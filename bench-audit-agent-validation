#!/usr/bin/env python3
"""Reject direct benchmark turns that exceed Work Leaf's focused-check budget."""

from __future__ import annotations

import json
import shlex
import sys
from pathlib import Path
from typing import Any


VALIDATION_SUBCOMMAND_ALIASES = {
    "b": "build",
    "build": "build",
    "c": "check",
    "check": "check",
    "clippy": "clippy",
    "d": "doc",
    "doc": "doc",
    "fmt": "fmt",
    "nextest": "nextest",
    "t": "test",
    "test": "test",
}
CARGO_GLOBAL_VALUE_OPTIONS = {"--color", "-C", "--config", "-Z"}
CARGO_GLOBAL_TERMINATING_OPTIONS = {"-V", "--version", "--list", "--explain", "-h", "--help"}
SHELL_BINARIES = {"bash", "dash", "ksh", "sh", "zsh"}
SHELL_SEPARATORS = {"\n", "&", "&&", "(", ")", ";", "|", "||"}
VALUE_SCOPE_OPTIONS = {"-p", "--package", "--bin", "--test", "--bench", "--example"}
VALUE_CARGO_OPTIONS = {
    "--exclude", "-F", "--features", "--target", "--manifest-path", "--target-dir",
    "-j", "--jobs", "--color", "--config", "-Z", "--profile",
    "--message-format",
}
VALUE_LIBTEST_OPTIONS = {
    "--skip", "--test-threads", "--format", "--color", "--logfile",
    "--shuffle-seed", "-Z",
}
SHELL_REDIRECTION_OPERATORS = ("<<<", "<<-", ">>", "<<", "<>", ">&", "<&", ">|", ">", "<")
MAX_SHELL_PAYLOAD_DEPTH = 4


def decoded_arguments(value: Any) -> dict[str, Any]:
    if isinstance(value, dict):
        return value
    if not isinstance(value, str):
        return {}
    try:
        decoded = json.loads(value)
    except json.JSONDecodeError:
        return {}
    return decoded if isinstance(decoded, dict) else {}


def record_command(
    value: dict[str, Any],
    command: str,
    commands: dict[str, str],
    idless_sequence: list[int],
) -> None:
    identity = next(
        (
            f"{key}:{identifier}"
            for key in ("id", "call_id", "tool_use_id")
            if isinstance((identifier := value.get(key)), str) and identifier
        ),
        None,
    )
    if identity is None:
        identity = f"event:{idless_sequence[0]}"
        idless_sequence[0] += 1
    if identity in commands and commands[identity] != command:
        identity = f"{identity}:conflict:{idless_sequence[0]}"
        idless_sequence[0] += 1
    commands.setdefault(identity, command)


def extract_commands(
    value: Any, commands: dict[str, str], idless_sequence: list[int]
) -> None:
    if isinstance(value, list):
        for item in value:
            extract_commands(item, commands, idless_sequence)
        return
    if not isinstance(value, dict):
        return

    event_type = value.get("type")
    if event_type == "command_execution":
        command = value.get("command")
        if isinstance(command, str):
            record_command(value, command, commands, idless_sequence)
    elif event_type == "function_call" and value.get("name") in {
        "exec_command",
        "shell",
        "bash",
    }:
        arguments = decoded_arguments(value.get("arguments"))
        command = arguments.get("cmd") or arguments.get("command")
        if isinstance(command, str):
            record_command(value, command, commands, idless_sequence)
    elif event_type == "tool_use" and value.get("name") == "Bash":
        arguments = decoded_arguments(value.get("input"))
        command = arguments.get("command")
        if isinstance(command, str):
            record_command(value, command, commands, idless_sequence)

    for child in value.values():
        extract_commands(child, commands, idless_sequence)


def shell_tokens(command: str) -> list[str]:
    lexer = shlex.shlex(command, posix=True, punctuation_chars=";&|()\n")
    lexer.commenters = ""
    lexer.whitespace = " \t\r"
    lexer.whitespace_split = True
    tokens: list[str] = []
    for token in lexer:
        if token and all(character in ";&|()\n" for character in token):
            index = 0
            while index < len(token):
                character = token[index]
                if character in "&|" and token[index : index + 2] == character * 2:
                    tokens.append(character * 2)
                    index += 2
                else:
                    tokens.append(character)
                    index += 1
        else:
            tokens.append(token)
    return tokens


def has_ineligible_shell_syntax(command: str) -> bool:
    quote: str | None = None
    escaped = False
    in_comment = False
    index = 0
    while index < len(command):
        character = command[index]
        if in_comment:
            if character == "\n":
                in_comment = False
            index += 1
            continue
        if escaped:
            escaped = False
            index += 1
            continue
        if character == "\\" and quote != "'":
            escaped = True
            index += 1
            continue
        if quote == "'":
            if character == "'":
                quote = None
            index += 1
            continue
        if character == "'" and quote is None:
            quote = "'"
            index += 1
            continue
        if character == '"':
            quote = None if quote == '"' else '"'
            index += 1
            continue
        if quote is None and character == "#" and (
            index == 0 or command[index - 1].isspace() or command[index - 1] in ";&|()"
        ):
            in_comment = True
            index += 1
            continue
        if character == "`" or command.startswith(("$(", "<(", ">("), index):
            return True
        if quote is None and command.startswith(("<<", "<<-"), index):
            return True
        index += 1
    return False


def shell_command_ranges(tokens: list[str]) -> list[tuple[int, int]]:
    ranges: list[tuple[int, int]] = []
    start = 0
    for index, token in enumerate(tokens):
        if token not in SHELL_SEPARATORS:
            continue
        if start < index:
            ranges.append((start, index))
        start = index + 1
    if start < len(tokens):
        ranges.append((start, len(tokens)))
    return ranges


def is_shell_assignment(token: str) -> bool:
    name, separator, _ = token.partition("=")
    return bool(
        separator
        and name
        and name[0].isascii()
        and (name[0].isalpha() or name[0] == "_")
        and all(
            character.isascii() and (character.isalnum() or character == "_")
            for character in name
        )
    )


def shell_command_index(tokens: list[str], start: int, end: int) -> int | None:
    index = start
    while index < end and is_shell_assignment(tokens[index]):
        index += 1
    while index < end:
        executable = Path(tokens[index]).name.lower()
        if executable == "env":
            index += 1
            while index < end:
                argument = tokens[index]
                if argument == "--":
                    index += 1
                    break
                if is_shell_assignment(argument):
                    index += 1
                    continue
                if argument in {"-u", "--unset", "-C", "--chdir", "-a", "--argv0"}:
                    index += 2
                    continue
                if (
                    argument in {"-S", "--split-string"}
                    or argument.startswith("--split-string=")
                    or argument.startswith("-S")
                    and len(argument) > 2
                ):
                    return None
                if argument.startswith("-"):
                    index += 1
                    continue
                break
            while index < end and is_shell_assignment(tokens[index]):
                index += 1
            continue
        if executable == "command":
            index += 1
            while index < end and tokens[index].startswith("-"):
                if "v" in tokens[index][1:] or "V" in tokens[index][1:]:
                    return None
                index += 1
            continue
        break
    return index if index < end else None


def shell_segment_has_ineligible_wrapper(
    tokens: list[str], start: int, end: int
) -> bool:
    index = start
    while index < end and is_shell_assignment(tokens[index]):
        index += 1
    while index < end:
        executable = Path(tokens[index]).name.lower()
        if executable == "command":
            index += 1
            while index < end and tokens[index].startswith("-"):
                if "v" in tokens[index][1:] or "V" in tokens[index][1:]:
                    return False
                index += 1
            continue
        if executable != "env":
            return False
        index += 1
        while index < end:
            argument = tokens[index]
            if argument == "--":
                index += 1
                break
            if (
                argument in {"-S", "--split-string"}
                or argument.startswith("--split-string=")
                or argument.startswith("-S")
                and len(argument) > 2
            ):
                return True
            if is_shell_assignment(argument):
                index += 1
                continue
            if argument in {"-u", "--unset", "-C", "--chdir", "-a", "--argv0"}:
                index += 2
                continue
            if not argument.startswith("-"):
                break
            index += 1
        while index < end and is_shell_assignment(tokens[index]):
            index += 1
        if index >= end:
            return False
        if Path(tokens[index]).name.lower() in {"env", "command"}:
            continue
        return False
    return False


def shell_payload_indexes(tokens: list[str]) -> set[int]:
    payload_indexes: set[int] = set()
    for start, end in shell_command_ranges(tokens):
        index = shell_command_index(tokens, start, end)
        if index is None or Path(tokens[index]).name.lower() not in SHELL_BINARIES:
            continue
        option_index = index + 1
        while option_index < end:
            option = tokens[option_index]
            if option == "--" or not option.startswith(("-", "+")):
                break
            if option.startswith("-") and "c" in option[1:] and option_index + 1 < end:
                payload_indexes.add(option_index + 1)
                break
            if option in {"-o", "+o", "-O", "+O", "--rcfile", "--init-file"}:
                option_index += 2
                continue
            option_index += 1
    return payload_indexes


def shell_payloads(tokens: list[str]) -> list[str]:
    return [tokens[index] for index in sorted(shell_payload_indexes(tokens))]


def cargo_subcommand_and_arguments(tokens: list[str]) -> tuple[str, list[str]] | None:
    if not tokens or Path(tokens[0]).name.lower() != "cargo":
        return None
    index = 1
    if index < len(tokens) and tokens[index].startswith("+"):
        index += 1
    while index < len(tokens):
        argument = tokens[index]
        if argument == "--":
            index += 1
            break
        if argument in CARGO_GLOBAL_TERMINATING_OPTIONS:
            return None
        if argument in CARGO_GLOBAL_VALUE_OPTIONS:
            if index + 1 >= len(tokens):
                return None
            index += 2
            continue
        if (
            argument.startswith("--color=")
            or argument.startswith("--config=")
            or argument.startswith("-C") and len(argument) > 2
            or argument.startswith("-Z") and len(argument) > 2
        ):
            index += 1
            continue
        if argument in {"-q", "--quiet", "--verbose", "--locked", "--offline", "--frozen"}:
            index += 1
            continue
        if len(argument) > 1 and argument.startswith("-") and set(argument[1:]) == {"v"}:
            index += 1
            continue
        break
    if index >= len(tokens):
        return None
    subcommand = VALIDATION_SUBCOMMAND_ALIASES.get(tokens[index].lower())
    if subcommand is None:
        return None
    return subcommand, tokens[index + 1 :]


def cargo_validations(command: str, depth: int = 0) -> list[tuple[str, list[str]]]:
    if depth > MAX_SHELL_PAYLOAD_DEPTH:
        return []
    try:
        raw_tokens = shell_tokens(command)
    except ValueError:
        return []
    tokens = validation_arguments(raw_tokens, shell_payload_indexes(raw_tokens))
    payloads = shell_payloads(tokens)

    validations: list[tuple[str, list[str]]] = []
    # Segments are disjoint. Each token is classified once at this depth, so repeated Cargo-looking
    # arguments cannot trigger a scan of every remaining token.
    for start, end in shell_command_ranges(tokens):
        if shell_segment_has_ineligible_wrapper(tokens, start, end):
            validations.append(("ineligible shell wrapper", ["cargo", "test"]))
            continue
        index = shell_command_index(tokens, start, end)
        if index is None:
            continue
        executable = Path(tokens[index]).name.lower()
        if executable == "eval":
            validations.append(("dynamic shell evaluation", ["cargo", "test"]))
            continue
        if executable != "cargo":
            continue
        segment_tokens = tokens[index:end]
        if cargo_subcommand_and_arguments(segment_tokens) is None:
            continue

        validations.append((" ".join(segment_tokens), segment_tokens))

    if has_ineligible_shell_syntax(command):
        validations.append(("dynamic shell substitution", ["cargo", "test"]))

    for payload in payloads:
        validations.extend(cargo_validations(payload, depth + 1))
    return validations


def option_has_attached_value(argument: str, names: tuple[str, ...]) -> bool:
    return any(
        argument.startswith(f"{name}=") and len(argument) > len(name) + 1
        for name in names
    )


def has_explicit_scope(arguments: list[str]) -> bool:
    index = 0
    while index < len(arguments) and arguments[index] != "--":
        argument = arguments[index]
        if option_has_attached_value(
            argument, ("--package", "--bin", "--test", "--bench", "--example")
        ):
            return True
        if argument.startswith("-p") and argument[2:].lstrip("="):
            return True
        if argument in VALUE_SCOPE_OPTIONS:
            return (
                index + 1 < len(arguments)
                and bool(arguments[index + 1])
                and not arguments[index + 1].startswith("-")
            )
        index += 2 if option_takes_value(argument) else 1
    return False


def option_takes_value(argument: str) -> bool:
    return argument in VALUE_SCOPE_OPTIONS | VALUE_CARGO_OPTIONS


def has_named_test_filter(arguments: list[str]) -> bool:
    before_separator = True
    index = 0
    while index < len(arguments):
        argument = arguments[index]
        if argument == "--":
            before_separator = False
            index += 1
            continue
        if argument.startswith("-"):
            takes_value = (
                option_takes_value(argument)
                if before_separator
                else argument in VALUE_LIBTEST_OPTIONS
            )
            index += 2 if takes_value and "=" not in argument else 1
            continue
        if argument:
            return True
        index += 1
    return False


def validation_arguments(
    arguments: list[str], opaque_indexes: set[int] | None = None
) -> list[str]:
    filtered: list[str] = []
    skip_redirection_target = False
    in_comment = False
    opaque_indexes = opaque_indexes or set()
    for index, argument in enumerate(arguments):
        if in_comment:
            if argument == "\n":
                in_comment = False
                filtered.append(argument)
            continue
        if skip_redirection_target:
            skip_redirection_target = argument == "&"
            continue
        if index in opaque_indexes:
            filtered.append(argument)
            continue
        if argument.startswith("#"):
            in_comment = True
            continue
        redirect_at = min(
            (index for index in (argument.find("<"), argument.find(">")) if index >= 0),
            default=-1,
        )
        if redirect_at < 0:
            filtered.append(argument)
            continue
        prefix = argument[:redirect_at]
        if prefix and not (prefix.isascii() and prefix.isdigit()):
            filtered.append(prefix)
        redirection = argument[redirect_at:]
        operator = next(
            (item for item in SHELL_REDIRECTION_OPERATORS if redirection.startswith(item)),
            redirection,
        )
        skip_redirection_target = len(redirection) == len(operator)
    return filtered


def focused_validation_violation(subcommand: str, arguments: list[str]) -> str | None:
    arguments = validation_arguments(arguments)
    scoped = has_explicit_scope(arguments)
    if subcommand == "test":
        scoped = scoped or has_named_test_filter(arguments)
    elif subcommand == "nextest":
        if not arguments or arguments[0] != "run":
            return "cargo nextest must use the run action to validate tests"
        scoped = scoped or any(
            argument.startswith("--filter-expr=") and len(argument) > len("--filter-expr=")
            or argument == "--filter-expr"
            and index + 1 < len(arguments)
            and bool(arguments[index + 1])
            and not arguments[index + 1].startswith("-")
            for index, argument in enumerate(arguments)
        )
    if not scoped:
        return f"repository-wide cargo {subcommand} is not a focused validation"
    if subcommand == "fmt" and "--check" not in arguments:
        return "write-producing cargo fmt is not a validation"
    return None


def audit(path: Path) -> tuple[list[str], list[str]]:
    commands: dict[str, str] = {}
    idless_sequence = [0]
    with path.open(encoding="utf-8", errors="replace") as handle:
        for line in handle:
            try:
                extract_commands(json.loads(line), commands, idless_sequence)
            except json.JSONDecodeError:
                continue

    validations: list[str] = []
    violations: list[str] = []
    for command in commands.values():
        for segment, tokens in cargo_validations(command):
            parsed = cargo_subcommand_and_arguments(tokens)
            if parsed is None:
                continue
            subcommand, arguments = parsed
            validations.append(segment)

            violation = focused_validation_violation(subcommand, arguments)
            if violation is not None:
                violations.append(violation)

    if len(validations) != 1:
        violations.append(
            f"found {len(validations)} validation commands; exactly one focused Cargo validation command is required"
        )
    return validations, list(dict.fromkeys(violations))


def main() -> int:
    if len(sys.argv) != 2:
        print("usage: bench-audit-agent-validation <agent-turn.jsonl>", file=sys.stderr)
        return 2

    path = Path(sys.argv[1])
    if not path.is_file():
        print(f"agent validation log does not exist: {path}", file=sys.stderr)
        return 2

    validations, violations = audit(path)
    for command in validations:
        print(f"validation: {command}")
    if not violations:
        print(f"validation audit passed: {len(validations)} focused command(s)")
        return 0

    print("iteration validation budget exceeded:", file=sys.stderr)
    for violation in violations:
        print(f"- {violation}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
