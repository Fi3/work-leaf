#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$repo_root/bench-candidate-common"

candidate_replay="$repo_root/bench-candidate-replay"

bench_mode=0
remote_cli_mode=0
start_args=()
while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --bench)
      bench_mode=1
      shift
      ;;
    -c|--cli)
      remote_cli_mode=1
      start_args+=("$1")
      if [[ "$#" -lt 2 ]]; then
        break
      fi
      start_args+=("$2")
      shift 2
      ;;
    *)
      start_args+=("$1")
      shift
      ;;
  esac
done

capture_bench_candidate_snapshot() {
  local artifact_dir="$1"
  local first_snapshot second_snapshot

  bench_candidate_is_runnable "$artifact_dir" || return 1
  first_snapshot="$("$candidate_replay" snapshot "$artifact_dir")" || return 1
  bench_candidate_is_runnable "$artifact_dir" || return 1
  second_snapshot="$("$candidate_replay" snapshot "$artifact_dir")" || return 1
  [[ "$second_snapshot" == "$first_snapshot" ]] || return 1
  printf '%s\n' "$first_snapshot"
}

select_bench_candidate() {
  local results_dir="${WORK_LEAF_START_BENCH_RESULTS_DIR:-$repo_root/bench-results}"
  if [[ ! -d "$results_dir" ]]; then
    echo "no bench results directory found: $results_dir" >&2
    exit 1
  fi
  results_dir="$(cd "$results_dir" && pwd -P)"
  for required_command in awk cmp find git jq python3 sha256sum sort stat; do
    if ! command -v "$required_command" >/dev/null 2>&1; then
      echo "$required_command is required to validate benchmark candidates" >&2
      exit 1
    fi
  done
  if [[ ! -x "$candidate_replay" ]]; then
    echo "benchmark candidate replay helper is not executable: $candidate_replay" >&2
    exit 1
  fi

  local artifact_dirs=()
  local candidate_snapshots=()
  local artifact_dir provenance_path snapshot
  while IFS= read -r -d '' provenance_path; do
    artifact_dir="${provenance_path%/candidate/PROVENANCE}"
    if snapshot="$(capture_bench_candidate_snapshot "$artifact_dir")"; then
      artifact_dirs+=("$artifact_dir")
      candidate_snapshots+=("$snapshot")
    fi
  done < <(
    find "$results_dir" -mindepth 3 -type f -path '*/candidate/PROVENANCE' -print0 \
      | sort -zVr
  )

  if [[ "${#artifact_dirs[@]}" -eq 0 ]]; then
    echo "no runnable benchmark candidates found in $results_dir" >&2
    exit 1
  fi

  echo "Available benchmark candidates:"
  local index=1
  local artifact_name
  local display_name
  for artifact_dir in "${artifact_dirs[@]}"; do
    artifact_name="$(basename "$artifact_dir")"
    display_name="${artifact_name%-artifacts}"
    printf '  %d) %s\n' "$index" "$display_name"
    index=$((index + 1))
  done

  local choice
  printf 'Choose a benchmark to run [1-%d]: ' "${#artifact_dirs[@]}"
  if ! read -r choice; then
    echo "no benchmark selection received" >&2
    exit 1
  fi
  if [[ ! "$choice" =~ ^[0-9]+$ ]]; then
    echo "invalid benchmark selection: $choice" >&2
    exit 1
  fi
  local leading_zeros="${choice%%[!0]*}"
  local decimal_choice="${choice#"$leading_zeros"}"
  [[ -n "$decimal_choice" ]] || decimal_choice="0"
  local maximum_choice="${#artifact_dirs[@]}"
  if [[ "$decimal_choice" == "0" \
    || "${#decimal_choice}" -gt "${#maximum_choice}" \
    || ( "${#decimal_choice}" -eq "${#maximum_choice}" \
      && "$decimal_choice" > "$maximum_choice" ) ]]; then
    echo "invalid benchmark selection: $choice" >&2
    exit 1
  fi

  local selected_index=$((10#$decimal_choice - 1))
  local selected_artifact="${artifact_dirs[$selected_index]}"
  local selected_snapshot="${candidate_snapshots[$selected_index]}"
  local current_snapshot
  if ! bench_candidate_is_runnable "$selected_artifact" \
    || ! current_snapshot="$("$candidate_replay" snapshot "$selected_artifact")" \
    || [[ "$current_snapshot" != "$selected_snapshot" ]]; then
    echo "selected benchmark candidate changed after it was listed: $selected_artifact" >&2
    exit 1
  fi

  echo "Running benchmark candidate from $selected_artifact/candidate/bin"
  local snapshot_fd
  exec {snapshot_fd}< <(printf '%s' "$selected_snapshot")
  set -- "${start_args[@]}"
  exec "$candidate_replay" exec-fd "$snapshot_fd" "$@"
}

if [[ "$bench_mode" == "1" ]]; then
  select_bench_candidate
elif [[ "${WORK_LEAF_START_SKIP_BUILD:-}" != "1" ]]; then
  (cd "$repo_root" && cargo build --release --bin work-leaf)
  bin_dir="${WORK_LEAF_START_BIN_DIR:-$repo_root/target/release}"
else
  bin_dir="${WORK_LEAF_START_BIN_DIR:-$repo_root/target/release}"
fi

cli_bin="$bin_dir/work-leaf"
set -- "${start_args[@]}"
exec "$cli_bin" "$@"
