+#[test]
+fn orchestrator_protocol_experiment_can_resend_full_changed_files() {
+    const CHILD: &str = "WORK_LEAF_TEST_CHANGED_REPEAT_CHILD";
+    if std::env::var_os(CHILD).is_none() {
+        let status = Command::new(std::env::current_exe().unwrap())
+            .args([
+                "--exact",
+                "orchestrator_protocol_experiment_can_resend_full_changed_files",
+                "--nocapture",
+            ])
+            .env(CHILD, "1")
+            .env("WORK_LEAF_EXPERIMENT_CHANGED_REPEAT_DELIVERY", "full")
+            .status()
+            .unwrap();
+        assert!(status.success());
+        return;
+    }
+    let root = temp_git_repo("protocol-repeat-read-changed-full");
+    fs::write(root.join("README.md"), "before\n").unwrap();
+    let backend = RecordingBackend::default();
+    let mut orchestrator = AgentOrchestrator::new(root.clone(), backend);
+    let agent_id = AgentId::new("user-1").unwrap();
+
+    orchestrator
+        .handle_agent_message(&agent_id, "docs", "@work-leaf read README.md")
+        .unwrap();
+    fs::write(root.join("README.md"), "after\n").unwrap();
+    orchestrator
+        .handle_agent_message(&agent_id, "docs", "@work-leaf read README.md")
+        .unwrap();
+    let backend = orchestrator.into_backend();
+
+    let repeat_prompt = &backend.sends[1].1;
+    assert!(repeat_prompt.contains("full current text follows:\nafter\n"));
+    assert!(!repeat_prompt.contains("diff --git"));
+}
+
