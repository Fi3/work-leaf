+fn experiment_review_provenance_policy_from_env() -> ExperimentReviewProvenancePolicy {
+    match std::env::var(WORK_LEAF_EXPERIMENT_REVIEW_PROVENANCE_ENV) {
+        Err(std::env::VarError::NotPresent) => ExperimentReviewProvenancePolicy::InlineExact,
+        Err(std::env::VarError::NotUnicode(_)) => {
+            panic!("{WORK_LEAF_EXPERIMENT_REVIEW_PROVENANCE_ENV} must be valid UTF-8")
+        }
+        Ok(value) => match value.trim() {
+            "" | "inline-exact" | "normal" => ExperimentReviewProvenancePolicy::InlineExact,
+            "git-reconstruct" => ExperimentReviewProvenancePolicy::GitReconstruct,
+            value => panic!(
+                "{WORK_LEAF_EXPERIMENT_REVIEW_PROVENANCE_ENV} must be `inline-exact` or `git-reconstruct`, got `{value}`"
+            ),
+        },
+    }
+}
