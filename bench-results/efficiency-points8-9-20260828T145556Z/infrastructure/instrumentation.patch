+#[test]
+fn command_chat_experiment_can_require_review_context_reconstruction() {
+    const CHILD: &str = "WORK_LEAF_TEST_REVIEW_RECONSTRUCT_CHILD";
+    if std::env::var_os(CHILD).is_none() {
+        let status = Command::new(std::env::current_exe().unwrap())
+            .args([
+                "--exact",
+                "command_chat_experiment_can_require_review_context_reconstruction",
+                "--nocapture",
+            ])
+            .env(CHILD, "1")
+            .env("WORK_LEAF_EXPERIMENT_REVIEW_PROVENANCE", "git-reconstruct")
+            .status()
+            .unwrap();
+        assert!(status.success());
+        return;
+    }
+    let root = temp_git_repo("command-chat-review-git-reconstruct");
+    fs::write(root.join("README.md"), "review target\n").unwrap();
+    git(&root, ["add", "README.md"]);
+    git(
+        &root,
+        [
+            "commit",
+            "-m",
+            "UPDATE apply docs patch from user-1",
+            "-m",
+            "Agent-ID: user-1\nFeature: docs\nReason: review docs\nContext: private inline context",
+        ],
+    );
+    let backend = FakeBackend::new(["NO_FINDINGS"]);
+    let mut chat = CommandChat::new(root, backend);
+
+    let result = chat.handle_line("review").unwrap();
+    assert!(matches!(result, CommandChatResult::ReviewComplete(_)));
+
+    let backend = chat.into_backend();
+    let prompt = &backend.launches[0].prompt;
+    assert!(prompt.contains(
+        "Review scope and source context are intentionally not inlined for this experiment"
+    ));
+    assert!(prompt.contains("Reconstruct the exact review scope from Git before reviewing"));
+    assert!(!prompt.contains("private inline context"));
+    assert!(!prompt.contains("Recorded chat history"));
+}
