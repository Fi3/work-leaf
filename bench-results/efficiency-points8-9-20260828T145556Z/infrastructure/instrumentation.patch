+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]
+struct ExperimentReadDeliveryConfig {
+    changed_full: bool,
+    unchanged_full: bool,
+}
+
+fn experiment_read_delivery_config_from_env() -> ExperimentReadDeliveryConfig {
+    let shared = experiment_env_value(WORK_LEAF_EXPERIMENT_READ_DELIVERY_ENV);
+    ExperimentReadDeliveryConfig {
+        changed_full: experiment_full_delivery(
+            WORK_LEAF_EXPERIMENT_CHANGED_REPEAT_DELIVERY_ENV,
+            shared.as_deref(),
+        ),
+        unchanged_full: experiment_full_delivery(
+            WORK_LEAF_EXPERIMENT_UNCHANGED_REPEAT_DELIVERY_ENV,
+            shared.as_deref(),
+        ),
+    }
+}
+
+fn experiment_full_delivery(name: &str, fallback: Option<&str>) -> bool {
+    match experiment_env_value(name).as_deref().or(fallback) {
+        None | Some("normal") => false,
+        Some("full") => true,
+        Some(value) => panic!("{name} must be `normal` or `full`, got `{value}`"),
+    }
+}
+
+fn experiment_env_value(name: &str) -> Option<String> {
+    match std::env::var(name) {
+        Err(std::env::VarError::NotPresent) => None,
+        Err(std::env::VarError::NotUnicode(_)) => panic!("{name} must be valid UTF-8"),
+        Ok(value) => {
+            let value = value.trim().to_string();
+            (!value.is_empty()).then_some(value)
+        }
+    }
+}
+
 fn render_file_read_response_inline(
     snapshots: &[crate::locks::FileSnapshot],
     failures: &[FileReadFailure],
@@ -2166,6 +2238,31 @@ fn render_changed_repeat_read_snapshot(
     }
 }
 
+fn render_changed_repeat_full_current_snapshot(
+    text: &mut String,
+    file_reads: &FileReadTracker,
+    agent_id: &AgentId,
+    snapshot: &crate::locks::FileSnapshot,
+) {
+    text.push_str("\n--- ");
+    text.push_str(&snapshot.path.display().to_string());
+    text.push_str(" ---\n");
+    text.push_str("current digest: ");
+    text.push_str(&content_digest(&snapshot.text));
+    text.push('\n');
+    if let Some(previous) = file_reads.snapshot_for(agent_id, &snapshot.path) {
+        text.push_str("previous digest: ");
+        text.push_str(&previous.digest);
+        text.push('\n');
+    }
+    text.push_str("status: changed since this agent's last snapshot\n");
+    text.push_str("full current text follows:\n");
+    text.push_str(&snapshot.text);
+    if !snapshot.text.ends_with('\n') {
+        text.push('\n');
+    }
+}
