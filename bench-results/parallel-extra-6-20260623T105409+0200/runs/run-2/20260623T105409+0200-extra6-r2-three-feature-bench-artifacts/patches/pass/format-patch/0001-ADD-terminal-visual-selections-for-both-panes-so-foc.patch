+#[test]
+fn scripted_harness_single_v_yanks_right_pane_character_selection() {
+    let mut harness = UiHarness::new(80, 24);
+
+    harness.handle_bytes(&[23, b'l']);
+    harness.handle_byte(b'v');
+
+    assert!(harness.ui().visual_selection_active());
+
+    harness.handle_byte(b'l');
+    harness.handle_byte(b'y');
+
+    assert_eq!(harness.ui().copied_text(), Some("Es"));
+}
+
+#[test]
+fn scripted_harness_single_v_then_y_yanks_focused_pane_character() {
+    let mut left_harness = UiHarness::new(80, 24);
+
+    left_harness.handle_byte(b'v');
+    left_harness.handle_byte(b'y');
+
+    assert_eq!(left_harness.ui().copied_text(), Some(">"));
+
+    let mut right_harness = UiHarness::new(80, 24);
+
+    right_harness.handle_bytes(&[23, b'l']);
+    right_harness.handle_byte(b'v');
+    right_harness.handle_byte(b'y');
+
+    assert_eq!(right_harness.ui().copied_text(), Some("E"));
+}
+
+#[test]
+fn scripted_harness_visual_mode_starts_on_focused_left_pane_row() {
+    let mut harness = UiHarness::new(80, 24);
+
+    assert_eq!(harness.ui().focus(), PaneFocus::Left);
+
+    harness.handle_byte(b'v');
+
+    assert!(harness.ui().visual_selection_active());
+
+    harness.handle_byte(b'Y');
+
+    assert_eq!(harness.ui().copied_text(), Some(">user-1 READY"));
+}
+
+#[test]
+fn scripted_harness_ctrl_v_block_selection_yanks_rectangle() {
+    let mut harness = UiHarness::new(80, 24);
+
+    harness.handle_bytes(&[23, b'l']);
+    harness.handle_byte(22);
+    harness.handle_byte(b'k');
+    harness.handle_byte(b'l');
+    harness.handle_byte(b'l');
+    harness.handle_byte(b'y');
+
+    assert_eq!(harness.ui().copied_text(), Some("UI \nEsc"));
+}
