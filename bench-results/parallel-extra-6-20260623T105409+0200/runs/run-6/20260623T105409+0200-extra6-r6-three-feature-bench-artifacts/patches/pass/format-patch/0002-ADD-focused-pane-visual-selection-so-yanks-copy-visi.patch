diff --git a/tests/ui_harness.rs b/tests/ui_harness.rs
index 3502bcf..b6d276a 100644
--- a/tests/ui_harness.rs
+++ b/tests/ui_harness.rs
@@ -324,6 +324,26 @@ fn scripted_harness_drives_ctrl_w_navigation_and_left_toggle() {
     assert_eq!(harness.ui().focus(), PaneFocus::Left);
 }
 
+#[test]
+fn scripted_harness_visual_char_mode_yanks_right_pane_selection_to_clipboard() {
+    let mut harness = UiHarness::new(80, 24);
+
+    harness.handle_bytes(&[23, b'l']);
+    harness.handle_byte(b'v');
+
+    assert!(harness.ui().visual_selection_active());
+    assert!(
+        harness
+            .render_frame()
+            .contains("mode=visual-char focus=right")
+    );
+
+    harness.handle_bytes(b"ll");
+    harness.handle_byte(b'y');
+
+    assert_eq!(harness.ui().copied_text(), Some("Esc"));
+}
+
 #[test]
 fn scripted_harness_visual_mode_yanks_right_pane_line_to_clipboard() {
     let mut harness = UiHarness::new(80, 24);
@@ -348,6 +368,63 @@ fn scripted_harness_visual_mode_yanks_right_pane_line_to_clipboard() {
     assert!(frame.contains("copied "));
 }
 
+#[test]
+fn scripted_harness_visual_block_mode_yanks_right_pane_columns_to_clipboard() {
+    let mut harness = UiHarness::new(80, 24);
+
+    harness.handle_bytes(&[23, b'l']);
+    harness.handle_byte(22);
+
+    assert!(harness.ui().visual_selection_active());
+    assert!(
+        harness
+            .render_frame()
+            .contains("mode=visual-block focus=right")
+    );
+
+    harness.handle_bytes(b"lllj");
+    harness.handle_byte(b'y');
+
+    assert_eq!(harness.ui().copied_text(), Some("Esc \nchat"));
+}
+
+#[test]
+fn scripted_harness_visual_modes_yank_left_pane_text() {
+    let mut harness = UiHarness::new(120, 24);
+
+    assert_eq!(harness.ui().focus(), PaneFocus::Left);
+
+    harness.handle_byte(b'v');
+    assert!(harness.ui().visual_selection_active());
+    assert!(
+        harness
+            .render_frame()
+            .contains("mode=visual-char focus=left")
+    );
+    harness.handle_bytes(b"lll");
+    harness.handle_byte(b'y');
+    assert_eq!(harness.ui().copied_text(), Some(">par"));
+
+    harness.handle_byte(b'V');
+    assert!(
+        harness
+            .render_frame()
+            .contains("mode=visual-line focus=left")
+    );
+    harness.handle_byte(b'Y');
+    assert_eq!(harness.ui().copied_text(), Some(">parser user-1 READY"));
+
+    harness.handle_byte(22);
+    assert!(
+        harness
+            .render_frame()
+            .contains("mode=visual-block focus=left")
+    );
+    harness.handle_bytes(b"lllj");
+    harness.handle_byte(b'y');
+    assert_eq!(harness.ui().copied_text(), Some(">par\n    "));
+}
