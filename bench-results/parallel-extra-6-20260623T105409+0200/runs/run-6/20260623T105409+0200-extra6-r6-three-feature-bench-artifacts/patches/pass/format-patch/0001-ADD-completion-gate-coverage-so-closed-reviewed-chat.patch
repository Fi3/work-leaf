+    #[test]
+    fn feature_done_yes_closes_and_later_message_reopens_patch_agent() {
+        let backend = ScriptedBackend::new([
+            "initial launch reply",
+            "generated completion title",
+            "follow-up reply",
+        ]);
+        let chat = CommandChat::new(PathBuf::from("/repo"), backend.clone());
+        let mut controller = WorkLeafController::new(chat);
+        let agent_id = controller
+            .create_agent("completion gate")
+            .expect("patch-agent launch is prepared");
+        assert!(controller.wait_for_idle(Duration::from_secs(1)));
+        controller.ask_feature_done(&agent_id);
+
+        controller
+            .send_message(&agent_id, "yes")
+            .expect("yes answer is accepted");
+
+        let snapshot = controller.snapshot();
+        let session = snapshot
+            .session(&agent_id)
+            .expect("patch-agent session exists after closing");
+        assert_eq!(session.completion, Some(WorkLeafCompletion::Closed));
+        assert!(
+            session
+                .lines
+                .iter()
+                .any(|line| line == FEATURE_CLOSED_MESSAGE),
+            "{session:?}"
+        );
+        assert!(
+            backend.sends().is_empty(),
+            "yes should close locally instead of sending to the backend"
+        );
+
+        controller
+            .send_message(&agent_id, "please handle one more case")
+            .expect("later chat message reopens the patch agent");
+        assert!(controller.wait_for_idle(Duration::from_secs(1)));
+
+        let snapshot = controller.snapshot();
+        let session = snapshot
+            .session(&agent_id)
+            .expect("patch-agent session exists after reopening");
+        assert_eq!(session.completion, None);
+        assert!(
+            session.lines.iter().any(|line| line == "follow-up reply"),
+            "{session:?}"
+        );
+        assert_eq!(
+            backend.sends(),
+            vec![(agent_id, "please handle one more case".to_string())]
+        );
+    }
+
