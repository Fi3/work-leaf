+#[test]
+fn scripted_harness_visual_char_mode_yanks_right_pane_selection_to_clipboard() {
+    let mut harness = UiHarness::new(80, 24);
+
+    harness.handle_bytes(&[23, b'l']);
+    harness.handle_byte(b'v');
+    assert!(harness.ui().visual_selection_active());
+
+    harness.handle_byte(b'l');
+    assert!(
+        harness
+            .render_frame()
+            .contains("\u{1b}[7mEs\u{1b}[0mc command")
+    );
+    harness.handle_byte(b'y');
+
+    assert_eq!(harness.ui().copied_text(), Some("Es"));
+    assert!(harness.render_frame().starts_with("\u{1b}]52;c;"));
+}
+
+#[test]
+fn scripted_harness_visual_line_mode_yanks_left_pane_selected_row_to_clipboard() {
+    let mut harness = UiHarness::new(80, 24);
+
+    harness.handle_byte(b'V');
+    assert!(harness.ui().visual_selection_active());
+    assert!(
+        harness
+            .render_frame()
+            .contains("mode=visual-line focus=left")
+    );
+
+    harness.handle_byte(b'Y');
+
+    assert_eq!(harness.ui().copied_text(), Some(">user-1 READY"));
+}
+
+#[test]
+fn scripted_harness_visual_block_mode_yanks_right_pane_rectangle_to_clipboard() {
+    let mut harness = UiHarness::new(80, 24);
+
+    harness.handle_bytes(&[23, b'l']);
+    harness.handle_byte(22);
+    assert!(harness.ui().visual_selection_active());
+    assert!(
+        harness
+            .render_frame()
+            .contains("mode=visual-block focus=right")
+    );
+
+    harness.handle_byte(b'l');
+    harness.handle_byte(b'j');
+    harness.handle_byte(b'y');
+
+    assert_eq!(harness.ui().copied_text(), Some("Es\nch"));
+}
