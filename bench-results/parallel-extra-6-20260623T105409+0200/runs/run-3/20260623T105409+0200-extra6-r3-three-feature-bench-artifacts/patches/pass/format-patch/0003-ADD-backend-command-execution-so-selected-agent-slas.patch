+fn agent_slash_command_message(message: &str) -> Option<&str> {
+    let message = message.trim();
+    let rest = message.strip_prefix('/')?;
+    rest.chars()
+        .next()
+        .is_some_and(|first| !first.is_whitespace())
+        .then_some(message)
+}
