+    fn handle_completion_message(&mut self, agent_id: &AgentId, message: &str) -> bool {
+        let Some(completion) = self.completion.get(agent_id).cloned() else {
+            return false;
+        };
+
+        match completion.state {
+            HarnessCompletionState::NeedsDecision => {
+                self.transcript.push(format!("{agent_id}> {message}"));
+                if message.eq_ignore_ascii_case("yes") {
+                    self.mark_completion_closed(agent_id, &completion.base_title);
+                } else if message.eq_ignore_ascii_case("no") {
+                    self.reopen_completed_feature(agent_id, &completion.base_title, true);
+                    self.transcript
+                        .push("work-leaf: feature remains open".to_string());
+                } else {
+                    self.transcript
+                        .push("work-leaf: answer yes or no to close this feature".to_string());
+                }
+                true
+            }
+            HarnessCompletionState::Closed => {
+                self.reopen_completed_feature(agent_id, &completion.base_title, false);
+                false
+            }
+        }
+    }
+
+    fn mark_completion_closed(&mut self, agent_id: &AgentId, title: &str) {
+        self.completion.insert(
+            agent_id.clone(),
+            HarnessCompletion {
+                base_title: title.to_string(),
+                state: HarnessCompletionState::Closed,
+            },
+        );
+        let _ = self
+            .ui
+            .set_agent_feature(agent_id, format!("{title} CLOSED"));
+        let _ = self.ui.set_agent_patch_lifecycle(agent_id, true, true);
+        let _ = self.ui.set_agent_ready_state(agent_id, false);
+        self.transcript
+            .push("work-leaf: feature marked closed".to_string());
+    }
+
+    fn reopen_completed_feature(&mut self, agent_id: &AgentId, title: &str, ready: bool) {
+        self.completion.remove(agent_id);
+        let _ = self.ui.set_agent_feature(agent_id, title.to_string());
+        let _ = self.ui.set_agent_patch_lifecycle(agent_id, true, false);
+        let _ = self.ui.set_agent_ready_state(agent_id, ready);
+    }
