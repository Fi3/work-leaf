+fn agent_backend_command_message(message: &str) -> Option<&str> {
+    let command = message.trim();
+    command.strip_prefix('/').and_then(|rest| {
+        rest.chars()
+            .next()
+            .is_some_and(|first| !first.is_whitespace())
+            .then_some(command)
+    })
+}
