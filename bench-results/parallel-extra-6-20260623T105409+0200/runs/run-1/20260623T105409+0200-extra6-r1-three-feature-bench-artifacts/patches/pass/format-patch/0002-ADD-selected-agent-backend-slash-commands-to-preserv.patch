+        command: &str,
+        _sink: &mut dyn FnMut(AgentStreamEvent),
+    ) -> Result<ChatMessage, AgentError> {
+        self.command(agent_id, command)
+    }
+
     fn send_streaming_interruptible(
         &mut self,
         agent_id: &AgentId,
@@ -75,6 +93,24 @@ pub trait AgentBackend {
         };
         self.send_streaming(agent_id, prompt, &mut stream)
     }
+
+    fn command_streaming_interruptible(
+        &mut self,
+        agent_id: &AgentId,
+        command: &str,
+        sink: &mut dyn FnMut(AgentStreamEvent),
+        should_interrupt: &mut dyn FnMut(&AgentStreamEvent) -> bool,
+    ) -> Result<ChatMessage, AgentError> {
+        let mut stream = |event: AgentStreamEvent| {
+            sink(event.clone());
+            let _ = should_interrupt(&event);
+        };
+        self.command_streaming(agent_id, command, &mut stream)
+    }
+}
+
+fn backend_command_token(command: &str) -> &str {
+    command.split_whitespace().next().unwrap_or(command)
 }
 
