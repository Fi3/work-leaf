diff --git a/tests/ui_harness.rs b/tests/ui_harness.rs
index 3502bcf..e53afa5 100644
--- a/tests/ui_harness.rs
+++ b/tests/ui_harness.rs
@@ -348,6 +348,60 @@ fn scripted_harness_visual_mode_yanks_right_pane_line_to_clipboard() {
     assert!(frame.contains("copied "));
 }
 
+#[test]
+fn scripted_harness_visual_mode_yanks_right_pane_character_selection_to_clipboard() {
+    let mut harness = UiHarness::new(80, 24);
+
+    harness.handle_bytes(&[23, b'l']);
+    harness.handle_byte(b'v');
+
+    assert!(
+        harness
+            .render_frame()
+            .contains("mode=visual-char focus=right")
+    );
+
+    harness.handle_byte(b'l');
+    harness.handle_byte(b'l');
+    harness.handle_byte(b'y');
+
+    assert_eq!(harness.ui().copied_text(), Some("Esc"));
+    assert!(!harness.ui().visual_selection_active());
+}
+
+#[test]
+fn scripted_harness_visual_block_yanks_rectangular_right_pane_selection_to_clipboard() {
+    let mut harness = UiHarness::new(80, 24);
+
+    harness.handle_bytes(&[23, b'l']);
+    harness.handle_byte(22);
+    harness.handle_byte(b'l');
+    harness.handle_byte(b'l');
+    harness.handle_byte(b'j');
+    harness.handle_byte(b'y');
+
+    assert_eq!(harness.ui().copied_text(), Some("Esc\ncha"));
+}
+
+#[test]
+fn scripted_harness_visual_line_yanks_left_pane_focused_row_to_clipboard() {
+    let mut harness = UiHarness::new(100, 24);
+
+    assert_eq!(harness.ui().focus(), PaneFocus::Left);
+
+    harness.handle_byte(b'V');
+
+    assert!(
+        harness
+            .render_frame()
+            .contains("mode=visual-line focus=left")
+    );
+
+    harness.handle_byte(b'Y');
+
+    assert_eq!(harness.ui().copied_text(), Some(">pars user-1 READY"));
+}
+
