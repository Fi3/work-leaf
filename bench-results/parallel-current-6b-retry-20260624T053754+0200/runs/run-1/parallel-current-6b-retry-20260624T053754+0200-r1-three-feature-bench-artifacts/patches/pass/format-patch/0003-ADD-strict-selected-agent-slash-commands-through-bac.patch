+fn terminal_app_interrupts_spawned_codex_slash_command() {
+    let root = temp_dir("terminal-app-codex-slash-interrupt");
+    let fake_bin = root.join("bin");
+    fs::create_dir_all(&fake_bin).unwrap();
+    let codex = fake_bin.join("codex");
+    fs::write(
+        &codex,
+        "\
+#!/bin/sh
+project_dir=
+seen_resume=0
+command_arg=
+while [ \"$#\" -gt 0 ]; do
+  if [ \"$1\" = \"--cd\" ]; then
+    shift
+    project_dir=$1
+  elif [ \"$1\" = \"resume\" ]; then
+    seen_resume=1
+  elif [ \"$1\" = \"/status\" ]; then
+    command_arg=/status
+  fi
+  shift
+done
+if [ \"$seen_resume\" = \"1\" ] && [ \"$command_arg\" = \"/status\" ]; then
+  trap 'printf \"%s\\n\" interrupted > \"$project_dir/interrupted\"; exit 0' TERM
+  printf '%s\\n' '{\"type\":\"turn.started\"}'
+  while :; do sleep 1; done
+else
+  printf '%s\\n' '{\"type\":\"thread.started\",\"thread_id\":\"thread-slash-interrupt\"}'
+  printf '%s\\n' '{\"type\":\"item.completed\",\"item\":{\"id\":\"launch\",\"type\":\"agent_message\",\"text\":\"launch reply from fake codex\"}}'
+fi
+",
+    )
+    .unwrap();
+    make_executable(&codex);
+    let backend = CodexBackend::new(
+        CodexCommandConfig::new(root.clone()).with_binary(&codex),
+        PromptPolicy::for_restricted_agents(),
+    );
+    let chat = CommandChat::new(root.clone(), backend);
+    let mut app = TerminalApp::new(chat, 100, 24);
+
+    app.handle_bytes(b":new interrupt slash command\n");
+    assert!(app.wait_for_idle(Duration::from_secs(1)));
+
+    app.handle_bytes(b"\x1b/status\n");
+    assert!(app.wait_for_frame_contains("Codex is working", Duration::from_secs(1)));
+    assert!(app.is_busy());
+    assert!(app.handle_byte(3));
+
+    let interrupted = root.join("interrupted");
+    let start = Instant::now();
+    while start.elapsed() < Duration::from_secs(1) && !interrupted.exists() {
+        app.poll_worker();
+        thread::sleep(Duration::from_millis(10));
+    }
+
+    assert_eq!(fs::read_to_string(interrupted).unwrap(), "interrupted\n");
+    assert!(app.wait_for_idle(Duration::from_secs(1)));
 }
 
