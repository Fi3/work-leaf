+fn clamp_text_point(point: TextPoint, lines: &[String]) -> TextPoint {
+    let row = point.row.min(lines.len().saturating_sub(1));
+    let line_len = lines
+        .get(row)
+        .map(|line| line.chars().count())
+        .unwrap_or_default();
+    let column = if line_len == 0 {
+        0
+    } else {
+        point.column.min(line_len - 1)
+    };
+    TextPoint { row, column }
+}
+
+fn selected_columns(selection: VisualSelection, row: usize, line: &str) -> Option<(usize, usize)> {
+    let len = line.chars().count();
+    let (row_start, row_end) = row_bounds(selection.anchor, selection.cursor);
+    if row < row_start || row > row_end {
+        return None;
+    }
+
+    let (start, end) = match selection.kind {
+        VisualSelectionKind::Character => character_selection_columns(selection, row, len),
+        VisualSelectionKind::Line => (0, len),
+        VisualSelectionKind::Block => {
+            let column_start = selection.anchor.column.min(selection.cursor.column);
+            let column_end = selection.anchor.column.max(selection.cursor.column) + 1;
+            (column_start.min(len), column_end.min(len))
+        }
+    };
+
+    (start < end).then_some((start, end))
+}
+
+fn character_selection_columns(
+    selection: VisualSelection,
+    row: usize,
+    line_len: usize,
+) -> (usize, usize) {
+    let (start, end) = ordered_points(selection.anchor, selection.cursor);
+    if start.row == end.row {
+        return (
+            start.column.min(line_len),
+            end.column.saturating_add(1).min(line_len),
+        );
+    }
+    if row == start.row {
+        (start.column.min(line_len), line_len)
+    } else if row == end.row {
+        (0, end.column.saturating_add(1).min(line_len))
+    } else {
+        (0, line_len)
+    }
+}
+
+fn row_bounds(anchor: TextPoint, cursor: TextPoint) -> (usize, usize) {
+    (anchor.row.min(cursor.row), anchor.row.max(cursor.row))
+}
+
+fn ordered_points(anchor: TextPoint, cursor: TextPoint) -> (TextPoint, TextPoint) {
+    if anchor.row < cursor.row || (anchor.row == cursor.row && anchor.column <= cursor.column) {
+        (anchor, cursor)
+    } else {
+        (cursor, anchor)
+    }
+}
+
+fn styled_selection_spans(line: &str, start: usize, end: usize) -> Spans<'static> {
+    let chars = line.chars().collect::<Vec<_>>();
+    let len = chars.len();
+    let start = start.min(len);
+    let end = end.min(len);
+    if start >= end {
+        return Spans::from(vec![Span::raw(line.to_string())]);
+    }
+
+    let before = chars[..start].iter().collect::<String>();
+    let selected = chars[start..end].iter().collect::<String>();
+    let after = chars[end..].iter().collect::<String>();
+    Spans::from(vec![
+        Span::raw(before),
+        Span::styled(selected, Style::default().add_modifier(Modifier::REVERSED)),
+        Span::raw(after),
+    ])
+}
+
+fn selected_text(mut selection: VisualSelection, lines: &[String], force_linewise: bool) -> String {
+    if lines.is_empty() {
+        return String::new();
+    }
+    if force_linewise {
+        selection.kind = VisualSelectionKind::Line;
+    }
+
+    let (row_start, row_end) = row_bounds(selection.anchor, selection.cursor);
+    let row_end = row_end.min(lines.len().saturating_sub(1));
+    let mut copied = Vec::new();
+    for row in row_start..=row_end {
+        let Some(line) = lines.get(row) else {
+            continue;
+        };
+        if selection.kind == VisualSelectionKind::Line {
+            copied.push(line.clone());
+        } else if let Some((start, end)) = selected_columns(selection, row, line) {
+            copied.push(line_slice(line, start, end));
+        }
+    }
+
+    let mut text = copied.join("\n");
+    if selection.kind == VisualSelectionKind::Line {
+        text.push('\n');
+    }
+    text
+}
+
+fn line_slice(line: &str, start: usize, end: usize) -> String {
+    line.chars()
+        .skip(start)
+        .take(end.saturating_sub(start))
+        .collect()
+}
