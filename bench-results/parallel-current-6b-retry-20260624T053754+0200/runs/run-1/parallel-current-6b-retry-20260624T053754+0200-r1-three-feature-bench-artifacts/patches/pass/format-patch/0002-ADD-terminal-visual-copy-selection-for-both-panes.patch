+    fn handle_visual_key(
+        &mut self,
+        key: UiKey,
+        right_content: &str,
+        right_cursor_column: Option<usize>,
+    ) -> Vec<UiAction> {
+        match key {
+            UiKey::Esc => {
+                self.clear_visual_selection();
+            }
+            UiKey::Char('v') => {
+                self.toggle_visual_selection(
+                    VisualSelectionKind::Character,
+                    right_content,
+                    right_cursor_column,
+                );
+            }
+            UiKey::Char('V') => {
+                self.toggle_visual_selection(
+                    VisualSelectionKind::Line,
+                    right_content,
+                    right_cursor_column,
+                );
+            }
+            UiKey::Char('\u{16}') => {
+                self.toggle_visual_selection(
+                    VisualSelectionKind::Block,
+                    right_content,
+                    right_cursor_column,
+                );
+            }
+            UiKey::Char('y') => {
+                self.copy_visual_selection(right_content, false);
+                self.clear_visual_selection();
+            }
+            UiKey::Char('Y') => {
+                self.copy_visual_selection(right_content, true);
+                self.clear_visual_selection();
+            }
+            UiKey::Char('h') | UiKey::Left => self.move_visual_cursor(0, -1, right_content),
+            UiKey::Char('j') | UiKey::Down => self.move_visual_cursor(1, 0, right_content),
+            UiKey::Char('k') | UiKey::Up => self.move_visual_cursor(-1, 0, right_content),
+            UiKey::Char('l') | UiKey::Right => self.move_visual_cursor(0, 1, right_content),
+            UiKey::MouseClick { .. }
+            | UiKey::MouseScrollUp { .. }
+            | UiKey::MouseScrollDown { .. } => self.clear_visual_selection(),
+            _ => {}
+        }
+        Vec::new()
+    }
+
+    fn start_visual_selection(
+        &mut self,
+        kind: VisualSelectionKind,
+        right_content: &str,
+        right_cursor_column: Option<usize>,
+    ) {
+        let point = self.visual_start_point(right_content, right_cursor_column);
+        self.visual_selection = Some(VisualSelection {
+            focus: self.focus,
+            kind,
+            anchor: point,
+            cursor: point,
+        });
+        self.mode = UiMode::Command;
+    }
+
+    fn toggle_visual_selection(
+        &mut self,
+        kind: VisualSelectionKind,
+        right_content: &str,
+        right_cursor_column: Option<usize>,
+    ) {
+        if self
+            .visual_selection
+            .is_some_and(|selection| selection.kind == kind)
+        {
+            self.clear_visual_selection();
+        } else if let Some(mut selection) = self.visual_selection {
+            selection.kind = kind;
+            self.visual_selection = Some(selection);
+        } else {
+            self.start_visual_selection(kind, right_content, right_cursor_column);
+        }
+    }
+
+    fn clear_visual_selection(&mut self) {
+        self.visual_selection = None;
+    }
+
+    fn visual_start_point(
+        &self,
+        right_content: &str,
+        right_cursor_column: Option<usize>,
+    ) -> TextPoint {
+        let lines = self.pane_text_lines(self.focus, right_content);
+        let row = (match self.focus {
+            PaneFocus::Left => self.left_control_selected_render_row(),
+            PaneFocus::Right => lines.len().saturating_sub(1),
+        })
+        .min(lines.len().saturating_sub(1));
+        let column = match self.focus {
+            PaneFocus::Left => 0,
+            PaneFocus::Right => right_cursor_column.unwrap_or(0),
+        };
+        clamp_text_point(TextPoint { row, column }, &lines)
+    }
+
+    fn move_visual_cursor(&mut self, row_delta: isize, column_delta: isize, right_content: &str) {
+        let Some(mut selection) = self.visual_selection else {
+            return;
+        };
+        let lines = self.pane_text_lines(selection.focus, right_content);
+        let max_row = lines.len().saturating_sub(1);
+        let next_row = add_signed(selection.cursor.row, row_delta).min(max_row);
+        let next_column = add_signed(selection.cursor.column, column_delta);
+        selection.cursor = clamp_text_point(
+            TextPoint {
+                row: next_row,
+                column: next_column,
+            },
+            &lines,
+        );
+        self.visual_selection = Some(selection);
+    }
+
+    fn pane_text_lines(&self, focus: PaneFocus, right_content: &str) -> Vec<String> {
+        match focus {
+            PaneFocus::Left => {
+                let inner_width = usize::from(self.layout().left_width.saturating_sub(2).max(1));
+                self.left_pane_widget_lines(inner_width)
+                    .into_iter()
+                    .map(|line| line.text)
+                    .collect()
+            }
+            PaneFocus::Right => pane_lines(&self.visible_right_content(right_content)),
+        }
+    }
