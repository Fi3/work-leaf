+#[test]
+fn controller_prompts_patch_agent_for_feature_done_after_clean_review() {
+    let root = git_repo("workspace-feature-done-confirmation");
+    fs::write(root.join("README.md"), "before\n").unwrap();
+    git(&root, ["add", "README.md"]);
+    git(&root, ["commit", "-m", "ADD initial readme fixture"]);
+    let backend = FakeBackend::new([
+        "implemented patch\n@work-leaf patch update readme\n--- a/README.md\n+++ b/README.md\n@@ -1 +1 @@\n-before\n+after\n@work-leaf end\n@work-leaf done",
+        "summary: README changes from before to after",
+        "NO_FINDINGS",
+    ]);
+    let chat = CommandChat::new(root, backend.clone()).with_max_review_rounds(4);
+    let mut controller = WorkLeafController::new(chat);
+
+    let agent_id = controller.create_agent("update readme").unwrap();
+
+    assert!(controller.wait_for_idle(Duration::from_secs(2)));
+    let snapshot = controller.snapshot();
+    let patch_agent = snapshot.session(&agent_id).expect("patch agent exists");
+    assert!(patch_agent.feature_done_confirmation);
+    assert!(
+        patch_agent
+            .lines
+            .iter()
+            .any(|line| { line.starts_with("work-leaf: is this feature done? yes/no") })
+    );
+
+    let sends_before_yes = backend.sends();
+    controller.send_message(&agent_id, "yes").unwrap();
+
+    let snapshot = controller.snapshot();
+    let patch_agent = snapshot.session(&agent_id).expect("patch agent exists");
+    assert!(!patch_agent.feature_done_confirmation);
+    assert!(patch_agent.lines.iter().any(|line| line == "user: yes"));
+    assert!(
+        patch_agent
+            .lines
+            .iter()
+            .any(|line| line == "work-leaf: feature marked done")
+    );
+    assert_eq!(
+        backend.sends(),
+        sends_before_yes,
+        "yes should close the confirmation without resuming the agent"
+    );
+}
+
+#[test]
+fn controller_reopens_reviewed_patch_agent_when_user_types_follow_up() {
+    let root = git_repo("workspace-feature-done-reopen");
+    fs::write(root.join("README.md"), "before\n").unwrap();
+    git(&root, ["add", "README.md"]);
+    git(&root, ["commit", "-m", "ADD initial readme fixture"]);
+    let backend = FakeBackend::new([
+        "implemented patch\n@work-leaf patch update readme\n--- a/README.md\n+++ b/README.md\n@@ -1 +1 @@\n-before\n+after\n@work-leaf end\n@work-leaf done",
+        "summary: README changes from before to after",
+        "NO_FINDINGS",
+        "follow-up reply",
+    ]);
+    let chat = CommandChat::new(root, backend.clone()).with_max_review_rounds(4);
+    let mut controller = WorkLeafController::new(chat);
+
+    let agent_id = controller.create_agent("update readme").unwrap();
+
+    assert!(controller.wait_for_idle(Duration::from_secs(2)));
+    let sends_before_follow_up = backend.sends().len();
+    controller
+        .send_message(&agent_id, "not yet; adjust the wording")
+        .unwrap();
+    assert!(controller.wait_for_idle(Duration::from_secs(2)));
+
+    let sends = backend.sends();
+    assert!(
+        sends
+            .iter()
+            .skip(sends_before_follow_up)
+            .any(|(target, prompt)| {
+                target == &agent_id && prompt == "not yet; adjust the wording"
+            })
+    );
+    let snapshot = controller.snapshot();
+    let patch_agent = snapshot.session(&agent_id).expect("patch agent exists");
+    assert!(!patch_agent.feature_done_confirmation);
+    assert!(
+        patch_agent
+            .lines
+            .iter()
+            .any(|line| line == "user: not yet; adjust the wording")
+    );
+    assert!(
+        patch_agent
+            .lines
+            .iter()
+            .any(|line| line == "follow-up reply")
+    );
+    assert!(
+        !patch_agent
+            .lines
+            .iter()
+            .any(|line| line == "work-leaf: feature marked done")
+    );
+}
