+
+    fn confirm_feature_done(&mut self, agent_id: &AgentId, message: &str) -> bool {
+        if !self.session_feature_done_confirmation(agent_id) {
+            return false;
+        }
+        if !is_yes_confirmation(message) {
+            self.set_feature_done_confirmation(agent_id, false);
+            return false;
+        }
+
+        self.set_feature_done_confirmation(agent_id, false);
+        self.append_agent_line(agent_id, format!("user: {message}"));
+        self.append_agent_line(agent_id, FEATURE_DONE_CONFIRMED.to_string());
+        true
+    }
+
+    fn session_feature_done_confirmation(&self, agent_id: &AgentId) -> bool {
+        self.sessions
+            .get(agent_id)
+            .is_some_and(|session| session.feature_done_confirmation)
+    }
+
+    fn set_feature_done_confirmation(
+        &mut self,
+        agent_id: &AgentId,
+        feature_done_confirmation: bool,
+    ) {
+        let fallback_kind = self.agent_kind();
+        if !self.sessions.contains_key(agent_id) {
+            let session = WorkLeafSession::unknown(agent_id.clone(), fallback_kind);
+            self.sessions.insert(agent_id.clone(), session.clone());
+            self.pending_events
+                .push(WorkLeafEvent::AgentAdded { session });
+        }
+        let session = self
+            .sessions
+            .get_mut(agent_id)
+            .expect("session was inserted before updating feature-done confirmation");
+        if session.feature_done_confirmation == feature_done_confirmation {
+            return;
+        }
+        session.feature_done_confirmation = feature_done_confirmation;
+        self.pending_events.push(WorkLeafEvent::AgentUpdated {
+            session: session.clone(),
+        });
+    }
