+fn selected_visual_text(
+    lines: &[String],
+    selection: VisualSelection,
+    force_linewise: bool,
+) -> String {
+    if lines.is_empty() {
+        return String::new();
+    }
+    let (start_row, end_row) =
+        ordered_rows(selection.anchor.row, selection.cursor.row, lines.len());
+    if force_linewise || selection.mode == VisualSelectionMode::Line {
+        return lines[start_row..=end_row].join("\n");
+    }
+
+    match selection.mode {
+        VisualSelectionMode::Line => lines[start_row..=end_row].join("\n"),
+        VisualSelectionMode::Block => {
+            let (start_column, end_column) =
+                ordered_columns(selection.anchor.column, selection.cursor.column);
+            lines[start_row..=end_row]
+                .iter()
+                .map(|line| slice_chars(line, start_column, end_column.saturating_add(1)))
+                .collect::<Vec<_>>()
+                .join("\n")
+        }
+        VisualSelectionMode::Character => {
+            let anchor = selection.anchor;
+            let cursor = selection.cursor;
+            let (start, end) = if (anchor.row, anchor.column) <= (cursor.row, cursor.column) {
+                (anchor, cursor)
+            } else {
+                (cursor, anchor)
+            };
+            (start.row..=end.row)
+                .map(|row| {
+                    let line = &lines[row];
+                    if start.row == end.row {
+                        slice_chars(line, start.column, end.column.saturating_add(1))
+                    } else if row == start.row {
+                        slice_chars(line, start.column, line.chars().count())
+                    } else if row == end.row {
+                        slice_chars(line, 0, end.column.saturating_add(1))
+                    } else {
+                        line.clone()
+                    }
+                })
+                .collect::<Vec<_>>()
+                .join("\n")
+        }
+    }
+}
+
+fn selected_visual_columns(
+    selection: VisualSelection,
+    row: usize,
+    line: &str,
+    width: usize,
+) -> Option<(usize, usize)> {
+    let (start_row, end_row) = ordered_rows(selection.anchor.row, selection.cursor.row, usize::MAX);
+    if row < start_row || row > end_row {
+        return None;
+    }
+
+    match selection.mode {
+        VisualSelectionMode::Line => Some((0, width)),
+        VisualSelectionMode::Block => {
+            let (start, end) = ordered_columns(selection.anchor.column, selection.cursor.column);
+            (start < width).then_some((start, end.saturating_add(1).min(width)))
+        }
+        VisualSelectionMode::Character => {
+            let anchor = selection.anchor;
+            let cursor = selection.cursor;
+            let (start, end) = if (anchor.row, anchor.column) <= (cursor.row, cursor.column) {
+                (anchor, cursor)
+            } else {
+                (cursor, anchor)
+            };
+            let line_width = line.chars().count().max(1).min(width);
+            if start.row == end.row {
+                Some((
+                    start.column.min(line_width.saturating_sub(1)),
+                    end.column.saturating_add(1).min(line_width),
+                ))
+            } else if row == start.row {
+                Some((start.column.min(line_width.saturating_sub(1)), line_width))
+            } else if row == end.row {
+                Some((0, end.column.saturating_add(1).min(line_width)))
+            } else {
+                Some((0, line_width))
+            }
+        }
+    }
+}
+
+fn ordered_rows(left: usize, right: usize, line_count: usize) -> (usize, usize) {
+    let last = line_count.saturating_sub(1);
+    let start = left.min(right).min(last);
+    let end = left.max(right).min(last);
+    (start, end)
+}
+
+fn ordered_columns(left: usize, right: usize) -> (usize, usize) {
+    (left.min(right), left.max(right))
+}
+
+fn slice_chars(line: &str, start: usize, end: usize) -> String {
+    line.chars()
+        .skip(start)
+        .take(end.saturating_sub(start))
+        .collect()
+}
