+    fn start_or_switch_visual_selection(&mut self, mode: VisualSelectionMode) {
+        if self.mode != UiMode::Command {
+            return;
+        }
+        if let Some(selection) = self.visual_selection.as_mut() {
+            selection.mode = mode;
+            return;
+        }
+        let pane = self.focused_visual_pane();
+        let position = self.visual_start_position(pane);
+        self.visual_selection = Some(VisualSelection {
+            pane,
+            mode,
+            anchor: position,
+            cursor: position,
+        });
+    }
+
+    fn focused_visual_pane(&self) -> PaneFocus {
+        if self.focus == PaneFocus::Left && self.left_visible {
+            PaneFocus::Left
+        } else {
+            PaneFocus::Right
+        }
+    }
+
+    fn visual_start_position(&self, pane: PaneFocus) -> VisualPosition {
+        match pane {
+            PaneFocus::Left => VisualPosition {
+                row: self.left_visual_selected_row(),
+                column: 0,
+            },
+            PaneFocus::Right => {
+                let lines = self.visual_pane_lines(PaneFocus::Right);
+                let row = lines.len().saturating_sub(1);
+                let column = lines
+                    .get(row)
+                    .map(|line| line.chars().count().saturating_sub(1))
+                    .unwrap_or_default();
+                VisualPosition { row, column }
+            }
+        }
+    }
+
+    fn clear_visual_selection(&mut self) {
