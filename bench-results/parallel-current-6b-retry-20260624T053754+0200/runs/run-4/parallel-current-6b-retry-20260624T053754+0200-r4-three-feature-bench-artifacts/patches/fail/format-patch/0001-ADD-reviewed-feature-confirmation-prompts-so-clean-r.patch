+#[test]
+fn controller_closes_reviewed_feature_on_yes_and_reopens_on_follow_up() {
+    let root = git_repo("workspace-feature-done-confirmation");
+    fs::write(root.join("README.md"), "before\n").unwrap();
+    git(&root, ["add", "README.md"]);
+    git(
+        &root,
+        ["commit", "-m", "ADD initial feature confirmation fixture"],
+    );
+    let backend = FakeBackend::new([
+        "implemented patch\n@work-leaf patch update readme\n--- a/README.md\n+++ b/README.md\n@@ -1 +1 @@\n-before\n+after\n@work-leaf end\n@work-leaf done",
+        "summary: README changes from before to after",
+        "NO_FINDINGS",
+        "follow-up reply",
+    ]);
+    let chat = CommandChat::new(root, backend.clone()).with_max_review_rounds(4);
+    let mut controller = WorkLeafController::new(chat);
+
+    let agent_id = controller.create_agent("update readme").unwrap();
+
+    assert!(controller.wait_for_idle(Duration::from_secs(2)));
+    let sends_after_review = backend.sends().len();
+    let snapshot = controller.snapshot();
+    let session = snapshot.session(&agent_id).expect("patch agent exists");
+    assert!(
+        session
+            .lines
+            .iter()
+            .any(|line| line == "work-leaf: is this feature done? yes/no")
+    );
+
+    controller.send_message(&agent_id, "yes").unwrap();
+
+    assert_eq!(
+        backend.sends().len(),
+        sends_after_review,
+        "answering yes should close the feature without sending to the agent backend"
+    );
+    let snapshot = controller.snapshot();
+    let session = snapshot.session(&agent_id).expect("patch agent exists");
+    assert!(session.lines.iter().any(|line| line == "user: yes"));
+    assert!(
+        session
+            .lines
+            .iter()
+            .any(|line| line == "work-leaf: feature marked done")
+    );
+
+    controller
+        .send_message(&agent_id, "add final polish")
+        .unwrap();
+    assert!(controller.wait_for_idle(Duration::from_secs(2)));
+
+    let snapshot = controller.snapshot();
+    let session = snapshot.session(&agent_id).expect("patch agent exists");
+    assert!(
+        session
+            .lines
+            .iter()
+            .any(|line| line == "work-leaf: feature reopened")
+    );
+    assert!(
+        session
+            .lines
+            .iter()
+            .any(|line| line == "user: add final polish")
+    );
+    assert!(session.lines.iter().any(|line| line == "follow-up reply"));
+    assert!(
+        backend
+            .sends()
+            .iter()
+            .any(|(target, prompt)| { target == &agent_id && prompt == "add final polish" })
+    );
+}
