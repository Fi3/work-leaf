+#[test]
+fn terminal_app_prompts_and_closes_patch_chat_after_review_then_reopens_on_typing() {
+    let root = git_repo("terminal-app-feature-done-prompt");
+    fs::write(root.join("README.md"), "before\n").unwrap();
+    Command::new("git")
+        .current_dir(&root)
+        .args(["add", "README.md"])
+        .status()
+        .unwrap();
+    Command::new("git")
+        .current_dir(&root)
+        .args(["commit", "-m", "ADD initial feature done fixture"])
+        .status()
+        .unwrap();
+    let backend = FakeBackend::new([
+        "implemented patch\n@work-leaf patch update readme\n--- a/README.md\n+++ b/README.md\n@@ -1 +1 @@\n-before\n+after\n@work-leaf end\n@work-leaf done",
+        "summary: README changes from before to after",
+        "NO_FINDINGS",
+        "follow-up reply",
+    ]);
+    let chat = CommandChat::new(root, backend.clone()).with_max_review_rounds(4);
+    let mut app = TerminalApp::new(chat, 100, 24);
+
+    app.handle_bytes(b":new update readme\n");
+    assert!(app.wait_for_idle(Duration::from_secs(2)));
+
+    let reviewed_frame = app.render_frame();
+    assert_eq!(
+        app.ui().selected_agent().map(AgentId::as_str),
+        Some("user-1")
+    );
+    assert!(reviewed_frame.contains("work-leaf: is this feature done? yes/no"));
+    assert!(
+        app.ui()
+            .render_left_pane()
+            .contains("\u{1b}[7m>chat-title user-1  working: chat-title  READY\u{1b}[0m")
+    );
+
+    app.handle_bytes(b"yes\n");
+
+    assert_eq!(app.ui().selected_agent().map(AgentId::as_str), None);
+    assert!(!app.ui().render_left_pane().contains("chat-title user-1"));
+    assert_eq!(backend.sends().len(), 1);
+
+    app.handle_bytes(b"add final polish\n");
+    assert!(app.wait_for_idle(Duration::from_secs(2)));
+
+    let reopened_frame = app.render_frame();
+    assert_eq!(
+        app.ui().selected_agent().map(AgentId::as_str),
+        Some("user-1")
+    );
+    assert!(app.ui().render_left_pane().contains("user-1"));
+    assert!(reopened_frame.contains("work-leaf: feature reopened"));
+    assert!(reopened_frame.contains("user: add final polish"));
+    assert!(reopened_frame.contains("follow-up reply"));
+    assert!(backend.sends().iter().any(|(agent_id, prompt)| {
+        agent_id.as_str() == "user-1" && prompt == "add final polish"
+    }));
+}
