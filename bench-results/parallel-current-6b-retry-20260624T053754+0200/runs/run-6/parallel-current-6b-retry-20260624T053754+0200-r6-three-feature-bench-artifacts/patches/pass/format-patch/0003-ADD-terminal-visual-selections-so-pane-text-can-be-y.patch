+
+fn add_signed(value: usize, delta: isize) -> usize {
+    if delta < 0 {
+        value.saturating_sub(delta.unsigned_abs())
+    } else {
+        value.saturating_add(delta as usize)
+    }
+}
+
+fn clamp_text_position(
+    kind: VisualSelectionKind,
+    position: TextPosition,
+    lines: &[String],
+) -> TextPosition {
+    let row = position.row.min(lines.len().saturating_sub(1));
+    let column = match kind {
+        VisualSelectionKind::Line => 0,
+        VisualSelectionKind::Character => position
+            .column
+            .min(last_char_column(lines.get(row).map_or("", String::as_str))),
+        VisualSelectionKind::Block => position.column.min(max_last_char_column(lines)),
+    };
+    TextPosition { row, column }
+}
+
+fn last_char_column(line: &str) -> usize {
+    line.chars().count().saturating_sub(1)
+}
+
+fn max_last_char_column(lines: &[String]) -> usize {
+    lines
+        .iter()
+        .map(|line| last_char_column(line))
+        .max()
+        .unwrap_or_default()
+}
+
+fn selected_text(selection: VisualSelection, lines: &[String]) -> String {
+    selected_ranges(selection, lines)
+        .into_iter()
+        .map(|(row, start, end)| char_slice(&lines[row], start, end))
+        .collect::<Vec<_>>()
+        .join("\n")
+}
+
+fn selected_ranges(selection: VisualSelection, lines: &[String]) -> Vec<(usize, usize, usize)> {
+    if lines.is_empty() {
+        return Vec::new();
+    }
+    let anchor = clamp_text_position(selection.kind, selection.anchor, lines);
+    let cursor = clamp_text_position(selection.kind, selection.cursor, lines);
+    match selection.kind {
+        VisualSelectionKind::Character => character_selected_ranges(anchor, cursor, lines),
+        VisualSelectionKind::Line => line_selected_ranges(anchor, cursor, lines),
+        VisualSelectionKind::Block => block_selected_ranges(anchor, cursor, lines),
+    }
+}
+
+fn character_selected_ranges(
+    anchor: TextPosition,
+    cursor: TextPosition,
+    lines: &[String],
+) -> Vec<(usize, usize, usize)> {
+    let (start, end) = ordered_positions(anchor, cursor);
+    (start.row..=end.row)
+        .map(|row| {
+            let line_len = lines[row].chars().count();
+            if line_len == 0 {
+                return (row, 0, 0);
+            }
+            let start_column = if row == start.row {
+                start.column.min(line_len - 1)
+            } else {
+                0
+            };
+            let end_column = if row == end.row {
+                end.column.min(line_len - 1)
+            } else {
+                line_len - 1
+            };
+            (row, start_column, end_column.saturating_add(1))
+        })
+        .collect()
+}
+
+fn line_selected_ranges(
+    anchor: TextPosition,
+    cursor: TextPosition,
+    lines: &[String],
+) -> Vec<(usize, usize, usize)> {
+    let start = anchor.row.min(cursor.row);
+    let end = anchor.row.max(cursor.row);
+    (start..=end)
+        .map(|row| (row, 0, lines[row].chars().count()))
+        .collect()
+}
+
+fn block_selected_ranges(
+    anchor: TextPosition,
+    cursor: TextPosition,
+    lines: &[String],
+) -> Vec<(usize, usize, usize)> {
+    let start_row = anchor.row.min(cursor.row);
+    let end_row = anchor.row.max(cursor.row);
+    let start_column = anchor.column.min(cursor.column);
+    let end_column = anchor.column.max(cursor.column).saturating_add(1);
+    (start_row..=end_row)
+        .map(|row| {
+            let line_len = lines[row].chars().count();
+            (row, start_column.min(line_len), end_column.min(line_len))
+        })
+        .collect()
+}
+
+fn ordered_positions(left: TextPosition, right: TextPosition) -> (TextPosition, TextPosition) {
+    if left.row < right.row || (left.row == right.row && left.column <= right.column) {
+        (left, right)
+    } else {
+        (right, left)
+    }
+}
+
+fn char_slice(text: &str, start: usize, end: usize) -> String {
+    let start = byte_index_for_char(text, start);
+    let end = byte_index_for_char(text, end);
+    text[start..end].to_string()
+}
+
+fn byte_index_for_char(text: &str, char_index: usize) -> usize {
+    text.char_indices()
+        .nth(char_index)
+        .map(|(index, _)| index)
+        .unwrap_or(text.len())
+}
+
+fn visual_row_offsets(lines: &[String], width: usize) -> Vec<usize> {
+    let mut offsets = Vec::with_capacity(lines.len());
+    let mut next_offset = 0_usize;
+    for line in lines {
+        offsets.push(next_offset);
+        next_offset = next_offset.saturating_add(visual_row_count(line, width as u16));
+    }
+    offsets
+}
+
+fn set_reversed(buffer: &mut Buffer, x: u16, y: u16) {
+    if x >= buffer.area.width || y >= buffer.area.height {
+        return;
+    }
+    buffer.get_mut(x, y).modifier.insert(Modifier::REVERSED);
+}
