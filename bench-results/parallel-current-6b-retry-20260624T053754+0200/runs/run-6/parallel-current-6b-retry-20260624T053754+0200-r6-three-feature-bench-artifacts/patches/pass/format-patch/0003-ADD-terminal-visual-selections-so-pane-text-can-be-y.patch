+    fn handle_visual_key(&mut self, key: UiKey, right_content: &str) -> Vec<UiAction> {
+        match key {
+            UiKey::Esc => {
+                self.clear_visual_selection();
+                self.mode = UiMode::Command;
+                Vec::new()
+            }
+            UiKey::Char('v') => {
+                self.change_visual_selection_kind(VisualSelectionKind::Character, right_content);
+                Vec::new()
+            }
+            UiKey::Char('V') => {
+                self.change_visual_selection_kind(VisualSelectionKind::Line, right_content);
+                Vec::new()
+            }
+            UiKey::CtrlV => {
+                self.change_visual_selection_kind(VisualSelectionKind::Block, right_content);
+                Vec::new()
+            }
+            UiKey::Char('y') | UiKey::Char('Y') => self.copy_visual_selection(right_content),
+            UiKey::Char('h') | UiKey::Left => {
+                self.move_visual_selection(0, -1, right_content);
+                Vec::new()
+            }
+            UiKey::Char('j') | UiKey::Down => {
+                self.move_visual_selection(1, 0, right_content);
+                Vec::new()
+            }
+            UiKey::Char('k') | UiKey::Up => {
+                self.move_visual_selection(-1, 0, right_content);
+                Vec::new()
+            }
+            UiKey::Char('l') | UiKey::Right => {
+                self.move_visual_selection(0, 1, right_content);
+                Vec::new()
+            }
+            _ => Vec::new(),
+        }
+    }
+
+    fn start_visual_selection(
+        &mut self,
+        kind: VisualSelectionKind,
+        right_content: &str,
+    ) -> Vec<UiAction> {
+        let lines = self.text_lines_for_pane(self.focus, right_content);
+        let position = self.current_text_position(self.focus, kind, &lines);
+        self.visual_selection = Some(VisualSelection {
+            pane: self.focus,
+            kind,
+            anchor: position,
+            cursor: position,
+        });
+        self.mode = kind.ui_mode();
+        Vec::new()
+    }
+
+    fn change_visual_selection_kind(&mut self, kind: VisualSelectionKind, right_content: &str) {
+        let Some(selection) = self.visual_selection else {
+            let _ = self.start_visual_selection(kind, right_content);
+            return;
+        };
+        let lines = self.text_lines_for_pane(selection.pane, right_content);
+        self.visual_selection = Some(VisualSelection {
+            pane: selection.pane,
+            kind,
+            anchor: clamp_text_position(kind, selection.anchor, &lines),
+            cursor: clamp_text_position(kind, selection.cursor, &lines),
+        });
+        self.mode = kind.ui_mode();
+    }
+
+    fn move_visual_selection(
+        &mut self,
+        row_delta: isize,
+        column_delta: isize,
+        right_content: &str,
+    ) {
+        let Some(selection) = self.visual_selection else {
+            return;
+        };
+        let lines = self.text_lines_for_pane(selection.pane, right_content);
+        let next = TextPosition {
+            row: add_signed(selection.cursor.row, row_delta),
+            column: add_signed(selection.cursor.column, column_delta),
+        };
+        if let Some(active) = self.visual_selection.as_mut() {
+            active.cursor = clamp_text_position(active.kind, next, &lines);
+        }
+    }
+
+    fn copy_visual_selection(&mut self, right_content: &str) -> Vec<UiAction> {
+        let Some(selection) = self.visual_selection else {
+            return Vec::new();
+        };
+        let lines = self.text_lines_for_pane(selection.pane, right_content);
+        let text = selected_text(selection, &lines);
+        self.clear_visual_selection();
+        self.mode = UiMode::Command;
+        self.show_copy_notice(&text);
+        vec![UiAction::CopySelection(text)]
+    }
+
+    fn copy_current_line(&mut self, right_content: &str) -> Vec<UiAction> {
+        let lines = self.text_lines_for_pane(self.focus, right_content);
+        let position = self.current_text_position(self.focus, VisualSelectionKind::Line, &lines);
+        let text = lines.get(position.row).cloned().unwrap_or_default();
+        self.show_copy_notice(&text);
+        vec![UiAction::CopySelection(text)]
+    }
+
+    fn show_copy_notice(&mut self, text: &str) {
+        self.show_status_notice(
+            format!("copied {} chars", text.chars().count()),
+            Duration::from_secs(STATUS_NOTICE_SECONDS),
