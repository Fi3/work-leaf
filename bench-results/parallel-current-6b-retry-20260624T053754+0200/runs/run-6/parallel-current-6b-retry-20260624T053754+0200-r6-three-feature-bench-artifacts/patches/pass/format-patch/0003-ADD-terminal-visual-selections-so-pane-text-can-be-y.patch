+
+    fn clear_visual_selection(&mut self) {
+        self.visual_selection = None;
+    }
+
+    fn text_lines_for_pane(&self, pane: PaneFocus, right_content: &str) -> Vec<String> {
+        match pane {
+            PaneFocus::Left => self.left_text_lines(),
+            PaneFocus::Right => self.right_visible_text_lines(right_content),
+        }
+    }
+
+    fn right_visible_text_lines(&self, right_content: &str) -> Vec<String> {
+        text_lines(&self.visible_right_content(right_content))
+    }
+
+    fn left_text_lines(&self) -> Vec<String> {
+        let inner_width = usize::from(self.layout().left_width.saturating_sub(2).max(1));
+        let mut lines = vec![truncate_to_width(
+            if self.control_selected == 0 {
+                "> work-leaf  command"
+            } else {
+                "  work-leaf  command"
+            },
+            inner_width,
+        )];
+        for (visible_position, agent_index) in self.visible_agent_indices().iter().enumerate() {
+            let agent = &self.agents[*agent_index];
+            lines.push(compact_agent_row(
+                agent,
+                self.control_selected == visible_position + 1,
+                inner_width,
+            ));
+            if !agent.modified_files.is_empty() {
+                lines.push(truncate_to_width(
+                    &format!(
+                        "    files: {}",
+                        agent
+                            .modified_files
+                            .iter()
+                            .map(|path| path.display().to_string())
+                            .collect::<Vec<_>>()
+                            .join(", ")
+                    ),
+                    inner_width,
+                ));
+            }
+            for (label, agents) in [
+                ("conflicts", &agent.conflicting_agents),
+                ("depends-on", &agent.depends_on),
+                ("depended-on-by", &agent.depended_on_by),
+            ] {
+                if !agents.is_empty() {
+                    lines.push(truncate_to_width(
+                        &format!(
+                            "    {label}: {}",
+                            agents
+                                .iter()
+                                .map(AgentId::as_str)
+                                .collect::<Vec<_>>()
+                                .join(", ")
+                        ),
+                        inner_width,
+                    ));
+                }
+            }
+        }
+        lines
+    }
+
+    fn current_text_position(
+        &self,
+        pane: PaneFocus,
+        kind: VisualSelectionKind,
+        lines: &[String],
+    ) -> TextPosition {
+        let row = match pane {
+            PaneFocus::Left => self.left_control_text_row(),
+            PaneFocus::Right => lines.len().saturating_sub(1),
+        };
+        let row = row.min(lines.len().saturating_sub(1));
