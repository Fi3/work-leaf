+pub(crate) fn backend_command_message(message: &str) -> Option<&str> {
+    let trimmed = message.trim();
+    let rest = trimmed.strip_prefix('/')?;
+    let first = rest.chars().next()?;
+    if first.is_whitespace() {
+        return None;
+    }
+    Some(trimmed)
+}
