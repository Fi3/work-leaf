+fn apply_visual_delta(value: usize, delta: isize, max: usize) -> usize {
+    let next = if delta < 0 {
+        value.saturating_sub((-delta) as usize)
+    } else {
+        value.saturating_add(delta as usize)
+    };
+    next.min(max)
+}
