+fn clamp_visual_position(lines: &[String], position: VisualPosition) -> VisualPosition {
+    if lines.is_empty() {
+        return VisualPosition { row: 0, column: 0 };
+    }
+    let row = position.row.min(lines.len() - 1);
+    let max_column = lines[row].chars().count().saturating_sub(1);
+    VisualPosition {
+        row,
+        column: position.column.min(max_column),
+    }
+}
+
+fn selected_visual_text(selection: VisualSelection, force_line: bool, lines: &[String]) -> String {
+    if lines.is_empty() {
+        return String::new();
+    }
+    let selection = VisualSelection {
+        anchor: clamp_visual_position(lines, selection.anchor),
+        cursor: clamp_visual_position(lines, selection.cursor),
+        ..selection
+    };
+    let kind = if force_line {
+        VisualKind::Line
+    } else {
+        selection.kind
+    };
+    match kind {
+        VisualKind::Character => selected_character_text(selection.anchor, selection.cursor, lines),
+        VisualKind::Line => selected_line_text(selection.anchor, selection.cursor, lines),
+        VisualKind::Block => selected_block_text(selection.anchor, selection.cursor, lines),
+    }
+}
+
+fn selected_character_text(
+    anchor: VisualPosition,
+    cursor: VisualPosition,
+    lines: &[String],
+) -> String {
+    let (start, end) = ordered_visual_positions(anchor, cursor);
+    let mut selected = Vec::new();
+    for (row, line) in lines.iter().enumerate().take(end.row + 1).skip(start.row) {
+        if row == start.row && row == end.row {
+            selected.push(char_slice_inclusive(line, start.column, end.column));
+        } else if row == start.row {
+            selected.push(line.chars().skip(start.column).collect::<String>());
+        } else if row == end.row {
+            selected.push(char_slice_prefix_inclusive(line, end.column));
+        } else {
+            selected.push(line.clone());
+        }
+    }
+    selected.join("\n")
+}
+
+fn selected_line_text(anchor: VisualPosition, cursor: VisualPosition, lines: &[String]) -> String {
+    let start = anchor.row.min(cursor.row);
+    let end = anchor.row.max(cursor.row);
+    lines[start..=end].join("\n")
+}
+
+fn selected_block_text(anchor: VisualPosition, cursor: VisualPosition, lines: &[String]) -> String {
+    let start_row = anchor.row.min(cursor.row);
+    let end_row = anchor.row.max(cursor.row);
+    let start_column = anchor.column.min(cursor.column);
+    let end_column = anchor.column.max(cursor.column);
+    (start_row..=end_row)
+        .map(|row| char_slice_inclusive(&lines[row], start_column, end_column))
+        .collect::<Vec<_>>()
+        .join("\n")
+}
+
+fn selected_visual_ranges(
+    selection: VisualSelection,
+    lines: &[String],
+    width: usize,
+) -> Vec<(usize, usize, usize)> {
+    if lines.is_empty() || width == 0 {
+        return Vec::new();
+    }
+    let selection = VisualSelection {
+        anchor: clamp_visual_position(lines, selection.anchor),
+        cursor: clamp_visual_position(lines, selection.cursor),
+        ..selection
+    };
+    match selection.kind {
+        VisualKind::Character => character_visual_ranges(selection.anchor, selection.cursor, lines),
+        VisualKind::Line => {
+            let start = selection.anchor.row.min(selection.cursor.row);
+            let end = selection.anchor.row.max(selection.cursor.row);
+            (start..=end).map(|row| (row, 0, width)).collect()
+        }
+        VisualKind::Block => {
+            let start_row = selection.anchor.row.min(selection.cursor.row);
+            let end_row = selection.anchor.row.max(selection.cursor.row);
+            let start_column = selection.anchor.column.min(selection.cursor.column);
+            let end_column = selection.anchor.column.max(selection.cursor.column);
+            (start_row..=end_row)
+                .map(|row| {
+                    (
+                        row,
+                        start_column.min(width),
+                        end_column.saturating_add(1).min(width),
+                    )
+                })
+                .collect()
+        }
+    }
+}
+
+fn character_visual_ranges(
+    anchor: VisualPosition,
+    cursor: VisualPosition,
+    lines: &[String],
+) -> Vec<(usize, usize, usize)> {
+    let (start, end) = ordered_visual_positions(anchor, cursor);
+    let mut ranges = Vec::new();
+    for (row, line) in lines.iter().enumerate().take(end.row + 1).skip(start.row) {
+        let line_len = line.chars().count();
+        let (range_start, range_end) = if row == start.row && row == end.row {
+            (start.column, end.column.saturating_add(1))
+        } else if row == start.row {
+            (start.column, line_len)
+        } else if row == end.row {
+            (0, end.column.saturating_add(1))
+        } else {
+            (0, line_len)
+        };
+        if range_start < range_end {
+            ranges.push((row, range_start, range_end));
+        }
+    }
+    ranges
+}
+
+fn ordered_visual_positions(
+    left: VisualPosition,
+    right: VisualPosition,
+) -> (VisualPosition, VisualPosition) {
+    if (left.row, left.column) <= (right.row, right.column) {
+        (left, right)
+    } else {
+        (right, left)
+    }
+}
+
+fn char_slice_inclusive(text: &str, start: usize, end: usize) -> String {
+    let len = text.chars().count();
+    if len == 0 || start >= len {
+        return String::new();
+    }
+    let end = end.min(len - 1);
+    if start > end {
+        return String::new();
+    }
+    text.chars().skip(start).take(end - start + 1).collect()
+}
+
+fn char_slice_prefix_inclusive(text: &str, end: usize) -> String {
+    let len = text.chars().count();
+    if len == 0 {
+        return String::new();
+    }
+    text.chars().take(end.min(len - 1) + 1).collect()
+}
+
+fn base64_encode(bytes: &[u8]) -> String {
+    const TABLE: &[u8; 64] = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    let mut output = String::new();
+    for chunk in bytes.chunks(3) {
+        let first = chunk[0];
+        let second = *chunk.get(1).unwrap_or(&0);
+        let third = *chunk.get(2).unwrap_or(&0);
+        output.push(TABLE[(first >> 2) as usize] as char);
+        output.push(TABLE[(((first & 0b0000_0011) << 4) | (second >> 4)) as usize] as char);
+        if chunk.len() > 1 {
+            output.push(TABLE[(((second & 0b0000_1111) << 2) | (third >> 6)) as usize] as char);
+        } else {
+            output.push('=');
+        }
+        if chunk.len() > 2 {
+            output.push(TABLE[(third & 0b0011_1111) as usize] as char);
+        } else {
+            output.push('=');
+        }
+    }
+    output
+}
