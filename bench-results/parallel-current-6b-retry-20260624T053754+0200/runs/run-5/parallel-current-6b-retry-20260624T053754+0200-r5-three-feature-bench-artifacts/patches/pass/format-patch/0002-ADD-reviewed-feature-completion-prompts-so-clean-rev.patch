+        Some("user-2")
+    );
+    harness
+        .finish_review_for_selected_agent()
+        .expect("fixture selected agent can finish review");
+
+    let prompted = harness.render_frame();
+    assert!(prompted.starts_with('\u{7}'));
+    assert!(prompted.contains("work-leaf: review is done. Is this feature done? yes/no"));
+    assert!(prompted.contains("\u{1b}[7m>test user-2 READY\u{1b}[0m"));
