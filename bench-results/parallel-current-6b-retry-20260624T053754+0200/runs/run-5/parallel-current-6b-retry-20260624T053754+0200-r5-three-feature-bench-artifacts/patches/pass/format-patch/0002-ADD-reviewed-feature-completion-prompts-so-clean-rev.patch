+pub(crate) const FEATURE_DONE_CONFIRMATION_PROMPT: &str =
+    "work-leaf: review is done. Is this feature done? yes/no";
+pub(crate) const FEATURE_DONE_CLOSED_REPLY: &str = "work-leaf: feature marked done";
+pub(crate) const FEATURE_DONE_OPEN_REPLY: &str =
+    "work-leaf: feature left open; send another message to continue";
+pub(crate) const FEATURE_DONE_REOPENED_REPLY: &str = "work-leaf: reopening feature";
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+enum FeatureDoneConfirmationAnswer {
+    Yes,
+    No,
+    FollowUp,
+}
+
+pub(crate) fn is_feature_done_confirmation_yes(message: &str) -> bool {
+    matches!(
+        feature_done_confirmation_answer(message),
+        FeatureDoneConfirmationAnswer::Yes
+    )
+}
+
+fn feature_done_confirmation_answer(message: &str) -> FeatureDoneConfirmationAnswer {
+    match message.trim().to_ascii_lowercase().as_str() {
+        "yes" | "y" => FeatureDoneConfirmationAnswer::Yes,
+        "no" | "n" => FeatureDoneConfirmationAnswer::No,
+        _ => FeatureDoneConfirmationAnswer::FollowUp,
+    }
+}
