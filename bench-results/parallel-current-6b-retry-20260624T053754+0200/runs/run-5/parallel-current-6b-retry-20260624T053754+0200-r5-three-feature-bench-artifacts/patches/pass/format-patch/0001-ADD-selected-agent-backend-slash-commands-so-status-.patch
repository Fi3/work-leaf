+        &mut self,
+        agent_id: &AgentId,
+        command: &str,
+        _sink: &mut dyn FnMut(AgentStreamEvent),
+    ) -> Result<ChatMessage, AgentError> {
+        self.execute_command(agent_id, command)
+    }
 }
 
