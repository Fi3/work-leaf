         assert_eq!(ui.mode(), UiMode::Insert);
     }
+
+    #[test]
+    fn selected_agent_backend_command_requires_slash_and_token() {
+        assert_eq!(selected_agent_backend_command("/status"), Some("/status"));
+        assert_eq!(
+            selected_agent_backend_command("/fork user-1"),
+            Some("/fork user-1")
+        );
+        assert_eq!(selected_agent_backend_command("/"), None);
+        assert_eq!(selected_agent_backend_command("/ status"), None);
+        assert_eq!(selected_agent_backend_command(" /status"), None);
+        assert_eq!(selected_agent_backend_command("status"), None);
+    }
 }
