+impl VisualSelectionKind {
+    fn as_str(&self) -> &'static str {
+        match self {
+            Self::Character => "visual",
+            Self::Line => "visual-line",
+            Self::Block => "visual-block",
+        }
+    }
+}
+
+fn selected_columns_for_row(
+    selection: &VisualSelection,
+    row: usize,
+    width: usize,
+    force_line: bool,
+) -> Option<(usize, usize)> {
+    if width == 0 {
+        return None;
+    }
+    let kind = if force_line {
+        VisualSelectionKind::Line
+    } else {
+        selection.kind
+    };
+    match kind {
+        VisualSelectionKind::Line => {
+            let row_start = selection.anchor.row.min(selection.cursor.row);
+            let row_end = selection.anchor.row.max(selection.cursor.row);
+            (row_start..=row_end)
+                .contains(&row)
+                .then_some((0, width - 1))
+        }
+        VisualSelectionKind::Block => {
+            let row_start = selection.anchor.row.min(selection.cursor.row);
+            let row_end = selection.anchor.row.max(selection.cursor.row);
+            if !(row_start..=row_end).contains(&row) {
+                return None;
+            }
+            let column_start = selection
+                .anchor
+                .column
+                .min(selection.cursor.column)
+                .min(width - 1);
+            let column_end = selection
+                .anchor
+                .column
+                .max(selection.cursor.column)
+                .min(width - 1);
+            Some((column_start, column_end))
+        }
+        VisualSelectionKind::Character => {
+            let (start, end) = ordered_selection_points(selection);
+            if row < start.row || row > end.row {
+                return None;
+            }
+            if start.row == end.row {
+                return Some((start.column.min(width - 1), end.column.min(width - 1)));
+            }
+            if row == start.row {
+                Some((start.column.min(width - 1), width - 1))
+            } else if row == end.row {
+                Some((0, end.column.min(width - 1)))
+            } else {
+                Some((0, width - 1))
+            }
+        }
+    }
+}
+
+fn ordered_selection_points(selection: &VisualSelection) -> (PanePoint, PanePoint) {
+    let anchor = selection.anchor;
+    let cursor = selection.cursor;
+    if (anchor.row, anchor.column) <= (cursor.row, cursor.column) {
+        (anchor, cursor)
+    } else {
+        (cursor, anchor)
+    }
+}
+
+fn offset_coordinate(value: usize, delta: isize, limit: usize) -> usize {
+    if limit == 0 {
+        return 0;
+    }
+    if delta.is_negative() {
+        value.saturating_sub(delta.unsigned_abs()).min(limit - 1)
+    } else {
+        value.saturating_add(delta as usize).min(limit - 1)
+    }
+}
+
+fn slice_line_columns(line: &str, column_start: usize, column_end: usize) -> String {
+    if column_end < column_start {
+        return String::new();
+    }
+    line.chars()
+        .skip(column_start)
+        .take(column_end - column_start + 1)
+        .collect()
+}
+
+fn wrap_content_lines(content: &str, width: usize) -> Vec<String> {
+    let width = width.max(1);
+    let mut wrapped = Vec::new();
+    for line in content.lines() {
+        if line.is_empty() {
+            wrapped.push(String::new());
+            continue;
+        }
+
+        let chars = line.chars().collect::<Vec<_>>();
+        for chunk in chars.chunks(width) {
+            wrapped.push(chunk.iter().collect());
+        }
+        if chars.len() % width == 0 {
+            wrapped.push(String::new());
+        }
+    }
+    wrapped
+}
