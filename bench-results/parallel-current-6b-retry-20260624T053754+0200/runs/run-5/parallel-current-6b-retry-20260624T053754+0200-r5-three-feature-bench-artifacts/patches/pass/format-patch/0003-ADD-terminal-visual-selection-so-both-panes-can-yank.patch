+    fn visual_selection_text(&self, selection: &VisualSelection, force_line: bool) -> String {
+        let (width, height) = self.pane_inner_size(selection.focus);
+        if width == 0 || height == 0 {
+            return String::new();
+        }
+        let lines = self.pane_lines(selection.focus);
+        let row_start = selection
+            .anchor
+            .row
+            .min(selection.cursor.row)
+            .min(height - 1);
+        let row_end = selection
+            .anchor
+            .row
+            .max(selection.cursor.row)
+            .min(height - 1);
+        let mut selected = Vec::new();
+        for row in row_start..=row_end {
+            let line = lines.get(row).map(String::as_str).unwrap_or("");
+            let Some((column_start, column_end)) =
+                selected_columns_for_row(selection, row, width, force_line)
+            else {
+                continue;
+            };
+            if force_line || selection.kind == VisualSelectionKind::Line {
+                selected.push(line.to_string());
+            } else {
+                selected.push(slice_line_columns(line, column_start, column_end));
+            }
+        }
+        selected.join("\n")
+    }
