+    let mut harness = UiHarness::new(100, 24);
+
+    assert!(strip_ansi(&harness.ui().render_left_pane()).contains("parser user-1"));
+
+    harness
+        .close_agent_chat("user-1")
+        .expect("fixture user-1 agent is registered");
+
+    assert!(!strip_ansi(&harness.ui().render_left_pane()).contains("parser user-1"));
+
+    harness.handle_bytes(b"ihello again");
+
+    let left_pane = strip_ansi(&harness.ui().render_left_pane());
+    let reopened = strip_ansi(&harness.render_frame());
+    assert!(left_pane.contains("parser user-1"));
+    assert!(reopened.contains("chat> hello again"));
+}
