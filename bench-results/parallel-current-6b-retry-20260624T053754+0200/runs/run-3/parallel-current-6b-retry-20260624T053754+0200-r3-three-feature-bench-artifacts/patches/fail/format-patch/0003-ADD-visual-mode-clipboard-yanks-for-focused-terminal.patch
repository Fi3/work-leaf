+    fn is_visual_mode(&self) -> bool {
+        matches!(
+            self.mode,
+            UiMode::Visual | UiMode::VisualLine | UiMode::VisualBlock
+        )
+    }
+
+    fn clear_visual_selection(&mut self) {
+        self.visual_selection = None;
+    }
+
+    fn cancel_visual_selection(&mut self) {
+        if self.is_visual_mode() {
+            self.mode = UiMode::Command;
+        }
+        self.clear_visual_selection();
+    }
+
+    fn handle_visual_key(&mut self, key: UiKey) -> Vec<UiAction> {
+        match key {
+            UiKey::Esc => {
+                self.mode = UiMode::Command;
+                self.clear_visual_selection();
+            }
+            UiKey::Char('v') => self.change_visual_kind(VisualKind::Character),
+            UiKey::Char('V') => self.change_visual_kind(VisualKind::Line),
+            UiKey::CtrlV => self.change_visual_kind(VisualKind::Block),
+            UiKey::Char('h') | UiKey::Left => self.move_visual_cursor(0, -1),
+            UiKey::Char('j') | UiKey::Down => self.move_visual_cursor(1, 0),
+            UiKey::Char('k') | UiKey::Up => self.move_visual_cursor(-1, 0),
+            UiKey::Char('l') | UiKey::Right => self.move_visual_cursor(0, 1),
+            UiKey::Char('y') => self.request_visual_yank(None),
+            UiKey::Char('Y') => self.request_visual_yank(Some(VisualKind::Line)),
+            _ => {}
+        }
+        Vec::new()
+    }
+
+    fn start_visual_selection(&mut self, kind: VisualKind) {
+        let pane = self.focus;
+        let position = self.visual_start_position(pane, kind);
+        self.mode = kind.mode();
+        self.visual_selection = Some(VisualSelection {
+            pane,
+            kind,
+            anchor: position,
+            cursor: position,
+        });
+    }
+
+    fn change_visual_kind(&mut self, kind: VisualKind) {
+        if let Some(mut selection) = self.visual_selection {
+            selection.kind = kind;
+            self.visual_selection = Some(selection);
+        }
+        self.mode = kind.mode();
+    }
+
+    fn request_visual_yank(&mut self, override_kind: Option<VisualKind>) {
+        let Some(mut selection) = self.visual_selection else {
+            return;
+        };
+        if let Some(kind) = override_kind {
+            selection.kind = kind;
+        }
+        self.pending_yank.replace(Some(selection));
+        self.mode = UiMode::Command;
+        self.clear_visual_selection();
+        self.show_status_notice(
+            "copied selection",
+            Duration::from_secs(STATUS_NOTICE_SECONDS),
+        );
+    }
+
+    fn request_current_line_yank(&mut self) {
+        let pane = self.focus;
+        let mut position = self.current_text_position(pane);
+        position.column = 0;
+        self.pending_yank.replace(Some(VisualSelection {
+            pane,
+            kind: VisualKind::Line,
+            anchor: position,
+            cursor: position,
+        }));
+        self.show_status_notice("copied line", Duration::from_secs(STATUS_NOTICE_SECONDS));
+    }
+
+    fn current_text_position(&self, pane: PaneFocus) -> TextPosition {
+        let lines = self.pane_lines(pane);
+        let position = match pane {
+            PaneFocus::Left => TextPosition {
+                row: self.left_control_display_row_index(),
+                column: 0,
+            },
+            PaneFocus::Right => self.last_right_cursor.get(),
+        };
+        clamp_position_to_lines(position, &lines)
+    }
+
+    fn visual_start_position(&self, pane: PaneFocus, kind: VisualKind) -> TextPosition {
+        let position = self.current_text_position(pane);
+        if kind == VisualKind::Line {
+            return position;
+        }
+        let lines = self.pane_lines(pane);
+        clamp_position_to_selectable_char(position, &lines)
+    }
+
+    fn left_control_display_row_index(&self) -> usize {
+        if self.control_selected == 0 {
+            return 0;
+        }
+
+        let mut row = 1;
+        for (visible_position, agent_index) in self.visible_agent_indices().iter().enumerate() {
+            if self.control_selected == visible_position + 1 {
+                return row;
+            }
+
+            row += 1;
+            let agent = &self.agents[*agent_index];
+            if !agent.modified_files.is_empty() {
+                row += 1;
+            }
+            if !agent.conflicting_agents.is_empty() {
+                row += 1;
+            }
+            if !agent.depends_on.is_empty() {
+                row += 1;
+            }
+            if !agent.depended_on_by.is_empty() {
+                row += 1;
+            }
+        }
+        0
+    }
+
+    fn move_visual_cursor(&mut self, row_delta: isize, column_delta: isize) {
+        let Some(mut selection) = self.visual_selection else {
+            return;
+        };
+        let lines = self.pane_lines(selection.pane);
+        let next_row =
+            apply_delta(selection.cursor.row, row_delta).min(lines.len().saturating_sub(1));
+        let line_len = line_char_len(&lines[next_row]);
+        let next_column = apply_delta(selection.cursor.column, column_delta).min(line_len);
+        selection.cursor = TextPosition {
+            row: next_row,
+            column: next_column,
+        };
+        self.visual_selection = Some(selection);
+    }
+
+    fn pane_lines(&self, pane: PaneFocus) -> Vec<String> {
+        match pane {
+            PaneFocus::Left => self
+                .left_widget_rows()
+                .into_iter()
+                .map(|row| row.text)
+                .collect(),
+            PaneFocus::Right => {
+                let lines = self.last_right_lines.borrow();
+                if lines.is_empty() {
+                    vec![String::new()]
+                } else {
+                    lines.clone()
+                }
+            }
+        }
+    }
+
+    fn remember_right_content(&self, right_content: &str, cursor_column: Option<usize>) {
+        let lines = pane_lines_from_text(right_content);
+        let row = lines.len().saturating_sub(1);
+        let column = cursor_column
+            .unwrap_or_else(|| line_char_len(&lines[row]))
+            .min(line_char_len(&lines[row]));
+        self.last_right_lines.replace(lines);
+        self.last_right_cursor.set(TextPosition { row, column });
+    }
+
+    fn visual_cursor_position(&self, selection: VisualSelection) -> (u16, u16) {
+        let layout = self.layout();
+        match selection.pane {
+            PaneFocus::Left => {
+                let max_column = layout.left_width.saturating_sub(1).max(1);
+                let row =
+                    2_u16.saturating_add(selection.cursor.row.min(usize::from(u16::MAX)) as u16);
+                let column = 2_u16
+                    .saturating_add(selection.cursor.column.min(usize::from(u16::MAX)) as u16)
+                    .min(max_column);
+                (row, column)
+            }
+            PaneFocus::Right => {
+                let max_column = self.width.max(1);
+                let row =
+                    2_u16.saturating_add(selection.cursor.row.min(usize::from(u16::MAX)) as u16);
+                let column = layout
+                    .left_width
+                    .saturating_add(2)
+                    .saturating_add(selection.cursor.column.min(usize::from(u16::MAX)) as u16)
+                    .min(max_column);
+                (row, column)
+            }
+        }
+    }
+
+    fn left_widget_rows(&self) -> Vec<PaneRow> {
+        let inner_width = usize::from(self.layout().left_width.saturating_sub(2).max(1));
+        let mut rows = vec![PaneRow {
+            text: if self.control_selected == 0 {
+                "> work-leaf  command".to_string()
+            } else {
+                "  work-leaf  command".to_string()
+            },
+            reversed: false,
+        }];
+        for (visible_position, agent_index) in self.visible_agent_indices().iter().enumerate() {
+            let agent = &self.agents[*agent_index];
+            let selected = self.control_selected == visible_position + 1;
+            rows.push(PaneRow {
+                text: compact_agent_row(agent, selected, inner_width),
+                reversed: agent.ready,
+            });
+            if !agent.modified_files.is_empty() {
+                rows.push(PaneRow {
+                    text: format!(
+                        "    files: {}",
+                        agent
+                            .modified_files
+                            .iter()
+                            .map(|path| path.display().to_string())
+                            .collect::<Vec<_>>()
+                            .join(", ")
+                    ),
+                    reversed: false,
+                });
+            }
+            for (label, agents) in [
+                ("conflicts", &agent.conflicting_agents),
+                ("depends-on", &agent.depends_on),
+                ("depended-on-by", &agent.depended_on_by),
+            ] {
+                if !agents.is_empty() {
+                    rows.push(PaneRow {
+                        text: format!(
+                            "    {label}: {}",
+                            agents
+                                .iter()
+                                .map(AgentId::as_str)
+                                .collect::<Vec<_>>()
+                                .join(", ")
+                        ),
+                        reversed: false,
+                    });
+                }
+            }
+        }
+        rows
+    }
+
+    fn styled_pane_line(
+        &self,
+        pane: PaneFocus,
+        row_index: usize,
+        line: &str,
+        base_reversed: bool,
+    ) -> Spans<'static> {
+        let ranges = self.selection_ranges_for_line(pane, row_index, line);
+        styled_line_with_ranges(line, base_reversed, &ranges)
+    }
+
+    fn selection_ranges_for_line(
+        &self,
+        pane: PaneFocus,
+        row_index: usize,
+        line: &str,
+    ) -> Vec<(usize, usize)> {
+        let Some(selection) = self.visual_selection else {
+            return Vec::new();
+        };
+        if !self.is_visual_mode() || selection.pane != pane {
+            return Vec::new();
+        }
+        selection_ranges_for_line(selection, row_index, line)
+    }
+
+    fn clipboard_prefix(&self, right_content: &str) -> String {
+        let Some(selection) = self.pending_yank.borrow_mut().take() else {
+            return String::new();
+        };
+        let text = self.selected_text(selection, right_content);
+        self.last_yank.replace(Some(text.clone()));
+        if text.is_empty() {
+            String::new()
+        } else {
+            osc52_sequence(&text)
+        }
+    }
+
+    fn selected_text(&self, selection: VisualSelection, right_content: &str) -> String {
+        let lines = match selection.pane {
+            PaneFocus::Left => self
+                .left_widget_rows()
+                .into_iter()
+                .map(|row| row.text)
+                .collect::<Vec<_>>(),
+            PaneFocus::Right => pane_lines_from_text(right_content),
+        };
+        selected_text_from_lines(selection, &lines)
+    }
