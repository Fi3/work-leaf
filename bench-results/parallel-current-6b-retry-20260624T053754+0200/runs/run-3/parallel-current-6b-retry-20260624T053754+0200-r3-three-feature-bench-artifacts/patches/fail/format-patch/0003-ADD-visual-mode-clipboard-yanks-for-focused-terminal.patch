+fn clamp_position_to_lines(position: TextPosition, lines: &[String]) -> TextPosition {
+    let row = position.row.min(lines.len().saturating_sub(1));
+    TextPosition {
+        row,
+        column: position.column.min(line_char_len(&lines[row])),
+    }
