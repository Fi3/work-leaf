+fn selection_ranges_for_line(
+    selection: VisualSelection,
+    row_index: usize,
+    line: &str,
+) -> Vec<(usize, usize)> {
+    let line_len = line_char_len(line);
+    let start_row = selection.anchor.row.min(selection.cursor.row);
+    let end_row = selection.anchor.row.max(selection.cursor.row);
+    if row_index < start_row || row_index > end_row {
+        return Vec::new();
+    }
+
+    match selection.kind {
+        VisualKind::Line => (!line.is_empty())
+            .then_some((0, line_len))
+            .into_iter()
+            .collect(),
+        VisualKind::Block => {
+            let start = selection
+                .anchor
+                .column
+                .min(selection.cursor.column)
+                .min(line_len);
+            let end = selection
+                .anchor
+                .column
+                .max(selection.cursor.column)
+                .saturating_add(1)
+                .min(line_len);
+            (start < end).then_some((start, end)).into_iter().collect()
+        }
+        VisualKind::Character => {
+            let (start, end) = ordered_positions(selection.anchor, selection.cursor);
+            let range = if start.row == end.row {
+                let range_start = start.column.min(line_len);
+                let range_end = end.column.saturating_add(1).min(line_len);
+                (range_start < range_end).then_some((range_start, range_end))
+            } else if row_index == start.row {
+                let range_start = start.column.min(line_len);
+                (range_start < line_len).then_some((range_start, line_len))
+            } else if row_index == end.row {
+                let range_end = end.column.saturating_add(1).min(line_len);
+                (range_end > 0).then_some((0, range_end))
+            } else {
+                (!line.is_empty()).then_some((0, line_len))
+            };
+            range.into_iter().collect()
+        }
+    }
+}
+
+fn selected_text_from_lines(selection: VisualSelection, lines: &[String]) -> String {
+    if lines.is_empty() {
+        return String::new();
+    }
+    let anchor = clamp_position_to_lines(selection.anchor, lines);
+    let cursor = clamp_position_to_lines(selection.cursor, lines);
+    let selection = VisualSelection {
+        anchor,
+        cursor,
+        ..selection
+    };
+    let start_row = anchor.row.min(cursor.row);
+    let end_row = anchor.row.max(cursor.row);
+
+    match selection.kind {
+        VisualKind::Line => lines[start_row..=end_row].join("\n"),
+        VisualKind::Block => {
+            let start_column = anchor.column.min(cursor.column);
+            let end_column = anchor.column.max(cursor.column);
+            lines[start_row..=end_row]
+                .iter()
+                .map(|line| slice_chars(line, start_column, end_column.saturating_add(1)))
+                .collect::<Vec<_>>()
+                .join("\n")
+        }
+        VisualKind::Character => {
+            let (start, end) = ordered_positions(anchor, cursor);
+            if start.row == end.row {
+                return slice_chars(
+                    &lines[start.row],
+                    start.column,
+                    end.column.saturating_add(1),
+                );
+            }
+
+            let mut selected = Vec::new();
+            selected.push(slice_chars(
+                &lines[start.row],
+                start.column,
+                line_char_len(&lines[start.row]),
+            ));
+            if end.row > start.row + 1 {
+                selected.extend(lines[start.row + 1..end.row].iter().cloned());
+            }
+            selected.push(slice_chars(
+                &lines[end.row],
+                0,
+                end.column.saturating_add(1),
+            ));
+            selected.join("\n")
+        }
+    }
+}
+
+fn slice_chars(line: &str, start: usize, end: usize) -> String {
+    line.chars()
+        .skip(start)
+        .take(end.saturating_sub(start))
+        .collect()
+}
+
+fn styled_line_with_ranges(
+    line: &str,
+    base_reversed: bool,
+    ranges: &[(usize, usize)],
+) -> Spans<'static> {
+    let base_style = Style::default();
+    let selected_style = if base_reversed {
+        Style::default().remove_modifier(Modifier::REVERSED)
+    } else {
+        Style::default().add_modifier(Modifier::REVERSED)
+    };
+    if ranges.is_empty() {
+        return Spans::from(vec![Span::styled(line.to_string(), base_style)]);
+    }
+
+    let mut spans = Vec::new();
+    let mut cursor = 0;
+    let line_len = line_char_len(line);
+    for (start, end) in ranges {
+        let start = (*start).min(line_len);
+        let end = (*end).min(line_len);
+        if cursor < start {
+            spans.push(Span::styled(slice_chars(line, cursor, start), base_style));
+        }
+        if start < end {
+            spans.push(Span::styled(slice_chars(line, start, end), selected_style));
+        }
+        cursor = cursor.max(end);
+    }
+    if cursor < line_len {
+        spans.push(Span::styled(
+            slice_chars(line, cursor, line_len),
+            base_style,
+        ));
+    }
+    Spans::from(spans)
+}
