+fn ordered_positions(anchor: TextPosition, cursor: TextPosition) -> (TextPosition, TextPosition) {
+    if (anchor.row, anchor.column) <= (cursor.row, cursor.column) {
+        (anchor, cursor)
+    } else {
+        (cursor, anchor)
+    }
+}
