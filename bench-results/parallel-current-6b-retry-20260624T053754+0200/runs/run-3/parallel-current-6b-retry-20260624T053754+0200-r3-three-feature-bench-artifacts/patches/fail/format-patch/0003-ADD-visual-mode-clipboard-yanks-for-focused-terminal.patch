+fn clamp_position_to_selectable_char(position: TextPosition, lines: &[String]) -> TextPosition {
+    let position = clamp_position_to_lines(position, lines);
+    let line_len = line_char_len(&lines[position.row]);
+    if line_len == 0 {
+        position
+    } else {
+        TextPosition {
+            row: position.row,
+            column: position.column.min(line_len.saturating_sub(1)),
+        }
+    }
