#!/usr/bin/env bash
set -euo pipefail

if [[ "$#" != 3 ]]; then
  echo "usage: $0 ATTEMPT_ID CONDITION BATCH_ID" >&2
  exit 2
fi

attempt_id="$1"
condition="$2"
batch_id="$3"
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/../.." && pwd)"
source_repo="/home/user/.codex/work-leaf-points89-source-20260828T145556Z"
runtime_root="/home/user/.codex/work-leaf-exact-points89-runtime-20260829T002755Z"
bin_dir="$repo_root/bench-results/efficiency-points8-9-20260828T145556Z/infrastructure/bin"
observer_bin="$bin_dir/bench-observer"
exact_launcher="$repo_root/bench-results/efficiency-exact-cancelled-usage-20260828T221936Z/infrastructure/run_with_exact_usage.py"
real_codex="$(command -v codex 2>/dev/null || true)"
study_id="efficiency-exact-points8-9-20260829T002755Z"
expected_source_commit="4707ceb4903a09646857d1e316cb45acb15a3d07"
timeout_seconds=7200

check_sha256() {
  local expected="$1"
  local path="$2"
  local actual
  [[ -f "$path" && ! -L "$path" ]] || {
    echo "error: required frozen file is missing or symlinked: $path" >&2
    exit 1
  }
  actual="$(sha256sum "$path" | awk '{print $1}')"
  [[ "$actual" == "$expected" ]] || {
    echo "error: frozen file hash changed: $path" >&2
    exit 1
  }
}

[[ "$attempt_id" =~ ^(direct|wl-000|wl-111)-[0-9][0-9][0-9]$ ]] || {
  echo "error: invalid attempt ID: $attempt_id" >&2
  exit 2
}
[[ "$batch_id" =~ ^[1-5]$ ]] || {
  echo "error: invalid batch ID: $batch_id" >&2
  exit 2
}
[[ -n "${OPENAI_API_KEY:-}" ]] || {
  echo "error: OPENAI_API_KEY is required" >&2
  exit 1
}
[[ -n "$real_codex" && -x "$real_codex" ]] || {
  echo "error: Codex executable is unavailable" >&2
  exit 1
}
[[ "$(codex --version)" == "codex-cli 0.149.1" ]] || {
  echo "error: Codex CLI version differs from the frozen study" >&2
  exit 1
}
[[ "$(git -C "$source_repo" rev-parse HEAD)" == "$expected_source_commit" \
  && -z "$(git -C "$source_repo" status --short)" ]] || {
  echo "error: isolated benchmark source differs from the frozen commit" >&2
  exit 1
}

check_sha256 0487eea18f886cd846499d7f750f46d5d6d5606bd60f73122b71e6b23d84e310 \
  "$source_repo/bench-three-features"
check_sha256 489289165601e00a545f76ab0631d5e0f48d644b928376488677e1875651e386 \
  "$source_repo/bench-three-features-direct-common"
check_sha256 de9803658bc8ac41a9356436be2c8b8edfce9d7bef9176841e067b3478633d4f \
  "$source_repo/bench-agent-profile-common"
check_sha256 229c96272ed8bc2868e882ff8e3ab6170e7adf8af86235e8a372d9246f005734 \
  "$bin_dir/work-leaf"
check_sha256 0df516e0de37f40cd069e2be3496cbe36f03d99ce9d894291b0bf32915ae7df3 \
  "$bin_dir/work-leaf-orchestrator"
check_sha256 ba9c6286fdb4f4fbebc54b878c7243a43b284068dea60740dcf50e30d08c7c00 \
  "$observer_bin"
check_sha256 92273821112523dc2442d55e70b702c2acb48a2ecc5b8ed4188eed05cd0a9e74 \
  "$exact_launcher"
check_sha256 189d433e22cd8414c36c2f8fd8017b3a4b3b842355c6b02e3ab5183a51a27385 \
  "${exact_launcher%/*}/exact_usage_proxy.py"

case "$condition" in
  direct)
    workflow="direct-sequential"
    changed="n/a"
    unchanged="n/a"
    review="n/a"
    ;;
  wl-000)
    workflow="work-leaf-concurrent"
    changed="normal"
    unchanged="normal"
    review="inline-exact"
    ;;
  wl-111)
    workflow="work-leaf-concurrent"
    changed="full"
    unchanged="full"
    review="git-reconstruct"
    ;;
  *)
    echo "error: condition must be direct, wl-000, or wl-111" >&2
    exit 2
    ;;
esac
[[ "$attempt_id" == "$condition"-* ]] || {
  echo "error: attempt ID does not match condition" >&2
  exit 2
}

attempt_dir="$script_dir/runs/$attempt_id"
benchmark_dir="$attempt_dir/benchmark"
exact_dir="$attempt_dir/exact-usage"
log_path="$script_dir/logs/$attempt_id.log"
status_path="$script_dir/logs/$attempt_id.exit"
run_id="exact-points89-$attempt_id"
[[ ! -e "$attempt_dir" && ! -e "$log_path" && ! -e "$status_path" ]] || {
  echo "error: attempt already has preserved state: $attempt_id" >&2
  exit 2
}
mkdir -p "$benchmark_dir" "$script_dir/logs" "$runtime_root/$attempt_id"

python3 - "$attempt_dir/admission.json" "$attempt_id" "$condition" "$workflow" \
  "$batch_id" "$changed" "$unchanged" "$review" "$expected_source_commit" <<'PY'
import json
import os
import sys
import time
from pathlib import Path

output, attempt, condition, workflow, batch, changed, unchanged, review, source_commit = sys.argv[1:]
payload = {
    "schema_version": 1,
    "attempt_id": attempt,
    "condition": condition,
    "workflow": workflow,
    "launch_batch": int(batch),
    "analytical_pair": False,
    "model": "gpt-5.5",
    "reasoning_effort": "xhigh",
    "provider_route": "openai-responses-api-exact-usage",
    "candidate_base_commit": "c92a0b7060a36eac6db2d869b85e589a7a9480f9",
    "benchmark_source_commit": source_commit,
    "changed_reread": changed,
    "unchanged_reread": unchanged,
    "review_context": review,
    "retry": False,
    "started_unix_ns": time.time_ns(),
}
temporary = Path(output + ".tmp")
temporary.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="ascii")
os.replace(temporary, output)
PY

common_env=(
  WORK_LEAF_BENCH_OBSERVER_BIN="$observer_bin"
  WORK_LEAF_BENCH_STUDY_ID="$study_id"
  WORK_LEAF_BENCH_PAIR_ID="unpaired-$attempt_id"
)

set +e
if [[ "$workflow" == "direct-sequential" ]]; then
  python3 "$exact_launcher" --result-dir "$exact_dir" --real-codex "$real_codex" -- \
    env -u WORK_LEAF_EXPERIMENT_CHANGED_REPEAT_DELIVERY \
      -u WORK_LEAF_EXPERIMENT_UNCHANGED_REPEAT_DELIVERY \
      -u WORK_LEAF_EXPERIMENT_REVIEW_PROVENANCE \
      "${common_env[@]}" \
      WORK_LEAF_DIRECT_BENCH_MODEL=gpt-5.5 \
      WORK_LEAF_DIRECT_BENCH_REASONING_EFFORT=xhigh \
      WORK_LEAF_DIRECT_BENCH_TMPDIR="$runtime_root/$attempt_id" \
      WORK_LEAF_DIRECT_BENCH_RESULTS_DIR="$benchmark_dir" \
      WORK_LEAF_DIRECT_BENCH_SKIP_BUILD=1 \
      WORK_LEAF_DIRECT_BENCH_BIN_DIR="$bin_dir" \
      WORK_LEAF_DIRECT_BENCH_TIMEOUT_SECS="$timeout_seconds" \
      WORK_LEAF_DIRECT_BENCH_RUN_ID="$run_id" \
      "$source_repo/bench-three-features-sequential" >"$log_path" 2>&1
  status=$?
else
  python3 "$exact_launcher" --result-dir "$exact_dir" --real-codex "$real_codex" -- \
    env "${common_env[@]}" \
      WORK_LEAF_EXPERIMENT_CHANGED_REPEAT_DELIVERY="$changed" \
      WORK_LEAF_EXPERIMENT_UNCHANGED_REPEAT_DELIVERY="$unchanged" \
      WORK_LEAF_EXPERIMENT_REVIEW_PROVENANCE="$review" \
      WORK_LEAF_BENCH_MODEL=gpt-5.5 \
      WORK_LEAF_BENCH_REASONING_EFFORT=xhigh \
      WORK_LEAF_BENCH_TMPDIR="$runtime_root/$attempt_id" \
      WORK_LEAF_BENCH_RESULTS_DIR="$benchmark_dir" \
      WORK_LEAF_BENCH_SKIP_BUILD=1 \
      WORK_LEAF_BENCH_BIN_DIR="$bin_dir" \
      WORK_LEAF_BENCH_TIMEOUT_SECS="$timeout_seconds" \
      WORK_LEAF_BENCH_NO_READ_PERMISSION=0 \
      WORK_LEAF_BENCH_WEB_UI=0 \
      WORK_LEAF_BENCH_DISABLE_TMUX_SUPERVISOR=1 \
      WORK_LEAF_BENCH_RUN_ID="$run_id" \
      "$source_repo/bench-three-features" >"$log_path" 2>&1
  status=$?
fi
set -e

printf '%s\n' "$status" >"$status_path"
exit "$status"
