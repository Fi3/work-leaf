+#[test]
+fn terminal_app_closes_reviewed_patch_agent_on_yes_and_reopens_on_typing() {
+    let root = git_repo("terminal-app-feature-done-prompt");
+    fs::write(root.join("README.md"), "before\n").unwrap();
+    Command::new("git")
+        .current_dir(&root)
+        .args(["add", "README.md"])
+        .status()
+        .unwrap();
+    Command::new("git")
+        .current_dir(&root)
+        .args(["commit", "-m", "ADD initial feature done fixture"])
+        .status()
+        .unwrap();
+
+    let backend = FakeBackend::new([
+        "implemented patch\n@work-leaf patch update readme\n--- a/README.md\n+++ b/README.md\n@@ -1 +1 @@\n-before\n+after\n@work-leaf end\n@work-leaf done",
+        "summary: README changes",
+        "NO_FINDINGS",
+        "follow reply",
+    ]);
+    let chat = CommandChat::new(root, backend.clone()).with_max_review_rounds(4);
+    let mut app = TerminalApp::new(chat, 100, 24);
+
+    app.handle_bytes(b":new update readme\n");
+    assert!(app.wait_for_idle(Duration::from_secs(2)));
+
+    assert_eq!(
+        app.ui().selected_agent().map(AgentId::as_str),
+        Some("user-1")
+    );
+    assert!(
+        app.render_frame()
+            .contains("work-leaf: is this feature done? yes/no")
+    );
+    let left_pane = app.ui().render_left_pane();
+    assert!(left_pane.contains("user-1"));
+    assert!(left_pane.contains("READY"));
+    assert!(left_pane.contains("\u{1b}[7m"));
+
+    app.handle_bytes(b"yes\n");
+
+    assert!(app.render_frame().contains("work-leaf: feature closed"));
+    assert!(!app.ui().render_left_pane().contains("user-1"));
+
+    app.handle_bytes(b"please continue\n");
+    assert!(app.wait_for_idle(Duration::from_secs(2)));
+
+    let frame = app.render_frame();
+    assert!(app.ui().render_left_pane().contains("user-1"));
+    assert!(frame.contains("work-leaf: feature reopened"));
+    assert!(frame.contains("user: please continue"));
+    assert!(frame.contains("follow reply"));
+
+    let backend = app.into_chat().into_backend();
+    let sends = backend.sends();
+    assert!(
+        sends
+            .iter()
+            .any(|(agent_id, prompt)| agent_id.as_str() == "user-1" && prompt == "please continue")
+    );
+    assert!(!sends.iter().any(|(_, prompt)| prompt == "yes"));
+}
