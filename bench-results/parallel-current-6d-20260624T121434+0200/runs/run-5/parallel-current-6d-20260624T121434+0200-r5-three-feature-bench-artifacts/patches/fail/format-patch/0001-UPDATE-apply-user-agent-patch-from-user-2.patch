+pub(crate) fn agent_backend_command(message: &str) -> Option<&str> {
+    let message = message.trim();
+    let command = message.strip_prefix('/')?;
+    command
+        .chars()
+        .next()
+        .is_some_and(|ch| !ch.is_whitespace())
+        .then_some(message)
+}
+
+trait AgentBackendCommandExt {
+    fn send_streaming_or_command(
+        &mut self,
+        agent_id: &AgentId,
+        message: &str,
+        command: Option<&str>,
+        sink: &mut dyn FnMut(AgentStreamEvent),
+    ) -> Result<crate::agent::ChatMessage, crate::agent::AgentError>;
+}
+
+impl<B> AgentBackendCommandExt for B
+where
+    B: AgentBackend,
+{
+    fn send_streaming_or_command(
+        &mut self,
+        agent_id: &AgentId,
+        message: &str,
+        command: Option<&str>,
+        sink: &mut dyn FnMut(AgentStreamEvent),
+    ) -> Result<crate::agent::ChatMessage, crate::agent::AgentError> {
+        if let Some(command) = command {
+            self.execute_command_streaming(agent_id, command, sink)
+        } else {
+            self.send_streaming(agent_id, message, sink)
+        }
+    }
+}
