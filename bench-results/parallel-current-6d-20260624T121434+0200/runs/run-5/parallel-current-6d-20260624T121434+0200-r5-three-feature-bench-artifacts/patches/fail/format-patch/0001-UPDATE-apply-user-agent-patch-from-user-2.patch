+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::path::PathBuf;
+    use std::sync::{Arc, Mutex};
+
+    use crate::agent::{AgentError, AgentSession, ChatMessage, MessageRole};
+
+    #[test]
+    fn selected_agent_status_slash_command_uses_backend_command_not_send() {
+        let state = Arc::new(Mutex::new(RecordingBackendState::default()));
+        let backend = RecordingBackend {
+            state: state.clone(),
+        };
+        let chat = CommandChat::new(PathBuf::from("/repo"), backend);
+        let mut controller = WorkLeafController::new(chat);
+        let agent_id = AgentId::new("user-1").expect("test agent id is valid");
+
+        controller
+            .send_message(&agent_id, "/status")
+            .expect("slash command message is accepted");
+        assert!(controller.wait_for_idle(Duration::from_secs(2)));
+
+        let snapshot = controller.snapshot();
+        let session = snapshot
+            .session(&agent_id)
+            .expect("slash command creates an agent transcript");
+        assert!(session.lines.iter().any(|line| line == "user: /status"));
+        assert!(
+            session
+                .lines
+                .iter()
+                .any(|line| line == "backend command output: /status")
+        );
+
+        let state = state.lock().expect("recording backend state mutex poisoned");
+        assert!(state.sent_prompts.is_empty());
+        assert_eq!(state.commands, vec![(agent_id, "/status".to_string())]);
+    }
+
