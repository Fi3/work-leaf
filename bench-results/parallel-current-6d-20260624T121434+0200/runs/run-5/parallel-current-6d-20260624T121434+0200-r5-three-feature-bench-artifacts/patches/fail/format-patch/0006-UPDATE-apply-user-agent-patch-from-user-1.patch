+fn clamp_position(position: TextPosition, lines: &[String]) -> TextPosition {
+    if lines.is_empty() {
+        return TextPosition { row: 0, column: 0 };
+    }
+    let row = position.row.min(lines.len() - 1);
+    let line_len = lines[row].chars().count();
+    TextPosition {
+        row,
+        column: position.column.min(line_len.saturating_sub(1)),
+    }
