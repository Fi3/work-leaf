+    fn start_visual_selection(&mut self, mode: VisualMode) {
+        let pane = self.focus;
+        let lines = self.visual_lines(pane);
+        if lines.is_empty() {
+            return;
+        }
+        let mut position = self.visual_start_position(pane, &lines);
+        if mode == VisualMode::Line {
+            position.column = 0;
+        }
+        self.visual_selection = Some(VisualSelection {
+            pane,
+            mode,
+            anchor: position,
+            cursor: position,
+        });
+    }
+
+    fn set_visual_mode(&mut self, mode: VisualMode) {
+        if let Some(selection) = &mut self.visual_selection {
+            selection.mode = mode;
+            if mode == VisualMode::Line {
+                selection.anchor.column = 0;
+                selection.cursor.column = 0;
+            }
+        }
+    }
