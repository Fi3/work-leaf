+fn move_position(
+    position: TextPosition,
+    row_delta: isize,
+    column_delta: isize,
+    lines: &[String],
+) -> TextPosition {
+    if lines.is_empty() {
+        return TextPosition { row: 0, column: 0 };
+    }
+    let row = offset_index(position.row, row_delta, lines.len() - 1);
+    let line_len = lines[row].chars().count();
+    let column = offset_index(position.column, column_delta, line_len.saturating_sub(1));
+    TextPosition { row, column }
+}
+
+fn offset_index(current: usize, delta: isize, max: usize) -> usize {
+    if delta < 0 {
+        current.saturating_sub(delta.unsigned_abs()).min(max)
+    } else {
+        current.saturating_add(delta as usize).min(max)
+    }
+}
