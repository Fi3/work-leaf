+fn selected_text(lines: &[String], selection: VisualSelection, force_linewise: bool) -> String {
+    let mode = if force_linewise {
+        VisualMode::Line
+    } else {
+        selection.mode
+    };
+    let selection = VisualSelection { mode, ..selection };
+    lines
+        .iter()
+        .enumerate()
+        .filter_map(|(row, line)| {
+            selection_range_for_line(&selection, row, line.chars().count())
+                .map(|(start, end)| text_char_range(line, start, end))
+        })
+        .collect::<Vec<_>>()
+        .join("\n")
+}
