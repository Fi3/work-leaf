+fn selection_range_for_line(
+    selection: &VisualSelection,
+    row: usize,
+    line_len: usize,
+) -> Option<(usize, usize)> {
+    match selection.mode {
+        VisualMode::Character => character_selection_range(selection, row, line_len),
+        VisualMode::Line => line_selection_range(selection, row, line_len),
+        VisualMode::Block => block_selection_range(selection, row, line_len),
+    }
+}
+
+fn character_selection_range(
+    selection: &VisualSelection,
+    row: usize,
+    line_len: usize,
+) -> Option<(usize, usize)> {
+    if line_len == 0 {
+        return None;
+    }
+    let (start, end) = ordered_positions(selection.anchor, selection.cursor);
+    if row < start.row || row > end.row {
+        return None;
+    }
+    if start.row == end.row {
+        return inclusive_range(start.column, end.column, line_len);
+    }
+    if row == start.row {
+        return Some((start.column.min(line_len - 1), line_len));
+    }
+    if row == end.row {
+        return Some((0, end.column.min(line_len - 1) + 1));
+    }
+    Some((0, line_len))
+}
+
+fn line_selection_range(
+    selection: &VisualSelection,
+    row: usize,
+    line_len: usize,
+) -> Option<(usize, usize)> {
+    let start = selection.anchor.row.min(selection.cursor.row);
+    let end = selection.anchor.row.max(selection.cursor.row);
+    (start..=end).contains(&row).then_some((0, line_len))
+}
+
+fn block_selection_range(
+    selection: &VisualSelection,
+    row: usize,
+    line_len: usize,
+) -> Option<(usize, usize)> {
+    if line_len == 0 {
+        return None;
+    }
+    let start_row = selection.anchor.row.min(selection.cursor.row);
+    let end_row = selection.anchor.row.max(selection.cursor.row);
+    if row < start_row || row > end_row {
+        return None;
+    }
+    let start_column = selection.anchor.column.min(selection.cursor.column);
+    let end_column = selection.anchor.column.max(selection.cursor.column);
+    if start_column >= line_len {
+        return None;
+    }
+    Some((start_column, (end_column + 1).min(line_len)))
+}
+
+fn inclusive_range(start: usize, end: usize, line_len: usize) -> Option<(usize, usize)> {
+    if line_len == 0 {
+        return None;
+    }
+    let start = start.min(line_len - 1);
+    let end = end.min(line_len - 1);
+    (start <= end).then_some((start, end + 1))
+}
