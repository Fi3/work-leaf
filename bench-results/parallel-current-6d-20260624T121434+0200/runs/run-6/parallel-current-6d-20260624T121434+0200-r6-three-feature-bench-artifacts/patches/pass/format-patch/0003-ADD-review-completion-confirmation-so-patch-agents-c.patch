+pub(crate) const FEATURE_DONE_QUESTION_SUFFIX: &str = "Is this feature done? yes/no";
+pub(crate) const FEATURE_DONE_CLOSED_LINE: &str = "work-leaf: feature marked done";
+pub(crate) const FEATURE_DONE_REOPENED_LINE: &str = "work-leaf: feature reopened";
+
+pub(crate) fn is_feature_done_question_line(line: &str) -> bool {
+    line.starts_with("work-leaf: review complete for ")
+        && line.ends_with(FEATURE_DONE_QUESTION_SUFFIX)
+}
+
+pub(crate) fn is_feature_done_yes(message: &str) -> bool {
+    matches!(message.trim().to_ascii_lowercase().as_str(), "yes" | "y")
+}
+
+pub(crate) fn is_feature_done_no(message: &str) -> bool {
+    matches!(message.trim().to_ascii_lowercase().as_str(), "no" | "n")
+}
+
+fn feature_done_question_line(review: &ReviewResult) -> String {
+    let short_hash = review.commit.hash.chars().take(12).collect::<String>();
+    format!("work-leaf: review complete for {short_hash}. {FEATURE_DONE_QUESTION_SUFFIX}")
+}
