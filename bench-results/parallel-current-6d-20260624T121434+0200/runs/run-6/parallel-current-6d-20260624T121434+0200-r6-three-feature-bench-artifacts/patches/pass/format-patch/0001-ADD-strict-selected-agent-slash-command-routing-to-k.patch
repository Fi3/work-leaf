+pub(crate) fn backend_command_message(message: &str) -> Option<&str> {
+    let trimmed = message.trim();
+    let mut chars = trimmed.chars();
+    if chars.next()? != '/' {
+        return None;
+    }
+    chars
+        .next()
+        .is_some_and(|command_start| !command_start.is_whitespace())
+        .then_some(trimmed)
+}
