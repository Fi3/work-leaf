+fn clamp_text_position(position: TextPosition, lines: &[String]) -> TextPosition {
+    let row = position.row.min(lines.len().saturating_sub(1));
+    let max_column = lines
+        .get(row)
+        .map(|line| line_char_count(line).saturating_sub(1))
+        .unwrap_or(0);
+    TextPosition {
+        row,
+        column: position.column.min(max_column),
+    }
+}
+
+fn selected_text_from_lines(
+    lines: &[String],
+    selection: &VisualSelection,
+    force_line: bool,
+) -> String {
+    if lines.is_empty() {
+        return String::new();
+    }
+
+    let max_row = lines.len().saturating_sub(1);
+    let (start, end) = selection.ordered_positions();
+    let start_row = start.row.min(max_row);
+    let end_row = end.row.min(max_row);
+
+    if force_line || selection.kind == VisualSelectionKind::Line {
+        return (start_row..=end_row)
+            .map(|row| lines[row].clone())
+            .collect::<Vec<_>>()
+            .join("\n");
+    }
+
+    match selection.kind {
+        VisualSelectionKind::Block => {
+            let (start_column, end_column) = ordered_columns(selection);
+            (start_row..=end_row)
+                .map(|row| {
+                    line_slice_chars(&lines[row], start_column, end_column.saturating_add(1))
+                })
+                .collect::<Vec<_>>()
+                .join("\n")
+        }
+        VisualSelectionKind::Character => (start_row..=end_row)
+            .map(|row| {
+                let line = &lines[row];
+                let line_len = line_char_count(line);
+                let (start_column, end_column) = if start_row == end_row {
+                    (
+                        start.column.min(line_len),
+                        end.column.saturating_add(1).min(line_len),
+                    )
+                } else if row == start_row {
+                    (start.column.min(line_len), line_len)
+                } else if row == end_row {
+                    (0, end.column.saturating_add(1).min(line_len))
+                } else {
+                    (0, line_len)
+                };
+                line_slice_chars(line, start_column, end_column)
+            })
+            .collect::<Vec<_>>()
+            .join("\n"),
+        VisualSelectionKind::Line => unreachable!("line selection returned earlier"),
+    }
+}
+
+fn ordered_columns(selection: &VisualSelection) -> (usize, usize) {
+    if selection.anchor.column <= selection.cursor.column {
+        (selection.anchor.column, selection.cursor.column)
+    } else {
+        (selection.cursor.column, selection.anchor.column)
+    }
+}
