+fn spans_with_selection(line: &str, range: Option<(usize, usize)>) -> Vec<Span<'static>> {
+    let Some((start, end)) = range else {
+        return vec![Span::raw(line.to_string())];
+    };
+    let line_len = line_char_count(line);
+    let start = start.min(line_len);
+    let end = end.min(line_len);
+    if start >= end {
+        return vec![Span::raw(line.to_string())];
+    }
+
+    let start_byte = byte_index_at_char(line, start);
+    let end_byte = byte_index_at_char(line, end);
+    let mut spans = Vec::new();
+    if start_byte > 0 {
+        spans.push(Span::raw(line[..start_byte].to_string()));
+    }
+    spans.push(Span::styled(
+        line[start_byte..end_byte].to_string(),
+        Style::default().add_modifier(Modifier::REVERSED),
+    ));
+    if end_byte < line.len() {
+        spans.push(Span::raw(line[end_byte..].to_string()));
+    }
+    spans
+}
+
+fn line_slice_chars(line: &str, start: usize, end: usize) -> String {
+    let line_len = line_char_count(line);
+    let start = start.min(line_len);
+    let end = end.min(line_len);
+    if start >= end {
+        return String::new();
+    }
+
+    let start_byte = byte_index_at_char(line, start);
+    let end_byte = byte_index_at_char(line, end);
+    line[start_byte..end_byte].to_string()
+}
+
+fn byte_index_at_char(line: &str, char_index: usize) -> usize {
+    line.char_indices()
+        .nth(char_index)
+        .map(|(index, _)| index)
+        .unwrap_or(line.len())
+}
+
+fn line_char_count(line: &str) -> usize {
+    line.chars().count()
+}
