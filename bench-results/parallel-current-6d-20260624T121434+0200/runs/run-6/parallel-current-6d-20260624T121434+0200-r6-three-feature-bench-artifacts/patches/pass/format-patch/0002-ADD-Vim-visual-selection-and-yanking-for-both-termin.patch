+    fn start_visual_selection(
+        &mut self,
+        kind: VisualSelectionKind,
+        right_content: &str,
+        right_cursor_column: Option<usize>,
+    ) {
+        let pane = self.active_text_pane();
+        let position = self.current_text_position(pane, right_content, right_cursor_column);
+        self.visual_selection = Some(VisualSelection {
+            pane,
+            kind,
+            anchor: position,
+            cursor: position,
+        });
+        self.mode = UiMode::Command;
+    }
+
+    fn handle_visual_key(&mut self, key: UiKey, right_content: &str) -> Vec<UiAction> {
+        match key {
+            UiKey::Esc => {
+                self.visual_selection = None;
+            }
+            UiKey::Char('v') => {
+                self.set_visual_selection_kind(VisualSelectionKind::Character);
+            }
+            UiKey::Char('V') => {
+                self.set_visual_selection_kind(VisualSelectionKind::Line);
+            }
+            UiKey::Char('\u{16}') => {
+                self.set_visual_selection_kind(VisualSelectionKind::Block);
+            }
+            UiKey::Char('y') => {
+                self.copy_visual_selection(right_content, false);
+            }
+            UiKey::Char('Y') => {
+                self.copy_visual_selection(right_content, true);
+            }
+            UiKey::Char('h') | UiKey::Left => {
+                self.move_visual_cursor(0, -1, right_content);
+            }
+            UiKey::Char('j') | UiKey::Down => {
+                self.move_visual_cursor(1, 0, right_content);
+            }
+            UiKey::Char('k') | UiKey::Up => {
+                self.move_visual_cursor(-1, 0, right_content);
+            }
+            UiKey::Char('l') | UiKey::Right => {
+                self.move_visual_cursor(0, 1, right_content);
+            }
+            _ => {}
+        }
+        Vec::new()
+    }
+
+    fn set_visual_selection_kind(&mut self, kind: VisualSelectionKind) {
+        if let Some(selection) = &mut self.visual_selection {
+            selection.kind = kind;
+        }
+    }
+
+    fn move_visual_cursor(&mut self, row_delta: isize, column_delta: isize, right_content: &str) {
+        let Some(pane) = self
+            .visual_selection
+            .as_ref()
+            .map(|selection| selection.pane)
+        else {
+            return;
+        };
+        let lines = self.selection_text_lines(pane, right_content);
+        let Some(selection) = &mut self.visual_selection else {
+            return;
+        };
+        let max_row = lines.len().saturating_sub(1);
+        let next_row = (selection.cursor.row as isize + row_delta).clamp(0, max_row as isize);
+        let next_row = next_row as usize;
+        let max_column = lines
+            .get(next_row)
+            .map(|line| line_char_count(line).saturating_sub(1))
+            .unwrap_or(0);
+        let next_column =
+            (selection.cursor.column as isize + column_delta).clamp(0, max_column as isize);
+        selection.cursor = TextPosition {
