+#[test]
+fn terminal_app_review_completion_yes_closes_and_typing_reopens_patch_chat() {
+    let root = git_repo("terminal-app-review-completion-close");
+    fs::write(root.join("README.md"), "before\n").unwrap();
+    Command::new("git")
+        .current_dir(&root)
+        .args(["add", "README.md"])
+        .status()
+        .unwrap();
+    Command::new("git")
+        .current_dir(&root)
+        .args(["commit", "-m", "ADD initial readme fixture"])
+        .status()
+        .unwrap();
+    let backend = FakeBackend::new([
+        "patch done\n@work-leaf patch update readme\n--- a/README.md\n+++ b/README.md\n@@ -1 +1 @@\n-before\n+after\n@work-leaf end\n@work-leaf done",
+        "summary: README changes",
+        "NO_FINDINGS",
+        "follow-up after close",
+    ]);
+    let chat = CommandChat::new(root, backend);
+    let mut app = TerminalApp::new(chat, 100, 24);
+
+    app.handle_bytes(b":new patch terminal close\n");
+    assert!(app.wait_for_idle(Duration::from_secs(2)));
+    assert!(
+        app.render_frame()
+            .contains("work-leaf: review is done. Is this feature done? yes/no")
+    );
+
+    app.handle_bytes(b"yes\n");
+
+    assert!(
+        app.render_frame()
+            .contains("work-leaf: feature marked done")
+    );
+    assert!(!app.ui().render_left_pane().contains("patch user-1"));
+    assert_eq!(
+        app.ui().selected_agent().map(AgentId::as_str),
+        Some("user-1")
+    );
+
+    app.handle_bytes(b"one more thing\n");
