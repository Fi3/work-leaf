+const FEATURE_COMPLETION_PROMPT_NEEDLE: &str = "Is this feature done? yes/no";
+const FEATURE_COMPLETION_CLOSED: &str = "work-leaf: feature marked done";
+const FEATURE_COMPLETION_OPEN: &str = "work-leaf: feature kept open";
+const FEATURE_COMPLETION_REOPENED: &str = "work-leaf: feature reopened";
+
+fn feature_completion_pending_sessions(snapshot: &WorkLeafSnapshot) -> BTreeSet<AgentId> {
+    snapshot
+        .sessions
+        .iter()
+        .filter(|session| session_feature_completion_pending(session))
+        .map(|session| session.id.clone())
+        .collect()
+}
+
+fn session_feature_completion_pending(session: &WorkLeafSession) -> bool {
+    session.lines.iter().fold(false, |pending, line| {
+        if is_feature_completion_prompt(line) {
+            true
+        } else if is_feature_completion_closed(line) || is_feature_completion_open(line) {
+            false
+        } else {
+            pending
+        }
+    })
+}
+
+fn is_feature_completion_prompt(line: &str) -> bool {
+    line.contains(FEATURE_COMPLETION_PROMPT_NEEDLE)
+}
+
+fn is_feature_completion_closed(line: &str) -> bool {
+    line == FEATURE_COMPLETION_CLOSED
+}
+
+fn is_feature_completion_open(line: &str) -> bool {
+    line == FEATURE_COMPLETION_OPEN || line == FEATURE_COMPLETION_REOPENED
+}
+
+fn is_feature_completion_yes(message: &str) -> bool {
+    matches!(message.trim().to_ascii_lowercase().as_str(), "yes" | "y")
+}
