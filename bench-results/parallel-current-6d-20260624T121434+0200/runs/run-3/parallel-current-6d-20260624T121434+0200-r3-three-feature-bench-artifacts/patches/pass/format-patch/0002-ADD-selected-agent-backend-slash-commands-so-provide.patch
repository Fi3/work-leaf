+pub(crate) fn selected_agent_backend_command(message: &str) -> Option<&str> {
+    let command = message.trim();
+    let rest = command.strip_prefix('/')?;
+    if rest.chars().next()?.is_whitespace() {
+        return None;
+    }
+    rest.split_whitespace().next().map(|_| command)
+}
