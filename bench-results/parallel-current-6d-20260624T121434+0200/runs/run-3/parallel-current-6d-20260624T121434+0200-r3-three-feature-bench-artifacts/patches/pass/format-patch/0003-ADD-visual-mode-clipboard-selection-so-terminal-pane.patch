+    fn apply_visual_selection(&self, buffer: &mut Buffer, right_content: &str) {
+        let Some(selection) = self.visual_selection else {
+            return;
+        };
+        let Some((origin_x, origin_y, width, height, lines)) =
+            self.visual_pane_context(selection.focus, right_content)
+        else {
+            return;
+        };
+        let width = usize::from(width);
+        let height = usize::from(height);
+        for (line_index, start, end) in selected_line_ranges(&lines, selection, width) {
+            if line_index >= height {
+                continue;
+            }
+            let start = start.min(width);
+            let end = end.min(width);
+            for column in start..end {
+                let x = origin_x.saturating_add(column.min(usize::from(u16::MAX)) as u16);
+                let y = origin_y.saturating_add(line_index.min(usize::from(u16::MAX)) as u16);
+                if x < buffer.area.width && y < buffer.area.height {
+                    buffer.get_mut(x, y).modifier.insert(Modifier::REVERSED);
+                }
+            }
+        }
+    }
+
+    fn visual_cursor_position(
+        &self,
+        selection: VisualSelection,
+        right_content: &str,
+    ) -> (u16, u16) {
+        let Some((origin_x, origin_y, width, height, lines)) =
+            self.visual_pane_context(selection.focus, right_content)
+        else {
+            return (1, 1);
+        };
+        let row = selection
+            .cursor
+            .row
+            .min(lines.len().saturating_sub(1))
+            .min(usize::from(height.saturating_sub(1)));
+        let line_width = lines.get(row).map(|line| line.chars().count()).unwrap_or(0);
+        let column = selection
+            .cursor
+            .column
+            .min(line_width.saturating_sub(1))
+            .min(usize::from(width.saturating_sub(1)));
+        (
+            origin_y
+                .saturating_add(row.min(usize::from(u16::MAX)) as u16)
+                .saturating_add(1),
+            origin_x
+                .saturating_add(column.min(usize::from(u16::MAX)) as u16)
+                .saturating_add(1),
+        )
+    }
+
+    fn visual_pane_context(
+        &self,
+        focus: PaneFocus,
+        right_content: &str,
+    ) -> Option<(u16, u16, u16, u16, Vec<String>)> {
+        let layout = self.layout();
+        let body_height = self.height.saturating_sub(1);
+        let inner_height = body_height.saturating_sub(2).max(1);
+        match focus {
+            PaneFocus::Left if self.left_visible && layout.left_width > 0 => Some((
+                1,
+                1,
+                layout.left_width.saturating_sub(2).max(1),
+                inner_height,
+                self.left_content_lines(),
+            )),
+            PaneFocus::Left => None,
+            PaneFocus::Right => {
+                let right_x = if self.left_visible {
+                    layout.left_width
+                } else {
+                    0
+                };
+                let inner_width = layout.right_width.saturating_sub(2).max(1);
+                Some((
+                    right_x.saturating_add(1),
+                    1,
+                    inner_width,
+                    inner_height,
+                    wrapped_content_lines(right_content, inner_width),
+                ))
+            }
+        }
+    }
