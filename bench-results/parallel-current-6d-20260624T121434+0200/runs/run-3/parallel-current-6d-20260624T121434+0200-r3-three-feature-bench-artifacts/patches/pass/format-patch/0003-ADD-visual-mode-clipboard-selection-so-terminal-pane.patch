+    let anchor = clamp_visual_position(selection.anchor, lines);
+    let cursor = clamp_visual_position(selection.cursor, lines);
+    match selection.kind {
+        VisualSelectionKind::Character => {
+            let (start, end) = ordered_positions(anchor, cursor);
+            (start.row..=end.row)
+                .map(|row| {
+                    let line_len = lines[row].chars().count();
+                    let start_column = if row == start.row {
+                        start.column.min(line_len)
+                    } else {
+                        0
+                    };
+                    let end_column = if row == end.row {
+                        end.column.saturating_add(1).min(line_len)
+                    } else {
+                        line_len
+                    };
+                    (row, start_column, end_column)
+                })
+                .collect()
+        }
+        VisualSelectionKind::Line => {
+            let start = anchor.row.min(cursor.row);
+            let end = anchor.row.max(cursor.row);
+            (start..=end).map(|row| (row, 0, full_width)).collect()
+        }
+        VisualSelectionKind::Block => {
+            let start_row = anchor.row.min(cursor.row);
+            let end_row = anchor.row.max(cursor.row);
+            let start_column = anchor.column.min(cursor.column);
+            let end_column = anchor.column.max(cursor.column).saturating_add(1);
+            (start_row..=end_row)
+                .map(|row| {
+                    let line_len = lines[row].chars().count();
+                    (row, start_column.min(line_len), end_column.min(line_len))
+                })
+                .collect()
+        }
+    }
+}
+
+fn clamp_visual_position(position: VisualPosition, lines: &[String]) -> VisualPosition {
+    let row = position.row.min(lines.len().saturating_sub(1));
+    let max_column = lines
+        .get(row)
+        .map(|line| line.chars().count().saturating_sub(1))
+        .unwrap_or(0);
+    VisualPosition {
+        row,
+        column: position.column.min(max_column),
+    }
+}
+
+fn ordered_positions(
+    first: VisualPosition,
+    second: VisualPosition,
+) -> (VisualPosition, VisualPosition) {
+    if (first.row, first.column) <= (second.row, second.column) {
+        (first, second)
+    } else {
+        (second, first)
+    }
+}
+
+fn slice_chars(text: &str, start: usize, end: usize) -> String {
+    text.chars()
+        .skip(start)
+        .take(end.saturating_sub(start))
+        .collect()
+}
+
+fn base64_encode(bytes: &[u8]) -> String {
+    const TABLE: &[u8; 64] = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    let mut output = String::with_capacity(bytes.len().div_ceil(3) * 4);
+    for chunk in bytes.chunks(3) {
+        let first = chunk[0];
+        let second = *chunk.get(1).unwrap_or(&0);
+        let third = *chunk.get(2).unwrap_or(&0);
+        output.push(TABLE[usize::from(first >> 2)] as char);
+        output.push(TABLE[usize::from(((first & 0b0000_0011) << 4) | (second >> 4))] as char);
+        if chunk.len() > 1 {
+            output.push(TABLE[usize::from(((second & 0b0000_1111) << 2) | (third >> 6))] as char);
+        } else {
+            output.push('=');
+        }
+        if chunk.len() > 2 {
+            output.push(TABLE[usize::from(third & 0b0011_1111)] as char);
+        } else {
+            output.push('=');
+        }
+    }
+    output
+}
+
 fn visual_rows(line: &str, width: u16) -> u16 {
     visual_row_count(line, width).min(usize::from(u16::MAX)) as u16
 }
