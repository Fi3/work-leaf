+fn clipboard_prefix(pending: &RefCell<Option<String>>) -> String {
+    let Some(text) = pending.borrow_mut().take() else {
+        return String::new();
+    };
+    format!("\u{1b}]52;c;{}\u{7}", base64_encode(text.as_bytes()))
+}
+
+fn wrapped_content_lines(content: &str, width: u16) -> Vec<String> {
+    let width = usize::from(width.max(1));
+    let mut rows = Vec::new();
+    for line in content.lines() {
+        if line.is_empty() {
+            rows.push(String::new());
+            continue;
+        }
+        let mut row = String::new();
+        let mut row_width = 0;
+        for ch in line.chars() {
+            row.push(ch);
+            row_width += 1;
+            if row_width == width {
+                rows.push(std::mem::take(&mut row));
+                row_width = 0;
+            }
+        }
+        if !row.is_empty() {
+            rows.push(row);
+        }
+    }
+    rows
+}
+
+fn move_index(current: usize, delta: isize, max: usize) -> usize {
+    if delta.is_negative() {
+        current.saturating_sub(delta.unsigned_abs()).min(max)
+    } else {
+        current.saturating_add(delta as usize).min(max)
+    }
+}
+
+fn selected_text(lines: &[String], selection: VisualSelection) -> String {
+    if lines.is_empty() {
+        return String::new();
+    }
+    selected_line_ranges(lines, selection, usize::MAX)
+        .into_iter()
+        .map(|(line_index, start, end)| slice_chars(&lines[line_index], start, end))
+        .collect::<Vec<_>>()
+        .join("\n")
+}
