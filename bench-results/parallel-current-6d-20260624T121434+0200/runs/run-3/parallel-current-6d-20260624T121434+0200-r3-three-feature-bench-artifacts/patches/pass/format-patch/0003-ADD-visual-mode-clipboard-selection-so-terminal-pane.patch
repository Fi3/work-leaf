+    fn handle_visual_key(&mut self, key: UiKey) -> Vec<UiAction> {
+        match key {
+            UiKey::Esc => {
+                self.clear_visual_selection();
+            }
+            UiKey::Char('y') => {
+                self.copy_visual_selection(false);
+            }
+            UiKey::Char('Y') => {
+                self.copy_visual_selection(true);
+            }
+            UiKey::Char('h') | UiKey::Left => {
+                self.move_visual_cursor(0, -1);
+            }
+            UiKey::Char('j') | UiKey::Down => {
+                self.move_visual_cursor(1, 0);
+            }
+            UiKey::Char('k') | UiKey::Up => {
+                self.move_visual_cursor(-1, 0);
+            }
+            UiKey::Char('l') | UiKey::Right => {
+                self.move_visual_cursor(0, 1);
+            }
+            _ => {}
+        }
+        Vec::new()
+    }
+
+    fn start_visual_selection(&mut self, kind: VisualSelectionKind) {
+        self.mode = UiMode::Command;
+        let position = self.visual_start_position(self.focus);
+        self.visual_selection = Some(VisualSelection {
+            focus: self.focus,
+            kind,
+            anchor: position,
+            cursor: position,
+        });
+    }
+
+    fn clear_visual_selection(&mut self) {
+        self.visual_selection = None;
+    }
+
+    fn visual_start_position(&self, focus: PaneFocus) -> VisualPosition {
+        match focus {
+            PaneFocus::Left => {
+                let lines = self.left_content_lines();
+                VisualPosition {
+                    row: self
+                        .left_selected_content_row()
+                        .min(lines.len().saturating_sub(1)),
+                    column: 0,
+                }
+            }
+            PaneFocus::Right => VisualPosition { row: 0, column: 0 },
+        }
+    }
+
+    fn move_visual_cursor(&mut self, row_delta: isize, column_delta: isize) {
+        let Some(selection) = self.visual_selection else {
+            return;
+        };
+        let lines = self.visual_lines(selection.focus);
+        let max_row = lines.len().saturating_sub(1);
+        let next_row = move_index(selection.cursor.row, row_delta, max_row);
+        let max_column = lines
+            .get(next_row)
+            .map(|line| line.chars().count().saturating_sub(1))
+            .unwrap_or(0);
+        let next_column = move_index(selection.cursor.column, column_delta, max_column);
+        if let Some(selection) = self.visual_selection.as_mut() {
+            selection.cursor = VisualPosition {
+                row: next_row,
+                column: next_column,
+            };
+        }
+    }
+
+    fn copy_visual_selection(&mut self, force_linewise: bool) {
+        let Some(mut selection) = self.visual_selection else {
+            return;
+        };
+        if force_linewise {
+            selection.kind = VisualSelectionKind::Line;
+        }
+        let text = selected_text(&self.visual_lines(selection.focus), selection);
+        self.store_copied_text(text);
+        self.clear_visual_selection();
+    }
+
+    fn copy_current_line(&mut self) {
+        let lines = self.visual_lines(self.focus);
+        let row = self
+            .visual_start_position(self.focus)
+            .row
+            .min(lines.len().saturating_sub(1));
+        let text = lines.get(row).cloned().unwrap_or_default();
+        self.store_copied_text(text);
+    }
+
+    fn store_copied_text(&mut self, text: String) {
