+pub(crate) fn selected_agent_backend_command(message: &str) -> Option<&str> {
+    let command_line = message.trim().strip_prefix('/')?;
+    let first = command_line.chars().next()?;
+    if first.is_whitespace() {
+        None
+    } else {
+        Some(command_line)
+    }
