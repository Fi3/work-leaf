+    fn move_visual_cursor(&mut self, row_delta: isize, column_delta: isize) {
+        let Some(selection) = self.visual_selection.clone() else {
+            return;
+        };
+        let lines = self.focus_source_lines(selection.focus);
+        if lines.is_empty() {
+            return;
+        }
+
+        let row = selection
+            .cursor
+            .row
+            .saturating_add_signed(row_delta)
+            .min(lines.len().saturating_sub(1));
+        let max_column = line_char_count(&lines[row]).saturating_sub(1);
+        let column = selection
+            .cursor
+            .column
+            .saturating_add_signed(column_delta)
+            .min(max_column);
+
+        self.visual_selection = Some(VisualSelection {
+            cursor: VisualPosition { row, column },
+            ..selection
+        });
+    }
