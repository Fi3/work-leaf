+    fn apply_left_visual_selection(&self, buffer: &mut Buffer, selection: &VisualSelection) {
+        let layout = self.layout();
+        if layout.left_width == 0 {
+            return;
+        }
+
+        let lines = self.left_visible_lines();
+        let ranges = selection_ranges(selection, &lines, false);
+        let inner_width = usize::from(layout.left_width.saturating_sub(2).max(1));
+        let inner_height = self.pane_inner_height();
+
+        for range in ranges {
