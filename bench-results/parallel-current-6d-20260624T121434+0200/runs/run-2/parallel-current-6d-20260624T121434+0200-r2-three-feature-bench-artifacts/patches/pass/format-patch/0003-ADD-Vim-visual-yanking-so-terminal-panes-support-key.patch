+fn selected_text(selection: &VisualSelection, lines: &[String], linewise: bool) -> String {
+    selection_ranges(selection, lines, linewise)
+        .into_iter()
+        .map(|range| char_slice(&lines[range.row], range.start, range.end))
+        .collect::<Vec<_>>()
+        .join("\n")
+}
+
+fn selection_ranges(
+    selection: &VisualSelection,
+    lines: &[String],
+    linewise: bool,
+) -> Vec<SelectionRange> {
+    if lines.is_empty() {
+        return Vec::new();
+    }
+
+    let start_row = selection.anchor.row.min(selection.cursor.row);
+    let end_row = selection
+        .anchor
+        .row
+        .max(selection.cursor.row)
+        .min(lines.len().saturating_sub(1));
+    if start_row > end_row {
+        return Vec::new();
+    }
+
+    if linewise || selection.mode == VisualSelectionMode::Line {
+        return (start_row..=end_row)
+            .map(|row| SelectionRange {
+                row,
+                start: 0,
+                end: line_char_count(&lines[row]),
+            })
+            .collect();
+    }
+
+    if selection.mode == VisualSelectionMode::Block {
+        let start_column = selection.anchor.column.min(selection.cursor.column);
+        let end_column = selection
+            .anchor
+            .column
+            .max(selection.cursor.column)
+            .saturating_add(1);
+        return (start_row..=end_row)
+            .map(|row| {
+                let line_len = line_char_count(&lines[row]);
+                SelectionRange {
+                    row,
+                    start: start_column.min(line_len),
+                    end: end_column.min(line_len),
+                }
+            })
+            .collect();
+    }
+
+    let (start, end) = ordered_visual_positions(selection.anchor, selection.cursor);
+    (start.row..=end.row.min(lines.len().saturating_sub(1)))
+        .map(|row| {
+            let line_len = line_char_count(&lines[row]);
+            let start_column = if row == start.row {
+                start.column.min(line_len)
+            } else {
+                0
+            };
+            let end_column = if row == end.row {
+                end.column.saturating_add(1).min(line_len)
+            } else {
+                line_len
+            };
+            SelectionRange {
+                row,
+                start: start_column,
+                end: end_column,
+            }
+        })
+        .collect()
+}
+
+fn ordered_visual_positions(
+    left: VisualPosition,
+    right: VisualPosition,
+) -> (VisualPosition, VisualPosition) {
+    if (left.row, left.column) <= (right.row, right.column) {
+        (left, right)
+    } else {
+        (right, left)
+    }
+}
+
+fn char_slice(line: &str, start: usize, end: usize) -> String {
+    line.chars()
+        .skip(start)
+        .take(end.saturating_sub(start))
+        .collect()
+}
+
+fn mark_reversed(buffer: &mut Buffer, x: usize, y: usize) {
+    if x >= usize::from(buffer.area.width) || y >= usize::from(buffer.area.height) {
+        return;
+    }
+    buffer
+        .get_mut(
+            x.min(usize::from(u16::MAX)) as u16,
+            y.min(usize::from(u16::MAX)) as u16,
+        )
+        .modifier
+        .insert(Modifier::REVERSED);
+}
