+
+        match focus {
+            PaneFocus::Left => VisualPosition {
+                row: self.left_visual_cursor_row(lines.len()),
+                column: 0,
+            },
+            PaneFocus::Right => {
+                let row = lines.len().saturating_sub(1);
+                let line_len = line_char_count(&lines[row]);
+                let column = self
