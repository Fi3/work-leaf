+#[test]
+fn controller_routes_selected_agent_status_slash_command_to_backend_command() {
+    let backend = FakeBackend::new(["launch reply"]);
+    let chat = CommandChat::new(PathBuf::from("/repo"), backend.clone());
+    let mut controller = WorkLeafController::new(chat);
+
+    let agent_id = controller.create_agent("inspect status").unwrap();
+    assert!(controller.wait_for_idle(Duration::from_secs(1)));
+
+    controller.send_message(&agent_id, "/status").unwrap();
+
+    assert!(controller.wait_for_idle(Duration::from_secs(1)));
+    let snapshot = controller.snapshot();
+    let session = snapshot.session(&agent_id).expect("session exists");
+    assert!(session.lines.iter().any(|line| line == "user: /status"));
+    assert!(
+        session
+            .lines
+            .iter()
+            .any(|line| line == "backend command output for /status")
+    );
+    assert!(
+        backend.sends().is_empty(),
+        "/status must not use the ordinary backend send path"
+    );
+    assert_eq!(backend.commands(), vec![(agent_id, "/status".to_string())]);
+}
+
+#[test]
+fn controller_routes_selected_agent_fork_slash_command_to_backend_command() {
+    let backend = FakeBackend::new(["launch reply"]);
+    let chat = CommandChat::new(PathBuf::from("/repo"), backend.clone());
+    let mut controller = WorkLeafController::new(chat);
+
+    let agent_id = controller.create_agent("forkable task").unwrap();
+    assert!(controller.wait_for_idle(Duration::from_secs(1)));
+
+    controller
+        .send_message(&agent_id, "/fork continue on branch")
+        .unwrap();
+
+    assert!(controller.wait_for_idle(Duration::from_secs(1)));
+    let snapshot = controller.snapshot();
+    let session = snapshot.session(&agent_id).expect("session exists");
+    assert!(
+        session
+            .lines
+            .iter()
+            .any(|line| line == "backend command output for /fork continue on branch")
+    );
+    assert_eq!(
+        backend.commands(),
+        vec![(agent_id, "/fork continue on branch".to_string())]
+    );
+}
