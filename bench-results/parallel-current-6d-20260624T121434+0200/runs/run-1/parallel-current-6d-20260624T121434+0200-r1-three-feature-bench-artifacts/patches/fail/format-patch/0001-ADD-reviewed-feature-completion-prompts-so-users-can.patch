+    fn handle_feature_done_response(&mut self, agent_id: &AgentId, message: &str) -> bool {
+        if !self.feature_done_prompts.contains(agent_id) {
+            return false;
+        }
+
+        let normalized = message.trim().to_ascii_lowercase();
+        if matches!(normalized.as_str(), "yes" | "y") {
+            self.feature_done_prompts.remove(agent_id);
+            self.transcript.push(FEATURE_MARKED_DONE_LINE.to_string());
+            let _ = self.ui.set_agent_hidden_state(agent_id, true);
+            return true;
+        }
+
+        if matches!(normalized.as_str(), "no" | "n") {
+            self.feature_done_prompts.remove(agent_id);
+            self.transcript
+                .push("work-leaf: feature remains open".to_string());
+            return true;
+        }
+
+        self.feature_done_prompts.remove(agent_id);
+        false
+    }
