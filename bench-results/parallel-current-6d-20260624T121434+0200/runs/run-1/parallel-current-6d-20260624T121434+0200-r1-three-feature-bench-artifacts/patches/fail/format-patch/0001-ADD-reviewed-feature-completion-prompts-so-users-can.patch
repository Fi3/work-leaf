+#[test]
+fn scripted_harness_feature_done_prompt_closes_and_reopens_chat() {
+    let mut harness = UiHarness::new(100, 24);
+
+    harness
+        .ask_feature_done("user-1")
+        .expect("fixture user-1 agent is registered");
+
+    let prompt_frame = harness.render_frame();
+    assert!(prompt_frame.starts_with('\u{7}'));
+    assert!(
+        harness
+            .ui()
+            .render_left_pane()
+            .contains("\u{1b}[7m>parser user-1  working: parser  READY\u{1b}[0m")
+    );
+    assert!(prompt_frame.contains("work-leaf: is this feature done? yes/no"));
+
+    harness.handle_bytes(b"iyes\n");
+
+    assert!(
+        !harness
+            .ui()
+            .render_left_pane()
+            .contains(">parser user-1  working: parser")
+    );
+    assert!(
+        harness
+            .transcript()
+            .iter()
+            .any(|line| line == "work-leaf: feature marked done")
+    );
+
+    harness.handle_bytes(b"one more fix\n");
+
+    assert!(
+        harness
+            .ui()
+            .render_left_pane()
+            .contains(">parser user-1  working: parser")
+    );
+    assert!(
+        harness
+            .transcript()
+            .iter()
+            .any(|line| line == "user-1> one more fix")
+    );
+}
