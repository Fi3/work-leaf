+    fn handle_visual_key(
+        &mut self,
+        key: UiKey,
+        right_content: &str,
+        right_cursor_column: Option<usize>,
+    ) -> Vec<UiAction> {
+        match key {
+            UiKey::Esc => {
+                self.visual_selection = None;
+                self.mode = UiMode::Command;
+            }
+            UiKey::Char('v') => {
+                self.change_visual_kind(VisualKind::Character, right_content, right_cursor_column);
+            }
+            UiKey::Char('V') => {
+                self.change_visual_kind(VisualKind::Line, right_content, right_cursor_column);
+            }
+            UiKey::CtrlV => {
+                self.change_visual_kind(VisualKind::Block, right_content, right_cursor_column);
+            }
+            UiKey::Char('h') | UiKey::Left => {
+                self.move_visual_cursor(0, -1, right_content);
+            }
+            UiKey::Char('l') | UiKey::Right => {
+                self.move_visual_cursor(0, 1, right_content);
+            }
+            UiKey::Char('j') | UiKey::Down => {
+                self.move_visual_cursor(1, 0, right_content);
+            }
+            UiKey::Char('k') | UiKey::Up => {
+                self.move_visual_cursor(-1, 0, right_content);
+            }
+            UiKey::Char('y') => {
+                self.yank_visual_selection(false, right_content);
+            }
+            UiKey::Char('Y') => {
+                self.yank_visual_selection(true, right_content);
+            }
+            _ => {}
+        }
+        Vec::new()
+    }
+
+    fn start_visual_selection(
+        &mut self,
+        kind: VisualKind,
+        right_content: &str,
+        right_cursor_column: Option<usize>,
+    ) {
+        let cursor = self.visual_start_point(kind, right_content, right_cursor_column);
+        self.visual_selection = Some(VisualSelection {
+            pane: self.focus,
+            kind,
+            anchor: cursor,
+            cursor,
+        });
+        self.mode = UiMode::Visual;
+    }
+
+    fn change_visual_kind(
+        &mut self,
+        kind: VisualKind,
+        right_content: &str,
+        right_cursor_column: Option<usize>,
+    ) {
+        if let Some(selection) = &mut self.visual_selection {
+            selection.kind = kind;
+        } else {
+            self.start_visual_selection(kind, right_content, right_cursor_column);
+        }
+    }
+
+    fn visual_start_point(
+        &self,
+        kind: VisualKind,
+        right_content: &str,
+        right_cursor_column: Option<usize>,
+    ) -> TextPoint {
+        match self.focus {
+            PaneFocus::Left => TextPoint {
+                line: self.control_selected_line_index(),
+                column: 0,
+            },
+            PaneFocus::Right => {
+                let lines = self.right_visual_lines(right_content);
+                let line = lines.len().saturating_sub(1);
+                let line_width = char_count(&lines[line]);
+                let column = if kind == VisualKind::Line {
+                    0
+                } else {
+                    right_cursor_column
+                        .unwrap_or(line_width)
+                        .saturating_sub(1)
+                        .min(line_width.saturating_sub(1))
+                };
+                TextPoint { line, column }
+            }
+        }
+    }
+
+    fn move_visual_cursor(&mut self, line_delta: isize, column_delta: isize, right_content: &str) {
+        let Some(current) = self.visual_selection.clone() else {
+            return;
+        };
+        let lines = self.selection_lines(current.pane, right_content);
+        let last_line = lines.len().saturating_sub(1);
+        let line = current
+            .cursor
+            .line
+            .saturating_add_signed(line_delta)
+            .min(last_line);
+        let max_column = char_count(&lines[line]).saturating_sub(1);
+        let column = current
+            .cursor
+            .column
+            .saturating_add_signed(column_delta)
+            .min(max_column);
+        if let Some(selection) = &mut self.visual_selection {
+            selection.cursor = TextPoint { line, column };
+        }
+    }
+
+    fn yank_visual_selection(&mut self, force_linewise: bool, right_content: &str) {
+        let Some(mut selection) = self.visual_selection.clone() else {
+            return;
+        };
+        if force_linewise {
+            selection.kind = VisualKind::Line;
+        }
+        let lines = self.selection_lines(selection.pane, right_content);
+        let yanked = selected_text(&selection, &lines);
+        let char_count = yanked.chars().count();
+        self.last_yank = Some(yanked);
+        self.pending_clipboard_yank.set(true);
+        self.visual_selection = None;
+        self.mode = UiMode::Command;
+        self.show_status_notice(
+            format!("yanked {char_count} chars"),
+            Duration::from_secs(STATUS_NOTICE_SECONDS),
+        );
