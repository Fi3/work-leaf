+fn char_count(text: &str) -> usize {
+    text.chars().count()
+}
+
+fn selected_text(selection: &VisualSelection, lines: &[String]) -> String {
+    let mut selected = Vec::new();
+    for (line_index, line) in lines.iter().enumerate() {
+        let Some((start, end)) = selected_range_for_line(selection, line_index, char_count(line))
+        else {
+            continue;
+        };
+        selected.push(
+            line.chars()
+                .skip(start)
+                .take(end.saturating_sub(start))
+                .collect::<String>(),
+        );
+    }
+    let mut text = selected.join("\n");
+    if selection.kind == VisualKind::Line && !text.is_empty() {
+        text.push('\n');
+    }
+    text
