+
+fn selected_range_for_line(
+    selection: &VisualSelection,
+    line_index: usize,
+    line_len: usize,
+) -> Option<(usize, usize)> {
+    match selection.kind {
+        VisualKind::Character => character_selection_range(selection, line_index, line_len),
+        VisualKind::Line => line_selection_range(selection, line_index, line_len),
+        VisualKind::Block => block_selection_range(selection, line_index, line_len),
+    }
+}
+
+fn character_selection_range(
+    selection: &VisualSelection,
+    line_index: usize,
+    line_len: usize,
+) -> Option<(usize, usize)> {
+    let (start, end) = ordered_points(selection.anchor, selection.cursor);
+    if line_index < start.line || line_index > end.line {
+        return None;
+    }
+    if start.line == end.line {
+        let range_start = start.column.min(line_len);
+        let range_end = end.column.saturating_add(1).min(line_len);
+        return Some((range_start, range_end.max(range_start)));
+    }
+    if line_index == start.line {
+        return Some((start.column.min(line_len), line_len));
+    }
+    if line_index == end.line {
+        let range_end = end.column.saturating_add(1).min(line_len);
+        return Some((0, range_end));
+    }
+    Some((0, line_len))
+}
+
+fn line_selection_range(
+    selection: &VisualSelection,
+    line_index: usize,
+    line_len: usize,
+) -> Option<(usize, usize)> {
+    let start = selection.anchor.line.min(selection.cursor.line);
+    let end = selection.anchor.line.max(selection.cursor.line);
+    (start..=end).contains(&line_index).then_some((0, line_len))
+}
+
+fn block_selection_range(
+    selection: &VisualSelection,
+    line_index: usize,
+    line_len: usize,
+) -> Option<(usize, usize)> {
+    let start_line = selection.anchor.line.min(selection.cursor.line);
+    let end_line = selection.anchor.line.max(selection.cursor.line);
+    if !(start_line..=end_line).contains(&line_index) {
+        return None;
+    }
+    let start = selection
+        .anchor
+        .column
+        .min(selection.cursor.column)
+        .min(line_len);
+    let end = selection
+        .anchor
+        .column
+        .max(selection.cursor.column)
+        .saturating_add(1)
+        .min(line_len);
+    Some((start, end.max(start)))
+}
+
+fn ordered_points(left: TextPoint, right: TextPoint) -> (TextPoint, TextPoint) {
+    if (left.line, left.column) <= (right.line, right.column) {
+        (left, right)
+    } else {
+        (right, left)
+    }
+}
+
+fn osc52_clipboard_sequence(text: &str) -> String {
+    format!("\u{1b}]52;c;{}\u{7}", base64_encode(text.as_bytes()))
+}
+
+fn base64_encode(bytes: &[u8]) -> String {
+    const TABLE: &[u8; 64] = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    let mut encoded = String::new();
+    for chunk in bytes.chunks(3) {
+        let first = chunk[0];
+        let second = *chunk.get(1).unwrap_or(&0);
+        let third = *chunk.get(2).unwrap_or(&0);
+        encoded.push(TABLE[usize::from(first >> 2)] as char);
+        encoded.push(TABLE[usize::from(((first & 0b0000_0011) << 4) | (second >> 4))] as char);
+        if chunk.len() > 1 {
+            encoded.push(TABLE[usize::from(((second & 0b0000_1111) << 2) | (third >> 6))] as char);
+        } else {
+            encoded.push('=');
+        }
+        if chunk.len() > 2 {
+            encoded.push(TABLE[usize::from(third & 0b0011_1111)] as char);
+        } else {
+            encoded.push('=');
+        }
+    }
+    encoded
+}
