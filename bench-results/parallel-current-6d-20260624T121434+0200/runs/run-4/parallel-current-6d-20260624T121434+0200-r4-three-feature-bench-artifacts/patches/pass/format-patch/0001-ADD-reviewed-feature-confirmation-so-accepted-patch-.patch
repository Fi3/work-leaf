+    #[derive(Debug)]
+    struct CompletionController {
+        snapshot: crate::WorkLeafSnapshot,
+        events: Vec<WorkLeafEvent>,
+    }
+
+    impl CompletionController {
+        fn new(agent_id: AgentId) -> Self {
+            Self {
+                snapshot: crate::WorkLeafSnapshot {
+                    command_transcript: Vec::new(),
+                    sessions: vec![WorkLeafSession {
+                        id: agent_id,
+                        kind: AgentKind::Codex,
+                        title: "feature".to_string(),
+                        feature: "feature".to_string(),
+                        lines: vec!["work-leaf: is this feature done? yes/no".to_string()],
+                        loading: None,
+                        completion: WorkLeafCompletionState::AwaitingConfirmation,
+                    }],
+                },
+                events: Vec::new(),
+            }
+        }
+    }
+
+    impl TerminalController for CompletionController {
+        fn snapshot(&self) -> crate::WorkLeafSnapshot {
+            self.snapshot.clone()
+        }
+
+        fn drain_events(&mut self) -> Vec<WorkLeafEvent> {
+            std::mem::take(&mut self.events)
+        }
+
+        fn execute_command_line(&mut self, _line: &str) {}
+
+        fn send_command_agent_message(&mut self, _message: &str) {}
+
+        fn send_message(&mut self, agent_id: &AgentId, message: &str) {
+            let completion = if message == "yes" {
+                WorkLeafCompletionState::Closed
+            } else {
+                WorkLeafCompletionState::Open
+            };
+            let Some(session) = self
+                .snapshot
+                .sessions
+                .iter_mut()
+                .find(|session| &session.id == agent_id)
+            else {
+                return;
+            };
+            session.completion = completion;
+            self.events.push(WorkLeafEvent::AgentStatusUpdated {
+                agent_id: session.id.clone(),
+                kind: session.kind.clone(),
+                title: session.title.clone(),
+                feature: session.feature.clone(),
+                loading: session.loading,
+                completion,
+            });
+            if message != "yes" {
+                self.events.push(WorkLeafEvent::AgentLineAppended {
+                    agent_id: session.id.clone(),
+                    line: "work-leaf: is this feature done? yes/no".to_string(),
+                });
+                session
+                    .lines
+                    .push("work-leaf: is this feature done? yes/no".to_string());
+                session.completion = WorkLeafCompletionState::AwaitingConfirmation;
+                self.events.push(WorkLeafEvent::AgentStatusUpdated {
+                    agent_id: session.id.clone(),
+                    kind: session.kind.clone(),
+                    title: session.title.clone(),
+                    feature: session.feature.clone(),
+                    loading: session.loading,
+                    completion: WorkLeafCompletionState::AwaitingConfirmation,
+                });
+            }
+        }
+
+        fn interrupt_agent(&mut self, _agent_id: &AgentId) {}
+
+        fn push_transcript_line(&mut self, _line: String) {}
+
+        fn is_busy(&mut self) -> bool {
+            false
+        }
+
+        fn loading_text(&self, _loading: WorkLeafLoading) -> String {
+            "Waiting for Codex".to_string()
+        }
+
+        fn shutdown(&mut self) {}
+    }
+
+    #[test]
+    fn reviewed_feature_confirmation_can_close_and_reopen_chat_row() {
+        let agent_id = AgentId::new("user-1").expect("test agent id is valid");
+        let controller = CompletionController::new(agent_id.clone());
+        let mut app = TerminalAppCore::new(controller, 80, 24);
+        app.ui
+            .activate_agent_chat(&agent_id)
+            .expect("test agent is registered");
+
+        assert!(app.render_frame().contains("is this feature done? yes/no"));
+        assert!(app.ui.render_left_pane().contains("feature user-1"));
+
+        app.handle_bytes(b"yes\n");
+
+        assert!(!app.ui.render_left_pane().contains("user-1"));
+        assert_eq!(app.ui.selected_agent(), Some(&agent_id));
+
+        app.handle_bytes(b"more work\n");
+
+        assert!(app.ui.render_left_pane().contains("feature user-1"));
+        let frame = app.render_frame();
+        assert_eq!(frame.matches("is this feature done? yes/no").count(), 2);
+    }
