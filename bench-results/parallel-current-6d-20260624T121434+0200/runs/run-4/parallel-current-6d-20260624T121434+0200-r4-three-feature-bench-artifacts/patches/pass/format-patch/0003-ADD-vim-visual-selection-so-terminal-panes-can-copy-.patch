+    fn handle_visual_key(&mut self, key: UiKey) -> Vec<UiAction> {
+        match key {
+            UiKey::Esc => self.cancel_visual_selection(),
+            UiKey::Char('y') | UiKey::Char('Y') => self.queue_visual_copy(),
+            UiKey::Char('v') => self.toggle_visual_kind(VisualKind::Character),
+            UiKey::Char('V') => self.toggle_visual_kind(VisualKind::Line),
+            UiKey::Char(CTRL_V_CHAR) => self.toggle_visual_kind(VisualKind::Block),
+            UiKey::Char('h') | UiKey::Left => self.move_visual_cursor(0, -1),
+            UiKey::Char('l') | UiKey::Right => self.move_visual_cursor(0, 1),
+            UiKey::Char('k') | UiKey::Up => self.move_visual_cursor(-1, 0),
+            UiKey::Char('j') | UiKey::Down => self.move_visual_cursor(1, 0),
+            _ => {}
+        }
+        Vec::new()
+    }
+
+    fn start_visual_selection(&mut self, kind: VisualKind) {
+        let focus = if self.focus == PaneFocus::Left && !self.left_visible {
+            PaneFocus::Right
+        } else {
+            self.focus
+        };
+        self.focus = focus;
+        let origin = self.visual_origin(focus);
+        self.visual_selection = Some(VisualSelection {
+            focus,
+            kind,
+            anchor: origin,
+            cursor: origin,
+        });
+        self.mode = UiMode::Command;
+        self.pending = None;
+    }
+
+    fn toggle_visual_kind(&mut self, kind: VisualKind) {
+        let Some(selection) = self.visual_selection.as_mut() else {
+            self.start_visual_selection(kind);
+            return;
+        };
+        if selection.kind == kind {
+            self.cancel_visual_selection();
+        } else {
+            selection.kind = kind;
+        }
+    }
+
+    fn cancel_visual_selection(&mut self) {
+        if self.visual_selection.take().is_some() {
+            self.mode = UiMode::Command;
+        }
+    }
+
+    fn queue_visual_copy(&mut self) {
+        if let Some(selection) = self.visual_selection.take() {
+            self.pending_copy_selection = Some(selection);
+            self.show_status_notice(
+                "copied selection",
+                Duration::from_secs(STATUS_NOTICE_SECONDS),
+            );
+        }
+        self.mode = UiMode::Command;
+    }
+
+    fn move_visual_cursor(&mut self, row_delta: isize, column_delta: isize) {
+        let Some(focus) = self
+            .visual_selection
+            .as_ref()
+            .map(|selection| selection.focus)
+        else {
+            return;
+        };
+        let (width, height) = self.visual_inner_size(focus);
+        let max_row = height.saturating_sub(1) as isize;
+        let max_column = width.saturating_sub(1) as isize;
+        let Some(selection) = self.visual_selection.as_mut() else {
+            return;
+        };
+        selection.cursor.row =
+            (selection.cursor.row as isize + row_delta).clamp(0, max_row) as usize;
+        selection.cursor.column =
+            (selection.cursor.column as isize + column_delta).clamp(0, max_column) as usize;
+    }
+
+    fn visual_origin(&self, focus: PaneFocus) -> VisualPosition {
+        match focus {
+            PaneFocus::Left => {
+                let (_, height) = self.visual_inner_size(focus);
+                VisualPosition {
+                    row: self.control_selected.min(height.saturating_sub(1)),
+                    column: 0,
+                }
+            }
+            PaneFocus::Right => VisualPosition { row: 0, column: 0 },
+        }
+    }
+
+    fn visual_inner_size(&self, focus: PaneFocus) -> (usize, usize) {
+        let layout = self.layout();
+        let body_height = self.height.saturating_sub(1);
+        let pane_width = match focus {
+            PaneFocus::Left if self.left_visible => layout.left_width,
+            PaneFocus::Left => 0,
+            PaneFocus::Right => layout.right_width,
+        };
+        let inner_width = pane_width.saturating_sub(2).max(1);
+        let inner_height = body_height.saturating_sub(2).max(1);
+        (usize::from(inner_width), usize::from(inner_height))
+    }
+
+    fn apply_visual_selection(&self, buffer: &mut Buffer) {
+        let Some(selection) = self.visual_selection.as_ref() else {
+            return;
+        };
+        let Some(rect) = self.selection_inner_rect(selection.focus) else {
+            return;
+        };
+        for (row, start_column, end_column) in
+            selected_visual_ranges(selection, usize::from(rect.width), usize::from(rect.height))
+        {
+            for column in start_column..=end_column {
+                let cell = buffer.get_mut(rect.x + column as u16, rect.y + row as u16);
+                cell.modifier.insert(Modifier::REVERSED);
+            }
+        }
+    }
+
+    fn selection_text_from_buffer(&self, buffer: &Buffer, selection: &VisualSelection) -> String {
+        let Some(rect) = self.selection_inner_rect(selection.focus) else {
+            return String::new();
+        };
+        let mut lines = Vec::new();
+        for (row, start_column, end_column) in
+            selected_visual_ranges(selection, usize::from(rect.width), usize::from(rect.height))
+        {
+            let mut line = String::new();
+            for column in start_column..=end_column {
+                line.push_str(
+                    &buffer
+                        .get(rect.x + column as u16, rect.y + row as u16)
+                        .symbol,
+                );
+            }
+            if selection.kind == VisualKind::Block {
+                lines.push(line);
+            } else {
+                lines.push(line.trim_end().to_string());
+            }
+        }
+        lines.join("\n")
+    }
+
+    fn selection_inner_rect(&self, focus: PaneFocus) -> Option<Rect> {
+        let layout = self.layout();
+        let body_height = self.height.saturating_sub(1);
+        let pane = match focus {
+            PaneFocus::Left if self.left_visible && layout.left_width > 0 => {
+                Rect::new(0, 0, layout.left_width, body_height)
+            }
+            PaneFocus::Left => return None,
