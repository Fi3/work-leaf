+fn selected_visual_ranges(
+    selection: &VisualSelection,
+    width: usize,
+    height: usize,
+) -> Vec<(usize, usize, usize)> {
+    if width == 0 || height == 0 {
+        return Vec::new();
+    }
+    let anchor = clamp_visual_position(selection.anchor, width, height);
+    let cursor = clamp_visual_position(selection.cursor, width, height);
+    match selection.kind {
+        VisualKind::Character => {
+            let (start, end) = if visual_position_before_or_equal(anchor, cursor) {
+                (anchor, cursor)
+            } else {
+                (cursor, anchor)
+            };
+            (start.row..=end.row)
+                .map(|row| {
+                    let start_column = if row == start.row { start.column } else { 0 };
+                    let end_column = if row == end.row {
+                        end.column
+                    } else {
+                        width - 1
+                    };
+                    (row, start_column, end_column)
+                })
+                .collect()
+        }
+        VisualKind::Line => {
+            let start_row = anchor.row.min(cursor.row);
+            let end_row = anchor.row.max(cursor.row);
+            (start_row..=end_row)
+                .map(|row| (row, 0, width - 1))
+                .collect()
+        }
+        VisualKind::Block => {
+            let start_row = anchor.row.min(cursor.row);
+            let end_row = anchor.row.max(cursor.row);
+            let start_column = anchor.column.min(cursor.column);
+            let end_column = anchor.column.max(cursor.column);
+            (start_row..=end_row)
+                .map(|row| (row, start_column, end_column))
+                .collect()
+        }
+    }
+}
