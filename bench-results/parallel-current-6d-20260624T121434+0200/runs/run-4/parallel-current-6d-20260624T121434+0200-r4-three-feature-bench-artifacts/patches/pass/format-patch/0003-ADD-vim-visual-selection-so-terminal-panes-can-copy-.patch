+fn clamp_visual_position(position: VisualPosition, width: usize, height: usize) -> VisualPosition {
+    VisualPosition {
+        row: position.row.min(height.saturating_sub(1)),
+        column: position.column.min(width.saturating_sub(1)),
+    }
+}
+
+fn visual_position_before_or_equal(left: VisualPosition, right: VisualPosition) -> bool {
+    (left.row, left.column) <= (right.row, right.column)
