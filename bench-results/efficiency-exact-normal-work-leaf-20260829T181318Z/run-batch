#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ "$#" != 1 || ! "$1" =~ ^[12]$ ]]; then
  echo "usage: $0 BATCH_ID" >&2
  exit 2
fi

batch="$1"
mapfile -t attempts < <(awk -F '\t' -v batch="$batch" 'NR > 1 && $1 == batch {print $2}' "$script_dir/SCHEDULE.tsv")
[[ "${#attempts[@]}" == 3 ]] || {
  echo "error: batch $batch must contain exactly three attempts" >&2
  exit 2
}
mkdir -p "$script_dir/batch-status"
complete="$script_dir/batch-status/batch-$batch.complete"
[[ ! -e "$complete" ]] || {
  echo "error: batch $batch already completed" >&2
  exit 2
}

pids=()
for attempt in "${attempts[@]}"; do
  "$script_dir/run-condition" "$attempt" "$batch" &
  pids+=("$!")
done

overall=0
statuses=()
for index in "${!pids[@]}"; do
  if wait "${pids[$index]}"; then
    statuses+=("${attempts[$index]}=0")
  else
    status=$?
    statuses+=("${attempts[$index]}=$status")
    overall=1
  fi
done
printf '%s\n' "${statuses[@]}" | tee "$complete"
exit "$overall"
