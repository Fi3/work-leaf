+#[test]
+fn scripted_harness_visual_mode_yanks_right_pane_character_selection() {
+    let mut harness = UiHarness::new(80, 24);
+
+    harness.handle_bytes(&[23, b'l']);
+    harness.handle_byte(b'v');
+
+    assert!(harness.ui().visual_selection_active());
+    assert!(
+        harness
+            .render_frame()
+            .contains("mode=visual-cursor focus=right")
+    );
+
+    harness.handle_byte(b'l');
+    assert!(
+        harness
+            .render_frame()
+            .contains("\u{1b}[7mEs\u{1b}[0mc command")
+    );
+    harness.handle_byte(b'y');
+
+    assert_eq!(harness.ui().copied_text(), Some("Es"));
+}
+
+#[test]
+fn scripted_harness_visual_mode_arrow_keys_extend_character_selection() {
+    let mut harness = UiHarness::new(80, 24);
+
+    harness.handle_bytes(&[23, b'l']);
+    harness.handle_byte(b'v');
+    harness.handle_bytes(b"\x1b[C");
+    harness.handle_byte(b'y');
+
+    assert_eq!(harness.ui().copied_text(), Some("Es"));
+}
+
+#[test]
+fn scripted_harness_visual_mode_yanks_left_pane_focused_line() {
+    let mut harness = UiHarness::new(80, 24);
+
+    assert_eq!(harness.ui().focus(), PaneFocus::Left);
+
+    harness.handle_byte(b'V');
+
+    assert!(harness.ui().visual_selection_active());
+    assert!(
+        harness
+            .render_frame()
+            .contains("mode=visual-line focus=left")
+    );
+
+    harness.handle_byte(b'Y');
+
+    let copied = harness.ui().copied_text().expect("line was copied");
+    assert!(copied.contains("user-1"));
+    assert!(!copied.contains("work-leaf"));
+}
+
+#[test]
+fn scripted_harness_visual_mode_yanks_right_pane_block_selection() {
+    let mut harness = UiHarness::new(80, 24);
+
+    harness.handle_bytes(&[23, b'l']);
+    harness.handle_byte(22);
+    harness.handle_byte(b'l');
+    harness.handle_byte(b'j');
+
+    assert!(
+        harness
+            .render_frame()
+            .contains("mode=visual-block focus=right")
+    );
+
+    harness.handle_byte(b'y');
+
+    assert_eq!(harness.ui().copied_text(), Some("Es\nch"));
+}
