+    #[test]
+    fn selected_agent_status_slash_command_uses_backend_command_without_send_prompt() {
+        let backend = ScriptedBackend::new(["launch reply", "generated title", "status: ready"]);
+        let chat = CommandChat::new(PathBuf::from("/repo"), backend.clone());
+        let mut controller = WorkLeafController::new(chat);
+        let agent_id = controller
+            .create_agent("inspect status routing")
+            .expect("agent launch is prepared");
+        assert!(controller.wait_for_idle(Duration::from_secs(1)));
+
+        controller
+            .send_message(&agent_id, "/status")
+            .expect("slash command message is accepted");
+        assert!(controller.wait_for_idle(Duration::from_secs(1)));
+
+        assert!(
+            backend.sends().is_empty(),
+            "/status must not use normal backend send path: {:?}",
+            backend.sends()
+        );
+        assert_eq!(
+            backend.commands(),
+            vec![(agent_id.clone(), "/status".to_string())]
+        );
+        let snapshot = controller.snapshot();
+        let session = snapshot
+            .session(&agent_id)
+            .expect("agent session remains visible");
+        assert!(
+            session.lines.iter().any(|line| line == "user: /status"),
+            "{session:?}"
+        );
+        assert!(
+            session.lines.iter().any(|line| line == "status: ready"),
+            "{session:?}"
+        );
+    }
