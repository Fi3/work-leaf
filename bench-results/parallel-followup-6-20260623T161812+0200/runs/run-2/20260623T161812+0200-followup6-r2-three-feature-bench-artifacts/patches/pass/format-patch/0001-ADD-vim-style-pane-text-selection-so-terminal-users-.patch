diff --git a/tests/ui_harness.rs b/tests/ui_harness.rs
index 3502bcf..cbb2444 100644
--- a/tests/ui_harness.rs
+++ b/tests/ui_harness.rs
@@ -348,6 +348,55 @@ fn scripted_harness_visual_mode_yanks_right_pane_line_to_clipboard() {
     assert!(frame.contains("copied "));
 }
 
+#[test]
+fn scripted_harness_plain_v_starts_character_selection_and_yanks_right_pane_text() {
+    let mut harness = UiHarness::new(80, 24);
+
+    harness.handle_bytes(&[23, b'l']);
+    harness.handle_byte(b'v');
+
+    assert!(harness.ui().visual_selection_active());
+    assert!(
+        harness
+            .render_frame()
+            .contains("mode=visual-char focus=right")
+    );
+
+    harness.handle_byte(b'l');
+    harness.handle_byte(b'y');
+
+    assert_eq!(harness.ui().copied_text(), Some("Es"));
+}
+
+#[test]
+fn scripted_harness_visual_line_and_block_modes_yank_left_pane_text() {
+    let mut line_harness = UiHarness::new(80, 24);
+
+    line_harness.handle_byte(b'V');
+    assert!(
+        line_harness
+            .render_frame()
+            .contains("mode=visual-line focus=left")
+    );
+    line_harness.handle_byte(b'Y');
+
+    assert_eq!(line_harness.ui().copied_text(), Some(">user-1 READY"));
+
+    let mut block_harness = UiHarness::new(80, 24);
+
+    block_harness.handle_byte(22);
+    assert!(
+        block_harness
+            .render_frame()
+            .contains("mode=visual-block focus=left")
+    );
+    block_harness.handle_byte(b'j');
+    block_harness.handle_byte(b'l');
+    block_harness.handle_byte(b'y');
+
+    assert_eq!(block_harness.ui().copied_text(), Some(">u\n  "));
+}
