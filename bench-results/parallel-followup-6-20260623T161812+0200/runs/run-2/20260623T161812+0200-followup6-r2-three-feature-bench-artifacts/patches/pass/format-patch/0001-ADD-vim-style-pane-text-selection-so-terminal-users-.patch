             PaneFocus::Right => {
@@ -2012,6 +2006,30 @@ impl TerminalUi {
             .map(|index| self.agents[index].id.clone())
     }
 
+    fn control_selection_target(&self) -> Option<LeftPaneClickTarget> {
+        if self.control_selected == 0 {
+            Some(LeftPaneClickTarget::Command)
+        } else {
+            self.control_selected_agent_id()
+                .map(LeftPaneClickTarget::Agent)
+        }
+    }
+
+    fn left_visual_start_row(&self) -> usize {
+        let inner_width = usize::from(self.layout().left_width.saturating_sub(2).max(1));
+        let lines = self.left_pane_lines(inner_width);
+        if lines.is_empty() {
+            return 0;
+        }
+        self.control_selection_target()
+            .and_then(|target| {
+                lines
+                    .iter()
+                    .position(|line| line.control_target.as_ref() == Some(&target))
+            })
+            .unwrap_or_else(|| self.control_selected.min(lines.len().saturating_sub(1)))
+    }
+
     fn left_pane_click_target(&mut self, row: u16) -> Option<LeftPaneClickTarget> {
         let list_row = usize::from(row.saturating_sub(2));
         if row < 2 {
@@ -2049,13 +2067,8 @@ impl TerminalUi {
     }
 
