+        fn execute_command(
+            &mut self,
+            agent_id: &AgentId,
+            command: &str,
+        ) -> Result<ChatMessage, crate::agent::AgentError> {
+            let mut state = self.state.lock().unwrap();
+            state.commands.push((agent_id.clone(), command.to_string()));
+            let reply = state.replies.pop_front().expect("missing fake reply");
+            if let Some(session) = state.sessions.get_mut(agent_id) {
+                session.push_message(MessageRole::User, command);
+                session.push_message(MessageRole::Agent, reply.clone());
+            }
+            Ok(ChatMessage::new(MessageRole::Agent, reply))
+        }
+
         fn session(&self, agent_id: &AgentId) -> Option<AgentSession> {
             self.state.lock().unwrap().sessions.get(agent_id).cloned()
         }
     }
 
+    #[test]
+    fn selected_agent_slash_status_executes_backend_command_without_normal_send() {
+        let backend = ScriptedBackend::new(["backend status output"]);
+        let chat = CommandChat::new(PathBuf::from("/repo"), backend.clone());
+        let mut controller = WorkLeafController::new(chat);
+        let agent_id = AgentId::new("chat-1").expect("test agent id is valid");
+        controller.register_agent_feature(agent_id.clone(), "user-agent".to_string());
+        controller.add_session(WorkLeafSession {
+            id: agent_id.clone(),
+            kind: AgentKind::Codex,
+            title: "chat-1".to_string(),
+            feature: "user-agent".to_string(),
+            lines: Vec::new(),
+            loading: None,
+            completion: None,
+            token_usage: None,
+            depends_on: Vec::new(),
+            depended_on_by: Vec::new(),
+        });
+
+        controller
+            .send_message(&agent_id, "/status")
+            .expect("slash command message is accepted");
+        assert!(controller.wait_for_idle(Duration::from_secs(2)));
+
+        assert_eq!(
+            backend.commands(),
+            vec![(agent_id.clone(), "/status".to_string())]
+        );
+        assert!(
+            backend
+                .sends()
+                .iter()
+                .all(|(_, prompt)| prompt != "/status"),
+            "/status must not be sent as an ordinary prompt: {:?}",
+            backend.sends()
+        );
+        let snapshot = controller.snapshot();
+        let session = snapshot
+            .session(&agent_id)
+            .expect("selected agent session exists");
+        assert!(session.lines.iter().any(|line| line == "user: /status"));
+        assert!(
+            session
+                .lines
+                .iter()
+                .any(|line| line == "backend status output"),
+            "{session:?}"
+        );
+    }
+
