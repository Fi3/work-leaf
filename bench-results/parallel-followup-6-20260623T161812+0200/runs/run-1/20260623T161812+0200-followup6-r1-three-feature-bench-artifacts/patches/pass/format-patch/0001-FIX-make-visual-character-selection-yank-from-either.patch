+#[test]
+fn scripted_harness_visual_character_mode_yanks_right_pane_selection_to_clipboard() {
+    let mut harness = UiHarness::new(80, 24);
+
+    harness.handle_bytes(&[23, b'l']);
+    harness.handle_byte(b'v');
+
+    assert!(harness.ui().visual_selection_active());
+    assert!(
+        harness
+            .render_frame()
+            .contains("mode=visual-char focus=right")
+    );
+
+    harness.handle_byte(b'l');
+    harness.handle_byte(b'l');
+    harness.handle_byte(b'y');
+
+    assert_eq!(harness.ui().copied_text(), Some("Esc"));
+    assert!(harness.render_frame().starts_with("\u{1b}]52;c;"));
+}
+
+#[test]
+fn scripted_harness_visual_character_mode_yanks_left_pane_selection_to_clipboard() {
+    let mut harness = UiHarness::new(80, 24);
+
+    assert_eq!(harness.ui().focus(), PaneFocus::Left);
+
+    harness.handle_byte(b'v');
+    harness.handle_byte(b'j');
+    harness.handle_byte(b'y');
+
+    assert_eq!(harness.ui().copied_text(), Some(">user-1 READY\n "));
+}
+
+#[test]
