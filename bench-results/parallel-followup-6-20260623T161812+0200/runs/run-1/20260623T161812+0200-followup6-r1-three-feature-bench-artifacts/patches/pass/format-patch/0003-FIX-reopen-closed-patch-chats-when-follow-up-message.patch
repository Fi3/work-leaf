+    #[derive(Clone, Debug)]
+    struct BlockingBackend {
+        release: Arc<(Mutex<bool>, Condvar)>,
+    }
+
+    impl BlockingBackend {
+        fn new() -> (Self, Arc<(Mutex<bool>, Condvar)>) {
+            let release = Arc::new((Mutex::new(false), Condvar::new()));
+            (
+                Self {
+                    release: Arc::clone(&release),
+                },
+                release,
+            )
+        }
+    }
+
+    impl AgentBackend for BlockingBackend {
+        fn launch(
+            &mut self,
+            request: AgentLaunch,
+        ) -> Result<AgentSession, crate::agent::AgentError> {
+            Ok(AgentSession::new(request))
+        }
+
+        fn send(
+            &mut self,
+            _agent_id: &AgentId,
+            _prompt: &str,
+        ) -> Result<ChatMessage, crate::agent::AgentError> {
+            let (lock, cvar) = &*self.release;
+            let mut released = lock.lock().unwrap();
+            while !*released {
+                released = cvar.wait(released).unwrap();
+            }
+            Ok(ChatMessage::new(
+                MessageRole::Agent,
+                "follow-up reply".to_string(),
+            ))
+        }
+    }
+
+    fn release_blocking_backend(release: &Arc<(Mutex<bool>, Condvar)>) {
+        let (lock, cvar) = &**release;
+        let mut released = lock.lock().unwrap();
+        *released = true;
+        cvar.notify_all();
+    }
+
