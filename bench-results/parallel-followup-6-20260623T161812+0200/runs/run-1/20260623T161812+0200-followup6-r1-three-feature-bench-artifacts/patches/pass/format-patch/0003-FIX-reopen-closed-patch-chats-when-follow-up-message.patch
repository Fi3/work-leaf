+    #[test]
+    fn yes_closes_feature_and_later_message_reopens_without_idle_status() {
+        let (backend, release) = BlockingBackend::new();
+        let chat = CommandChat::new(PathBuf::from("/repo"), backend);
+        let mut controller = WorkLeafController::new(chat);
+        let agent_id = AgentId::new("user-1").expect("test agent id is valid");
+
+        controller.register_agent_feature(agent_id.clone(), "completion flow".to_string());
+        controller.add_session(WorkLeafSession {
+            id: agent_id.clone(),
+            kind: AgentKind::Codex,
+            title: "completion flow".to_string(),
+            feature: "completion flow".to_string(),
+            lines: Vec::new(),
+            loading: None,
+            completion: None,
+            token_usage: None,
+            depends_on: Vec::new(),
+            depended_on_by: Vec::new(),
+        });
+        controller.ask_feature_done(&agent_id);
+        controller.drain_events();
+
+        controller
+            .send_message(&agent_id, "yes")
+            .expect("yes answer is accepted");
+
+        let snapshot = controller.snapshot();
+        let closed = snapshot
+            .session(&agent_id)
+            .expect("patch agent session exists");
+        assert_eq!(closed.completion, Some(WorkLeafCompletion::Closed));
+        assert!(
+            closed
+                .lines
+                .iter()
+                .any(|line| line == "work-leaf: feature marked closed")
+        );
+        controller.drain_events();
+
+        controller
+            .send_message(&agent_id, "continue with polish")
+            .expect("closed patch agent accepts follow-up chat");
+        let events = controller.drain_events();
+
+        assert!(events.iter().any(|event| {
+            matches!(
+                event,
+                WorkLeafEvent::AgentStatusUpdated {
+                    agent_id: updated_agent_id,
+                    loading: Some(WorkLeafLoading::WaitingForReply),
+                    completion: None,
+                    ..
+                } if updated_agent_id == &agent_id
+            )
+        }));
+        assert!(!events.iter().any(|event| {
+            matches!(
+                event,
+                WorkLeafEvent::AgentStatusUpdated {
+                    agent_id: updated_agent_id,
+                    loading: None,
+                    completion: None,
+                    ..
+                } if updated_agent_id == &agent_id
+            )
+        }));
+
+        let snapshot = controller.snapshot();
+        let reopened = snapshot
+            .session(&agent_id)
+            .expect("patch agent session exists");
+        assert_eq!(reopened.completion, None);
+        assert_eq!(reopened.loading, Some(WorkLeafLoading::WaitingForReply));
+        assert!(
+            reopened
+                .lines
+                .iter()
+                .any(|line| line == "user: continue with polish")
+        );
+
+        release_blocking_backend(&release);
+        assert!(controller.wait_for_idle(Duration::from_secs(2)));
+        let snapshot = controller.snapshot();
+        let finished = snapshot
+            .session(&agent_id)
+            .expect("patch agent session exists");
+        assert_eq!(finished.completion, None);
+        assert_eq!(finished.loading, None);
+        assert!(finished.lines.iter().any(|line| line == "follow-up reply"));
+    }
