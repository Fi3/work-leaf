diff --git a/tests/ui_harness.rs b/tests/ui_harness.rs
index 3502bcf..b241c3c 100644
--- a/tests/ui_harness.rs
+++ b/tests/ui_harness.rs
@@ -348,6 +348,74 @@ fn scripted_harness_visual_mode_yanks_right_pane_line_to_clipboard() {
     assert!(frame.contains("copied "));
 }
 
+#[test]
+fn scripted_harness_visual_mode_yanks_right_pane_character_selection_to_clipboard() {
+    let mut harness = UiHarness::new(80, 24);
+
+    harness.handle_bytes(&[23, b'l']);
+    harness.handle_byte(b'v');
+
+    assert!(harness.ui().visual_selection_active());
+
+    harness.handle_byte(b'l');
+    harness.handle_byte(b'y');
+
+    assert_eq!(harness.ui().copied_text(), Some("Es"));
+    assert!(!harness.ui().visual_selection_active());
+}
+
+#[test]
+fn scripted_harness_visual_yanks_do_not_show_command_typing_notice() {
+    let mut harness = UiHarness::new(80, 24);
+
+    harness.handle_bytes(&[23, b'l']);
+    for _ in 0..5 {
+        harness.handle_bytes(b"vly");
+    }
+
+    assert_eq!(harness.ui().copied_text(), Some("Es"));
+    assert!(
+        !harness
+            .render_frame()
+            .contains("command mode: press i for insert mode before typing")
+    );
+}
+
+#[test]
+fn scripted_harness_visual_mode_yanks_left_pane_character_selection_to_clipboard() {
+    let mut harness = UiHarness::new(80, 24);
+
+    harness.handle_byte(b'v');
+
+    assert!(harness.ui().visual_selection_active());
+
+    harness.handle_byte(b'l');
+    harness.handle_byte(b'l');
+    harness.handle_byte(b'y');
+
+    assert_eq!(harness.ui().copied_text(), Some(">us"));
+    assert!(!harness.ui().visual_selection_active());
+}
+
+#[test]
+fn scripted_harness_visual_block_yanks_right_pane_columns_to_clipboard() {
+    const CTRL_V: u8 = 22;
+
+    let mut harness = UiHarness::new(80, 24);
+
+    harness.handle_bytes(&[23, b'l']);
+    harness.handle_byte(CTRL_V);
+
+    assert!(harness.ui().visual_selection_active());
+
+    harness.handle_byte(b'j');
+    harness.handle_byte(b'l');
+    harness.handle_byte(b'y');
+
+    assert_eq!(harness.ui().copied_text(), Some("Es\nch"));
+    assert!(!harness.ui().visual_selection_active());
+}
+
