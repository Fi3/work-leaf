From: fi3 <you@example.com>
Date: Tue, 23 Jun 2026 16:42:14 +0200
Subject: [PATCH 1/3] ADD review completion regression coverage so closed patch
 chats stay reopenable

The controller test covers the completion decision path where yes/no answers close locally without backend sends, and a later user message clears the closed state before resuming the same patch chat.
---
 src/workspace.rs | 79 ++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 79 insertions(+)

diff --git a/src/workspace.rs b/src/workspace.rs
index 72d6ce4..9063377 100644
--- a/src/workspace.rs
+++ b/src/workspace.rs
@@ -2214,6 +2214,10 @@ mod tests {
         fn launches(&self) -> Vec<AgentLaunch> {
             self.state.lock().unwrap().launches.clone()
         }
+
+        fn sends(&self) -> Vec<(AgentId, String)> {
+            self.state.lock().unwrap().sends.clone()
+        }
     }
 
     impl AgentBackend for ScriptedBackend {
@@ -2285,6 +2289,81 @@ mod tests {
         assert!(!controller.implicit_loading_agents.contains_key(&agent_id));
     }
 
+    #[test]
+    fn feature_done_yes_closes_and_later_message_reopens_patch_chat() {
+        let backend = ScriptedBackend::new(["working again", "handle-another-case"]);
+        let chat = CommandChat::new(PathBuf::from("/repo"), backend.clone());
+        let mut controller = WorkLeafController::new(chat);
+        let agent_id = AgentId::new("user-1").expect("test agent id is valid");
+
+        controller.register_agent_feature(agent_id.clone(), "reviewed feature".to_string());
+        controller.add_session(WorkLeafSession {
+            id: agent_id.clone(),
+            kind: AgentKind::Codex,
+            title: "user-1".to_string(),
+            feature: "reviewed feature".to_string(),
+            lines: Vec::new(),
+            loading: None,
+            completion: None,
+            token_usage: None,
+            depends_on: Vec::new(),
+            depended_on_by: Vec::new(),
+        });
+
+        controller.ask_feature_done(&agent_id);
+        controller
+            .send_message(&agent_id, "yes")
+            .expect("completion answer is accepted");
+
+        let snapshot = controller.snapshot();
+        let session = snapshot
+            .session(&agent_id)
+            .expect("patch agent session exists");
+        assert_eq!(session.completion, Some(WorkLeafCompletion::Closed));
+        assert!(
+            session.lines.iter().any(|line| line == "user: yes"),
+            "{session:?}"
+        );
+        assert!(
+            session
+                .lines
+                .iter()
+                .any(|line| line == "work-leaf: feature marked closed"),
+            "{session:?}"
+        );
+        assert!(
+            backend.sends().is_empty(),
+            "yes/no completion answers stay local to the controller"
+        );
+
+        controller
+            .send_message(&agent_id, "handle another case")
+            .expect("closed patch chat accepts follow-up work");
+        assert!(controller.wait_for_idle(Duration::from_secs(1)));
+
+        let snapshot = controller.snapshot();
+        let session = snapshot
+            .session(&agent_id)
+            .expect("patch agent session exists");
+        assert_eq!(session.completion, None);
+        assert_eq!(session.loading, None);
+        assert!(
+            session
+                .lines
+                .iter()
+                .any(|line| line == "user: handle another case"),
+            "{session:?}"
+        );
+        assert!(
+            session.lines.iter().any(|line| line == "working again"),
+            "{session:?}"
+        );
+        assert_eq!(
+            backend.sends(),
+            vec![(agent_id, "handle another case".to_string())]
+        );
+    }
+
     #[test]
     fn non_user_patch_agent_done_starts_review_and_completion_question() {
         let root = git_repo("workspace-non-user-review-completion");
