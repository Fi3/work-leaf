+    #[test]
+    fn selected_agent_slash_status_runs_backend_command_without_normal_send() {
+        let backend = ScriptedBackend::new(["status output"]);
+        let chat = CommandChat::new(PathBuf::from("/repo"), backend.clone());
+        let mut controller = WorkLeafController::new(chat);
+        let agent_id = AgentId::new("user-1").expect("test agent id is valid");
+
+        controller.register_agent_feature(agent_id.clone(), "slash status".to_string());
+        controller.add_session(WorkLeafSession {
+            id: agent_id.clone(),
+            kind: AgentKind::Codex,
+            title: "user-1".to_string(),
+            feature: "slash status".to_string(),
+            lines: Vec::new(),
+            loading: None,
+            completion: None,
+            token_usage: None,
+            depends_on: Vec::new(),
+            depended_on_by: Vec::new(),
+        });
+
+        controller
+            .send_message(&agent_id, "/status")
+            .expect("slash command message is accepted");
+        assert!(controller.wait_for_idle(Duration::from_secs(2)));
+
+        assert_eq!(backend.sends(), Vec::<(AgentId, String)>::new());
+        assert_eq!(
+            backend.commands(),
+            vec![(agent_id.clone(), "/status".to_string())]
+        );
+        let snapshot = controller.snapshot();
+        let session = snapshot
+            .session(&agent_id)
+            .expect("selected agent session exists");
+        assert!(session.lines.iter().any(|line| line == "user: /status"));
+        assert!(session.lines.iter().any(|line| line == "status output"));
+    }
