 src/agent_runtime.rs  |  33 ++++++++++++-
 src/cli.rs            |  48 ++++++++++++++++++-
 src/codex.rs          |  44 ++++++++++++++++++
 src/workspace.rs      | 105 +++++++++++++++++++++++++++++++++++++++++-
 tests/terminal_app.rs |  42 ++++++++++++++---
 tests/workspace.rs    |  54 +++++++++++++++++-----
 7 files changed, 314 insertions(+), 26 deletions(-)

