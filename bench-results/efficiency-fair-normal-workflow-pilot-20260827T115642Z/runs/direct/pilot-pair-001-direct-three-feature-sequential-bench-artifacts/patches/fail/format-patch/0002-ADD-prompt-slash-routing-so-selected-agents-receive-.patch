+
+    controller.create_agent("status command").unwrap();
+    assert!(controller.wait_for_idle(Duration::from_secs(1)));
+
+    controller.execute_command_line("/ status");
+    assert!(controller.wait_for_idle(Duration::from_secs(1)));
+
+    assert!(
+        controller
+            .transcript()
+            .iter()
+            .any(|line| line == "work-leaf> / status")
+    );
+    assert!(
+        controller
+            .transcript()
+            .iter()
+            .any(|line| line.contains("unknown command chat command `/`"))
+    );
+    assert!(recorder.sends().is_empty());
+}
