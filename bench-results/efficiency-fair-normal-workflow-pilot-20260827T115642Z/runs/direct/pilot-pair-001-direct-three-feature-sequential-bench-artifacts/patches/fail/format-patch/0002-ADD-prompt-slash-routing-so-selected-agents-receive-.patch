+fn is_agent_slash_command(line: &str) -> bool {
+    let mut chars = line.chars();
+    chars.next() == Some('/') && chars.next().is_some_and(|ch| !ch.is_whitespace())
+}
+
+fn unknown_command_chat_command_text(line: &str) -> String {
+    let command = line.split_whitespace().next().unwrap_or(line);
+    command_chat_error_text(&CliError::Usage(format!(
+        "unknown command chat command `{command}`"
+    )))
+}
