+
+    fn start_visual_selection(&mut self, kind: VisualKind) {
+        self.mode = UiMode::Command;
+        self.pending = None;
+        let anchor = self.focused_visual_position(kind);
+        self.visual_selection = Some(VisualSelection {
+            pane: self.focus,
+            kind,
+            anchor,
+            cursor: anchor,
+        });
+    }
+
+    fn handle_visual_key(&mut self, key: UiKey) -> Vec<UiAction> {
+        match key {
+            UiKey::Esc => {
+                self.clear_visual_selection();
+            }
+            UiKey::Char('y') => {
+                self.yank_visual_selection(false);
+            }
+            UiKey::Char('Y') => {
+                self.yank_visual_selection(true);
+            }
+            UiKey::Char('v') => {
+                self.toggle_visual_kind(VisualKind::Character);
+            }
+            UiKey::Char('V') => {
+                self.toggle_visual_kind(VisualKind::Line);
+            }
+            UiKey::Char(CTRL_V_CHAR) => {
+                self.toggle_visual_kind(VisualKind::Block);
+            }
+            UiKey::Char('h') | UiKey::Left => {
+                self.move_visual_cursor(0, -1);
+            }
+            UiKey::Char('j') | UiKey::Down => {
+                self.move_visual_cursor(1, 0);
+            }
+            UiKey::Char('k') | UiKey::Up => {
+                self.move_visual_cursor(-1, 0);
+            }
+            UiKey::Char('l') | UiKey::Right => {
+                self.move_visual_cursor(0, 1);
+            }
+            _ => {}
+        }
+        Vec::new()
+    }
+
+    fn toggle_visual_kind(&mut self, kind: VisualKind) {
+        let Some(selection) = self.visual_selection.as_ref() else {
+            self.start_visual_selection(kind);
+            return;
+        };
+        if selection.kind == kind {
+            self.clear_visual_selection();
