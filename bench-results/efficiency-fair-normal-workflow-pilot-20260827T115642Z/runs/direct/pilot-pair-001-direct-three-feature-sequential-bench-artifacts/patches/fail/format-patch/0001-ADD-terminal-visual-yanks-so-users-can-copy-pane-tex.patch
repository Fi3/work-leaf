+            right_cursor,
+        };
+    }
+
+    fn refresh_left_visual_context(&self) {
+        let left_inner_width = usize::from(self.layout().left_width.saturating_sub(2).max(1));
+        self.visual_context.borrow_mut().left_lines = self
+            .left_display_lines(left_inner_width)
+            .into_iter()
+            .map(|line| line.text)
+            .collect();
