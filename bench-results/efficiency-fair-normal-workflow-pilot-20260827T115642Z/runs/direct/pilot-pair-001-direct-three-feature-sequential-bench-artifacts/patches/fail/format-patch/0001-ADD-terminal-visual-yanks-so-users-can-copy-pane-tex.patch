 src/ui_harness.rs     |  21 +-
 tests/terminal_app.rs |  35 ++
 tests/terminal_ui.rs  |  14 +
 tests/ui_harness.rs   |  53 +++
 7 files changed, 904 insertions(+), 56 deletions(-)

