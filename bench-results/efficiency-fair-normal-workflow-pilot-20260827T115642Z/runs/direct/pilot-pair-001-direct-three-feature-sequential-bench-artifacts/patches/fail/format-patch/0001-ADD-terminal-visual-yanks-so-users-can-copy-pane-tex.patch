+fn styled_line_spans(
+    line: &str,
+    selection_range: Option<(usize, usize)>,
+    base_style: Style,
+) -> Vec<Span<'static>> {
+    let Some((start, end)) = selection_range else {
+        return vec![Span::styled(line.to_string(), base_style)];
+    };
+
+    let line_len = line.chars().count();
+    let start = start.min(line_len);
+    let end = end.min(line_len);
+    if start >= end {
+        return vec![Span::styled(line.to_string(), base_style)];
+    }
+
+    let selected_style = base_style.add_modifier(Modifier::REVERSED);
+    let mut spans = Vec::new();
+    if start > 0 {
+        spans.push(Span::styled(slice_chars(line, 0, start), base_style));
+    }
+    spans.push(Span::styled(slice_chars(line, start, end), selected_style));
+    if end < line_len {
+        spans.push(Span::styled(slice_chars(line, end, line_len), base_style));
+    }
+    spans
+}
+
+fn visual_range_for_row(
+    selection: &VisualSelection,
+    row: usize,
+    line_len: usize,
+) -> Option<(usize, usize)> {
+    match selection.kind {
+        VisualKind::Line => {
+            let start_row = selection.anchor.row.min(selection.cursor.row);
+            let end_row = selection.anchor.row.max(selection.cursor.row);
+            (start_row..=end_row)
+                .contains(&row)
+                .then_some((0, line_len))
+        }
+        VisualKind::Character => visual_character_range(selection, row, line_len),
+        VisualKind::Block => visual_block_range(selection, row, line_len),
+    }
+}
+
+fn visual_character_range(
+    selection: &VisualSelection,
+    row: usize,
+    line_len: usize,
+) -> Option<(usize, usize)> {
+    let (start, end) = ordered_positions(selection.anchor, selection.cursor);
+    if row < start.row || row > end.row {
+        return None;
+    }
+    if line_len == 0 {
+        return Some((0, 0));
+    }
+
+    let last = line_len.saturating_sub(1);
+    let start_column = if row == start.row {
+        start.column.min(last)
+    } else {
+        0
+    };
+    let end_column = if row == end.row {
+        end.column.min(last)
+    } else {
+        last
+    };
+    Some((
+        start_column.min(line_len),
+        end_column.saturating_add(1).min(line_len),
+    ))
+}
+
+fn visual_block_range(
+    selection: &VisualSelection,
+    row: usize,
+    line_len: usize,
+) -> Option<(usize, usize)> {
+    let start_row = selection.anchor.row.min(selection.cursor.row);
+    let end_row = selection.anchor.row.max(selection.cursor.row);
+    if !(start_row..=end_row).contains(&row) {
+        return None;
+    }
+    let start_column = selection.anchor.column.min(selection.cursor.column);
+    let end_column = selection
+        .anchor
+        .column
+        .max(selection.cursor.column)
+        .saturating_add(1);
+    Some((start_column.min(line_len), end_column.min(line_len)))
+}
+
+fn ordered_positions(
+    first: VisualPosition,
+    second: VisualPosition,
+) -> (VisualPosition, VisualPosition) {
+    if first.row < second.row || (first.row == second.row && first.column <= second.column) {
+        (first, second)
+    } else {
+        (second, first)
+    }
+}
+
+fn clamp_visual_position(
+    position: VisualPosition,
+    lines: &[String],
+    kind: VisualKind,
+    width: usize,
+) -> VisualPosition {
+    let row = position.row.min(lines.len().saturating_sub(1));
+    let line_len = lines
+        .get(row)
+        .map(|line| line.chars().count())
+        .unwrap_or_default();
+    let max_column = match kind {
+        VisualKind::Line => 0,
+        VisualKind::Character => line_len.saturating_sub(1),
+        VisualKind::Block => width.saturating_sub(1),
+    };
+    VisualPosition {
+        row,
+        column: position.column.min(max_column),
+    }
+}
+
+fn apply_delta(value: usize, delta: isize) -> usize {
+    if delta.is_negative() {
+        value.saturating_sub(delta.unsigned_abs())
+    } else {
+        value.saturating_add(delta as usize)
+    }
+}
+
+fn right_visual_cursor_position(
+    right_lines: &[String],
+    right_cursor_column: Option<usize>,
+) -> VisualPosition {
+    let row = right_lines.len().saturating_sub(1);
+    let line_len = right_lines
+        .get(row)
+        .map(|line| line.chars().count())
+        .unwrap_or_default();
+    let column = right_cursor_column.unwrap_or(line_len);
+    VisualPosition {
+        row,
+        column: column.min(line_len.saturating_sub(1)),
+    }
+}
+
+fn slice_chars(line: &str, start: usize, end: usize) -> String {
+    line.chars()
+        .skip(start)
+        .take(end.saturating_sub(start))
+        .collect()
+}
