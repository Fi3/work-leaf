+#[test]
+fn terminal_app_review_completion_yes_closes_and_typing_reopens_patch_chat() {
+    let root = git_repo("terminal-app-review-feature-done");
+    fs::write(root.join("README.md"), "before\n").unwrap();
+    Command::new("git")
+        .current_dir(&root)
+        .args(["add", "README.md"])
+        .status()
+        .unwrap();
+    Command::new("git")
+        .current_dir(&root)
+        .args(["commit", "-m", "ADD initial readme fixture"])
+        .status()
+        .unwrap();
+
+    let backend = FakeBackend::new([
+        "implemented patch\n@work-leaf patch update readme\n--- a/README.md\n+++ b/README.md\n@@ -1 +1 @@\n-before\n+after\n@work-leaf end\n@work-leaf done",
+        "summary: README changes from before to after",
+        "NO_FINDINGS",
+        "follow-up reply",
+    ]);
+    let recorder = backend.clone();
+    let chat = CommandChat::new(root, backend).with_max_review_rounds(4);
+    let mut app = TerminalApp::new(chat, 100, 24);
+
+    app.handle_bytes(b":new update readme\n");
+    assert!(app.wait_for_idle(Duration::from_secs(2)));
+
+    let agent_id = AgentId::new("user-1").unwrap();
+    assert_eq!(app.ui().selected_agent(), Some(&agent_id));
+    assert!(
+        app.render_frame()
+            .contains("work-leaf: Is this feature done? yes/no")
+    );
+    assert!(app.ui().render_left_pane().contains("READY"));
+
+    app.handle_bytes(b"yes\n");
+
+    assert!(!app.ui().render_left_pane().contains(" user-1  working:"));
+    assert!(!recorder.sends().iter().any(|(_, prompt)| prompt == "yes"));
+
+    app.handle_bytes(b"needs");
+
+    assert!(app.ui().render_left_pane().contains(" user-1  working:"));
+    app.handle_bytes(b" another polish pass\n");
+
+    assert!(app.wait_for_frame_contains("follow-up reply", Duration::from_secs(1)));
+    assert!(
+        recorder.sends().iter().any(|(target, prompt)| {
+            target == &agent_id && prompt == "needs another polish pass"
+        })
+    );
+}
