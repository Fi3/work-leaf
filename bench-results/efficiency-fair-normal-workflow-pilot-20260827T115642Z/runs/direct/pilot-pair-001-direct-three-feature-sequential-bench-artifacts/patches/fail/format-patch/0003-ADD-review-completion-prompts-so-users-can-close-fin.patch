+    fn remember_feature_done_prompt(&mut self, session: &WorkLeafSession) {
+        if session.lines.iter().any(|line| line == FEATURE_DONE_PROMPT) {
+            self.feature_done_prompts.insert(session.id.clone());
+        }
+    }
+
+    fn apply_feature_done_prompt_line(&mut self, agent_id: &AgentId, line: &str) {
+        if line != FEATURE_DONE_PROMPT {
+            return;
+        }
+        self.feature_done_prompts.insert(agent_id.clone());
+        if self
+            .last_closed_feature_done_chat
+            .as_ref()
+            .is_some_and(|closed| closed == agent_id)
+        {
+            self.last_closed_feature_done_chat = None;
+        }
+        let _ = self.ui.activate_agent_chat(agent_id);
+        let _ = self.ui.set_agent_ready_state(agent_id, true);
+    }
+
+    fn handle_feature_done_reply(&mut self, agent_id: &AgentId, message: &str) -> bool {
+        if !self.feature_done_prompts.contains(agent_id) {
+            return false;
+        }
+        self.feature_done_prompts.remove(agent_id);
+        if is_yes_reply(message) {
+            let _ = self.ui.hide_agent(agent_id);
+            self.last_closed_feature_done_chat = Some(agent_id.clone());
+            return true;
+        }
+        false
+    }
+
+    fn reopen_feature_done_chat_for_typing(&mut self) {
+        if self.ui.selected_agent().is_some() || !self.chat_buffer.as_str().is_empty() {
+            return;
+        }
+        let Some(agent_id) = self.last_closed_feature_done_chat.take() else {
+            return;
+        };
+        let _ = self.ui.activate_agent_chat(&agent_id);
+    }
+
+    fn reopen_feature_done_chat_for_message(&mut self) -> Option<AgentId> {
+        let agent_id = self.last_closed_feature_done_chat.take()?;
+        let _ = self.ui.activate_agent_chat(&agent_id);
+        Some(agent_id)
+    }
