+#[test]
+fn terminal_app_rearms_feature_done_prompt_for_repeated_patch_agent_reviews() {
+    let root = git_repo("terminal-app-review-feature-done-twice");
+    fs::write(root.join("README.md"), "before\n").unwrap();
+    Command::new("git")
+        .current_dir(&root)
+        .args(["add", "README.md"])
+        .status()
+        .unwrap();
+    Command::new("git")
+        .current_dir(&root)
+        .args(["commit", "-m", "ADD initial readme fixture"])
+        .status()
+        .unwrap();
+
+    let backend = FakeBackend::new([
+        "first patch\n@work-leaf patch update readme once\n--- a/README.md\n+++ b/README.md\n@@ -1 +1 @@\n-before\n+after first\n@work-leaf end\n@work-leaf done",
+        "summary: first reviewed change",
+        "NO_FINDINGS",
+        "second patch\n@work-leaf patch update readme twice\n--- a/README.md\n+++ b/README.md\n@@ -1 +1 @@\n-after first\n+after second\n@work-leaf end\n@work-leaf done",
+        "summary: second reviewed change",
+        "NO_FINDINGS",
+        "unexpected yes reply",
+    ]);
+    let recorder = backend.clone();
+    let chat = CommandChat::new(root, backend).with_max_review_rounds(4);
+    let mut app = TerminalApp::new(chat, 100, 24);
+    let agent_id = AgentId::new("user-1").unwrap();
+
+    app.handle_bytes(b":new update readme\n");
+    assert!(app.wait_for_idle(Duration::from_secs(2)));
+    app.handle_bytes(b"yes\n");
+    assert!(!app.ui().render_left_pane().contains(" user-1  working:"));
+
+    app.handle_bytes(b"make");
+    assert!(app.ui().render_left_pane().contains(" user-1  working:"));
+    app.handle_bytes(b" a second reviewed update\n");
+    assert!(app.wait_for_idle(Duration::from_secs(2)));
+    assert_eq!(app.ui().selected_agent(), Some(&agent_id));
+    let frame = app.render_frame();
+    assert_eq!(
+        frame
+            .matches("work-leaf: Is this feature done? yes/no")
+            .count(),
+        2,
+        "{frame}"
+    );
+
+    let sends_before_yes = recorder.sends().len();
+    app.handle_bytes(b"yes\n");
+
+    assert!(!app.ui().render_left_pane().contains(" user-1  working:"));
+    assert_eq!(recorder.sends().len(), sends_before_yes);
+    assert!(!recorder.sends().iter().any(|(_, prompt)| prompt == "yes"));
+}
