.any(|line| line == \"work-leaf> / status\")\n+    );\n+    assert!(\n+        controller\n+            .transcript()\n+            .iter()\n+            .any(|line| line.contains(\"unknown command chat command `/`\"))\n+    );\n+    assert!(recorder.sends().is_empty());\n+}\n+\n #[test]\n fn controller_line_events_do_not_resend_full_session_transcripts() {\n     let backend = FakeBackend::new([\"launch reply\"]);\n","exit_code":0,"status":"completed"}}
