tespace())\n }\n \n+fn unknown_command_chat_command_text(line: &str) -> String {\n+    let command = line.split_whitespace().next().unwrap_or(line);\n+    command_chat_error_text(&CliError::Usage(format!(\n+        \"unknown command chat command `{command}`\"\n+    )))\n+}\n+\n fn parse_sgr_mouse_event(sequence: &[u8]) -> Option<UiKey> {\n     let final_byte = *sequence.last()?;\n     if !sequence.starts_with(b\"[<\") || !matches!(final_byte, b'M' | b'm') {\ndiff --git a/tests/terminal_app.rs b/tests/terminal_app.rs\nindex abb5911..1211d60 100644\n--- a/tests/terminal_app.rs\n+++ b/tests/terminal_app.rs\n@@ -114,6 +114,36 @@ fn terminal_app_prompt_slash_space_stays_work_leaf_command() {\n     assert!(backend.sends().is_empty());\n }\n \n+#[test]\n+fn terminal_app_prompt_slash_with_command_row_selected_does_not_use_stale_agent() {\n+    let backend = FakeBackend::new([\"launch reply\"]);\n+    let chat = CommandChat::new(PathBuf::from(\"/repo\"), backend);\n+    let mut app = TerminalApp::new(chat, 100, 24);\n+\n+    app.handle_bytes(b\":new status command\\n\");\n+    app.wait_for_idle(Duration::from_secs(1));\n+    app.handle_bytes(&[27, 23, b'h', b'k']);\n+\n+    assert!(app.ui().selected_agent().is_none());\n+\n+    app.handle_bytes(b\":/status\\n\");\n+    app.wait_for_idle(Duration::from_secs(1));\n+\n+    assert!(\n+        app.transcript()\n+            .iter()\n+            .any(|line| line == \"work-leaf> /status\")\n+    );\n+    assert!(\n+        app.transcript()\n+            .iter()\n+            .any(|line| line.contains(\"unknown command chat command `/status`\"))\n+    );\n+\n+    let backend = app.into_chat().into_backend();\n+    assert!(backend.sends().is_empty());\n+}\n+\n #[test]\n fn terminal_app_sends_spawned_codex_slash_command_as_raw_command() {\n     let root = temp_dir(\"terminal-app-codex-slash-command\");\ndiff --git a/tests/ui_harness.rs b/tests/ui_harness.rs\nindex 03f85e9..3f804b4 100644\n--- a/tests/ui_harness.rs\n+++ b/tests/ui_harness.rs\n@@ -403,6 +403,35 @@ fn scripted_harness_prompt_slash_space_stays_work_leaf_command() {\n     );\n }\n \n+#[test]\n+fn scripted_harness_prompt_slash_with_command_row_selected_stays_work_leaf_command() {\n+    let mut harness = UiHarness::new(80, 24);\n+\n+    harness.handle_byte(b'k');\n+    assert!(harness.ui().selected_agent().is_none());\n+\n+    harness.handle_bytes(b\":/status\\n\");\n+\n+    assert!(\n+        harness\n+            .transcript()\n+            .iter()\n+            .any(|line| line == \"work-leaf> /status\")\n+    );\n+    assert!(\n+        harness\n+            .transcript()\n+            .iter()\n+            .any(|line| line == \"unknown fixture command: /status\")\n+    );\n+    assert!(\n+        !harness\n+            .transcript()\n+            .iter()\n+            .any(|line| line == \"user-1> /status\")\n+    );\n+}\n+\n #[test]\n fn scripted_harness_mouse_wheel_scrolls_chat_history() {\n     let mut harness = UiHarness::new(80, 10);\n","exit_code":0,"status":"completed"}}
