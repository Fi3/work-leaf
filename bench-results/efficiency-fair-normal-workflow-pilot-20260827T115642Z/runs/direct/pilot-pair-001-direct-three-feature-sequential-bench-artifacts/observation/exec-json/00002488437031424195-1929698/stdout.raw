{"type":"item.completed","item":{"id":"item_63","type":"command_execution","command":"/usr/bin/bash -lc 'git diff --color=never 21fc946..5c8ae41 -- src tests'","aggregated_output":"diff --git a/src/workspace.rs b/src/workspace.rs\nindex f95a14c..b5d405c 100644\n--- a/src/workspace.rs\n+++ b/src/workspace.rs\n@@ -698,7 +698,7 @@ where\n                 for review in results {\n                     self.record_review_result(review);\n                     self.append_agent_line(&review.commit.agent_id, format!(\"review: {text}\"));\n-                    self.append_agent_line(\n+                    self.append_agent_line_allow_duplicate(\n                         &review.commit.agent_id,\n                         FEATURE_DONE_PROMPT.to_string(),\n                     );\n@@ -727,6 +727,19 @@ where\n     }\n \n     fn append_agent_line(&mut self, agent_id: &AgentId, line: String) {\n+        self.append_agent_line_with_duplicate_policy(agent_id, line, false);\n+    }\n+\n+    fn append_agent_line_allow_duplicate(&mut self, agent_id: &AgentId, line: String) {\n+        self.append_agent_line_with_duplicate_policy(agent_id, line, true);\n+    }\n+\n+    fn append_agent_line_with_duplicate_policy(\n+        &mut self,\n+        agent_id: &AgentId,\n+        line: String,\n+        allow_duplicate: bool,\n+    ) {\n         if line.is_empty() {\n             return;\n         }\n@@ -741,7 +754,7 @@ where\n             .sessions\n             .get_mut(agent_id)\n             .expect(\"session was inserted before appending a line\");\n-        if session.lines.iter().any(|existing| existing == &line) {\n+        if !allow_duplicate && session.lines.iter().any(|existing| existing == &line) {\n             return;\n         }\n         session.lines.push(line.clone());\ndiff --git a/tests/terminal_app.rs b/tests/terminal_app.rs\nindex 9ff9943..9491627 100644\n--- a/tests/terminal_app.rs\n+++ b/tests/terminal_app.rs\n@@ -1114,6 +1114,54 @@ fn terminal_app_review_completion_yes_closes_and_typing_reopens_patch_chat() {\n     );\n }\n \n+#[test]\n+fn terminal_app_rearms_feature_done_prompt_for_repeated_patch_agent_reviews() {\n+    let root = git_repo(\"terminal-app-review-feature-done-twice\");\n+    fs::write(root.join(\"README.md\"), \"before\\n\").unwrap();\n+    Command::new(\"git\")\n+        .current_dir(&root)\n+        .args([\"add\", \"README.md\"])\n+        .status()\n+        .unwrap();\n+    Command::new(\"git\")\n+        .current_dir(&root)\n+        .args([\"commit\", \"-m\", \"ADD initial readme fixture\"])\n+        .status()\n+        .unwrap();\n+\n+    let backend = FakeBackend::new([\n+        \"first patch\\n@work-leaf patch update readme once\\n--- a/README.md\\n+++ b/README.md\\n@@ -1 +1 @@\\n-before\\n+after first\\n@work-leaf end\\n@work-leaf done\",\n+        \"summary: first reviewed change\",\n+        \"NO_FINDINGS\",\n+        \"second patch\\n@work-leaf patch update readme twice\\n--- a/README.md\\n+++ b/README.md\\n@@ -1 +1 @@\\n-after first\\n+after second\\n@work-leaf end\\n@work-leaf done\",\n+        \"summary: second reviewed change\",\n+        \"NO_FINDINGS\",\n+        \"unexpected yes reply\",\n+    ]);\n+    let recorder = backend.clone();\n+    let chat = CommandChat::new(root, backend).with_max_review_rounds(4);\n+    let mut app = TerminalApp::new(chat, 100, 24);\n+    let agent_id = AgentId::new(\"user-1\").unwrap();\n+\n+    app.handle_bytes(b\":new update readme\\n\");\n+    assert!(app.wait_for_idle(Duration::from_secs(2)));\n+    app.handle_bytes(b\"yes\\n\");\n+    assert!(!app.ui().render_left_pane().contains(\" user-1  working:\"));\n+\n+    app.handle_bytes(b\"make\");\n+    assert!(app.ui().render_left_pane().contains(\" user-1  working:\"));\n+    app.handle_bytes(b\" a second reviewed update\\n\");\n+    assert!(app.wait_for_idle(Duration::from_secs(2)));\n+    assert_eq!(app.ui().selected_agent(), Some(&agent_id));\n+\n+    let sends_before_yes = recorder.sends().len();\n+    app.handle_bytes(b\"yes\\n\");\n+\n+    assert!(!app.ui().render_left_pane().contains(\" user-1  working:\"));\n+    assert_eq!(recorder.sends().len(), sends_before_yes);\n+    assert!(!recorder.sends().iter().any(|(_, prompt)| prompt == \"yes\"));\n+}\n+\n #[test]\n fn terminal_app_names_user_session_from_first_prompt_immediately() {\n     let backend = FakeBackend::new([\"launch reply\"]);\ndiff --git a/tests/workspace.rs b/tests/workspace.rs\nindex 59dd699..c3c078c 100644\n--- a/tests/workspace.rs\n+++ b/tests/workspace.rs\n@@ -653,6 +653,15 @@ fn controller_linearize_keeps_multiple_reviewed_commits_from_same_agent() {\n         .send_message(&agent_id, \"make a second reviewed update\")\n         .unwrap();\n     assert!(controller.wait_for_idle(Duration::from_secs(2)));\n+    let prompt_count = controller\n+        .snapshot()\n+        .session(&agent_id)\n+        .expect(\"patch agent exists\")\n+        .lines\n+        .iter()\n+        .filter(|line| line.as_str() == \"work-leaf: Is this feature done? yes/no\")\n+        .count();\n+    assert_eq!(prompt_count, 2);\n     assert!(controller.start_linearize().unwrap().is_some());\n     assert!(controller.wait_for_idle(Duration::from_secs(2)));\n \n","exit_code":0,"status":"completed"}}
