agent.depended_on_by,\n+            ] {\n+                if !linked_agents.is_empty() {\n+                    display_row += 1;\n+                }\n+            }\n+        }\n+\n+        display_row.saturating_sub(1)\n+    }\n+\n     fn right_cursor_position_with_cursor(\n         &self,\n         right_content: &str,\n@@ -1095,6 +1590,16 @@ impl TerminalUi {\n             return notice.to_string();\n         }\n \n+        if let Some(selection) = &self.visual_selection {\n+            return format!(\n+                \"mode={} focus={} window={}/{}\",\n+                selection.kind.as_status(),\n+                selection.pane.as_str(),\n+                self.active_window + 1,\n+                self.windows.len()\n+            );\n+        }\n+\n         format!(\n             \"mode={} focus={} window={}/{}\",\n             self.mode.as_str(),\n@@ -1115,6 +1620,16 @@ impl UiMode {\n     }\n }\n \n+impl VisualKind {\n+    fn as_status(&self) -> &'static str {\n+        match self {\n+            Self::Character => \"visual\",\n+            Self::Line => \"visual-line\",\n+            Self::Block => \"visual-block\",\n+        }\n+    }\n+}\n+\n impl PaneFocus {\n     fn as_str(&self) -> &'static str {\n         match self {\n@@ -1188,6 +1703,200 @@ fn truncate_to_width(text: &str, width: usize) -> String {\n     text.chars().take(width).collect()\n }\n \n+fn split_preserving_empty_lines(text: &str) -> Vec<&str> {\n+    if text.is_empty() {\n+        Vec::new()\n+    } else {\n+        text.split('\\n').collect()\n+    }\n+}\n+\n+fn styled_line_spans(\n+    line: &str,\n+    selection_range: Option<(usize, usize)>,\n+    base_style: Style,\n+) -> Vec<Span<'static>> {\n+    let Some((start, end)) = selection_range else {\n+        return vec![Span::styled(line.to_string(), base_style)];\n+    };\n+\n+    let line_len = line.chars().count();\n+    let start = start.min(line_len);\n+    let end = end.min(line_len);\n+    if start >= end {\n+        return vec![Span::styled(line.to_string(), base_style)];\n+    }\n+\n+    let selected_style = base_style.add_modifier(Modifier::REVERSED);\n+    let mut spans = Vec::new();\n+    if start > 0 {\n+        spans.push(Span::styled(slice_chars(line, 0, start), base_style));\n+    }\n+    spans.push(Span::styled(slice_chars(line, start, end), selected_style));\n+    if end < line_len {\n+        spans.push(Span::styled(slice_chars(line, end, line_len), base_style));\n+    }\n+    spans\n+}\n+\n+fn visual_range_for_row(\n+    selection: &VisualSelection,\n+    row: usize,\n+    line_len: usize,\n+) -> Option<(usize, usize)> {\n+    match selection.kind {\n+        VisualKind::Line => {\n+            let start_row = selection.anchor.row.min(selection.cursor.row);\n+            let end_row = selection.anchor.row.max(selection.cursor.row);\n+            (start_row..=end_row)\n+                .contains(&row)\n+                .then_some((0, line_len))\n+        }\n+        VisualKind::Character => visual_character_range(selection, row, line_len),\n+        VisualKind::Block => visual_block_range(selection, row, line_len),\n+    }\n+}\n+\n+fn visual_character_range(\n+    selection: &VisualSelection,\n+    row: usize,\n+    line_len: usize,\n+) -> Option<(usize, usize)> {\n+    let (start, end) = ordered_positions(selection.anchor, selection.cursor);\n+    if row < start.row || row > end.row {\n+        return None;\n+    }\n+    if line_len == 0 {\n+        return Some((0, 0));\n+    }\n+\n+    let last = line_len.saturating_sub(1);\n+    let start_column = if row == start.row {\n+        start.column.min(last)\n+    } else {\n+        0\n+    };\n+    let end_column = if row == end.row {\n+        end.column.min(last)\n+    } else {\n+        last\n+    };\n+    Some((\n+        start_column.min(line_len),\n+        end_column.saturating_add(1).min(line_len),\n+    ))\n+}\n+\n+fn visual_block_range(\n+    selection: &VisualSelection,\n+    row: usize,\n+    line_len: usize,\n+) -> Option<(usize, usize)> {\n+    let start_row = selection.anchor.row.min(selection.cursor.row);\n+    let end_row = selection.anchor.row.max(selection.cursor.row);\n+    if !(start_row..=end_row).contains(&row) {\n+        return None;\n+    }\n+    let start_column = selection.anchor.column.min(selection.cursor.column);\n+    let end_column = selection\n+        .anchor\n+        .column\n+        .max(selection.cursor.column)\n+        .saturating_add(1);\n+    Some((start_column.min(line_len), end_column.min(line_len)))\n+}\n+\n+fn ordered_positions(\n+    first: VisualPosition,\n+    second: VisualPosition,\n+) -> (VisualPosition, VisualPosition) {\n+    if first.row < second.row || (first.row == second.row && first.column <= second.column) {\n+        (first, second)\n+    } else {\n+        (second, first)\n+    }\n+}\n+\n+fn clamp_visual_position(\n+    position: VisualPosition,\n+    lines: &[String],\n+    kind: VisualKind,\n+    width: usize,\n+) -> VisualPosition {\n+    let row = position.row.min(lines.len().saturating_sub(1));\n+    let line_len = lines\n+        .get(row)\n+        .map(|line| line.chars().count())\n+        .unwrap_or_default();\n+    let max_column = match kind {\n+        VisualKind::Line => 0,\n+        VisualKind::Character => line_len.saturating_sub(1),\n+        VisualKind::Block => width.saturating_sub(1),\n+    };\n+    VisualPosition {\n+        row,\n+        column: position.column.min(max_column),\n+    }\n+}\n+\n+fn apply_delta(value: usize, delta: isize) -> usize {\n+    if delta.is_negative() {\n+        value.saturating_sub(delta.unsigned_abs())\n+    } else {\n+        value.saturating_add(delta as usize)\n+    }\n+}\n+\n+fn right_visual_cursor_position(\n+    right_lines: &[String],\n+    right_cursor_column: Option<usize>,\n+) -> VisualPosition {\n+    let row = right_lines.len().saturating_sub(1);\n+    let line_len = right_lines\n+        .get(row)\n+        .map(|line| line.chars().count())\n+        .unwrap_or_default();\n+    let column = right_cursor_column.unwrap_or(line_len);\n+    VisualPosition {\n+        row,\n+        column: column.min(line_len.saturating_sub(1)),\n+    }\n+}\n+\n+fn slice_chars(line: &str, start: usize, end: usize) -> String {\n+    line.chars()\n+        .skip(start)\n+        .take(end.saturating_sub(start))\n+        .collect()\n+}\n+\n+fn osc52_clipboard_sequence(text: &str) -> String {\n+    format!(\"\\u{1b}]52;c;{}\\u{7}\", base64_encode(text.as_bytes()))\n+}\n+\n+fn base64_encode(bytes: &[u8]) -> String {\n+    let mut encoded = String::new();\n+    for chunk in bytes.chunks(OSC52_CHUNK) {\n+        let first = chunk[0];\n+        let second = chunk.get(1).copied().unwrap_or(0);\n+        let third = chunk.get(2).copied().unwrap_or(0);\n+\n+        encoded.push(BASE64[(first >> 2) as usize] as char);\n+        encoded.push(BASE64[(((first & 0b0000_0011) << 4) | (second >> 4)) as usize] as char);\n+        if chunk.len() > 1 {\n+            encoded.push(BASE64[(((second & 0b0000_1111) << 2) | (third >> 6)) as usize] as char);\n+        } else {\n+            encoded.push('=');\n+        }\n+        if chunk.len() > 2 {\n+            encoded.push(BASE64[(third & 0b0011_1111) as usize] as char);\n+        } else {\n+            encoded.push('=');\n+        }\n+    }\n+    encoded\n+}\n+\n fn buffer_to_string(buffer: &Buffer) -> String {\n     const ANSI_REVERSE_VIDEO: &str = \"\\u{1b}[7m\";\n     const ANSI_RESET: &str = \"\\u{1b}[0m\";\n","exit_code":0,"status":"completed"}}
