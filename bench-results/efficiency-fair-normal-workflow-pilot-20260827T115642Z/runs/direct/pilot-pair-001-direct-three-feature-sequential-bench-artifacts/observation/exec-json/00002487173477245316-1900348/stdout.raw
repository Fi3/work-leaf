_id.clone());\n   835\t        if self\n   836\t            .last_closed_feature_done_chat\n   837\t            .as_ref()\n   838\t            .is_some_and(|closed| closed == agent_id)\n   839\t        {\n   840\t            self.last_closed_feature_done_chat = None;\n   841\t        }\n   842\t        let _ = self.ui.activate_agent_chat(agent_id);\n   843\t        let _ = self.ui.set_agent_ready_state(agent_id, true);\n   844\t    }\n   845\t\n   846\t    fn handle_feature_done_reply(&mut self, agent_id: &AgentId, message: &str) -> bool {\n   847\t        if !self.feature_done_prompts.contains(agent_id) {\n   848\t            return false;\n   849\t        }\n   850\t        self.feature_done_prompts.remove(agent_id);\n   851\t        if is_yes_reply(message) {\n   852\t            let _ = self.ui.hide_agent(agent_id);\n   853\t            self.last_closed_feature_done_chat = Some(agent_id.clone());\n   854\t            return true;\n   855\t        }\n   856\t        false\n   857\t    }\n   858\t\n   859\t    fn reopen_feature_done_chat_for_typing(&mut self) {\n   860\t        if self.ui.selected_agent().is_some() || !self.chat_buffer.as_str().is_empty() {\n   861\t            return;\n   862\t        }\n   863\t        let Some(agent_id) = self.last_closed_feature_done_chat.take() else {\n   864\t            return;\n   865\t        };\n   866\t        let _ = self.ui.activate_agent_chat(&agent_id);\n   867\t    }\n   868\t\n   869\t    fn reopen_feature_done_chat_for_message(&mut self) -> Option<AgentId> {\n   870\t        let agent_id = self.last_closed_feature_done_chat.take()?;\n  1110\t            Some(TerminalAppInput::LineBreak)\n  1111\t        }\n  1112\t        _ => parse_sgr_mouse_event(sequence).map(TerminalAppInput::Key),\n  1113\t    }\n  1114\t}\n  1115\t\n  1116\tfn is_agent_slash_command(line: &str) -> bool {\n  1117\t    let mut chars = line.chars();\n  1118\t    chars.next() == Some('/') && chars.next().is_some_and(|ch| !ch.is_whitespace())\n  1119\t}\n  1120\t\n  1121\tfn is_yes_reply(message: &str) -> bool {\n  1122\t    let message = message.trim();\n  1123\t    message.eq_ignore_ascii_case(\"yes\") || message.eq_ignore_ascii_case(\"y\")\n  1124\t}\n  1125\t\n  1126\tfn unknown_command_chat_command_text(line: &str) -> String {\n  1127\t    let command = line.split_whitespace().next().unwrap_or(line);\n  1128\t    command_chat_error_text(&CliError::Usage(format!(\n  1129\t        \"unknown command chat command `{command}`\"\n  1130\t    )))\n","exit_code":0,"status":"completed"}}
