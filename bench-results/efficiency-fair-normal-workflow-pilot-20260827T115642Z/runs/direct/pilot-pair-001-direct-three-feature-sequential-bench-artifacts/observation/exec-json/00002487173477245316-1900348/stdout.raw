ecutable command. Do not run `@work-leaf` in a shell or ask the user to run it.\",\nsrc/agent.rs:244:            \"This command-lock rule is language- and tool-agnostic: use it for any formatter, build, test, code generator, package manager, installer, cache-producing tool, or repository-required check that may write files.\",\nsrc/agent.rs:247:            \"Do not use command locks for manual feature edits; manual code or documentation changes must still be submitted with the unified-diff patch directive.\",\nsrc/agent.rs:248:            \"Use `@work-leaf send <agent-id> <message>` to route context to another agent.\",\nsrc/agent.rs:249:            \"You are responsible for following the project instructions, including running the repository's required checks before you submit a patch or report work done.\",\nsrc/agent.rs:250:            \"Use `@work-leaf done` when no more orchestrator work is required.\",\nsrc/agent.rs:307:    UnknownSession(AgentId),\nsrc/agent.rs:326:            Self::UnknownSession(id) => write!(formatter, \"unknown agent session `{id}`\"),\nsrc/agent_runtime.rs:121:        let start = Instant::now();\nsrc/agent_runtime.rs:204:#[cfg(not(unix))]\nsrc/agent_runtime.rs:222:#[cfg(all(unix, not(target_os = \"linux\")))]\nsrc/agent_runtime.rs:230:#[cfg(not(unix))]\nsrc/agent_runtime.rs:267:#[cfg(all(not(unix), not(windows)))]\nsrc/chat_title.rs:32:- Return only the chat name, no prose and no quotes.\\n\\\nsrc/chat_title.rs:36:- Do not use spaces.\\n\\n\\\ntests/cli.rs:15:fn binary_help_describes_launching_orchestrator_not_internal_operations() {\ntests/cli.rs:23:    assert!(stdout.contains(\"Usage: work-leaf [--model <model>] [--no-read-permission]\"));\ntests/cli.rs:33:fn no_args_launches_orchestrator_from_current_project_directory() {\ntests/cli.rs:46:fn no_read_permission_allows_direct_filesystem_reads() {\ntests/cli.rs:47:    let command = parse_process_args([\"work-leaf\", \"--no-read-permission\"]).unwrap();\ntests/cli.rs:59:fn process_args_ac