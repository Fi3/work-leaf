+72,11 @@ impl UiHarness {\n         self.ui.set_agent_ready_state(&agent_id, true)\n     }\n \n+    pub fn activate_agent_chat(&mut self, agent_id: &str) -> Result<(), String> {\n+        let agent_id = AgentId::new(agent_id).map_err(|error| error.to_string())?;\n+        self.ui.activate_agent_chat(&agent_id)\n+    }\n+\n     pub fn is_quit(&self) -> bool {\n         self.quit\n     }\ndiff --git a/src/workspace.rs b/src/workspace.rs\nindex 011b04a..f95a14c 100644\n--- a/src/workspace.rs\n+++ b/src/workspace.rs\n@@ -15,6 +15,8 @@ use crate::cli::{\n };\n use crate::review::{AgentCommit, GitHistory, ReviewResult};\n \n+pub(crate) const FEATURE_DONE_PROMPT: &str = \"work-leaf: Is this feature done? yes/no\";\n+\n #[derive(Debug)]\n pub struct WorkLeafController<B>\n where\n@@ -696,6 +698,11 @@ where\n                 for review in results {\n                     self.record_review_result(review);\n                     self.append_agent_line(&review.commit.agent_id, format!(\"review: {text}\"));\n+                    self.append_agent_line(\n+                        &review.commit.agent_id,\n+                        FEATURE_DONE_PROMPT.to_string(),\n+                    );\n+                    self.select_agent(review.commit.agent_id.clone());\n                 }\n             }\n             other => {\ndiff --git a/tests/terminal_app.rs b/tests/terminal_app.rs\nindex 1211d60..60bdbbe 100644\n--- a/tests/terminal_app.rs\n+++ b/tests/terminal_app.rs\n@@ -1060,6 +1060,58 @@ fn terminal_app_review_adds_reviewer_chat_and_streams_output_immediately() {\n     ));\n }\n \n+#[test]\n+fn terminal_app_review_completion_yes_closes_and_typing_reopens_patch_chat() {\n+    let root = git_repo(\"terminal-app-review-feature-done\");\n+    fs::write(root.join(\"README.md\"), \"before\\n\").unwrap();\n+    Command::new(\"git\")\n+        .current_dir(&root)\n+        .args([\"add\", \"README.md\"])\n+        .status()\n+        .unwrap();\n+    Command::new(\"git\")\n+        .current_dir(&root)\n+        .args([\"commit\", \"-m\", \"ADD initial readme fixture\"])\n+        .status()\n+        .unwrap();\n+\n+    let backend = FakeBackend::new([\n+        \"implemented patch\\n@work-leaf patch update readme\\n--- a/README.md\\n+++ b/README.md\\n@@ -1 +1 @@\\n-before\\n+after\\n@work-leaf end\\n@work-leaf done\",\n+        \"summary: README changes from before to after\",\n+        \"NO_FINDINGS\",\n+        \"follow-up reply\",\n+    ]);\n+    let recorder = backend.clone();\n+    let chat = CommandChat::new(root, backend).with_max_review_rounds(4);\n+    let mut app = TerminalApp::new(chat, 100, 24);\n+\n+    app.handle_bytes(b\":new update readme\\n\");\n+    assert!(app.wait_for_idle(Duration::from_secs(2)));\n+\n+    let agent_id = AgentId::new(\"user-1\").unwrap();\n+    assert_eq!(app.ui().selected_agent(), Some(&agent_id));\n+    assert!(\n+        app.render_frame()\n+            .contains(\"work-leaf: Is this feature done? yes/no\")\n+    );\n+    assert!(app.ui().render_left_pane().contains(\"READY\"));\n+\n+    app.handle_bytes(b\"yes\\n\");\n+\n+    assert!(!app.ui().render_left_pane().contains(\" user-1  working:\"));\n+    assert!(!recorder.sends().iter().any(|(_, prompt)| prompt == \"yes\"));\n+\n+    app.handle_bytes(b\"needs another polish pass\\n\");\n+\n+    assert!(app.ui().render_left_pane().contains(\" user-1  working:\"));\n+    assert!(app.wait_for_frame_contains(\"follow-up reply\", Duration::from_secs(1)));\n+    assert!(\n+        recorder.sends().iter().any(|(target, prompt)| {\n+            target == &agent_id && prompt == \"needs another polish pass\"\n+        })\n+    );\n+}\n+\n #[test]\n fn terminal_app_names_user_session_from_first_prompt_immediately() {\n     let backend = FakeBackend::new([\"launch reply\"]);\ndiff --git a/tests/ui_harness.rs b/tests/ui_harness.rs\nindex 3f804b4..8a4a83a 100644\n--- a/tests/ui_harness.rs\n+++ b/tests/ui_harness.rs\n@@ -34,6 +34,35 @@ fn scripted_harness_rings_and_highlights_ready_chat() {\n     assert!(!harness.render_frame().starts_with('\\u{7}'));\n }\n \n+#[test]\n+fn scripted_harness_reopens_hidden_chat_when_activated_again() {\n+    let mut harness = UiHarness::new(100, 24);\n+\n+    harness.handle_byte(b'x');\n+\n+    assert!(\n+        !harness\n+            .ui()\n+            .render_left_pane()\n+            .contains(\" user-1  working:\")\n+    );\n+\n+    harness\n+        .activate_agent_chat(\"user-1\")\n+        .expect(\"fixture user-1 agent is registered\");\n+\n+    assert!(\n+        harness\n+            .ui()\n+            .render_left_pane()\n+            .contains(\" user-1  working:\")\n+    );\n+    assert_eq!(\n+        harness.ui().selected_agent().map(|id| id.as_str()),\n+        Some(\"user-1\")\n+    );\n+}\n+\n #[test]\n fn scripted_harness_switches_modes_without_enter() {\n     let mut harness = UiHarness::new(80, 24);\ndiff --git a/tests/workspace.rs b/tests/workspace.rs\nindex b32fba9..ba93dd9 100644\n--- a/tests/workspace.rs\n+++ b/tests/workspace.rs\n@@ -325,6 +325,45 @@ fn controller_starts_review_after_patch_agent_done_and_loops_until_clean() {\n     }));\n }\n \n+#[test]\n+fn controller_selects_and_prompts_patch_agent_after_review_completion() {\n+    let root = git_repo(\"workspace-review-prompts-feature-done\");\n+    fs::write(root.join(\"README.md\"), \"before\\n\").unwrap();\n+    git(&root, [\"add\", \"README.md\"]);\n+    git(&root, [\"commit\", \"-m\", \"ADD initial readme fixture\"]);\n+    let backend = FakeBackend::new([\n+        \"implemented patch\\n@work-leaf patch update readme\\n--- a/README.md\\n+++ b/README.md\\n@@ -1 +1 @@\\n-before\\n+after\\n@work-leaf end\\n@work-leaf done\",\n+        \"summary: README changes from before to after\",\n+        \"NO_FINDINGS\",\n+    ]);\n+    let chat = CommandChat::new(root, backend).with_max_review_rounds(4);\n+    let mut controller = WorkLeafController::new(chat);\n+\n+    let agent_id = controller.create_agent(\"update readme\").unwrap();\n+    controller.drain_events();\n+\n+    assert!(controller.wait_for_idle(Duration::from_secs(2)));\n+\n+    let snapshot = controller.snapshot();\n+    let patch_agent = snapshot.session(&agent_id).expect(\"patch agent exists\");\n+    assert!(\n+        patch_agent\n+            .lines\n+            .iter()\n+            .any(|line| { line == \"work-leaf: Is this feature done? yes/no\" })\n+    );\n+\n+    let selected_agents = controller\n+        .drain_events()\n+        .into_iter()\n+        .filter_map(|event| match event {\n+            WorkLeafEvent::AgentSelected { agent_id } => Some(agent_id),\n+            _ => None,\n+        })\n+        .collect::<Vec<_>>();\n+    assert_eq!(selected_agents.last(), Some(&agent_id));\n+}\n+\n #[test]\n fn controller_does_not_start_review_until_patch_agent_reports_done() {\n     let root = git_repo(\"workspace-review-waits-for-done\");\n","exit_code":0,"status":"completed"}}
