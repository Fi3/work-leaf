prompt_line(&mut self, agent_id: &AgentId, line: &str) {\n+        if line != FEATURE_DONE_PROMPT {\n+            return;\n+        }\n+        self.feature_done_prompts.insert(agent_id.clone());\n+        if self\n+            .last_closed_feature_done_chat\n+            .as_ref()\n+            .is_some_and(|closed| closed == agent_id)\n+        {\n+            self.last_closed_feature_done_chat = None;\n+        }\n+        let _ = self.ui.activate_agent_chat(agent_id);\n+        let _ = self.ui.set_agent_ready_state(agent_id, true);\n+    }\n+\n+    fn handle_feature_done_reply(&mut self, agent_id: &AgentId, message: &str) -> bool {\n+        if !self.feature_done_prompts.contains(agent_id) {\n+            return false;\n+        }\n+        self.feature_done_prompts.remove(agent_id);\n+        if is_yes_reply(message) {\n+            let _ = self.ui.hide_agent(agent_id);\n+            self.last_closed_feature_done_chat = Some(agent_id.clone());\n+            return true;\n+        }\n+        false\n+    }\n+\n+    fn reopen_feature_done_chat_for_typing(&mut self) {\n+        if self.ui.selected_agent().is_some() || !self.chat_buffer.as_str().is_empty() {\n+            return;\n+        }\n+        let Some(agent_id) = self.last_closed_feature_done_chat.take() else {\n+            return;\n+        };\n+        let _ = self.ui.activate_agent_chat(&agent_id);\n+    }\n+\n+    fn reopen_feature_done_chat_for_message(&mut self) -> Option<AgentId> {\n+        let agent_id = self.last_closed_feature_done_chat.take()?;\n+        let _ = self.ui.activate_agent_chat(&agent_id);\n+        Some(agent_id)\n+    }\n+\n     fn should_start_agent_slash_command(&self) -> bool {\n         self.ui.mode() == UiMode::Command && self.ui.selected_agent().is_some()\n     }\n@@ -1053,6 +1118,11 @@ fn is_agent_slash_command(line: &str) -> bool {\n     chars.next() == Some('/') && chars.next().is_some_and(|ch| !ch.is_whitespace())\n }\n \n+fn is_yes_reply(message: &str) -> bool {\n+    