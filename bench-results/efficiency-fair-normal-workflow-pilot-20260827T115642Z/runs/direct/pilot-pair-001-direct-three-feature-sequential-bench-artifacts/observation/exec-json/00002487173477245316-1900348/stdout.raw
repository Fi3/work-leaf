{"type":"item.completed","item":{"id":"item_74","type":"command_execution","command":"/usr/bin/bash -lc 'git diff -- src/workspace.rs src/terminal_app.rs src/ui.rs src/ui_harness.rs tests/workspace.rs tests/terminal_app.rs tests/ui_harness.rs'","aggregated_output":"diff --git a/src/terminal_app.rs b/src/terminal_app.rs\nindex 14a6a8f..2bec951 100644\n--- a/src/terminal_app.rs\n+++ b/src/terminal_app.rs\n@@ -1,5 +1,5 @@\n-use std::thread;\n use std::time::{Duration, Instant};\n+use std::{collections::BTreeSet, thread};\n \n use rustyline::line_buffer::{ChangeListener, DeleteListener, Direction, LineBuffer};\n \n@@ -10,7 +10,8 @@ use crate::cli::{\n use crate::http_controller::HttpControllerClient;\n use crate::ui::{AgentListEntry, PaneFocus, TerminalUi, UiKey, UiMode};\n use crate::workspace::{\n-    WorkLeafController, WorkLeafEvent, WorkLeafLoading, WorkLeafSession, WorkLeafSnapshot,\n+    FEATURE_DONE_PROMPT, WorkLeafController, WorkLeafEvent, WorkLeafLoading, WorkLeafSession,\n+    WorkLeafSnapshot,\n };\n \n #[derive(Debug)]\n@@ -310,6 +311,8 @@ where\n     chat_history: Vec<String>,\n     chat_history_index: Option<usize>,\n     chat_history_draft: Option<String>,\n+    feature_done_prompts: BTreeSet<AgentId>,\n+    last_closed_feature_done_chat: Option<AgentId>,\n     escape_sequence: Option<PendingEscapeSequence>,\n     paste_mode: bool,\n     skip_next_paste_lf: bool,\n@@ -347,6 +350,8 @@ where\n             chat_history: Vec::new(),\n             chat_history_index: None,\n             chat_history_draft: None,\n+            feature_done_prompts: BTreeSet::new(),\n+            last_closed_feature_done_chat: None,\n             escape_sequence: None,\n             paste_mode: false,\n             skip_next_paste_lf: false,\n@@ -359,6 +364,7 @@ where\n         let sessions = app.snapshot.sessions.clone();\n         for session in sessions {\n             app.apply_session_to_ui(&session);\n+            app.remember_feature_done_prompt(&session);\n         }\n