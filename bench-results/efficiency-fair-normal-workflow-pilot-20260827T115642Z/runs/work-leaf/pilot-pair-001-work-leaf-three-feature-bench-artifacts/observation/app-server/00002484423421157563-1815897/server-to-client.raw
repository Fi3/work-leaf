lize, Eq, PartialEq, Serialize)]\npub enum WorkLeafEvent {\n    AgentAdded {\n        session: WorkLeafSession,\n    },\n    AgentUpdated {\n        session: WorkLeafSession,\n    },\n    AgentStatusUpdated {\n        agent_id: AgentId,\n        kind: AgentKind,\n        title: String,\n        feature: String,\n        loading: Option<WorkLeafLoading>,\n        status: WorkLeafSessionStatus,\n    },\n    AgentLineAppended {\n        agent_id: AgentId,\n        line: String,\n    },\n","exitCode":0,"durationMs":0},"threadId":"01a04347-4439-7793-843e-fa41147c6505","turnId":"01a04350-e722-77c1-af8a-9141e0fbf0fb","completedAtMs":1787835800348},"emittedAtMs":1787835800348}
