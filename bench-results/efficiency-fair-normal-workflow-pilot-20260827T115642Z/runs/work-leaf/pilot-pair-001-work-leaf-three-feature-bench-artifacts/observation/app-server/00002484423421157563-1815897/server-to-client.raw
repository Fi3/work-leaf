to one session while other sessions may still be busy.\n250:`CommandTranscriptLine` carries one new command transcript line. `AgentStatusUpdated` carries\n259:## Localhost HTTP Controller\n269:- `POST /agent/message` calls `WorkLeafController::send_message`.\n280:## Terminal UI\n319:## Core Workflow Modules\n368:## Extension Rules\n396:## API and Architecture Change Policy\n416:## Validation Expectations\n435:----- END FILE docs/architecture.md -----\n437:----- BEGIN FILE src/lib.rs -----\n485:    WorkLeafController, WorkLeafEvent, WorkLeafLoading, WorkLeafSession, WorkLeafSessionStatus,\n488:----- END FILE src/lib.rs -----\n490:----- BEGIN FILE src/terminal_app.rs -----\n503:    WorkLeafController, WorkLeafEvent, WorkLeafLoading, WorkLeafSession, WorkLeafSessionStatus,\n689:    fn send_message(&mut self, agent_id: &AgentId, message: &str);\n717:    fn send_message(&mut self, agent_id: &AgentId, message: &str) {\n718:        let _ = self.controller.send_message(agent_id, message);\n763:    fn send_message(&mut self, agent_id: &AgentId, message: &str) {\n764:        let _ = HttpControllerClient::send_message(self, agent_id, message);\n852:            app.apply_session_to_ui(&session);\n1125:            self.controller.send_message(&agent_id, line);\n1145:            self.controller.send_message(&agent_id, &message);\n1160:        let _ = self.ui.set_agent_ready_state(agent_id, loading.is_none());\n1179:                    self.apply_session_to_ui(&session);\n1181:                WorkLeafEvent::AgentStatusUpdated {\n1191:                    self.apply_session_to_ui(&session);\n1233:        status: WorkLeafSessionStatus,\n1282:    fn apply_session_to_ui(&mut self, session: &WorkLeafSession) {\n1295:            .set_agent_ready_state(&session.id, session.loading.is_none() && session.status != WorkLeafSessionStatus::Done);\n1725:        fn send_message(&mut self, _agent_id: &AgentId, _message: &str) {}\n1783:                    status: WorkLeafSessionStatus::Active,\n1866:----- END FILE src/terminal_app.rs -----\n1868:----- BEGIN FILE src/ui_harness.rs -----\n1944:        self.ui.set_agent_ready_state(&agent_id, true)\n1947:    pub fn ask_feature_done(&mut self, agent_id: &str) -> Result<(), String> {\n1949:        self.ui.set_agent_ready_state(&agent_id, true)?;\n1952:            .push(\"work-leaf: is this feature done? yes/no\".to_string());\n2056:                        if self.handle_feature_done_response(agent_id, &message) {\n2068:                        let _ = self.ui.set_agent_ready_state(agent_id, true);\n2252:    fn handle_feature_done_response(&mut self, agent_id: &AgentId, message: &str) -> bool {\n2259:                let _ = self.ui.set_agent_ready_state(agent_id, false);\n2262:                let _ = self.ui.set_agent_ready_state(agent_id, false);\n2269:                    let _ = self.ui.set_agent_ready_state(agent_id, true);\n2277:            let _ = self.ui.set_agent_ready_state(agent_id, true);\n2554:----- END FILE src/ui_harness.rs -----\n2556:----- BEGIN FILE src/workspace.rs -----\n2791:            status: WorkLeafSessionStatus::Active,\n2803:    pub fn send_message(&mut self, agent_id: &AgentId, message: &str) -> Result<(), CliError> {\n2823:            WorkLeafSessionStatus::AwaitingFeatureDoneConfirmation => {\n2828:                    self.set_session_status(agent_id, WorkLeafSessionStatus::Done);\n2831:                self.set_session_status(agent_id, WorkLeafSessionStatus::Active);\n2837:            WorkLeafSessionStatus::Done => {\n2838:                self.set_session_status(agent_id, WorkLeafSessionStatus::Active);\n2841:            WorkLeafSessionStatus::Active => {}\n2957:                    status: WorkLeafSessionStatus::Active,\n2996:            status: WorkLeafSessionStatus::Active,\n3275:                    self.request_feature_done_confirmation(&review.commit.agent_id);\n3288:            self.pending_events.push(WorkLeafEvent::AgentStatusUpdated {\n3340:    fn request_feature_done_confirmation(&mut self, agent_id: &AgentId) {\n3343:            \"work-leaf: is this feature done? yes/no\".to_string(),\n3347:            WorkLeafSessionStatus::AwaitingFeatureDoneConfirmation,\n3379:        self.pending_events.push(WorkLeafEvent::AgentStatusUpdated {\n3389:    fn set_session_status(&mut self, agent_id: &AgentId, status: WorkLeafSessionStatus) {\n3405:        self.pending_events.push(WorkLeafEvent::AgentStatusUpdated {\n3415:    fn session_status(&self, agent_id: &AgentId) -> WorkLeafSessionStatus {\n3513:    pub status: WorkLeafSessionStatus,\n3525:            status: WorkLeafSessionStatus::Active,\n3537:pub enum WorkLeafSessionStatus {\n3540:    AwaitingFeatureDoneConfirmation,\n3552:    AgentStatusUpdated {\n3558:        status: WorkLeafSessionStatus,\n3889:----- END FILE src/workspace.rs -----\n3891:----- BEGIN FILE tests/ui_harness.rs -----\n3931:fn scripted_harness_feature_done_prompt_closes_and_reopens_chat() {\n3935:        .ask_feature_done(\"user-2\")\n3940:    assert!(pending_frame.contains(\"work-leaf: is this feature done? yes/no\"));\n4516:----- END FILE tests/ui_harness.rs -----\n4518:----- BEGIN FILE tests/workspace.rs -----\n4532:    WorkLeafSessionStatus,\n4561:    controller.send_message(&agent_id, \"continue\").unwrap();\n4610:    controller.send_message(&agent_id, \"continue\").unwrap();\n4615:            WorkLeafEvent::AgentStatusUpdated {\n4639:            WorkLeafEvent::AgentStatusUpdated {\n4768:        WorkLeafSessionStatus::AwaitingFeatureDoneConfirmation\n4785:            .any(|line| line == \"work-leaf: is this feature done? yes/no\")\n4802:fn controller_yes_closes_reviewed_feature_and_later_chat_reopens_it() {\n4821:        WorkLeafSessionStatus::AwaitingFeatureDoneConfirmation\n4825:    controller.send_message(&agent_id, \"yes\").unwrap();\n4828:    assert_eq!(closed_session.status, WorkLeafSessionStatus::Done);\n4843:        .send_message(&agent_id, \"please reopen this feature\")\n4848:    assert_eq!(reopened_session.status, WorkLeafSessionStatus::Active);\n4965:        .send_message(&agent_id, \"make the second update\")\n5152:        .send_message(&agent_id, \"make a second reviewed update\")\n5229:    controller.send_message(&second, \"slow question\").unwrap();\n5239:    controller.send_message(&first, \"quick question\").unwrap();\n5379:----- END FILE tests/workspace.rs -----\n","exitCode":0,"durationMs":0},"threadId":"01a0434e-39d0-76d2-840b-4bb14335d058","turnId":"01a0434e-6d25-7a61-bc37-4537d39ddefc","completedAtMs":1787835621836},"emittedAtMs":1787835621836}
