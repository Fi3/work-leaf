one, Copy, Debug, Deserialize, Eq, PartialEq, Serialize)]\npub enum WorkLeafLoading {\n    Launching,\n    WaitingForReply,\n}\n\n#[derive(Clone, Copy, Debug, Default, Deserialize, Eq, PartialEq, Serialize)]\npub enum WorkLeafSessionStatus {\n    #[default]\n    Active,\n    AwaitingFeatureDoneConfirmation,\n    Done,\n}\n\n#[derive(Clone, Debug, Deserialize, Eq, PartialEq, Serialize)]\npub enum WorkLeafEvent {\n    AgentAdded {\n        session: WorkLeafSession,\n    },\n    AgentUpdated {\n        session: WorkLeafSession,\n    },\n    AgentStatusUpdated {\n        agent_id: AgentId,\n        kind: AgentKind,\n        title: String,\n        feature: String,\n        loading: Option<WorkLeafLoading>,\n        status: WorkLeafSessionStatus,\n    },\n    AgentLineAppended {\n        agent_id: AgentId,\n        line: String,\n    },\n    AgentSelected {\n        agent_id: AgentId,\n","exitCode":0,"durationMs":0},"threadId":"01a0434e-39d0-76d2-840b-4bb14335d058","turnId":"01a0434e-6d25-7a61-bc37-4537d39ddefc","completedAtMs":1787835640089},"emittedAtMs":1787835640090}
