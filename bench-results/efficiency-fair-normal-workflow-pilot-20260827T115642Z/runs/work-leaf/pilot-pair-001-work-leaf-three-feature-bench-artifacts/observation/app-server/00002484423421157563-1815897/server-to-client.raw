);\n5382:#[test]\n5383:fn scripted_harness_rings_and_highlights_ready_chat() {\n5384:    let mut harness = UiHarness::new(100, 24);\n5389:        .mark_agent_ready(\"user-2\")\n5390:        .expect(\"fixture user-2 agent is registered\");\n5398:#[test]\n5400:    let mut harness = UiHarness::new(80, 24);\n5417:#[test]\n5419:    let mut harness = UiHarness::new(80, 24);\n5428:#[test]\n5430:    let mut harness = UiHarness::new(20, 10);\n5432:    harness.handle_bytes(b\":abcdefghijklmnopqrstuvwxyz0123\\x1b[D\\x1b[D\\x1b[D\\x1b[D\\x1b[DX\");\n5435:    assert!(frame.contains(\":ijklmnopqrstuvwxyXz\"));\n5444:            .any(|line| line == \"unknown fixture command: abcdefghijklmnopqrstuvwxyXz0123\")\n5447:#[test]\n5449:    let mut harness = UiHarness::new(80, 24);\n5450:    harness.handle_bytes(b\":review\\n:linearize\\n:\\x1b[A\\x1b[A\\x1b[B\\n\");\n5462:#[test]\n5464:    let mut harness = UiHarness::new(80, 24);\n5466:    harness.handle_bytes(b\":review\\n:draft command\\x1b[A\\x1b[B\\n\");\n5472:            .any(|line| line == \"unknown fixture command: draft command\")\n5476:#[test]\n5478:    let mut harness = UiHarness::new(80, 24);\n5494:            .any(|line| line == \"unknown fixture command: aZb\")\n5497:#[test]\n5499:    let mut harness = UiHarness::new(80, 24);\n5525:#[test]\n5526:fn scripted_harness_ctrl_c_never_quits_and_only_right_focus_interrupts_agent() {\n5527:    let mut harness = UiHarness::new(80, 24);\n5551:#[test]\n5552:fn scripted_harness_command_mode_typing_shows_insert_mode_notice() {\n5553:    let mut harness = UiHarness::new(80, 24);\n5565:#[test]\n5566:fn scripted_harness_ctrl_c_shows_quit_notice() {\n5567:    let mut harness = UiHarness::new(80, 24);\n5578:#[test]\n5579:fn scripted_harness_structural_command_keys_do_not_show_typing_notice() {\n5580:    let mut harness = UiHarness::new(80, 24);\n5588:#[test]\n5589:fn scripted_harness_left_pane_navigation_does_not_show_typing_notice() {\n5590:    let mut harness = UiHarness::new(80, 24);\n5596