r review\\n@work-leaf end\\n@work-leaf done\",\n4507:    let chat = CommandChat::new(root.clone(), backend.clone()).with_max_review_rounds(4);\n4515:        \"after review\\n\"\n4518:    let reviewer_id = AgentId::new(\"review-user-1\").unwrap();\n4519:    let snapshot = controller.snapshot();\n4520:    let reviewer = snapshot\n4521:        .session(&reviewer_id)\n4522:        .expect(\"reviewer session exists\");\n4523:    assert_eq!(reviewer.title, \"review user-agent\");\n4524:    assert_eq!(reviewer.loading, None);\n4525:    let patch_agent = snapshot.session(&agent_id).expect(\"patch agent exists\");\n4530:            .any(|line| line.contains(\"missing reviewed wording\"))\n4534:            line.contains(\"user-1 reviewed by review-user-1: rounds=2 resolved=yes\")\n4541:            && prompt.contains(\"missing reviewed wording\")\n4545:        target == &reviewer_id\n4552:fn controller_does_not_start_review_until_patch_agent_reports_done() {\n4553:    let root = git_repo(\"workspace-review-waits-for-done\");\n4562:    let chat = CommandChat::new(root, backend.clone()).with_max_review_rounds(4);\n4568:    let snapshot = controller.snapshot();\n4570:        snapshot\n4571:            .session(&AgentId::new(\"review-user-1\").unwrap())\n4573:        \"review must wait for the patch agent to report done\"\n4575:    let patch_agent = snapshot.session(&agent_id).expect(\"patch agent exists\");\n4576:    assert_eq!(patch_agent.loading, None);\n4581:            .any(|launch| launch.id.as_str() == \"review-user-1\")\n4592:fn controller_review_prompt_covers_all_agent_commits_since_launch() {\n4593:    let root = git_repo(\"workspace-review-full-agent-scope\");\n4603:    let chat = CommandChat::new(root, backend.clone()).with_max_review_rounds(4);\n4613:    let review_launch = launches\n4615:        .find(|launch| launch.id.as_str() == \"review-user-1\")\n4616:        .expect(\"reviewer launched\");\n4618:        review_launch.prompt.contains(\"first step\"),\n4620:     