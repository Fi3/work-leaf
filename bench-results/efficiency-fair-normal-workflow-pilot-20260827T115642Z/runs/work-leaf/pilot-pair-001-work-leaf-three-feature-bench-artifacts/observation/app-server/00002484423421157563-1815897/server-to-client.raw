);\n 747         if !self.sessions.contains_key(agent_id) {\n 748             let session = WorkLeafSession::unknown(agent_id.clone(), fallback_kind);\n 749             self.sessions.insert(agent_id.clone(), session.clone());\n 750             self.pending_events\n 751                 .push(WorkLeafEvent::AgentAdded { session });\n 752         }\n 753         let session = self\n 754             .sessions\n 755             .get_mut(agent_id)\n 756             .expect(\"session was inserted before appending a line\");\n 757         if session.lines.iter().any(|existing| existing == &line) {\n 758             return;\n 759         }\n 760         session.lines.push(line.clone());\n 761         self.pending_events.push(WorkLeafEvent::AgentLineAppended {\n 762             agent_id: agent_id.clone(),\n 763             line,\n 764         });\n 765     }\n 766 \n 767     fn record_review_result(&mut self, review: &ReviewResult) {\n 768         self.review_commits_in_progress.remove(&review.agent_id);\n 769         let latest_commit = self\n 770             .latest_agent_review_commit(&review.agent_id)\n 771             .unwrap_or_else(|| review.commit.clone());\n 772         self.reviewed_agent_commits\n 773             .insert(review.agent_id.clone(), latest_commit.hash.clone());\n 774         self.agent_review_baselines\n 775             .insert(review.agent_id.clone(), latest_commit.hash.clone());\n 776         if let Some(chat) = self.chat.as_mut() {\n 777             chat.mark_reviewed_agent_commit(latest_commit);\n 778         }\n 779         self.reviewers.insert(review.reviewer_id.clone());\n 780     }\n 781 \n 782     fn request_feature_done_confirmation(&mut self, agent_id: &AgentId) {\n 783         self.append_agent_line(\n 784             agent_id,\n 785             \"work-leaf: is this feature done? yes/no\".to_string(),\n 786         );\n 787         self.set_session_status(\n 788             agent_id,\n 789             WorkLeafSessionStatus::AwaitingFeatureDoneConfirmation,\n 790         );\n 791     }\n 792 \n 793     fn latest_agent_review_commit(&self, agent_id: &AgentId) -> Option<AgentCommit> {\n 794         let root = self\n 795             .chat\n","exitCode":0,"durationMs":0},"threadId":"01a0434e-39d0-76d2-840b-4bb14335d058","turnId":"01a0434f-67ec-7a43-a9c8-7b7e43c48e2a","completedAtMs":1787835735534},"emittedAtMs":1787835735535}
