0             }\n 691             WorkerEvent::ReviewError {\n 692                 reviewer_id,\n 693                 reviewed_agent_id,\n 694                 message,\n 695             } => {\n 696                 self.review_commits_in_progress.remove(&reviewed_agent_id);\n 697                 self.set_session_loading(&reviewer_id, None);\n 698                 self.append_agent_line(&reviewer_id, message);\n 699             }\n 700         }\n 701     }\n 702 \n 703     fn apply_agent_result(&mut self, agent_id: &AgentId, result: &CommandChatResult) {\n 704         match result {\n 705             CommandChatResult::AgentLaunched { reply, .. }\n 706             | CommandChatResult::AgentMessage { reply, .. } => {\n 707                 if !reply.is_empty() {\n 708                     self.append_agent_line(agent_id, reply.clone());\n 709                 }\n 710             }\n 711             CommandChatResult::ReviewComplete(results) => {\n 712                 let text = command_result_text(result);\n 713                 self.push_command_line(text.clone());\n 714                 for review in results {\n 715                     self.record_review_result(review);\n 716                     self.append_agent_line(&review.commit.agent_id, format!(\"review: {text}\"));\n 717                     self.request_feature_done_confirmation(&review.commit.agent_id);\n 718                 }\n 719             }\n 720             other => {\n 721                 self.push_command_line(command_result_text(other));\n 722             }\n 723         }\n 724     }\n 725 \n","exitCode":0,"durationMs":0},"threadId":"01a0434e-39d0-76d2-840b-4bb14335d058","turnId":"01a0434f-67ec-7a43-a9c8-7b7e43c48e2a","completedAtMs":1787835748363},"emittedAtMs":1787835748364}
