.with_max_review_rounds(4);\n4837:        .send_message(&agent_id, \"make a second reviewed update\")\n4892:    let snapshot = controller.snapshot();\n4893:    let session = snapshot.session(&agent_id).expect(\"session exists\");\n4894:    assert_eq!(session.loading, None);\n4905:fn controller_keeps_agent_loading_scoped_to_the_active_session() {\n4914:    controller.send_message(&second, \"slow question\").unwrap();\n4917:            .snapshot()\n4920:            .loading,\n4921:        Some(WorkLeafLoading::WaitingForReply)\n4924:    controller.send_message(&first, \"quick question\").unwrap();\n4927:    let snapshot = controller.snapshot();\n4928:    let first_session = snapshot.session(&first).expect(\"first session\");\n5012:        session.push_message(MessageRole::Agent, \"ready\");\n","exitCode":0,"durationMs":0},"threadId":"01a04347-4439-7793-843e-fa41147c6505","turnId":"01a04348-7e21-7560-ad07-28a268936811","completedAtMs":1787835230628},"emittedAtMs":1787835230629}
