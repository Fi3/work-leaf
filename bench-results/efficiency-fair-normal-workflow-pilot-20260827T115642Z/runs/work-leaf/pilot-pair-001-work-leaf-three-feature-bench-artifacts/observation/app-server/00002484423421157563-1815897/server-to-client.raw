{"method":"item/completed","params":{"item":{"type":"agentMessage","id":"msg_0c1fcc85c5704ee9016a903371fc9c87d2aa6d9a26237c6b48","text":"There is no existing “closed” UI concept in the terminal adapter beyond hiding rows, and `AgentSession` already has domain states but the controller snapshot does not expose close/done state. I’m checking the agent state and command result shape so I can add the smallest UI-facing status without changing provider contracts.","phase":"commentary","memoryCitation":null,"delivery":null},"threadId":"01a04347-4439-7793-843e-fa41147c6505","turnId":"01a04348-7e21-7560-ad07-28a268936811","completedAtMs":1787835257645},"emittedAtMs":1787835257645}
