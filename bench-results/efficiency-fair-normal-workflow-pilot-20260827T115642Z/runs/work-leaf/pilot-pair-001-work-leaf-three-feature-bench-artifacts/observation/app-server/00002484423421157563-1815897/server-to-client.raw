 cache-producing tool, or repository-required check that may write files.\",\n713:            \"Do not use command locks for manual feature edits; manual code or documentation changes must still be submitted with the unified-diff patch directive.\",\n714:            \"Use `@work-leaf send <agent-id> <message>` to route context to another agent.\",\n715:            \"You are responsible for following the project instructions, including running the repository's required checks before you submit a patch or report work done.\",\n716:            \"Use `@work-leaf done` when no more orchestrator work is required.\",\n724:    pub fn for_project(root: impl AsRef<Path>) -> Result<Self, AgentError> {\n731:    ) -> Result<Self, AgentError> {\n737:    pub fn inject(&self, agent_id: &AgentId, feature: &str, prompt: &str) -> String {\n752:            \"\\n\\nAgent-ID: {agent_id}\\nFeature: {feature}\\n\\nUser prompt:\\n{prompt}\"\n760:        Self::for_restricted_agents()\n764:#[derive(Debug)]\n765:pub enum AgentError {\n766:    InvalidAgentId(String),\n773:    UnknownSession(AgentId),\n776:impl fmt::Display for AgentError {\n779:            Self::InvalidAgentId(message) => formatter.write_str(message),\n792:            Self::UnknownSession(id) => write!(formatter, \"unknown agent session `{id}`\"),\n797:impl std::error::Error for AgentError {\n806:impl From<std::io::Error> for AgentError {\n811:----- END FILE src/agent.rs -----\n813:----- BEGIN FILE src/agent_runtime.rs -----\n822:use crate::agent::{AgentError, AgentId, AgentLaunch, AgentSession, ChatMessage};\n824:pub trait AgentBackend {\n825:    fn launch(&mut self, request: AgentLaunch) -> Result<AgentSession, AgentError>;\n826:    fn send(&mut self, agent_id: &AgentId, prompt: &str) -> Result<ChatMessage, AgentError>;\n827:    fn interrupt(&mut self, _agent_id: &AgentId) -> Result<(), AgentError> {\n831:    fn shutdown_handle(&self) -> AgentShutdownHandle {\n832:        AgentShutdownHandle::default()\n837:        request: A