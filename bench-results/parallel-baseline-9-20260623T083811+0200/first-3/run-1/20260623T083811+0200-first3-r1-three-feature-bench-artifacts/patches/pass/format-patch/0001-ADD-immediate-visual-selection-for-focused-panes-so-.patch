From db751e4f3711fbe3a516508c60cb4f2ab3d4b166 Mon Sep 17 00:00:00 2001
From: fi3 <you@example.com>
Date: Tue, 23 Jun 2026 09:17:42 +0200
Subject: [PATCH 1/2] ADD immediate visual selection for focused panes so
 Vim-style selection starts on the active row

Command-mode visual entry creates an active selection immediately from the focused pane, matching the behavior users expect from Vim-style selection commands.

Left-pane selection resolves the rendered control target before choosing the visual anchor, so grouped or hidden rows copy the focused visible entry instead of a raw row index.
---
 src/ui.rs            | 25 ++++++++++++++-
 tests/terminal_ui.rs | 26 ++++++---------
 tests/ui_harness.rs  | 76 +++++++++++++++++++++++++++++++++++++++++---
 3 files changed, 105 insertions(+), 22 deletions(-)

diff --git a/src/ui.rs b/src/ui.rs
index 620b15c..ee196cb 100644
--- a/src/ui.rs
+++ b/src/ui.rs
@@ -669,6 +669,11 @@ impl TerminalUi {
             }
             UiKey::Char('v') if self.mode == UiMode::Command => {
                 self.start_visual_cursor(visible_right_content, right_cursor_column);
+                self.start_visual_selection(
+                    VisualSelectionMode::Character,
+                    visible_right_content,
+                    right_cursor_column,
+                );
                 Vec::new()
             }
             UiKey::Char('V') if self.mode == UiMode::Command => {
@@ -1190,7 +1195,9 @@ impl TerminalUi {
         match self.focus {
             PaneFocus::Left => {
                 let lines = self.visual_pane_lines(visible_right_content, PaneFocus::Left);
-                let row = self.control_selected.min(lines.len().saturating_sub(1));
+                let row = self
+                    .left_visual_start_row()
+                    .min(lines.len().saturating_sub(1));
                 VisualPoint { row, column: 0 }
             }
             PaneFocus::Right => {
@@ -1226,6 +1233,22 @@ impl TerminalUi {
         lines.len().saturating_sub(1)
     }
 
+    fn left_visual_start_row(&self) -> usize {
+        let target = if self.control_selected == 0 {
+            LeftPaneClickTarget::Command
+        } else {
+            let Some(agent_id) = self.control_selected_agent_id() else {
+                return 0;
+            };
+            LeftPaneClickTarget::Agent(agent_id)
+        };
+        let inner_width = usize::from(self.layout().left_width.saturating_sub(2).max(1));
+        self.left_pane_lines(inner_width)
+            .iter()
+            .position(|line| line.control_target.as_ref() == Some(&target))
+            .unwrap_or(0)
+    }
+
     fn move_visual_cursor(
         &mut self,
         row_delta: isize,
