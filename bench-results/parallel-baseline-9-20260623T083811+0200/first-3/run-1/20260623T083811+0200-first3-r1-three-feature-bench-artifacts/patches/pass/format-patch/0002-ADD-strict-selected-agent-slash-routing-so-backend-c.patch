+
+fn update_thread_id_if_current(
+    state: &mut CodexBackendState,
+    agent_id: &AgentId,
+    expected_current: Option<&str>,
+    new_thread_id: String,
+) {
+    let current = state.thread_ids.get(agent_id).map(String::as_str);
+    let should_update = match expected_current {
+        Some(expected) => current.is_none_or(|current| current == expected),
+        None => current.is_none(),
+    };
+    if should_update {
+        state.thread_ids.insert(agent_id.clone(), new_thread_id);
+    }
