+    #[test]
+    fn launch_thread_update_does_not_overwrite_forked_thread() {
+        let agent_id = AgentId::new("user-1").expect("test agent id is valid");
+        let mut state = CodexBackendState::default();
+
+        update_thread_id_if_current(&mut state, &agent_id, None, "launch-thread".to_string());
+        assert_eq!(
+            state.thread_ids.get(&agent_id).map(String::as_str),
+            Some("launch-thread")
+        );
+
+        update_thread_id_if_current(
+            &mut state,
+            &agent_id,
+            Some("launch-thread"),
+            "fork-thread".to_string(),
+        );
+        assert_eq!(
+            state.thread_ids.get(&agent_id).map(String::as_str),
+            Some("fork-thread")
+        );
+
+        update_thread_id_if_current(&mut state, &agent_id, None, "launch-thread".to_string());
+        assert_eq!(
+            state.thread_ids.get(&agent_id).map(String::as_str),
+            Some("fork-thread")
+        );
+    }
+}
