+#[test]
+fn scripted_harness_highlights_done_question_closes_and_reopens_patch_chat() {
+    let mut harness = UiHarness::new(100, 24);
+
+    harness
+        .mark_agent_needs_completion_decision("user-1")
+        .expect("fixture user-1 agent is registered");
+    let done_left_pane = harness.ui().render_left_pane();
+    assert!(done_left_pane.contains("parser DONE?"));
+    assert!(done_left_pane.contains("READY"));
+    assert!(done_left_pane.contains("\u{1b}[7m"));
+
+    harness
+        .mark_agent_closed("user-1")
+        .expect("fixture user-1 agent is registered");
+    let closed_left_pane = strip_ansi(&harness.ui().render_left_pane());
+    assert!(closed_left_pane.contains("[closed]\n>parser CLOSED user-1"));
+    assert!(!closed_left_pane.contains("READY"));
+
+    harness.handle_byte(b'\n');
+    harness.handle_bytes(b"another change\n");
+
+    let reopened_left_pane = strip_ansi(&harness.ui().render_left_pane());
+    assert!(!reopened_left_pane.contains("parser CLOSED"));
+    assert!(reopened_left_pane.contains("[working]\n>parser user-1"));
+    assert!(
+        harness
+            .transcript()
+            .iter()
+            .any(|line| line == "user-1> another change")
+    );
+}
