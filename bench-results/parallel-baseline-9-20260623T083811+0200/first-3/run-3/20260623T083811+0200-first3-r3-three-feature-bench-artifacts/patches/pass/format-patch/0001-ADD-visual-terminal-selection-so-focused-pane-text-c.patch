From 7b006cf86653fdd72ecbbeeafc5581fc84d7333b Mon Sep 17 00:00:00 2001
From: fi3 <you@example.com>
Date: Tue, 23 Jun 2026 09:00:08 +0200
Subject: [PATCH 1/3] ADD visual terminal selection so focused pane text can be
 copied accurately

Start visual mode immediately from the focused pane's rendered cursor row, and cover character, line, and block yanks so terminal users can copy left- or right-pane text without a separate cursor setup step.
---
 src/ui.rs            | 45 ++++++++++++++--------------
 tests/terminal_ui.rs | 28 +++++-------------
 tests/ui_harness.rs  | 70 ++++++++++++++++++++++++++++++++++++++++++--
 3 files changed, 98 insertions(+), 45 deletions(-)

diff --git a/src/ui.rs b/src/ui.rs
index 620b15c..8d2c379 100644
--- a/src/ui.rs
+++ b/src/ui.rs
@@ -668,7 +668,11 @@ impl TerminalUi {
                 Vec::new()
             }
             UiKey::Char('v') if self.mode == UiMode::Command => {
-                self.start_visual_cursor(visible_right_content, right_cursor_column);
+                self.start_visual_selection(
+                    VisualSelectionMode::Character,
+                    visible_right_content,
+                    right_cursor_column,
+                );
                 Vec::new()
             }
             UiKey::Char('V') if self.mode == UiMode::Command => {
@@ -1091,18 +1095,6 @@ impl TerminalUi {
         Vec::new()
     }
 
-    fn start_visual_cursor(
-        &mut self,
-        visible_right_content: &str,
-        right_cursor_column: Option<usize>,
-    ) {
-        let point = self.visual_start_point(visible_right_content, right_cursor_column);
-        self.visual_cursor = Some(VisualCursor {
-            pane: self.focus,
-            point,
-        });
-    }
-
     fn start_visual_selection(
         &mut self,
         mode: VisualSelectionMode,
@@ -1190,7 +1182,10 @@ impl TerminalUi {
         match self.focus {
             PaneFocus::Left => {
                 let lines = self.visual_pane_lines(visible_right_content, PaneFocus::Left);
-                let row = self.control_selected.min(lines.len().saturating_sub(1));
+                let row = self
+                    .left_control_row()
+                    .unwrap_or(0)
+                    .min(lines.len().saturating_sub(1));
                 VisualPoint { row, column: 0 }
             }
             PaneFocus::Right => {
@@ -1602,7 +1597,7 @@ impl TerminalUi {
     }
 
     fn command_mode_text_key_control_status(&self, key: UiKey) -> Option<bool> {
-        if self.mode != UiMode::Command || self.pending.is_some() {
+        if self.mode != UiMode::Command || self.pending.is_some() || self.visual_mode_active() {
             return None;
         }
         let UiKey::Char(ch) = key else {
@@ -1614,7 +1609,7 @@ impl TerminalUi {
     fn is_command_control_char(&self, ch: char) -> bool {
         matches!(
             ch,
-            'i' | ':' | ',' | 's' | 't' | 'f' | 'g' | 'G' | 'v' | 'V' | 'Y' | 'z' | CTRL_V
+            'i' | ':' | ',' | 's' | 't' | 'f' | 'g' | 'G' | 'v' | 'V' | 'y' | 'Y' | 'z' | CTRL_V
         ) || (self.focus == PaneFocus::Left && matches!(ch, 'j' | 'k' | 'l' | 'x'))
     }
 
@@ -2049,20 +2044,22 @@ impl TerminalUi {
     }
 
     fn control_cursor_row(&self) -> u16 {
+        self.left_control_row()
+            .map(|row| (row + 2).min(usize::from(u16::MAX)) as u16)
+            .unwrap_or(2)
+    }
+
+    fn left_control_row(&self) -> Option<usize> {
         let target = if self.control_selected == 0 {
             LeftPaneClickTarget::Command
         } else {
-            let Some(agent_id) = self.control_selected_agent_id() else {
-                return 2;
-            };
+            let agent_id = self.control_selected_agent_id()?;
             LeftPaneClickTarget::Agent(agent_id)
         };
         let inner_width = usize::from(self.layout().left_width.saturating_sub(2).max(1));
         self.left_pane_lines(inner_width)
             .iter()
             .position(|line| line.control_target.as_ref() == Some(&target))
-            .map(|row| (row + 2).min(usize::from(u16::MAX)) as u16)
-            .unwrap_or(2)
     }
 
     fn right_cursor_position_with_cursor(
@@ -2119,9 +2116,13 @@ impl TerminalUi {
 
     fn render_status_line(&self) -> String {
         if let Some(selection) = &self.visual_selection {
+            let visual_mode = match selection.mode {
+                VisualSelectionMode::Character => "cursor",
+                _ => selection.mode.as_str(),
+            };
             return format!(
                 "mode=visual-{} focus={} window={}/{}",
-                selection.mode.as_str(),
+                visual_mode,
                 self.focus.as_str(),
                 self.active_window + 1,
                 self.windows.len()
