diff --git a/tests/ui_harness.rs b/tests/ui_harness.rs
index 3502bcf..240caa8 100644
--- a/tests/ui_harness.rs
+++ b/tests/ui_harness.rs
@@ -348,6 +348,71 @@ fn scripted_harness_visual_mode_yanks_right_pane_line_to_clipboard() {
     assert!(frame.contains("copied "));
 }
 
+#[test]
+fn scripted_harness_v_immediately_selects_right_pane_text() {
+    let mut harness = UiHarness::new(80, 24);
+
+    harness.handle_bytes(&[23, b'l']);
+    harness.handle_byte(b'v');
+
+    assert!(harness.ui().visual_selection_active());
+
+    harness.handle_byte(b'y');
+
+    assert_eq!(harness.ui().copied_text(), Some("E"));
+}
+
+#[test]
+fn scripted_harness_visual_mode_yanks_left_pane_character_selection() {
+    let mut harness = UiHarness::new(80, 24);
+
+    assert_eq!(harness.ui().focus(), PaneFocus::Left);
+
+    harness.handle_byte(b'v');
+
+    assert!(harness.ui().visual_selection_active());
+
+    harness.handle_bytes(b"lly");
+
+    assert_eq!(harness.ui().copied_text(), Some(">us"));
+}
+
+#[test]
+fn scripted_harness_visual_line_mode_yanks_focused_left_pane_row() {
+    let mut harness = UiHarness::new(80, 24);
+
+    harness.handle_byte(b'V');
+
+    assert!(harness.ui().visual_selection_active());
+    assert!(
+        harness
+            .render_frame()
+            .contains("mode=visual-line focus=left")
+    );
+
+    harness.handle_byte(b'Y');
+
+    assert_eq!(harness.ui().copied_text(), Some(">user-1 READY"));
+}
+
+#[test]
+fn scripted_harness_visual_block_mode_yanks_left_pane_columns() {
+    let mut harness = UiHarness::new(80, 24);
+
+    harness.handle_byte(22);
+
+    assert!(harness.ui().visual_selection_active());
+    assert!(
+        harness
+            .render_frame()
+            .contains("mode=visual-block focus=left")
+    );
+
+    harness.handle_bytes(b"ljy");
+
+    assert_eq!(harness.ui().copied_text(), Some(">u\n  "));
+}
+
