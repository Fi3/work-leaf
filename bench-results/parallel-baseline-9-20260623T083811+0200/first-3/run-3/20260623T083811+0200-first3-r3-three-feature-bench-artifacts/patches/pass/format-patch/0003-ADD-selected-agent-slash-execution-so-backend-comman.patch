@@ -77,6 +84,19 @@ pub trait AgentBackend {
     }
 }
 
+fn unsupported_agent_command_reply(command: &str) -> String {
+    let trimmed = command.trim();
+    let token = trimmed.split_whitespace().next().unwrap_or(trimmed);
+    let command = if token.is_empty() {
+        "the requested command"
+    } else {
+        token
+    };
+    format!(
+        "Backend command {command} is not supported by this agent provider; no model request was sent."
+    )
+}
