diff --git a/tests/ui_harness.rs b/tests/ui_harness.rs
index 346bfc3..f635229 100644
--- a/tests/ui_harness.rs
+++ b/tests/ui_harness.rs
@@ -86,6 +86,41 @@ fn scripted_harness_rings_and_highlights_ready_chat() {
     assert!(!harness.render_frame().starts_with('\u{7}'));
 }
 
+#[test]
+fn scripted_harness_completion_question_highlights_closes_and_reopens_patch_chat() {
+    let mut harness = UiHarness::new(100, 24);
+
+    harness
+        .mark_agent_needs_decision("user-2", "tests")
+        .expect("fixture user-2 agent is registered");
+
+    let decision_frame = harness.render_frame();
+    assert!(decision_frame.starts_with('\u{7}'));
+    assert!(decision_frame.contains("\u{1b}[7m"));
+
+    let decision_left_pane = strip_ansi(&harness.ui().render_left_pane());
+    assert!(decision_left_pane.contains("tests DONE? user-2  working: tests DONE?  READY"));
+
+    harness
+        .mark_agent_closed("user-2", "tests")
+        .expect("fixture user-2 agent is registered");
+
+    let closed_left_pane = strip_ansi(&harness.ui().render_left_pane());
+    assert!(closed_left_pane.contains("[closed]"));
+    assert!(closed_left_pane.contains("tests CLOSED user-2  working: tests CLOSED"));
+    assert!(!closed_left_pane.contains("tests CLOSED  READY"));
+
+    harness
+        .mark_agent_reopened("user-2", "tests")
+        .expect("fixture user-2 agent is registered");
+
+    let reopened_left_pane = strip_ansi(&harness.ui().render_left_pane());
+    assert!(reopened_left_pane.contains("[working]"));
+    assert!(reopened_left_pane.contains("tests user-2  working: tests"));
+    assert!(!reopened_left_pane.contains("tests DONE?"));
+    assert!(!reopened_left_pane.contains("tests CLOSED"));
+}
