+    #[test]
+    fn closed_feature_reopens_when_user_types_again() {
+        let backend = ScriptedBackend::new(["reopened reply"]);
+        let chat = CommandChat::new(PathBuf::from("/repo"), backend.clone());
+        let mut controller = WorkLeafController::new(chat);
+        let agent_id = AgentId::new("chat-9").expect("test agent id is valid");
+
+        controller.register_agent_feature(agent_id.clone(), "reviewed feature".to_string());
+        controller.add_session(WorkLeafSession {
+            id: agent_id.clone(),
+            kind: AgentKind::Codex,
+            title: "chat-9".to_string(),
+            feature: "reviewed feature".to_string(),
+            lines: Vec::new(),
+            loading: None,
+            completion: None,
+            token_usage: None,
+            depends_on: Vec::new(),
+            depended_on_by: Vec::new(),
+        });
+        controller.ask_feature_done(&agent_id);
+
+        controller
+            .send_message(&agent_id, "yes")
+            .expect("yes answer closes the reviewed feature");
+        let snapshot = controller.snapshot();
+        let closed_session = snapshot
+            .session(&agent_id)
+            .expect("patch agent session exists");
+        assert_eq!(closed_session.completion, Some(WorkLeafCompletion::Closed));
+        assert!(
+            closed_session
+                .lines
+                .iter()
+                .any(|line| line == FEATURE_CLOSED_MESSAGE),
+            "{closed_session:?}"
+        );
+
+        controller
+            .send_message(&agent_id, "please revisit edge case")
+            .expect("typing in a closed feature reopens it");
+        assert!(controller.wait_for_idle(Duration::from_secs(2)));
+
+        assert_eq!(
+            backend.sends(),
+            vec![(agent_id.clone(), "please revisit edge case".to_string())]
+        );
+        let snapshot = controller.snapshot();
+        let reopened_session = snapshot
+            .session(&agent_id)
+            .expect("patch agent session exists");
+        assert_eq!(reopened_session.completion, None);
+        assert!(
+            reopened_session
+                .lines
+                .iter()
+                .any(|line| line == FEATURE_OPEN_MESSAGE),
+            "{reopened_session:?}"
+        );
+        assert!(
+            reopened_session
+                .lines
+                .iter()
+                .any(|line| line == "user: please revisit edge case"),
+            "{reopened_session:?}"
+        );
+        assert!(
+            reopened_session
+                .lines
+                .iter()
+                .any(|line| line == "reopened reply"),
+            "{reopened_session:?}"
+        );
+    }
