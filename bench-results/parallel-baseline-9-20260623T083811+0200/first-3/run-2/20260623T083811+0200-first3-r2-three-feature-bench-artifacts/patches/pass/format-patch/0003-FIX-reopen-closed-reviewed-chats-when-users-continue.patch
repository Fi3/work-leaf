From 20e3abd76d0bad7db8f257857407e12551881bef Mon Sep 17 00:00:00 2001
From: fi3 <you@example.com>
Date: Tue, 23 Jun 2026 08:58:32 +0200
Subject: [PATCH 3/3] FIX reopen closed reviewed chats when users continue work

Clear the closed completion state before forwarding a new user message so reviewed patch chats can resume normal agent work after a previous done decision.
---
 src/ui_harness.rs   | 27 +++++++++++++++
 src/workspace.rs    | 80 +++++++++++++++++++++++++++++++++++++++++++++
 tests/ui_harness.rs | 35 ++++++++++++++++++++
 3 files changed, 142 insertions(+)

diff --git a/src/ui_harness.rs b/src/ui_harness.rs
index eb09368..b8cf694 100644
--- a/src/ui_harness.rs
+++ b/src/ui_harness.rs
@@ -67,6 +67,33 @@ impl UiHarness {
         self.ui.set_agent_ready_state(&agent_id, true)
     }
 
+    pub fn mark_agent_needs_decision(
+        &mut self,
+        agent_id: &str,
+        feature: &str,
+    ) -> Result<(), String> {
+        let agent_id = AgentId::new(agent_id).map_err(|error| error.to_string())?;
+        self.ui
+            .set_agent_feature(&agent_id, format!("{feature} DONE?"))?;
+        self.ui.set_agent_patch_lifecycle(&agent_id, true, false)?;
+        self.ui.set_agent_ready_state(&agent_id, true)
+    }
+
+    pub fn mark_agent_closed(&mut self, agent_id: &str, feature: &str) -> Result<(), String> {
+        let agent_id = AgentId::new(agent_id).map_err(|error| error.to_string())?;
+        self.ui
+            .set_agent_feature(&agent_id, format!("{feature} CLOSED"))?;
+        self.ui.set_agent_patch_lifecycle(&agent_id, true, true)?;
+        self.ui.set_agent_ready_state(&agent_id, false)
+    }
+
+    pub fn mark_agent_reopened(&mut self, agent_id: &str, feature: &str) -> Result<(), String> {
+        let agent_id = AgentId::new(agent_id).map_err(|error| error.to_string())?;
+        self.ui.set_agent_feature(&agent_id, feature)?;
+        self.ui.set_agent_patch_lifecycle(&agent_id, true, false)?;
+        self.ui.set_agent_ready_state(&agent_id, false)
+    }
+
