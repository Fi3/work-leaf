+
+    pub(crate) fn set_agent_patch_lifecycle_state(
+        &mut self,
+        agent_id: &AgentId,
+        has_user_message: bool,
+        needs_decision: bool,
+        closed: bool,
     ) -> Result<(), String> {
         let control_agent = self.control_selected_agent_id();
         if !self.agents.iter().any(|agent| &agent.id == agent_id) {
             return Err(format!("unknown agent `{agent_id}`"));
         }
+        let previous = self.agent_patch_states.get(agent_id).copied();
+        let needs_decision = needs_decision && !closed;
         self.agent_patch_states.insert(
             agent_id.clone(),
             AgentListPatchState {
                 has_user_message,
+                needs_decision,
                 closed,
             },
         );
+        if needs_decision && previous.is_none_or(|state| !state.needs_decision) {
+            self.pending_bell.set(true);
+        }
         self.restore_control_selection(control_agent.as_ref());
         Ok(())
     }
