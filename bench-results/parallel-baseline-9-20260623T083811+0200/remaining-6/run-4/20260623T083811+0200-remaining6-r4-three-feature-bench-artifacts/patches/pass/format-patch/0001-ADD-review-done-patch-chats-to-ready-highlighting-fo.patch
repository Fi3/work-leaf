+    pub fn mark_agent_needs_decision(
+        &mut self,
+        agent_id: &str,
+        feature: &str,
+    ) -> Result<(), String> {
+        let agent_id = AgentId::new(agent_id).map_err(|error| error.to_string())?;
+        self.ui
+            .set_agent_feature(&agent_id, format!("{feature} DONE?"))?;
+        self.ui
+            .set_agent_patch_lifecycle_state(&agent_id, true, true, false)?;
+        self.transcript
+            .push("work-leaf: is this feature done? [yes/no]".to_string());
+        Ok(())
+    }
