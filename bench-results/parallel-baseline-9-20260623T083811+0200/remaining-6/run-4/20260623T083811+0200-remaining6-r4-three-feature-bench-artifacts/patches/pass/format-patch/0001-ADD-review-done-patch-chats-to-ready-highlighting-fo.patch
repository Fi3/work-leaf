+#[test]
+fn scripted_harness_highlights_review_done_chat_and_shows_question() {
+    let mut harness = UiHarness::new(120, 24);
+
+    assert!(!harness.render_frame().starts_with('\u{7}'));
+
+    harness
+        .mark_agent_needs_decision("user-1", "parser")
+        .expect("fixture user-1 agent is registered");
+
+    let frame = harness.render_frame();
+    assert!(frame.starts_with('\u{7}'));
+    assert!(frame.contains("work-leaf: is this feature done? [yes/no]"));
+    assert!(
+        harness
+            .ui()
+            .render_left_pane()
+            .contains("\u{1b}[7m>parser DONE? user-1  working: parser DONE?  READY\u{1b}[0m")
+    );
+    assert!(!harness.render_frame().starts_with('\u{7}'));
+}
