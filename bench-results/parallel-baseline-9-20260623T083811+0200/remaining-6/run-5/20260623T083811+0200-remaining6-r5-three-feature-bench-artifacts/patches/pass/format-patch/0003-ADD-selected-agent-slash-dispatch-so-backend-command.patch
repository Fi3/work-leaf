+    #[derive(Clone, Debug)]
+    struct BlockingCommandBackend {
+        state: Arc<(Mutex<BlockingCommandState>, Condvar)>,
+    }
+
+    #[derive(Debug, Default)]
+    struct BlockingCommandState {
+        command_started: bool,
+        release_command: bool,
+        commands: Vec<(AgentId, String)>,
+        sends: Vec<(AgentId, String)>,
+    }
+
+    impl BlockingCommandBackend {
+        fn new() -> Self {
+            Self {
+                state: Arc::new((Mutex::new(BlockingCommandState::default()), Condvar::new())),
+            }
+        }
+
+        fn wait_for_command_start(&self, timeout: Duration) -> bool {
+            let (lock, condvar) = &*self.state;
+            let state = lock.lock().unwrap();
+            let (state, _) = condvar
+                .wait_timeout_while(state, timeout, |state| !state.command_started)
+                .unwrap();
+            state.command_started
+        }
+
+        fn release_command(&self) {
+            let (lock, condvar) = &*self.state;
+            let mut state = lock.lock().unwrap();
+            state.release_command = true;
+            condvar.notify_all();
+        }
+
+        fn commands(&self) -> Vec<(AgentId, String)> {
+            self.state.0.lock().unwrap().commands.clone()
+        }
+
+        fn sends(&self) -> Vec<(AgentId, String)> {
+            self.state.0.lock().unwrap().sends.clone()
+        }
+    }
+
+    impl AgentBackend for BlockingCommandBackend {
+        fn launch(
+            &mut self,
+            request: AgentLaunch,
+        ) -> Result<AgentSession, crate::agent::AgentError> {
+            Ok(AgentSession::new(request))
+        }
+
+        fn send(
+            &mut self,
+            agent_id: &AgentId,
+            prompt: &str,
+        ) -> Result<ChatMessage, crate::agent::AgentError> {
+            self.state
+                .0
+                .lock()
+                .unwrap()
+                .sends
+                .push((agent_id.clone(), prompt.to_string()));
+            Ok(ChatMessage::new(MessageRole::Agent, "send output"))
+        }
+
+        fn command(
+            &mut self,
+            agent_id: &AgentId,
+            command: &str,
+        ) -> Result<ChatMessage, crate::agent::AgentError> {
+            let (lock, condvar) = &*self.state;
+            let mut state = lock.lock().unwrap();
+            state.commands.push((agent_id.clone(), command.to_string()));
+            state.command_started = true;
+            condvar.notify_all();
+            while !state.release_command {
+                state = condvar.wait(state).unwrap();
+            }
+            Ok(ChatMessage::new(MessageRole::Agent, "command output"))
+        }
+    }
