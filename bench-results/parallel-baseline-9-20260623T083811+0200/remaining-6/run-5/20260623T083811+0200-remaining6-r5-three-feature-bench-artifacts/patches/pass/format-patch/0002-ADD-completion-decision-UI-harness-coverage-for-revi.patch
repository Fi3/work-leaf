+#[test]
+fn scripted_harness_completion_decision_highlights_closes_and_reopens_patch_chat() {
+    let mut harness = UiHarness::new(100, 24);
+
+    harness
+        .mark_agent_needs_completion_decision("user-2", "tests")
+        .expect("fixture user-2 agent is registered");
+
+    let decision_frame = harness.render_frame();
+    assert!(decision_frame.starts_with('\u{7}'));
+    assert!(decision_frame.contains("work-leaf: is this feature done? [yes/no]"));
+    let decision_left_pane = harness.ui().render_left_pane();
+    assert!(decision_left_pane.contains("\u{1b}[7m"));
+    let decision_left_pane = strip_ansi(&decision_left_pane);
+    assert!(decision_left_pane.contains(">tests DONE? user-2"));
+    assert!(decision_left_pane.contains("tests DONE?  READY"));
+
+    assert!(harness.handle_bytes(b"yes\n"));
+
+    let closed_left_pane = strip_ansi(&harness.ui().render_left_pane());
+    assert!(closed_left_pane.contains("[closed]\n>tests CLOSED user-2"));
+    assert!(!closed_left_pane.contains("tests CLOSED  READY"));
+    assert!(
+        harness
+            .transcript()
+            .iter()
+            .any(|line| line == "work-leaf: feature marked closed")
+    );
+
+    assert!(harness.handle_bytes(b"add another tweak\n"));
+
+    let reopened_left_pane = strip_ansi(&harness.ui().render_left_pane());
+    assert!(reopened_left_pane.contains(">tests user-2"));
+    assert!(reopened_left_pane.contains("tests  READY"));
+    assert!(!reopened_left_pane.contains("tests CLOSED"));
+    assert!(
+        harness
+            .transcript()
+            .iter()
+            .any(|line| line == "user-2> add another tweak")
+    );
+}
+
+#[test]
+fn scripted_harness_completion_no_keeps_patch_chat_open_without_backend_chat() {
+    let mut harness = UiHarness::new(100, 24);
+
+    harness
+        .mark_agent_needs_completion_decision("user-2", "tests")
+        .expect("fixture user-2 agent is registered");
+
+    assert!(harness.handle_bytes(b"no\n"));
+
+    let left_pane = strip_ansi(&harness.ui().render_left_pane());
+    assert!(left_pane.contains(">tests user-2"));
+    assert!(left_pane.contains("tests  READY"));
+    assert!(!left_pane.contains("tests DONE?"));
+    assert!(!left_pane.contains("tests CLOSED"));
+    assert!(
+        harness
+            .transcript()
+            .iter()
+            .any(|line| line == "work-leaf: feature remains open")
+    );
+    assert!(
+        !harness
+            .transcript()
+            .iter()
+            .any(|line| line == "fixture reply: message recorded")
+    );
+}
