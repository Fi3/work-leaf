+    fn handle_completion_answer(&mut self, agent_id: &AgentId, message: &str) -> bool {
+        if self.completion_agents.get(agent_id) != Some(&HarnessCompletion::NeedsDecision) {
+            return false;
+        }
+
+        if message.eq_ignore_ascii_case("no") {
+            self.reopen_needs_decision_agent(agent_id);
+            self.transcript.push(format!("{agent_id}> {message}"));
+            self.transcript
+                .push("work-leaf: feature remains open".to_string());
+            return true;
+        }
+
+        if !message.eq_ignore_ascii_case("yes") {
+            return false;
+        }
+
+        let base_title = self
+            .agent_base_titles
+            .get(agent_id)
+            .cloned()
+            .unwrap_or_else(|| agent_id.as_str().to_string());
+        self.completion_agents
+            .insert(agent_id.clone(), HarnessCompletion::Closed);
+        let _ = self
+            .ui
+            .set_agent_feature(agent_id, format!("{base_title} CLOSED"));
+        let _ = self.ui.set_agent_patch_lifecycle(agent_id, true, true);
+        let _ = self.ui.set_agent_ready_state(agent_id, false);
+        self.transcript.push(format!("{agent_id}> {message}"));
+        self.transcript
+            .push("work-leaf: feature marked closed".to_string());
+        true
+    }
+
+    fn reopen_needs_decision_agent(&mut self, agent_id: &AgentId) {
+        self.completion_agents.remove(agent_id);
+        if let Some(base_title) = self.agent_base_titles.get(agent_id).cloned() {
+            let _ = self.ui.set_agent_feature(agent_id, base_title);
+        }
+        let _ = self.ui.set_agent_patch_lifecycle(agent_id, true, false);
+        let _ = self.ui.set_agent_ready_state(agent_id, true);
+    }
+
+    fn reopen_closed_agent(&mut self, agent_id: &AgentId) {
+        if self.completion_agents.get(agent_id) != Some(&HarnessCompletion::Closed) {
+            return;
+        }
+
+        self.reopen_needs_decision_agent(agent_id);
+    }
