 src/ui.rs            | 14 ++++++----
 tests/terminal_ui.rs | 21 ++++++++-------
 tests/ui_harness.rs  | 64 +++++++++++++++++++++++++++++++++++++++-----
 3 files changed, 78 insertions(+), 21 deletions(-)

