+#[test]
+fn scripted_harness_visual_character_mode_yanks_right_pane_selection() {
+    let mut harness = UiHarness::new(80, 24);
+
+    harness.handle_bytes(&[23, b'l']);
+    harness.handle_byte(b'v');
+
+    assert!(harness.ui().visual_selection_active());
+    assert!(
+        harness
+            .render_frame()
+            .contains("mode=visual-char focus=right")
+    );
+
+    harness.handle_bytes(b"lll");
+    harness.handle_byte(b'y');
+
+    assert_eq!(harness.ui().copied_text(), Some("Esc "));
+}
+
+#[test]
+fn scripted_harness_visual_line_mode_yanks_focused_left_pane_line() {
+    let mut harness = UiHarness::new(80, 24);
+
+    assert_eq!(harness.ui().focus(), PaneFocus::Left);
+
+    harness.handle_byte(b'V');
+    harness.handle_byte(b'Y');
+
+    let copied = harness
+        .ui()
+        .copied_text()
+        .expect("visual line yank copies left-pane text");
+    assert!(copied.starts_with('>'));
+    assert!(copied.contains("user-1"));
+    assert!(!copied.contains("work-leaf"));
+}
+
+#[test]
+fn scripted_harness_visual_block_mode_yanks_rectangular_right_pane_selection() {
+    let mut harness = UiHarness::new(80, 24);
+
+    harness.handle_bytes(&[23, b'l']);
+    harness.handle_byte(22);
+
+    assert!(
+        harness
+            .render_frame()
+            .contains("mode=visual-block focus=right")
+    );
+
+    harness.handle_byte(b'k');
+    harness.handle_byte(b'l');
+    harness.handle_byte(b'y');
+
+    assert_eq!(harness.ui().copied_text(), Some("UI\nEs"));
+}
+
+#[test]
+fn scripted_harness_visual_block_keeps_virtual_column_after_crossing_short_line() {
+    let mut harness = UiHarness::new(80, 24);
+
+    harness.handle_bytes(&[23, b'l']);
+    harness.handle_byte(22);
+    for _ in 0..15 {
+        harness.handle_byte(b'l');
+    }
+    harness.handle_byte(b'k');
+    harness.handle_byte(b'j');
+    harness.handle_byte(b'y');
+
+    assert_eq!(harness.ui().copied_text(), Some("Esc command, i i"));
+}
