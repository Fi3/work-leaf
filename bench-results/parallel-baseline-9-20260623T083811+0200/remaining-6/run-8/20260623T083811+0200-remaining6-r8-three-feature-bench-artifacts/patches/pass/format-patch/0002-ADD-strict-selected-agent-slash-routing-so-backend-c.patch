     }
 
+    fn command(&mut self, agent_id: &AgentId, command: &str) -> Result<ChatMessage, AgentError> {
+        if slash_command_name(command).0.is_none() {
+            return Err(AgentError::Io(std::io::Error::new(
+                std::io::ErrorKind::InvalidInput,
+                "backend command must start with `/` followed by a command token",
+            )));
+        }
+
+        let _operation_guard = self.acquire_agent_operation(agent_id);
+        let thread_id = {
+            let state = self
+                .state
+                .lock()
+                .expect("codex backend state mutex poisoned");
+            state
+                .thread_ids
+                .get(agent_id)
+                .cloned()
+                .ok_or_else(|| AgentError::UnknownSession(agent_id.clone()))?
+        };
+        let sandbox = self.sandbox_for_agent(agent_id);
+        let output =
+            self.app_server
+                .command(agent_id, command, &thread_id, &sandbox, &self.shutdown)?;
+        if !output.thread_id.is_empty() || output.usage.is_some() {
+            let mut state = self
+                .state
+                .lock()
+                .expect("codex backend state mutex poisoned");
+            if !output.thread_id.is_empty() {
+                state
+                    .thread_ids
+                    .insert(agent_id.clone(), output.thread_id.clone());
+            }
+            if let Some(usage) = output.usage {
+                record_usage(&mut state, agent_id, usage);
+            }
+        }
+        self.record_send_reply(agent_id, command, output.reply)
+    }
+
     fn shutdown_handle(&self) -> AgentShutdownHandle {
         self.shutdown.clone()
     }
