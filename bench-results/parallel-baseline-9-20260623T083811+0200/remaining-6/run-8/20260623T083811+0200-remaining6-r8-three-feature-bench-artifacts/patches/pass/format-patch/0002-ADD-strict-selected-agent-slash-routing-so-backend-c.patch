+    #[test]
+    fn selected_agent_status_slash_command_runs_immediately_while_agent_is_loading() {
+        let backend = ScriptedBackend::new(["busy backend status output"]);
+        let chat = CommandChat::new(PathBuf::from("/repo"), backend.clone());
+        let mut controller = WorkLeafController::new(chat);
+        let agent_id = AgentId::new("user-1").expect("test agent id is valid");
+
+        controller.register_agent_feature(agent_id.clone(), "busy slash status".to_string());
+        controller.add_session(WorkLeafSession {
+            id: agent_id.clone(),
+            kind: AgentKind::Codex,
+            title: "user-1".to_string(),
+            feature: "busy slash status".to_string(),
+            lines: Vec::new(),
+            loading: Some(WorkLeafLoading::WaitingForReply),
+            completion: None,
+            token_usage: None,
+            depends_on: Vec::new(),
+            depended_on_by: Vec::new(),
+        });
+
+        controller
+            .send_message(&agent_id, "/status")
+            .expect("slash command message is accepted");
+        assert!(controller.wait_for_session_line(
+            &agent_id,
+            "busy backend status output",
+            Duration::from_secs(1)
+        ));
+
+        assert_eq!(
+            backend.commands(),
+            vec![(agent_id.clone(), "/status".to_string())]
+        );
+        assert!(
+            backend.sends().is_empty(),
+            "/status must not reach the normal send path"
+        );
+        assert!(!controller.has_pending_agent_prompt(&agent_id));
+        let snapshot = controller.snapshot();
+        let session = snapshot.session(&agent_id).expect("agent session exists");
+        assert_eq!(session.loading, Some(WorkLeafLoading::WaitingForReply));
+        assert!(session.lines.iter().any(|line| line == "user: /status"));
+    }
+
