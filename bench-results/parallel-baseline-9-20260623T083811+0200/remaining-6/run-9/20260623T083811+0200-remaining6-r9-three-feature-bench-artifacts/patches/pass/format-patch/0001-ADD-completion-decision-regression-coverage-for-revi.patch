+    #[test]
+    fn feature_done_yes_closes_and_later_input_reopens_patch_chat() {
+        let backend = ScriptedBackend::new(["reopened reply", "reviewed feature"]);
+        let chat = CommandChat::new(PathBuf::from("/repo"), backend.clone());
+        let mut controller = WorkLeafController::new(chat);
+        let agent_id = AgentId::new("user-1").expect("test agent id is valid");
+        backend.insert_session(AgentLaunch::new(
+            agent_id.clone(),
+            AgentKind::Codex,
+            "reviewed feature",
+            "initial prompt",
+        ));
+
+        controller.register_agent_feature(agent_id.clone(), "reviewed feature".to_string());
+        controller.add_session(WorkLeafSession {
+            id: agent_id.clone(),
+            kind: AgentKind::Codex,
+            title: "reviewed feature".to_string(),
+            feature: "reviewed feature".to_string(),
+            lines: Vec::new(),
+            loading: None,
+            completion: None,
+            token_usage: None,
+            depends_on: Vec::new(),
+            depended_on_by: Vec::new(),
+        });
+        controller.ask_feature_done(&agent_id);
+
+        controller
+            .send_message(&agent_id, "yes")
+            .expect("completion answer is accepted");
+
+        let snapshot = controller.snapshot();
+        let session = snapshot
+            .session(&agent_id)
+            .expect("patch agent session exists");
+        assert_eq!(session.completion, Some(WorkLeafCompletion::Closed));
+        assert!(session.lines.iter().any(|line| line == "user: yes"));
+        assert!(
+            session
+                .lines
+                .iter()
+                .any(|line| line == FEATURE_CLOSED_MESSAGE)
+        );
+        assert!(
+            backend.sends().is_empty(),
+            "closing the feature should not send the yes answer to the agent backend"
+        );
+
+        controller
+            .send_message(&agent_id, "continue with another fix")
+            .expect("closed chat accepts a follow-up message");
+        assert!(controller.wait_for_idle(Duration::from_secs(1)));
+
+        assert_eq!(
+            backend.sends(),
+            vec![(agent_id.clone(), "continue with another fix".to_string())]
+        );
+        let snapshot = controller.snapshot();
+        let session = snapshot
+            .session(&agent_id)
+            .expect("patch agent session exists");
+        assert_eq!(session.completion, None);
+        assert_eq!(session.loading, None);
+        assert!(
+            session
+                .lines
+                .iter()
+                .any(|line| line == "user: continue with another fix")
+        );
+        assert!(
+            session.lines.iter().any(|line| line == "reopened reply"),
+            "{session:?}"
+        );
+    }
+
