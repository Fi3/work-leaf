                 VisualPoint { row, column: 0 }
             }
             PaneFocus::Right => {
@@ -1305,12 +1311,48 @@ impl TerminalUi {
                 } else {
                     self.right_visual_start_row(&lines)
                 };
-                self.set_right_visual_cursor_row(&visible_right_content, row);
+                self.set_right_visual_cursor_row_after_scroll(&visible_right_content, row);
