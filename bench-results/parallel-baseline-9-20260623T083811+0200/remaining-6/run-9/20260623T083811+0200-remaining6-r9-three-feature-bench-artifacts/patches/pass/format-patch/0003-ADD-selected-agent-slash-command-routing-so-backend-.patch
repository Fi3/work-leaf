 pub trait AgentBackend {
     fn launch(&mut self, request: AgentLaunch) -> Result<AgentSession, AgentError>;
     fn send(&mut self, agent_id: &AgentId, prompt: &str) -> Result<ChatMessage, AgentError>;
 
+    fn command(&mut self, _agent_id: &AgentId, command: &str) -> Result<ChatMessage, AgentError> {
+        let command_label = agent_backend_command_token(command)
+            .map(|token| format!("/{token}"))
+            .unwrap_or_else(|| command.trim().to_string());
+        let command_label = if command_label.is_empty() {
+            "command".to_string()
+        } else {
+            command_label
+        };
+        Ok(ChatMessage::new(
+            MessageRole::Agent,
+            format!(
+                "Backend command {command_label} is not supported by this agent provider; no model request was sent."
+            ),
+        ))
+    }
+
     /// Optional snapshot lookup for providers that keep local session metadata.
     ///
     /// Work Leaf does not require providers to override this method for persistent hidden
@@ -77,6 +94,19 @@ pub trait AgentBackend {
     }
 }
 
+pub(crate) fn is_agent_backend_command_message(message: &str) -> bool {
+    agent_backend_command_token(message).is_some()
+}
+
+fn agent_backend_command_token(message: &str) -> Option<&str> {
+    let rest = message.strip_prefix('/')?;
+    if rest.chars().next().is_none_or(char::is_whitespace) {
+        return None;
+    }
+    let (token, _) = rest.split_once(char::is_whitespace).unwrap_or((rest, ""));
+    Some(token)
+}
+
