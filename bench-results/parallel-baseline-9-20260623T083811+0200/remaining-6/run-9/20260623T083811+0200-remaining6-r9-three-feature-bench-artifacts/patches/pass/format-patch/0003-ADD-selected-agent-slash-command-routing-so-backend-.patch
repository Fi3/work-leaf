+    #[test]
+    fn selected_agent_slash_commands_use_backend_command_path() {
+        let backend = ScriptedBackend::new(["normal reply", "status output", "fork output"]);
+        let chat = CommandChat::new(PathBuf::from("/repo"), backend.clone());
+        let mut controller = WorkLeafController::new(chat);
+        let agent_id = AgentId::new("chat-commands").expect("test agent id is valid");
+
+        controller.register_agent_feature(agent_id.clone(), "command routing".to_string());
+        controller.add_session(WorkLeafSession {
+            id: agent_id.clone(),
+            kind: AgentKind::Codex,
+            title: "chat-commands".to_string(),
+            feature: "command routing".to_string(),
+            lines: Vec::new(),
+            loading: None,
+            completion: None,
+            token_usage: None,
+            depends_on: Vec::new(),
+            depended_on_by: Vec::new(),
+        });
+
+        controller
+            .send_message(&agent_id, "hello")
+            .expect("ordinary message is accepted");
+        assert!(controller.wait_for_idle(Duration::from_secs(1)));
+        controller
+            .send_message(&agent_id, "/status")
+            .expect("status command is accepted");
+        assert!(controller.wait_for_idle(Duration::from_secs(1)));
+        controller
+            .send_message(&agent_id, "/fork")
+            .expect("fork command is accepted");
+        assert!(controller.wait_for_idle(Duration::from_secs(1)));
+
+        assert_eq!(
