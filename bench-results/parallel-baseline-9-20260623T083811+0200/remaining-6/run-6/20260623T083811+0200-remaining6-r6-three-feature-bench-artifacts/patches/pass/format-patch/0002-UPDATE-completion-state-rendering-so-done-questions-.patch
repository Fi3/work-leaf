+function sessionDisplayTitle(session) {
+  const title = session.title || session.feature || idKey(session.id);
+  if (session.completion === "NeedsDecision") {
+    return `${title} DONE?`;
+  }
+  if (session.completion === "Closed") {
+    return `${title} CLOSED`;
+  }
+  return title;
+}
