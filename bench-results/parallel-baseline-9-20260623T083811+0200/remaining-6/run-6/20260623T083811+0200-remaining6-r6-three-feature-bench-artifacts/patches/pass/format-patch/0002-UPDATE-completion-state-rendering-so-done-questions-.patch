From 0e03c7895aac967e905fbd10161cc5add8bdaa8b Mon Sep 17 00:00:00 2001
From: fi3 <you@example.com>
Date: Tue, 23 Jun 2026 09:46:52 +0200
Subject: [PATCH 2/3] UPDATE completion-state rendering so done questions stay
 highlighted

Patch chats that need the user completion decision carry DONE? title text and ready styling, while closed chats carry CLOSED state without the ready highlight. Web rows and terminal harness fixtures both render from that completion state.
---
 src/ui_harness.rs   | 16 ++++++++++++++++
 tests/ui_harness.rs | 30 ++++++++++++++++++++++++++++++
 web-ui/app.js       | 28 +++++++++++++++++++++++-----
 web-ui/index.html   |  2 +-
 web-ui/styles.css   | 25 +++++++++++++++++++++++++
 5 files changed, 95 insertions(+), 6 deletions(-)

diff --git a/src/ui_harness.rs b/src/ui_harness.rs
index eb09368..7d81773 100644
--- a/src/ui_harness.rs
+++ b/src/ui_harness.rs
@@ -67,6 +67,22 @@ impl UiHarness {
         self.ui.set_agent_ready_state(&agent_id, true)
     }
 
+    pub fn mark_agent_needs_decision(&mut self, agent_id: &str) -> Result<(), String> {
+        let agent_id = AgentId::new(agent_id).map_err(|error| error.to_string())?;
+        self.ui
+            .set_agent_feature(&agent_id, "reviewed feature DONE?")?;
+        self.ui.set_agent_patch_lifecycle(&agent_id, true, false)?;
+        self.ui.set_agent_ready_state(&agent_id, true)
+    }
+
+    pub fn mark_agent_closed(&mut self, agent_id: &str) -> Result<(), String> {
+        let agent_id = AgentId::new(agent_id).map_err(|error| error.to_string())?;
+        self.ui
+            .set_agent_feature(&agent_id, "reviewed feature CLOSED")?;
+        self.ui.set_agent_patch_lifecycle(&agent_id, true, true)?;
+        self.ui.set_agent_ready_state(&agent_id, false)
+    }
+
     pub fn add_review_agent(
         &mut self,
         agent_id: &str,
diff --git a/tests/ui_harness.rs b/tests/ui_harness.rs
index dc613b8..80ecf0d 100644
--- a/tests/ui_harness.rs
+++ b/tests/ui_harness.rs
@@ -86,6 +86,36 @@ fn scripted_harness_rings_and_highlights_ready_chat() {
     assert!(!harness.render_frame().starts_with('\u{7}'));
 }
 
+#[test]
+fn scripted_harness_highlights_done_question_and_clears_closed_chat() {
+    let mut harness = UiHarness::new(100, 24);
+
+    harness
+        .mark_agent_needs_decision("user-2")
+        .expect("fixture user-2 agent is registered");
+
+    let decision_frame = harness.render_frame();
+    assert!(decision_frame.starts_with('\u{7}'));
+    let decision_left_pane = strip_ansi(&harness.ui().render_left_pane());
+    assert!(
+        decision_left_pane
+            .contains(" reviewed feature DONE? user-2  working: reviewed feature DONE?  READY")
+    );
+
+    harness
+        .mark_agent_closed("user-2")
+        .expect("fixture user-2 agent is registered");
+
+    assert!(!harness.render_frame().starts_with('\u{7}'));
+    let closed_left_pane = strip_ansi(&harness.ui().render_left_pane());
+    assert!(
+        closed_left_pane.contains(
+            "[closed]\n reviewed feature CLOSED user-2  working: reviewed feature CLOSED"
+        )
+    );
+    assert!(!closed_left_pane.contains("reviewed feature CLOSED  READY"));
+}
+
