+    #[test]
+    fn selected_agent_slash_commands_execute_backend_command_instead_of_send_prompt() {
+        let backend = ScriptedBackend::new([]);
+        let chat = CommandChat::new(PathBuf::from("/repo"), backend.clone());
+        let mut controller = WorkLeafController::new(chat);
+        let agent_id = AgentId::new("user-1").expect("test agent id is valid");
+
+        controller.register_agent_feature(agent_id.clone(), "user-agent".to_string());
+        controller.add_session(WorkLeafSession {
+            id: agent_id.clone(),
+            kind: AgentKind::Codex,
+            title: "user-1".to_string(),
+            feature: "user-agent".to_string(),
+            lines: Vec::new(),
+            loading: None,
+            completion: None,
+            token_usage: None,
+            depends_on: Vec::new(),
+            depended_on_by: Vec::new(),
+        });
+
+        controller
+            .send_message(&agent_id, "/status")
+            .expect("slash status message is accepted");
+        assert!(controller.wait_for_idle(Duration::from_secs(2)));
+        controller
+            .send_message(&agent_id, "/fork")
+            .expect("slash fork message is accepted");
+        assert!(controller.wait_for_idle(Duration::from_secs(2)));
+
+        assert_eq!(
+            backend.commands(),
+            vec![
+                (agent_id.clone(), "/status".to_string()),
+                (agent_id.clone(), "/fork".to_string()),
+            ]
+        );
+        assert!(
+            backend
+                .sends()
+                .iter()
+                .all(|(_, prompt)| prompt != "/status"),
+            "/status must not be delivered through the ordinary backend send path"
+        );
+
+        let snapshot = controller.snapshot();
+        let session = snapshot
+            .session(&agent_id)
+            .expect("selected agent session exists");
+        assert!(session.lines.iter().any(|line| line == "user: /status"));
+        assert!(
+            session
+                .lines
+                .iter()
+                .any(|line| line == "backend command output: /status")
+        );
+        assert!(session.lines.iter().any(|line| line == "user: /fork"));
+        assert!(
+            session
+                .lines
+                .iter()
+                .any(|line| line == "backend command output: /fork")
+        );
+    }
