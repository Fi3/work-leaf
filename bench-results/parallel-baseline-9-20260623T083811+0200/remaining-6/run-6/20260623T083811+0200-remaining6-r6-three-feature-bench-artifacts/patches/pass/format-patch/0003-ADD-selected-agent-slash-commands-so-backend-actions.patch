 src/agent_runtime.rs  | 28 ++++++++++++-
 src/cli.rs            | 38 ++++++++++++++++-
 src/codex.rs          | 70 +++++++++++++++++++++++++------
 src/workspace.rs      | 96 ++++++++++++++++++++++++++++++++++++++++++-
 tests/terminal_app.rs | 37 ++++++++++++++---
 tests/workspace.rs    | 56 +++++++++++++++++++++----
 7 files changed, 300 insertions(+), 29 deletions(-)

