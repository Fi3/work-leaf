#!/usr/bin/env bash
set -euo pipefail

if [[ "$#" != 3 ]]; then
  echo "usage: $0 ATTEMPT_ID CONDITION BATCH_ID" >&2
  exit 2
fi

attempt_id="$1"
condition="$2"
batch_id="$3"
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source_repo="${WORK_LEAF_CORRECTED_CONTROL_SOURCE_REPO:-/home/user/.codex/work-leaf-corrected-control-source-20260829T091341Z}"
runtime_root="${WORK_LEAF_CORRECTED_CONTROL_RUNTIME_DIR:-/home/user/.codex/work-leaf-corrected-control-runtime-20260829T091341Z}"
bin_dir="$script_dir/infrastructure/bin"
observer_bin="$bin_dir/bench-observer"
study_id="efficiency-corrected-all-disabled-20260829T091341Z"
expected_commit="72a9e507f57daf20a54bab5dcd6fe8f13f083d30"
timeout_seconds=7200

schedule_matches="$(awk -F '\t' -v batch="$batch_id" -v attempt="$attempt_id" -v condition="$condition" \
  'NR > 1 && $1 == batch && $2 == attempt && $3 == condition {count++} END {print count + 0}' \
  "$script_dir/SCHEDULE.tsv")"
[[ "$schedule_matches" == "1" ]] || {
  echo "error: attempt is not uniquely declared in the schedule: $batch_id $attempt_id $condition" >&2
  exit 2
}
[[ -x "$bin_dir/work-leaf" && -x "$bin_dir/work-leaf-orchestrator" \
  && -x "$observer_bin" ]] || {
  echo "error: frozen study binaries are missing" >&2
  exit 2
}
[[ "$(git -C "$source_repo" rev-parse HEAD)" == "$expected_commit" \
  && -z "$(git -C "$source_repo" status --short)" ]] || {
  echo "error: isolated study source does not match the frozen commit" >&2
  exit 1
}

case "$condition" in
  direct)
    workflow="direct-sequential"
    changed="n/a"
    unchanged="n/a"
    review="n/a"
    changed_env="n/a"
    unchanged_env="n/a"
    review_env="n/a"
    ;;
  normal)
    workflow="work-leaf-concurrent"
    changed="diff"
    unchanged="digest"
    review="inline-exact"
    changed_env="normal"
    unchanged_env="normal"
    review_env="inline-exact"
    ;;
  corrected-all-disabled)
    workflow="work-leaf-concurrent"
    changed="full"
    unchanged="full"
    review="git-reconstruct-marker-first"
    changed_env="full"
    unchanged_env="full"
    review_env="git-reconstruct"
    ;;
  *)
    echo "error: unsupported condition: $condition" >&2
    exit 2
    ;;
esac

results_dir="$script_dir/runs/$attempt_id"
log_path="$script_dir/logs/$attempt_id.log"
status_path="$script_dir/logs/$attempt_id.exit"
run_id="corrected-study-$attempt_id"
[[ ! -e "$results_dir" && ! -e "$log_path" && ! -e "$status_path" ]] || {
  echo "error: attempt already has preserved state: $attempt_id" >&2
  exit 2
}
mkdir -p "$results_dir" "$script_dir/logs" "$runtime_root/$attempt_id"

python3 - "$results_dir/admission.json" "$attempt_id" "$condition" "$workflow" \
  "$batch_id" "$changed" "$unchanged" "$review" <<'PY'
import json
import os
import sys
from pathlib import Path

output, attempt, condition, workflow, batch, changed, unchanged, review = sys.argv[1:]
payload = {
    "schema_version": 1,
    "attempt_id": attempt,
    "condition": condition,
    "workflow": workflow,
    "launch_batch": int(batch),
    "analytical_pair": False,
    "model": "gpt-5.5",
    "reasoning_effort": "xhigh",
    "changed_reread": changed,
    "unchanged_reread": unchanged,
    "review_context": review,
    "retry": False,
}
temporary = Path(output + ".tmp")
temporary.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n")
os.replace(temporary, output)
PY

set +e
if [[ "$workflow" == "direct-sequential" ]]; then
  env -u WORK_LEAF_EXPERIMENT_CHANGED_REPEAT_DELIVERY \
    -u WORK_LEAF_EXPERIMENT_UNCHANGED_REPEAT_DELIVERY \
    -u WORK_LEAF_EXPERIMENT_REVIEW_PROVENANCE \
    WORK_LEAF_DIRECT_BENCH_MODEL=gpt-5.5 \
    WORK_LEAF_DIRECT_BENCH_REASONING_EFFORT=xhigh \
    WORK_LEAF_DIRECT_BENCH_TMPDIR="$runtime_root/$attempt_id" \
    WORK_LEAF_DIRECT_BENCH_RESULTS_DIR="$results_dir" \
    WORK_LEAF_DIRECT_BENCH_SKIP_BUILD=1 \
    WORK_LEAF_DIRECT_BENCH_BIN_DIR="$bin_dir" \
    WORK_LEAF_DIRECT_BENCH_TIMEOUT_SECS="$timeout_seconds" \
    WORK_LEAF_BENCH_OBSERVER_BIN="$observer_bin" \
    WORK_LEAF_BENCH_STUDY_ID="$study_id" \
    WORK_LEAF_BENCH_PAIR_ID="unpaired-$attempt_id" \
    WORK_LEAF_DIRECT_BENCH_RUN_ID="$run_id" \
    "$source_repo/bench-three-features-sequential" >"$log_path" 2>&1
  status=$?
else
  env \
    WORK_LEAF_EXPERIMENT_CHANGED_REPEAT_DELIVERY="$changed_env" \
    WORK_LEAF_EXPERIMENT_UNCHANGED_REPEAT_DELIVERY="$unchanged_env" \
    WORK_LEAF_EXPERIMENT_REVIEW_PROVENANCE="$review_env" \
    WORK_LEAF_BENCH_MODEL=gpt-5.5 \
    WORK_LEAF_BENCH_REASONING_EFFORT=xhigh \
    WORK_LEAF_BENCH_TMPDIR="$runtime_root/$attempt_id" \
    WORK_LEAF_BENCH_RESULTS_DIR="$results_dir" \
    WORK_LEAF_BENCH_SKIP_BUILD=1 \
    WORK_LEAF_BENCH_BIN_DIR="$bin_dir" \
    WORK_LEAF_BENCH_TIMEOUT_SECS="$timeout_seconds" \
    WORK_LEAF_BENCH_NO_READ_PERMISSION=0 \
    WORK_LEAF_BENCH_WEB_UI=0 \
    WORK_LEAF_BENCH_DISABLE_TMUX_SUPERVISOR=1 \
    WORK_LEAF_BENCH_OBSERVER_BIN="$observer_bin" \
    WORK_LEAF_BENCH_STUDY_ID="$study_id" \
    WORK_LEAF_BENCH_PAIR_ID="unpaired-$attempt_id" \
    WORK_LEAF_BENCH_RUN_ID="$run_id" \
    "$source_repo/bench-three-features" >"$log_path" 2>&1
  status=$?
fi
set -e

printf '%s\n' "$status" >"$status_path"
exit "$status"
