+fn wrapped_rows(content: &str, width: u16) -> Vec<String> {
+    let width = usize::from(width.max(1));
+    let mut rows = Vec::new();
+    for line in content.split('\n') {
+        if line.is_empty() {
+            rows.push(String::new());
+            continue;
+        }
+        let chars = line.chars().collect::<Vec<_>>();
+        for chunk in chars.chunks(width) {
+            rows.push(chunk.iter().collect());
+        }
+    }
+    if rows.is_empty() {
+        rows.push(String::new());
+    }
+    rows
+}
+
+fn selection_ranges(
+    rows: &[String],
+    selection: VisualSelection,
+    force_linewise: bool,
+    line_fill_width: Option<u16>,
+) -> Vec<(usize, usize, usize)> {
+    if rows.is_empty() {
+        return Vec::new();
+    }
+    let kind = if force_linewise {
+        VisualSelectionKind::Line
+    } else {
+        selection.kind
+    };
+    let anchor = clamp_point(selection.anchor, rows);
+    let cursor = clamp_point(selection.cursor, rows);
+    let min_row = anchor.row.min(cursor.row);
+    let max_row = anchor.row.max(cursor.row);
+    match kind {
+        VisualSelectionKind::Line => (min_row..=max_row)
+            .map(|row| {
+                let end = line_fill_width
+                    .map(usize::from)
+                    .unwrap_or_else(|| rows[row].chars().count());
+                (row, 0, end)
+            })
+            .collect(),
+        VisualSelectionKind::Block => {
+            let min_column = anchor.column.min(cursor.column);
+            let max_column = anchor.column.max(cursor.column).saturating_add(1);
+            (min_row..=max_row)
+                .map(|row| (row, min_column, max_column))
+                .collect()
+        }
+        VisualSelectionKind::Character => {
+            let (start, end) = ordered_points(anchor, cursor);
+            (start.row..=end.row)
+                .map(|row| {
+                    let line_len = rows[row].chars().count();
+                    let (start_column, end_column) = if start.row == end.row {
+                        (
+                            start.column.min(line_len),
+                            end.column.saturating_add(1).min(line_len),
+                        )
+                    } else if row == start.row {
+                        (start.column.min(line_len), line_len)
+                    } else if row == end.row {
+                        (0, end.column.saturating_add(1).min(line_len))
+                    } else {
+                        (0, line_len)
+                    };
+                    (row, start_column, end_column)
+                })
+                .collect()
+        }
+    }
+}
+
+fn selected_text(rows: &[String], selection: VisualSelection, force_linewise: bool) -> String {
+    selection_ranges(rows, selection, force_linewise, None)
+        .into_iter()
+        .map(|(row, start, end)| char_slice(&rows[row], start, end))
+        .collect::<Vec<_>>()
+        .join("\n")
+}
+
+fn clamp_point(point: SelectionPoint, rows: &[String]) -> SelectionPoint {
+    let row = point.row.min(rows.len().saturating_sub(1));
+    let column = point
+        .column
+        .min(rows[row].chars().count().saturating_sub(1));
+    SelectionPoint { row, column }
+}
+
+fn ordered_points(left: SelectionPoint, right: SelectionPoint) -> (SelectionPoint, SelectionPoint) {
+    if (left.row, left.column) <= (right.row, right.column) {
+        (left, right)
+    } else {
+        (right, left)
+    }
+}
+
+fn char_slice(text: &str, start: usize, end: usize) -> String {
+    text.chars()
+        .skip(start)
+        .take(end.saturating_sub(start))
+        .collect()
+}
+
+fn add_signed(value: usize, delta: isize) -> usize {
+    if delta.is_negative() {
+        value.saturating_sub(delta.unsigned_abs())
+    } else {
+        value.saturating_add(delta as usize)
+    }
+}
+
+fn osc52_sequence(text: &str) -> String {
+    format!("\u{1b}]52;c;{}\u{7}", base64_encode(text.as_bytes()))
+}
+
+fn base64_encode(bytes: &[u8]) -> String {
+    const TABLE: &[u8; 64] = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    let mut encoded = String::new();
+    for chunk in bytes.chunks(3) {
+        let first = chunk[0];
+        let second = chunk.get(1).copied().unwrap_or(0);
+        let third = chunk.get(2).copied().unwrap_or(0);
+        encoded.push(TABLE[usize::from(first >> 2)] as char);
+        encoded.push(TABLE[usize::from(((first & 0b0000_0011) << 4) | (second >> 4))] as char);
+        if chunk.len() > 1 {
+            encoded.push(TABLE[usize::from(((second & 0b0000_1111) << 2) | (third >> 6))] as char);
+        } else {
+            encoded.push('=');
+        }
+        if chunk.len() > 2 {
+            encoded.push(TABLE[usize::from(third & 0b0011_1111)] as char);
+        } else {
+            encoded.push('=');
+        }
+    }
+    encoded
+}
