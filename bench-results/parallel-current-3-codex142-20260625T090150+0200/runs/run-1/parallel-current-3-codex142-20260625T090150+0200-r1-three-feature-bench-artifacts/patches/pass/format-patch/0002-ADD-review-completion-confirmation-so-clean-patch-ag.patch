+#[test]
+fn terminal_app_review_completion_prompts_patch_chat_and_yes_closes_until_typing_reopens() {
+    let root = git_repo("terminal-app-review-completion-prompt");
+    fs::write(root.join("README.md"), "before\n").unwrap();
+    Command::new("git")
+        .current_dir(&root)
+        .args(["add", "README.md"])
+        .status()
+        .unwrap();
+    Command::new("git")
+        .current_dir(&root)
+        .args(["commit", "-m", "ADD initial readme fixture"])
+        .status()
+        .unwrap();
+
+    let backend = FakeBackend::new([
+        "implemented patch\n@work-leaf patch update readme\n--- a/README.md\n+++ b/README.md\n@@ -1 +1 @@\n-before\n+after\n@work-leaf end\n@work-leaf done",
+        "summary: README changes from before to after",
+        "NO_FINDINGS",
+        "implemented follow-up\n@work-leaf patch update readme again\n--- a/README.md\n+++ b/README.md\n@@ -1 +1 @@\n-after\n+after again\n@work-leaf end\n@work-leaf done",
+        "summary: README changes from after to after again",
+        "NO_FINDINGS",
+    ]);
+    let chat = CommandChat::new(root, backend.clone()).with_max_review_rounds(4);
+    let mut app = TerminalApp::new(chat, 100, 50);
+
+    app.handle_bytes(b":new update readme\n");
+
+    assert!(app.wait_for_idle(Duration::from_secs(2)));
+    assert_eq!(
+        app.ui().selected_agent().map(AgentId::as_str),
+        Some("user-1")
+    );
+    assert!(
+        app.render_frame()
+            .contains("work-leaf: is this feature done? yes/no")
+    );
+    assert!(
+        app.ui()
+            .render_left_pane()
+            .lines()
+            .any(|line| { line.contains(" user-1  ") && line.contains("READY") })
+    );
+
+    app.handle_bytes(b"yes\n");
+
+    assert!(
+        !app.ui()
+            .render_left_pane()
+            .lines()
+            .any(|line| line.contains(" user-1  "))
+    );
+    assert!(
+        backend
+            .sends()
+            .iter()
+            .all(|(_target, prompt)| prompt != "yes")
+    );
+
+    app.handle_bytes(b"make another change\n");
+
+    assert!(app.wait_for_idle(Duration::from_secs(2)));
+    assert!(
+        app.ui()
+            .render_left_pane()
+            .lines()
+            .any(|line| { line.contains(" user-1  ") && line.contains("READY") })
+    );
+    assert!(backend.sends().iter().any(|(target, prompt)| {
+        target.as_str() == "user-1" && prompt == "make another change"
+    }));
+    assert_eq!(
+        app.render_frame()
+            .matches("work-leaf: is this feature done? yes/no")
+            .count(),
+        2
+    );
+}
