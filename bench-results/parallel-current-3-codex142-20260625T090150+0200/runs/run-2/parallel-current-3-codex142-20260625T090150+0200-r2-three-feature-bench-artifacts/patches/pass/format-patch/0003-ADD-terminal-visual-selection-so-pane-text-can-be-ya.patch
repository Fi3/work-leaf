+    fn visual_start_position(&self, pane: PaneFocus, text: &PaneText) -> TextPosition {
+        let position = match pane {
+            PaneFocus::Left => TextPosition {
+                row: self.left_selected_text_row(),
+                column: 0,
+            },
+            PaneFocus::Right => {
+                let row = text.lines.len().saturating_sub(1);
+                let column = text
+                    .lines
+                    .get(row)
+                    .map(|line| line.chars().count())
+                    .unwrap_or(0)
+                    .min(text.width.saturating_sub(1));
+                TextPosition { row, column }
+            }
+        };
+        clamp_text_position(position, text)
+    }
+
+    fn left_selected_text_row(&self) -> usize {
+        if self.control_selected == 0 {
+            return 0;
+        }
+
+        let mut row = 1;
+        for (visible_position, agent_index) in self.visible_agent_indices().iter().enumerate() {
+            if self.control_selected == visible_position + 1 {
+                return row;
+            }
+
+            row += 1;
+            let agent = &self.agents[*agent_index];
+            if !agent.modified_files.is_empty() {
+                row += 1;
+            }
+            for linked_agents in [
+                &agent.conflicting_agents,
+                &agent.depends_on,
+                &agent.depended_on_by,
+            ] {
+                if !linked_agents.is_empty() {
+                    row += 1;
+                }
+            }
+        }
+
+        0
+    }
