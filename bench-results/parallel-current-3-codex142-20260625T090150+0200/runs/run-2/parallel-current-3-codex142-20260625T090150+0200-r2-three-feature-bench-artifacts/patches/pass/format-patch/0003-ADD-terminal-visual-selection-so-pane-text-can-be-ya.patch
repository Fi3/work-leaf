+
+fn selection_row_ranges(
+    selection: &VisualSelection,
+    text: &PaneText,
+    force_linewise: bool,
+) -> Vec<(usize, usize, usize)> {
+    let anchor = clamp_text_position(selection.anchor, text);
+    let cursor = clamp_text_position(selection.cursor, text);
+    let start_row = anchor.row.min(cursor.row);
+    let end_row = anchor.row.max(cursor.row);
+    let width = text.width.max(1);
+
+    if force_linewise || selection.mode == VisualMode::Line {
+        return (start_row..=end_row).map(|row| (row, 0, width)).collect();
+    }
+
+    if selection.mode == VisualMode::Block {
+        let start_column = anchor.column.min(cursor.column);
+        let end_column = anchor.column.max(cursor.column).saturating_add(1);
+        return (start_row..=end_row)
+            .map(|row| (row, start_column, end_column))
+            .collect();
+    }
+
+    if anchor.row == cursor.row {
+        let start_column = anchor.column.min(cursor.column);
+        let end_column = anchor.column.max(cursor.column).saturating_add(1);
+        return vec![(anchor.row, start_column, end_column)];
+    }
+
+    let (first, last) = if (anchor.row, anchor.column) <= (cursor.row, cursor.column) {
+        (anchor, cursor)
+    } else {
+        (cursor, anchor)
+    };
+    let mut ranges = Vec::new();
+    ranges.push((first.row, first.column, width));
+    for row in first.row.saturating_add(1)..last.row {
+        ranges.push((row, 0, width));
+    }
+    ranges.push((last.row, 0, last.column.saturating_add(1)));
