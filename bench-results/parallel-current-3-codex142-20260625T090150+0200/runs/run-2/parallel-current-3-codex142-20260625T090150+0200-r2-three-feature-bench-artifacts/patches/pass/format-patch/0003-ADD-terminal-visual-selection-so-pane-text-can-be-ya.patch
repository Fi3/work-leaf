+    fn pane_inner_size(&self, pane: PaneFocus) -> (u16, u16) {
+        let layout = self.layout();
+        let body_height = self.height.saturating_sub(1);
+        let inner_height = body_height.saturating_sub(2).max(1);
+        let pane_width = match pane {
+            PaneFocus::Left if self.left_visible => layout.left_width,
+            PaneFocus::Left => 0,
+            PaneFocus::Right => layout.right_width,
+        };
+        (pane_width.saturating_sub(2).max(1), inner_height)
+    }
+
+    fn pane_inner_rect(&self, pane: PaneFocus) -> Option<(u16, u16, u16, u16)> {
+        let layout = self.layout();
+        let pane_width = match pane {
+            PaneFocus::Left if self.left_visible => layout.left_width,
+            PaneFocus::Left => return None,
+            PaneFocus::Right => layout.right_width,
+        };
+        let x = match pane {
+            PaneFocus::Left => 1,
+            PaneFocus::Right => layout.left_width.saturating_add(1),
+        };
+        let body_height = self.height.saturating_sub(1);
+        Some((
+            x,
+            1,
+            pane_width.saturating_sub(2).max(1),
