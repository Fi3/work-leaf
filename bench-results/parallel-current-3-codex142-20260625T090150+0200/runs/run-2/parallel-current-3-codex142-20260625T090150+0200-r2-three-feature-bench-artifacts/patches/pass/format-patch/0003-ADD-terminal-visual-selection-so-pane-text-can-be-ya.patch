+        let text = self.pane_text(selection_snapshot.pane, right_content);
+        if let Some(selection) = self.visual_selection.as_mut() {
+            let row_count = text.lines.len().max(1) as isize;
+            let width = text.width.max(1) as isize;
+            let next_row = (selection.cursor.row as isize + row_delta).clamp(0, row_count - 1);
+            let next_column = if selection.mode == VisualMode::Line {
+                0
+            } else {
+                (selection.cursor.column as isize + column_delta).clamp(0, width - 1)
+            };
+            selection.cursor = TextPosition {
+                row: next_row as usize,
+                column: next_column as usize,
+            };
+        }
+    }
