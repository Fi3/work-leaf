+    fn handle_visual_key(&mut self, key: UiKey, right_content: &str) -> Vec<UiAction> {
+        match key {
+            UiKey::Esc => {
+                self.visual_selection = None;
+            }
+            UiKey::Char('v') => self.set_visual_mode(VisualMode::Character, right_content),
+            UiKey::Char('V') => self.set_visual_mode(VisualMode::Line, right_content),
+            UiKey::Char(ch) if ch == CTRL_V_CHAR => {
+                self.set_visual_mode(VisualMode::Block, right_content);
+            }
+            UiKey::Char('h') | UiKey::Left => self.move_visual_cursor(0, -1, right_content),
+            UiKey::Char('j') | UiKey::Down => self.move_visual_cursor(1, 0, right_content),
+            UiKey::Char('k') | UiKey::Up => self.move_visual_cursor(-1, 0, right_content),
+            UiKey::Char('l') | UiKey::Right => self.move_visual_cursor(0, 1, right_content),
+            UiKey::Char('y') => self.copy_visual_selection(false, right_content),
+            UiKey::Char('Y') => self.copy_visual_selection(true, right_content),
+            _ => {}
+        }
+        Vec::new()
+    }
+
+    fn start_visual_selection(&mut self, mode: VisualMode, right_content: &str) {
+        let pane = self.focus;
+        let text = self.pane_text(pane, right_content);
+        let mut position = self.visual_start_position(pane, &text);
+        if mode == VisualMode::Line {
+            position.column = 0;
+        }
+        self.visual_selection = Some(VisualSelection {
+            pane,
+            mode,
+            anchor: position,
+            cursor: position,
+        });
+    }
+
+    fn set_visual_mode(&mut self, mode: VisualMode, right_content: &str) {
+        let Some(pane) = self
+            .visual_selection
+            .as_ref()
+            .map(|selection| selection.pane)
+        else {
+            self.start_visual_selection(mode, right_content);
+            return;
+        };
+        let text = self.pane_text(pane, right_content);
+        if let Some(selection) = self.visual_selection.as_mut() {
+            selection.mode = mode;
+            if mode == VisualMode::Line {
+                selection.anchor.column = 0;
+                selection.cursor.column = 0;
+            }
+            selection.anchor = clamp_text_position(selection.anchor, &text);
+            selection.cursor = clamp_text_position(selection.cursor, &text);
+        }
+    }
+
+    fn move_visual_cursor(&mut self, row_delta: isize, column_delta: isize, right_content: &str) {
+        let Some(selection_snapshot) = self.visual_selection.clone() else {
+            return;
