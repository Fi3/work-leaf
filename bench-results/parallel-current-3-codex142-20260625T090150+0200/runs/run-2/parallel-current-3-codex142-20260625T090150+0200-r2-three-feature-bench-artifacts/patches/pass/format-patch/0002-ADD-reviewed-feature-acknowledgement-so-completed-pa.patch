+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+enum FeatureDoneState {
+    None,
+    Pending,
+    Closed,
+}
+
+fn feature_done_state(lines: &[String]) -> FeatureDoneState {
+    let mut state = FeatureDoneState::None;
+    for line in lines {
+        if line.starts_with(FEATURE_DONE_PROMPT) {
+            state = FeatureDoneState::Pending;
+        } else if line == FEATURE_MARKED_DONE {
+            state = FeatureDoneState::Closed;
+        } else if line.starts_with("user: ") {
+            state = FeatureDoneState::None;
+        }
+    }
+    state
+}
+
+fn should_deduplicate_cached_agent_line(line: &str) -> bool {
+    !line.starts_with(FEATURE_DONE_PROMPT) && line != FEATURE_MARKED_DONE
+}
