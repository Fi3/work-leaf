         Ok(message)
     }
+
+    fn run_command_streaming(
+        &mut self,
+        agent_id: &AgentId,
+        command: &str,
+        sink: &mut dyn FnMut(AgentStreamEvent),
+    ) -> Result<ChatMessage, AgentError> {
+        let mut state = self
+            .state
+            .lock()
+            .expect("codex backend state mutex poisoned");
+        let reply = codex_backend_command_reply(&state, agent_id, command)?;
+        sink(AgentStreamEvent::AgentMessage(reply.clone()));
+        let message = ChatMessage::new(MessageRole::Agent, reply);
+        let session = state
+            .sessions
+            .get_mut(agent_id)
+            .ok_or_else(|| AgentError::UnknownSession(agent_id.clone()))?;
+        session.push_message(MessageRole::User, command);
+        session.messages.push(message.clone());
+        Ok(message)
+    }
+}
+
+fn codex_backend_command_reply(
+    state: &CodexBackendState,
+    agent_id: &AgentId,
+    command: &str,
+) -> Result<String, AgentError> {
+    let session = state
+        .sessions
+        .get(agent_id)
+        .ok_or_else(|| AgentError::UnknownSession(agent_id.clone()))?;
+    let thread_id = state
+        .thread_ids
+        .get(agent_id)
+        .map(String::as_str)
+        .unwrap_or("unrecorded");
+    let token = command.split_whitespace().next().unwrap_or(command);
+    match token {
+        "/status" => {
+            let state_text = if state.active_processes.contains_key(agent_id) {
+                "running"
+            } else {
+                "ready"
+            };
+            Ok(format!(
+                "Codex backend status\nagent: {agent_id}\nfeature: {}\nsession: {thread_id}\nstate: {state_text}",
+                session.feature
+            ))
+        }
+        "/fork" => {
+            let request = command.strip_prefix("/fork").unwrap_or("").trim();
+            let request = if request.is_empty() {
+                "current session"
+            } else {
+                request
+            };
+            Ok(format!(
+                "Codex backend fork\nagent: {agent_id}\nsource session: {thread_id}\nrequest: {request}\nresult: fork is not supported by the non-interactive Codex backend"
+            ))
+        }
+        other => Err(AgentError::Io(std::io::Error::other(format!(
+            "unsupported Codex backend command: {other}"
+        )))),
+    }
 }
 
