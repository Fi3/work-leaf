+    use std::time::Duration;
+
+    use super::*;
+    use crate::agent::{AgentError, AgentProfile, AgentSession, ChatMessage, MessageRole};
+
+    #[test]
+    fn selected_agent_status_slash_command_uses_backend_command_not_send_prompt() {
+        let backend = RecordingBackend::default();
+        let calls = backend.calls.clone();
+        let agent_id = AgentId::new("user-1").expect("test agent id is valid");
+        let mut controller = controller_with_session(backend, agent_id.clone());
+
+        controller
+            .send_message(&agent_id, "/status")
+            .expect("slash command is accepted");
+        assert!(controller.wait_for_idle(Duration::from_secs(1)));
+
+        let calls = calls
+            .lock()
+            .expect("recording backend calls mutex poisoned");
+        assert_eq!(calls.commands, vec!["/status".to_string()]);
+        assert!(
+            calls.sends.is_empty(),
+            "/status must not reach the normal backend send path"
+        );
+        drop(calls);
+
+        let snapshot = controller.snapshot();
+        let session = snapshot
+            .session(&agent_id)
+            .expect("test session remains present");
+        assert!(session.lines.iter().any(|line| line == "user: /status"));
+        assert!(
+            session
+                .lines
+                .iter()
+                .any(|line| line == "backend command output: /status")
+        );
+    }
+
+    #[test]
+    fn selected_agent_fork_slash_command_appends_backend_command_output() {
+        let backend = RecordingBackend::default();
+        let calls = backend.calls.clone();
+        let agent_id = AgentId::new("user-1").expect("test agent id is valid");
+        let mut controller = controller_with_session(backend, agent_id.clone());
+
+        controller
+            .send_message(&agent_id, "/fork")
+            .expect("slash command is accepted");
+        assert!(controller.wait_for_idle(Duration::from_secs(1)));
+
+        let calls = calls
+            .lock()
+            .expect("recording backend calls mutex poisoned");
+        assert_eq!(calls.commands, vec!["/fork".to_string()]);
+        drop(calls);
+
+        let snapshot = controller.snapshot();
+        let session = snapshot
+            .session(&agent_id)
+            .expect("test session remains present");
+        assert!(session.lines.iter().any(|line| line == "user: /fork"));
+        assert!(
+            session
+                .lines
+                .iter()
+                .any(|line| line == "backend command output: /fork")
+        );
+    }
+
+    #[test]
+    fn selected_agent_backend_command_requires_non_whitespace_token() {
+        assert_eq!(selected_agent_backend_command("/status"), Some("/status"));
+        assert_eq!(
+            selected_agent_backend_command("/fork target"),
+            Some("/fork target")
+        );
+        assert_eq!(selected_agent_backend_command("/"), None);
+        assert_eq!(selected_agent_backend_command("/ status"), None);
+        assert_eq!(selected_agent_backend_command("status"), None);
+    }
+
+    fn controller_with_session(
+        backend: RecordingBackend,
+        agent_id: AgentId,
+    ) -> WorkLeafController<RecordingBackend> {
+        let mut chat =
+            CommandChat::new(PathBuf::from("."), backend).with_agent_profile(AgentProfile::new(
+                AgentKind::External("recording".to_string()),
+                "Recording",
+                "user-agent",
+            ));
+        chat.register_agent_feature(agent_id.clone(), "user-agent".to_string());
+        let mut controller = WorkLeafController::new(chat);
+        controller.add_session(WorkLeafSession {
+            id: agent_id,
+            kind: AgentKind::External("recording".to_string()),
+            title: "user-agent".to_string(),
+            feature: "user-agent".to_string(),
+            lines: Vec::new(),
+            loading: None,
+        });
+        controller
+    }
+
+    #[derive(Clone, Default)]
+    struct RecordingBackend {
+        calls: Arc<Mutex<RecordingBackendCalls>>,
+    }
+
+    #[derive(Default)]
+    struct RecordingBackendCalls {
+        sends: Vec<String>,
+        commands: Vec<String>,
+    }
+
+    impl AgentBackend for RecordingBackend {
+        fn launch(&mut self, request: AgentLaunch) -> Result<AgentSession, AgentError> {
+            Ok(AgentSession::new(request))
+        }
+
+        fn send(&mut self, _agent_id: &AgentId, prompt: &str) -> Result<ChatMessage, AgentError> {
+            self.calls
+                .lock()
+                .expect("recording backend calls mutex poisoned")
+                .sends
+                .push(prompt.to_string());
+            Ok(ChatMessage::new(
+                MessageRole::Agent,
+                format!("send output: {prompt}"),
+            ))
+        }
+
+        fn run_command(
+            &mut self,
+            _agent_id: &AgentId,
+            command: &str,
+        ) -> Result<ChatMessage, AgentError> {
+            self.calls
+                .lock()
+                .expect("recording backend calls mutex poisoned")
+                .commands
+                .push(command.to_string());
+            Ok(ChatMessage::new(
+                MessageRole::Agent,
+                format!("backend command output: {command}"),
+            ))
+        }
+    }
