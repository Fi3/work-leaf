+    fn handle_feature_done_answer(&mut self, agent_id: &AgentId, message: &str) -> bool {
+        if !self.feature_done_prompt_agents.contains(agent_id)
+            && !self.closed_feature_agents.contains(agent_id)
+        {
+            return false;
+        }
+
+        match message.to_ascii_lowercase().as_str() {
+            "yes" | "y" => {
+                self.feature_done_prompt_agents.remove(agent_id);
+                self.closed_feature_agents.insert(agent_id.clone());
+                self.last_closed_feature_agent = Some(agent_id.clone());
+                let _ = self.ui.hide_agent(agent_id);
+                true
+            }
+            "no" | "n" => {
+                self.feature_done_prompt_agents.remove(agent_id);
+                self.reopen_feature_agent(agent_id);
+                true
+            }
+            _ => {
+                self.feature_done_prompt_agents.remove(agent_id);
+                self.reopen_feature_agent(agent_id);
+                false
+            }
+        }
+    }
+
+    fn reopen_feature_agent(&mut self, agent_id: &AgentId) {
+        self.closed_feature_agents.remove(agent_id);
+        if self
+            .last_closed_feature_agent
+            .as_ref()
+            .is_some_and(|closed| closed == agent_id)
+        {
+            self.last_closed_feature_agent = None;
+        }
+        let _ = self.ui.show_agent(agent_id);
+    }
+
+    fn reopen_closed_feature_agent_for_message(&mut self) -> Option<AgentId> {
