+#[test]
+fn terminal_app_review_done_prompt_yes_closes_and_follow_up_reopens_patch_chat() {
+    let root = git_repo("terminal-app-review-done-prompt");
+    fs::write(root.join("README.md"), "before\n").unwrap();
+    git(&root, ["add", "README.md"]);
+    git(&root, ["commit", "-m", "ADD initial readme fixture"]);
+    let backend = SlowPromptBackend::new(
+        [
+            "implemented patch\n@work-leaf patch update readme\n--- a/README.md\n+++ b/README.md\n@@ -1 +1 @@\n-before\n+after\n@work-leaf end\n@work-leaf done",
+            "summary: README changes from before to after",
+            "NO_FINDINGS",
+            "follow-up reply",
+        ],
+        "actually keep going",
+    );
+    let chat = CommandChat::new(root, backend.clone()).with_max_review_rounds(4);
+    let mut app = TerminalApp::new(chat, 100, 24);
+
+    app.handle_bytes(b":new update readme\n");
+    assert!(app.wait_for_idle(Duration::from_secs(2)));
+
+    assert_eq!(
+        app.ui().selected_agent().map(AgentId::as_str),
+        Some("user-1")
+    );
+    assert!(
+        app.render_frame()
+            .contains("work-leaf: Is this feature done? yes/no")
+    );
+    assert!(app.ui().render_left_pane().contains("user-1  working"));
+    assert!(app.ui().render_left_pane().contains("READY"));
+
+    app.handle_bytes(b"yes\n");
+
+    assert!(
+        !app.ui().render_left_pane().contains("user-1  working"),
+        "{}",
+        app.ui().render_left_pane()
+    );
+    assert_eq!(app.ui().selected_agent().map(AgentId::as_str), None);
+    assert!(
+        backend
+            .sends()
+            .iter()
+            .all(|(_, prompt)| prompt.as_str() != "yes")
+    );
+
+    app.handle_bytes(b"actually keep going\n");
+    assert_eq!(
+        app.ui().selected_agent().map(AgentId::as_str),
+        Some("user-1")
+    );
+    assert!(app.is_busy());
+    assert!(
+        !app.ui()
+            .render_left_pane()
+            .contains("chat-title user-1  working: chat-title  READY"),
+        "{}",
+        app.ui().render_left_pane()
+    );
+    assert!(app.wait_for_idle(Duration::from_secs(1)));
+
+    assert!(app.ui().render_left_pane().contains("user-1  working"));
+    let frame = app.render_frame();
+    assert!(frame.contains("user: actually keep going"));
+    assert!(frame.contains("follow-up reply"));
+    assert!(backend.sends().iter().any(|(target, prompt)| {
+        target.as_str() == "user-1" && prompt == "actually keep going"
+    }));
+}
