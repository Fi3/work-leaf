+    fn begin_visual_selection(
+        &mut self,
+        kind: UiVisualMode,
+        right_content: &str,
+        right_cursor_column: Option<usize>,
+    ) {
+        let cursor = self.focus_cursor_position(right_content, right_cursor_column);
+        self.mode = UiMode::Visual(kind);
+        self.visual_selection = Some(VisualSelection {
+            focus: self.focus,
+            anchor: cursor,
+            cursor,
+        });
+    }
+
+    fn handle_visual_key(
+        &mut self,
+        key: UiKey,
+        right_content: &str,
+        right_cursor_column: Option<usize>,
+    ) -> Vec<UiAction> {
+        match key {
+            UiKey::Esc => {
+                self.mode = UiMode::Command;
+                self.clear_visual_selection();
+                Vec::new()
+            }
+            UiKey::Char('v') => {
+                self.set_visual_mode(UiVisualMode::Character, right_content, right_cursor_column);
+                Vec::new()
+            }
+            UiKey::Char('V') => {
+                self.set_visual_mode(UiVisualMode::Line, right_content, right_cursor_column);
+                Vec::new()
+            }
+            UiKey::CtrlV => {
+                self.set_visual_mode(UiVisualMode::Block, right_content, right_cursor_column);
+                Vec::new()
+            }
+            UiKey::Char('y') => self.copy_visual_selection(right_content, None),
+            UiKey::Char('Y') => self.copy_visual_selection(right_content, Some(UiVisualMode::Line)),
+            UiKey::Char('h') | UiKey::Left => {
+                self.move_visual_cursor(0, -1, right_content);
+                Vec::new()
+            }
+            UiKey::Char('j') | UiKey::Down => {
+                self.move_visual_cursor(1, 0, right_content);
+                Vec::new()
+            }
+            UiKey::Char('k') | UiKey::Up => {
+                self.move_visual_cursor(-1, 0, right_content);
+                Vec::new()
+            }
+            UiKey::Char('l') | UiKey::Right => {
+                self.move_visual_cursor(0, 1, right_content);
+                Vec::new()
+            }
+            _ => Vec::new(),
+        }
+    }
+
+    fn set_visual_mode(
+        &mut self,
+        kind: UiVisualMode,
+        right_content: &str,
+        right_cursor_column: Option<usize>,
+    ) {
+        if self.visual_selection.is_none() {
+            self.begin_visual_selection(kind, right_content, right_cursor_column);
+        } else {
+            self.mode = UiMode::Visual(kind);
+        }
+    }
+
+    fn move_visual_cursor(&mut self, line_delta: isize, column_delta: isize, right_content: &str) {
+        let Some(selection) = self.visual_selection else {
+            return;
+        };
+        let lines = self.visual_lines(selection.focus, right_content);
+        let next = TextPosition {
+            line: selection.line_with_delta(line_delta),
+            column: selection.column_with_delta(column_delta),
+        };
+        let next = clamp_text_position(next, &lines);
+        if let Some(selection) = self.visual_selection.as_mut() {
+            selection.cursor = next;
+        }
+    }
+
+    fn copy_visual_selection(
+        &mut self,
+        right_content: &str,
+        override_mode: Option<UiVisualMode>,
+    ) -> Vec<UiAction> {
+        let Some(selection) = self.visual_selection else {
+            return Vec::new();
+        };
+        let kind = override_mode.unwrap_or(match self.mode {
+            UiMode::Visual(kind) => kind,
+            UiMode::Command | UiMode::Insert | UiMode::Prompt => UiVisualMode::Character,
+        });
+        let lines = self.visual_lines(selection.focus, right_content);
+        let text = selected_text(&lines, selection, kind);
+        self.clipboard_text = Some(text.clone());
+        self.pending_clipboard_text.replace(Some(text.clone()));
+        self.mode = UiMode::Command;
+        self.clear_visual_selection();
+        vec![UiAction::CopySelection(text)]
+    }
+
+    fn clear_visual_selection(&mut self) {
+        self.visual_selection = None;
+    }
+
+    fn focus_cursor_position(
+        &self,
+        right_content: &str,
+        right_cursor_column: Option<usize>,
+    ) -> TextPosition {
+        let lines = self.visual_lines(self.focus, right_content);
+        let position = match self.focus {
+            PaneFocus::Left => TextPosition {
