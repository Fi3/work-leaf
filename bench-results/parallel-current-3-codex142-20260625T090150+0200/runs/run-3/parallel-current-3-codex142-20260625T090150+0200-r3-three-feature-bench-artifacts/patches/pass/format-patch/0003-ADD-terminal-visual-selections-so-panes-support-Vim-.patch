+
+fn selection_line_range(
+    selection: VisualSelection,
+    kind: UiVisualMode,
+    line_index: usize,
+    line_len: usize,
+) -> Option<(usize, usize)> {
+    let (start, end) = ordered_positions(selection.anchor, selection.cursor);
+    if line_index < start.line || line_index > end.line {
+        return None;
+    }
+    match kind {
+        UiVisualMode::Line => Some((0, line_len)),
+        UiVisualMode::Character if start.line == end.line => Some((
+            start.column.min(line_len),
+            end.column.saturating_add(1).min(line_len),
+        )),
+        UiVisualMode::Character if line_index == start.line => {
+            Some((start.column.min(line_len), line_len))
+        }
+        UiVisualMode::Character if line_index == end.line => {
+            Some((0, end.column.saturating_add(1).min(line_len)))
+        }
+        UiVisualMode::Character => Some((0, line_len)),
+        UiVisualMode::Block => {
+            let start_column = selection.anchor.column.min(selection.cursor.column);
+            let end_column = selection.anchor.column.max(selection.cursor.column);
+            Some((
+                start_column.min(line_len),
+                end_column.saturating_add(1).min(line_len),
+            ))
+        }
+    }
+}
+
+fn ordered_positions(left: TextPosition, right: TextPosition) -> (TextPosition, TextPosition) {
+    if (left.line, left.column) <= (right.line, right.column) {
+        (left, right)
+    } else {
+        (right, left)
+    }
+}
+
+fn styled_spans(text: &str, start: usize, end: usize) -> Vec<Span<'static>> {
+    let char_count = text.chars().count();
+    let start = start.min(char_count);
+    let end = end.min(char_count);
+    if start >= end {
+        return vec![Span::raw(text.to_string())];
+    }
+    let before = char_slice(text, 0, start);
+    let selected = char_slice(text, start, end);
+    let after = char_slice(text, end, char_count);
+    let mut spans = Vec::new();
+    if !before.is_empty() {
+        spans.push(Span::raw(before));
+    }
+    spans.push(Span::styled(
+        selected,
+        Style::default().add_modifier(Modifier::REVERSED),
+    ));
+    if !after.is_empty() {
+        spans.push(Span::raw(after));
+    }
+    spans
+}
+
+fn char_slice(text: &str, start: usize, end: usize) -> String {
+    text.chars()
+        .skip(start)
+        .take(end.saturating_sub(start))
+        .collect()
+}
