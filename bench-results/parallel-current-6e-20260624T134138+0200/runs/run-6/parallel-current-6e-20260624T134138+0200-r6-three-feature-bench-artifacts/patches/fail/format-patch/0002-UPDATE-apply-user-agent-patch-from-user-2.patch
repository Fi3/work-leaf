+#[test]
+fn selected_agent_status_slash_command_uses_backend_command_not_send_prompt() {
+    let backend = FakeBackend::new(["agent ready", "status output"]);
+    let mut chat = CommandChat::new(PathBuf::from("/repo"), backend);
+    let launched = chat.handle_line("new inspect status").unwrap();
+    let CommandChatResult::AgentLaunched { agent_id, .. } = launched else {
+        panic!("expected launched agent");
+    };
+
+    let result = chat.send_to_agent(&agent_id, "/status").unwrap();
+
+    assert_eq!(
+        result,
+        CommandChatResult::AgentMessage {
+            agent_id: agent_id.clone(),
+            reply: "status output".to_string(),
+        }
+    );
+    let backend = chat.into_backend();
+    assert!(backend.sends.is_empty());
+    assert_eq!(backend.commands, vec![(agent_id, "/status".to_string())]);
+}
+
+#[test]
+fn selected_agent_fork_slash_command_uses_backend_command() {
+    let backend = FakeBackend::new(["agent ready", "fork output"]);
+    let mut chat = CommandChat::new(PathBuf::from("/repo"), backend);
+    let launched = chat.handle_line("new inspect fork").unwrap();
+    let CommandChatResult::AgentLaunched { agent_id, .. } = launched else {
+        panic!("expected launched agent");
+    };
+
+    let result = chat.send_to_agent(&agent_id, "/fork user-2").unwrap();
+
+    assert_eq!(
+        result,
+        CommandChatResult::AgentMessage {
+            agent_id: agent_id.clone(),
+            reply: "fork output".to_string(),
+        }
+    );
+    let backend = chat.into_backend();
+    assert!(backend.sends.is_empty());
+    assert_eq!(backend.commands, vec![(agent_id, "/fork user-2".to_string())]);
+}
