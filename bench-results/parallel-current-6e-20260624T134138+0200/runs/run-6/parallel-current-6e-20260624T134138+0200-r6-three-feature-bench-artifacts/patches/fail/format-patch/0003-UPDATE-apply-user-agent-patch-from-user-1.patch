+    fn start_visual_selection(
+        &mut self,
+        kind: VisualSelectionKind,
+        right_content: &str,
+        right_cursor_column: Option<usize>,
+    ) {
+        self.pending = None;
+        self.mode = UiMode::Command;
+        let pane = if self.focus == PaneFocus::Left && self.left_visible {
+            PaneFocus::Left
+        } else {
+            PaneFocus::Right
+        };
+        let (lines, position) = match pane {
+            PaneFocus::Left => {
+                let lines = self.left_visual_lines();
+                let row = self.control_selection_visual_row();
+                (lines, TextPosition { row, column: 0 })
+            }
+            PaneFocus::Right => {
+                let visible = self.visible_right_content(right_content);
+                let lines = content_lines(&visible);
+                let row = lines.len().saturating_sub(1);
+                let column = lines
+                    .get(row)
+                    .map(|line| {
+                        let line_len = line_char_count(line);
+                        right_cursor_column
+                            .unwrap_or(line_len)
+                            .min(line_len.saturating_sub(1))
+                    })
+                    .unwrap_or(0);
+                (lines, TextPosition { row, column })
+            }
+        };
+        let lines = if lines.is_empty() {
+            vec![String::new()]
+        } else {
+            lines
+        };
+        let position = clamp_text_position(position, &lines);
+        self.visual_selection = Some(VisualSelection {
+            pane,
+            kind,
+            anchor: position,
+            cursor: position,
+            lines,
+        });
+    }
+
+    fn copy_visual_selection(&mut self, linewise: bool) -> Option<String> {
+        let text = self
+            .visual_selection
+            .as_ref()
+            .map(|selection| selection.selected_text(linewise))?;
+        self.visual_selection = None;
+        self.clipboard_text = Some(text.clone());
+        self.pending_clipboard_text.replace(Some(text.clone()));
+        self.show_status_notice(
+            "selection copied",
+            Duration::from_secs(STATUS_NOTICE_SECONDS),
+        );
+        Some(text)
+    }
+
+    fn clear_visual_selection(&mut self) {
+        self.visual_selection = None;
+    }
+
+    fn move_visual_cursor(&mut self, row_delta: isize, column_delta: isize) {
+        let Some(selection) = self.visual_selection.as_mut() else {
+            return;
+        };
+        let max_row = selection.lines.len().saturating_sub(1);
+        let row = if row_delta < 0 {
+            selection.cursor.row.saturating_sub(row_delta.unsigned_abs())
+        } else {
+            selection
+                .cursor
+                .row
+                .saturating_add(row_delta as usize)
+                .min(max_row)
+        };
+        let line_len = selection
+            .lines
+            .get(row)
+            .map(|line| line_char_count(line))
+            .unwrap_or(0);
+        let max_column = line_len.saturating_sub(1);
+        let column = if column_delta < 0 {
+            selection.cursor.column.saturating_sub(column_delta.unsigned_abs())
+        } else {
+            selection
+                .cursor
+                .column
+                .saturating_add(column_delta as usize)
+        }
+        .min(max_column);
+        selection.cursor = TextPosition {
+            row,
+            column,
+        };
+    }
+
+    fn left_visual_lines(&self) -> Vec<String> {
