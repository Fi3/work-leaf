+fn reverse_buffer_cell(buffer: &mut Buffer, x: u16, y: u16) {
+    if x < buffer.area.width && y < buffer.area.height {
+        buffer.get_mut(x, y).modifier.insert(Modifier::REVERSED);
+    }
+}
+
+fn style_wrapped_range(
+    buffer: &mut Buffer,
+    origin_x: u16,
+    origin_y: u16,
+    width: u16,
+    height: u16,
+    visual_row: usize,
+    start: usize,
+    end: usize,
+) {
+    let width = usize::from(width.max(1));
+    for column in start..=end {
+        let row_offset = visual_row.saturating_add(column / width);
+        if row_offset >= usize::from(height) {
+            break;
+        }
+        let x = origin_x.saturating_add((column % width) as u16);
+        let y = origin_y.saturating_add(row_offset as u16);
+        reverse_buffer_cell(buffer, x, y);
+    }
+}
