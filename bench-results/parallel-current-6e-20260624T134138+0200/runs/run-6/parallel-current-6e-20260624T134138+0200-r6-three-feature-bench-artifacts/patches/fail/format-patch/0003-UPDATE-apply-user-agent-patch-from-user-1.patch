+fn line_char_count(line: &str) -> usize {
+    line.chars().count()
+}
+
+fn char_slice_inclusive(line: &str, start: usize, end: usize) -> String {
+    let len = line_char_count(line);
+    let start = start.min(len);
+    let end_exclusive = end.saturating_add(1).min(len);
+    if start >= end_exclusive {
+        return String::new();
+    }
+    line.chars()
+        .skip(start)
+        .take(end_exclusive - start)
+        .collect()
+}
+
+fn clamp_text_position(position: TextPosition, lines: &[String]) -> TextPosition {
+    let row = position.row.min(lines.len().saturating_sub(1));
+    let column = lines
+        .get(row)
+        .map(|line| position.column.min(line_char_count(line).saturating_sub(1)))
+        .unwrap_or(0);
+    TextPosition { row, column }
+}
