+    fn apply_visual_selection_to_buffer(&self, buffer: &mut Buffer) {
+        let Some(selection) = &self.visual_selection else {
+            return;
+        };
+        let layout = self.layout();
+        let body_height = self.height.saturating_sub(1);
+        let inner_height = body_height.saturating_sub(2);
+        if inner_height == 0 {
+            return;
+        }
+
+        match selection.pane {
+            PaneFocus::Left if self.left_visible => {
+                let inner_width = layout.left_width.saturating_sub(2).max(1);
+                let max_column = usize::from(inner_width.saturating_sub(1));
+                for (row, start, end) in selection.row_ranges(false) {
+                    if row >= usize::from(inner_height) {
+                        continue;
+                    }
+                    let start = start.min(max_column);
+                    let end = end.min(max_column);
+                    for column in start..=end {
+                        reverse_buffer_cell(buffer, column as u16 + 1, row as u16 + 1);
+                    }
+                }
+            }
+            PaneFocus::Right => {
+                let inner_width = layout.right_width.saturating_sub(2).max(1);
+                let origin_x = if self.left_visible {
+                    layout.left_width.saturating_add(1)
+                } else {
+                    1
+                };
+                let mut ranges = selection.row_ranges(false).into_iter().peekable();
+                let mut visual_row = 0_usize;
+                for (line_index, line) in selection.lines.iter().enumerate() {
+                    while matches!(ranges.peek(), Some((row, _, _)) if *row == line_index) {
+                        let (_, start, end) = ranges.next().expect("range is present");
+                        style_wrapped_range(
+                            buffer,
+                            origin_x,
+                            1,
+                            inner_width,
+                            inner_height,
+                            visual_row,
+                            start,
+                            end,
+                        );
+                    }
+                    visual_row =
+                        visual_row.saturating_add(visual_row_count(line, inner_width));
+                }
+            }
+            PaneFocus::Left => {}
+        }
+    }
