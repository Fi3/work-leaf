+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+enum VisualSelectionKind {
+    Character,
+    Line,
+    Block,
+}
+
+impl VisualSelectionKind {
+    fn mode_label(self) -> &'static str {
+        match self {
+            Self::Character => "visual",
+            Self::Line => "visual-line",
+            Self::Block => "visual-block",
+        }
+    }
+}
+
+#[derive(Clone, Copy, Debug, Eq, Ord, PartialEq, PartialOrd)]
+struct TextPosition {
+    row: usize,
+    column: usize,
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+struct VisualSelection {
+    pane: PaneFocus,
+    kind: VisualSelectionKind,
+    anchor: TextPosition,
+    cursor: TextPosition,
+    lines: Vec<String>,
+}
+
+impl VisualSelection {
+    fn selected_text(&self, linewise: bool) -> String {
+        if self.lines.is_empty() {
+            return String::new();
+        }
+
+        let mut selected = Vec::new();
+        match (linewise, self.kind) {
+            (true, _) | (_, VisualSelectionKind::Line) => {
+                let (start, end) = self.row_bounds();
+                for row in start..=end {
+                    if let Some(line) = self.lines.get(row) {
+                        selected.push(line.clone());
+                    }
+                }
+            }
+            (_, VisualSelectionKind::Block) => {
+                let (start_row, end_row) = self.row_bounds();
+                let start_column = self.anchor.column.min(self.cursor.column);
+                let end_column = self.anchor.column.max(self.cursor.column);
+                for row in start_row..=end_row {
+                    if let Some(line) = self.lines.get(row) {
+                        selected.push(char_slice_inclusive(line, start_column, end_column));
+                    }
+                }
+            }
+            (_, VisualSelectionKind::Character) => {
+                let (start, end) = self.ordered_positions();
+                for row in start.row..=end.row {
+                    let Some(line) = self.lines.get(row) else {
+                        continue;
+                    };
+                    let text = if start.row == end.row {
+                        char_slice_inclusive(line, start.column, end.column)
+                    } else if row == start.row {
+                        let last = line_char_count(line).saturating_sub(1);
+                        char_slice_inclusive(line, start.column, last)
+                    } else if row == end.row {
+                        char_slice_inclusive(line, 0, end.column)
+                    } else {
+                        line.clone()
+                    };
+                    selected.push(text);
+                }
+            }
+        }
+        selected.join("\n")
+    }
+
+    fn row_ranges(&self, linewise: bool) -> Vec<(usize, usize, usize)> {
+        if self.lines.is_empty() {
+            return Vec::new();
+        }
+
+        let mut ranges = Vec::new();
+        match (linewise, self.kind) {
+            (true, _) | (_, VisualSelectionKind::Line) => {
+                let (start, end) = self.row_bounds();
+                for row in start..=end {
+                    let end_column = self
+                        .lines
+                        .get(row)
+                        .map(|line| line_char_count(line).saturating_sub(1))
+                        .unwrap_or(0);
+                    ranges.push((row, 0, end_column));
+                }
+            }
+            (_, VisualSelectionKind::Block) => {
+                let (start_row, end_row) = self.row_bounds();
+                let start_column = self.anchor.column.min(self.cursor.column);
+                let end_column = self.anchor.column.max(self.cursor.column);
+                for row in start_row..=end_row {
+                    ranges.push((row, start_column, end_column));
+                }
+            }
+            (_, VisualSelectionKind::Character) => {
+                let (start, end) = self.ordered_positions();
+                for row in start.row..=end.row {
+                    let end_column = self
+                        .lines
+                        .get(row)
+                        .map(|line| line_char_count(line).saturating_sub(1))
+                        .unwrap_or(0);
+                    if start.row == end.row {
+                        ranges.push((row, start.column, end.column));
+                    } else if row == start.row {
+                        ranges.push((row, start.column, end_column));
+                    } else if row == end.row {
+                        ranges.push((row, 0, end.column));
+                    } else {
+                        ranges.push((row, 0, end_column));
+                    }
+                }
+            }
+        }
+        ranges
+    }
+
+    fn row_bounds(&self) -> (usize, usize) {
+        (
+            self.anchor.row.min(self.cursor.row),
+            self.anchor.row.max(self.cursor.row),
+        )
+    }
+
+    fn ordered_positions(&self) -> (TextPosition, TextPosition) {
+        if self.anchor <= self.cursor {
+            (self.anchor, self.cursor)
+        } else {
+            (self.cursor, self.anchor)
+        }
+    }
+}
