+    fn visual_cursor_position(&self) -> Option<(u16, u16)> {
+        let selection = self.visual_selection.as_ref()?;
+        let layout = self.layout();
+        match selection.pane {
+            PaneFocus::Left if self.left_visible => Some((
+                selection.cursor.row.saturating_add(2).min(usize::from(u16::MAX)) as u16,
+                selection
+                    .cursor
+                    .column
+                    .saturating_add(2)
+                    .min(usize::from(u16::MAX)) as u16,
+            )),
+            PaneFocus::Right => {
+                let inner_width = layout.right_width.saturating_sub(2).max(1);
+                let previous_rows = selection
+                    .lines
+                    .iter()
+                    .take(selection.cursor.row)
+                    .map(|line| visual_row_count(line, inner_width))
+                    .sum::<usize>();
+                let row = 2_usize
+                    .saturating_add(previous_rows)
+                    .saturating_add(selection.cursor.column / usize::from(inner_width));
+                let column = usize::from(layout.left_width)
+                    .saturating_add(2)
+                    .saturating_add(selection.cursor.column % usize::from(inner_width));
+                Some((
+                    row.min(usize::from(u16::MAX)) as u16,
+                    column.min(usize::from(u16::MAX)) as u16,
+                ))
+            }
+            PaneFocus::Left => None,
+        }
+    }
