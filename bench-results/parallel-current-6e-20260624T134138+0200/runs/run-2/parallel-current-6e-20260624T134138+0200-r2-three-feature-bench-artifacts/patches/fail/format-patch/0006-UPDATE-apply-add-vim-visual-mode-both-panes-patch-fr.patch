+#[test]
+fn scripted_harness_bytewise_visual_arrow_keys_keep_selection_active() {
+    let mut harness = UiHarness::new(80, 24);
+
+    harness.handle_bytes(&[23, b'l']);
+    harness.handle_byte(b'V');
+    harness.handle_byte(27);
+    harness.handle_byte(b'[');
+    harness.handle_byte(b'A');
+    harness.handle_byte(b'y');
+
+    assert_eq!(
+        harness.clipboard_text(),
+        Some("Esc command, i insert, : prompt, Ctrl-W h/j/k/l focus, , toggle right, q quit\nchat> ")
+    );
+}
