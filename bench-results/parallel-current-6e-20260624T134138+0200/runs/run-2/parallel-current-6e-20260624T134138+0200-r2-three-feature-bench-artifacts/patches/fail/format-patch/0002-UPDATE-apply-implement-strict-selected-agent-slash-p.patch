+#[test]
+fn controller_routes_leading_whitespace_slash_text_through_normal_send_path() {
+    let backend = FakeBackend::new(["launch reply", "ordinary prompt reply"]);
+    let chat = CommandChat::new(PathBuf::from("/repo"), backend.clone());
+    let mut controller = WorkLeafController::new(chat);
+
+    let agent_id = controller.create_agent("inspect prompts").unwrap();
+    assert!(controller.wait_for_idle(Duration::from_secs(1)));
+
+    controller.send_message(&agent_id, " /status").unwrap();
+    assert!(controller.wait_for_idle(Duration::from_secs(1)));
+
+    let sends = backend.sends();
+    assert_eq!(sends.len(), 1);
+    assert_eq!(sends[0].0.as_str(), agent_id.as_str());
+    assert_eq!(sends[0].1, "/status");
+    assert!(
+        backend.commands().is_empty(),
+        "leading whitespace means the message does not start with a slash command"
+    );
+
+    let snapshot = controller.snapshot();
+    let session = snapshot.session(&agent_id).expect("session exists");
+    assert!(
+        session
+            .lines
+            .iter()
+            .any(|line| line == "ordinary prompt reply")
+    );
+}
