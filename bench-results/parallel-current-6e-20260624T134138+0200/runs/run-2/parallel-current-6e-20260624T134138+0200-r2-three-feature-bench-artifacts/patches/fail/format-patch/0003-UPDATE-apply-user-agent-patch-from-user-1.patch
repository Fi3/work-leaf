+    fn begin_visual_selection_kind(
+        &mut self,
+        kind: VisualSelectionKind,
+        right_content: &str,
+        right_cursor_column: Option<usize>,
+    ) {
+        if self.mode != UiMode::Command {
+            return;
+        }
+        self.pending = None;
+        let position = self.visual_start_position(right_content, right_cursor_column);
+        self.visual_selection = Some(VisualSelection {
+            focus: self.focus,
+            kind,
+            anchor: position,
+            cursor: position,
+        });
+    }
+
+    fn visual_start_position(
+        &self,
+        right_content: &str,
+        right_cursor_column: Option<usize>,
+    ) -> VisualPosition {
+        match self.focus {
+            PaneFocus::Left => VisualPosition {
+                row: self.left_visual_start_row(),
+                column: 0,
+            },
+            PaneFocus::Right => {
+                let visible = self.visible_right_content(right_content);
+                let lines = content_lines(&visible);
+                let row = lines.len().saturating_sub(1);
+                let line_len = lines
+                    .get(row)
+                    .map(|line| line.chars().count())
+                    .unwrap_or_default();
+                let last_column = line_len.saturating_sub(1);
+                VisualPosition {
+                    row,
+                    column: right_cursor_column.unwrap_or(last_column).min(last_column),
+                }
+            }
+        }
+    }
+
+    fn left_visual_start_row(&self) -> usize {
+        if self.control_selected == 0 {
+            return 0;
+        }
+
+        let mut row = 1;
+        for (visible_position, agent_index) in self.visible_agent_indices().iter().enumerate() {
+            if self.control_selected == visible_position + 1 {
+                return row;
+            }
+            row += 1;
+
+            let agent = &self.agents[*agent_index];
+            if !agent.modified_files.is_empty() {
+                row += 1;
+            }
+            for linked_agents in [
+                &agent.conflicting_agents,
+                &agent.depends_on,
+                &agent.depended_on_by,
+            ] {
+                if !linked_agents.is_empty() {
+                    row += 1;
+                }
+            }
+        }
+
+        0
+    }
