+
+fn spans_from_ranges(line: &str, ranges: Vec<(usize, usize)>) -> Spans<'static> {
+    if ranges.is_empty() {
+        return Spans::from(vec![Span::raw(line.to_string())]);
+    }
+
+    let mut spans = Vec::new();
+    let mut column = 0;
+    let line_len = line.chars().count();
+    for (start, end) in ranges {
+        let start = start.min(line_len);
+        let end = end.min(line_len);
+        if column < start {
+            spans.push(Span::raw(slice_line_chars(line, column, start)));
+        }
+        if start < end {
+            spans.push(Span::styled(
+                slice_line_chars(line, start, end),
+                Style::default().add_modifier(Modifier::REVERSED),
+            ));
+        }
+        column = end;
+    }
+    if column < line_len {
+        spans.push(Span::raw(slice_line_chars(line, column, line_len)));
+    }
+    Spans::from(spans)
+}
+
+fn visual_ranges_for_line(
+    selection: VisualSelection,
+    row: usize,
+    lines: &[String],
+) -> Vec<(usize, usize)> {
+    if lines.is_empty() {
+        return Vec::new();
+    }
+
+    if selection.kind == VisualSelectionKind::Block {
+        let start_row = clamped_visual_row(selection.anchor.row, lines)
+            .min(clamped_visual_row(selection.cursor.row, lines));
+        let end_row = clamped_visual_row(selection.anchor.row, lines)
+            .max(clamped_visual_row(selection.cursor.row, lines));
+        if row < start_row || row > end_row {
+            return Vec::new();
+        }
+        let start_column = selection.anchor.column.min(selection.cursor.column);
+        let end_column = selection.anchor.column.max(selection.cursor.column) + 1;
+        let line_len = lines[row].chars().count();
+        let start = start_column.min(line_len);
+        let end = end_column.min(line_len);
+        return if start < end {
+            vec![(start, end)]
+        } else {
+            Vec::new()
+        };
+    }
+
+    let anchor = normalize_visual_position(selection.anchor, lines);
+    let cursor = normalize_visual_position(selection.cursor, lines);
+    let (start, end) = ordered_visual_positions(anchor, cursor);
+    if row < start.row || row > end.row {
+        return Vec::new();
+    }
+
+    let line_len = lines[row].chars().count();
+    let range = if selection.kind == VisualSelectionKind::Line {
+        (0, line_len)
+    } else if start.row == end.row {
+        (start.column.min(line_len), (end.column + 1).min(line_len))
+    } else if row == start.row {
+        (start.column.min(line_len), line_len)
+    } else if row == end.row {
+        (0, (end.column + 1).min(line_len))
+    } else {
+        (0, line_len)
+    };
+    if range.0 < range.1 {
+        vec![range]
+    } else {
+        Vec::new()
+    }
+}
+
+fn linewise_selection_text(
+    lines: &[String],
+    anchor: VisualPosition,
+    cursor: VisualPosition,
+) -> String {
+    let start_row = clamped_visual_row(anchor.row, lines).min(clamped_visual_row(cursor.row, lines));
+    let end_row = clamped_visual_row(anchor.row, lines).max(clamped_visual_row(cursor.row, lines));
+    lines[start_row..=end_row].join("\n")
+}
+
+fn character_selection_text(
+    lines: &[String],
+    anchor: VisualPosition,
+    cursor: VisualPosition,
+) -> String {
+    let anchor = normalize_visual_position(anchor, lines);
+    let cursor = normalize_visual_position(cursor, lines);
+    let (start, end) = ordered_visual_positions(anchor, cursor);
+    if start.row == end.row {
+        return slice_line_chars(&lines[start.row], start.column, end.column + 1);
+    }
+
+    let mut selected = Vec::new();
+    selected.push(slice_line_chars(
+        &lines[start.row],
+        start.column,
+        lines[start.row].chars().count(),
+    ));
+    for line in &lines[start.row + 1..end.row] {
+        selected.push(line.clone());
+    }
+    selected.push(slice_line_chars(&lines[end.row], 0, end.column + 1));
+    selected.join("\n")
+}
+
+fn block_selection_text(
+    lines: &[String],
+    anchor: VisualPosition,
+    cursor: VisualPosition,
+) -> String {
+    let start_row = clamped_visual_row(anchor.row, lines).min(clamped_visual_row(cursor.row, lines));
+    let end_row = clamped_visual_row(anchor.row, lines).max(clamped_visual_row(cursor.row, lines));
+    let start_column = anchor.column.min(cursor.column);
+    let end_column = anchor.column.max(cursor.column) + 1;
+    lines[start_row..=end_row]
+        .iter()
+        .map(|line| slice_line_chars(line, start_column, end_column))
+        .collect::<Vec<_>>()
+        .join("\n")
+}
+
+fn normalize_visual_position(position: VisualPosition, lines: &[String]) -> VisualPosition {
+    let row = clamped_visual_row(position.row, lines);
+    let line_len = lines[row].chars().count();
+    VisualPosition {
+        row,
+        column: position.column.min(line_len.saturating_sub(1)),
+    }
+}
+
+fn clamped_visual_row(row: usize, lines: &[String]) -> usize {
+    row.min(lines.len().saturating_sub(1))
+}
+
+fn ordered_visual_positions(
+    first: VisualPosition,
+    second: VisualPosition,
+) -> (VisualPosition, VisualPosition) {
+    if first.row < second.row || (first.row == second.row && first.column <= second.column) {
+        (first, second)
+    } else {
+        (second, first)
+    }
+}
+
+fn slice_line_chars(line: &str, start: usize, end: usize) -> String {
+    let len = line.chars().count();
+    let start = start.min(len);
+    let end = end.min(len);
+    if start >= end {
+        return String::new();
+    }
+    let start_byte = byte_index_for_char(line, start);
+    let end_byte = byte_index_for_char(line, end);
+    line[start_byte..end_byte].to_string()
+}
+
+fn byte_index_for_char(line: &str, column: usize) -> usize {
+    if column == 0 {
+        return 0;
+    }
+    line.char_indices()
+        .nth(column)
+        .map(|(index, _)| index)
+        .unwrap_or(line.len())
+}
+
+fn osc52_clipboard_sequence(text: &str) -> String {
+    format!("\u{1b}]52;c;{}\u{7}", base64_encode(text.as_bytes()))
+}
+
+fn base64_encode(bytes: &[u8]) -> String {
+    const TABLE: &[u8; 64] = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    let mut output = String::with_capacity(((bytes.len() + 2) / 3) * 4);
+    for chunk in bytes.chunks(3) {
+        let first = chunk[0];
+        let second = *chunk.get(1).unwrap_or(&0);
+        let third = *chunk.get(2).unwrap_or(&0);
+        output.push(TABLE[(first >> 2) as usize] as char);
+        output.push(TABLE[(((first & 0b0000_0011) << 4) | (second >> 4)) as usize] as char);
+        if chunk.len() > 1 {
+            output.push(TABLE[(((second & 0b0000_1111) << 2) | (third >> 6)) as usize] as char);
+        } else {
+            output.push('=');
+        }
+        if chunk.len() > 2 {
+            output.push(TABLE[(third & 0b0011_1111) as usize] as char);
+        } else {
+            output.push('=');
+        }
+    }
+    output
+}
+
 fn visual_rows(line: &str, width: u16) -> u16 {
     visual_row_count(line, width).min(usize::from(u16::MAX)) as u16
 }
