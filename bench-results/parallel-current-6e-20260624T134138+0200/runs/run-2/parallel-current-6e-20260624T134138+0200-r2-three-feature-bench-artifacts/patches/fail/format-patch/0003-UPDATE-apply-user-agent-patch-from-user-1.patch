+    fn handle_visual_key(&mut self, key: UiKey) -> Vec<UiAction> {
+        match key {
+            UiKey::Esc => self.clear_visual_selection(),
+            UiKey::Char('v') => self.set_visual_selection_kind(VisualSelectionKind::Character),
+            UiKey::Char('V') => self.set_visual_selection_kind(VisualSelectionKind::Line),
+            UiKey::Char('y') => self.queue_pending_visual_copy(false),
+            UiKey::Char('Y') => self.queue_pending_visual_copy(true),
+            UiKey::Char('h') | UiKey::Left => self.move_visual_cursor(0, -1),
+            UiKey::Char('j') | UiKey::Down => self.move_visual_cursor(1, 0),
+            UiKey::Char('k') | UiKey::Up => self.move_visual_cursor(-1, 0),
+            UiKey::Char('l') | UiKey::Right => self.move_visual_cursor(0, 1),
+            _ => {}
+        }
+        Vec::new()
+    }
+
+    fn clear_visual_selection(&mut self) {
+        self.visual_selection = None;
+        self.pending_visual_copy = None;
+    }
+
+    fn set_visual_selection_kind(&mut self, kind: VisualSelectionKind) {
+        if let Some(selection) = self.visual_selection.as_mut() {
+            selection.kind = kind;
+        }
+    }
+
+    fn move_visual_cursor(&mut self, row_delta: isize, column_delta: isize) {
+        let Some(selection) = self.visual_selection.as_mut() else {
+            return;
+        };
+        selection.cursor.row = selection.cursor.row.saturating_add_signed(row_delta);
+        selection.cursor.column = selection.cursor.column.saturating_add_signed(column_delta);
+    }
+
+    fn queue_pending_visual_copy(&mut self, linewise: bool) {
+        let Some(selection) = self.visual_selection.take() else {
+            return;
+        };
+        self.pending_visual_copy = Some(PendingVisualCopy {
+            selection,
+            linewise,
+        });
+    }
+
+    fn visual_selection_text(
+        &self,
+        selection: VisualSelection,
+        right_content: &str,
+        linewise: bool,
+    ) -> Option<String> {
+        let lines = self.visual_source_lines(selection.focus, right_content);
+        if lines.is_empty() {
+            return None;
+        }
