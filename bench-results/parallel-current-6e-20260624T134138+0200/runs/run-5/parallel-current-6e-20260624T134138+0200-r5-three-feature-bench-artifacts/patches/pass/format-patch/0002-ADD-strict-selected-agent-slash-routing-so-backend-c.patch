+#[test]
+fn controller_routes_selected_agent_slash_commands_to_backend_commands() {
+    let backend = FakeBackend::new([
+        "launch reply",
+        "status output",
+        "fork output",
+        "plain reply",
+    ]);
+    let chat = CommandChat::new(PathBuf::from("/repo"), backend.clone());
+    let mut controller = WorkLeafController::new(chat);
+
+    let agent_id = controller.create_agent("").unwrap();
+    assert!(controller.wait_for_idle(Duration::from_secs(1)));
+
+    controller.send_message(&agent_id, "/status").unwrap();
+    assert!(controller.wait_for_idle(Duration::from_secs(1)));
+    controller
+        .send_message(&agent_id, "/fork branch from selected chat")
+        .unwrap();
+    assert!(controller.wait_for_idle(Duration::from_secs(1)));
+    controller
+        .send_message(&agent_id, "plain prompt should name chat")
+        .unwrap();
+    assert!(controller.wait_for_idle(Duration::from_secs(1)));
+
+    assert_eq!(
+        backend.commands(),
+        vec![
+            (agent_id.clone(), "status".to_string(), String::new()),
+            (
+                agent_id.clone(),
+                "fork".to_string(),
+                "branch from selected chat".to_string()
+            ),
+        ]
+    );
+    assert!(
+        !backend
+            .sends()
+            .iter()
+            .any(|(target, prompt)| target == &agent_id && prompt == "/status"),
+        "`/status` must not be sent through the ordinary prompt path"
+    );
+
+    let snapshot = controller.snapshot();
+    let session = snapshot.session(&agent_id).expect("session exists");
+    assert!(session.lines.iter().any(|line| line == "user: /status"));
+    assert!(session.lines.iter().any(|line| line == "status output"));
+    assert!(
+        session
+            .lines
+            .iter()
+            .any(|line| line == "user: /fork branch from selected chat")
+    );
+    assert!(session.lines.iter().any(|line| line == "fork output"));
+    assert_eq!(session.title, "chat-title");
+    assert!(backend.launches().iter().any(|launch| {
+        launch.id.as_str() == "title-user-1"
+            && launch.feature == "chat-title"
+            && launch.prompt.contains("plain prompt should name chat")
+            && !launch.prompt.contains("/status")
+    }));
+}
