+#[derive(Clone, Debug, Eq, PartialEq)]
+struct SelectedAgentBackendCommand {
+    token: String,
+    arguments: String,
+}
+
+fn selected_agent_backend_command(message: &str) -> Option<SelectedAgentBackendCommand> {
+    let rest = message.strip_prefix('/')?;
+    let first = rest.chars().next()?;
+    if first.is_whitespace() {
+        return None;
+    }
+    let token_end = rest.find(char::is_whitespace).unwrap_or(rest.len());
+    Some(SelectedAgentBackendCommand {
+        token: rest[..token_end].to_string(),
+        arguments: rest[token_end..].trim_start().to_string(),
+    })
+}
+
