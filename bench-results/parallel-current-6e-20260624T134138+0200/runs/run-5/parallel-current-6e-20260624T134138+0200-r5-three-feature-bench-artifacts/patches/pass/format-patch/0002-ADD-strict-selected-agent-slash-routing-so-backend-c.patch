+impl CodexBackend {
+    fn status_command_output(&self, agent_id: &AgentId) -> Result<String, AgentError> {
+        let state = self
+            .state
+            .lock()
+            .expect("codex backend state mutex poisoned");
+        let session = state
+            .sessions
+            .get(agent_id)
+            .ok_or_else(|| AgentError::UnknownSession(agent_id.clone()))?;
+        let status = if state.active_processes.contains_key(agent_id) {
+            "running"
+        } else {
+            "ready"
+        };
+        let mut lines = vec![
+            format!("Codex session {agent_id} is {status}"),
+            format!("feature: {}", session.feature),
+        ];
+        if let Some(thread_id) = state.thread_ids.get(agent_id) {
+            lines.push(format!("thread: {thread_id}"));
+        }
+        Ok(lines.join("\n"))
+    }
+
+    fn fork_command_output(
+        &self,
+        agent_id: &AgentId,
+        arguments: &str,
+    ) -> Result<String, AgentError> {
+        let state = self
+            .state
+            .lock()
+            .expect("codex backend state mutex poisoned");
+        let _session = state
+            .sessions
+            .get(agent_id)
+            .ok_or_else(|| AgentError::UnknownSession(agent_id.clone()))?;
+        let mut text = format!(
+            "Codex command `/fork` is recognized for {agent_id}, but Work Leaf's non-interactive Codex backend cannot open an interactive fork picker."
+        );
+        if let Some(thread_id) = state.thread_ids.get(agent_id) {
+            text.push_str(&format!("\nsource thread: {thread_id}"));
+        }
+        if !arguments.trim().is_empty() {
+            text.push_str(&format!("\nrequested prompt: {}", arguments.trim()));
+        }
+        Ok(text)
+    }
+}
