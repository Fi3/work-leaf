+            snapshot: crate::WorkLeafSnapshot {
+                command_transcript: Vec::new(),
+                sessions: vec![WorkLeafSession {
+                    id: agent_id.clone(),
+                    kind: AgentKind::Codex,
+                    title: "feature".to_string(),
+                    feature: "feature".to_string(),
+                    lines: vec![FEATURE_DONE_PROMPT.to_string()],
+                    loading: None,
+                }],
+            },
+            events: Arc::clone(&events),
+            sent_messages: Arc::clone(&sent_messages),
+        };
+        let mut app = TerminalAppCore::new(controller, 80, 24);
+        app.ui
+            .activate_agent_chat(&agent_id)
+            .expect("test agent is registered");
+
+        app.handle_bytes(b"yes\n");
+
+        assert!(app.ui.selected_agent().is_none());
+        assert!(!app.ui.render_left_pane().contains("user-1"));
+        assert!(sent_messages.lock().unwrap().is_empty());
+
+        events.lock().unwrap().extend([
+            WorkLeafEvent::AgentLineAppended {
+                agent_id: agent_id.clone(),
+                line: FEATURE_DONE_PROMPT.to_string(),
+            },
+            WorkLeafEvent::AgentSelected {
+                agent_id: agent_id.clone(),
+            },
+        ]);
+        app.poll_worker();
+
+        assert_eq!(app.ui.selected_agent(), Some(&agent_id));
+        app.handle_bytes(b"yes\n");
+
+        assert!(app.ui.selected_agent().is_none());
+        assert!(sent_messages.lock().unwrap().is_empty());
+
+        app.handle_bytes(b"add follow-up coverage\n");
+
+        assert_eq!(app.ui.selected_agent(), Some(&agent_id));
+        assert!(app.ui.render_left_pane().contains("user-1"));
+        assert_eq!(
+            sent_messages.lock().unwrap().as_slice(),
+            &[(agent_id, "add follow-up coverage".to_string())]
+        );
+    }
