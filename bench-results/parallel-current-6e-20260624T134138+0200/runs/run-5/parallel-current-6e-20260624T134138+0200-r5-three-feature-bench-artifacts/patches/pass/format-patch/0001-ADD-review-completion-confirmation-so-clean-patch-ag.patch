+#[test]
+fn scripted_harness_review_done_prompt_closes_and_reopens_feature_chat() {
+    let mut harness = UiHarness::new(100, 24);
+
+    harness
+        .complete_review_for_agent("user-2")
+        .expect("fixture user-2 agent is registered");
+
+    let ready_frame = harness.render_frame();
+    assert!(ready_frame.starts_with('\u{7}'));
+    assert!(ready_frame.contains("work-leaf: is this feature done? yes/no"));
+    assert_eq!(
+        harness.ui().selected_agent().map(|id| id.as_str()),
+        Some("user-2")
+    );
+
+    harness.handle_bytes(b"yes\n");
+
+    assert_eq!(harness.ui().selected_agent(), None);
+    assert!(!harness.ui().render_left_pane().contains("test user-2"));
+
+    harness.handle_bytes(b"actually add smoke coverage\n");
+
+    assert_eq!(
+        harness.ui().selected_agent().map(|id| id.as_str()),
+        Some("user-2")
+    );
+    assert!(harness.ui().render_left_pane().contains("user-2"));
+    assert!(
+        harness
+            .transcript()
+            .iter()
+            .any(|line| line == "user-2> actually add smoke coverage")
+    );
+}
