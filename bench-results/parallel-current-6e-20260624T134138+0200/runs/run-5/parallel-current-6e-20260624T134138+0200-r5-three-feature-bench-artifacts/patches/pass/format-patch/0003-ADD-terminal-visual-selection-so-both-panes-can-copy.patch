+    fn handle_visual_key(&mut self, key: UiKey, right_content: &str) -> Vec<UiAction> {
+        match key {
+            UiKey::Esc => self.clear_visual_selection(),
+            UiKey::Char('v') => self.set_visual_kind(VisualKind::Character),
+            UiKey::Char('V') => self.set_visual_kind(VisualKind::Line),
+            UiKey::Char(ch) if ch == CTRL_V_CHAR => self.set_visual_kind(VisualKind::Block),
+            UiKey::Char('y') => self.copy_visual_selection(false, right_content),
+            UiKey::Char('Y') => self.copy_visual_selection(true, right_content),
+            UiKey::Char('h') | UiKey::Left => self.move_visual_cursor(0, -1, right_content),
+            UiKey::Char('j') | UiKey::Down => self.move_visual_cursor(1, 0, right_content),
+            UiKey::Char('k') | UiKey::Up => self.move_visual_cursor(-1, 0, right_content),
+            UiKey::Char('l') | UiKey::Right => self.move_visual_cursor(0, 1, right_content),
+            _ => {}
+        }
+        Vec::new()
+    }
+
+    fn start_visual_selection(&mut self, kind: VisualKind, right_content: &str) {
+        let pane = self.focus;
+        let Some(position) = self.current_pane_position(pane, right_content) else {
+            return;
+        };
+        self.pending = None;
+        self.mode = UiMode::Command;
+        self.visual_selection = Some(VisualSelection {
+            pane,
+            kind,
+            anchor: position,
+            cursor: position,
+            preferred_column: position.column,
+        });
+    }
+
+    fn set_visual_kind(&mut self, kind: VisualKind) {
+        if let Some(selection) = self.visual_selection.as_mut() {
+            selection.kind = kind;
+        }
+    }
+
+    fn move_visual_cursor(&mut self, row_delta: isize, column_delta: isize, right_content: &str) {
+        let Some(selection) = self.visual_selection else {
+            return;
+        };
+        let lines = self.visual_pane_lines(selection.pane, right_content);
+        if lines.is_empty() {
+            return;
+        }
+        let max_row = lines.len().saturating_sub(1);
+        let row = apply_delta(selection.cursor.row, row_delta, max_row);
+        let preferred_column = if column_delta == 0 {
+            selection.preferred_column
+        } else {
+            apply_delta(
+                selection.cursor.column,
+                column_delta,
+                max_visual_column(&lines[selection.cursor.row]),
+            )
+        };
+        let column = preferred_column.min(max_visual_column(&lines[row]));
+        if let Some(selection) = self.visual_selection.as_mut() {
+            selection.cursor = TextPosition { row, column };
+            selection.preferred_column = preferred_column;
+        }
+    }
+
+    fn copy_visual_selection(&mut self, force_line: bool, right_content: &str) {
+        let Some(mut selection) = self.visual_selection else {
+            return;
+        };
+        if force_line {
+            selection.kind = VisualKind::Line;
+        }
+        let lines = self.visual_pane_lines(selection.pane, right_content);
+        let copied = selected_text(selection, &lines);
+        self.clear_visual_selection();
+        self.store_copied_text(copied);
+    }
+
+    fn copy_current_line(&mut self, right_content: &str) {
+        let pane = self.focus;
+        let lines = self.visual_pane_lines(pane, right_content);
+        let Some(position) = self.current_pane_position(pane, right_content) else {
+            return;
+        };
+        let copied = lines.get(position.row).cloned().unwrap_or_default();
+        self.store_copied_text(copied);
+    }
+
+    fn store_copied_text(&mut self, text: String) {
+        let summary = copy_summary(&text);
+        self.copied_text = Some(text);
+        self.pending_clipboard.set(true);
+        self.show_status_notice(
+            format!("copied {summary}"),
+            Duration::from_secs(STATUS_NOTICE_SECONDS),
+        );
+    }
+
+    fn clear_visual_selection(&mut self) {
+        self.visual_selection = None;
+    }
+
+    fn current_pane_position(&self, pane: PaneFocus, right_content: &str) -> Option<TextPosition> {
+        let lines = self.visual_pane_lines(pane, right_content);
+        if lines.is_empty() {
+            return None;
+        }
+        let row = match pane {
+            PaneFocus::Left => self.control_selection_line_index().min(lines.len() - 1),
+            PaneFocus::Right => lines.len() - 1,
+        };
+        Some(TextPosition {
+            row,
+            column: match pane {
+                PaneFocus::Left => 0,
+                PaneFocus::Right => max_visual_column(&lines[row]),
+            },
+        })
+    }
+
+    fn visual_pane_lines(&self, pane: PaneFocus, right_content: &str) -> Vec<String> {
+        match pane {
+            PaneFocus::Left => self.left_pane_selection_lines(),
+            PaneFocus::Right => self.right_pane_selection_lines(right_content),
+        }
+    }
+
+    fn left_pane_selection_lines(&self) -> Vec<String> {
+        let inner_width = usize::from(self.layout().left_width.saturating_sub(2).max(1));
+        let mut lines = vec!["  work-leaf  command".to_string()];
+        if self.control_selected == 0 {
+            lines[0] = "> work-leaf  command".to_string();
+        }
+        for (visible_position, agent_index) in self.visible_agent_indices().iter().enumerate() {
+            let agent = &self.agents[*agent_index];
+            let selected = self.control_selected == visible_position + 1;
+            lines.push(compact_agent_row(agent, selected, inner_width));
+            if !agent.modified_files.is_empty() {
+                lines.push(format!(
+                    "    files: {}",
+                    agent
+                        .modified_files
+                        .iter()
