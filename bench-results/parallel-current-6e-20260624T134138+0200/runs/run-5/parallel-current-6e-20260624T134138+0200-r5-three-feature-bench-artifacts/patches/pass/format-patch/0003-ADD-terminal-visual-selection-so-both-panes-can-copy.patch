+fn selected_text(selection: VisualSelection, lines: &[String]) -> String {
+    if lines.is_empty() {
+        return String::new();
+    }
+    let last_row = lines.len() - 1;
+    let (start_row, end_row) = ordered_pair(selection.anchor.row, selection.cursor.row);
+    let start_row = start_row.min(last_row);
+    let end_row = end_row.min(last_row);
+    match selection.kind {
+        VisualKind::Line => lines[start_row..=end_row].join("\n"),
+        VisualKind::Block => {
+            let (start_column, end_column) =
+                ordered_pair(selection.anchor.column, selection.cursor.column);
+            (start_row..=end_row)
+                .map(|row| char_range(&lines[row], start_column, end_column.saturating_add(1)))
+                .collect::<Vec<_>>()
+                .join("\n")
+        }
+        VisualKind::Character => {
+            let (head, tail) = if selection.anchor.row < selection.cursor.row
+                || (selection.anchor.row == selection.cursor.row
+                    && selection.anchor.column <= selection.cursor.column)
+            {
+                (
+                    TextPosition {
+                        row: selection.anchor.row.min(last_row),
+                        column: selection.anchor.column,
+                    },
+                    TextPosition {
+                        row: selection.cursor.row.min(last_row),
+                        column: selection.cursor.column,
+                    },
+                )
+            } else {
+                (
+                    TextPosition {
+                        row: selection.cursor.row.min(last_row),
+                        column: selection.cursor.column,
+                    },
+                    TextPosition {
+                        row: selection.anchor.row.min(last_row),
+                        column: selection.anchor.column,
+                    },
+                )
+            };
+            if head.row == tail.row {
+                return char_range(&lines[head.row], head.column, tail.column.saturating_add(1));
+            }
+            let mut selected = Vec::new();
+            selected.push(char_range(
+                &lines[head.row],
+                head.column,
+                char_count(&lines[head.row]),
+            ));
+            for line in lines.iter().take(tail.row).skip(head.row + 1) {
+                selected.push(line.clone());
+            }
+            selected.push(char_range(
+                &lines[tail.row],
+                0,
+                tail.column.saturating_add(1),
+            ));
+            selected.join("\n")
+        }
+    }
+}
