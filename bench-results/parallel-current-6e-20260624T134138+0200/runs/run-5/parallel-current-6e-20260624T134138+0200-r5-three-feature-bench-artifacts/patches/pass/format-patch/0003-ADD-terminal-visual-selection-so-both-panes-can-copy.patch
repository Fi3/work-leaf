+fn selected_columns(
+    selection: VisualSelection,
+    row: usize,
+    line: &str,
+    pane_width: usize,
+) -> Option<(usize, usize)> {
+    if pane_width == 0 {
+        return None;
+    }
+    let (start_row, end_row) = ordered_pair(selection.anchor.row, selection.cursor.row);
+    if row < start_row || row > end_row {
+        return None;
+    }
+    match selection.kind {
+        VisualKind::Line => Some((0, pane_width.saturating_sub(1))),
+        VisualKind::Block => Some(ordered_pair(
+            selection.anchor.column,
+            selection.cursor.column,
+        )),
+        VisualKind::Character => {
+            let line_end = max_visual_column(line);
+            if start_row == end_row {
+                let (start, end) = ordered_pair(selection.anchor.column, selection.cursor.column);
+                return Some((start.min(line_end), end.min(line_end)));
+            }
+            if row == selection.anchor.row {
+                if selection.anchor.row <= selection.cursor.row {
+                    Some((selection.anchor.column.min(line_end), line_end))
+                } else {
+                    Some((0, selection.anchor.column.min(line_end)))
+                }
+            } else if row == selection.cursor.row {
+                if selection.anchor.row <= selection.cursor.row {
+                    Some((0, selection.cursor.column.min(line_end)))
+                } else {
+                    Some((selection.cursor.column.min(line_end), line_end))
+                }
+            } else {
+                Some((0, line_end))
+            }
+        }
+    }
+}
+
+fn ordered_pair(left: usize, right: usize) -> (usize, usize) {
+    if left <= right {
+        (left, right)
+    } else {
+        (right, left)
+    }
+}
+
+fn max_visual_column(line: &str) -> usize {
