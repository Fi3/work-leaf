+fn selected_text_from_rows(
+    rows: &[String],
+    selection: &VisualSelection,
+    intent: VisualCopyIntent,
+) -> String {
+    let kind = match intent {
+        VisualCopyIntent::Selection => selection.kind,
+        VisualCopyIntent::Line => VisualKind::Line,
+    };
+    let start_row = selection.anchor.row.min(selection.cursor.row);
+    let end_row = selection.anchor.row.max(selection.cursor.row);
+    let mut selected = Vec::new();
+    for row in start_row..=end_row {
+        let Some(line) = rows.get(row) else {
+            continue;
+        };
+        match kind {
+            VisualKind::Line => selected.push(line.clone()),
+            VisualKind::Block => {
+                let start_column = selection.anchor.column.min(selection.cursor.column);
+                let end_column = selection.anchor.column.max(selection.cursor.column) + 1;
+                selected.push(slice_chars(line, start_column, end_column));
+            }
+            VisualKind::Character => {
+                let row_len = line.chars().count();
+                let Some((start, end)) =
+                    selected_character_columns(selection, row, row_len, row_len)
+                else {
+                    continue;
+                };
+                selected.push(slice_chars(line, start, end));
+            }
+        }
+    }
+    selected.join("\n")
+}
