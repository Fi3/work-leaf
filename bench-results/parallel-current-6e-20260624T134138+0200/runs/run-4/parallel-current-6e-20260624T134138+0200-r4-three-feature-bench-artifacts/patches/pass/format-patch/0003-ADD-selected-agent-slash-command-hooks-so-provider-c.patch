+#[test]
+fn controller_executes_status_slash_command_without_normal_send_prompt() {
+    let backend = FakeBackend::new(["launch reply"]);
+    let chat = CommandChat::new(PathBuf::from("/repo"), backend.clone());
+    let mut controller = WorkLeafController::new(chat);
+
+    let agent_id = controller.create_agent("inspect status").unwrap();
+    assert!(controller.wait_for_idle(Duration::from_secs(1)));
+
+    controller.send_message(&agent_id, "/status").unwrap();
+    assert!(controller.wait_for_idle(Duration::from_secs(1)));
+
+    assert_eq!(
+        backend.commands(),
+        vec![(agent_id.clone(), "/status".to_string())]
+    );
+    assert!(
+        backend
+            .sends()
+            .iter()
+            .all(|(_, prompt)| prompt != "/status"),
+        "/status must not be sent as an ordinary backend prompt"
+    );
+    let snapshot = controller.snapshot();
+    let session = snapshot.session(&agent_id).expect("session exists");
+    assert!(session.lines.iter().any(|line| line == "user: /status"));
+    assert!(
+        session
+            .lines
+            .iter()
+            .any(|line| line == "backend command output for user-1: /status")
+    );
+}
+
+#[test]
+fn controller_executes_fork_slash_command_as_backend_command() {
+    let backend = FakeBackend::new(["launch reply"]);
+    let chat = CommandChat::new(PathBuf::from("/repo"), backend.clone());
+    let mut controller = WorkLeafController::new(chat);
+
+    let agent_id = controller.create_agent("inspect fork").unwrap();
+    assert!(controller.wait_for_idle(Duration::from_secs(1)));
+
+    controller
+        .send_message(&agent_id, "/fork alternate branch")
+        .unwrap();
+    assert!(controller.wait_for_idle(Duration::from_secs(1)));
+
+    assert_eq!(
+        backend.commands(),
+        vec![(agent_id.clone(), "/fork alternate branch".to_string())]
+    );
+    let snapshot = controller.snapshot();
+    let session = snapshot.session(&agent_id).expect("session exists");
+    assert!(
+        session
+            .lines
+            .iter()
+            .any(|line| line == "backend command output for user-1: /fork alternate branch")
+    );
+}
