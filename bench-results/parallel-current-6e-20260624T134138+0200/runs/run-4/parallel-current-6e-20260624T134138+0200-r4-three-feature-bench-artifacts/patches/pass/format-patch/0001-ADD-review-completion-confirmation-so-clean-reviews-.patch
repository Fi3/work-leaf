+#[test]
+fn scripted_harness_review_done_yes_closes_and_followup_reopens_chat() {
+    let mut harness = UiHarness::new(100, 24);
+
+    harness
+        .mark_agent_review_complete("user-1")
+        .expect("fixture user-1 agent is registered");
+
+    let review_done_frame = harness.render_frame();
+    assert!(review_done_frame.contains("Is this feature done? yes/no"));
+    assert!(review_done_frame.contains("\u{1b}[7m>pars user-1 READY\u{1b}[0m"));
+
+    harness.handle_bytes(b"iyes\n");
+
+    let closed_left_pane = harness.ui().render_left_pane();
+    assert!(!closed_left_pane.contains("parser user-1"));
+    assert!(
+        harness
+            .transcript()
+            .iter()
+            .any(|line| line == "work-leaf: feature marked done")
+    );
+
+    harness.handle_bytes(b"please add one more check\n");
+
+    let reopened_left_pane = harness.ui().render_left_pane();
+    assert!(reopened_left_pane.contains("parser user-1"));
+    assert!(
+        harness
+            .transcript()
+            .iter()
+            .any(|line| line == "work-leaf: feature reopened")
+    );
+    assert!(
+        harness
+            .transcript()
+            .iter()
+            .any(|line| line == "user-1> please add one more check")
+    );
+}
