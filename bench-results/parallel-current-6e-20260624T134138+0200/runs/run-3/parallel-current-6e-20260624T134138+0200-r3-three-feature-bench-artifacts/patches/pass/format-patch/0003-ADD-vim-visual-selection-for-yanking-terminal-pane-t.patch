+        content_lines(content)
+            .into_iter()
+            .enumerate()
+            .map(|(line_index, line)| self.styled_line_spans(pane, line_index, &line))
+            .collect()
+    }
+
+    fn styled_line_spans(&self, pane: PaneFocus, line_index: usize, line: &str) -> Spans<'static> {
+        let line_len = line.chars().count();
+        let Some(selection) = self.visual_selection.as_ref() else {
+            return Spans::from(vec![Span::raw(line.to_string())]);
+        };
+        if selection.pane != pane {
+            return Spans::from(vec![Span::raw(line.to_string())]);
+        }
+        let Some((start, end)) = selection_columns(selection, selection.mode, line_index, line_len)
+        else {
+            return Spans::from(vec![Span::raw(line.to_string())]);
+        };
+        spans_with_selection(line, start, end)
+    }
