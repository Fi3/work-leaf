+    fn handle_visual_key(&mut self, key: UiKey, right_content: &str) -> Vec<UiAction> {
+        match key {
+            UiKey::Esc => {
+                self.clear_visual_selection();
+            }
+            UiKey::Char('v') => {
+                self.set_visual_mode(VisualMode::Character);
+            }
+            UiKey::Char('V') => {
+                self.set_visual_mode(VisualMode::Line);
+            }
+            UiKey::Char(ch) if ch == CTRL_V_CHAR => {
+                self.set_visual_mode(VisualMode::Block);
+            }
+            UiKey::Char('y') => {
+                self.yank_visual_selection(right_content, false);
+            }
+            UiKey::Char('Y') => {
+                self.yank_visual_selection(right_content, true);
+            }
+            UiKey::Char('h') | UiKey::Left => {
+                self.move_visual_cursor(0, -1, right_content);
+            }
+            UiKey::Char('j') | UiKey::Down => {
+                self.move_visual_cursor(1, 0, right_content);
+            }
+            UiKey::Char('k') | UiKey::Up => {
+                self.move_visual_cursor(-1, 0, right_content);
+            }
+            UiKey::Char('l') | UiKey::Right => {
+                self.move_visual_cursor(0, 1, right_content);
+            }
+            _ => {}
+        }
+        Vec::new()
+    }
+
+    fn start_visual_selection(&mut self, mode: VisualMode, right_content: &str) {
+        let mut anchor = self.focused_text_position(right_content);
+        if mode == VisualMode::Line {
+            anchor.column = 0;
+        }
+        self.visual_selection = Some(VisualSelection {
+            pane: self.focus,
+            mode,
+            anchor,
+            cursor: anchor,
+        });
+        self.mode = UiMode::Command;
+    }
+
+    fn set_visual_mode(&mut self, mode: VisualMode) {
+        if let Some(selection) = self.visual_selection.as_mut() {
+            selection.mode = mode;
+            if mode == VisualMode::Line {
+                selection.anchor.column = 0;
+                selection.cursor.column = 0;
+            }
+        }
+    }
+
+    fn move_visual_cursor(&mut self, line_delta: isize, column_delta: isize, right_content: &str) {
+        let Some(selection) = self.visual_selection.as_ref() else {
+            return;
+        };
+        let pane = selection.pane;
+        let lines = self.visual_source_lines(pane, right_content);
+        let Some(selection) = self.visual_selection.as_mut() else {
+            return;
+        };
+        let max_line = lines.len().saturating_sub(1);
+        let next_line = selection
+            .cursor
+            .line
+            .saturating_add_signed(line_delta)
+            .min(max_line);
+        let line_len = lines
+            .get(next_line)
+            .map(|line| line.chars().count())
+            .unwrap_or_default();
+        let next_column = selection
+            .cursor
+            .column
+            .saturating_add_signed(column_delta)
+            .min(line_len);
+        selection.cursor = TextPosition {
+            line: next_line,
+            column: if selection.mode == VisualMode::Line {
+                0
+            } else {
+                next_column
+            },
+        };
+    }
+
+    fn yank_visual_selection(&mut self, right_content: &str, force_line: bool) {
+        let Some(selection) = self.visual_selection.clone() else {
+            return;
+        };
+        let mode = if force_line {
+            VisualMode::Line
+        } else {
+            selection.mode
+        };
+        let text = self.selection_text(&selection, mode, right_content);
+        self.clear_visual_selection();
+        self.copy_text_to_clipboard(text);
+    }
+
+    fn yank_focused_line(&mut self, right_content: &str) {
+        let lines = self.visual_source_lines(self.focus, right_content);
+        let position = self.focused_text_position(right_content);
+        let text = lines.get(position.line).cloned().unwrap_or_default();
+        self.copy_text_to_clipboard(text);
+    }
+
+    fn copy_text_to_clipboard(&mut self, text: String) {
+        self.show_status_notice(
+            clipboard_copy_notice(&text),
+            Duration::from_secs(STATUS_NOTICE_SECONDS),
+        );
+        self.pending_clipboard = Some(text);
+    }
+
+    fn selection_text(
+        &self,
+        selection: &VisualSelection,
+        mode: VisualMode,
+        right_content: &str,
+    ) -> String {
+        let lines = self.visual_source_lines(selection.pane, right_content);
+        match mode {
+            VisualMode::Line => {
+                let (start, end) = ordered_line_range(selection.anchor, selection.cursor);
+                (start..=end)
+                    .filter_map(|line| lines.get(line))
+                    .cloned()
+                    .collect::<Vec<_>>()
+                    .join("\n")
+            }
+            VisualMode::Character | VisualMode::Block => {
+                let (start, end) = ordered_line_range(selection.anchor, selection.cursor);
+                (start..=end)
+                    .filter_map(|line_index| {
+                        let line = lines.get(line_index)?;
+                        let (start_column, end_column) =
+                            selection_columns(selection, mode, line_index, line.chars().count())
+                                .unwrap_or((0, 0));
+                        Some(char_slice(line, start_column, end_column))
+                    })
+                    .collect::<Vec<_>>()
+                    .join("\n")
+            }
+        }
+    }
+
+    fn focused_text_position(&self, right_content: &str) -> TextPosition {
+        match self.focus {
+            PaneFocus::Left => TextPosition {
+                line: self.left_cursor_line_index(),
+                column: 0,
+            },
+            PaneFocus::Right => {
+                let lines = content_lines(right_content);
+                let line = lines.len().saturating_sub(1);
+                let column = lines
+                    .get(line)
+                    .map(|line| line.chars().count())
+                    .unwrap_or_default();
+                TextPosition { line, column }
+            }
+        }
+    }
+
+    fn visual_source_lines(&self, pane: PaneFocus, right_content: &str) -> Vec<String> {
+        match pane {
+            PaneFocus::Left => self.left_content_lines(),
+            PaneFocus::Right => content_lines(right_content),
+        }
+    }
+
+    fn left_content_lines(&self) -> Vec<String> {
+        let inner_width = usize::from(self.layout().left_width.saturating_sub(2).max(1));
+        self.left_widget_rows(inner_width)
+            .into_iter()
+            .map(|row| row.text)
+            .collect()
+    }
+
+    fn left_cursor_line_index(&self) -> usize {
+        if self.control_selected == 0 {
+            return 0;
+        }
+        let mut current_line = 1;
+        for (visible_position, agent_index) in self.visible_agent_indices().iter().enumerate() {
+            if self.control_selected == visible_position + 1 {
+                return current_line;
+            }
+            current_line += 1;
+            let agent = &self.agents[*agent_index];
+            if !agent.modified_files.is_empty() {
+                current_line += 1;
+            }
+            for linked_agents in [
+                &agent.conflicting_agents,
+                &agent.depends_on,
+                &agent.depended_on_by,
+            ] {
+                if !linked_agents.is_empty() {
+                    current_line += 1;
+                }
+            }
+        }
+        0
+    }
+
+    fn clear_visual_selection(&mut self) {
+        self.visual_selection = None;
+    }
