+pub(crate) fn clipboard_copy_notice(text: &str) -> String {
+    let line_count = text.split('\n').count();
+    if line_count > 1 {
+        format!("copied {line_count} lines to clipboard")
+    } else {
+        format!("copied {} characters to clipboard", text.chars().count())
+    }
+}
+
+fn content_lines(content: &str) -> Vec<String> {
+    if content.is_empty() {
+        vec![String::new()]
+    } else {
+        content.lines().map(str::to_string).collect()
+    }
+}
+
+fn ordered_positions(left: TextPosition, right: TextPosition) -> (TextPosition, TextPosition) {
+    if (left.line, left.column) <= (right.line, right.column) {
+        (left, right)
+    } else {
+        (right, left)
+    }
+}
+
+fn ordered_line_range(left: TextPosition, right: TextPosition) -> (usize, usize) {
+    if left.line <= right.line {
+        (left.line, right.line)
+    } else {
+        (right.line, left.line)
+    }
+}
+
+fn selection_columns(
+    selection: &VisualSelection,
+    mode: VisualMode,
+    line_index: usize,
+    line_len: usize,
+) -> Option<(usize, usize)> {
+    let range = match mode {
+        VisualMode::Line => {
+            let (start, end) = ordered_line_range(selection.anchor, selection.cursor);
+            (start <= line_index && line_index <= end).then_some((0, line_len))
+        }
+        VisualMode::Character => {
+            let (start, end) = ordered_positions(selection.anchor, selection.cursor);
+            if line_index < start.line || line_index > end.line {
+                None
+            } else if start.line == end.line {
+                Some((start.column, end.column.saturating_add(1)))
+            } else if line_index == start.line {
+                Some((start.column, line_len))
+            } else if line_index == end.line {
+                Some((0, end.column.saturating_add(1)))
+            } else {
+                Some((0, line_len))
+            }
+        }
+        VisualMode::Block => {
+            let (start_line, end_line) = ordered_line_range(selection.anchor, selection.cursor);
+            if line_index < start_line || line_index > end_line {
+                None
+            } else {
+                let start_column = selection.anchor.column.min(selection.cursor.column);
+                let end_column = selection
+                    .anchor
+                    .column
+                    .max(selection.cursor.column)
+                    .saturating_add(1);
+                Some((start_column, end_column))
+            }
+        }
+    }?;
+
+    let start = range.0.min(line_len);
+    let end = range.1.min(line_len);
+    (start < end).then_some((start, end))
+}
+
+fn spans_with_selection(line: &str, start: usize, end: usize) -> Spans<'static> {
+    let line_len = line.chars().count();
+    let start = start.min(line_len);
+    let end = end.min(line_len);
+    if start >= end {
+        return Spans::from(vec![Span::raw(line.to_string())]);
+    }
+
+    let mut spans = Vec::new();
+    if start > 0 {
+        spans.push(Span::raw(char_slice(line, 0, start)));
+    }
+    spans.push(Span::styled(
+        char_slice(line, start, end),
+        Style::default().add_modifier(Modifier::REVERSED),
+    ));
+    if end < line_len {
+        spans.push(Span::raw(char_slice(line, end, line_len)));
+    }
+    Spans::from(spans)
+}
+
+fn char_slice(text: &str, start: usize, end: usize) -> String {
+    let len = text.chars().count();
+    let start = start.min(len);
+    let end = end.min(len);
+    if start >= end {
+        String::new()
+    } else {
+        text.chars().skip(start).take(end - start).collect()
+    }
+}
