+#[test]
+fn terminal_app_prompts_patch_agent_after_review_and_yes_closes_until_typing_reopens() {
+    let root = git_repo("terminal-app-feature-done-prompt");
+    fs::write(root.join("README.md"), "before\n").unwrap();
+    Command::new("git")
+        .current_dir(&root)
+        .args(["add", "README.md"])
+        .status()
+        .unwrap();
+    Command::new("git")
+        .current_dir(&root)
+        .args(["commit", "-m", "ADD initial readme fixture"])
+        .status()
+        .unwrap();
+    let backend = FakeBackend::new([
+        "implemented patch\n@work-leaf patch update readme\n--- a/README.md\n+++ b/README.md\n@@ -1 +1 @@\n-before\n+after\n@work-leaf end\n@work-leaf done",
+        "summary: README changes from before to after",
+        "NO_FINDINGS",
+        "reopened reply",
+    ]);
+    let chat = CommandChat::new(root, backend.clone()).with_max_review_rounds(4);
+    let mut app = TerminalApp::new(chat, 100, 24);
+
+    app.handle_bytes(b":new update readme\n");
+    assert!(app.wait_for_idle(Duration::from_secs(2)));
+
+    assert_eq!(
+        app.ui().selected_agent().map(AgentId::as_str),
+        Some("user-1")
+    );
+    assert!(
+        app.render_frame()
+            .contains("work-leaf: is this feature done? yes/no")
+    );
+    assert!(
+        app.ui()
+            .render_left_pane()
+            .contains("user-1  working: chat-title  READY")
+    );
+
+    app.handle_bytes(b"yes\n");
+
+    assert!(app.render_frame().contains("work-leaf: feature closed"));
+    assert!(
+        !app.ui()
+            .render_left_pane()
+            .contains("user-1  working: chat-title  READY")
+    );
+
+    app.handle_bytes(b"please reopen\n");
+    assert!(app.wait_for_idle(Duration::from_secs(1)));
+
+    assert!(app.render_frame().contains("work-leaf: feature reopened"));
+    assert!(app.render_frame().contains("user: please reopen"));
+    assert!(app.render_frame().contains("reopened reply"));
+    assert!(
+        app.ui()
+            .render_left_pane()
+            .contains("user-1  working: chat-title  READY")
+    );
+
+    let backend = app.into_chat().into_backend();
+    assert!(backend.sends().iter().any(|(target, prompt)| {
+        target.as_str() == "user-1" && prompt == "please reopen"
+    }));
+}
