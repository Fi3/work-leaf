+pub(crate) fn feature_done_answer(message: &str) -> Option<bool> {
+    match message.trim().to_ascii_lowercase().as_str() {
+        "yes" | "y" => Some(true),
+        "no" | "n" => Some(false),
+        _ => None,
+    }
+}
