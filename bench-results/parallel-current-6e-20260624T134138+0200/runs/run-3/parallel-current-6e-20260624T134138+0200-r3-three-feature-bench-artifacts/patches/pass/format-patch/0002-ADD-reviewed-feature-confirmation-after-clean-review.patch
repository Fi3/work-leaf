+pub(crate) fn is_feature_completion_marker(line: &str) -> bool {
+    matches!(
+        line,
+        FEATURE_DONE_PROMPT
+            | FEATURE_CLOSED_LINE
+            | FEATURE_REMAINS_OPEN_LINE
+            | FEATURE_REOPENED_LINE
+    )
+}
