+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+enum CachedFeatureCompletionState {
+    Open,
+    AwaitingUserConfirmation,
+    Closed,
+}
+
+fn cached_feature_completion_state(session: &WorkLeafSession) -> CachedFeatureCompletionState {
+    let mut state = CachedFeatureCompletionState::Open;
+    for line in &session.lines {
+        state = match line.as_str() {
+            FEATURE_DONE_PROMPT => CachedFeatureCompletionState::AwaitingUserConfirmation,
+            FEATURE_CLOSED_LINE => CachedFeatureCompletionState::Closed,
+            FEATURE_REMAINS_OPEN_LINE | FEATURE_REOPENED_LINE => CachedFeatureCompletionState::Open,
+            _ => state,
+        };
+    }
+    state
+}
