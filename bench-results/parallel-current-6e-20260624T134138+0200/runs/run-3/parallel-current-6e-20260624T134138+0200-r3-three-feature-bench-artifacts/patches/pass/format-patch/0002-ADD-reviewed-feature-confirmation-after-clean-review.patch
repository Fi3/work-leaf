+                        self.append_agent_line_allow_duplicate(
+                            agent_id,
+                            FEATURE_REMAINS_OPEN_LINE.to_string(),
+                        );
+                    }
+                    true
+                } else {
+                    self.feature_completion
+                        .insert(agent_id.clone(), FeatureCompletionState::Open);
+                    self.append_agent_line_allow_duplicate(
+                        agent_id,
+                        FEATURE_REOPENED_LINE.to_string(),
+                    );
+                    false
+                }
+            }
+            FeatureCompletionState::Closed => {
+                self.feature_completion
+                    .insert(agent_id.clone(), FeatureCompletionState::Open);
+                self.append_agent_line_allow_duplicate(agent_id, FEATURE_REOPENED_LINE.to_string());
+                false
+            }
+            FeatureCompletionState::Open => false,
+        }
+    }
