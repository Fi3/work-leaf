+    fn handle_visual_key(&mut self, key: UiKey) -> Vec<UiAction> {
+        match key {
+            UiKey::Esc => {
+                self.clear_visual_selection();
+                self.mode = UiMode::Command;
+            }
+            UiKey::Char('v') => self.switch_visual_selection_kind(VisualSelectionKind::Character),
+            UiKey::Char('V') => self.switch_visual_selection_kind(VisualSelectionKind::Line),
+            UiKey::Char(CTRL_V_CHAR) => {
+                self.switch_visual_selection_kind(VisualSelectionKind::Block)
+            }
+            UiKey::Char('y') => self.yank_visual_selection(false),
+            UiKey::Char('Y') => self.yank_visual_selection(true),
+            UiKey::Char('h') | UiKey::Left => self.move_visual_cursor(0, -1),
+            UiKey::Char('j') | UiKey::Down => self.move_visual_cursor(1, 0),
+            UiKey::Char('k') | UiKey::Up => self.move_visual_cursor(-1, 0),
+            UiKey::Char('l') | UiKey::Right => self.move_visual_cursor(0, 1),
+            _ => {}
+        }
+        Vec::new()
+    }
+
+    fn start_visual_selection(&mut self, kind: VisualSelectionKind) {
+        let pane = self.focus;
+        let position = self.current_visual_position(pane);
+        self.mode = UiMode::Command;
+        self.visual_selection = Some(VisualSelection {
+            pane,
+            kind,
+            anchor: position,
+            cursor: position,
+        });
+    }
+
+    fn switch_visual_selection_kind(&mut self, kind: VisualSelectionKind) {
+        if let Some(selection) = &mut self.visual_selection {
+            selection.kind = kind;
+        } else {
+            self.start_visual_selection(kind);
+        }
+    }
+
+    fn clear_visual_selection(&mut self) {
+        self.visual_selection = None;
+    }
+
+    fn current_visual_position(&self, pane: PaneFocus) -> VisualPosition {
+        let lines = self.visual_text_lines(pane);
+        let max_row = lines.len().saturating_sub(1);
+        let row = match pane {
+            PaneFocus::Left => self.left_control_rendered_row().min(max_row),
+            PaneFocus::Right => max_row,
+        };
+        let line_len = line_char_len(lines.get(row).map(String::as_str).unwrap_or(""));
+        let column = match pane {
+            PaneFocus::Left => 0,
+            PaneFocus::Right => self
+                .last_right_cursor_column
+                .get()
+                .unwrap_or_else(|| line_len.saturating_sub(1))
+                .min(line_len.saturating_sub(1)),
+        };
+        VisualPosition { row, column }
+    }
+
+    fn move_visual_cursor(&mut self, row_delta: isize, column_delta: isize) {
+        let Some(selection) = self.visual_selection.clone() else {
+            return;
+        };
+        let lines = self.visual_text_lines(selection.pane);
+        if lines.is_empty() {
+            return;
+        }
+
+        let max_row = lines.len() - 1;
+        let mut cursor = selection.cursor;
+        cursor.row = offset_index(cursor.row, row_delta, max_row);
+        if selection.kind == VisualSelectionKind::Line {
+            cursor.column = 0;
+        } else {
+            let max_column = line_char_len(&lines[cursor.row]).saturating_sub(1);
+            cursor.column = offset_index(cursor.column, column_delta, max_column);
+        }
+
+        if let Some(selection) = &mut self.visual_selection {
+            selection.cursor = cursor;
+        }
+    }
+
+    fn yank_visual_selection(&mut self, force_linewise: bool) {
+        let Some(selection) = self.visual_selection.clone() else {
+            return;
+        };
+        let text = self.selected_text(&selection, force_linewise);
+        self.clear_visual_selection();
+        self.queue_clipboard(text);
+    }
+
+    fn yank_current_line(&mut self) {
+        let pane = self.focus;
+        let lines = self.visual_text_lines(pane);
+        let position = self.current_visual_position(pane);
+        let text = lines.get(position.row).cloned().unwrap_or_default();
+        self.queue_clipboard(text);
+    }
+
+    fn queue_clipboard(&mut self, text: String) {
+        let copied_chars = text.chars().count();
+        self.pending_clipboard.replace(Some(text));
+        self.show_status_notice(
+            format!("copied {copied_chars} chars"),
+            Duration::from_secs(STATUS_NOTICE_SECONDS),
+        );
+        self.mode = UiMode::Command;
+    }
+
+    fn selected_text(&self, selection: &VisualSelection, force_linewise: bool) -> String {
+        let lines = self.visual_text_lines(selection.pane);
+        selected_ranges(selection, &lines, force_linewise)
+            .into_iter()
+            .map(|(row, start, end)| slice_chars(&lines[row], start, end))
+            .collect::<Vec<_>>()
+            .join("\n")
+    }
+
+    fn visual_text_lines(&self, pane: PaneFocus) -> Vec<String> {
+        match pane {
+            PaneFocus::Left => {
+                let inner_width =
+                    usize::from(self.layout().left_width.saturating_sub(2).max(1));
+                self.left_widget_text_lines(inner_width)
+            }
+            PaneFocus::Right => {
+                let content = self.last_right_content.borrow();
+                text_lines(content.as_str())
+            }
+        }
+    }
+
+    fn left_widget_text_lines(&self, inner_width: usize) -> Vec<String> {
+        let mut lines = vec![if self.control_selected == 0 {
+            "> work-leaf  command".to_string()
+        } else {
+            "  work-leaf  command".to_string()
+        }];
+        for (visible_position, agent_index) in self.visible_agent_indices().iter().enumerate() {
+            let agent = &self.agents[*agent_index];
+            lines.push(compact_agent_row(
+                agent,
+                self.control_selected == visible_position + 1,
+                inner_width,
+            ));
+            if !agent.modified_files.is_empty() {
+                lines.push(format!(
+                    "    files: {}",
+                    agent
+                        .modified_files
+                        .iter()
+                        .map(|path| path.display().to_string())
+                        .collect::<Vec<_>>()
+                        .join(", ")
+                ));
+            }
+            for (label, agents) in [
+                ("conflicts", &agent.conflicting_agents),
+                ("depends-on", &agent.depends_on),
+                ("depended-on-by", &agent.depended_on_by),
+            ] {
+                if !agents.is_empty() {
+                    lines.push(format!(
+                        "    {label}: {}",
+                        agents
+                            .iter()
+                            .map(AgentId::as_str)
+                            .collect::<Vec<_>>()
+                            .join(", ")
+                    ));
+                }
+            }
+        }
+        lines
+    }
+
+    fn left_control_rendered_row(&self) -> usize {
+        if self.control_selected == 0 {
+            return 0;
+        }
+
+        let mut current_row = 1;
+        for (visible_position, agent_index) in self.visible_agent_indices().iter().enumerate() {
+            if self.control_selected == visible_position + 1 {
+                return current_row;
+            }
+
+            let agent = &self.agents[*agent_index];
+            current_row += 1;
+            if !agent.modified_files.is_empty() {
+                current_row += 1;
+            }
+            for linked_agents in [
+                &agent.conflicting_agents,
+                &agent.depends_on,
+                &agent.depended_on_by,
+            ] {
+                if !linked_agents.is_empty() {
+                    current_row += 1;
+                }
+            }
+        }
+
+        0
+    }
+
+    fn apply_visual_selection(&self, buffer: &mut Buffer, right_content: &str) {
+        let Some(selection) = &self.visual_selection else {
+            return;
+        };
+        let Some(geometry) = self.visual_pane_geometry(selection.pane) else {
+            return;
+        };
+        let lines = match selection.pane {
+            PaneFocus::Left => self.left_widget_text_lines(usize::from(geometry.width)),
+            PaneFocus::Right => text_lines(right_content),
+        };
+        let ranges = selected_ranges(selection, &lines, false);
+        apply_ranges_to_buffer(buffer, &lines, ranges, geometry);
+    }
+
+    fn visual_pane_geometry(&self, pane: PaneFocus) -> Option<VisualPaneGeometry> {
+        let layout = self.layout();
+        let body_height = self.height.saturating_sub(1);
+        let inner_height = body_height.saturating_sub(2);
+        if inner_height == 0 {
+            return None;
+        }
+        match pane {
+            PaneFocus::Left if layout.left_width > 0 => Some(VisualPaneGeometry {
+                origin_x: 1,
+                origin_y: 1,
+                width: layout.left_width.saturating_sub(2).max(1),
+                height: inner_height,
+            }),
+            PaneFocus::Right => Some(VisualPaneGeometry {
+                origin_x: layout.left_width.saturating_add(1),
+                origin_y: 1,
+                width: layout.right_width.saturating_sub(2).max(1),
+                height: inner_height,
+            }),
+            PaneFocus::Left => None,
+        }
+    }
+
+    fn visual_cursor_position(&self, right_content: &str) -> Option<(u16, u16)> {
+        let selection = self.visual_selection.as_ref()?;
+        let geometry = self.visual_pane_geometry(selection.pane)?;
+        let lines = match selection.pane {
+            PaneFocus::Left => self.left_widget_text_lines(usize::from(geometry.width)),
+            PaneFocus::Right => text_lines(right_content),
+        };
+        let position = clamp_position(selection.cursor, &lines);
+        text_position_to_screen(position, &lines, geometry)
+    }
