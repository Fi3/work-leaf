+fn offset_index(current: usize, delta: isize, max: usize) -> usize {
+    (current as isize + delta).clamp(0, max as isize) as usize
+}
+
+fn text_lines(text: &str) -> Vec<String> {
+    let lines = text.lines().map(str::to_string).collect::<Vec<_>>();
+    if lines.is_empty() {
+        vec![String::new()]
+    } else {
+        lines
+    }
+}
+
+fn line_char_len(line: &str) -> usize {
+    line.chars().count()
+}
+
+fn clamp_position(position: VisualPosition, lines: &[String]) -> VisualPosition {
+    if lines.is_empty() {
+        return VisualPosition { row: 0, column: 0 };
+    }
+    let row = position.row.min(lines.len() - 1);
+    let column = position
+        .column
+        .min(line_char_len(&lines[row]).saturating_sub(1));
+    VisualPosition { row, column }
+}
+
+fn selected_ranges(
+    selection: &VisualSelection,
+    lines: &[String],
+    force_linewise: bool,
+) -> Vec<(usize, usize, usize)> {
+    if lines.is_empty() {
+        return Vec::new();
+    }
+    let anchor = clamp_position(selection.anchor, lines);
+    let cursor = clamp_position(selection.cursor, lines);
+    let (start, end) = ordered_positions(anchor, cursor);
+
+    if force_linewise || selection.kind == VisualSelectionKind::Line {
+        return (start.row..=end.row)
+            .map(|row| (row, 0, line_char_len(&lines[row])))
+            .collect();
+    }
+
+    if selection.kind == VisualSelectionKind::Block {
+        let start_column = start.column.min(end.column);
+        let end_column = start.column.max(end.column).saturating_add(1);
+        return (start.row..=end.row)
+            .map(|row| {
+                let line_len = line_char_len(&lines[row]);
+                let start = start_column.min(line_len);
+                let end = end_column.min(line_len);
+                (row, start, end)
+            })
+            .collect();
+    }
+
+    if start.row == end.row {
+        return vec![(start.row, start.column, end.column.saturating_add(1))];
+    }
+
+    let mut ranges = Vec::new();
+    ranges.push((start.row, start.column, line_char_len(&lines[start.row])));
+    for (row, line) in lines.iter().enumerate().take(end.row).skip(start.row + 1) {
+        ranges.push((row, 0, line_char_len(line)));
+    }
+    ranges.push((end.row, 0, end.column.saturating_add(1)));
+    ranges
+}
+
+fn ordered_positions(
+    left: VisualPosition,
+    right: VisualPosition,
+) -> (VisualPosition, VisualPosition) {
+    if (left.row, left.column) <= (right.row, right.column) {
+        (left, right)
+    } else {
+        (right, left)
+    }
+}
+
+fn slice_chars(line: &str, start: usize, end: usize) -> String {
+    line.chars()
+        .skip(start)
+        .take(end.saturating_sub(start))
+        .collect()
+}
+
+fn apply_ranges_to_buffer(
+    buffer: &mut Buffer,
+    lines: &[String],
+    ranges: Vec<(usize, usize, usize)>,
+    geometry: VisualPaneGeometry,
+) {
+    if lines.is_empty() {
+        return;
+    }
+    let mut ranges_by_row = vec![Vec::<(usize, usize)>::new(); lines.len()];
+    for (row, start, end) in ranges {
+        if row < ranges_by_row.len() {
+            ranges_by_row[row].push((start, end));
+        }
+    }
+
+    let width = usize::from(geometry.width.max(1));
+    let mut visual_row_offset = 0_usize;
+    for (row, line) in lines.iter().enumerate() {
+        for (start, end) in &ranges_by_row[row] {
+            for column in *start..*end {
+                let wrapped_row = column / width;
+                let screen_row = visual_row_offset.saturating_add(wrapped_row);
+                if screen_row >= usize::from(geometry.height) {
+                    continue;
+                }
+                let screen_column = column % width;
+                let x = geometry.origin_x.saturating_add(screen_column as u16);
+                let y = geometry.origin_y.saturating_add(screen_row as u16);
+                if x < buffer.area.width && y < buffer.area.height {
+                    buffer.get_mut(x, y).modifier.insert(Modifier::REVERSED);
+                }
+            }
+        }
+        visual_row_offset =
+            visual_row_offset.saturating_add(visual_row_count(line, geometry.width));
+        if visual_row_offset >= usize::from(geometry.height) {
+            break;
+        }
+    }
+}
+
+fn text_position_to_screen(
+    position: VisualPosition,
+    lines: &[String],
+    geometry: VisualPaneGeometry,
+) -> Option<(u16, u16)> {
+    let width = usize::from(geometry.width.max(1));
+    let mut visual_row_offset = 0_usize;
+    for (row, line) in lines.iter().enumerate() {
+        if row == position.row {
+            let column = position.column.min(line_char_len(line).saturating_sub(1));
+            let screen_row = visual_row_offset.saturating_add(column / width);
+            if screen_row >= usize::from(geometry.height) {
+                return None;
+            }
+            return Some((
+                geometry.origin_y.saturating_add(screen_row as u16 + 1),
+                geometry
+                    .origin_x
+                    .saturating_add((column % width) as u16 + 1),
+            ));
+        }
+        visual_row_offset =
+            visual_row_offset.saturating_add(visual_row_count(line, geometry.width));
+    }
+    None
+}
+
+fn osc52_clipboard_sequence(text: &str) -> String {
+    format!("\u{1b}]52;c;{}\u{7}", base64_encode(text.as_bytes()))
+}
+
+fn base64_encode(bytes: &[u8]) -> String {
+    const TABLE: &[u8; 64] = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    let mut encoded = String::new();
+    for chunk in bytes.chunks(3) {
+        let first = chunk[0];
+        let second = *chunk.get(1).unwrap_or(&0);
+        let third = *chunk.get(2).unwrap_or(&0);
+        let triple = ((first as u32) << 16) | ((second as u32) << 8) | third as u32;
+        encoded.push(TABLE[((triple >> 18) & 0x3f) as usize] as char);
+        encoded.push(TABLE[((triple >> 12) & 0x3f) as usize] as char);
+        if chunk.len() > 1 {
+            encoded.push(TABLE[((triple >> 6) & 0x3f) as usize] as char);
+        } else {
+            encoded.push('=');
+        }
+        if chunk.len() > 2 {
+            encoded.push(TABLE[(triple & 0x3f) as usize] as char);
+        } else {
+            encoded.push('=');
+        }
+    }
+    encoded
+}
