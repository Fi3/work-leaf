+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+enum FeatureDoneUiState {
+    Open,
+    AwaitingConfirmation,
+    Closed,
+}
+
+fn feature_done_ui_state(lines: &[String]) -> FeatureDoneUiState {
+    let mut state = FeatureDoneUiState::Open;
+    for line in lines {
+        match line.as_str() {
+            FEATURE_DONE_PROMPT => state = FeatureDoneUiState::AwaitingConfirmation,
+            FEATURE_DONE_CLOSED => state = FeatureDoneUiState::Closed,
+            FEATURE_REOPENED => state = FeatureDoneUiState::Open,
+            _ => {}
+        }
+    }
+    state
+}
+
+fn is_feature_done_state_line(line: &str) -> bool {
+    matches!(
+        line,
+        FEATURE_DONE_PROMPT | FEATURE_DONE_CLOSED | FEATURE_REOPENED
+    )
+}
