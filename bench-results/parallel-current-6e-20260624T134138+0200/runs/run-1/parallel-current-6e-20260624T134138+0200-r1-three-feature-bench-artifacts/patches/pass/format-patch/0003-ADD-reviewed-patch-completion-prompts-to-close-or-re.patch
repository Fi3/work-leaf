+#[test]
+fn terminal_app_review_completion_prompts_patch_agent_and_yes_closes_it() {
+    let root = git_repo("terminal-app-review-feature-done-prompt");
+    fs::write(root.join("README.md"), "before\n").unwrap();
+    Command::new("git")
+        .current_dir(&root)
+        .args(["add", "README.md"])
+        .status()
+        .unwrap();
+    Command::new("git")
+        .current_dir(&root)
+        .args(["commit", "-m", "ADD initial readme fixture"])
+        .status()
+        .unwrap();
+    let backend = FakeBackend::new([
+        "implemented patch\n@work-leaf patch update readme\n--- a/README.md\n+++ b/README.md\n@@ -1 +1 @@\n-before\n+after\n@work-leaf end\n@work-leaf done",
+        "summary: README changes from before to after",
+        "NO_FINDINGS",
+        "reopened reply",
+    ]);
+    let chat = CommandChat::new(root, backend.clone());
+    let mut app = TerminalApp::new(chat, 100, 24);
+
+    app.handle_bytes(b":new patch update readme\n");
+
+    assert!(app.wait_for_idle(Duration::from_secs(2)));
+    assert_eq!(
+        app.ui().selected_agent().map(AgentId::as_str),
+        Some("user-1")
+    );
+    let frame = app.render_frame();
+    assert!(frame.contains("work-leaf: is this feature done? yes/no"));
+    assert!(app.ui().render_left_pane().contains("READY"));
+
+    app.handle_bytes(b"yes\n");
+
+    let left_pane = app.ui().render_left_pane();
+    assert!(!left_pane.contains("patch user-1"));
+    assert!(left_pane.contains("review-user-1"));
+
+    app.handle_bytes(b"needs another change\n");
+
+    assert!(app.wait_for_idle(Duration::from_secs(2)));
+    let reopened_left_pane = app.ui().render_left_pane();
+    assert!(reopened_left_pane.contains("patch user-1"));
+    let frame = app.render_frame();
+    assert!(frame.contains("work-leaf: feature reopened"));
+    assert!(frame.contains("user: needs another change"));
+    assert!(frame.contains("reopened reply"));
+    assert!(backend.sends().iter().any(|(target, prompt)| {
+        target == &AgentId::new("user-1").unwrap() && prompt == "needs another change"
+    }));
+}
