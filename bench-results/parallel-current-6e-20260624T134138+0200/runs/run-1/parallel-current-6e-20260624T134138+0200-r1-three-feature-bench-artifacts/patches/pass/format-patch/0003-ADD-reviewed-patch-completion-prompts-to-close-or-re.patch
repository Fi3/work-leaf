+    fn handle_feature_done_confirmation(
+        &mut self,
+        agent_id: Option<&AgentId>,
+        message: &str,
+    ) -> bool {
+        let Some(agent_id) = agent_id else {
+            return false;
+        };
+        if !self.feature_done_confirmations.contains(agent_id) {
+            return false;
+        }
+        if message.eq_ignore_ascii_case("yes") {
+            self.feature_done_confirmations.remove(agent_id);
+            self.transcript.push(FEATURE_DONE_CLOSED.to_string());
+            let _ = self.ui.set_agent_ready_state(agent_id, false);
+            let _ = self.ui.set_agent_hidden_state(agent_id, true);
+            return true;
+        }
+        if message.eq_ignore_ascii_case("no") {
+            self.feature_done_confirmations.remove(agent_id);
+            self.transcript.push(FEATURE_REOPENED.to_string());
+            let _ = self.ui.set_agent_hidden_state(agent_id, false);
+            let _ = self.ui.set_agent_ready_state(agent_id, false);
+            return true;
+        }
+
+        self.feature_done_confirmations.remove(agent_id);
+        self.transcript.push(FEATURE_REOPENED.to_string());
+        let _ = self.ui.set_agent_hidden_state(agent_id, false);
+        let _ = self.ui.set_agent_ready_state(agent_id, false);
+        false
+    }
