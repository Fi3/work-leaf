+
+    fn handle_feature_done_message(
+        &mut self,
+        agent_id: &AgentId,
+        message: &str,
+    ) -> FeatureDoneMessage {
+        if self.feature_done_confirmations.contains(agent_id) {
+            if message.eq_ignore_ascii_case("yes") {
+                self.feature_done_confirmations.remove(agent_id);
+                self.closed_feature_agents.insert(agent_id.clone());
+                self.append_agent_line(agent_id, format!("user: {message}"));
+                self.append_agent_state_line(agent_id, FEATURE_DONE_CLOSED.to_string());
+                return FeatureDoneMessage::Handled;
+            }
+            if message.eq_ignore_ascii_case("no") {
+                self.feature_done_confirmations.remove(agent_id);
+                self.closed_feature_agents.remove(agent_id);
+                self.append_agent_line(agent_id, format!("user: {message}"));
+                self.append_agent_state_line(agent_id, FEATURE_REOPENED.to_string());
+                return FeatureDoneMessage::Handled;
+            }
+            self.feature_done_confirmations.remove(agent_id);
+            self.closed_feature_agents.remove(agent_id);
+            self.append_agent_state_line(agent_id, FEATURE_REOPENED.to_string());
+            return FeatureDoneMessage::Continue;
+        }
+
+        if self.closed_feature_agents.remove(agent_id) {
+            self.append_agent_state_line(agent_id, FEATURE_REOPENED.to_string());
+        }
+        FeatureDoneMessage::Continue
+    }
