#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/../.." && pwd)"
reference_study="$repo_root/bench-results/efficiency-exact-normal-work-leaf-20260829T181318Z"
reference_manifest="$reference_study/infrastructure/manifest.json"
source_repo="/home/user/.codex/work-leaf-exact-normal-source-20260829T181318Z"
runtime_root="/home/user/.codex/work-leaf-causal-validation-runtime-20260829T210343Z"
expected_commit="5b1d1ef9590850faed26052f909ddff7ff8f127d"
study_id="efficiency-causal-validation-20260829T210343Z"
bin_dir="$reference_study/infrastructure/bin"

check_infrastructure() {
  [[ -f "$reference_manifest" ]] || {
    echo "error: frozen reference manifest is missing" >&2
    return 1
  }
  [[ "$(jq -r '.source_commit' "$reference_manifest")" == "$expected_commit" ]] || {
    echo "error: frozen reference manifest has the wrong source commit" >&2
    return 1
  }
  [[ "$(git -C "$source_repo" rev-parse HEAD)" == "$expected_commit" \
    && -z "$(git -C "$source_repo" status --short)" ]] || {
    echo "error: immutable source checkout does not match $expected_commit" >&2
    return 1
  }
  for binary in bench-observer work-leaf work-leaf-orchestrator; do
    [[ -x "$bin_dir/$binary" ]] || {
      echo "error: frozen binary is missing: $binary" >&2
      return 1
    }
    expected="$(jq -r --arg binary "$binary" '.binaries[$binary]' "$reference_manifest")"
    actual="$(sha256sum "$bin_dir/$binary" | awk '{print $1}')"
    [[ "$actual" == "$expected" ]] || {
      echo "error: frozen binary hash differs: $binary" >&2
      return 1
    }
  done
}

check_infrastructure
if [[ "${1:-}" == "--check" ]]; then
  [[ "$#" == 1 ]] || {
    echo "usage: $0 --check | ATTEMPT_ID" >&2
    exit 2
  }
  echo "CONTROL_PREFLIGHT_OK"
  exit 0
fi

if [[ "$#" != 1 ]]; then
  echo "usage: $0 --check | ATTEMPT_ID" >&2
  exit 2
fi

attempt_id="$1"
matches="$(awk -F '\t' -v attempt="$attempt_id" \
  'NR > 1 && $2 == attempt && $3 == "work-leaf-direct-read" {count++} END {print count + 0}' \
  "$script_dir/CONTROL-SCHEDULE.tsv")"
[[ "$matches" == "1" ]] || {
  echo "error: attempt is not uniquely declared: $attempt_id" >&2
  exit 2
}

results_dir="$script_dir/runs/$attempt_id"
log_path="$script_dir/logs/$attempt_id.log"
status_path="$script_dir/logs/$attempt_id.exit"
runtime_dir="$runtime_root/$attempt_id"
[[ ! -e "$results_dir" && ! -e "$log_path" && ! -e "$status_path" \
  && ! -e "$runtime_dir" ]] || {
  echo "error: preserved state already exists for $attempt_id" >&2
  exit 2
}

mkdir -p "$results_dir" "$script_dir/logs" "$runtime_dir"
jq -n \
  --arg attempt_id "$attempt_id" \
  --arg source_commit "$expected_commit" \
  '{
    schema_version:1,
    attempt_id:$attempt_id,
    batch:1,
    condition:"work-leaf-direct-read",
    workflow:"concurrent-work-leaf",
    isolated_difference:"agents use direct filesystem reads instead of orchestrator-mediated reads",
    source_commit:$source_commit,
    model:"gpt-5.5",
    reasoning_effort:"xhigh",
    provider_usage_grace_ms:1000,
    analytical_pair:false,
    retry:false
  }' > "$results_dir/admission.json"

set +e
env \
  -u WORK_LEAF_EXPERIMENT_CHANGED_REPEAT_DELIVERY \
  -u WORK_LEAF_EXPERIMENT_UNCHANGED_REPEAT_DELIVERY \
  -u WORK_LEAF_EXPERIMENT_REVIEW_PROVENANCE \
  -u WORK_LEAF_BENCH_FEATURE_SCHEDULE \
  WORK_LEAF_BENCH_MODEL=gpt-5.5 \
  WORK_LEAF_BENCH_REASONING_EFFORT=xhigh \
  WORK_LEAF_OBSERVER_PROVIDER_USAGE_GRACE_MS=1000 \
  WORK_LEAF_BENCH_TMPDIR="$runtime_dir" \
  WORK_LEAF_BENCH_RESULTS_DIR="$results_dir" \
  WORK_LEAF_BENCH_SKIP_BUILD=1 \
  WORK_LEAF_BENCH_BIN_DIR="$bin_dir" \
  WORK_LEAF_BENCH_TIMEOUT_SECS=7200 \
  WORK_LEAF_BENCH_NO_READ_PERMISSION=1 \
  WORK_LEAF_BENCH_WEB_UI=0 \
  WORK_LEAF_BENCH_DISABLE_TMUX_SUPERVISOR=1 \
  WORK_LEAF_BENCH_OBSERVER_BIN="$bin_dir/bench-observer" \
  WORK_LEAF_BENCH_STUDY_ID="$study_id" \
  WORK_LEAF_BENCH_PAIR_ID="unpaired-$attempt_id" \
  WORK_LEAF_BENCH_RUN_ID="$attempt_id" \
  WORK_LEAF_BENCH_OPERATOR_NOTES="causal control: existing direct-read mode; all other normal concurrent Work Leaf settings retained" \
  "$source_repo/bench-three-features" > "$log_path" 2>&1
status=$?
set -e

printf '%s\n' "$status" > "$status_path"
exit "$status"
