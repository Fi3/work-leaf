bench_runtime_fail() {
  bench_runtime_error_reason="$1"
  bench_runtime_error_code="${2:-candidate_build_failed}"
  return 1
}

bench_checkout_matches_commit() {
  local checkout_dir="$1"
  local expected_commit="$2"
  local actual_commit checkout_status
  actual_commit="$(git -C "$checkout_dir" rev-parse --verify 'HEAD^{commit}' 2>/dev/null)" \
    || return 1
  [[ "$actual_commit" == "$expected_commit" ]] || return 1
  checkout_status="$(git -C "$checkout_dir" status --porcelain=v1 --untracked-files=all)" \
    || return 1
  [[ -z "$checkout_status" ]]
}

bench_fd_path() {
  local fd="$1"
  if [[ -e "/proc/self/fd/$fd" ]]; then
    printf '/proc/self/fd/%s\n' "$fd"
  elif [[ -e "/dev/fd/$fd" ]]; then
    printf '/dev/fd/%s\n' "$fd"
  else
    return 1
  fi
}

bench_directory_fd_path() {
  local fd_path
  fd_path="$(bench_fd_path "$1")" || return 1
  [[ -d "$fd_path" ]] || return 1
  printf '%s\n' "$fd_path"
}

bench_directory_matches_identity() {
  local path="$1"
  local fd_path="$2"
  local identity="$3"
  [[ -d "$path" && ! -L "$path" && -d "$fd_path" ]] || return 1
  [[ "$(stat -c '%d:%i' "$path" 2>/dev/null)" == "$identity" ]] || return 1
  [[ "$(stat -Lc '%d:%i' "$fd_path" 2>/dev/null)" == "$identity" ]]
}

bench_remove_owned_directory() {
  local owner_fd_path="$1"
  local owner_identity="$2"
  local entry_name="$3"
  local entry_identity="$4"
  local allow_candidate="${5:-0}"

  [[ -d "$owner_fd_path" \
    && "$owner_identity" =~ ^[0-9]+:[0-9]+$ \
    && "$entry_identity" =~ ^[0-9]+:[0-9]+$ ]] || return 1
  if [[ "$entry_name" == "candidate" ]]; then
    [[ "$allow_candidate" == "1" ]] || return 1
  else
    [[ "$allow_candidate" == "0" \
      && "$entry_name" =~ ^([.]bench-artifact-publish[.][0-9a-f]{32}|[.]candidate[.](publish|materialize)[.][A-Za-z0-9]+)$ ]] \
      || return 1
  fi
  python3 - "$owner_fd_path" "$owner_identity" "$entry_name" "$entry_identity" <<'PY'
import os
import stat
import sys


# Rechecking a fixed-size ancestor chain keeps cleanup linear in the number of
# entries while still detecting renames and replacements before every unlink.
MAX_IDENTITY_CHAIN_DEPTH = 64


def identity(value):
    return tuple(map(int, value.split(":")))


def same_identity(value, expected):
    return (value.st_dev, value.st_ino) == expected


def chain_is_current(chain):
    for parent_fd, name, expected in chain:
        try:
            current = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
        except FileNotFoundError:
            return False
        if not stat.S_ISDIR(current.st_mode) or not same_identity(current, expected):
            return False
    return True


def remove_contents(directory_fd, chain):
    if len(chain) > MAX_IDENTITY_CHAIN_DEPTH:
        raise RuntimeError("publication staging nesting exceeds cleanup safety bound")
    for name in sorted(os.listdir(directory_fd)):
        if not chain_is_current(chain):
            raise RuntimeError("publication staging path changed during cleanup")
        entry = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
        expected = (entry.st_dev, entry.st_ino)
        if stat.S_ISDIR(entry.st_mode):
            child_fd = os.open(
                name,
                os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                dir_fd=directory_fd,
            )
            try:
                child = os.fstat(child_fd)
                if not same_identity(child, expected):
                    raise RuntimeError("publication child directory identity changed")
                child_chain = chain + [(directory_fd, name, expected)]
                if not chain_is_current(child_chain):
                    raise RuntimeError("publication child path changed before cleanup")
                remove_contents(child_fd, child_chain)
                if not chain_is_current(child_chain):
                    raise RuntimeError("publication child path changed after cleanup")
                os.rmdir(name, dir_fd=directory_fd)
            finally:
                os.close(child_fd)
        else:
            current = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
            if not same_identity(current, expected) or not chain_is_current(chain):
                raise RuntimeError("publication entry identity changed before cleanup")
            os.unlink(name, dir_fd=directory_fd)


owner_path, owner_identity, entry_name, entry_identity = sys.argv[1:]
owner_expected = identity(owner_identity)
entry_expected = identity(entry_identity)
owner_fd = os.open(owner_path, os.O_RDONLY | os.O_DIRECTORY)
entry_fd = -1
try:
    owner = os.fstat(owner_fd)
    if not same_identity(owner, owner_expected):
        raise RuntimeError("publication owner identity changed before cleanup")
    entry = os.stat(entry_name, dir_fd=owner_fd, follow_symlinks=False)
    if not stat.S_ISDIR(entry.st_mode) or not same_identity(entry, entry_expected):
        raise RuntimeError("publication staging identity changed before cleanup")
    entry_fd = os.open(
        entry_name,
        os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
        dir_fd=owner_fd,
    )
    opened = os.fstat(entry_fd)
    if not same_identity(opened, entry_expected):
        raise RuntimeError("publication staging identity changed while opening cleanup")
    chain = [(owner_fd, entry_name, entry_expected)]
    if not chain_is_current(chain):
        raise RuntimeError("publication staging path changed before cleanup")
    remove_contents(entry_fd, chain)
    if not chain_is_current(chain):
        raise RuntimeError("publication staging path changed after cleanup")
    os.rmdir(entry_name, dir_fd=owner_fd)
finally:
    if entry_fd >= 0:
        os.close(entry_fd)
    os.close(owner_fd)
PY
}

bench_remove_owned_regular_file() {
  local owner_fd_path="$1"
  local owner_identity="$2"
  local entry_name="$3"
  local entry_identity="$4"

  [[ -d "$owner_fd_path" \
    && "$owner_identity" =~ ^[0-9]+:[0-9]+$ \
    && "$entry_name" =~ ^[.][A-Za-z0-9._-]+[.]publish[.][A-Za-z0-9]+$ \
    && "$entry_identity" =~ ^[0-9]+:[0-9]+$ ]] || return 1
  python3 - "$owner_fd_path" "$owner_identity" "$entry_name" "$entry_identity" <<'PY'
import ctypes
import errno
import os
import secrets
import stat
import sys


# Linux has no inode-conditional unlink. A private directory therefore makes
# this a terminal quarantine operation: an owned staging file can be moved out
# of its publication name, but no pathname in the quarantine is ever deleted.
# A replacement is moved back without ever being overwritten or unlinked.
def rename_no_replace(source_fd, source, destination_fd, destination):
    libc = ctypes.CDLL(None, use_errno=True)
    renameat2 = libc.renameat2
    renameat2.argtypes = [
        ctypes.c_int,
        ctypes.c_char_p,
        ctypes.c_int,
        ctypes.c_char_p,
        ctypes.c_uint,
    ]
    renameat2.restype = ctypes.c_int
    if renameat2(
        source_fd,
        os.fsencode(source),
        destination_fd,
        os.fsencode(destination),
        1,
    ) != 0:
        error = ctypes.get_errno()
        if error == errno.EEXIST:
            raise RuntimeError("publication staging name appeared during cleanup")
        raise OSError(error, os.strerror(error))


owner_path, owner_identity, entry_name, entry_identity = sys.argv[1:]
owner_expected = tuple(map(int, owner_identity.split(":")))
entry_expected = tuple(map(int, entry_identity.split(":")))
owner_fd = os.open(owner_path, os.O_RDONLY | os.O_DIRECTORY)
quarantine_fd = -1
quarantine_name = ""
quarantine_identity = None
try:
    owner = os.fstat(owner_fd)
    if (owner.st_dev, owner.st_ino) != owner_expected:
        raise RuntimeError("publication owner directory identity changed before cleanup")

    for _ in range(128):
        quarantine_name = ".bench-file-cleanup." + secrets.token_hex(16)
        try:
            os.mkdir(quarantine_name, mode=0o700, dir_fd=owner_fd)
            break
        except FileExistsError:
            continue
    else:
        raise RuntimeError("could not reserve publication cleanup quarantine")

    quarantine = os.stat(quarantine_name, dir_fd=owner_fd, follow_symlinks=False)
    if not stat.S_ISDIR(quarantine.st_mode) or quarantine.st_uid != os.geteuid():
        raise RuntimeError("publication cleanup quarantine is unsafe")
    quarantine_identity = (quarantine.st_dev, quarantine.st_ino)
    quarantine_fd = os.open(
        quarantine_name,
        os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
        dir_fd=owner_fd,
    )
    opened_quarantine = os.fstat(quarantine_fd)
    if (opened_quarantine.st_dev, opened_quarantine.st_ino) != quarantine_identity:
        raise RuntimeError("publication cleanup quarantine identity changed")
    os.fchmod(quarantine_fd, 0o700)

    try:
        rename_no_replace(owner_fd, entry_name, quarantine_fd, "entry")
    except FileNotFoundError:
        pass
    else:
        moved = os.stat("entry", dir_fd=quarantine_fd, follow_symlinks=False)
        moved_identity = (moved.st_dev, moved.st_ino)
        terminal_quarantine = stat.S_ISREG(moved.st_mode) and moved_identity == entry_expected
        if not terminal_quarantine:
            rename_no_replace(quarantine_fd, "entry", owner_fd, entry_name)
            raise RuntimeError("publication staging identity changed before cleanup")
finally:
    if quarantine_fd >= 0:
        os.close(quarantine_fd)
    os.close(owner_fd)
PY
}

bench_publish_owned_directory_noreplace() {
  local owner_fd_path="$1"
  local owner_identity="$2"
  local source_name="$3"
  local source_identity="$4"
  local target_name="$5"

  [[ -d "$owner_fd_path" \
    && "$owner_identity" =~ ^[0-9]+:[0-9]+$ \
    && "$source_name" =~ ^[.]candidate[.](publish|materialize)[.][A-Za-z0-9]+$ \
    && "$source_identity" =~ ^[0-9]+:[0-9]+$ \
    && "$target_name" == "candidate" ]] || return 1
  python3 - \
    "$owner_fd_path" "$owner_identity" "$source_name" "$source_identity" "$target_name" <<'PY'
import ctypes
import errno
import os
import stat
import sys

owner, owner_identity, source_name, source_identity, target_name = sys.argv[1:]
owner_dev, owner_ino = map(int, owner_identity.split(":"))
source_dev, source_ino = map(int, source_identity.split(":"))
owner_fd = os.open(owner, os.O_RDONLY | os.O_DIRECTORY)
try:
    owner_stat = os.fstat(owner_fd)
    if (owner_stat.st_dev, owner_stat.st_ino) != (owner_dev, owner_ino):
        raise RuntimeError("candidate owner directory identity changed")
    source_stat = os.stat(source_name, dir_fd=owner_fd, follow_symlinks=False)
    if not stat.S_ISDIR(source_stat.st_mode):
        raise RuntimeError("candidate staging entry is not a directory")
    if (source_stat.st_dev, source_stat.st_ino) != (source_dev, source_ino):
        raise RuntimeError("candidate staging directory identity changed")
    try:
        os.stat(target_name, dir_fd=owner_fd, follow_symlinks=False)
    except FileNotFoundError:
        pass
    else:
        raise RuntimeError("candidate destination already exists")

    libc = ctypes.CDLL(None, use_errno=True)
    renameat2 = libc.renameat2
    renameat2.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint]
    renameat2.restype = ctypes.c_int
    if renameat2(
        owner_fd,
        os.fsencode(source_name),
        owner_fd,
        os.fsencode(target_name),
        1,
    ) != 0:
        error = ctypes.get_errno()
        if error == errno.EEXIST:
            raise RuntimeError("candidate destination appeared during publication")
        raise OSError(error, os.strerror(error))
    published_stat = os.stat(target_name, dir_fd=owner_fd, follow_symlinks=False)
    if not stat.S_ISDIR(published_stat.st_mode):
        raise RuntimeError("published candidate is not a directory")
    if (published_stat.st_dev, published_stat.st_ino) != (source_dev, source_ino):
        raise RuntimeError("published candidate identity differs from staging")
finally:
    os.close(owner_fd)
PY
}

bench_pinned_directory_guard_pid=""
bench_pinned_directory_guard_read_fd=""
bench_pinned_directory_guard_write_fd=""
bench_pinned_directory_fd_path=""
bench_pinned_directory_identity=""

bench_close_pinned_directory() {
  if [[ "$bench_pinned_directory_guard_write_fd" =~ ^[0-9]+$ ]]; then
    printf '\n' >&"$bench_pinned_directory_guard_write_fd" 2>/dev/null || true
    exec {bench_pinned_directory_guard_write_fd}>&- 2>/dev/null || true
  fi
  if [[ "$bench_pinned_directory_guard_read_fd" =~ ^[0-9]+$ ]]; then
    exec {bench_pinned_directory_guard_read_fd}<&- 2>/dev/null || true
  fi
  if [[ "$bench_pinned_directory_guard_pid" =~ ^[0-9]+$ ]]; then
    wait "$bench_pinned_directory_guard_pid" 2>/dev/null || true
  fi
  bench_pinned_directory_guard_pid=""
  bench_pinned_directory_guard_read_fd=""
  bench_pinned_directory_guard_write_fd=""
  bench_pinned_directory_fd_path=""
  bench_pinned_directory_identity=""
}

bench_pin_owned_directory() {
  local owner_fd="$1"
  local owner_identity="$2"
  local entry_name="$3"
  local guard_line guard_process_pid guard_directory_fd guard_identity

  bench_close_pinned_directory
  coproc BENCH_PINNED_DIRECTORY_GUARD {
    python3 -c '
import os
import stat
import sys

owner_fd = int(sys.argv[1])
owner_dev, owner_ino = map(int, sys.argv[2].split(":"))
entry_name = sys.argv[3]
owner_stat = os.fstat(owner_fd)
if (owner_stat.st_dev, owner_stat.st_ino) != (owner_dev, owner_ino):
    raise RuntimeError("publication owner directory identity changed")
entry_stat = os.stat(entry_name, dir_fd=owner_fd, follow_symlinks=False)
if not stat.S_ISDIR(entry_stat.st_mode):
    raise RuntimeError("publication staging entry is not a directory")
if not hasattr(os, "O_NOFOLLOW"):
    raise RuntimeError("platform does not support no-follow directory opens")
flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
directory_fd = os.open(entry_name, flags, dir_fd=owner_fd)
try:
    directory_stat = os.fstat(directory_fd)
    if (directory_stat.st_dev, directory_stat.st_ino) != (
        entry_stat.st_dev,
        entry_stat.st_ino,
    ):
        raise RuntimeError("publication staging directory identity changed")
    print(
        f"{os.getpid()}\t{directory_fd}\t{directory_stat.st_dev}:{directory_stat.st_ino}",
        flush=True,
    )
    sys.stdin.buffer.read(1)
finally:
    os.close(directory_fd)
' "$owner_fd" "$owner_identity" "$entry_name"
  }
  bench_pinned_directory_guard_pid="$BENCH_PINNED_DIRECTORY_GUARD_PID"
  bench_pinned_directory_guard_read_fd="${BENCH_PINNED_DIRECTORY_GUARD[0]}"
  bench_pinned_directory_guard_write_fd="${BENCH_PINNED_DIRECTORY_GUARD[1]}"
  if ! IFS= read -r guard_line <&"$bench_pinned_directory_guard_read_fd"; then
    bench_close_pinned_directory
    return 1
  fi
  IFS=$'\t' read -r guard_process_pid guard_directory_fd guard_identity <<< "$guard_line"
  if [[ ! "$guard_process_pid" =~ ^[0-9]+$ \
    || ! "$guard_directory_fd" =~ ^[0-9]+$ \
    || ! "$guard_identity" =~ ^[0-9]+:[0-9]+$ ]]; then
    bench_close_pinned_directory
    return 1
  fi
  bench_pinned_directory_fd_path="/proc/$guard_process_pid/fd/$guard_directory_fd"
  bench_pinned_directory_identity="$guard_identity"
  if [[ ! -d "$bench_pinned_directory_fd_path" \
    || "$(stat -Lc '%d:%i' "$bench_pinned_directory_fd_path" 2>/dev/null)" != "$guard_identity" ]]; then
    bench_close_pinned_directory
    return 1
  fi
}

bench_artifact_transaction_guard_pid=""
bench_artifact_transaction_guard_read_fd=""
bench_artifact_transaction_guard_write_fd=""
bench_artifact_transaction_root_fd_path=""
bench_artifact_transaction_root_identity=""
bench_artifact_transaction_stage_fd_path=""
bench_artifact_transaction_stage_identity=""
bench_artifact_transaction_stage_name=""
bench_artifact_transaction_artifact_name=""
bench_artifact_transaction_report_name=""
bench_artifact_transaction_index_name=""
bench_artifact_transaction_active=0

bench_close_artifact_transaction_guard() {
  local disposition="${1:-abort}"

  if [[ "$disposition" == "abort" \
    && -n "$bench_artifact_transaction_root_fd_path" \
    && -n "$bench_artifact_transaction_root_identity" \
    && -n "$bench_artifact_transaction_stage_name" \
    && -n "$bench_artifact_transaction_stage_identity" ]]; then
    bench_remove_owned_directory \
      "$bench_artifact_transaction_root_fd_path" \
      "$bench_artifact_transaction_root_identity" \
      "$bench_artifact_transaction_stage_name" \
      "$bench_artifact_transaction_stage_identity" 2>/dev/null || true
  fi
  if [[ "$bench_artifact_transaction_guard_write_fd" =~ ^[0-9]+$ ]]; then
    printf '%s\n' "$disposition" \
      >&"$bench_artifact_transaction_guard_write_fd" 2>/dev/null || true
    exec {bench_artifact_transaction_guard_write_fd}>&- 2>/dev/null || true
  fi
  if [[ "$bench_artifact_transaction_guard_read_fd" =~ ^[0-9]+$ ]]; then
    exec {bench_artifact_transaction_guard_read_fd}<&- 2>/dev/null || true
  fi
  if [[ "$bench_artifact_transaction_guard_pid" =~ ^[0-9]+$ ]]; then
    wait "$bench_artifact_transaction_guard_pid" 2>/dev/null || true
  fi
  bench_artifact_transaction_guard_pid=""
  bench_artifact_transaction_guard_read_fd=""
  bench_artifact_transaction_guard_write_fd=""
  bench_artifact_transaction_root_fd_path=""
  bench_artifact_transaction_root_identity=""
  bench_artifact_transaction_stage_fd_path=""
  bench_artifact_transaction_stage_identity=""
  bench_artifact_transaction_stage_name=""
  bench_artifact_transaction_artifact_name=""
  bench_artifact_transaction_report_name=""
  bench_artifact_transaction_index_name=""
  bench_artifact_transaction_active=0
}

bench_abort_artifact_transaction() {
  bench_close_artifact_transaction_guard abort
}

bench_begin_artifact_transaction() {
  local results_dir="$1"
  local artifact_name="$2"
  local report_name="$3"
  local index_name="$4"
  local guard_line guard_process_pid root_fd root_identity stage_fd stage_identity stage_name

  [[ "$bench_artifact_transaction_active" == "0" ]] || return 1
  [[ "$artifact_name" =~ ^[A-Za-z0-9._+-]+$ \
    && "$report_name" =~ ^[A-Za-z0-9._+-]+$ \
    && "$index_name" =~ ^[A-Za-z0-9._+-]+$ ]] || return 1
  [[ -d "$results_dir" && ! -L "$results_dir" ]] || return 1
  results_dir="$(cd "$results_dir" && pwd -P)" || return 1

  coproc BENCH_ARTIFACT_TRANSACTION_GUARD {
    python3 -c '
import fcntl
import hashlib
import os
import secrets
import stat
import sys

results_dir, artifact_name, report_name = sys.argv[1:4]
root_flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
root_fd = os.open(results_dir, root_flags)
lock_fd = -1
stage_fd = -1
stage_name = ""
try:
    root = os.fstat(root_fd)
    if root.st_uid != os.geteuid():
        raise RuntimeError("benchmark results directory is not owned by the current user")
    lock_name = ".bench-artifact-lock." + hashlib.sha256(
        artifact_name.encode("utf-8")
    ).hexdigest()
    lock_flags = os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW
    lock_fd = os.open(lock_name, lock_flags, 0o600, dir_fd=root_fd)
    lock = os.fstat(lock_fd)
    if not stat.S_ISREG(lock.st_mode) or lock.st_uid != os.geteuid() or lock.st_nlink != 1:
        raise RuntimeError("benchmark artifact lock is unsafe")
    fcntl.flock(lock_fd, fcntl.LOCK_EX)
    for completed_name in (artifact_name, report_name):
        try:
            os.stat(completed_name, dir_fd=root_fd, follow_symlinks=False)
        except FileNotFoundError:
            pass
        else:
            raise RuntimeError(f"benchmark output already exists: {completed_name}")
    for _ in range(128):
        stage_name = ".bench-artifact-publish." + secrets.token_hex(16)
        try:
            os.mkdir(stage_name, 0o700, dir_fd=root_fd)
            break
        except FileExistsError:
            continue
    else:
        raise RuntimeError("could not reserve benchmark artifact staging directory")
    stage_entry = os.stat(stage_name, dir_fd=root_fd, follow_symlinks=False)
    if not stat.S_ISDIR(stage_entry.st_mode) or stage_entry.st_uid != os.geteuid():
        raise RuntimeError("benchmark artifact staging entry is unsafe")
    stage_fd = os.open(stage_name, root_flags, dir_fd=root_fd)
    stage = os.fstat(stage_fd)
    if (stage.st_dev, stage.st_ino) != (stage_entry.st_dev, stage_entry.st_ino):
        raise RuntimeError("benchmark artifact staging identity changed")
    print(
        f"{os.getpid()}\t{root_fd}\t{root.st_dev}:{root.st_ino}"
        f"\t{stage_fd}\t{stage.st_dev}:{stage.st_ino}\t{stage_name}",
        flush=True,
    )
    sys.stdin.buffer.readline()
finally:
    if stage_fd >= 0:
        os.close(stage_fd)
    if lock_fd >= 0:
        os.close(lock_fd)
    os.close(root_fd)
' "$results_dir" "$artifact_name" "$report_name"
  }
  bench_artifact_transaction_guard_pid="$BENCH_ARTIFACT_TRANSACTION_GUARD_PID"
  bench_artifact_transaction_guard_read_fd="${BENCH_ARTIFACT_TRANSACTION_GUARD[0]}"
  bench_artifact_transaction_guard_write_fd="${BENCH_ARTIFACT_TRANSACTION_GUARD[1]}"
  if ! IFS= read -r guard_line <&"$bench_artifact_transaction_guard_read_fd"; then
    bench_close_artifact_transaction_guard abort
    return 1
  fi
  IFS=$'\t' read -r \
    guard_process_pid root_fd root_identity stage_fd stage_identity stage_name <<< "$guard_line"
  if [[ ! "$guard_process_pid" =~ ^[0-9]+$ \
    || ! "$root_fd" =~ ^[0-9]+$ \
    || ! "$root_identity" =~ ^[0-9]+:[0-9]+$ \
    || ! "$stage_fd" =~ ^[0-9]+$ \
    || ! "$stage_identity" =~ ^[0-9]+:[0-9]+$ \
    || ! "$stage_name" =~ ^[.]bench-artifact-publish[.][0-9a-f]{32}$ ]]; then
    bench_close_artifact_transaction_guard abort
    return 1
  fi
  bench_artifact_transaction_root_fd_path="/proc/$guard_process_pid/fd/$root_fd"
  bench_artifact_transaction_root_identity="$root_identity"
  bench_artifact_transaction_stage_fd_path="/proc/$guard_process_pid/fd/$stage_fd"
  bench_artifact_transaction_stage_identity="$stage_identity"
  bench_artifact_transaction_stage_name="$stage_name"
  bench_artifact_transaction_artifact_name="$artifact_name"
  bench_artifact_transaction_report_name="$report_name"
  bench_artifact_transaction_index_name="$index_name"
  if [[ ! -d "$bench_artifact_transaction_root_fd_path" \
    || ! -d "$bench_artifact_transaction_stage_fd_path" \
    || "$(stat -Lc '%d:%i' "$bench_artifact_transaction_root_fd_path" 2>/dev/null)" != "$root_identity" \
    || "$(stat -Lc '%d:%i' "$bench_artifact_transaction_stage_fd_path" 2>/dev/null)" != "$stage_identity" ]]; then
    bench_close_artifact_transaction_guard abort
    return 1
  fi
  bench_artifact_transaction_active=1
}

bench_commit_artifact_transaction() {
  local human_report_name="$1"

  [[ "$bench_artifact_transaction_active" == "1" ]] || return 1
  [[ "$human_report_name" =~ ^[A-Za-z0-9._+-]+$ ]] || return 1
  if ! python3 - \
    "$bench_artifact_transaction_root_fd_path" \
    "$bench_artifact_transaction_root_identity" \
    "$bench_artifact_transaction_stage_fd_path" \
    "$bench_artifact_transaction_stage_identity" \
    "$bench_artifact_transaction_stage_name" \
    "$bench_artifact_transaction_artifact_name" \
    "$bench_artifact_transaction_report_name" \
    "$bench_artifact_transaction_index_name" \
    "$human_report_name" <<'PY'
import ctypes
import errno
import fcntl
import json
import os
import secrets
import stat
import sys


def identity(value):
    return tuple(map(int, value.split(":")))


def checked_stat(directory_fd, name, expected_kind, expected_identity=None):
    value = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
    if expected_kind == "directory" and not stat.S_ISDIR(value.st_mode):
        raise RuntimeError(f"{name} is not a directory")
    if expected_kind == "file" and not stat.S_ISREG(value.st_mode):
        raise RuntimeError(f"{name} is not a regular file")
    if expected_identity is not None and (value.st_dev, value.st_ino) != expected_identity:
        raise RuntimeError(f"{name} identity changed")
    return value


def rename_no_replace(directory_fd, source, destination):
    libc = ctypes.CDLL(None, use_errno=True)
    renameat2 = libc.renameat2
    renameat2.argtypes = [
        ctypes.c_int,
        ctypes.c_char_p,
        ctypes.c_int,
        ctypes.c_char_p,
        ctypes.c_uint,
    ]
    renameat2.restype = ctypes.c_int
    if renameat2(
        directory_fd,
        os.fsencode(source),
        directory_fd,
        os.fsencode(destination),
        1,
    ) != 0:
        error = ctypes.get_errno()
        if error == errno.EEXIST:
            raise RuntimeError(f"benchmark output appeared during publication: {destination}")
        raise OSError(error, os.strerror(error))


(
    root_path,
    root_identity,
    stage_path,
    stage_identity,
    stage_name,
    artifact_name,
    report_name,
    index_name,
    human_report_name,
) = sys.argv[1:]
root_expected = identity(root_identity)
stage_expected = identity(stage_identity)
directory_flags = os.O_RDONLY | os.O_DIRECTORY
root_fd = os.open(root_path, directory_flags)
stage_fd = os.open(stage_path, directory_flags)
report_source_fd = -1
report_staging_fd = -1
machine_fd = -1
index_fd = -1
report_staging_name = ""
report_staging_identity = None
index_identity = None
index_original_size = 0
index_created = False
index_touched = False
report_published = False
artifact_published = False
try:
    root = os.fstat(root_fd)
    stage = os.fstat(stage_fd)
    if (root.st_dev, root.st_ino) != root_expected:
        raise RuntimeError("benchmark results directory identity changed")
    if (stage.st_dev, stage.st_ino) != stage_expected:
        raise RuntimeError("benchmark artifact staging identity changed")
    checked_stat(root_fd, stage_name, "directory", stage_expected)
    for completed_name in (artifact_name, report_name):
        try:
            os.stat(completed_name, dir_fd=root_fd, follow_symlinks=False)
        except FileNotFoundError:
            pass
        else:
            raise RuntimeError(f"benchmark output already exists: {completed_name}")
    report_source = checked_stat(stage_fd, human_report_name, "file")
    machine_report = checked_stat(stage_fd, "report.json", "file")
    if report_source.st_uid != os.geteuid() or machine_report.st_uid != os.geteuid():
        raise RuntimeError("benchmark report staging files have unsafe ownership")
    report_source_fd = os.open(
        human_report_name, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=stage_fd
    )
    if (os.fstat(report_source_fd).st_dev, os.fstat(report_source_fd).st_ino) != (
        report_source.st_dev,
        report_source.st_ino,
    ):
        raise RuntimeError("benchmark human report identity changed")
    machine_fd = os.open("report.json", os.O_RDONLY | os.O_NOFOLLOW, dir_fd=stage_fd)
    pinned_machine_report = os.fstat(machine_fd)
    if (pinned_machine_report.st_dev, pinned_machine_report.st_ino) != (
        machine_report.st_dev,
        machine_report.st_ino,
    ):
        raise RuntimeError("benchmark machine report identity changed")
    machine_chunks = []
    while True:
        chunk = os.read(machine_fd, 1024 * 1024)
        if not chunk:
            break
        machine_chunks.append(chunk)
    machine_bytes = b"".join(machine_chunks)
    machine_value = json.loads(machine_bytes)
    if not isinstance(machine_value, dict):
        raise RuntimeError("benchmark machine report is not a JSON object")
    index_record = machine_bytes.rstrip(b"\n") + b"\n"
    for _ in range(128):
        report_staging_name = ".bench-report-publish." + secrets.token_hex(16)
        try:
            report_staging_fd = os.open(
                report_staging_name,
                os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                0o644,
                dir_fd=root_fd,
            )
            break
        except FileExistsError:
            continue
    else:
        raise RuntimeError("could not reserve benchmark report staging file")
    report_staging = os.fstat(report_staging_fd)
    report_staging_identity = (report_staging.st_dev, report_staging.st_ino)
    while True:
        chunk = os.read(report_source_fd, 1024 * 1024)
        if not chunk:
            break
        view = memoryview(chunk)
        while view:
            written = os.write(report_staging_fd, view)
            view = view[written:]
    os.fsync(report_staging_fd)
    checked_stat(root_fd, report_staging_name, "file", report_staging_identity)

    try:
        index_entry = os.stat(index_name, dir_fd=root_fd, follow_symlinks=False)
    except FileNotFoundError:
        index_fd = os.open(
            index_name,
            os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
            0o644,
            dir_fd=root_fd,
        )
        index_created = True
    else:
        if not stat.S_ISREG(index_entry.st_mode):
            raise RuntimeError("benchmark report index is not a regular file")
        index_fd = os.open(
            index_name, os.O_WRONLY | os.O_APPEND | os.O_NOFOLLOW, dir_fd=root_fd
        )
        opened_index = os.fstat(index_fd)
        if (opened_index.st_dev, opened_index.st_ino) != (
            index_entry.st_dev,
            index_entry.st_ino,
        ):
            raise RuntimeError("benchmark report index identity changed")
    index = os.fstat(index_fd)
    if not stat.S_ISREG(index.st_mode) or index.st_uid != os.geteuid() or index.st_nlink != 1:
        raise RuntimeError("benchmark report index is unsafe")
    fcntl.flock(index_fd, fcntl.LOCK_EX)
    index = os.fstat(index_fd)
    index_identity = (index.st_dev, index.st_ino)
    index_original_size = index.st_size
    checked_stat(root_fd, index_name, "file", index_identity)
    checked_stat(root_fd, stage_name, "directory", stage_expected)
    checked_stat(stage_fd, human_report_name, "file", (report_source.st_dev, report_source.st_ino))
    checked_stat(stage_fd, "report.json", "file", (machine_report.st_dev, machine_report.st_ino))

    index_touched = True
    view = memoryview(index_record)
    while view:
        written = os.write(index_fd, view)
        view = view[written:]
    os.fsync(index_fd)
    os.unlink(human_report_name, dir_fd=stage_fd)
    os.fsync(stage_fd)
    rename_no_replace(root_fd, report_staging_name, report_name)
    report_published = True
    rename_no_replace(root_fd, stage_name, artifact_name)
    artifact_published = True
    checked_stat(root_fd, report_name, "file", report_staging_identity)
    checked_stat(root_fd, artifact_name, "directory", stage_expected)
    os.fsync(root_fd)
finally:
    if not artifact_published and index_fd >= 0 and index_touched:
        os.ftruncate(index_fd, index_original_size)
        os.fsync(index_fd)
    if not artifact_published and report_published and report_staging_identity is not None:
        try:
            published_report = os.stat(report_name, dir_fd=root_fd, follow_symlinks=False)
        except FileNotFoundError:
            pass
        else:
            if (published_report.st_dev, published_report.st_ino) == report_staging_identity:
                os.unlink(report_name, dir_fd=root_fd)
    if not report_published and report_staging_name and report_staging_identity is not None:
        try:
            staged_report = os.stat(
                report_staging_name, dir_fd=root_fd, follow_symlinks=False
            )
        except FileNotFoundError:
            pass
        else:
            if (staged_report.st_dev, staged_report.st_ino) == report_staging_identity:
                os.unlink(report_staging_name, dir_fd=root_fd)
    if not artifact_published and index_fd >= 0 and index_created and index_identity is not None:
        try:
            current_index = os.stat(index_name, dir_fd=root_fd, follow_symlinks=False)
        except FileNotFoundError:
            pass
        else:
            if (current_index.st_dev, current_index.st_ino) == index_identity:
                os.unlink(index_name, dir_fd=root_fd)
    if index_fd >= 0:
        os.close(index_fd)
    if machine_fd >= 0:
        os.close(machine_fd)
    if report_staging_fd >= 0:
        os.close(report_staging_fd)
    if report_source_fd >= 0:
        os.close(report_source_fd)
    os.close(stage_fd)
    os.close(root_fd)
PY
  then
    bench_close_artifact_transaction_guard abort
    return 1
  fi
  bench_close_artifact_transaction_guard commit
}

bench_publish_candidate_runtime() (
  local artifact_dir="$1"
  local source_candidate="$2"
  local admission_path="$3"
  local trusted_artifact_identity="${4:-}"
  local artifact_fd="" artifact_fd_path="" artifact_identity=""
  local source_fd="" source_fd_path="" source_identity=""
  local staging_path="" staging_name="" staging_fd_path="" staging_identity=""
  local published=0

  artifact_owner_matches() {
    [[ -d "$artifact_fd_path" \
      && "$(stat -Lc '%d:%i' "$artifact_fd_path" 2>/dev/null)" == "$artifact_identity" ]] \
      || return 1
    if [[ -n "$trusted_artifact_identity" ]]; then
      return 0
    fi
    bench_directory_matches_identity "$artifact_dir" "$artifact_fd_path" "$artifact_identity"
  }

  cleanup_candidate_publication() {
    if [[ "$published" == "0" \
      && -n "$artifact_fd_path" \
      && -n "$artifact_identity" \
      && -n "$staging_name" \
      && -n "$staging_identity" ]]; then
      bench_remove_owned_directory \
        "$artifact_fd_path" "$artifact_identity" "$staging_name" "$staging_identity" \
        2>/dev/null || true
      bench_remove_owned_directory \
        "$artifact_fd_path" "$artifact_identity" candidate "$staging_identity" 1 \
        2>/dev/null || true
    fi
    bench_close_pinned_directory
  }
  trap cleanup_candidate_publication EXIT

  if [[ -n "$trusted_artifact_identity" ]]; then
    [[ "$trusted_artifact_identity" =~ ^[0-9]+:[0-9]+$ \
      && -d "$artifact_dir" \
      && "$(stat -Lc '%d:%i' "$artifact_dir" 2>/dev/null)" == "$trusted_artifact_identity" ]] \
      || return 1
    artifact_identity="$trusted_artifact_identity"
  else
    [[ -d "$artifact_dir" && ! -L "$artifact_dir" ]] || return 1
    artifact_dir="$(cd "$artifact_dir" && pwd -P)" || return 1
  fi
  [[ -d "$source_candidate" && ! -L "$source_candidate" ]] || return 1
  source_candidate="$(cd "$source_candidate" && pwd -P)" || return 1
  [[ -f "$admission_path" && ! -L "$admission_path" ]] || return 1
  [[ -z "$(find "$source_candidate" -xdev -type l -print -quit)" ]] || return 1
  [[ ! -e "$artifact_dir/candidate" && ! -L "$artifact_dir/candidate" ]] || return 1

  exec {artifact_fd}<"$artifact_dir" || return 1
  artifact_fd_path="$(bench_directory_fd_path "$artifact_fd")" || return 1
  if [[ -n "$trusted_artifact_identity" ]]; then
    [[ "$(stat -Lc '%d:%i' "$artifact_fd_path" 2>/dev/null)" == "$artifact_identity" ]] \
      || return 1
  else
    artifact_identity="$(stat -Lc '%d:%i' "$artifact_fd_path")" || return 1
  fi
  artifact_owner_matches || return 1

  exec {source_fd}<"$source_candidate" || return 1
  source_fd_path="$(bench_directory_fd_path "$source_fd")" || return 1
  source_identity="$(stat -Lc '%d:%i' "$source_fd_path")" || return 1
  bench_directory_matches_identity "$source_candidate" "$source_fd_path" "$source_identity" \
    || return 1

  staging_path="$(mktemp -d "$artifact_fd_path/.candidate.publish.XXXXXX")" || return 1
  staging_name="${staging_path##*/}"
  [[ "$staging_name" =~ ^[.]candidate[.]publish[.][A-Za-z0-9]+$ ]] || return 1
  [[ -d "$staging_path" && ! -L "$staging_path" ]] || return 1
  bench_pin_owned_directory "$artifact_fd" "$artifact_identity" "$staging_name" || return 1
  staging_fd_path="$bench_pinned_directory_fd_path"
  staging_identity="$bench_pinned_directory_identity"
  bench_directory_matches_identity \
    "$artifact_fd_path/$staging_name" "$staging_fd_path" "$staging_identity" || return 1

  cp -a --no-dereference --no-preserve=ownership -- \
    "$source_fd_path/." "$staging_fd_path/." || return 1
  artifact_owner_matches || return 1
  bench_directory_matches_identity "$source_candidate" "$source_fd_path" "$source_identity" \
    || return 1
  bench_directory_matches_identity \
    "$artifact_fd_path/$staging_name" "$staging_fd_path" "$staging_identity" || return 1
  [[ -z "$(find "$staging_fd_path/." -xdev -type l -print -quit)" ]] || return 1
  bench_candidate_paths_are_runnable \
    "$artifact_dir" "$staging_fd_path/." "$admission_path" "$artifact_identity" || return 1
  [[ ! -e "$artifact_fd_path/candidate" && ! -L "$artifact_fd_path/candidate" ]] || return 1

  bench_publish_owned_directory_noreplace \
    "$artifact_fd_path" "$artifact_identity" "$staging_name" "$staging_identity" candidate \
    || return 1
  [[ -d "$artifact_fd_path/candidate" && ! -L "$artifact_fd_path/candidate" \
    && "$(stat -c '%d:%i' "$artifact_fd_path/candidate" 2>/dev/null)" == "$staging_identity" \
    && "$(stat -Lc '%d:%i' "$staging_fd_path" 2>/dev/null)" == "$staging_identity" ]] \
    || return 1
  bench_candidate_paths_are_runnable \
    "$artifact_dir" "$artifact_fd_path/candidate" "$admission_path" "$artifact_identity" || return 1
  published=1
)

bench_publish_regular_file() (
  local owner_dir="$1"
  local source_file="$2"
  local target_name="$3"
  local trusted_owner_identity="${4:-}"
  local owner_fd owner_fd_path owner_identity
  local source_fd source_fd_path source_identity
  local staging_path="" staging_name="" staging_fd="" staging_fd_path="" staging_identity=""
  local published=0

  owner_matches() {
    [[ -d "$owner_fd_path" \
      && "$(stat -Lc '%d:%i' "$owner_fd_path" 2>/dev/null)" == "$owner_identity" ]] \
      || return 1
    if [[ -n "$trusted_owner_identity" ]]; then
      return 0
    fi
    bench_directory_matches_identity "$owner_dir" "$owner_fd_path" "$owner_identity"
  }

  cleanup_file_publication() {
    [[ "$published" == "0" && -n "$owner_fd_path" && -n "$staging_name" ]] || return 0
    [[ -n "$owner_identity" && -n "$staging_identity" ]] || return 0
    bench_remove_owned_regular_file \
      "$owner_fd_path" "$owner_identity" "$staging_name" "$staging_identity" \
      2>/dev/null || true
  }
  trap cleanup_file_publication EXIT

  [[ "$target_name" =~ ^[A-Za-z0-9._-]+$ ]] || return 1
  if [[ -n "$trusted_owner_identity" ]]; then
    [[ "$trusted_owner_identity" =~ ^[0-9]+:[0-9]+$ \
      && -d "$owner_dir" \
      && "$(stat -Lc '%d:%i' "$owner_dir" 2>/dev/null)" == "$trusted_owner_identity" ]] \
      || return 1
  else
    [[ -d "$owner_dir" && ! -L "$owner_dir" ]] || return 1
    owner_dir="$(cd "$owner_dir" && pwd -P)" || return 1
  fi
  [[ -f "$source_file" && ! -L "$source_file" ]] || return 1

  exec {owner_fd}<"$owner_dir" || return 1
  owner_fd_path="$(bench_directory_fd_path "$owner_fd")" || return 1
  if [[ -n "$trusted_owner_identity" ]]; then
    owner_identity="$trusted_owner_identity"
  else
    owner_identity="$(stat -Lc '%d:%i' "$owner_fd_path")" || return 1
  fi
  owner_matches || return 1
  if [[ -e "$owner_fd_path/$target_name" || -L "$owner_fd_path/$target_name" ]]; then
    [[ -f "$owner_fd_path/$target_name" && ! -L "$owner_fd_path/$target_name" ]] || return 1
  fi

  exec {source_fd}<"$source_file" || return 1
  source_fd_path="$(bench_fd_path "$source_fd")" || return 1
  source_identity="$(stat -Lc '%d:%i' "$source_fd_path")" || return 1
  [[ "$(stat -c '%d:%i' "$source_file" 2>/dev/null)" == "$source_identity" ]] || return 1

  staging_path="$(mktemp "$owner_fd_path/.${target_name}.publish.XXXXXX")" || return 1
  staging_name="${staging_path##*/}"
  [[ -f "$staging_path" && ! -L "$staging_path" ]] || return 1
  exec {staging_fd}<"$staging_path" || return 1
  staging_fd_path="$(bench_fd_path "$staging_fd")" || return 1
  staging_identity="$(stat -Lc '%d:%i' "$staging_fd_path")" || return 1
  [[ "$(stat -c '%d:%i' "$owner_fd_path/$staging_name" 2>/dev/null)" == "$staging_identity" ]] \
    || return 1

  cat "$source_fd_path" > "$staging_fd_path" || return 1
  cmp -s "$source_fd_path" "$staging_fd_path" || return 1
  owner_matches || return 1
  [[ "$(stat -c '%d:%i' "$source_file" 2>/dev/null)" == "$source_identity" ]] || return 1
  [[ "$(stat -c '%d:%i' "$owner_fd_path/$staging_name" 2>/dev/null)" == "$staging_identity" ]] \
    || return 1

  python3 - \
    "$owner_fd_path" "$owner_identity" "$staging_name" "$staging_identity" "$target_name" <<'PY'
import os
import stat
import sys

owner, owner_identity, source_name, source_identity, target_name = sys.argv[1:]
owner_dev, owner_ino = map(int, owner_identity.split(":"))
source_dev, source_ino = map(int, source_identity.split(":"))
flags = os.O_RDONLY | os.O_DIRECTORY
owner_fd = os.open(owner, flags)
try:
    owner_stat = os.fstat(owner_fd)
    if (owner_stat.st_dev, owner_stat.st_ino) != (owner_dev, owner_ino):
        raise RuntimeError("publication owner directory identity changed")
    source_stat = os.stat(source_name, dir_fd=owner_fd, follow_symlinks=False)
    if not stat.S_ISREG(source_stat.st_mode):
        raise RuntimeError("publication staging entry is not a regular file")
    if (source_stat.st_dev, source_stat.st_ino) != (source_dev, source_ino):
        raise RuntimeError("publication staging file identity changed")
    try:
        target_stat = os.stat(target_name, dir_fd=owner_fd, follow_symlinks=False)
    except FileNotFoundError:
        pass
    else:
        if not stat.S_ISREG(target_stat.st_mode):
            raise RuntimeError("publication target is not a regular file")
    os.replace(source_name, target_name, src_dir_fd=owner_fd, dst_dir_fd=owner_fd)
    published_stat = os.stat(target_name, dir_fd=owner_fd, follow_symlinks=False)
    if not stat.S_ISREG(published_stat.st_mode):
        raise RuntimeError("published target is not a regular file")
    if (published_stat.st_dev, published_stat.st_ino) != (source_dev, source_ino):
        raise RuntimeError("published file identity differs from staging")
finally:
    os.close(owner_fd)
PY
  [[ "$(stat -c '%d:%i' "$owner_fd_path/$target_name" 2>/dev/null)" == "$staging_identity" ]] \
    || return 1
  cmp -s "$source_fd_path" "$owner_fd_path/$target_name" || return 1
  published=1
)

