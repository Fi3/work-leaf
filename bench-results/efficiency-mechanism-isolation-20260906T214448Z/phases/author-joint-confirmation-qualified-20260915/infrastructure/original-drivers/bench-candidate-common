    || bench_runtime_fail "candidate checkout is not clean at the expected final commit" || return $?

  root_manifest="$checkout_dir/Cargo.toml"
  [[ -f "$root_manifest" && ! -L "$root_manifest" ]] \
    || bench_runtime_fail "candidate checkout has no regular root Cargo manifest" || return $?
  metadata_path="$runtime_work_dir/cargo-metadata.json"
  : > "$build_log" || bench_runtime_fail "candidate build log could not be created" || return $?
  if ! (
    cd "$checkout_dir"
    export CARGO_TARGET_DIR="$target_dir"
    export TMPDIR="$build_tmp"
    "$cargo_bin" metadata --no-deps --format-version 1 --locked
  ) > "$metadata_path" 2>> "$build_log"; then
    bench_runtime_fail "candidate Cargo metadata failed" "candidate_metadata_failed"
    return $?
  fi
  target_manifest="$candidate_dir/SOURCE_TARGETS.json"
  if ! jq -e --arg manifest "$root_manifest" '
    [
      .packages[]
      | select(.manifest_path == $manifest)
    ] as $packages
    | select($packages | length == 1)
    | [
        $packages[0].targets[]
        | select(.kind | index("bin"))
        | .name
      ]
    | sort
    | select(length > 0)
    | select(index("work-leaf") != null)
    | select(. == unique)
    | select(all(.[]; type == "string" and test("^[A-Za-z0-9._-]+$")))
  ' "$metadata_path" > "$target_manifest"; then
    bench_runtime_fail \
      "candidate Cargo metadata has no unambiguous Work Leaf binary target set" \
      "invalid_candidate_targets"
    return $?
  fi
  mapfile -t target_names < <(jq -r '.[]' "$target_manifest")
  [[ "${#target_names[@]}" -gt 0 ]] \
    || bench_runtime_fail "candidate Cargo target set is empty" "invalid_candidate_targets" \
    || return $?
  bench_checkout_matches_commit "$checkout_dir" "$expected_commit" \
    || bench_runtime_fail "candidate source changed during metadata inspection" || return $?

  if ! (
    cd "$checkout_dir"
    export CARGO_TARGET_DIR="$target_dir"
    export TMPDIR="$build_tmp"
    "$cargo_bin" build --release --locked --bins
  ) >> "$build_log" 2>&1; then
    bench_runtime_fail "candidate release compilation failed"
    return $?
  fi
  for executable_name in "${target_names[@]}"; do
    executable_path="$target_dir/release/$executable_name"
    [[ -f "$executable_path" && ! -L "$executable_path" && -x "$executable_path" ]] \
      || bench_runtime_fail \
        "candidate build omitted declared executable $executable_name" \
        "incomplete_candidate_runtime" \
      || return $?
  done
  bench_checkout_matches_commit "$checkout_dir" "$expected_commit" \
    || bench_runtime_fail "candidate source changed during compilation" || return $?

  mkdir "$candidate_dir/bin" \
    || bench_runtime_fail "candidate executable staging directory could not be created" || return $?
  executable_records="$runtime_work_dir/executables.jsonl"
  : > "$executable_records"
  : > "$candidate_dir/SHA256SUMS"
  for executable_name in "${target_names[@]}"; do
    executable_path="$candidate_dir/bin/$executable_name"
    cp "$target_dir/release/$executable_name" "$executable_path" \
      || bench_runtime_fail "candidate executable staging failed" || return $?
    chmod 0755 "$executable_path" \
      || bench_runtime_fail "candidate executable mode could not be set" || return $?
    executable_digest="$(bench_sha256_file "$executable_path")" \
      || bench_runtime_fail "candidate executable digest failed" || return $?
    printf '%s  bin/%s\n' "$executable_digest" "$executable_name" \
      >> "$candidate_dir/SHA256SUMS"
    jq -cn \
      --arg path "candidate/bin/$executable_name" \
      --arg sha256 "$executable_digest" \
      '{path:$path,sha256:$sha256}' >> "$executable_records"
  done
  bench_runtime_executables="$(jq -sc 'sort_by(.path)' "$executable_records")" \
    || bench_runtime_fail "candidate executable manifest generation failed" || return $?
  bench_runtime_entrypoint_digest="$(
    jq -er '.[] | select(.path == "candidate/bin/work-leaf") | .sha256' \
      <<< "$bench_runtime_executables"
  )" || bench_runtime_fail "candidate entrypoint digest is unavailable" || return $?

  smoke_project="$runtime_work_dir/smoke-project"
  mkdir "$smoke_project" \
    || bench_runtime_fail "candidate smoke project directory could not be created" || return $?
  git -C "$smoke_project" init --quiet \
    || bench_runtime_fail "candidate smoke project initialization failed" || return $?
  git -C "$smoke_project" \
    -c user.name='Work Leaf Candidate Smoke' \
    -c user.email='candidate-smoke@invalid' \
    commit --quiet --allow-empty -m 'candidate smoke fixture' \
    || bench_runtime_fail "candidate smoke project commit failed" || return $?
  smoke_stdout="$candidate_dir/SMOKE.stdout"
  smoke_stderr="$candidate_dir/SMOKE.stderr"
  if ! (
    cd "$smoke_project"
    printf 'quit\n' \
      | timeout --kill-after=5s 20s \
        env -u WORK_LEAF_IN_PROCESS -u WORK_LEAF_ORCHESTRATOR_URL \
        WORK_LEAF_START_LISTEN=127.0.0.1:0 \
        "$candidate_dir/bin/work-leaf"
  ) > "$smoke_stdout" 2> "$smoke_stderr"; then
    bench_runtime_fail \
      "staged candidate failed bounded scripted startup" \
      "candidate_smoke_failed"
    return $?
  fi
  bench_checkout_matches_commit "$checkout_dir" "$expected_commit" \
    || bench_runtime_fail "candidate source changed during staged startup" || return $?

  bench_runtime_target_manifest_digest="$(bench_sha256_file "$target_manifest")" \
    || bench_runtime_fail "candidate target manifest digest failed" || return $?
  bench_runtime_smoke_stdout_digest="$(bench_sha256_file "$smoke_stdout")" \
    || bench_runtime_fail "candidate smoke stdout digest failed" || return $?
  bench_runtime_smoke_stderr_digest="$(bench_sha256_file "$smoke_stderr")" \
    || bench_runtime_fail "candidate smoke stderr digest failed" || return $?
  bench_runtime_stdin_digest="$(printf 'quit\n' | sha256sum | awk '{print $1}')"
  [[ "$bench_runtime_stdin_digest" =~ ^[0-9a-f]{64}$ ]] \
    || bench_runtime_fail "candidate smoke stdin digest failed" || return $?
}

bench_candidate_is_runnable() {
  local artifact_dir="$1"
  local provenance_path="$artifact_dir/candidate/PROVENANCE"
  local schema report_path
  bench_path_has_private_publication_component "$artifact_dir" && return 1
  [[ -f "$provenance_path" && ! -L "$provenance_path" ]] || return 1
  schema="$(jq -er '.schema | select(type == "string")' "$provenance_path")" || return 1
  case "$schema" in
    "$bench_candidate_schema")
      report_path="$artifact_dir/report.json"
      ;;
    "$bench_materialized_candidate_schema")
      report_path="$artifact_dir/candidate/$bench_materialized_admission_name"
      ;;
    *)
      return 1
      ;;
  esac
  bench_candidate_paths_are_runnable \
    "$artifact_dir" \
    "$artifact_dir/candidate" \
    "$report_path"
}

bench_candidate_paths_are_runnable() {
  local artifact_dir="$1"
  local candidate_dir="$2"
  local report_path="$3"
  local trusted_artifact_identity="${4:-}"
  local provenance_path checksums_path
  local provenance schema entrypoint executable_path executable_relative executable_digest
  local expected_count actual_count actual_name expected_name index
  local source_commit materialization bundle_path final_log_path source_report_path
  local format_patches_path target_manifest_path target_manifest_digest smoke_stdout_path smoke_stderr_path
  local expected_patch_digest patch_relative_path patch_path
  local bundle_commit bundle_ref bundle_extra saved_final saved_subject
  local -a bundle_heads=() actual_names=() expected_names=()

  if [[ -n "$trusted_artifact_identity" ]]; then
    [[ "$trusted_artifact_identity" =~ ^[0-9]+:[0-9]+$ \
      && -d "$artifact_dir" \
      && "$(stat -Lc '%d:%i' "$artifact_dir" 2>/dev/null)" == "$trusted_artifact_identity" ]] \
      || return 1
  else
    [[ -d "$artifact_dir" && ! -L "$artifact_dir" ]] || return 1
    artifact_dir="$(cd "$artifact_dir" && pwd -P)" || return 1
  fi
  provenance_path="$candidate_dir/PROVENANCE"
  checksums_path="$candidate_dir/SHA256SUMS"
  [[ -d "$candidate_dir" && ! -L "$candidate_dir" ]] || return 1
  [[ -d "$candidate_dir/bin" && ! -L "$candidate_dir/bin" ]] || return 1
  [[ -f "$provenance_path" && ! -L "$provenance_path" ]] || return 1
  [[ -f "$checksums_path" && ! -L "$checksums_path" ]] || return 1
  [[ -f "$report_path" && ! -L "$report_path" ]] || return 1

  schema="$(jq -er '.schema | select(type == "string")' "$provenance_path")" || return 1
  if [[ "$schema" == "$bench_candidate_schema" ]]; then
    provenance="$(jq -ce \
      --arg schema "$bench_candidate_schema" \
      --arg smoke_schema "$bench_candidate_smoke_schema" '
      select(
        type == "object"
        and keys == ["entrypoint", "executables", "schema", "smoke", "source_commit", "targets"]
        and .schema == $schema
        and .entrypoint == "candidate/bin/work-leaf"
        and (.source_commit | type == "string" and test("^([0-9a-f]{40}|[0-9a-f]{64})$"))
        and (.executables | type == "array" and length > 0)
        and all(
          .executables[];
          type == "object"
          and keys == ["path", "sha256"]
          and (.path | type == "string" and test("^candidate/bin/[A-Za-z0-9._-]+$"))
          and (.sha256 | type == "string" and test("^[0-9a-f]{64}$"))
        )
        and ([.executables[].path] | unique | length) == (.executables | length)
        and [.executables[].path] == ([.executables[].path] | sort)
        and (.entrypoint as $entrypoint | [.executables[].path] | index($entrypoint)) != null
        and (.targets | type == "object" and keys == ["path", "sha256"])
        and .targets.path == "candidate/SOURCE_TARGETS.json"
        and (.targets.sha256 | type == "string" and test("^[0-9a-f]{64}$"))
        and (.smoke | type == "object")
        and (.smoke | keys) == [
          "command",
          "exit_code",
          "gate",
          "schema",
          "stderr",
          "stdin_sha256",
          "stdout",
          "timeout_seconds"
        ]
        and .smoke.schema == $smoke_schema
        and .smoke.gate == "bounded-startup-quit"
        and .smoke.command == ["candidate/bin/work-leaf"]
        and .smoke.exit_code == 0
        and .smoke.timeout_seconds == 20
        and (.smoke.stdin_sha256 | type == "string" and test("^[0-9a-f]{64}$"))
        and (.smoke.stdout | type == "object" and keys == ["path", "sha256"])
        and .smoke.stdout.path == "candidate/SMOKE.stdout"
        and (.smoke.stdout.sha256 | type == "string" and test("^[0-9a-f]{64}$"))
        and (.smoke.stderr | type == "object" and keys == ["path", "sha256"])
        and .smoke.stderr.path == "candidate/SMOKE.stderr"
        and (.smoke.stderr.sha256 | type == "string" and test("^[0-9a-f]{64}$"))
      )
    ' "$provenance_path")" || return 1
  elif [[ "$schema" == "$bench_materialized_candidate_schema" ]]; then
    provenance="$(jq -ce \
      --arg schema "$bench_materialized_candidate_schema" \
      --arg materialization_schema "$bench_materialization_schema" \
      --arg smoke_schema "$bench_candidate_smoke_schema" \
      --arg historical_smoke_schema "$bench_historical_candidate_smoke_schema" \
      --arg historical_smoke_gate "$bench_historical_candidate_smoke_gate" '
      select(
        type == "object"
        and keys == ["entrypoint", "executables", "materialization", "schema", "smoke", "source_commit"]
        and .schema == $schema
        and .entrypoint == "candidate/bin/work-leaf"
        and (.source_commit | type == "string" and test("^([0-9a-f]{40}|[0-9a-f]{64})$"))
        and (.executables | type == "array" and length > 0)
        and all(
          .executables[];
          type == "object"
          and keys == ["path", "sha256"]
          and (.path | type == "string" and test("^candidate/bin/[A-Za-z0-9._-]+$"))
          and (.sha256 | type == "string" and test("^[0-9a-f]{64}$"))
        )
        and ([.executables[].path] | unique | length) == (.executables | length)
        and [.executables[].path] == ([.executables[].path] | sort)
        and (.entrypoint as $entrypoint | [.executables[].path] | index($entrypoint)) != null
        and (.smoke | type == "object")
        and (.smoke | keys) == [
          "command",
          "exit_code",
          "gate",
          "schema",
          "stderr",
          "stdin_sha256",
          "stdout",
          "timeout_seconds"
        ]
        and (
          (
            .smoke.schema == $smoke_schema
            and .smoke.gate == "bounded-startup-quit"
          )
          or (
            .smoke.schema == $historical_smoke_schema
            and .smoke.gate == $historical_smoke_gate
          )
        )
        and .smoke.command == ["candidate/bin/work-leaf"]
        and .smoke.exit_code == 0
        and .smoke.timeout_seconds == 20
        and (.smoke.stdin_sha256 | type == "string" and test("^[0-9a-f]{64}$"))
        and (.smoke.stdout | type == "object" and keys == ["path", "sha256"])
        and .smoke.stdout.path == "candidate/SMOKE.stdout"
        and (.smoke.stdout.sha256 | type == "string" and test("^[0-9a-f]{64}$"))
        and (.smoke.stderr | type == "object" and keys == ["path", "sha256"])
        and .smoke.stderr.path == "candidate/SMOKE.stderr"
        and (.smoke.stderr.sha256 | type == "string" and test("^[0-9a-f]{64}$"))
        and (.materialization | type == "object")
        and (.materialization | keys) == [
          "base_commit",
          "bundle",
          "bundle_sha256",
          "changed_files",
          "commits_after_base",
          "final_log",
          "final_log_sha256",
          "format_patches",
          "format_patches_sha256",
          "schema",
          "source_report",
          "source_report_sha256",
          "targets",
          "targets_sha256"
        ]
        and .materialization.schema == $materialization_schema
        and (.materialization.base_commit | type == "string" and test("^([0-9a-f]{40}|[0-9a-f]{64})$"))
        and .materialization.bundle == "patches/pass/commits.bundle"
        and (.materialization.bundle_sha256 | type == "string" and test("^[0-9a-f]{64}$"))
        and .materialization.final_log == "final-log.txt"
        and (.materialization.final_log_sha256 | type == "string" and test("^[0-9a-f]{64}$"))
        and .materialization.format_patches == "candidate/SOURCE_PATCHES.json"
        and (.materialization.format_patches_sha256 | type == "string" and test("^[0-9a-f]{64}$"))
        and .materialization.source_report == "candidate/SOURCE_REPORT.json"
        and (.materialization.source_report_sha256 | type == "string" and test("^[0-9a-f]{64}$"))
        and .materialization.targets == "candidate/SOURCE_TARGETS.json"
        and (.materialization.targets_sha256 | type == "string" and test("^[0-9a-f]{64}$"))
        and ((.materialization.commits_after_base | type) == "number")
        and .materialization.commits_after_base > 0
        and .materialization.commits_after_base == (.materialization.commits_after_base | floor)
        and ((.materialization.changed_files | type) == "number")
        and .materialization.changed_files > 0
        and .materialization.changed_files == (.materialization.changed_files | floor)
      )
    ' "$provenance_path")" || return 1

  else
    return 1
  fi

  entrypoint="$(jq -r '.entrypoint' <<< "$provenance")" || return 1
  [[ "$entrypoint" == "candidate/bin/work-leaf" ]] || return 1
  cmp -s \
    <(jq -r '.executables[] | "\(.sha256)  \(.path | sub("^candidate/"; ""))"' <<< "$provenance") \
    "$checksums_path" || return 1
  while IFS=$'\t' read -r executable_path executable_digest; do
    executable_relative="${executable_path#candidate/}"
    executable_path="$candidate_dir/$executable_relative"
    [[ -f "$executable_path" && ! -L "$executable_path" && -x "$executable_path" ]] || return 1
    [[ "$(bench_sha256_file "$executable_path")" == "$executable_digest" ]] || return 1
  done < <(jq -r '.executables[] | [.path, .sha256] | @tsv' <<< "$provenance")
  mapfile -t expected_names < <(jq -r '.executables[].path | sub("^candidate/bin/"; "")' <<< "$provenance")
  mapfile -t actual_names < <(find "$candidate_dir/bin" -mindepth 1 -maxdepth 1 -printf '%f\n' | sort)
  expected_count="${#expected_names[@]}"
  actual_count="${#actual_names[@]}"
  [[ "$actual_count" -eq "$expected_count" ]] || return 1
  for index in "${!expected_names[@]}"; do
    expected_name="${expected_names[$index]}"
    actual_name="${actual_names[$index]}"
    [[ "$actual_name" == "$expected_name" ]] || return 1
  done

  target_manifest_path="$candidate_dir/SOURCE_TARGETS.json"
  smoke_stdout_path="$candidate_dir/SMOKE.stdout"
  smoke_stderr_path="$candidate_dir/SMOKE.stderr"
  [[ -f "$target_manifest_path" && ! -L "$target_manifest_path" ]] || return 1
  [[ -f "$smoke_stdout_path" && ! -L "$smoke_stdout_path" ]] || return 1
  [[ -f "$smoke_stderr_path" && ! -L "$smoke_stderr_path" ]] || return 1
  if [[ "$schema" == "$bench_candidate_schema" ]]; then
    target_manifest_digest="$(jq -r '.targets.sha256' <<< "$provenance")" || return 1
  else
    target_manifest_digest="$(jq -r '.materialization.targets_sha256' <<< "$provenance")" \
      || return 1
  fi
  [[ "$(bench_sha256_file "$target_manifest_path")" == "$target_manifest_digest" ]] || return 1
  [[ "$(bench_sha256_file "$smoke_stdout_path")" == "$(jq -r '.smoke.stdout.sha256' <<< "$provenance")" ]] \
    || return 1
  [[ "$(bench_sha256_file "$smoke_stderr_path")" == "$(jq -r '.smoke.stderr.sha256' <<< "$provenance")" ]] \
    || return 1
  [[ "$(printf 'quit\n' | sha256sum | awk '{print $1}')" == "$(jq -r '.smoke.stdin_sha256' <<< "$provenance")" ]] \
    || return 1
  jq -e --argjson paths "$(jq '[.executables[].path | sub("^candidate/bin/"; "")]' <<< "$provenance")" '
    type == "array"
    and length > 0
    and all(.[]; type == "string" and test("^[A-Za-z0-9._-]+$"))
    and . == (sort | unique)
    and . == $paths
  ' "$target_manifest_path" >/dev/null || return 1

  if [[ "$schema" == "$bench_materialized_candidate_schema" ]]; then
    materialization="$(jq -ce '.materialization' <<< "$provenance")" || return 1
    source_commit="$(jq -r '.source_commit' <<< "$provenance")" || return 1
    bundle_path="$artifact_dir/$(jq -r '.bundle' <<< "$materialization")"
    final_log_path="$artifact_dir/$(jq -r '.final_log' <<< "$materialization")"
    format_patches_path="$candidate_dir/SOURCE_PATCHES.json"
    source_report_path="$candidate_dir/SOURCE_REPORT.json"
    target_manifest_path="$candidate_dir/SOURCE_TARGETS.json"
    smoke_stdout_path="$candidate_dir/SMOKE.stdout"
    smoke_stderr_path="$candidate_dir/SMOKE.stderr"
    [[ -d "$artifact_dir/patches" && ! -L "$artifact_dir/patches" ]] || return 1
    [[ -d "$artifact_dir/patches/pass" && ! -L "$artifact_dir/patches/pass" ]] || return 1
    [[ -d "$artifact_dir/patches/pass/format-patch" \
      && ! -L "$artifact_dir/patches/pass/format-patch" ]] || return 1
    [[ -f "$bundle_path" && ! -L "$bundle_path" ]] || return 1
    [[ -f "$final_log_path" && ! -L "$final_log_path" ]] || return 1
    [[ -f "$format_patches_path" && ! -L "$format_patches_path" ]] || return 1
    [[ -f "$source_report_path" && ! -L "$source_report_path" ]] || return 1
    [[ -f "$target_manifest_path" && ! -L "$target_manifest_path" ]] || return 1
    [[ -f "$smoke_stdout_path" && ! -L "$smoke_stdout_path" ]] || return 1
    [[ -f "$smoke_stderr_path" && ! -L "$smoke_stderr_path" ]] || return 1
    [[ "$(bench_sha256_file "$bundle_path")" == "$(jq -r '.bundle_sha256' <<< "$materialization")" ]] \
      || return 1
    [[ "$(bench_sha256_file "$final_log_path")" == "$(jq -r '.final_log_sha256' <<< "$materialization")" ]] \
      || return 1
    [[ "$(bench_sha256_file "$format_patches_path")" == "$(jq -r '.format_patches_sha256' <<< "$materialization")" ]] \
      || return 1
    [[ "$(bench_sha256_file "$source_report_path")" == "$(jq -r '.source_report_sha256' <<< "$materialization")" ]] \
      || return 1
    [[ "$(bench_sha256_file "$target_manifest_path")" == "$(jq -r '.targets_sha256' <<< "$materialization")" ]] \
      || return 1
    [[ "$(bench_sha256_file "$smoke_stdout_path")" == "$(jq -r '.smoke.stdout.sha256' <<< "$provenance")" ]] \
      || return 1
    [[ "$(bench_sha256_file "$smoke_stderr_path")" == "$(jq -r '.smoke.stderr.sha256' <<< "$provenance")" ]] \
      || return 1
    [[ "$(printf 'quit\n' | sha256sum | awk '{print $1}')" == "$(jq -r '.smoke.stdin_sha256' <<< "$provenance")" ]] \
      || return 1
    jq -e --argjson paths "$(jq '[.executables[].path | sub("^candidate/bin/"; "")]' <<< "$provenance")" '
      type == "array"
      and length > 0
      and all(.[]; type == "string" and test("^[A-Za-z0-9._-]+$"))
      and . == (sort | unique)
      and . == $paths
    ' "$target_manifest_path" >/dev/null || return 1
    jq -e --argjson count "$(jq '.commits_after_base' <<< "$materialization")" '
      type == "array"
      and length == $count
      and all(
        .[];
        type == "object"
        and keys == ["path", "sha256"]
        and (.path | type == "string" and test("^patches/pass/format-patch/[A-Za-z0-9._-]+[.]patch$"))
        and (.sha256 | type == "string" and test("^[0-9a-f]{64}$"))
      )
      and ([.[].path] | unique | length) == $count
    ' "$format_patches_path" >/dev/null || return 1
    while IFS=$'\t' read -r expected_patch_digest patch_relative_path; do
      patch_path="$artifact_dir/$patch_relative_path"
      [[ -f "$patch_path" && ! -L "$patch_path" ]] || return 1
      [[ "$(bench_sha256_file "$patch_path")" == "$expected_patch_digest" ]] || return 1
    done < <(jq -r '.[] | [.sha256, .path] | @tsv' "$format_patches_path")
    read -r saved_final saved_subject < "$final_log_path" || return 1
    [[ "$saved_final" =~ ^[0-9a-f]{7,64}$ && "$source_commit" == "$saved_final"* ]] || return 1
    mapfile -t bundle_heads < <(git bundle list-heads "$bundle_path" 2>/dev/null) || return 1
    [[ "${#bundle_heads[@]}" -eq 1 ]] || return 1
    read -r bundle_commit bundle_ref bundle_extra <<< "${bundle_heads[0]}"
    [[ "$bundle_commit" == "$source_commit" && "$bundle_ref" == "HEAD" && -z "$bundle_extra" ]] \
      || return 1
    jq -e \
      --arg patch_artifacts "$artifact_dir/patches/pass" \
      --argjson materialization "$materialization" '
      type == "object"
      and .result == "pass"
      and (.run_id | type == "string" and length > 0)
      and .base_commit == $materialization.base_commit
      and .worktree_source_commit == $materialization.base_commit
      and .worktree_source_dirty == "no"
      and .patch_artifacts == $patch_artifacts
      and .commits_after_base == $materialization.commits_after_base
      and .changed_files == $materialization.changed_files
    ' "$source_report_path" >/dev/null || return 1
  fi

  jq -e \
    --arg materialized_schema "$bench_materialized_candidate_schema" \
    --argjson candidate "$provenance" '
    type == "object"
    and .result == "pass"
    and (.run_id | type == "string" and length > 0)
    and ((.commits_after_base | type) == "number")
    and .commits_after_base > 0
    and .commits_after_base == (.commits_after_base | floor)
    and ((.changed_files | type) == "number")
    and .changed_files > 0
    and .changed_files == (.changed_files | floor)
    and .candidate == $candidate
    and (
      $candidate.schema != $materialized_schema
      or .materialization == $candidate.materialization
    )
  ' "$report_path" >/dev/null
}
