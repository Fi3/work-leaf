bench_path_has_private_publication_component() {
  local path="$1"
  local component
  local -a components=()
  IFS='/' read -r -a components <<< "$path"
  for component in "${components[@]}"; do
    case "$component" in
      .bench-artifact-publish.*|.candidate.publish.*|.candidate.materialize.*) return 0 ;;
    esac
  done
  return 1
}

bench_sha256_file() {
  local path="$1"
  local digest
  digest="$(sha256sum "$path" | awk '{print $1}')" || return 1
  [[ "$digest" =~ ^[0-9a-f]{64}$ ]] || return 1
  printf '%s\n' "$digest"
}

