+
+fn spans_for_ranges(line: &str, ranges: &[(usize, usize)]) -> Spans<'static> {
+    if ranges.is_empty() {
+        return Spans::from(vec![Span::raw(line.to_string())]);
+    }
+
+    let chars = line.chars().collect::<Vec<_>>();
+    let mut spans = Vec::new();
+    let mut position = 0;
+    for (start, end) in merged_ranges(ranges, chars.len()) {
+        if position < start {
+            spans.push(Span::raw(chars[position..start].iter().collect::<String>()));
+        }
+        if start < end {
+            spans.push(Span::styled(
+                chars[start..end].iter().collect::<String>(),
+                reversed_style(),
+            ));
+        }
+        position = end;
+    }
+    if position < chars.len() {
+        spans.push(Span::raw(chars[position..].iter().collect::<String>()));
+    }
+    Spans::from(spans)
+}
+
+fn merged_ranges(ranges: &[(usize, usize)], line_len: usize) -> Vec<(usize, usize)> {
+    let mut ranges = ranges
+        .iter()
+        .filter_map(|(start, end)| {
+            let start = (*start).min(line_len);
+            let end = (*end).min(line_len);
+            (start < end).then_some((start, end))
+        })
+        .collect::<Vec<_>>();
+    ranges.sort_unstable();
+
+    let mut merged: Vec<(usize, usize)> = Vec::new();
+    for (start, end) in ranges {
+        if let Some((_, last_end)) = merged.last_mut()
+            && start <= *last_end
+        {
+            *last_end = (*last_end).max(end);
+            continue;
+        }
+        merged.push((start, end));
+    }
+    merged
+}
+
+fn ordered_positions(left: TextPosition, right: TextPosition) -> (TextPosition, TextPosition) {
+    if (left.line, left.column) <= (right.line, right.column) {
+        (left, right)
+    } else {
+        (right, left)
+    }
+}
+
+fn moved_text_position(
+    position: TextPosition,
+    line_delta: isize,
+    column_delta: isize,
+    lines: &[String],
+) -> TextPosition {
+    let max_line = lines.len().saturating_sub(1);
+    let line = position
+        .line
+        .saturating_add_signed(line_delta)
+        .min(max_line);
+    let max_column = line_char_len(&lines[line]).saturating_sub(1);
+    let column = position
+        .column
+        .saturating_add_signed(column_delta)
+        .min(max_column);
+    TextPosition { line, column }
+}
+
+fn clamp_text_position(position: TextPosition, lines: &[String]) -> TextPosition {
+    let max_line = lines.len().saturating_sub(1);
+    let line = position.line.min(max_line);
+    let column = position
+        .column
+        .min(line_char_len(&lines[line]).saturating_sub(1));
+    TextPosition { line, column }
+}
+
+fn copy_visual_text(lines: &[String], selection: &VisualSelection, force_linewise: bool) -> String {
+    let (start, end) = ordered_positions(selection.anchor, selection.cursor);
+    if force_linewise || selection.kind == VisualKind::Line {
+        return lines[start.line..=end.line].join("\n");
+    }
+
+    match selection.kind {
+        VisualKind::Character => copy_character_selection(lines, start, end),
+        VisualKind::Line => lines[start.line..=end.line].join("\n"),
+        VisualKind::Block => copy_block_selection(lines, selection.anchor, selection.cursor),
+    }
+}
+
+fn copy_character_selection(lines: &[String], start: TextPosition, end: TextPosition) -> String {
+    if start.line == end.line {
+        return slice_chars(
+            &lines[start.line],
+            start.column,
+            end.column.saturating_add(1),
+        );
+    }
+
+    let mut copied = Vec::new();
+    copied.push(slice_chars(
+        &lines[start.line],
+        start.column,
+        line_char_len(&lines[start.line]),
+    ));
+    for line in &lines[start.line + 1..end.line] {
+        copied.push(line.clone());
+    }
+    copied.push(slice_chars(
+        &lines[end.line],
+        0,
+        end.column.saturating_add(1),
+    ));
+    copied.join("\n")
+}
+
+fn copy_block_selection(lines: &[String], anchor: TextPosition, cursor: TextPosition) -> String {
+    let start_line = anchor.line.min(cursor.line);
+    let end_line = anchor.line.max(cursor.line);
+    let start_column = anchor.column.min(cursor.column);
+    let end_column = anchor.column.max(cursor.column).saturating_add(1);
+    lines[start_line..=end_line]
+        .iter()
+        .map(|line| slice_chars(line, start_column, end_column))
+        .collect::<Vec<_>>()
+        .join("\n")
+}
+
+fn line_range(
+    line_index: usize,
+    start_line: usize,
+    end_line: usize,
+    line_len: usize,
+) -> Vec<(usize, usize)> {
+    if (start_line..=end_line).contains(&line_index) {
+        vec![(0, line_len)]
+    } else {
+        Vec::new()
+    }
+}
+
+fn character_range(
+    line_index: usize,
+    start: TextPosition,
+    end: TextPosition,
+    line_len: usize,
+) -> Option<(usize, usize)> {
+    if line_index < start.line || line_index > end.line {
+        return None;
+    }
+    if start.line == end.line {
+        return Some((start.column, end.column.saturating_add(1)));
+    }
+    if line_index == start.line {
+        Some((start.column, line_len))
+    } else if line_index == end.line {
+        Some((0, end.column.saturating_add(1)))
+    } else {
+        Some((0, line_len))
+    }
+}
+
+fn block_range(
+    line_index: usize,
+    anchor: TextPosition,
+    cursor: TextPosition,
+    line_len: usize,
+) -> Option<(usize, usize)> {
+    let start_line = anchor.line.min(cursor.line);
+    let end_line = anchor.line.max(cursor.line);
+    if !(start_line..=end_line).contains(&line_index) {
+        return None;
+    }
+    let start_column = anchor.column.min(cursor.column).min(line_len);
+    let end_column = anchor.column.max(cursor.column).saturating_add(1);
+    Some((start_column, end_column))
+}
+
+fn slice_chars(line: &str, start: usize, end: usize) -> String {
+    line.chars()
+        .skip(start)
+        .take(end.saturating_sub(start))
+        .collect()
+}
+
+fn line_char_len(line: &str) -> usize {
+    line.chars().count()
+}
