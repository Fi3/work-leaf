+#[test]
+fn scripted_harness_visual_character_mode_highlights_and_copies_right_pane_text() {
+    let mut harness = UiHarness::new(80, 24);
+
+    harness.handle_bytes(&[23, b'l']);
+    harness.handle_bytes(b"vlll");
+
+    assert!(harness.ui().is_visual_active());
+    assert!(harness.render_frame().contains("mode=visual focus=right"));
+    assert!(harness.render_frame().contains("\u{1b}[7mchat\u{1b}[0m> "));
+
+    harness.handle_byte(b'y');
+
+    assert_eq!(harness.ui().mode(), UiMode::Command);
+    assert_eq!(harness.last_copied_text(), Some("chat"));
+}
+
+#[test]
+fn scripted_harness_visual_yank_keeps_the_copied_status_notice() {
+    let mut harness = UiHarness::new(80, 24);
+
+    harness.handle_bytes(&[23, b'l']);
+    harness.handle_bytes(b"vllly");
+
+    let frame = harness.render_frame();
+    assert!(frame.contains("copied 4 chars"));
+    assert!(!frame.contains("command mode: press i for insert mode before typing"));
+}
+
+#[test]
+fn scripted_harness_visual_line_mode_copies_focused_left_pane_lines() {
+    let mut harness = UiHarness::new(100, 24);
+
+    harness.handle_bytes(b"VjY");
+
+    assert_eq!(harness.ui().mode(), UiMode::Command);
+    let copied = harness
+        .last_copied_text()
+        .expect("linewise visual selection should copy text");
+    assert!(
+        copied
+            .lines()
+            .next()
+            .is_some_and(|line| line.contains("parser"))
+    );
+    assert!(copied.contains("src/parser.rs"));
+}
+
+#[test]
+fn scripted_harness_visual_block_mode_copies_a_rectangular_right_pane_selection() {
+    let mut harness = UiHarness::new(80, 24);
+
+    harness.handle_bytes(&[23, b'l', 22, b'k', b'l', b'y']);
+
+    assert_eq!(harness.ui().mode(), UiMode::Command);
+    assert_eq!(harness.last_copied_text(), Some("Es\nch"));
+}
