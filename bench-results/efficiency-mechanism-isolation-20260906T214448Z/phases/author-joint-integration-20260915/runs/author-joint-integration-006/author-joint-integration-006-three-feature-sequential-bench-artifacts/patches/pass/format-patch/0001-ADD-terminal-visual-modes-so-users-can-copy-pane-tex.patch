+    fn handle_visual_key(&mut self, key: UiKey, right_content: &str) -> Vec<UiAction> {
+        match key {
+            UiKey::Esc => {
+                self.clear_visual_selection();
+                Vec::new()
+            }
+            UiKey::Char('v') => {
+                self.set_visual_kind(VisualKind::Character, right_content);
+                Vec::new()
+            }
+            UiKey::Char('V') => {
+                self.set_visual_kind(VisualKind::Line, right_content);
+                Vec::new()
+            }
+            UiKey::Char('\u{16}') => {
+                self.set_visual_kind(VisualKind::Block, right_content);
+                Vec::new()
+            }
+            UiKey::Char('h') | UiKey::Left => {
+                self.move_visual_cursor(0, -1, right_content);
+                Vec::new()
+            }
+            UiKey::Char('j') | UiKey::Down => {
+                self.move_visual_cursor(1, 0, right_content);
+                Vec::new()
+            }
+            UiKey::Char('k') | UiKey::Up => {
+                self.move_visual_cursor(-1, 0, right_content);
+                Vec::new()
+            }
+            UiKey::Char('l') | UiKey::Right => {
+                self.move_visual_cursor(0, 1, right_content);
+                Vec::new()
+            }
+            UiKey::Char('y') => self.yank_visual_selection(right_content, false),
+            UiKey::Char('Y') => self.yank_visual_selection(right_content, true),
+            _ => Vec::new(),
+        }
+    }
+
+    fn start_visual_selection(&mut self, kind: VisualKind, right_content: &str) {
+        let anchor = self.visual_start_position(self.focus, right_content);
+        self.visual = Some(VisualSelection {
+            pane: self.focus,
+            kind,
+            anchor,
+            cursor: anchor,
+        });
+    }
+
+    fn set_visual_kind(&mut self, kind: VisualKind, right_content: &str) {
+        if self.visual.is_none() {
+            self.start_visual_selection(kind, right_content);
+            return;
+        }
+        if let Some(selection) = self.visual.as_mut() {
+            selection.kind = kind;
+        }
+        self.clamp_visual_cursor(right_content);
+    }
+
+    fn move_visual_cursor(&mut self, line_delta: isize, column_delta: isize, right_content: &str) {
+        let Some(selection) = self.visual.as_ref() else {
+            return;
+        };
+        let lines = self.visual_lines_for_pane(selection.pane, right_content);
+        let next = moved_text_position(selection.cursor, line_delta, column_delta, &lines);
+        if let Some(selection) = self.visual.as_mut() {
+            selection.cursor = next;
+        }
+    }
+
+    fn clamp_visual_cursor(&mut self, right_content: &str) {
+        let Some(selection) = self.visual.as_ref() else {
+            return;
+        };
