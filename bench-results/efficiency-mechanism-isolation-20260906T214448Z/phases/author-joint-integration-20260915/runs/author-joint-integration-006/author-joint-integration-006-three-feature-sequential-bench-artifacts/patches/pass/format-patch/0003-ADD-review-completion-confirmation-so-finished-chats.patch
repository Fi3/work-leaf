+#[test]
+fn scripted_harness_review_confirmation_closes_and_reopens_chat() {
+    let mut harness = UiHarness::new(100, 24);
+
+    harness
+        .mark_review_done("user-1")
+        .expect("fixture user-1 agent is registered");
+
+    let frame = harness.render_frame();
+    assert!(frame.starts_with('\u{7}'), "{frame}");
+    assert!(frame.contains("work-leaf: is this feature done? yes/no"));
+    assert!(frame.contains("\u{1b}[7m>pars user-1 READY\u{1b}[0m"));
+
+    harness.handle_bytes(b"yes\n");
+
+    let left_pane = harness.ui().render_left_pane();
+    assert!(!left_pane.contains("parser user-1"), "{left_pane}");
+    assert_eq!(harness.ui().selected_agent().map(|id| id.as_str()), None);
+
+    harness.handle_bytes(b"actually keep working\n");
+
+    assert_eq!(
+        harness.ui().selected_agent().map(|id| id.as_str()),
+        Some("user-1")
+    );
+    assert!(
+        harness
+            .transcript()
+            .iter()
+            .any(|line| line == "user-1> actually keep working")
+    );
+    assert!(harness.ui().render_left_pane().contains(">parser user-1"));
+}
