+#[test]
+fn controller_command_line_slash_command_routes_to_selected_agent() {
+    let backend = FakeBackend::new(["launch reply", "slash reply"]);
+    let chat = CommandChat::new(PathBuf::from("/repo"), backend.clone());
+    let mut controller = WorkLeafController::new(chat);
+
+    let agent_id = controller.create_agent("status command").unwrap();
+    assert!(controller.wait_for_idle(Duration::from_secs(1)));
+
+    controller.execute_command_line("/status");
+    assert!(controller.wait_for_idle(Duration::from_secs(1)));
+
+    let snapshot = controller.snapshot();
+    let session = snapshot.session(&agent_id).expect("session exists");
+    assert!(session.lines.iter().any(|line| line == "user: /status"));
+    assert!(session.lines.iter().any(|line| line == "slash reply"));
+    assert!(
+        !snapshot
+            .command_transcript
+            .iter()
+            .any(|line| line.contains("unknown command chat command `/status`"))
+    );
+
+    let sends = backend.sends();
+    assert_eq!(sends, vec![(agent_id, "/status".to_string())]);
+}
