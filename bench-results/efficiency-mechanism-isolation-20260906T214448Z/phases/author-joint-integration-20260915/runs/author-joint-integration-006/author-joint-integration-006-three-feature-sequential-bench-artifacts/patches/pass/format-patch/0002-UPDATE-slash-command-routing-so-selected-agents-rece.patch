+#[test]
+fn terminal_app_prompt_slash_command_routes_to_ui_selected_agent() {
+    let backend = FakeBackend::new(["first launch", "second launch", "slash reply"]);
+    let chat = CommandChat::new(PathBuf::from("/repo"), backend);
+    let mut app = TerminalApp::new(chat, 100, 24);
+
+    app.handle_bytes(b":new first\n");
+    assert!(app.wait_for_idle(Duration::from_secs(1)));
+    app.handle_bytes(b"\x1b:new second\n");
+    assert!(app.wait_for_idle(Duration::from_secs(1)));
+
+    app.handle_bytes(&[27, 23, b'h', b'k']);
+    assert_eq!(
+        app.ui().selected_agent().map(AgentId::as_str),
+        Some("user-1")
+    );
+
+    app.handle_bytes(b":/status\n");
+    assert!(app.wait_for_idle(Duration::from_secs(1)));
+
+    let frame = app.render_frame();
+    assert!(frame.contains("user: /status"));
+    assert!(frame.contains("slash reply"));
+    assert!(!frame.contains("unknown command chat command"), "{frame}");
+
+    let backend = app.into_chat().into_backend();
+    let sends = backend.sends();
+    assert_eq!(sends.len(), 1);
+    assert_eq!(sends[0].0.as_str(), "user-1");
+    assert_eq!(sends[0].1, "/status");
+}
+
+#[test]
+fn terminal_app_prompt_slash_command_on_command_surface_does_not_use_stale_agent_selection() {
+    let backend = FakeBackend::new(["launch reply", "stale slash reply"]);
+    let chat = CommandChat::new(PathBuf::from("/repo"), backend);
+    let mut app = TerminalApp::new(chat, 100, 24);
+
+    app.handle_bytes(b":new status command\n");
+    assert!(app.wait_for_idle(Duration::from_secs(1)));
+
+    app.handle_bytes(&[27, 23, b'h', b'k']);
+    assert!(app.ui().selected_agent().is_none());
+
+    app.handle_bytes(b":/status\n");
+    assert!(app.wait_for_idle(Duration::from_secs(1)));
+
+    let frame = app.render_frame();
+    assert!(
+        frame.contains("unknown command chat command `/status`"),
+        "{frame}"
+    );
+    assert!(!frame.contains("stale slash reply"), "{frame}");
+
+    let backend = app.into_chat().into_backend();
+    assert!(backend.sends().is_empty());
+}
