+#[test]
+fn terminal_app_closes_reviewed_patch_chat_on_yes_and_reopens_on_new_message() {
+    let root = git_repo("terminal-app-review-confirmation");
+    fs::write(root.join("README.md"), "before\n").unwrap();
+    git(&root, ["add", "README.md"]);
+    git(&root, ["commit", "-m", "ADD initial readme fixture"]);
+    let backend = FakeBackend::new([
+        "implemented patch\n@work-leaf patch update readme\n--- a/README.md\n+++ b/README.md\n@@ -1 +1 @@\n-before\n+after\n@work-leaf end\n@work-leaf done",
+        "summary: README changes",
+        "NO_FINDINGS",
+        "follow-up reply",
+    ]);
+    let chat = CommandChat::new(root, backend.clone()).with_max_review_rounds(4);
+    let mut app = TerminalApp::new(chat, 100, 24);
+
+    app.handle_bytes(b":new update readme\n");
+    assert!(app.wait_for_idle(Duration::from_secs(2)));
+
+    let frame = app.render_frame();
+    assert!(frame.starts_with('\u{7}'), "{frame}");
+    assert!(frame.contains("work-leaf: is this feature done? yes/no"));
+    assert!(
+        frame.contains("\u{1b}[7m>chat-title user-1  working: chat-title  READY\u{1b}[0m"),
+        "{frame}"
+    );
+
+    app.handle_bytes(b"yes\n");
+
+    let frame = app.render_frame();
+    assert!(!frame.contains("user-1"), "{frame}");
+    assert_eq!(app.ui().selected_agent().map(AgentId::as_str), None);
+
+    app.handle_bytes(b"actually keep working\n");
+    assert!(app.wait_for_idle(Duration::from_secs(1)));
+
+    let frame = app.render_frame();
+    assert!(frame.contains("user-1"), "{frame}");
+    assert!(frame.contains("user: actually keep working"), "{frame}");
+    assert!(frame.contains("follow-up reply"), "{frame}");
+    assert_eq!(
+        app.ui().selected_agent().map(AgentId::as_str),
+        Some("user-1")
+    );
+
+    let backend = app.into_chat().into_backend();
+    let sends = backend.sends();
+    assert!(sends.iter().any(|(agent_id, prompt)| {
+        agent_id.as_str() == "user-1" && prompt == "actually keep working"
+    }));
+}
