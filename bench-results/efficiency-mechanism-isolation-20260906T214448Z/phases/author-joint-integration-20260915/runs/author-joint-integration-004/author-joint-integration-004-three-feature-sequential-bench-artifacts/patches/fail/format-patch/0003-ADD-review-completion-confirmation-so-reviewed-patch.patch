+pub(crate) fn parse_feature_completion_answer(message: &str) -> Option<bool> {
+    match message.trim().to_ascii_lowercase().as_str() {
+        "yes" | "y" => Some(true),
+        "no" | "n" => Some(false),
+        _ => None,
+    }
+}
+
+pub(crate) fn is_feature_completion_marker(line: &str) -> bool {
+    matches!(
+        line,
+        FEATURE_DONE_PROMPT | FEATURE_CLOSED_LINE | FEATURE_REOPENED_LINE | FEATURE_OPEN_LINE
+    )
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(crate) enum FeatureCompletionState {
+    Open,
+    Pending,
+    Closed,
+}
+
+pub(crate) fn feature_completion_state(lines: &[String]) -> FeatureCompletionState {
+    let mut state = FeatureCompletionState::Open;
+    for line in lines {
+        match line.as_str() {
+            FEATURE_DONE_PROMPT => state = FeatureCompletionState::Pending,
+            FEATURE_CLOSED_LINE => state = FeatureCompletionState::Closed,
+            FEATURE_REOPENED_LINE | FEATURE_OPEN_LINE => state = FeatureCompletionState::Open,
+            _ => {}
+        }
+    }
+    state
+}
