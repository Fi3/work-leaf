+        "{second_prompt_frame}"
+    );
+    assert!(
+        app.ui()
+            .render_left_pane()
+            .contains("\u{1b}[7m>patch user-1  working: patch  READY\u{1b}[0m")
+    );
+
+    app.handle_bytes(b"yes\n");
+    assert!(app.wait_for_idle(Duration::from_secs(1)));
+    assert!(
+        !app.ui().render_left_pane().contains("patch user-1"),
