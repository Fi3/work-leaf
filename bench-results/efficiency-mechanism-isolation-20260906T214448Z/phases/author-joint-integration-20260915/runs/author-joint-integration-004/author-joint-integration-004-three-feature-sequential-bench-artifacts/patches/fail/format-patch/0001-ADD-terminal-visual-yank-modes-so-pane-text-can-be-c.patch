+    fn styled_line(&self, pane: PaneFocus, row: usize, text: &str) -> Spans<'static> {
+        let chars = text.chars().collect::<Vec<_>>();
+        if chars.is_empty() {
+            return Spans::from(vec![Span::raw(String::new())]);
+        }
+
+        let selected_range = self.selected_column_range(pane, row, chars.len());
+        let mut spans = Vec::new();
+        let mut index = 0_usize;
+        while index < chars.len() {
+            let selected = selected_range
+                .as_ref()
+                .is_some_and(|(start, end)| index >= *start && index < *end);
+            let start = index;
+            while index < chars.len() {
+                let current_selected = selected_range
+                    .as_ref()
+                    .is_some_and(|(start, end)| index >= *start && index < *end);
+                if current_selected != selected {
+                    break;
+                }
+                index += 1;
+            }
+            let text = chars[start..index].iter().collect::<String>();
+            if selected {
+                spans.push(Span::styled(
+                    text,
+                    Style::default().add_modifier(Modifier::REVERSED),
+                ));
+            } else {
+                spans.push(Span::raw(text));
+            }
+        }
+        Spans::from(spans)
+    }
+
