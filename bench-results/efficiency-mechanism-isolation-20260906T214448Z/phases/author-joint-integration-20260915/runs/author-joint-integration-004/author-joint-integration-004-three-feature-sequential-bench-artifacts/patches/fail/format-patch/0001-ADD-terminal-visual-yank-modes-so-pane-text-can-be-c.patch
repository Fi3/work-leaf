+fn selected_text_for_kind(
+    kind: VisualKind,
+    selection: &VisualSelection,
+    lines: &[String],
+) -> String {
+    let (start, end) = ordered_positions(selection.anchor, selection.cursor);
+    let start_row = start.row.min(lines.len().saturating_sub(1));
+    let end_row = end.row.min(lines.len().saturating_sub(1));
+    let mut text = String::new();
+    for (row, line) in lines.iter().enumerate().take(end_row + 1).skip(start_row) {
+        let line_len = line.chars().count();
+        match kind {
+            VisualKind::Line => text.push_str(line),
+            VisualKind::Block | VisualKind::Character => {
+                if let Some((start_column, end_column)) =
+                    selected_column_range_for_kind(kind, selection, row, line_len)
+                {
+                    text.push_str(&line_char_range(line, start_column, end_column));
+                }
+            }
+        }
+        if kind != VisualKind::Character || row < end_row {
+            text.push('\n');
+        }
+    }
+    text
+}
