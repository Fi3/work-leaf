+fn selected_column_range_for_kind(
+    kind: VisualKind,
+    selection: &VisualSelection,
+    row: usize,
+    line_len: usize,
+) -> Option<(usize, usize)> {
+    let (start, end) = ordered_positions(selection.anchor, selection.cursor);
+    match kind {
+        VisualKind::Line => (row >= start.row && row <= end.row).then_some((0, line_len)),
+        VisualKind::Block => {
+            if row < start.row || row > end.row {
+                return None;
+            }
+            let start_column = selection.anchor.column.min(selection.cursor.column);
+            let end_column = selection.anchor.column.max(selection.cursor.column);
+            let start_column = start_column.min(line_len);
+            let end_column = end_column.saturating_add(1).min(line_len);
+            (start_column < end_column).then_some((start_column, end_column))
+        }
+        VisualKind::Character => {
+            if row < start.row || row > end.row {
+                return None;
+            }
+            if start.row == end.row {
+                let start_column = start.column.min(line_len);
+                let end_column = end.column.saturating_add(1).min(line_len);
+                return (start_column < end_column).then_some((start_column, end_column));
+            }
+            if row == start.row {
+                let start_column = start.column.min(line_len);
+                return (start_column < line_len).then_some((start_column, line_len));
+            }
+            if row == end.row {
+                let end_column = end.column.saturating_add(1).min(line_len);
+                return (end_column > 0).then_some((0, end_column));
+            }
+            Some((0, line_len))
+        }
+    }
+}
