+    fn visual_start_position(&self, pane: PaneFocus, kind: VisualKind) -> TextPosition {
+        let cached_lines = {
+            let cache = self.render_cache.borrow();
+            match pane {
+                PaneFocus::Left => cache.left_lines.clone(),
+                PaneFocus::Right => cache.right_lines.clone(),
+            }
