+#[test]
+fn terminal_app_review_confirmation_highlights_then_closes_and_reopens_patch_chat() {
+    let root = git_repo("terminal-app-review-close-reopen");
+    fs::write(root.join("README.md"), "before\n").unwrap();
+    Command::new("git")
+        .current_dir(&root)
+        .args(["add", "README.md"])
+        .status()
+        .unwrap();
+    Command::new("git")
+        .current_dir(&root)
+        .args(["commit", "-m", "ADD initial readme fixture"])
+        .status()
+        .unwrap();
+    let backend = FakeBackend::new([
+        "implemented patch\n@work-leaf patch update readme\n--- a/README.md\n+++ b/README.md\n@@ -1 +1 @@\n-before\n+after\n@work-leaf end\n@work-leaf done",
+        "summary: README changes from before to after",
+        "NO_FINDINGS",
+        "follow-up after reopen",
+    ]);
+    let chat = CommandChat::new(root, backend.clone()).with_max_review_rounds(4);
+    let mut app = TerminalApp::new(chat, 100, 24);
+
+    app.handle_bytes(b":new patch readme\n");
+    assert!(app.wait_for_idle(Duration::from_secs(2)));
+
+    let reviewed_frame = app.render_frame();
+    assert_eq!(
+        app.ui().selected_agent().map(AgentId::as_str),
+        Some("user-1")
+    );
+    assert!(reviewed_frame.contains("work-leaf: Is this feature done? yes/no"));
+    assert!(left_pane_row(&app.ui().render_left_pane(), "user-1").contains("READY"));
+
+    app.handle_bytes(b"yes\n");
+    assert!(app.wait_for_idle(Duration::from_secs(1)));
+
+    let closed_frame = app.render_frame();
+    assert!(closed_frame.contains("user: yes"));
+    assert!(closed_frame.contains("work-leaf: feature closed"));
+    assert!(!left_pane_row(&app.ui().render_left_pane(), "user-1").contains("READY"));
+
+    app.handle_bytes(b"add another pass\n");
+    assert!(app.wait_for_idle(Duration::from_secs(1)));
+
+    let reopened_frame = app.render_frame();
+    assert!(reopened_frame.contains("work-leaf: feature reopened"));
+    assert!(reopened_frame.contains("user: add another pass"));
+    assert!(reopened_frame.contains("follow-up after reopen"));
+    assert!(left_pane_row(&app.ui().render_left_pane(), "user-1").contains("READY"));
+
+    let backend = app.into_chat().into_backend();
+    let sends = backend.sends();
+    assert!(
+        !sends
+            .iter()
+            .any(|(target, prompt)| target.as_str() == "user-1" && prompt == "yes")
+    );
+    assert!(
+        sends.iter().any(|(target, prompt)| {
+            target.as_str() == "user-1" && prompt == "add another pass"
+        })
+    );
+}
