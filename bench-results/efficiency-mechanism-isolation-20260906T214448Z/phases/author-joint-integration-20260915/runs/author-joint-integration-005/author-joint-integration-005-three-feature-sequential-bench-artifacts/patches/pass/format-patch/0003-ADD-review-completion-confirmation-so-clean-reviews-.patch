+    fn handle_feature_completion_reply(&mut self, agent_id: &AgentId, message: &str) -> bool {
+        if !self.feature_completion_prompts.contains(agent_id) {
+            return false;
+        }
+        if feature_completion_yes(message) {
+            self.feature_completion_prompts.remove(agent_id);
+            self.closed_features.insert(agent_id.clone());
+            self.transcript.push(format!("{agent_id}> {message}"));
+            self.transcript.push(FEATURE_CLOSED_LINE.to_string());
+            let _ = self.ui.set_agent_ready_state(agent_id, false);
+            return true;
+        }
+        if feature_completion_no(message) {
+            self.feature_completion_prompts.remove(agent_id);
+            self.closed_features.remove(agent_id);
+            self.transcript.push(format!("{agent_id}> {message}"));
+            self.transcript.push(FEATURE_OPEN_LINE.to_string());
+            let _ = self.ui.set_agent_ready_state(agent_id, true);
+            return true;
+        }
+
+        self.feature_completion_prompts.remove(agent_id);
+        self.closed_features.remove(agent_id);
+        self.transcript.push(FEATURE_REOPENED_LINE.to_string());
+        let _ = self.ui.set_agent_ready_state(agent_id, true);
+        false
+    }
+
