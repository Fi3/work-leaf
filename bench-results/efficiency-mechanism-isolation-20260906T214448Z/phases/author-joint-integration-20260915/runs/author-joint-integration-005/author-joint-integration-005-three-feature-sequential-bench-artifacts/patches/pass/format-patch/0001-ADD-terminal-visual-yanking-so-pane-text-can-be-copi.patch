+    fn handle_visual_key(&mut self, key: UiKey, right_content: &str) -> Vec<UiAction> {
+        match key {
+            UiKey::Esc => {
+                self.clear_visual_selection();
+                self.mode = UiMode::Command;
+            }
+            UiKey::Char('v') => self.set_visual_mode(VisualSelectionMode::Character),
+            UiKey::Char('V') => self.set_visual_mode(VisualSelectionMode::Line),
+            UiKey::Char('\u{16}') => self.set_visual_mode(VisualSelectionMode::Block),
+            UiKey::Char('y') => self.yank_visual_selection(right_content, false),
+            UiKey::Char('Y') => self.yank_visual_selection(right_content, true),
+            UiKey::Char('h') | UiKey::Left => self.move_visual_selection(0, -1, right_content),
+            UiKey::Char('j') | UiKey::Down => self.move_visual_selection(1, 0, right_content),
+            UiKey::Char('k') | UiKey::Up => self.move_visual_selection(-1, 0, right_content),
+            UiKey::Char('l') | UiKey::Right => self.move_visual_selection(0, 1, right_content),
+            _ => {}
+        }
+        Vec::new()
+    }
+
+    fn start_visual_selection(
+        &mut self,
+        mode: VisualSelectionMode,
+        right_content: &str,
+        right_cursor_column: Option<usize>,
+    ) {
+        let pane = self.focus;
+        let lines = self.visual_lines_for_pane(pane, right_content);
+        let anchor = self.visual_start_position(pane, &lines, right_cursor_column);
+        self.pending = None;
+        self.visual_selection = Some(VisualSelection {
+            pane,
+            mode,
+            anchor,
+            cursor: anchor,
+        });
+        self.mode = UiMode::Command;
+    }
+
+    fn set_visual_mode(&mut self, mode: VisualSelectionMode) {
+        if let Some(selection) = self.visual_selection.as_mut() {
+            selection.mode = mode;
+        }
+    }
+
+    fn move_visual_selection(
+        &mut self,
+        line_delta: isize,
+        column_delta: isize,
+        right_content: &str,
+    ) {
+        let Some(selection) = self.visual_selection.as_ref() else {
+            return;
+        };
+        let lines = self.visual_lines_for_pane(selection.pane, right_content);
+        let Some(selection) = self.visual_selection.as_mut() else {
+            return;
+        };
+        let current = clamp_text_position(selection.cursor, &lines);
+        let max_line = lines.len().saturating_sub(1) as isize;
+        let next_line = (current.line as isize + line_delta).clamp(0, max_line) as usize;
+        let max_column = line_char_count(&lines[next_line]).saturating_sub(1) as isize;
+        let next_column = (current.column as isize + column_delta).clamp(0, max_column) as usize;
+        selection.cursor = TextPosition {
+            line: next_line,
+            column: next_column,
+        };
+    }
+
+    fn yank_visual_selection(&mut self, right_content: &str, force_line: bool) {
+        let Some(selection) = self.visual_selection.clone() else {
+            return;
+        };
+        let lines = self.visual_lines_for_pane(selection.pane, right_content);
+        let text = selected_text(&selection, &lines, force_line);
+        self.clear_visual_selection();
+        self.finish_yank(text);
+    }
+
+    fn yank_current_line(&mut self, right_content: &str, right_cursor_column: Option<usize>) {
+        let pane = self.focus;
+        let lines = self.visual_lines_for_pane(pane, right_content);
+        let position = self.visual_start_position(pane, &lines, right_cursor_column);
+        let text = line_yank_text(&lines, position.line);
+        self.finish_yank(text);
+    }
+
+    fn finish_yank(&mut self, text: String) {
+        let char_count = text.chars().count();
+        self.last_yanked_text = Some(text);
+        self.pending_clipboard_copy.set(true);
+        self.show_status_notice(
+            format!("yanked {char_count} chars"),
+            Duration::from_secs(STATUS_NOTICE_SECONDS),
+        );
+    }
+
+    fn clear_visual_selection(&mut self) {
+        self.visual_selection = None;
+    }
+
+    fn visual_lines_for_pane(&self, pane: PaneFocus, right_content: &str) -> Vec<String> {
+        match pane {
+            PaneFocus::Left => self.left_pane_lines(),
+            PaneFocus::Right => content_lines(&self.visible_right_content(right_content)),
+        }
+    }
+
+    fn left_pane_lines(&self) -> Vec<String> {
+        let inner_width = usize::from(self.layout().left_width.saturating_sub(2).max(1));
+        let mut lines = vec![if self.control_selected == 0 {
+            "> work-leaf  command".to_string()
+        } else {
+            "  work-leaf  command".to_string()
+        }];
+        for (visible_position, agent_index) in self.visible_agent_indices().iter().enumerate() {
+            let agent = &self.agents[*agent_index];
+            let selected = self.control_selected == visible_position + 1;
+            lines.push(compact_agent_row(agent, selected, inner_width));
+            if !agent.modified_files.is_empty() {
+                lines.push(format!(
+                    "    files: {}",
+                    agent
+                        .modified_files
+                        .iter()
+                        .map(|path| path.display().to_string())
+                        .collect::<Vec<_>>()
+                        .join(", ")
+                ));
+            }
+            for (label, agents) in [
+                ("conflicts", &agent.conflicting_agents),
+                ("depends-on", &agent.depends_on),
+                ("depended-on-by", &agent.depended_on_by),
+            ] {
+                if !agents.is_empty() {
+                    lines.push(format!(
+                        "    {label}: {}",
+                        agents
+                            .iter()
+                            .map(AgentId::as_str)
+                            .collect::<Vec<_>>()
+                            .join(", ")
+                    ));
+                }
+            }
+        }
+        lines
+    }
+
+    fn left_visual_start_line(&self) -> usize {
+        if self.control_selected == 0 {
+            return 0;
+        }
+
+        let mut line = 1;
