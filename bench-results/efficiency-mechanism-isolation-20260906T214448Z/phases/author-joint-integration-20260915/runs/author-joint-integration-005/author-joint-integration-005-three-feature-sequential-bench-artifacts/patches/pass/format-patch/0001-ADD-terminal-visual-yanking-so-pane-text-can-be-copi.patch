+fn content_lines(content: &str) -> Vec<String> {
+    let lines = content.lines().map(str::to_string).collect::<Vec<_>>();
+    if lines.is_empty() {
+        vec![String::new()]
+    } else {
+        lines
+    }
+}
+
+fn selected_text(selection: &VisualSelection, lines: &[String], force_line: bool) -> String {
+    let ranges = selected_ranges(selection, lines, force_line);
+    if force_line || selection.mode == VisualSelectionMode::Line {
+        return ranges
+            .into_iter()
+            .filter_map(|range| lines.get(range.line))
+            .fold(String::new(), |mut output, line| {
+                output.push_str(line);
+                output.push('\n');
+                output
+            });
+    }
+
+    let parts = ranges
+        .into_iter()
+        .filter_map(|range| {
+            lines
+                .get(range.line)
+                .map(|line| char_slice(line, range.start, range.end))
+        })
+        .collect::<Vec<_>>();
+    parts.join("\n")
+}
+
+fn line_yank_text(lines: &[String], line: usize) -> String {
+    lines
+        .get(line)
+        .map(|line| format!("{line}\n"))
+        .unwrap_or_default()
+}
+
+fn selected_ranges(
+    selection: &VisualSelection,
+    lines: &[String],
+    force_line: bool,
+) -> Vec<SelectionRange> {
+    if lines.is_empty() {
+        return Vec::new();
+    }
+
+    let anchor = clamp_text_position(selection.anchor, lines);
+    let cursor = clamp_text_position(selection.cursor, lines);
+    let (start, end) = ordered_positions(anchor, cursor);
+    if force_line || selection.mode == VisualSelectionMode::Line {
+        return (start.line..=end.line)
+            .map(|line| SelectionRange {
+                line,
+                start: 0,
+                end: line_char_count(&lines[line]),
+                full_line: true,
+            })
+            .collect();
+    }
+
+    if selection.mode == VisualSelectionMode::Block {
+        let start_column = start.column.min(end.column);
+        let end_column = start.column.max(end.column).saturating_add(1);
+        return (start.line..=end.line)
+            .map(|line| SelectionRange {
+                line,
+                start: start_column,
+                end: end_column,
+                full_line: false,
+            })
+            .collect();
+    }
+
+    if start.line == end.line {
+        return vec![SelectionRange {
+            line: start.line,
+            start: start.column,
+            end: end.column.saturating_add(1),
+            full_line: false,
+        }];
+    }
+
+    let mut ranges = Vec::new();
+    ranges.push(SelectionRange {
+        line: start.line,
+        start: start.column,
+        end: line_char_count(&lines[start.line]),
+        full_line: false,
+    });
+    for (line, text) in lines
+        .iter()
+        .enumerate()
+        .take(end.line)
+        .skip(start.line.saturating_add(1))
+    {
+        ranges.push(SelectionRange {
+            line,
+            start: 0,
+            end: line_char_count(text),
+            full_line: false,
+        });
+    }
+    ranges.push(SelectionRange {
+        line: end.line,
+        start: 0,
+        end: end.column.saturating_add(1),
+        full_line: false,
+    });
+    ranges
+}
+
+fn clamp_text_position(position: TextPosition, lines: &[String]) -> TextPosition {
+    if lines.is_empty() {
+        return TextPosition { line: 0, column: 0 };
+    }
+
+    let line = position.line.min(lines.len().saturating_sub(1));
+    let line_len = line_char_count(&lines[line]);
+    let column = if line_len == 0 {
+        0
+    } else {
+        position.column.min(line_len.saturating_sub(1))
+    };
+    TextPosition { line, column }
+}
+
+fn ordered_positions(left: TextPosition, right: TextPosition) -> (TextPosition, TextPosition) {
+    if (left.line, left.column) <= (right.line, right.column) {
+        (left, right)
+    } else {
+        (right, left)
+    }
+}
+
+fn char_slice(text: &str, start: usize, end: usize) -> String {
+    text.chars()
+        .skip(start)
+        .take(end.saturating_sub(start))
+        .collect()
+}
+
+fn line_char_count(line: &str) -> usize {
+    line.chars().count()
+}
+
+fn highlight_selection_range(
+    buffer: &mut Buffer,
+    inner: Rect,
+    lines: &[String],
+    range: SelectionRange,
+) {
+    let Some(line) = lines.get(range.line) else {
+        return;
+    };
+    let width = usize::from(inner.width.max(1));
+    let line_start_row = visual_line_start_row(lines, range.line, inner.width);
+
+    if range.full_line {
+        for row in
+            line_start_row..line_start_row.saturating_add(visual_row_count(line, inner.width))
+        {
+            for column in 0..width {
+                highlight_cell(buffer, inner, row, column);
+            }
+        }
+        return;
+    }
+
+    let line_len = line_char_count(line);
+    let start = range.start.min(line_len);
+    let end = range.end.min(line_len);
+    if start >= end {
+        return;
+    }
+
+    for column in start..end {
+        let row = line_start_row.saturating_add(column / width);
+        let column = column % width;
+        highlight_cell(buffer, inner, row, column);
+    }
+}
+
+fn highlight_cell(buffer: &mut Buffer, inner: Rect, row: usize, column: usize) {
+    if row >= usize::from(inner.height) || column >= usize::from(inner.width) {
+        return;
+    }
+
+    let x = inner.x.saturating_add(column as u16);
+    let y = inner.y.saturating_add(row as u16);
+    if x < buffer.area.width && y < buffer.area.height {
+        buffer.get_mut(x, y).modifier.insert(Modifier::REVERSED);
+    }
+}
+
+fn visual_line_start_row(lines: &[String], line: usize, width: u16) -> usize {
+    lines
+        .iter()
+        .take(line)
+        .map(|line| visual_row_count(line, width))
+        .sum()
+}
+
+fn osc52_clipboard_sequence(text: &str) -> String {
+    format!("\u{1b}]52;c;{}\u{7}", base64_encode(text.as_bytes()))
+}
+
+fn base64_encode(input: &[u8]) -> String {
+    const TABLE: &[u8; 64] = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+
+    let mut output = String::with_capacity(input.len().div_ceil(3) * 4);
+    for chunk in input.chunks(3) {
+        let first = chunk[0];
+        let second = *chunk.get(1).unwrap_or(&0);
+        let third = *chunk.get(2).unwrap_or(&0);
+
+        output.push(TABLE[(first >> 2) as usize] as char);
+        output.push(TABLE[(((first & 0b0000_0011) << 4) | (second >> 4)) as usize] as char);
+        if chunk.len() > 1 {
+            output.push(TABLE[(((second & 0b0000_1111) << 2) | (third >> 6)) as usize] as char);
+        } else {
+            output.push('=');
+        }
+        if chunk.len() > 2 {
+            output.push(TABLE[(third & 0b0011_1111) as usize] as char);
+        } else {
+            output.push('=');
+        }
+    }
+    output
+}
+
 fn visual_rows(line: &str, width: u16) -> u16 {
     visual_row_count(line, width).min(usize::from(u16::MAX)) as u16
 }
