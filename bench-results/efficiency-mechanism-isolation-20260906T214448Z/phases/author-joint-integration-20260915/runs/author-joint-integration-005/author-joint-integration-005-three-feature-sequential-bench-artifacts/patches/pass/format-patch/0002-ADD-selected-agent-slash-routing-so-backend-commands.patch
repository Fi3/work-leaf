+#[test]
+fn terminal_app_prompt_slash_command_uses_ui_selected_agent() {
+    let backend = FakeBackend::new(["first launch", "second launch", "first status reply"]);
+    let chat = CommandChat::new(PathBuf::from("/repo"), backend);
+    let mut app = TerminalApp::new(chat, 100, 24);
+
+    app.handle_bytes(b":new first\n");
+    assert!(app.wait_for_idle(Duration::from_secs(1)));
+    app.handle_bytes(b"\x1b:new second\n");
+    assert!(app.wait_for_idle(Duration::from_secs(1)));
+
+    app.handle_bytes(&[27, 23, b'h', b'k', b'l']);
+    assert_eq!(
+        app.ui().selected_agent().map(AgentId::as_str),
+        Some("user-1")
+    );
+
+    app.handle_bytes(b":/status\n");
+    assert!(app.wait_for_idle(Duration::from_secs(1)));
+
+    let frame = app.render_frame();
+    assert!(frame.contains("user: /status"));
+    assert!(frame.contains("first status reply"));
+    assert!(!frame.contains("second launch"));
+
+    let backend = app.into_chat().into_backend();
+    let sends = backend.sends();
+    assert_eq!(sends.len(), 1);
+    assert_eq!(sends[0].0.as_str(), "user-1");
+    assert_eq!(sends[0].1, "/status");
+}
+
+#[test]
+fn terminal_app_prompt_slash_command_from_command_surface_does_not_use_stale_agent_selection() {
+    let backend = FakeBackend::new(["launch reply", "stale status reply"]);
+    let chat = CommandChat::new(PathBuf::from("/repo"), backend);
+    let mut app = TerminalApp::new(chat, 100, 24);
+
+    app.handle_bytes(b":new status command\n");
+    assert!(app.wait_for_idle(Duration::from_secs(1)));
+    app.handle_bytes(&[27, 23, b'h', b'k', b'l']);
+    assert_eq!(app.ui().selected_agent(), None);
+
+    app.handle_bytes(b":/status\n");
+    assert!(app.wait_for_idle(Duration::from_secs(1)));
+
+    let frame = app.render_frame();
+    assert!(frame.contains("work-leaf> /status"));
+    assert!(frame.contains("error: unknown command chat command `/status`"));
+    assert!(!frame.contains("stale status reply"));
+
+    let backend = app.into_chat().into_backend();
+    assert!(backend.sends().is_empty());
+}
