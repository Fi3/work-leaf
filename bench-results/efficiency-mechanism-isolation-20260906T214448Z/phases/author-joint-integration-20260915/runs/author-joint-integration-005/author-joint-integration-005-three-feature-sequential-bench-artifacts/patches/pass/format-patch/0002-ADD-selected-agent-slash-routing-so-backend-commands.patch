+#[test]
+fn controller_routes_slash_command_line_to_selected_backend_agent() {
+    let backend = FakeBackend::new(["launch reply", "status reply"]);
+    let chat = CommandChat::new(PathBuf::from("/repo"), backend.clone());
+    let mut controller = WorkLeafController::new(chat);
+
+    let agent_id = controller.create_agent("inspect status").unwrap();
+    assert!(controller.wait_for_idle(Duration::from_secs(1)));
+
+    controller.execute_command_line("/status --all");
+    assert!(controller.wait_for_idle(Duration::from_secs(1)));
+
+    let snapshot = controller.snapshot();
+    let session = snapshot.session(&agent_id).expect("session exists");
+    assert!(session.lines.iter().any(|line| line == "user: /status --all"));
+    assert!(session.lines.iter().any(|line| line == "status reply"));
+    assert!(
+        !snapshot
+            .command_transcript
+            .iter()
+            .any(|line| line.contains("unknown command chat command `/status`"))
+    );
+
+    let sends = backend.sends();
+    assert_eq!(sends.len(), 1);
+    assert_eq!(sends[0].0, agent_id);
+    assert_eq!(sends[0].1, "/status --all");
+}
+
