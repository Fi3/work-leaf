{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/usr/bin/bash -lc \"nl -ba src/workspace.rs | sed -n '930,990p'\"","aggregated_output":"   930\t    text.lines()\n   931\t        .any(|line| line.trim_start().starts_with(&prefix))\n   932\t}\n   933\t\n   934\tfn contains_done_directive(text: &str) -> bool {\n   935\t    text.lines()\n   936\t        .any(|line| line.trim_start() == \"@work-leaf done\")\n   937\t}\n   938\t\n   939\t#[derive(Clone, Copy, Debug, Eq, PartialEq)]\n   940\tenum FeatureCompletionAnswer {\n   941\t    Yes,\n   942\t    No,\n   943\t}\n   944\t\n   945\tfn feature_completion_answer(message: &str) -> Option<FeatureCompletionAnswer> {\n   946\t    match message.trim().to_ascii_lowercase().as_str() {\n   947\t        \"yes\" | \"y\" => Some(FeatureCompletionAnswer::Yes),\n   948\t        \"no\" | \"n\" => Some(FeatureCompletionAnswer::No),\n   949\t        _ => None,\n   950\t    }\n   951\t}\n   952\t\n   953\tpub(crate) fn agent_slash_command_line(line: &str) -> Option<&str> {\n   954\t    let rest = line.strip_prefix('/')?;\n   955\t    let first = rest.chars().next()?;\n   956\t    (!first.is_whitespace()).then_some(line)\n   957\t}\n   958\t\n   959\t#[derive(Clone, Debug, Deserialize, Eq, PartialEq, Serialize)]\n   960\tpub struct WorkLeafSnapshot {\n   961\t    pub command_transcript: Vec<String>,\n   962\t    pub sessions: Vec<WorkLeafSession>,\n   963\t}\n   964\t\n   965\timpl WorkLeafSnapshot {\n   966\t    pub fn session(&self, agent_id: &AgentId) -> Option<&WorkLeafSession> {\n   967\t        self.sessions.iter().find(|session| &session.id == agent_id)\n   968\t    }\n   969\t}\n   970\t\n   971\t#[derive(Clone, Debug, Deserialize, Eq, PartialEq, Serialize)]\n   972\tpub struct WorkLeafSession {\n   973\t    pub id: AgentId,\n   974\t    pub kind: AgentKind,\n   975\t    pub title: String,\n   976\t    pub feature: String,\n   977\t    pub lines: Vec<String>,\n   978\t    pub loading: Option<WorkLeafLoading>,\n   979\t}\n   980\t\n   981\timpl WorkLeafSession {\n   982\t    fn unknown(agent_id: AgentId, kind: AgentKind) -> Self {\n   983\t        Self {\n   984\t            id: agent_id,\n   985\t            kind,\n   986\t            title: \"agent\".to_string(),\n   987\t            feature: \"agent\".to_string(),\n   988\t            lines: Vec::new(),\n   989\t            loading: None,\n   990\t        }\n","exit_code":0,"status":"completed"}}
