.clone(), first_prompt);\n   290\t        }\n   291\t        self.start_worker(move |mut chat, sender| {\n   292\t            let stream_sender = sender.clone();\n   293\t            let display_name = chat.agent_profile().display_name.clone();\n   294\t            let mut stream = move |event_agent_id: &AgentId, event| {\n   295\t                let _ = stream_sender.send(WorkerEvent::Stream {\n   296\t                    agent_id: event_agent_id.clone(),\n   297\t                    text: stream_event_text(event, &display_name),\n   298\t                });\n   299\t            };\n   300\t            match chat.send_to_agent_streaming_with_ids(&agent_id, &message, &mut stream) {\n   301\t                Ok(result) => {\n   302\t                    let _ = sender.send(WorkerEvent::Complete {\n   303\t                        agent_id: Some(agent_id),\n   304\t                        result,\n   305\t                    });\n   306\t                }\n   307\t                Err(error) => {\n   308\t                    let _ = sender.send(WorkerEvent::Error {\n   309\t                        agent_id: Some(agent_id),\n   310\t                        message: command_chat_error_text(&error),\n   311\t                    });\n   312\t                }\n   313\t            }\n   314\t        });\n   315\t        Ok(())\n   316\t    }\n   317\t\n   318\t    pub fn start_review(&mut self) -> Result<Vec<AgentId>, CliError> {\n   319\t        self.start_review_for_agent(None)\n   320\t    }\n   321\t\n   322\t    fn start_review_for_patch_agent(\n   323\t        &mut self,\n   324\t        agent_id: &AgentId,\n   325\t    ) -> Result<Vec<AgentId>, CliError> {\n   326\t        self.start_review_for_agent(Some(agent_id))\n   327\t    }\n   328\t\n   329\t    fn start_review_for_agent(\n   330\t        &mut self,\n   331\t        target_agent_id: Option<&AgentId>,\n   332\t    ) -> Result<Vec<AgentId>, CliError> {\n   333\t        let (project_dir, agent_profile) = {\n   334\t            let chat = self\n   335\t                .chat\n   336\t                .as_ref()\n   337\t                .expect(\"work-leaf controller command chat is present\");\n   338\t            (\n   339\t                chat.project_dir().to_path_buf(),\n   340\t                chat.agent_profile().clone(),\n","exit_code":0,"status":"completed"}}
