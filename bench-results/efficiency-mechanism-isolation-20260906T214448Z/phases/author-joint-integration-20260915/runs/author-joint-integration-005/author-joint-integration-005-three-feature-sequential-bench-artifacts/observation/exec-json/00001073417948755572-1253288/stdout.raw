fn selected_agent(&self) -> Option<&AgentId> {\n   316\t        self.selected_agent.as_ref()\n   317\t    }\n   318\t\n   319\t    pub fn control_selected_row(&self) -> usize {\n   320\t        self.control_selected\n   321\t    }\n   322\t\n   323\t    pub fn add_agent(&mut self, agent: AgentListEntry) {\n   324\t        self.agents.push(agent);\n   325\t    }\n   326\t\n   327\t    pub(crate) fn set_agent_feature(\n   328\t        &mut self,\n   329\t        agent_id: &AgentId,\n   330\t        feature: impl Into<String>,\n   331\t    ) -> Result<(), String> {\n   332\t        let Some(agent) = self.agents.iter_mut().find(|agent| &agent.id == agent_id) else {\n   333\t            return Err(format!(\"unknown agent `{agent_id}`\"));\n   334\t        };\n   335\t        agent.feature = feature.into();\n   336\t        Ok(())\n   337\t    }\n   338\t\n   339\t    pub(crate) fn set_agent_ready_state(\n   340\t        &mut self,\n   341\t        agent_id: &AgentId,\n   342\t        ready: bool,\n   343\t    ) -> Result<(), String> {\n   344\t        let Some(agent) = self.agents.iter_mut().find(|agent| &agent.id == agent_id) else {\n   345\t            return Err(format!(\"unknown agent `{agent_id}`\"));\n   346\t        };\n   347\t        if ready && !agent.ready {\n   348\t            self.pending_bell.set(true);\n   349\t        }\n   350\t        agent.ready = ready;\n   351\t        Ok(())\n   352\t    }\n   353\t\n   354\t    pub fn select_agent(&mut self, agent_id: &AgentId) -> Result<(), String> {\n   355\t        if self.agents.iter().any(|agent| &agent.id == agent_id) {\n   356\t            self.clear_visual_selection();\n   357\t            self.selected_agent = Some(agent_id.clone());\n   358\t            self.windows[self.active_window] = UiWindow::chat(agent_id.clone());\n   359\t            self.control_selected = self\n   360\t                .visible_agent_indices()\n   361\t                .iter()\n   362\t                .position(|index| self.agents[*index].id == *agent_id)\n   363\t                .map(|position| position + 1)\n   364\t                .unwrap_or(self.control_selected);\n   365\t            self.reset_right_scroll();\n   366\t            Ok(())\n   367\t        } else {\n   368\t            Err(format!(\"unknown agent `{agent_id}`\"))\n   369\t        }\n   370\t    }\n   371\t\n   372\t    pub fn activate_agent_chat(&mut self, agent_id: &AgentId) -> Result<(), String> {\n   373\t        self.select_agent(agent_id)?;\n   374\t        self.focus = PaneFocus::Right;\n   375\t        self.mode = UiMode::Insert;\n   376\t        Ok(())\n   377\t    }\n   378\t\n   379\t    pub fn select_command_interface(&mut self) {\n   380\t        self.clear_visual_selection();\n   381\t        self.selected_agent = None;\n   382\t        self.windows[self.active_window] = UiWindow::command();\n   383\t        self.control_selected = 0;\n   384\t        self.reset_right_scroll();\n   385\t    }\n   386\t\n   387\t    pub fn handle_key(&mut self, key: UiKey) -> Vec<UiAction> {\n   388\t        self.handle_key_with_pane_content(key, \"\", None)\n   389\t    }\n   390\t\n   391\t    pub fn handle_key_with_pane_content(\n   392\t        &mut self,\n   393\t        key: UiKey,\n   394\t        right_content: &str,\n   395\t        right_cursor_column: Option<usize>,\n   396\t    ) -> Vec<UiAction> {\n   397\t        let command_mode_text_key = self.command_mode_text_key_control_status(key);\n   398\t        let actions = self.handle_key_inner(key, right_content, right_cursor_column);\n   399\t        self.update_command_mode_typing_notice(command_mode_text_key);\n   400\t        actions\n   401\t    }\n   402\t\n   403\t    fn handle_key_inner(\n   404\t        &mut self,\n   405\t        key: UiKey,\n   406\t        right_content: &str,\n   407\t        right_cursor_column: Option<usize>,\n   408\t    ) -> Vec<UiAction> {\n   409\t        match key {\n   410\t            UiKey::MouseClick { column, row } => {\n   411\t                self.pending = None;\n   412\t                self.clear_visual_selection();\n   413\t                return self.handle_mouse_click(column, row);\n   414\t            }\n   415\t            UiKey::MouseScrollUp { column, row } => {\n   416\t                self.pending = None;\n   417\t                self.clear_visual_selection();\n   418\t                self.handle_mouse_scroll(column, row, true);\n   419\t                return Vec::new();\n   420\t            }\n   421\t            UiKey::MouseScrollDown { column, row } => {\n   422\t                self.pending = None;\n   423\t                self.clear_visual_selection();\n   424\t                self.handle_mouse_scroll(column, row, false);\n   425\t                return Vec::new();\n   426\t            }\n   427\t            _ => {}\n   428\t        }\n   429\t\n   430\t        if self.visual_selection.is_some() {\n   431\t            return self.handle_visual_key(key, right_content);\n   432\t        }\n   433\t\n   434\t        if let Some(pending) = self.pending.take() {\n   435\t            return self.handle_pending_key(pending, key);\n   436\t        }\n   437\t\n   438\t        match key {\n   439\t            UiKey::Esc => {\n   440\t                self.clear_visual_selection();\n   441\t                self.mode = UiMode::Command;\n   442\t                Vec::new()\n   443\t            }\n   444\t            UiKey::Char('v') if self.mode == UiMode::Command => {\n   445\t                self.start_visual_selection(\n   446\t                    VisualSelectionMode::Character,\n   447\t                    right_content,\n   448\t                    right_cursor_column,\n   449\t                );\n   450\t                Vec::new()\n   451\t            }\n   452\t            UiKey::Char('V') if self.mode == UiMode::Command => {\n   453\t                self.start_visual_selection(\n   454\t                    VisualSelectionMode::Line,\n   455\t                    right_content,\n   456\t                    right_cursor_column,\n   457\t                );\n   458\t                Vec::new()\n   459\t            }\n   460\t            UiKey::Char('\\u{16}') if self.mode == UiMode::Command => {\n   461\t                self.start_visual_selection(\n   462\t                    VisualSelectionMode::Block,\n   463\t                    right_content,\n   464\t                    right_cursor_column,\n   465\t                );\n   466\t                Vec::new()\n   467\t            }\n   468\t            UiKey::Char('Y') if self.mode == UiMode::Command => {\n   469\t                self.yank_current_line(right_content, right_cursor_column);\n   470\t                Vec::new()\n   471\t            }\n   472\t            UiKey::CtrlW if self.mode == UiMode::Command => {\n   473\t                self.pending = Some(PendingKey::CtrlW);\n   474\t                Vec::new()\n   475\t            }\n   476\t            UiKey::Char('g') if self.mode == UiMode::Command => {\n   477\t                self.pending = Some(PendingKey::G);\n   478\t                Vec::new()\n   479\t            }\n   480\t            UiKey::Char('i') if self.mode == UiMode::Command => {\n   481\t                self.mode = UiMode::Insert;\n   482\t                Vec::new()\n   483\t            }\n   484\t            UiKey::Char(':') if self.mode == UiMode::Command => {\n   485\t                self.mode = UiMode::Prompt;\n   486\t                Vec::new()\n   487\t            }\n   488\t            UiKey::Char(',') if self.mode == UiMode::Command => {\n   489\t                self.left_visible = !self.left_visible;\n   490\t                self.focus = if self.left_visible {\n   491\t                    PaneFocus::Left\n   492\t                } else {\n   493\t                    PaneFocus::Right\n   494\t                };\n   495\t                Vec::new()\n   496\t            }\n   497\t            UiKey::Char('j') if self.mode == UiMode::Command && self.focus == PaneFocus::Left => {\n   498\t                self.move_control_selection(1);\n   499\t                self.select_control_row_surface();\n   500\t                Vec::new()\n   501\t            }\n   502\t            UiKey::Down if self.mode == UiMode::Command && self.focus == PaneFocus::Left => {\n   503\t                self.move_control_selection(1);\n   504\t                self.select_control_row_surface();\n   505\t                Vec::new()\n   506\t            }\n   507\t            UiKey::Right if self.mode == UiMode::Command && self.focus == PaneFocus::Left => {\n   508\t                self.move_control_selection(1);\n   509\t                self.select_control_row_surface();\n   510\t                Vec::new()\n   511\t            }\n   512\t            UiKey::Char('k') if self.mode == UiMode::Command && self.focus == PaneFocus::Left => {\n   513\t                self.move_control_selection(-1);\n   514\t                self.select_control_row_surface();\n   515\t                Vec::new()\n   516\t            }\n   517\t            UiKey::Up if self.mode == UiMode::Command && self.focus == PaneFocus::Left => {\n   518\t                self.move_control_selection(-1);\n   519\t                self.select_control_row_surface();\n   520\t                Vec::new()\n   521\t            }\n   522\t            UiKey::Left if self.mode == UiMode::Command && self.focus == PaneFocus::Left => {\n   523\t                self.move_control_selection(-1);\n   524\t                self.select_control_row_surface();\n   525\t                Vec::new()\n   526\t            }\n   527\t            UiKey::Char('l') if self.mode == UiMode::Command && self.focus == PaneFocus::Left => {\n   528\t                self.open_control_selection();\n   529\t                Vec::new()\n   530\t            }\n   531\t            UiKey::Char('x') if self.mode == UiMode::Command && self.focus == PaneFocus::Left => {\n   532\t                self.hide_control_selection();\n   533\t                Vec::new()\n   534\t            }\n   535\t            UiKey::Char('s') if self.mode == UiMode::Command => self.open_selected_same_pane(),\n   536\t            UiKey::Char('t') if self.mode == UiMode::Command => self.open_selected_new_window(),\n   537\t            UiKey::Char('f') if self.mode == UiMode::Command => self.fork_selected_agent(),\n   538\t            _ => Vec::new(),\n   539\t        }\n   540\t    }\n","exit_code":0,"status":"completed"}}
