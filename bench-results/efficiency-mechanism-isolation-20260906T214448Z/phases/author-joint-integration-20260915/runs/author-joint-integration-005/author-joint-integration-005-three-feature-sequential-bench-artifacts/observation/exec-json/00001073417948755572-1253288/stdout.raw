d,\n   715\t                    title,\n   716\t                    feature,\n   717\t                    loading,\n   718\t                } => {\n   719\t                    let session =\n   720\t                        self.upsert_cached_session_status(agent_id, kind, title, feature, loading);\n   721\t                    self.apply_session_to_ui(&session);\n   722\t                }\n   723\t                WorkLeafEvent::AgentLineAppended { agent_id, line } => {\n   724\t                    self.append_cached_agent_line(&agent_id, line);\n   725\t                }\n   726\t                WorkLeafEvent::AgentSelected { agent_id } => {\n   727\t                    let _ = self.ui.activate_agent_chat(&agent_id);\n   728\t                }\n   729\t                WorkLeafEvent::CommandTranscriptLine { line } => {\n   730\t                    self.snapshot.command_transcript.push(line);\n   731\t                }\n   732\t                WorkLeafEvent::QuitRequested => {\n   733\t                    self.quit = true;\n   734\t                }\n   735\t            }\n   736\t        }\n   737\t        self.dirty = true;\n   738\t    }\n   739\t\n   740\t    fn upsert_cached_session(&mut self, session: WorkLeafSession) {\n   741\t        if let Some(existing) = self\n   742\t            .snapshot\n   743\t            .sessions\n   744\t            .iter_mut()\n   745\t            .find(|existing| existing.id == session.id)\n   746\t        {\n   747\t            *existing = session;\n   748\t        } else {\n   749\t            self.snapshot.sessions.push(session);\n   750\t            self.snapshot\n   751\t                .sessions\n   752\t                .sort_by(|left, right| left.id.as_str().cmp(right.id.as_str()));\n   753\t        }\n   754\t    }\n   755\t\n   756\t    fn upsert_cached_session_status(\n   757\t        &mut self,\n   758\t        agent_id: AgentId,\n   759\t        kind: crate::agent::AgentKind,\n   760\t        title: String,\n   761\t        feature: String,\n   762\t        loading: Option<WorkLeafLoading>,\n   763\t    ) -> WorkLeafSession {\n   764\t        if let Some(session) = self\n   765\t            .snapshot\n   766\t            .sessions\n   767\t            .iter_mut()\n   768\t            .find(|session| session.id == agent_id)\n   769\t        {\n   770\t            session.kind = kind;\n   771\t            session.title = title;\n   772\t            session.feature = feature;\n   773\t            session.loading = loading;\n   774\t            return session.clone();\n   775\t        }\n   776\t\n   777\t        let session = WorkLeafSession {\n   778\t            id: agent_id,\n   779\t            kind,\n   780\t            title,\n   781\t            feature,\n   782\t            lines: Vec::new(),\n   783\t            loading,\n   784\t        };\n   785\t        self.snapshot.sessions.push(session.clone());\n   786\t        self.snapshot\n   787\t            .sessions\n   788\t            .sort_by(|left, right| left.id.as_str().cmp(right.id.as_str()));\n   789\t        session\n   790\t    }\n   791\t\n   792\t    fn append_cached_agent_line(&mut self, agent_id: &AgentId, line: String) {\n   793\t        if line.is_empty() {\n   794\t            return;\n   795\t        }\n   796\t        let updated = {\n   797\t            let Some(session) = self\n   798\t                .snapshot\n   799\t                .sessions\n   800\t                .iter_mut()\n   801\t                .find(|session| &session.id == agent_id)\n   802\t            else {\n   803\t                return;\n   804\t            };\n   805\t            if feature_completion_state_line(&line)\n   806\t                || !session.lines.iter().any(|existing| existing == &line)\n   807\t            {\n   808\t                session.lines.push(line);\n   809\t            }\n   810\t            session.clone()\n   811\t        };\n   812\t        self.apply_session_to_ui(&updated);\n   813\t    }\n   814\t\n   815\t    fn apply_session_to_ui(&mut self, session: &WorkLeafSession) {\n   816\t        if self\n   817\t            .ui\n   818\t            .set_agent_feature(&session.id, session.title.clone())\n   819\t            .is_err()\n   820\t        {\n   821\t            self.ui.add_agent(AgentListEntry::new(\n   822\t                session.id.clone(),\n   823\t                session.title.clone(),\n   824\t            ));\n   825\t        }\n   826\t        let ready = session.loading.is_none() && !session_feature_closed(session);\n   827\t        let _ = self.ui.set_agent_ready_state(&session.id, ready);\n   828\t    }\n   829\t\n   830\t    fn should_start_agent_slash_command(&self) -> bool {\n   831\t        self.ui.mode() == UiMode::Command\n   832\t            && !self.ui.is_visual_active()\n   833\t            && self.ui.selected_agent().is_some()\n   834\t    }\n   835\t\n   836\t    fn start_agent_slash_command(&mut self) {\n   837\t        let Some(agent_id) = self.ui.selected_agent().cloned() else {\n   838\t            return;\n   839\t        };\n   840\t        if self.ui.activate_agent_chat(&agent_id).is_ok() {\n   841\t            self.chat_buffer.push('/');\n   842\t            self.chat_history_index = None;\n   843\t            self.chat_history_draft = None;\n   844\t        }\n   845\t    }\n   846\t\n   847\t    fn should_route_chat_arrow(&self) -> bool {\n   848\t        !self.ui.is_visual_active()\n   849\t            && (self.ui.mode() == UiMode::Insert\n   850\t                || (self.ui.mode() == UiMode::Command && self.ui.focus() == PaneFocus::Right))\n   851\t    }\n   852\t\n   853\t    fn defer_escape_key(&self) -> bool {\n   854\t        self.ui.mode() == UiMode::Prompt\n   855\t            || (self.ui.mode() == UiMode::Insert && self.ui.focus() == PaneFocus::Right)\n   856\t    }\n   857\t\n   858\t    fn finish_pending_escape_sequence(&mut self) {\n   859\t        let should_finish = self\n   860\t            .escape_sequence\n   861\t            .as_ref()\n   862\t            .is_some_and(|sequence| sequence.bytes.is_empty());\n   863\t        if should_finish {\n   864\t            let sequence = self\n   865\t                .escape_sequence\n   866\t                .take()\n   867\t                .expect(\"escape sequence is present\");\n   868\t            self.dispatch_pending_escape_if_needed(&sequence);\n   869\t        }\n   870\t    }\n","exit_code":0,"status":"completed"}}
