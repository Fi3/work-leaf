at!(\"{prefix}{fixed}{status}\");\n  1560\t    }\n  1561\t\n  1562\t    let flexible_width = width.saturating_sub(fixed_width + 1);\n  1563\t    format!(\n  1564\t        \"{prefix}{fixed} {}{status}\",\n  1565\t        truncate_to_width(flexible, flexible_width)\n  1566\t    )\n  1567\t}\n  1568\t\n  1569\tfn compact_fixed_last(\n  1570\t    prefix: &str,\n  1571\t    flexible: &str,\n  1572\t    fixed: &str,\n  1573\t    status: &str,\n  1574\t    width: usize,\n  1575\t) -> String {\n  1576\t    let fixed_width = prefix.chars().count() + 1 + fixed.chars().count() + status.chars().count();\n  1577\t    if fixed_width >= width {\n  1578\t        return format!(\"{prefix}{fixed}{status}\");\n  1579\t    }\n  1580\t\n  1581\t    let flexible_width = width.saturating_sub(fixed_width);\n  1582\t    format!(\n  1583\t        \"{prefix}{} {fixed}{status}\",\n  1584\t        truncate_to_width(flexible, flexible_width)\n  1585\t    )\n  1586\t}\n  1587\t\n  1588\tfn truncate_to_width(text: &str, width: usize) -> String {\n  1589\t    text.chars().take(width).collect()\n  1590\t}\n  1591\t\n  1592\tfn buffer_to_string(buffer: &Buffer) -> String {\n  1593\t    const ANSI_REVERSE_VIDEO: &str = \"\\u{1b}[7m\";\n  1594\t    const ANSI_RESET: &str = \"\\u{1b}[0m\";\n  1595\t    let mut output = String::new();\n  1596\t    for y in 0..buffer.area.height {\n  1597\t        let mut reversed = false;\n  1598\t        for x in 0..buffer.area.width {\n  1599\t            let cell = buffer.get(x, y);\n  1600\t            let cell_reversed = cell.modifier.contains(Modifier::REVERSED);\n  1601\t            if cell_reversed != reversed {\n  1602\t                output.push_str(if cell_reversed {\n  1603\t                    ANSI_REVERSE_VIDEO\n  1604\t                } else {\n  1605\t                    ANSI_RESET\n  1606\t                });\n  1607\t                reversed = cell_reversed;\n  1608\t            }\n  1609\t            output.push_str(&cell.symbol);\n  1610\t        }\n