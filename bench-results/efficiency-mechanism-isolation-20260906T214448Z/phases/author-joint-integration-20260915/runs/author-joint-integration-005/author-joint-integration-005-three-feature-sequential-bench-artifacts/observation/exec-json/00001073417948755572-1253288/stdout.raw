t(&error));\n   161\t                }\n   162\t            }\n   163\t            \"review\" => {\n   164\t                if let Err(error) = self.start_review() {\n   165\t                    self.push_command_line(command_chat_error_text(&error));\n   166\t                }\n   167\t            }\n   168\t            \"linearize\" => {\n   169\t                if let Err(error) = self.start_linearize() {\n   170\t                    self.push_command_line(command_chat_error_text(&error));\n   171\t                }\n   172\t            }\n   173\t            _ => self.start_command_worker(trimmed.to_string()),\n   174\t        }\n   175\t    }\n   176\t\n   177\t    pub fn send_command_agent_message(&mut self, message: &str) {\n   178\t        let message = message.trim();\n   179\t        if message.is_empty() {\n   180\t            return;\n","exit_code":0,"status":"completed"}}
