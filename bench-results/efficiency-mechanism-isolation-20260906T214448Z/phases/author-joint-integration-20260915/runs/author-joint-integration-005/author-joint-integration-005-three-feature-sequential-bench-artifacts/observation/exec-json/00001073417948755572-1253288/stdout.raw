: u16,\n   216\t    height: u16,\n   217\t    mode: UiMode,\n   218\t    focus: PaneFocus,\n   219\t    left_visible: bool,\n   220\t    agents: Vec<AgentListEntry>,\n   221\t    selected_agent: Option<AgentId>,\n   222\t    control_selected: usize,\n   223\t    split_chats: Vec<AgentId>,\n   224\t    windows: Vec<UiWindow>,\n   225\t    active_window: usize,\n   226\t    right_scroll_rows: usize,\n   227\t    pending: Option<PendingKey>,\n   228\t    pending_bell: Cell<bool>,\n   229\t    pending_clipboard_copy: Cell<bool>,\n   230\t    visual_selection: Option<VisualSelection>,\n   231\t    last_yanked_text: Option<String>,\n   232\t    status_notice: Option<StatusNotice>,\n   233\t    command_mode_typing_count: usize,\n   234\t    command_mode_typing_controls_only: bool,\n   235\t}\n   236\t\n   237\timpl TerminalUi {\n   238\t    pub fn new(width: u16, height: u16) -> Self {\n   239\t        Self {\n   240\t            width,\n","exit_code":0,"status":"completed"}}
