rrent = self.control_selected as isize;\n  1322\t        let next = (current + delta).clamp(0, max_row as isize);\n  1323\t        self.control_selected = next as usize;\n  1324\t    }\n  1325\t\n  1326\t    fn clamp_control_selection(&mut self) {\n  1327\t        let max_row = self.visible_agent_indices().len();\n  1328\t        if self.control_selected > max_row {\n  1329\t            self.control_selected = max_row;\n  1330\t        }\n  1331\t    }\n  1332\t\n  1333\t    fn visible_agent_indices(&self) -> Vec<usize> {\n  1334\t        self.agents\n  1335\t            .iter()\n  1336\t            .enumerate()\n  1337\t            .filter_map(|(index, agent)| (!agent.hidden).then_some(index))\n  1338\t            .collect()\n  1339\t    }\n  1340\t\n  1341\t    fn control_selected_agent_index(&self) -> Option<usize> {\n  1342\t        if self.control_selected == 0 {\n  1343\t            return None;\n  1344\t        }\n  1345\t        self.visible_agent_indices()\n  1346\t            .get(self.control_selected - 1)\n  1347\t            .copied()\n  1348\t    }\n  1349\t\n  1350\t    fn control_selected_agent_id(&self) -> Option<AgentId> {\n  1351\t        self.control_selected_agent_index()\n  1352\t            .map(|index| self.agents[index].id.clone())\n  1353\t    }\n  1354\t\n  1355\t    fn left_pane_click_target(&mut self, row: u16) -> Option<LeftPaneClickTarget> {\n  1356\t        let list_row = usize::from(row.saturating_sub(2));\n  1357\t        if row < 2 {\n  1358\t            return None;\n  1359\t        }\n  1360\t        if list_row == 0 {\n  1361\t            self.control_selected = 0;\n  1362\t            return Some(LeftPaneClickTarget::Command);\n  1363\t        }\n  1364\t\n  1365\t        let mut current_row = 1;\n  1366\t        for (visible_position, agent_index) in self.visible_agent_indices().iter().enumerate() {\n  1367\t            let agent = &self.agents[*agent_index];\n  1368\t            if list_row == current_row {\n  1369\t                self.control_selected = visible_position + 1;\n  1370\t                return Some(LeftPaneClickTarget::Agent(agent.id.clone()));\n  1371\t            }\n  1372\t            current_row += 1;\n  1373\t\n  1374\t            if !agent.modified_files.is_empty() {\n  1375\t                if list_row == current_row {\n  1376\t                    self.control_selected = visible_position + 1;\n  1377\t                    return Some(LeftPaneClickTarget::Agent(agent.id.clone()));\n  1378\t                }\n  1379\t                current_row += 1;\n  1380\t            }\n  1381\t\n  1382\t            for linked_agents in [\n  1383\t                &agent.conflicting_agents,\n  1384\t                &agent.depends_on,\n  1385\t                &agent.depended_on_by,\n  1386\t            ] {\n  1387\t                if !linked_agents.is_empty() {\n  1388\t                    if list_row == current_row {\n  1389\t                        self.control_selected = visible_position + 1;\n  1390\t                        return linked_agents\n  1391\t                            .first()\n  1392\t                            .cloned()\n  1393\t                            .map(LeftPaneClickTarget::Agent);\n  1394\t                    }\n  1395\t                    current_row += 1;\n","exit_code":0,"status":"completed"}}
