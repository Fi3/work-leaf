\n   663\t                if let Some(agent_id) = agent_id {\n   664\t                    let start_review = should_start_review(&agent_id, &result);\n   665\t                    self.set_session_loading(&agent_id, None);\n   666\t                    self.apply_agent_result(&agent_id, &result);\n   667\t                    if start_review && let Err(error) = self.start_review_for_patch_agent(&agent_id)\n   668\t                    {\n   669\t                        self.push_command_line(command_chat_error_text(&error));\n   670\t                    }\n   671\t                } else {\n   672\t                    self.push_command_line(command_result_text(&result));\n   673\t                    if matches!(result, CommandChatResult::Quit) {\n   674\t                        self.request_quit();\n   675\t                    }\n   676\t                }\n   677\t            }\n   678\t            WorkerEvent::Error { agent_id, message } => {\n   679\t                if let Some(agent_id) = agent_id {\n   680\t                    self.set_session_loading(&agent_id, None);\n   681\t                    self.append_agent_line(&agent_id, message);\n   682\t                } else {\n   683\t                    self.push_command_line(message);\n   684\t                }\n   685\t            }\n   686\t            WorkerEvent::ReviewError {\n   687\t                reviewer_id,\n   688\t                reviewed_agent_id,\n   689\t                message,\n   690\t            } => {\n","exit_code":0,"status":"completed"}}
