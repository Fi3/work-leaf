             .push(\"commands: new [prompt...], review, linearize, quit\".into());\nsrc/ui_harness.rs:300:            \"review\" => {\nsrc/ui_harness.rs:301:                self.transcript.push(\"fixture review: no findings\".into());\nsrc/ui_harness.rs:303:                    self.prompt_feature_completion(&agent_id);\nsrc/ui_harness.rs:315:    fn prompt_feature_completion(&mut self, agent_id: &AgentId) {\nsrc/ui_harness.rs:317:        self.feature_completion_prompts.insert(agent_id.clone());\nsrc/ui_harness.rs:322:    fn handle_feature_completion_reply(&mut self, agent_id: &AgentId, message: &str) -> bool {\nsrc/ui_harness.rs:323:        if !self.feature_completion_prompts.contains(agent_id) {\nsrc/ui_harness.rs:326:        if feature_completion_yes(message) {\nsrc/ui_harness.rs:327:            self.feature_completion_prompts.remove(agent_id);\nsrc/ui_harness.rs:334:        if feature_completion_no(message) {\nsrc/ui_harness.rs:335:            self.feature_completion_prompts.remove(agent_id);\nsrc/ui_harness.rs:343:        self.feature_completion_prompts.remove(agent_id);\nsrc/ui_harness.rs:352:            self.feature_completion_prompts.remove(agent_id);\nsrc/ui_harness.rs:501:    fn should_start_agent_slash_command(&self) -> bool {\nsrc/ui_harness.rs:503:            && !self.ui.is_visual_active()\nsrc/ui_harness.rs:507:    fn start_agent_slash_command(&mut self) {\nsrc/ui_harness.rs:517:        !self.ui.is_visual_active()\nsrc/ui_harness.rs:527:    fn finish_pending_escape_sequence(&mut self) {\nsrc/ui_harness.rs:537:            self.dispatch_pending_escape_if_needed(&sequence);\nsrc/ui_harness.rs:541:    fn dispatch_pending_escape_if_needed(&mut self, sequence: &PendingEscapeSequence) {\nsrc/ui_harness.rs:557:            self.dispatch_pending_escape_if_needed(&sequence);\nsrc/ui_harness.rs:582:            self.dispatch_pending_escape_if_needed(&sequence);\nsrc/ui_harness.rs:679:fn feature_completion_yes(message: &str) -> bool {\nsrc/ui_harness.rs:683:fn feature_completion_no(message: &str) -> bool {\ntests/workspace.rs:49:fn controller_routes_slash_command_line_to_selected_backend_agent() {\ntests/workspace.rs:83:fn controller_keeps_slash_followed_by_whitespace_on_command_surface() {\ntests/workspace.rs:232:fn controller_uses_agent_profile_for_non_codex_launches_and_reviews() {\ntests/workspace.rs:233:    let root = git_repo(\"workspace-custom-profile-review\");\ntests/workspace.rs:259:    controller.start_review().unwrap();\ntests/workspace.rs:271:            .any(|launch| { launch.id.as_str() == \"review-user-1\" && launch.kind == profile.kind })\ntests/workspace.rs:276:fn controller_starts_review_after_patch_agent_done_and_loops_until_clean() {\ntests/workspace.rs:277:    let root = git_repo(\"workspace-automatic-review-loop\");\ntests/workspace.rs:284:        \"FINDINGS\\n- missing reviewed wording\",\ntests/workspace.rs:285:        \"fixed review finding\\n@work-leaf patch address review\\n--- a/README.md\\n+++ b/README.md\\n@@ -1 +1 @@\\n-after\\n+after review\\n@work-leaf end\\n@work-leaf done\",\ntests/workspace.rs:288:    let chat = CommandChat::new(root.clone(), backend.clone()).with_max_review_rounds(4);\ntests/workspace.rs:296:        \"after review\\n\"\ntests/workspace.rs:299:    let reviewer_id = AgentId::new(\"review-user-1\").unwrap();\ntests/workspace.rs:301:    let reviewer = snapshot\ntests/workspace.rs:302:        .session(&reviewer_id)\ntests/workspace.rs:303:        .expect(\"reviewer session exists\");\ntests/workspace.rs:304:    assert_eq!(reviewer.title, \"review user-agent\");\ntests/workspace.rs:305:    assert_eq!(reviewer.loading, None);\ntests/workspace.rs:311:            .any(|line| line.contains(\"missing reviewed wording\"))\ntests/workspace.rs:315:            line.contains(\"user-1 reviewed by review-user-1: rounds=2 resolved=yes\")\ntests/workspace.rs:322:            && prompt.contains(\"missing reviewed wording\")\ntests/workspace.rs:326:        target == &reviewer_id\ntests/workspace.rs:333:fn controller_review_completion_prompts_user_to_close_and_reopen_patch_agent() {\ntests/workspace.rs:334:    let root = git_repo(\"workspace-review-close-reopen\");\ntests/workspace.rs:344:    let chat = CommandChat::new(root, backend.clone()).with_max_review_rounds(4);\ntests/workspace.rs:410:fn controller_does_not_start_review_until_patch_agent_reports_done() {\ntests/workspace.rs:411:    let root = git_repo(\"workspace-review-waits-for-done\");\ntests/workspace.rs:420:    let chat = CommandChat::new(root, backend.clone()).with_max_review_rounds(4);\ntests/workspace.rs:429:            .session(&AgentId::new(\"review-user-1\").unwrap())\ntests/workspace.rs:431:        \"review must wait for the patch agent to report done\"\ntests/workspace.rs:439:            .any(|launch| launch.id.as_str() == \"review-user-1\")\ntests/workspace.rs:450:fn controller_review_prompt_covers_all_agent_commits_since_launch() {\ntests/workspace.rs:451:    let root = git_repo(\"workspace-review-full-agent-scope\");\ntests/workspace.rs:461:    let chat = CommandChat::new(root, backend.clone()).with_max_review_rounds(4);\ntests/workspace.rs:471:    let review_launch = launches\ntests/workspace.rs:473:        .find(|launch| launch.id.as_str() == \"review-user-1\")\ntests/workspace.rs:474:        .expect(\"reviewer launched\");\ntests/workspace.rs:476:        review_launch.prompt.contains(\"first step\"),\ntests/workspace.rs:478:        review_launch.prompt\ntests/workspace.rs:481:        review_launch.prompt.contains(\"second step\"),\ntests/workspace.rs:483:        review_launch.prompt\ntests/workspace.rs:488:fn controller_reuses_one_reviewer_for_repeated_patch_agent_iterations() {\ntests/workspace.rs:489:    let root = git_repo(\"workspace-reuses-reviewer\");\ntests/workspace.rs:501:    let chat = CommandChat::new(root.clone(), backend.clone()).with_max_review_rounds(4);\ntests/workspace.rs:516:    let reviewer_id = AgentId::new(\"review-user-1\").unwrap();\ntests/workspace.rs:521:            .filter(|launch| launch.id == reviewer_id)\ntests/workspace.rs:527:        target == &reviewer_id\ntests/workspace.rs:534:fn controller_reviews_only_unreviewed_patch_agent_commits() {\ntests/workspace.rs:535:    let root = git_repo(\"workspace-reviews-only-unreviewed\");\ntests/workspace.rs:548:    let chat = CommandChat::new(root, backend.clone()).with_max_review_rounds(4);\ntests/workspace.rs:563:            .filter(|launch| launch.id.as_str() == \"review-user-1\")\ntests/workspace.rs:570:            .filter(|launch| launch.id.as_str() == \"review-user-2\")\ntests/workspace.rs:577:fn controller_auto_review_ignores_historical_agents_outside_current_patch_agent() {\ntests/workspace.rs:578:    let root = git_repo(\"workspace-auto-review-current-agent-only\");\ntests/workspace.rs:610:    let chat = CommandChat::new(root, backend.clone()).with_max_review_rounds(4);\ntests/workspace.rs:621:            .filter(|launch| launch.id.as_str().starts_with(\"review-\"))\ntests/workspace.rs:624:        vec![\"review-user-1\".to_string()]\ntests/workspace.rs:629:fn controller_linearize_uses_only_commits_reviewed_in_this_session() {\ntests/workspace.rs:630:    let root = git_repo(\"workspace-linearize-current-reviewed-only\");\ntests/workspace.rs:653:    let chat = CommandChat::new(root, backend.clone()).with_max_review_rounds(4);\ntests/workspace.rs:674:fn controller_linearize_keeps_multiple_reviewed_commits_from_same_agent() {\ntests/workspace.rs:675:    let root = git_repo(\"workspace-linearize-same-agent-multiple-reviewed\");\ntests/workspace.rs:681:        \"summary: first reviewed change\",\ntests/workspace.rs:684:        \"summary: second reviewed change\",\ntests/workspace.rs:688:    let chat = CommandChat::new(root, backend.clone()).with_max_review_rounds(4);\ntests/workspace.rs:695:        .send_message(&agent_id, \"make a second reviewed update\")\n","exit_code":2,"status":"failed"}}
