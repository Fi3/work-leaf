sc));\n   476\t            }\n   477\t            return !self.quit;\n   478\t        }\n   479\t\n   480\t        let Some(input) = self.input_from_byte(byte) else {\n   481\t            return true;\n   482\t        };\n   483\t        self.handle_input(input);\n   484\t        !self.quit\n   485\t    }\n   486\t\n   487\t    pub fn render_frame(&self) -> String {\n   488\t        let right_content = self.right_content();\n   489\t        self.ui.render_screen_with_cursors(\n   490\t            &right_content,\n   491\t            self.prompt_buffer.as_str(),\n   492\t            self.prompt_buffer.cursor(),\n   493\t            self.right_cursor_column(),\n   494\t        )\n   495\t    }\n   496\t\n   497\t    pub fn poll_worker(&mut self) {\n   498\t        self.apply_controller_events();\n   499\t    }\n   500\t\n   501\t    fn right_cursor_column(&self) -> Option<usize> {\n   502\t        (self.ui.focus() == PaneFocus::Right && self.ui.mode() != UiMode::Prompt)\n   503\t            .then_some(6 + self.chat_buffer.cursor_char_count())\n   504\t    }\n   505\t\n   506\t    fn handle_ui_key(&mut self, key: UiKey) -> Vec<crate::UiAction> {\n   507\t        let right_content = self.right_content();\n   508\t        self.ui\n   509\t            .handle_key_with_pane_content(key, &right_content, self.right_cursor_column())\n   510\t    }\n   511\t\n   512\t    fn handle_input(&mut self, input: TerminalAppInput) {\n   513\t        match input {\n   514\t            TerminalAppInput::Quit => {\n   515\t                self.request_quit();\n   516\t            }\n   517\t            TerminalAppInput::Interrupt => {\n   518\t                self.ui.show_ctrl_c_exit_notice();\n   519\t                if self.ui.focus() == PaneFocus::Right\n   520\t                    && let Some(agent_id) = self.ui.selected_agent().cloned()\n","exit_code":0,"status":"completed"}}
