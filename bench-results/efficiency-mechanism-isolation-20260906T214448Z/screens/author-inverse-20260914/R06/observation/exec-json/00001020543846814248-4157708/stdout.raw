           UiKey::Char('Y') => self.yank_visual_selection(true, right_content),\n   857\t            UiKey::Char('v') => {\n   858\t                self.switch_visual_selection_kind(\n   859\t                    VisualKind::Character,\n   860\t                    right_content,\n   861\t                    right_cursor_column,\n   862\t                );\n   863\t            }\n   864\t            UiKey::Char('V') => {\n   865\t                self.switch_visual_selection_kind(\n   866\t                    VisualKind::Line,\n   867\t                    right_content,\n   868\t                    right_cursor_column,\n   869\t                );\n   870\t            }\n   871\t            UiKey::Char(CTRL_V_CHAR) => {\n   872\t                self.switch_visual_selection_kind(\n   873\t                    VisualKind::Block,\n   874\t                    right_content,\n   875\t                    right_cursor_column,\n   876\t                );\n   877\t            }\n   878\t            _ => {}\n   879\t        }\n   880\t        Vec::new()\n   881\t    }\n   882\t\n   883\t    fn start_visual_selection(\n   884\t        &mut self,\n   885\t        kind: VisualKind,\n   886\t        right_content: &str,\n   887\t        right_cursor_column: Option<usize>,\n   888\t    ) {\n   889\t        self.pending = None;\n   890\t        self.mode = UiMode::Command;\n   891\t        let pane = if self.focus == PaneFocus::Left && !self.left_visible {\n   892\t            PaneFocus::Right\n   893\t        } else {\n   894\t            self.focus\n   895\t        };\n   896\t        let position = self.initial_visual_position(pane, right_content, right_cursor_column);\n   897\t        self.visual_selection = Some(VisualSelection {\n   898\t            pane,\n   899\t            kind,\n   900\t            anchor: position,\n   901\t            cursor: position,\n   902\t        });\n   903\t    }\n   904\t\n   905\t    fn switch_visual_selection_kind(\n   906\t        &mut self,\n   907\t        kind: VisualKind,\n   908\t        right_content: &str,\n   909\t        right_cursor_column: Option<usize>,\n   910\t    ) {\n   911\t        let Some(selection) = self.visual_selection else {\n   912\t            self.start_visual_selection(kind, right_content, right_cursor_column);\n   913\t            return;\n   914\t        };\n   915\t\n   916\t        if selection.kind == kind {\n   917\t            self.clear_visual_selection();\n   918\t        } else {\n   919\t            self.visual_selection = Some(VisualSelection { kind, ..selection });\n   920\t        }\n   921\t    }\n   922\t\n   923\t    fn initial_visual_position(\n   924\t        &self,\n   925\t        pane: PaneFocus,\n   926\t        right_content: &str,\n   927\t        right_cursor_column: Option<usize>,\n   928\t    ) -> VisualPosition {\n   929\t        match pane {\n   930\t            PaneFocus::Left => {\n   931\t                let lines = self.pane_text_lines(PaneFocus::Left, right_content);\n   932\t                let row = self.control_selected.min(lines.len().saturating_sub(1));\n   933\t                let column = clamp_visual_column(0, &lines[row]);\n   934\t                VisualPosition { row, column }\n   935\t            }\n   936\t            PaneFocus::Right => {\n   937\t                let lines = self.pane_text_lines(PaneFocus::Right, right_content);\n   938\t                let row = lines.len().saturating_sub(1);\n   939\t                let line_width = line_char_count(&lines[row]);\n   940\t                let requested_column = right_cursor_column.unwrap_or(line_width);\n   941\t                let column = clamp_visual_column(requested_column, &lines[row]);\n   942\t                VisualPosition { row, column }\n   943\t            }\n   944\t        }\n   945\t    }\n   946\t\n   947\t    fn move_visual_cursor(&mut self, row_delta: isize, column_delta: isize, right_content: &str) {\n   948\t        let Some(mut selection) = self.visual_selection else {\n   949\t            return;\n   950\t        };\n   951\t        let lines = self.pane_text_lines(selection.pane, right_content);\n   952\t        let max_row = lines.len().saturating_sub(1) as isize;\n   953\t        let row = (selection.cursor.row as isize + row_delta).clamp(0, max_row) as usize;\n   954\t        let column = if column_delta == 0 {\n   955\t            selection.cursor.column\n   956\t        } else if column_delta.is_negative() {\n   957\t            selection\n   958\t                .cursor\n   959\t                .column\n   960\t                .saturating_sub(column_delta.unsigned_abs())\n   961\t        } else {\n   962\t            selection\n   963\t                .cursor\n   964\t                .column\n   965\t                .saturating_add(column_delta as usize)\n   966\t        };\n   967\t        selection.cursor = VisualPosition {\n   968\t            row,\n   969\t            column: clamp_visual_column(column, &lines[row]),\n   970\t        };\n   971\t        self.visual_selection = Some(selection);\n   972\t    }\n   973\t\n   974\t    fn yank_visual_selection(&mut self, whole_lines: bool, right_content: &str) {\n   975\t        let Some(selection) = self.visual_selection else {\n   976\t            return;\n   977\t        };\n   978\t        let kind = if whole_lines {\n   979\t            VisualKind::Line\n   980\t        } else {\n   981\t            selection.kind\n   982\t        };\n   983\t        let text = self.selected_text(selection, kind, right_content);\n   984\t        self.store_yank(text);\n   985\t        self.clear_visual_selection();\n   986\t        self.mode = UiMode::Command;\n   987\t    }\n   988\t\n   989\t    fn yank_current_line(&mut self, right_content: &str, right_cursor_column: Option<usize>) {\n   990\t        let pane = if self.focus == PaneFocus::Left && !self.left_visible {\n   991\t            PaneFocus::Right\n   992\t        } else {\n   993\t            self.focus\n   994\t        };\n   995\t        let position = self.initial_visual_position(pane, right_content, right_cursor_column);\n   996\t        let selection = VisualSelection {\n   997\t            pane,\n   998\t            kind: VisualKind::Line,\n   999\t            anchor: position,\n  1000\t            cursor: position,\n  1001\t        };\n  1002\t        let text = self.selected_text(selection, VisualKind::Line, right_content);\n  1003\t        self.store_yank(text);\n  1004\t    }\n  1005\t\n  1006\t    fn store_yank(&mut self, text: String) {\n  1007\t        let char_count = text.chars().count();\n  1008\t        self.yank_register = Some(text);\n  1009\t        self.pending_clipboard.set(true);\n  1010\t        self.show_status_notice(\n  1011\t            format!(\"yanked {char_count} chars\"),\n  1012\t            Duration::from_secs(STATUS_NOTICE_SECONDS),\n  1013\t        );\n  1014\t    }\n  1015\t\n  1016\t    fn selected_text(\n  1017\t        &self,\n  1018\t        selection: VisualSelection,\n  1019\t        kind: VisualKind,\n  1020\t        right_content: &str,\n  1021\t    ) -> String {\n  1022\t        let lines = self.pane_text_lines(selection.pane, right_content);\n  1023\t        let (start_row, end_row) = selected_row_bounds(selection);\n  1024\t        (start_row..=end_row.min(lines.len().saturating_sub(1)))\n  1025\t            .map(|row| {\n  1026\t                let range = selection_range_for(selection, kind, row, &lines[row])?;\n  1027\t                Some(slice_chars(&lines[row], range))\n  1028\t            })\n  1029\t            .collect::<Option<Vec<_>>>()\n  1030\t            .unwrap_or_default()\n  1031\t            .join(\"\\n\")\n  1032\t    }\n  1033\t\n  1034\t    fn selection_range_for_line(\n  1035\t        &self,\n  1036\t        pane: PaneFocus,\n  1037\t        row: usize,\n  1038\t        line: &str,\n  1039\t    ) -> Option<Range<usize>> {\n  1040\t        let selection = self.visual_selection?;\n  1041\t        if selection.pane != pane {\n  1042\t            return None;\n  1043\t        }\n  1044\t        let range = selection_range_for(selection, selection.kind, row, line)?;\n  1045\t        (range.start < range.end).then_some(range)\n  1046\t    }\n  1047\t\n  1048\t    fn pane_text_lines(&self, pane: PaneFocus, right_content: &str) -> Vec<String> {\n  1049\t        match pane {\n  1050\t            PaneFocus::Left => self\n  1051\t                .left_pane_tui_lines()\n  1052\t                .into_iter()\n  1053\t                .map(|line| line.text)\n  1054\t                .collect(),\n  1055\t            PaneFocus::Right => text_lines(&self.visible_right_content(right_content)),\n  1056\t        }\n  1057\t    }\n  1058\t\n  1059\t    fn left_pane_tui_lines(&self) -> Vec<PaneLine> {\n  1060\t        let inner_width = usize::from(self.layout().left_width.saturating_sub(2).max(1));\n  1061\t        let mut lines = vec![PaneLine {\n  1062\t            text: if self.control_selected == 0 {\n  1063\t                \"> work-leaf  command\".to_string()\n  1064\t            } else {\n  1065\t                \"  work-leaf  command\".to_string()\n  1066\t            },\n  1067\t            reversed: false,\n  1068\t        }];\n  1069\t\n  1070\t        for (visible_position, agent_index) in self.visible_agent_indices().iter().enumerate() {\n  1071\t            let agent = &self.agents[*agent_index];\n  1072\t            let selected = self.control_selected == visible_position + 1;\n  1073\t            lines.push(PaneLine {\n  1074\t                text: compact_agent_row(agent, selected, inner_width),\n  1075\t                reversed: agent.ready,\n  1076\t            });\n  1077\t\n  1078\t            if !agent.modified_files.is_empty() {\n  1079\t                lines.push(PaneLine {\n  1080\t                    text: format!(\n  1081\t                        \"    files: {}\",\n  1082\t                        agent\n  1083\t                            .modified_files\n  1084\t                            .iter()\n  1085\t                            .map(|path| path.display().to_string())\n  1086\t                            .collect::<Vec<_>>()\n  1087\t                            .join(\", \")\n  1088\t                    ),\n  1089\t                    reversed: false,\n  1090\t                });\n  1091\t            }\n  1092\t\n  1093\t            for (label, agents) in [\n  1094\t                (\"conflicts\", &agent.conflicting_agents),\n  1095\t                (\"depends-on\", &agent.depends_on),\n  1096\t                (\"depended-on-by\", &agent.depended_on_by),\n  1097\t            ] {\n  1098\t                if !agents.is_empty() {\n  1099\t                    lines.push(PaneLine {\n  1100\t                        text: format!(\n  1101\t                            \"    {label}: {}\",\n  1102\t                            agents\n  1103\t                                .iter()\n  1104\t                                .map(AgentId::as_str)\n  1105\t                                .collect::<Vec<_>>()\n  1106\t                                .join(\", \")\n  1107\t                        ),\n  1108\t                        reversed: false,\n  1109\t                    });\n  1110\t                }\n  1111\t            }\n  1112\t        }\n  1113\t\n  1114\t        lines\n  1115\t    }\n  1116\t\n  1117\t    fn clear_visual_selection(&mut self) {\n  1118\t        self.visual_selection = None;\n  1119\t    }\n  1120\t\n  1121\t    fn command_mode_text_key_control_status(&self, key: UiKey) -> Option<bool> {\n  1122\t        if self.mode != UiMode::Command || self.pending.is_some() || self.has_visual_selection() {\n  1123\t            return None;\n  1124\t        }\n  1125\t        let UiKey::Char(ch) = key else {\n  1126\t            return None;\n  1127\t        };\n  1128\t        (ch.is_ascii_alphanumeric() || ch == ' ').then(|| self.is_command_control_char(ch))\n  1129\t    }\n  1130\t\n  1131\t    fn is_command_control_char(&self, ch: char) -> bool {\n  1132\t        matches!(\n  1133\t            ch,\n  1134\t            'i' | ':' | ',' | 's' | 't' | 'f' | 'g' | 'v' | 'V' | 'Y'\n  1135\t        ) || (self.focus == PaneFocus::Left && matches!(ch, 'j' | 'k' | 'l' | 'x'))\n  1136\t    }\n  1137\t\n  1138\t    fn update_command_mode_typing_notice(&mut self, command_mode_text_key_control: Option<bool>) {\n  1139\t        if let Some(command_mode_text_key_control) = command_mode_text_key_control\n  1140\t            && self.mode == UiMode::Command\n  1141\t            && self.pending.is_none()\n  1142\t        {\n  1143\t            self.command_mode_typing_count = self.command_mode_typing_count.saturating_add(1);\n  1144\t            self.command_mode_typing_controls_only &= command_mode_text_key_control;\n  1145\t            if self.command_mode_typing_count >= COMMAND_MODE_TYPING_NOTICE_THRESHOLD {\n  1146\t                if !self.command_mode_typing_controls_only {\n  1147\t                    self.show_status_notice(\n  1148\t                        COMMAND_MODE_TYPING_NOTICE,\n  1149\t                        Duration::from_secs(STATUS_NOTICE_SECONDS),\n  1150\t                    );\n  1151\t                }\n  1152\t                self.command_mode_typing_count = 0;\n  1153\t                self.command_mode_typing_controls_only = true;\n  1154\t            }\n  1155\t        } else {\n  1156\t            self.command_mode_typing_count = 0;\n  1157\t            self.command_mode_typing_controls_only = true;\n  1158\t        }\n  1159\t    }\n  1160\t\n","exit_code":0,"status":"completed"}}
