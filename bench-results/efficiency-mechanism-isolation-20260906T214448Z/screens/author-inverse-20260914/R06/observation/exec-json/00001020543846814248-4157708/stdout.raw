e_text(UiKey::Char('k'), right_content, Some(0));\n+    ui.handle_key_with_pane_text(UiKey::Char('y'), right_content, Some(0));\n+\n+    assert_eq!(ui.yanked_text(), Some(\"ab\\nwx\"));\n+}\n+\n+#[test]\n+fn visual_character_mode_yanks_text_from_the_left_pane() {\n+    let mut ui = TerminalUi::new(80, 12);\n+    let agent_id = AgentId::new(\"user-1\").unwrap();\n+    ui.add_agent(AgentListEntry::new(agent_id.clone(), \"alpha\"));\n+    ui.select_agent(&agent_id).unwrap();\n+\n+    ui.handle_key(UiKey::Char('v'));\n+    ui.handle_key(UiKey::Char('l'));\n+    ui.handle_key(UiKey::Char('y'));\n+\n+    assert_eq!(ui.yanked_text(), Some(\">a\"));\n+}\n+\n fn strip_ansi(input: &str) -> String {\n     let mut output = String::new();\n     let mut chars = input.chars();\ndiff --git a/tests/ui_harness.rs b/tests/ui_harness.rs\nindex dd7a280..bf10b4c 100644\n--- a/tests/ui_harness.rs\n+++ b/tests/ui_harness.rs\n@@ -533,6 +533,22 @@ fn scripted_harness_left_right_arrows_move_left_pane_selection_like_j_k() {\n     );\n }\n \n+#[test]\n+fn scripted_harness_visual_line_mode_yanks_right_pane_text() {\n+    let mut harness = UiHarness::new(80, 24);\n+\n+    harness.handle_bytes(&[23, b'l']);\n+    harness.handle_bytes(b\"VkY\");\n+\n+    assert_eq!(\n+        harness.ui().yanked_text(),\n+        Some(\n+            \"Esc command, i insert, : prompt, Ctrl-W h/j/k/l focus, , toggle right, q quit\\nchat> \"\n+        )\n+    );\n+    assert!(harness.render_frame().contains(\"\\u{1b}]52;c;\"));\n+}\n+\n fn strip_ansi(input: &str) -> String {\n     let mut output = String::new();\n     let mut chars = input.chars();\n","exit_code":0,"status":"completed"}}
