 = ready;\n   351\t        Ok(())\n   352\t    }\n   353\t\n   354\t    pub fn select_agent(&mut self, agent_id: &AgentId) -> Result<(), String> {\n   355\t        if self.agents.iter().any(|agent| &agent.id == agent_id) {\n   356\t            self.clear_visual_selection();\n   357\t            self.selected_agent = Some(agent_id.clone());\n   358\t            self.windows[self.active_window] = UiWindow::chat(agent_id.clone());\n   359\t            self.control_selected = self\n   360\t                .visible_agent_indices()\n   361\t                .iter()\n   362\t                .position(|index| self.agents[*index].id == *agent_id)\n   363\t                .map(|position| position + 1)\n   364\t                .unwrap_or(self.control_selected);\n   365\t            self.reset_right_scroll();\n   366\t            Ok(())\n   367\t        } else {\n   368\t            Err(format!(\"unknown agent `{agent_id}`\"))\n   369\t        }\n   370\t    }\n   371\t\n   372\t    pub fn activate_agent_chat(&mut self, agent_id: &AgentId) -> Result<(), String> {\n   373\t        self.select_agent(agent_id)?;\n   374\t        self.focus = PaneFocus::Right;\n   375\t        self.mode = UiMode::Insert;\n   376\t        Ok(())\n   377\t    }\n   378\t\n   379\t    pub fn select_command_interface(&mut self) {\n   380\t        self.clear_visual_selection();\n   381\t        self.selected_agent = None;\n   382\t        self.windows[self.active_window] = UiWindow::command();\n   383\t        self.control_selected = 0;\n   384\t        self.reset_right_scroll();\n   385\t    }\n   386\t\n   387\t    pub fn handle_key(&mut self, key: UiKey) -> Vec<UiAction> {\n   388\t        self.handle_key_with_pane_text(key, \"\", None)\n   389\t    }\n   390\t\n   391\t    pub fn handle_key_with_pane_text(\n   392\t        &mut self,\n   393\t        key: UiKey,\n   394\t        right_content: &str,\n   395\t        right_cursor_column: Option<usize>,\n   396\t    ) -> Vec<UiAction> {\n   397\t        let command_mode_text_key = self.command_mode_text_key_control_status(key);\n   398\t        let actions = self.handle_key_inner(key, right_content, right_cursor_column);\n   399\t        self.update_command_mode_typing_notice(command_mode_text_key);\n   400\t        actions\n   401\t    }\n   402\t\n   403\t    fn handle_key_inner(\n   404\t        &mut self,\n   405\t        key: UiKey,\n   406\t        right_content: &str,\n   407\t        right_cursor_column: Option<usize>,\n   408\t    ) -> Vec<UiAction> {\n   409\t        match key {\n   410\t            UiKey::MouseClick { column, row } => {\n   411\t                self.pending = None;\n   412\t                self.clear_visual_selection();\n   413\t                return self.handle_mouse_click(column, row);\n   414\t            }\n   415\t            UiKey::MouseScrollUp { column, row } => {\n   416\t                self.pending = None;\n   417\t                self.clear_visual_selection();\n   418\t                self.handle_mouse_scroll(column, row, true);\n   419\t                return Vec::new();\n   420\t            }\n   421\t            UiKey::MouseScrollDown { column, row } => {\n   422\t                self.pending = None;\n   423\t                self.clear_visual_selection();\n   424\t                self.handle_mouse_scroll(column, row, false);\n   425\t                return Vec::new();\n   426\t            }\n   427\t            _ => {}\n   428\t        }\n   429\t\n   430\t        if let Some(pending) = self.pending.take() {\n   431\t            return self.handle_pending_key(pending, key);\n   432\t        }\n   433\t\n   434\t        if self.visual_selection.is_some() {\n   435\t            return self.handle_visual_key(key, right_content, right_cursor_column);\n   436\t        }\n   437\t\n   438\t        match key {\n   439\t            UiKey::Esc => {\n   440\t                self.mode = UiMode::Command;\n   441\t                Vec::new()\n   442\t            }\n   443\t            UiKey::CtrlW if self.mode == UiMode::Command => {\n   444\t                self.pending = Some(PendingKey::CtrlW);\n   445\t                Vec::new()\n   446\t            }\n   447\t            UiKey::Char('g') if self.mode == UiMode::Command => {\n   448\t                self.pending = Some(PendingKey::G);\n   449\t                Vec::new()\n   450\t            }\n   451\t            UiKey::Char('i') if self.mode == UiMode::Command => {\n   452\t                self.mode = UiMode::Insert;\n   453\t                Vec::new()\n   454\t            }\n   455\t            UiKey::Char('v') if self.mode == UiMode::Command => {\n   456\t                self.start_visual_selection(\n   457\t                    VisualKind::Character,\n   458\t                    right_content,\n   459\t                    right_cursor_column,\n   460\t                );\n   461\t                Vec::new()\n   462\t            }\n   463\t            UiKey::Char('V') if self.mode == UiMode::Command => {\n   464\t                self.start_visual_selection(VisualKind::Line, right_content, right_cursor_column);\n   465\t                Vec::new()\n   466\t            }\n   467\t            UiKey::Char(CTRL_V_CHAR) if self.mode == UiMode::Command => {\n   468\t                self.start_visual_selection(VisualKind::Block, right_content, right_cursor_column);\n   469\t                Vec::new()\n   470\t            }\n","exit_code":0,"status":"completed"}}
