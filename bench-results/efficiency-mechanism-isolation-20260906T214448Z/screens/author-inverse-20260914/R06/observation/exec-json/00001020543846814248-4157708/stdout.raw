   let end = end.saturating_add(1).min(line_width);\n+            Some(start..end)\n+        }\n+        VisualKind::Character => {\n+            let (start, end) = normalized_visual_positions(selection);\n+            if start.row == end.row {\n+                return Some(\n+                    start.column.min(line_width)..end.column.saturating_add(1).min(line_width),\n+                );\n+            }\n+            if row == start.row {\n+                Some(start.column.min(line_width)..line_width)\n+            } else if row == end.row {\n+                Some(0..end.column.saturating_add(1).min(line_width))\n+            } else {\n+                Some(0..line_width)\n+            }\n+        }\n+    }\n+}\n+\n+fn selected_row_bounds(selection: VisualSelection) -> (usize, usize) {\n+    (\n+        selection.anchor.row.min(selection.cursor.row),\n+        selection.anchor.row.max(selection.cursor.row),\n+    )\n+}\n+\n+fn normalized_visual_positions(selection: VisualSelection) -> (VisualPosition, VisualPosition) {\n+    let anchor_before_cursor = selection.anchor.row < selection.cursor.row\n+        || (selection.anchor.row == selection.cursor.row\n+            && selection.anchor.column <= selection.cursor.column);\n+    if anchor_before_cursor {\n+        (selection.anchor, selection.cursor)\n+    } else {\n+        (selection.cursor, selection.anchor)\n+    }\n+}\n+\n+fn slice_chars(line: &str, range: Range<usize>) -> String {\n+    let start = byte_index_at_char(line, range.start);\n+    let end = byte_index_at_char(line, range.end);\n+    line[start..end].to_string()\n+}\n+\n+fn clamp_visual_column(column: usize, line: &str) -> usize {\n+    line_char_count(line).saturating_sub(1).min(column)\n+}\n+\n+fn line_char_count(line: &str) -> usize {\n+    line.chars().count()\n+}\n+\n+fn byte_index_at_char(text: &str, char_index: usize) -> usize {\n+    if char_index == 0 {\n+        return 0;\n+    }\n+    text.char_indices()\n+        .nth(char_index)\n+        .map(|(index, _)| index)\n+        .unwrap_or(text.len())\n+}\n+\n+fn text_lines(text: &str) -> Vec<String> {\n+    if text.is_empty() {\n+        vec![String::new()]\n+    } else {\n+        text.lines().map(str::to_string).collect()\n+    }\n+}\n+\n+fn osc52_clipboard_sequence(text: &str) -> String {\n+    format!(\"\\u{1b}]52;c;{}\\u{7}\", base64_encode(text.as_bytes()))\n+}\n+\n+fn base64_encode(input: &[u8]) -> String {\n+    const TABLE: &[u8; 64] = b\"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\";\n+    let mut output = String::with_capacity(input.len().div_ceil(3) * 4);\n+\n+    for chunk in input.chunks(3) {\n+        let first = chunk[0];\n+        let second = *chunk.get(1).unwrap_or(&0);\n+        let third = *chunk.get(2).unwrap_or(&0);\n+        output.push(TABLE[(first >> 2) as usize] as char);\n+        output.push(TABLE[(((first & 0b0000_0011) << 4) | (second >> 4)) as usize] as char);\n+        if chunk.len() > 1 {\n+            output.push(TABLE[(((second & 0b0000_1111) << 2) | (third >> 6)) as usize] as char);\n+        } else {\n+            output.push('=');\n+        }\n+        if chunk.len() > 2 {\n+            output.push(TABLE[(third & 0b0011_1111) as usize] as char);\n+        } else {\n+            output.push('=');\n+        }\n+    }\n+\n+    output\n+}\n+\n fn visual_rows(line: &str, width: u16) -> u16 {\n     visual_row_count(line, width).min(usize::from(u16::MAX)) as u16\n }\ndiff --git a/src/ui_harness.rs b/src/ui_harness.rs\nindex b9bdcb9..51a7ba2 100644\n--- a/src/ui_harness.rs\n+++ b/src/ui_harness.rs\n@@ -216,15 +216,15 @@ impl UiHarness {\n                 self.prompt_cursor = 0;\n                 self.prompt_history_index = None;\n                 self.prompt_history_draft = None;\n-                let actions = self.ui.handle_key(UiKey::Esc);\n+                let actions = self.handle_ui_key(UiKey::Esc);\n                 self.record_actions(actions);\n             }\n             HarnessInput::Ke