k\\n\");\ntests/terminal_app.rs:187:    assert!(app.handle_byte(3));\ntests/terminal_app.rs:195:    app.handle_bytes(&[27, 23, b'h']);\ntests/terminal_app.rs:197:    assert!(app.handle_byte(3));\ntests/terminal_app.rs:210:    assert!(app.handle_byte(3));\ntests/terminal_app.rs:212:    assert!(app.handle_byte(b'q'));\ntests/terminal_app.rs:215:    assert!(!app.handle_bytes(b\":q\\n\"));\ntests/terminal_app.rs:220:fn terminal_app_command_mode_typing_shows_insert_mode_notice() {\ntests/terminal_app.rs:225:    app.handle_bytes(b\"hello\");\ntests/terminal_app.rs:227:    assert_eq!(app.ui().mode(), UiMode::Command);\ntests/terminal_app.rs:230:            .contains(\"command mode: press i for insert mode before typing\")\ntests/terminal_app.rs:240:    assert!(app.handle_byte(3));\ntests/terminal_app.rs:294:    app.handle_bytes(b\":new implement parser\\nhello\");\ntests/terminal_app.rs:306:    app.handle_bytes(b\":abcdefghijklmnopqrstuvwxyz0123\\x1b[D\\x1b[D\\x1b[D\\x1b[D\\x1b[DX\");\ntests/terminal_app.rs:308:    assert_eq!(app.ui().mode(), UiMode::Prompt);\ntests/terminal_app.rs:320:    app.handle_bytes(b\":help\\n\");\ntests/terminal_app.rs:321:    app.handle_bytes(b\":draft command\\x1b[A\");\ntests/terminal_app.rs:323:    assert_eq!(app.ui().mode(), UiMode::Prompt);\ntests/terminal_app.rs:326:    app.handle_bytes(b\"\\x1b[B\");\ntests/terminal_app.rs:328:    assert_eq!(app.ui().mode(), UiMode::Prompt);\ntests/terminal_app.rs:338:    app.handle_bytes(b\":new cursor render\\n\");\ntests/terminal_app.rs:340:    app.handle_bytes(b\"abcdefghijklmnopqrstuvwxyz0123\\x1b[D\\x1b[D\\x1b[D\\x1b[D\\x1b[DX\");\ntests/terminal_app.rs:353:    app.handle_bytes(b\":new chat history\\n\");\ntests/terminal_app.rs:355:    app.handle_bytes(b\"first\\n\");\ntests/terminal_app.rs:357:    app.handle_bytes(b\"draft message\\x1b[A\");\ntests/terminal_app.rs:360:    app.handle_bytes(b\"\\x1b[B\\n\");\ntests/terminal_app.rs:375:fn terminal_app_bytewise_arrow_prefix_keeps_focused_chat_in_insert_