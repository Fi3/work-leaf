+fn styled_spans_for_line(line: &str, selection: Option<Range<usize>>) -> Spans<'static> {
+    let Some(selection) = selection else {
+        return Spans::from(vec![Span::raw(line.to_string())]);
+    };
+
+    let start = byte_index_at_char(line, selection.start);
+    let end = byte_index_at_char(line, selection.end);
+    let mut spans = Vec::new();
+    if start > 0 {
+        spans.push(Span::raw(line[..start].to_string()));
+    }
+    if start < end {
+        spans.push(Span::styled(
+            line[start..end].to_string(),
+            Style::default().add_modifier(Modifier::REVERSED),
+        ));
+    }
+    if end < line.len() {
+        spans.push(Span::raw(line[end..].to_string()));
+    }
+    Spans::from(spans)
+}
+
+fn selection_range_for(
+    selection: VisualSelection,
+    kind: VisualKind,
+    row: usize,
+    line: &str,
+) -> Option<Range<usize>> {
+    let (start_row, end_row) = selected_row_bounds(selection);
+    if row < start_row || row > end_row {
+        return None;
+    }
+
+    let line_width = line_char_count(line);
+    match kind {
+        VisualKind::Line => Some(0..line_width),
+        VisualKind::Block => {
+            let start = selection.anchor.column.min(selection.cursor.column);
+            let end = selection.anchor.column.max(selection.cursor.column);
+            let start = start.min(line_width);
+            let end = end.saturating_add(1).min(line_width);
+            Some(start..end)
+        }
+        VisualKind::Character => {
+            let (start, end) = normalized_visual_positions(selection);
+            if start.row == end.row {
+                return Some(
+                    start.column.min(line_width)..end.column.saturating_add(1).min(line_width),
+                );
+            }
+            if row == start.row {
+                Some(start.column.min(line_width)..line_width)
+            } else if row == end.row {
+                Some(0..end.column.saturating_add(1).min(line_width))
+            } else {
+                Some(0..line_width)
+            }
+        }
+    }
+}
+
+fn selected_row_bounds(selection: VisualSelection) -> (usize, usize) {
+    (
+        selection.anchor.row.min(selection.cursor.row),
+        selection.anchor.row.max(selection.cursor.row),
+    )
+}
+
+fn normalized_visual_positions(selection: VisualSelection) -> (VisualPosition, VisualPosition) {
+    let anchor_before_cursor = selection.anchor.row < selection.cursor.row
+        || (selection.anchor.row == selection.cursor.row
+            && selection.anchor.column <= selection.cursor.column);
+    if anchor_before_cursor {
+        (selection.anchor, selection.cursor)
+    } else {
+        (selection.cursor, selection.anchor)
+    }
+}
+
+fn slice_chars(line: &str, range: Range<usize>) -> String {
+    let start = byte_index_at_char(line, range.start);
+    let end = byte_index_at_char(line, range.end);
+    line[start..end].to_string()
+}
+
+fn clamp_visual_column(column: usize, line: &str) -> usize {
+    line_char_count(line).saturating_sub(1).min(column)
+}
+
+fn line_char_count(line: &str) -> usize {
+    line.chars().count()
+}
+
+fn byte_index_at_char(text: &str, char_index: usize) -> usize {
+    if char_index == 0 {
+        return 0;
+    }
+    text.char_indices()
+        .nth(char_index)
+        .map(|(index, _)| index)
+        .unwrap_or(text.len())
+}
+
+fn text_lines(text: &str) -> Vec<String> {
+    if text.is_empty() {
+        vec![String::new()]
+    } else {
+        text.lines().map(str::to_string).collect()
+    }
+}
+
+fn osc52_clipboard_sequence(text: &str) -> String {
+    format!("\u{1b}]52;c;{}\u{7}", base64_encode(text.as_bytes()))
+}
+
+fn base64_encode(input: &[u8]) -> String {
+    const TABLE: &[u8; 64] = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    let mut output = String::with_capacity(input.len().div_ceil(3) * 4);
+
+    for chunk in input.chunks(3) {
+        let first = chunk[0];
+        let second = *chunk.get(1).unwrap_or(&0);
+        let third = *chunk.get(2).unwrap_or(&0);
+        output.push(TABLE[(first >> 2) as usize] as char);
+        output.push(TABLE[(((first & 0b0000_0011) << 4) | (second >> 4)) as usize] as char);
+        if chunk.len() > 1 {
+            output.push(TABLE[(((second & 0b0000_1111) << 2) | (third >> 6)) as usize] as char);
+        } else {
+            output.push('=');
+        }
+        if chunk.len() > 2 {
+            output.push(TABLE[(third & 0b0011_1111) as usize] as char);
+        } else {
+            output.push('=');
+        }
+    }
+
+    output
+}
