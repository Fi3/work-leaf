+    fn handle_visual_key(
+        &mut self,
+        key: UiKey,
+        right_content: &str,
+        right_cursor_column: Option<usize>,
+    ) -> Vec<UiAction> {
+        match key {
+            UiKey::Esc => {
+                self.clear_visual_selection();
+                self.mode = UiMode::Command;
+            }
+            UiKey::Char('h') | UiKey::Left => self.move_visual_cursor(0, -1, right_content),
+            UiKey::Char('j') | UiKey::Down => self.move_visual_cursor(1, 0, right_content),
+            UiKey::Char('k') | UiKey::Up => self.move_visual_cursor(-1, 0, right_content),
+            UiKey::Char('l') | UiKey::Right => self.move_visual_cursor(0, 1, right_content),
+            UiKey::Char('y') => self.yank_visual_selection(false, right_content),
+            UiKey::Char('Y') => self.yank_visual_selection(true, right_content),
+            UiKey::Char('v') => {
+                self.switch_visual_selection_kind(
+                    VisualKind::Character,
+                    right_content,
+                    right_cursor_column,
+                );
+            }
+            UiKey::Char('V') => {
+                self.switch_visual_selection_kind(
+                    VisualKind::Line,
+                    right_content,
+                    right_cursor_column,
+                );
+            }
+            UiKey::Char(CTRL_V_CHAR) => {
+                self.switch_visual_selection_kind(
+                    VisualKind::Block,
+                    right_content,
+                    right_cursor_column,
+                );
+            }
+            _ => {}
+        }
+        Vec::new()
+    }
+
+    fn start_visual_selection(
+        &mut self,
+        kind: VisualKind,
+        right_content: &str,
+        right_cursor_column: Option<usize>,
+    ) {
+        self.pending = None;
+        self.mode = UiMode::Command;
+        let pane = if self.focus == PaneFocus::Left && !self.left_visible {
+            PaneFocus::Right
+        } else {
+            self.focus
+        };
+        let position = self.initial_visual_position(pane, right_content, right_cursor_column);
+        self.visual_selection = Some(VisualSelection {
+            pane,
+            kind,
+            anchor: position,
+            cursor: position,
+        });
+    }
+
+    fn switch_visual_selection_kind(
+        &mut self,
+        kind: VisualKind,
+        right_content: &str,
+        right_cursor_column: Option<usize>,
+    ) {
+        let Some(selection) = self.visual_selection else {
+            self.start_visual_selection(kind, right_content, right_cursor_column);
+            return;
+        };
+
+        if selection.kind == kind {
+            self.clear_visual_selection();
+        } else {
+            self.visual_selection = Some(VisualSelection { kind, ..selection });
+        }
+    }
+
+    fn initial_visual_position(
+        &self,
+        pane: PaneFocus,
+        right_content: &str,
+        right_cursor_column: Option<usize>,
+    ) -> VisualPosition {
+        match pane {
+            PaneFocus::Left => {
+                let lines = self.pane_text_lines(PaneFocus::Left, right_content);
+                let row = self.control_selected.min(lines.len().saturating_sub(1));
+                let column = clamp_visual_column(0, &lines[row]);
+                VisualPosition { row, column }
+            }
+            PaneFocus::Right => {
+                let lines = self.pane_text_lines(PaneFocus::Right, right_content);
+                let row = lines.len().saturating_sub(1);
+                let line_width = line_char_count(&lines[row]);
+                let requested_column = right_cursor_column.unwrap_or(line_width);
+                let column = clamp_visual_column(requested_column, &lines[row]);
+                VisualPosition { row, column }
+            }
+        }
+    }
+
+    fn move_visual_cursor(&mut self, row_delta: isize, column_delta: isize, right_content: &str) {
+        let Some(mut selection) = self.visual_selection else {
+            return;
+        };
+        let lines = self.pane_text_lines(selection.pane, right_content);
+        let max_row = lines.len().saturating_sub(1) as isize;
+        let row = (selection.cursor.row as isize + row_delta).clamp(0, max_row) as usize;
+        let column = if column_delta == 0 {
+            selection.cursor.column
+        } else if column_delta.is_negative() {
+            selection
+                .cursor
+                .column
+                .saturating_sub(column_delta.unsigned_abs())
+        } else {
+            selection
+                .cursor
+                .column
+                .saturating_add(column_delta as usize)
+        };
+        selection.cursor = VisualPosition {
+            row,
+            column: clamp_visual_column(column, &lines[row]),
+        };
+        self.visual_selection = Some(selection);
+    }
+
+    fn yank_visual_selection(&mut self, whole_lines: bool, right_content: &str) {
