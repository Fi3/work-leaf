+#[test]
+fn scripted_harness_visual_mode_yanks_from_focused_right_pane() {
+    let mut harness = UiHarness::new(80, 24);
+
+    harness.handle_bytes(&[23, b'l']);
+    harness.handle_bytes(b"ihello world");
+    harness.handle_bytes(b"\x1b");
+    harness.handle_bytes(b"vhhhhy");
+
+    assert_eq!(harness.last_yanked_text(), Some("world"));
+    assert_eq!(harness.ui().mode(), UiMode::Command);
+    assert!(harness.render_frame().contains("copied 5 chars"));
+}
