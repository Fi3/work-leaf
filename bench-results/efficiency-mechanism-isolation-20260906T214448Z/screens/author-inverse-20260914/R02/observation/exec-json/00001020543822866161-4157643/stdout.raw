pp.rs:515:            TerminalAppInput::Backspace if self.ui.mode() == UiMode::Prompt => {\nsrc/terminal_app.rs:521:            TerminalAppInput::Backspace if self.ui.mode() == UiMode::Insert => {\nsrc/terminal_app.rs:527:            TerminalAppInput::Enter if self.ui.mode() == UiMode::Prompt => {\nsrc/terminal_app.rs:542:            TerminalAppInput::Enter if self.ui.mode() == UiMode::Insert => {\nsrc/terminal_app.rs:549:            TerminalAppInput::LineBreak if self.ui.mode() == UiMode::Insert => {\nsrc/terminal_app.rs:556:                self.paste_mode = true;\nsrc/terminal_app.rs:560:                self.paste_mode = false;\nsrc/terminal_app.rs:563:            TerminalAppInput::Char(ch) if self.ui.mode() == UiMode::Prompt => {\nsrc/terminal_app.rs:569:            TerminalAppInput::Char(ch) if self.ui.mode() == UiMode::Insert => {\nsrc/terminal_app.rs:575:            TerminalAppInput::Key(UiKey::Left) if self.ui.mode() == UiMode::Prompt => {\nsrc/terminal_app.rs:579:            TerminalAppInput::Key(UiKey::Right) if self.ui.mode() == UiMode::Prompt => {\nsrc/terminal_app.rs:583:            TerminalAppInput::Key(UiKey::Up) if self.ui.mode() == UiMode::Prompt => {\nsrc/terminal_app.rs:587:            TerminalAppInput::Key(UiKey::Down) if self.ui.mode() == UiMode::Prompt => {\nsrc/terminal_app.rs:795:        self.ui.mode() == UiMode::Command && self.ui.selected_agent().is_some()\nsrc/terminal_app.rs:810:        self.ui.mode() == UiMode::Insert\nsrc/terminal_app.rs:811:            || (self.ui.mode() == UiMode::Command && self.ui.focus() == PaneFocus::Right)\nsrc/terminal_app.rs:815:        self.ui.mode() == UiMode::Prompt\nsrc/terminal_app.rs:816:            || (self.ui.mode() == UiMode::Insert && self.ui.focus() == PaneFocus::Right)\nsrc/terminal_app.rs:840:        if self.paste_mode {\nsrc/terminal_app.rs:964:                && sequence.mode_before == UiMode::Insert\nsrc/terminal_app.rs:965:                && self.ui.mode() != UiMode::Insert\nsrc/terminal_app.rs:991:    mode_before: UiMode,\nsrc/terminal_app.rs:1246:        app.handle_bytes(b\":\");\nsrc/terminal_app.rs:1250:        assert!(app.handle_bytes(paste.as_bytes()));\nsrc/terminal_app.rs:1322:    fn command_surface_insert_mode_renders_chat_buffer() {\nsrc/terminal_app.rs:1326:        app.handle_bytes(b\"itype in command agent\");\nsrc/terminal_app.rs:1342:        app.handle_bytes(b\"ispawn a new patch agent that uses codex\\n\");\nsrc/ui.rs:26:pub enum PaneFocus {\nsrc/ui.rs:53:    OpenChatSamePane(AgentId),\nsrc/ui.rs:137:const COMMAND_MODE_TYPING_NOTICE: &str = \"command mode: press i for insert mode before typing\";\nsrc/ui.rs:141:enum LeftPaneClickTarget {\nsrc/ui.rs:178:    mode: UiMode,\nsrc/ui.rs:179:    focus: PaneFocus,\nsrc/ui.rs:191:    command_mode_typing_count: usize,\nsrc/ui.rs:192:    command_mode_typing_controls_only: bool,\nsrc/ui.rs:200:            mode: UiMode::Command,\nsrc/ui.rs:201:            focus: PaneFocus::Left,\nsrc/ui.rs:213:            command_mode_typing_count: 0,\nsrc/ui.rs:214:            command_mode_typing_controls_only: true,\nsrc/ui.rs:229:    pub fn mode(&self) -> UiMode {\nsrc/ui.rs:230:        self.mode\nsrc/ui.rs:233:    pub fn focus(&self) -> PaneFocus {\nsrc/ui.rs:320:        self.focus = PaneFocus::Right;\nsrc/ui.rs:321:        self.mode = UiMode::Insert;\nsrc/ui.rs:333:        let command_mode_text_key = self.command_mode_text_key_control_status(key);\nsrc/ui.rs:335:        self.update_command_mode_typing_notice(command_mode_text_key);\nsrc/ui.rs:364:                self.mode = UiMode::Command;\nsrc/ui.rs:367:            UiKey::CtrlW if self.mode == UiMode::Command => {\nsrc/ui.rs:371:            UiKey::Char('g') if self.mode == UiMode::Command => {\nsrc/ui.rs:375:            UiKey::Char('i') if self.mode == UiMode::Command => {\nsrc/ui.rs:376:                self.mode = UiMode::Insert;\nsrc/ui.rs:379:            UiKey::Char(':') if self.mode == UiMode::Command => {\nsrc/ui.rs:380:                self.mode = UiMode::Pro