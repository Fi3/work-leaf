cus::Left,\n+                    row_index,\n+                    &row.text,\n+                )));\n+                if row.reversed {\n+                    item.style(Style::default().add_modifier(Modifier::REVERSED))\n+                } else {\n+                    item\n+                }\n+            })\n+            .collect::<Vec<_>>();\n         List::new(items).block(Block::default().title(\"work-leaf\").borders(Borders::ALL))\n     }\n \n     fn right_widget(&self, right_content: &str) -> Paragraph<'static> {\n         let title = match self.windows[self.active_window].surface {\n             UiSurface::WorkLeafCommand => \"command\",\n             UiSurface::AgentChat => \"chat\",\n         };\n-        Paragraph::new(right_content.to_string())\n+        let lines = content_lines(right_content)\n+            .into_iter()\n+            .enumerate()\n+            .map(|(row_index, line)| {\n+                Spans::from(self.line_spans_for_selection(PaneFocus::Right, row_index, &line))\n+            })\n+            .collect::<Vec<_>>();\n+        Paragraph::new(lines)\n             .block(Block::default().title(title).borders(Borders::ALL))\n             .wrap(Wrap { trim: false })\n     }\n@@\n     ) -> (u16, u16) {\n-        let (row, column) = if self.mode == UiMode::Prompt {\n+        let (row, column) = if self.mode == UiMode::Prompt {\n             (\n                 self.height,\n                 self.prompt_view(prompt, prompt_cursor).cursor_column,\n             )\n+        } else if let Some(selection) = &self.visual_selection {\n+            self.visual_cursor_position(selection, right_content)\n         } else {\n             match self.focus {\n                 PaneFocus::Left => (self.control_cursor_row(), 2),\n@@\n-    fn bell_prefix(&self) -> &'static str {\n+    fn output_prefix(&self) -> String {\n+        let mut output = String::new();\n+        output.push_str(self.bell_prefix());\n+        if self.pending_clipboard.replace(false)\n+            && let Some(text) = &self.last_yanked_text\n+        {\n+            output.push_str(&osc52_copy_sequence(text));\n+        }\n+        output\n+    }\n+\n+    fn bell_prefix(&self) -> &'static str {\n         if self.pending_bell.replace(false) {\n             \"\\u{7}\"\n         } else {\n*** Update File: src/ui.rs\n@@\n     pub fn render_screen_with_prompt(&self, right_content: &str, prompt: &str) -> String {\n         let visible_right_content = self.visible_right_content(right_content);\n         let prompt_cursor = prompt.len();\n         let buffer = self.render_tui_buffer(&visible_right_content, prompt, prompt_cursor);\n         let mut rendered = String::new();\n-        rendered.push_str(self.bell_prefix());\n+        rendered.push_str(&self.output_prefix());\n         rendered.push_str(\"\\u{1b}[H\");\n         rendered.push_str(&buffer_to_string(&buffer));\n         rendered.push_str(&self.cursor_sequence(&visible_right_content, prompt));\n@@\n         let visible_right_content = self.visible_right_content(right_content);\n         let buffer = self.render_tui_buffer(&visible_right_content, prompt, prompt_cursor);\n         let mut rendered = String::new();\n-        rendered.push_str(self.bell_prefix());\n+        rendered.push_str(&self.output_prefix());\n         rendered.push_str(\"\\u{1b}[H\");\n         rendered.push_str(&buffer_to_string(&buffer));\n         rendered.push_str(&self.cursor_sequence_with_cursors(\n*** Update File: src/ui.rs\n@@\n     fn handle_pending_key(&mut self, pending: PendingKey, key: UiKey) -> Vec<UiAction> {\n         match (pending, key) {\n             (PendingKey::CtrlW, UiKey::Char('h')) if self.mode == UiMode::Command => {\n                 if self.left_visible {\n@@\n             _ => Vec::new(),\n         }\n     }\n+\n+    fn handle_visual_key(\n+        &mut self,\n+        key: UiKey,\n+        right_content: &str,\n+        right_cursor_column: Option<usize>,\n+    ) -> Vec<UiAction> {\n+        match key {\n+            UiKey::Esc => {\n+                self.mode = UiMode::Command;\n+                self.clear_visual_selection();\n+            }\n+            UiKey::Char('v') => self.set_visual_selection_kind(VisualSelectionKind::Character),\n+            UiKey::Char('V') => self.set_visual_selection_kind(VisualSelectionKind::Line),\n+            UiKey::CtrlV => self.set_visual_selection_kind(VisualSelectionKind::Block),\n+            UiKey::Char('h') | UiKey::Left => self.move_visual_cursor(0, -1, right_content),\n+            UiKey::Char('j') | UiKey::Down => self.move_visual_cursor(1, 0, right_content),\n+            UiKey::Char('k') | UiKey::Up => self.move_visual_cursor(-1, 0, right_content),\n+            UiKey::Char('l') | UiKey::Right => self.move_visual_cursor(0, 1, right_content),\n+            UiKey::Char('y') => self.yank_visual_selection(right_content, None),\n+            UiKey::Char('Y') => {\n+                self.yank_visual_selection(right_content, Some(VisualSelectionKind::Line))\n+            }\n+            UiKey::Char('v') if self.visual_selection.is_none() => self.start_visual_selection(\n+                VisualSelectionKind::Character,\n+                right_content,\n+                right_cursor_column,\n+            ),\n+            _ => {}\n+        }\n+        Vec::new()\n+    }\n+\n+    fn start_visual_selection(\n+        &mut self,\n+        kind: VisualSelectionKind,\n+        right_content: &str,\n+        right_cursor_column: Option<usize>,\n+    ) {\n+        let anchor = self.current_text_position(self.focus, right_content, right_cursor_column);\n+        self.visual_selection = Some(VisualSelection {\n+            pane: self.focus,\n+            kind,\n+            anchor,\n+            cursor: anchor,\n+        });\n+        self.mode = kind.ui_mode();\n+    }\n+\n+    fn set_visual_selection_kind(&mut self, kind: VisualSelectionKind) {\n+        if let Some(selection) = &mut self.visual_selection {\n+            selection.kind = kind;\n+            self.mode = kind.ui_mode();\n+        }\n+    }\n+\n+    fn move_visual_cursor(&mut self, row_delta: isize, column_delta: isize, right_content: &str) {\n+        let Some(pane) = self.visual_selection.as_ref().map(|selection| selection.pane) else {\n+            return;\n+        };\n+        let lines = self.pane_content_lines(pane, right_content);\n+        let Some(selection) = &mut self.visual_selection else {\n+            return;\n+        };\n+        if lines.is_empty() {\n+            return;\n+        }\n+\n+        let max_row = lines.len().saturating_sub(1);\n+        let row = selection\n+            .cursor\n+            .row\n+            .saturating_add_signed(row_delta)\n+            .min(max_row);\n+        let line_len = char_len(&lines[row]);\n+        let max_column = line_len.saturating_sub(1);\n+        let column = selection\n+            .cursor\n+            .column\n+            .saturating_add_signed(column_delta)\n+            .min(max_column);\n+        selection.cursor = TextPosition { row, column };\n+    }\n+\n+    fn yank_visual_selection(\n+        &mut self,\n+        right_content: &str,\n+        kind_override: Option<VisualSelectionKind>,\n+    ) {\n+        if let Some(text) = self.selected_text(right_content, kind_override) {\n+            self.finish_yank(text);\n+        }\n+        self.clear_visual_selection();\n+        self.mode = UiMode::Command;\n+    }\n+\n+    fn yank_current_line(&mut self, right_content: &str, right_cursor_column: Option<usize>) {\n+        let position = self.current_text_position(self.focus, right_content, right_cursor_column);\n+        let lines = self.pane_content_lines(self.focus, right_content);\n+        if let Some(line) = lines.get(position.row) {\n+            self.finish_yank(line.clone());\n+        }\n+    }\n+\n+    fn finish_yank(&mut self, text: String) {\n+        let count = text.chars().count();\n+        self.last_yanked_text = Some(text);\n+        self.pending_clipboard.set(true);\n+        self.show_status_notice(\n+            format!(\"copied {count} {}\", if count == 1 { \"char\" } else { \"chars\" }),\n+            Duration::from_secs(STATUS_NOTICE_SECONDS),\n+        );\n+    }\n+\n+    fn clear_visual_selection(&mut self) {\n+        self.visual_selection = None;\n+    }\n+\n+    fn current_text_position(\n+        &self,\n+        pane: PaneFocus,\n+        right_content: &str,\n+        right_cursor_column: Option<usize>,\n+    ) -> TextPosition {\n+        let lines = self.pane_content_lines(pane, right_content);\n+        if lines.is_empty() {\n+            return TextPosition { row: 0, column: 0 };\n+        }\n+        let row = match pane {\n+            PaneFocus::Left => self.current_left_content_row().min(lines.len().saturating_sub(1)),\n+            PaneFocus::Right => lines.len().saturating_sub(1),\n+        };\n+        let column = match pane {\n+            PaneFocus::Left => 0,\n+            PaneFocus::Right => right_cursor_column.unwrap_or(0),\n+        };\n+        clamp_text_position(TextPosition { row, column }, &lines)\n+    }\n+\n+    fn current_left_content_row(&self) -> usize {\n+        if self.control_selected == 0 {\n+            return 0;\n+        }\n+\n+        let mut row = 1;\n+        for (visible_position, agent_index) in self.visible_agent_indices().iter().enumerate() {\n+            if self.control_selected == visible_position + 1 {\n+                return row;\n+            }\n+            row += 1;\n+\n+            let agent = &self.agents[*agent_index];\n+            if !agent.modified_files.is_empty() {\n+                row += 1;\n+            }\n+            for linked_agents in [\n+                &agent.conflicting_agents,\n+                &agent.depends_on,\n+                &agent.depended_on_by,\n+            ] {\n+                if !linked_agents.is_empty() {\n+                    row += 1;\n+                }\n+            }\n+        }\n+\n+        0\n+    }\n+\n+    fn pane_content_lines(&self, pane: PaneFocus, right_content: &str) -> Vec<String> {\n+        match pane {\n+            PaneFocus::Left => self.left_pane_rows().into_iter().map(|row| row.text).collect(),\n+            PaneFocus::Right => content_lines(&self.visible_right_content(right_content)),\n+        }\n+    }\n+\n+    fn selected_text(\n+        &self,\n+        right_content: &str,\n+        kind_override: Option<VisualSelectionKind>,\n+    ) -> Option<String> {\n+        let selection = self.visual_selection.as_ref()?;\n+        let lines = self.pane_content_lines(selection.pane, right_content);\n+        if lines.is_empty() {\n+            return Some(String::new());\n+        }\n+        let kind = kind_override.unwrap_or(selection.kind);\n+        let anchor = clamp_text_position(selection.anchor, &lines);\n+        let cursor = clamp_text_position(selection.cursor, &lines);\n+        let (start, end) = ordered_positions(anchor, cursor);\n+\n+        let selected = match kind {\n+            VisualSelectionKind::Character => (start.row..=end.row)\n+                .map(|row| {\n+                    let line = &lines[row];\n+                    let line_len = char_len(line);\n+                    let start_column = if row == start.row { start.column } else { 0 };\n+                    let end_column = if row == end.row {\n+                        end.column.saturating_add(1)\n+                    } else {\n+                        line_len\n+                    };\n+                    slice_chars(line, start_column, end_column.min(line_len))\n+                })\n+                .collect::<Vec<_>>()\n+                .join(\"\\n\"),\n+            VisualSelectionKind::Line => lines[start.row..=end.row].join(\"\\n\"),\n+            VisualSelectionKind::Block => {\n+                let start_column = start.column.min(end.column);\n+                let end_column = start.column.max(end.column).saturating_add(1);\n+                (start.row..=end.row)\n+                    .map(|row| slice_chars(&lines[row], start_column, end_column))\n+                    .collect::<Vec<_>>()\n+                    .join(\"\\n\")\n+            }\n+        };\n+        Some(selected)\n+    }\n+\n+    fn selection_range_for_line(\n+        &self,\n+        pane: PaneFocus,\n+        row: usize,\n+        line: &str,\n+    ) -> Option<(usize, usize)> {\n+        if !self.mode.is_visual() {\n+            return None;\n+        }\n+        let selection = self.visual_selection.as_ref()?;\n+        if selection.pane != pane {\n+            return None;\n+        }\n+\n+        let line_len = char_len(line);\n+        let (start, end) = ordered_positions(selection.anchor, selection.cursor);\n+        if row < start.row || row > end.row {\n+            return None;\n+        }\n+\n+        match selection.kind {\n+            VisualSelectionKind::Character => {\n+                let start_column = if row == start.row { start.column } else { 0 };\n+                let end_column = if row == end.row {\n+                    end.column.saturating_add(1)\n+                } else {\n+                    line_len\n+                };\n+                Some((start_column.min(line_len), end_column.min(line_len)))\n+            }\n+            VisualSelectionKind::Line => Some((0, line_len)),\n+            VisualSelectionKind::Block => {\n+                let start_column = start.column.min(end.column);\n+                let end_column = start.column.max(end.column).saturating_add(1);\n+                Some((start_column.min(line_len), end_column.min(line_len)))\n+            }\n+        }\n+    }\n+\n+    fn line_spans_for_selection(\n+        &self,\n+        pane: PaneFocus,\n+        row_index: usize,\n+        line: &str,\n+    ) -> Vec<Span<'static>> {\n+        let Some((start, end)) = self.selection_range_for_line(pane, row_index, line) else {\n+            return vec![Span::raw(line.to_string())];\n+        };\n+        if 