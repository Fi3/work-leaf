{"type":"item.completed","item":{"id":"item_41","type":"agent_message","text":"@standalone edit add focused ui harness tests for vim-style visual selection before implementation\n*** Begin Patch\n*** Update File: tests/ui_harness.rs\n@@\n fn scripted_harness_left_right_arrows_move_left_pane_selection_like_j_k() {\n     let mut harness = UiHarness::new(80, 24);\n \n     assert_eq!(harness.ui().focus(), PaneFocus::Left);\n     assert_eq!(\n@@\n     assert_eq!(\n         harness.ui().selected_agent().map(|id| id.as_str()),\n         Some(\"user-1\")\n     );\n }\n+\n+#[test]\n+fn scripted_harness_visual_character_selection_copies_right_pane_text() {\n+    let mut harness = UiHarness::new(100, 24);\n+\n+    harness.handle_bytes(&[23, b'l']);\n+    harness.handle_byte(b'v');\n+\n+    assert!(\n+        harness\n+            .render_frame()\n+            .contains(\"mode=visual focus=right selection=character\")\n+    );\n+\n+    harness.handle_byte(b'l');\n+    assert!(harness.render_frame().contains(\"\\u{1b}[7mUI\\u{1b}[0m\"));\n+\n+    harness.handle_byte(b'y');\n+\n+    let copied_frame = harness.render_frame();\n+    assert!(copied_frame.starts_with(&osc52(\"UI\")), \"{copied_frame:?}\");\n+    assert_eq!(harness.ui().mode(), UiMode::Command);\n+    assert!(!harness.render_frame().contains(\"\\u{1b}]52;\"));\n+}\n+\n+#[test]\n+fn scripted_harness_visual_line_selection_copies_left_pane_line() {\n+    let mut harness = UiHarness::new(140, 24);\n+\n+    harness.handle_byte(b'k');\n+    harness.handle_bytes(b\"Vy\");\n+\n+    let copied_frame = harness.render_frame();\n+    assert!(\n+        copied_frame.starts_with(&osc52(\"> work-leaf  command\")),\n+        \"{copied_frame:?}\"\n+    );\n+}\n+\n+#[test]\n+fn scripted_harness_visual_block_selection_copies_right_pane_rectangle() {\n+    let mut harness = UiHarness::new(100, 24);\n+\n+    harness.handle_bytes(&[23, b'l']);\n+    harness.handle_byte(22);\n+    harness.handle_bytes(b\"ljy\");\n+\n+    let copied_frame = harness.render_frame();\n+    assert!(copied_frame.starts_with(&osc52(\"UI\\nEs\")), \"{copied_frame:?}\");\n+}\n+\n+#[test]\n+fn scripted_harness_yank_line_key_copies_right_pane_line() {\n+    let mut harness = UiHarness::new(100, 24);\n+\n+    harness.handle_bytes(&[23, b'l']);\n+    harness.handle_byte(b'Y');\n+\n+    let copied_frame = harness.render_frame();\n+    assert!(\n+        copied_frame.starts_with(&osc52(\"UI harness\")),\n+        \"{copied_frame:?}\"\n+    );\n+}\n \n fn strip_ansi(input: &str) -> String {\n     let mut output = String::new();\n     let mut chars = input.chars();\n     while let Some(ch) = chars.next() {\n@@\n     }\n     output\n }\n+\n+fn osc52(text: &str) -> String {\n+    format!(\"\\u{1b}]52;c;{}\\u{7}\", base64(text.as_bytes()))\n+}\n+\n+fn base64(bytes: &[u8]) -> String {\n+    const TABLE: &[u8; 64] = b\"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\";\n+    let mut encoded = String::new();\n+    for chunk in bytes.chunks(3) {\n+        let first = chunk[0];\n+        let second = chunk.get(1).copied().unwrap_or(0);\n+        let third = chunk.get(2).copied().unwrap_or(0);\n+        let triple = ((first as u32) << 16) | ((second as u32) << 8) | third as u32;\n+        encoded.push(TABLE[((triple >> 18) & 0x3f) as usize] as char);\n+        encoded.push(TABLE[((triple >> 12) & 0x3f) as usize] as char);\n+        encoded.push(if chunk.len() > 1 {\n+            TABLE[((triple >> 6) & 0x3f) as usize] as char\n+        } else {\n+            '='\n+        });\n+        encoded.push(if chunk.len() > 2 {\n+            TABLE[(triple & 0x3f) as usize] as char\n+        } else {\n+            '='\n+        });\n+    }\n+    encoded\n+}\n*** End Patch\n@standalone end"}}
