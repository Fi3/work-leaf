+
+fn selected_ranges(
+    selection: &VisualSelection,
+    lines: &[String],
+) -> Vec<(usize, usize, usize)> {
+    let Some(last_row) = lines.len().checked_sub(1) else {
+        return Vec::new();
+    };
+    let anchor = SelectionPoint {
+        row: selection.anchor.row.min(last_row),
+        column: selection.anchor.column,
+    };
+    let cursor = SelectionPoint {
+        row: selection.cursor.row.min(last_row),
+        column: selection.cursor.column,
+    };
+
+    match selection.kind {
+        VisualSelectionKind::Line => {
+            let (start_row, end_row) = ordered_rows(anchor.row, cursor.row);
+            (start_row..=end_row)
+                .map(|row| (row, 0, char_len(&lines[row])))
+                .collect()
+        }
+        VisualSelectionKind::Block => {
+            let (start_row, end_row) = ordered_rows(anchor.row, cursor.row);
+            let (start_column, end_column) = ordered_rows(anchor.column, cursor.column);
+            (start_row..=end_row)
+                .map(|row| {
+                    let len = char_len(&lines[row]);
+                    let start = start_column.min(len);
+                    let end = end_column.saturating_add(1).min(len);
+                    (row, start, end.max(start))
+                })
+                .collect()
+        }
+        VisualSelectionKind::Character => character_selection_ranges(anchor, cursor, lines),
+    }
+}
+
+fn character_selection_ranges(
+    anchor: SelectionPoint,
+    cursor: SelectionPoint,
+    lines: &[String],
+) -> Vec<(usize, usize, usize)> {
+    let (start, end) = if point_le(anchor, cursor) {
+        (anchor, cursor)
+    } else {
+        (cursor, anchor)
+    };
+    (start.row..=end.row)
+        .map(|row| {
+            let len = char_len(&lines[row]);
+            if len == 0 {
+                return (row, 0, 0);
+            }
+            if start.row == end.row {
+                let start_column = start.column.min(len - 1);
+                let end_column = end.column.min(len - 1).saturating_add(1);
+                return (row, start_column, end_column.max(start_column));
+            }
+            if row == start.row {
+                let start_column = start.column.min(len - 1);
+                return (row, start_column, len);
+            }
+            if row == end.row {
+                let end_column = end.column.min(len - 1).saturating_add(1);
+                return (row, 0, end_column);
+            }
+            (row, 0, len)
+        })
+        .collect()
+}
+
+fn point_le(left: SelectionPoint, right: SelectionPoint) -> bool {
+    left.row < right.row || (left.row == right.row && left.column <= right.column)
+}
+
+fn ordered_rows(left: usize, right: usize) -> (usize, usize) {
+    if left <= right {
+        (left, right)
+    } else {
+        (right, left)
+    }
+}
+
+fn char_len(line: &str) -> usize {
+    line.chars().count()
+}
+
+fn char_range(line: &str, start: usize, end: usize) -> String {
+    line.chars()
+        .skip(start)
+        .take(end.saturating_sub(start))
+        .collect()
+}
