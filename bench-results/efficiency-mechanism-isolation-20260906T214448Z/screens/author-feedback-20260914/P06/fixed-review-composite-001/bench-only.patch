@@ -0,0 +1,120 @@
+use super::*;
+
+#[test]
+fn fixed_review_process_activation_and_exact_refresh_preserve_other_bytes() {
+    let executable = std::env::current_exe().unwrap();
+    let root = std::env::temp_dir().join(format!("wl-joint-test-{}", std::process::id()));
+    std::fs::create_dir(&root).unwrap();
+    std::fs::create_dir(root.join("review")).unwrap();
+    let manifest = root.join("manifest.json");
+    let evidence = root.join("evidence.jsonl");
+    std::fs::write(
+        &manifest,
+        serde_json::to_vec(&json!({
+            "schema":SCHEMA_V5,"condition":"review-evidence-native","run_id":"joint-test",
+            "evidence_path":evidence,"review_evidence_root":root.join("review"),
+        }))
+        .unwrap(),
+    )
+    .unwrap();
+    let run = || {
+        std::process::Command::new(&executable)
+            .args([
+                "--exact",
+                "bench_experiment::automatic_refresh::fixed_review_tests::fixed_review_child",
+            ])
+            .env("WORK_LEAF_BENCH_EXPERIMENT", "1")
+            .env("WORK_LEAF_BENCH_EXPERIMENT_MANIFEST", &manifest)
+            .env("WORK_LEAF_BENCH_RUN_ID", "joint-test")
+            .env("WORK_LEAF_BENCH_FIXED_REVIEW_REFRESH", "1")
+            .env("WORK_LEAF_TEST_FIXED_REVIEW_CHILD", "1")
+            .output()
+            .unwrap()
+    };
+    let first = run();
+    assert!(
+        first.status.success(),
+        "{}",
+        String::from_utf8_lossy(&first.stdout)
+    );
+    let rows: Vec<Value> = std::fs::read_to_string(&evidence)
+        .unwrap()
+        .lines()
+        .map(|line| serde_json::from_str(line).unwrap())
+        .collect();
+    assert_eq!(rows.len(), 2);
+    assert_eq!(
+        rows[0]["joint_automatic_refresh"]["condition"],
+        "automatic-changed-refresh-full"
+    );
+    assert_eq!(rows[0]["condition"], "review-evidence-native");
+    assert_eq!(rows[1]["original_prompt"], "diagnostic compact tail");
+    assert_eq!(rows[1]["candidate_prompt"], "diagnostic current text tail");
+    let before = std::fs::read(&evidence).unwrap();
+    assert!(!run().status.success());
+    assert_eq!(std::fs::read(&evidence).unwrap(), before);
+    std::fs::remove_dir_all(root).unwrap();
+}
+
+#[test]
+fn fixed_review_child() {
+    if std::env::var("WORK_LEAF_TEST_FIXED_REVIEW_CHILD").as_deref() != Ok("1") {
+        return;
+    }
+    super::super::initialize().unwrap();
+    let mut capture = Capture::start().unwrap().unwrap();
+    capture.replace(
+        "current-full-text",
+        11..18,
+        "current text".into(),
+        Some(0..12),
+        Some(0),
+    );
+    let output = capture
+        .forward(
+            &AgentId::new("author").unwrap(),
+            "edit",
+            "diagnostic compact tail".into(),
+            json!({"diagnostic":"untouched"}),
+        )
+        .unwrap();
+    assert_eq!(output, "diagnostic current text tail");
+}
+
+#[test]
+fn fixed_review_opt_in_requires_exact_marker_and_constant_native_review() {
+    use std::ffi::OsStr;
+    assert!(!fixed_review_opt_in(None, SCHEMA_V5, "review-evidence-native").unwrap());
+    assert!(
+        fixed_review_opt_in(Some(OsStr::new("1")), SCHEMA_V5, "review-evidence-native").unwrap()
+    );
+    for (marker, schema, condition) in [
+        ("0", SCHEMA_V5, "review-evidence-native"),
+        ("", SCHEMA_V5, "review-evidence-native"),
+        ("1", SCHEMA_V5, "review-evidence-inline"),
+        ("1", SCHEMA_V7, "automatic-changed-refresh-full"),
+        ("1", SCHEMA_V2, "control"),
+    ] {
+        assert!(fixed_review_opt_in(Some(OsStr::new(marker)), schema, condition).is_err());
+    }
+}
+
+#[test]
+fn existing_schemas_require_no_new_opt_in_and_review_alone_stays_inactive() {
+    let make = |schema: &str, condition: &str| Manifest {
+        schema: schema.into(),
+        run_id: "joint-gate".into(),
+        condition: condition.into(),
+        evidence_path: PathBuf::from("/not-opened"),
+    };
+    let review = make(SCHEMA_V5, "review-evidence-native");
+    assert!(!selected(&review, false));
+    assert!(selected(&review, true));
+    assert!(!selected(&make(SCHEMA_V5, "review-evidence-inline"), true));
+    assert!(!selected(&make(SCHEMA_V2, "control"), true));
+    assert!(selected(
+        &make(SCHEMA_V7, "automatic-changed-refresh-full"),
+        false
+    ));
+    assert!(!selected(&make(SCHEMA_V7, "other"), false));
+}
