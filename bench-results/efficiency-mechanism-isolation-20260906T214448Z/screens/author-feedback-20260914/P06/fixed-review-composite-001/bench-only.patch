 use super::*;
 use serde_json::Value;
 
+pub(super) static FIXED_REVIEW_REFRESH: OnceLock<bool> = OnceLock::new();
+
+pub(super) fn fixed_review_opt_in(
+    marker: Option<&std::ffi::OsStr>,
+    schema: &str,
+    condition: &str,
+) -> io::Result<bool> {
+    let Some(marker) = marker else {
+        return Ok(false);
+    };
+    if marker != std::ffi::OsStr::new("1")
+        || schema != SCHEMA_V5
+        || condition != "review-evidence-native"
+    {
+        return Err(invalid(
+            "fixed-review refresh requires explicit 1 and native-review v5",
+        ));
+    }
+    Ok(true)
+}
+
+fn selected(manifest: &Manifest, fixed_review: bool) -> bool {
+    (manifest.schema == SCHEMA_V7 && manifest.condition == "automatic-changed-refresh-full")
+        || (fixed_review
+            && manifest.schema == SCHEMA_V5
+            && manifest.condition == "review-evidence-native")
+}
+
+fn selected_active(manifest: &Manifest) -> bool {
+    selected(manifest, *FIXED_REVIEW_REFRESH.get().unwrap_or(&false))
+}
