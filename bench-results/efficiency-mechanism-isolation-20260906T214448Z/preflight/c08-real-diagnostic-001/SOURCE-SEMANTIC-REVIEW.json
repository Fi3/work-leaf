        "text": "pub fn capped(value: u8, limit: u8) -> u8 {\n    value.min(limit)\n}\n\n#[cfg(test)]\nmod tests {\n    use super::capped;\n\n    #[test]\n    fn returns_value_when_below_limit() {\n        assert_eq!(capped(3, 5), 3);\n    }\n\n    #[test]\n    fn returns_value_when_equal_to_limit() {\n        assert_eq!(capped(5, 5), 5);\n    }\n\n    #[test]\n    fn returns_limit_when_value_exceeds_limit() {\n        assert_eq!(capped(7, 5), 5);\n    }\n}\n"
