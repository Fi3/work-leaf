TerminalUi {\n662:    pub fn new(width: u16, height: u16) -> Self {\n684:    pub fn layout(&self) -> TerminalLayout {\n695:    pub fn mode(&self) -> UiMode {\n699:    pub fn focus(&self) -> PaneFocus {\n703:    pub(crate) fn show_ctrl_c_exit_notice(&mut self) {\n710:    pub(crate) fn has_status_notice(&self) -> bool {\n714:    pub(crate) fn clear_expired_status_notice(&mut self) {\n720:    pub fn window_count(&self) -> usize {\n724:    pub fn active_window(&self) -> usize {\n728:    pub fn selected_agent(&self) -> Option<&AgentId> {\n732:    pub fn control_selected_row(&self) -> usize {\n736:    pub fn add_agent(&mut self, agent: AgentListEntry) {\n740:    pub(crate) fn set_agent_feature(\n743:        feature: impl Into<String>,\n752:    pub(crate) fn set_agent_ready_state(\n767:    pub fn select_agent(&mut self, agent_id: &AgentId) -> Result<(), String> {\n784:    pub fn activate_agent_chat(&mut self, agent_id: &AgentId) -> Result<(), String> {\n791:    pub fn select_command_interface(&mut self) {\n798:    pub fn handle_key(&mut self, key: UiKey) -> Vec<UiAction> {\n805:    fn handle_key_inner(&mut self, key: UiKey) -> Vec<UiAction> {\n903:    pub fn render_left_pane(&self) -> String {\n910:        for (visible_position, agent_index) in self.visible_agent_indices().iter().enumerate() {\n953:    pub fn render_screen(&self, right_content: &str) -> String {\n957:    pub fn render_screen_with_prompt(&self, right_content: &str, prompt: &str) -> String {\n969:    pub fn render_screen_with_cursors(\n991:    pub fn scroll_right_pane_up(&mut self) {\n995:    pub fn scroll_right_pane_down(&mut self) {\n999:    pub fn reset_right_scroll(&mut self) {\n1003:    fn visible_right_content(&self, right_content: &str) -> String {\n1013:    fn render_tui_buffer(&self, right_content: &str, prompt: &str, prompt_cursor: usize) -> Buffer {\n1050:    fn left_widget(&self) -> List<'static> {\n1057:        for (visible_position, agent_index) in self.visible_agent_indices().iter().enumerate(