s_insert_mode_notice() {\n3839:    let mut harness = UiHarness::new(80, 24);\n3840:\n3841:    harness.handle_bytes(b\"hello\");\n3842:\n3843:    assert_eq!(harness.ui().mode(), UiMode::Command);\n3844:    assert!(\n3845:        harness\n3846:            .render_frame()\n3847:            .contains(\"command mode: press i for insert mode before typing\")\n3848:    );\n3849:}\n3850:\n3851:#[test]\n3852:fn scripted_harness_ctrl_c_shows_quit_notice() {\n3853:    let mut harness = UiHarness::new(80, 24);\n3854:\n3855:    assert!(harness.handle_byte(3));\n3856:    assert!(!harness.is_quit());\n3857:    assert!(\n3858:        harness\n3859:            .render_frame()\n3860:            .contains(\"to exit, press Esc then :q then Enter\")\n3861:    );\n3862:}\n3863:\n3864:#[test]\n3865:fn scripted_harness_structural_command_keys_do_not_show_typing_notice() {\n3866:    let mut harness = UiHarness::new(80, 24);\n3867:\n3868:    harness.handle_bytes(&[23, b'l']);\n3869:\n3870:    assert_eq!(harness.ui().focus(), PaneFocus::Right);\n3871:    assert!(!harness.render_frame().contains(\"command mode: press i\"));\n3872:}\n3873:\n3874:#[test]\n3875:fn scripted_harness_left_pane_navigation_does_not_show_typing_notice() {\n3876:    let mut harness = UiHarness::new(80, 24);\n3877:\n3878:    harness.handle_bytes(b\"jjjjj\");\n3879:\n3880:    assert_eq!(harness.ui().focus(), PaneFocus::Left);\n3881:    assert_eq!(\n3882:        harness.ui().selected_agent().map(|id| id.as_str()),\n3883:        Some(\"user-2\")\n3884:    );\n3885:    assert!(!harness.render_frame().contains(\"command mode: press i\"));\n3886:}\n3887:\n3888:#[test]\n3889:fn scripted_harness_quits_only_through_colon_q() {\n3890:    let mut harness = UiHarness::new(80, 24);\n3891:\n3892:    assert!(harness.handle_byte(b'q'));\n3893:    assert!(!harness.is_quit());\n3894:\n3895:    assert!(!harness.handle_bytes(b\":q\\n\"));\n3896:    assert!(harness.is_quit());\n3897:}\n3898:\n3899:#[test]\n3900:fn scripted_harness_new_commands_select_new_agent_chat() {\n3901:    let mut harness = UiHarness::new(80, 24);\n3902:\n3903:    harness.handle_bytes(b\":new ui automation\\n\");\n3904:\n3905:    assert_eq!(\n3906:        harness.ui().selected_agent().map(|id| id.as_str()),\n3907:        Some(\"user-3\")\n3908:    );\n3909:    assert_eq!(harness.ui().focus(), PaneFocus::Right);\n3910:    assert_eq!(harness.ui().mode(), UiMode::Insert);\n3911:    assert!(\n3912:        harness\n3913:            .transcript()\n3914:            .iter()\n3915:            .any(|line| line.contains(\"agent user-3 launched for: ui automation\"))\n3916:    );\n3917:    assert!(harness.render_frame().contains(\"user-3\"));\n3918:\n3919:    harness.handle_bytes(b\"\\x1b:new\\n\");\n3920:\n3921:    assert_eq!(\n3922:        harness.ui().selected_agent().map(|id| id.as_str()),\n3923:        Some(\"user-4\")\n3924:    );\n3925:    assert_eq!(harness.ui().focus(), PaneFocus::Right);\n3926:    assert_eq!(harness.ui().mode(), UiMode::Insert);\n3927:}\n3928:\n3929:#[test]\n3930:fn scripted_harness_names_new_chat_from_first_inserted_prompt() {\n3931:    let mut harness = UiHarness::new(80, 24);\n3932:\n3933:    harness.handle_bytes(b\":new\\n\");\n3934:    assert!(\n3935:        harness\n3936:            .ui()\n3937:            .render_left_pane()\n3938:            .contains(\">harness-agent user-3  working: harness-agent\")\n3939:    );\n3940:\n3941:    harness.handle_bytes(b\"please fix the OAuth redirect handler\\n\");\n3942:\n3943:    let named_left_pane = harness.ui().render_left_pane();\n3944:    assert!(named_left_pane.contains(\n3945:        \">please-fix-the-oauth-redirect-handler user-3  working: please-fix-the-oauth-redirect-handler\"\n3946:    ));\n3947:    assert!(!named_left_pane.contains(\"harness-agent user-3\"));\n3948:\n3949:    harness.handle_bytes(b\"add cookie coverage\\n\");\n3950:\n3951:    let unchanged_left_pane = harness.ui().render_left_pane();\n3952:    assert!(unchanged_left_pane.contains(\n3953:      