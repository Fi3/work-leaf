:    );\n3732:}\n3733:#[test]\n3734:fn scripted_harness_prompt_arrow_keys_recall_prompt_history() {\n3735:    let mut harness = UiHarness::new(80, 24);\n3736:    harness.handle_bytes(b\":review\\n:linearize\\n:\\x1b[A\\x1b[A\\x1b[B\\n\");\n3737:    assert_eq!(harness.ui().mode(), UiMode::Command);\n3738:    assert_eq!(\n3739:        harness\n3740:            .transcript()\n3741:            .iter()\n3742:            .filter(|line| line.as_str() == \"work-leaf> linearize\")\n3743:            .count(),\n3744:        2\n3745:    );\n3746:}\n3747:\n3748:#[test]\n3749:fn scripted_harness_prompt_history_down_restores_in_progress_prompt() {\n3750:    let mut harness = UiHarness::new(80, 24);\n3751:\n3752:    harness.handle_bytes(b\":review\\n:draft command\\x1b[A\\x1b[B\\n\");\n3753:\n3754:    assert!(\n3755:        harness\n3756:            .transcript()\n3757:            .iter()\n3758:            .any(|line| line == \"unknown fixture command: draft command\")\n3759:    );\n3760:}\n3761:\n3762:#[test]\n3763:fn scripted_harness_bytewise_prompt_arrow_keys_edit_without_leaving_prompt() {\n3764:    let mut harness = UiHarness::new(80, 24);\n3765:    harness.handle_byte(b':');\n3766:    harness.handle_byte(b'a');\n3767:    harness.handle_byte(b'b');\n3768:    harness.handle_byte(27);\n3769:    assert_eq!(harness.ui().mode(), UiMode::Prompt);\n3770:    harness.handle_byte(b'[');\n3771:    assert_eq!(harness.ui().mode(), UiMode::Prompt);\n3772:    harness.handle_byte(b'D');\n3773:    harness.handle_byte(b'Z');\n3774:    harness.handle_byte(b'\\n');\n3775:    assert_eq!(harness.ui().mode(), UiMode::Command);\n3776:    assert!(\n3777:        harness\n3778:            .transcript()\n3779:            .iter()\n3780:            .any(|line| line == \"unknown fixture command: aZb\")\n3781:    );\n3782:}\n3783:#[test]\n3784:fn scripted_harness_drives_ctrl_w_navigation_and_left_toggle() {\n3785:    let mut harness = UiHarness::new(80, 24);\n3786:\n3787:    harness.handle_bytes(&[23, b'l'])