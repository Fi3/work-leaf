ew patch agent that uses codex\")\n3661:        );\n3662:    }\n3663:}\n3664:----- END FILE src/terminal_app.rs -----\n3665:\n3666:----- BEGIN FILE tests/reviews.rs -----\n3667:digest: fnv64:ea641f4f0e2f1719; bytes:6738\n3668:\n3669:use std::collections::VecDeque;\n3670:use std::fs;\n3671:use std::path::{Path, PathBuf};\n3672:use std::process::Command;\n3673:\n3674:use work_leaf::{\n3675:    AgentBackend, AgentError, AgentId, AgentKind, AgentLaunch, AgentSession, ChatMessage,\n3676:    GitHistory, MessageRole, ReviewCoordinator,\n3677:};\n3678:\n3679:#[test]\n3680:fn git_history_finds_latest_commit_for_each_agent_id() {\n3681:    let root = git_repo(\"review-history\");\n3682:    fs::write(root.join(\"one.txt\"), \"one\\n\").unwrap();\n3683:    git(&root, [\"add\", \".\"]);\n3684:    git(\n3685:        &root,\n3686:        [\n3687:            \"commit\",\n3688:            \"-m\",\n3689:            \"UPDATE apply parser patch from chat-a\",\n3690:            \"-m\",\n3691:            \"Agent-ID: chat-a\\nFeature: parser\\nReason: first\",\n3692:        ],\n3693:    );\n3694:    fs::write(root.join(\"two.txt\"), \"two\\n\").unwrap();\n3695:    git(&root, [\"add\", \".\"]);\n3696:    git(\n3697:        &root,\n3698:        [\n3699:            \"commit\",\n3700:            \"-m\",\n3701:            \"UPDATE apply docs patch from chat-b\",\n3702:            \"-m\",\n3703:            \"Agent-ID: chat-b\\nFeature: docs\\nReason: docs\",\n3704:        ],\n3705:    );\n3706:    fs::write(root.join(\"one.txt\"), \"one again\\n\").unwrap();\n3707:    git(&root, [\"add\", \".\"]);\n3708:    git(\n3709:        &root,\n3710:        [\n3711:            \"commit\",\n3712:            \"-m\",\n3713:            \"UPDATE apply parser patch from chat-a\",\n3714:            \"-m\",\n3715:            \"Agent-ID: chat-a\\nFeature: parser\\nReason: second\",\n3716:        ],\n3717:    );\n3718:\n3719:    let commits = GitHistory::new(root).latest_agent_commits().unwrap();\n3720:\n3721:    assert_eq!(commits.len(), 2);\n3722:    assert_eq!(commits[0].agent_id.as_str(), \"chat-a\");\n3723:    assert_eq!(commits[0].reason, \"second\");\n3724:    assert_eq!(commits[1].agent_id.as_str(), \"chat-b\");\n3725:    assert_eq!(commits[1].feature, \"docs\");\n3726:}\n3727:\n3728:#[test]\n2820:            }\n2821:            TerminalAppInput::Enter if self.ui.mode() == UiMode::Prompt => {\n2822:                let line = self.prompt_buffer.trimmed_string();\n2823:                self.prompt_buffer.clear();\n2824:                self.ui.handle_key(UiKey::Esc);\n2825:                if !line.is_empty() {\n2826:                    self.prompt_history.push(line.clone());\n2827:                    self.prompt_history_index = None;\n2828:                    self.prompt_history_draft = None;\n2829:                    self.handle_command_line(&line);\n2830:                } else {\n2831:                    self.prompt_history_index = None;\n2832:                    self.prompt_history_draft = None;\n2833:                }\n2834:                self.dirty = true;\n2835:            }\n2836:            TerminalAppInput::Enter if self.ui.mode() == UiMode::Insert => {\n2837:                self.send_chat_buffer();\n2838:            }\n2839:            TerminalAppInput::Char('/') if self.should_start_agent_slash_command() => {\n2840:                self.start_agent_slash_command();\n2841:                self.dirty = true;\n2842:            }\n2843:            TerminalAppInput::LineBreak if self.ui.mode() == UiMode::Insert => {\n2844:                self.chat_buffer.push('\\n');\n2845:                self.chat_history_index = None;\n2846:                self.chat_history_draft = None;\n2847:                self.dirty = true;\n2848:            }\n2849:            TerminalAppInput::PasteStart => {\n2850:                self.paste_mode = true;\n2851:                self.skip_next_paste_lf = false;\n2852:            }\n2853:            TerminalAppInput::PasteEnd => {\n2854:                self.paste_mode = false;\n2855:                self.skip_next_paste_lf = false;\n2856:            }\n2857:            TerminalAppInput::Char(ch) if self.ui.mode() == UiMode::Prompt => {\n2858:                self.prompt_buffer.push(ch);\n2859:                self.prompt_history_index = None;\n2860:                self.prompt_history_draft = None;\n2861:                self.dirty = true;\n2862:            }\n2863:            TerminalAppInput::Char(ch) if self.ui.mode() == UiMode::Insert => {\n2864:                self.chat_buffer.push(ch);\n2865:                self.chat_history_index = None;\n2866:                self.chat_history_draft = None;\n2867:                self.dirty = true;\n2868:            }\n2869:            TerminalAppInput::Key(UiKey::Left) if self.ui.mode() == UiMode::Prompt => {\n2870:                self.prompt_buffer.move_left();\n2871:                self.dirty = true;\n2872:            }\n2873:            TerminalAppInput::Key(UiKey::Right) if self.ui.mode() == UiMode::Prompt => {\n2874:                self.prompt_buffer.move_right();\n2875:                self.dirty = true;\n2876:            }\n2877:            TerminalAppInput::Key(UiKey::Up) if self.ui.mode() == UiMode::Prompt => {\n2878:                self.recall_prompt_history(-1);\n2879:                self.dirty = true;\n2880:            }\n2881:            TerminalAppInput::Key(UiKey::Down) if self.ui.mode() == UiMode::Prompt => {\n2882:                self.recall_prompt_history(1);\n2883:                self.dirty = true;\n2884:            }\n2885:            TerminalAppInput::Key(UiKey::Left) if self.should_route_chat_arrow() => {\n2886:                self.chat_buffer.move_left();\n2887:                self.dirty = true;\n2888:            }\n2889:            TerminalAppInput::Key(UiKey::Right) if self.should_route_chat_arrow() => {\n2890:                self.chat_buffer.move_right();\n2891:                self.dirty = true;\n2892:            }\n2893:            TerminalAppInput::Key(UiKey::Up) if self.should_route_chat_arrow() => {\n2894:                self.recall_chat_history(-1);\n2895:                self.dirty = true;\n2896:            }\n2897:            TerminalAppInput::Key(UiKey::Down) if self.should_route_chat_arrow() => {\n2898:                self.recall_chat_history(1);\n2899:                self.dirty = true;\n2900:            }\n2901:            TerminalAppInput::Key(UiKey::Esc) => {\n2902:                self.prompt_buffer.clear();\n2903:                let actions = self.ui.handle_key(UiKey::Esc);\n2904:                self.record_actions(actions);\n2905:                self.dirty = true;\n2906:            }\n2907:            TerminalAppInput::Key(key) => {\n2908:                let actions = self.ui.handle_key(key);\n2909:                self.record_actions(actions);\n2910:                self.dirty = true;\n2911:            }\n2912:            TerminalAppInput::Char(ch) => {\n2913:                let actions = self.ui.handle_key(UiKey::Char(ch));\n2914:                self.record_actions(actions);\n2915:                self.dirty = true;\n2916:            }\n2917:            TerminalAppInput::Backspace | TerminalAppInput::Enter | TerminalAppInput::LineBreak => {\n2918:            }\n2919:        }\n2920:    }\n2921:\n2922:    fn handle_command_line(&mut self, line: &str) {\n2923:        if is_agent_slash_command(line)\n2924:            && let Some(agent_id) = self.ui.selected_agent().cloned()\n2925:        {\n2926:            self.controller.send_message(&agent_id, line);\n2927:            self.apply_controller_events();\n2928:            return;\n2929:        }\n2930:\n2931:        self.controller.execute_command_line(line);\n2932:        self.apply_controller_events();\n2933:    }\n2934:\n2935:    fn send_chat_buffer(&mut self) {\n2936:        let message = self.chat_buffer.trimmed_string();\n2937:        self.chat_buffer.clear();\n2938:        self.chat_history_index = None;\n2939:        self.chat_history_draft = None;\n2940:        if message.is_empty() {\n2941:            self.dirty = true;\n2942:            return;\n2943:        }\n2944:\n2945:        self.chat_history.push(message.clone());\n2946:        if let Some(agent_id) = self.ui.selected_agent().cloned() {\n2947:            self.controller.send_message(&agent_id, &message);\n2948:        } else {\n2949:            self.controller.send_command_agent_message(&message);\n2950:        }\n2951:        self.apply_controller_events();\n2952:        self.dirty = true;\n2953:    }\n2954:\n2955:    #[cfg(test)]\n2956:    fn clear_agent_loading(&mut self, agent_id: &AgentId) {\n2957:        self.set_agent_loading(agent_id, None);\n2958:    }\n2959:\n2960:    #[cfg(test)]\n2961:    fn set_agent_loading(&mut self, agent_id: &AgentId, loading: Option<LoadingKind>) {\n2962:        let _ = self.ui.set_agent_ready_state(agent_id, loading.is_none());\n2963:    }\n2964:\n2965:    fn record_actions(&mut self, actions: Vec<crate::UiAction>) {\n2966:        for action in actions {\n2967:            self.controller.push_transcript_line(ui_action_text(action));\n2968:        }\nstderr:\n<empty>\n","type":"text"}],"model":"gpt-5.5","sandboxPolicy":{"type":"readOnly"},"threadId":"01a043d4-1711-72c0-8914-41fd265e1c7c"}}
