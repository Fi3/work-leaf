1400:
1401:    fn clamp_control_selection(&mut self) {
1402:        let max_row = self.visible_agent_indices().len();
1403:        if self.control_selected > max_row {
1404:            self.control_selected = max_row;
1405:        }
1406:    }
1407:
1408:    fn visible_agent_indices(&self) -> Vec<usize> {
1409:        self.agents
1410:            .iter()
1411:            .enumerate()
1412:            .filter_map(|(index, agent)| (!agent.hidden).then_some(index))
1413:            .collect()
1414:    }
1415:
1416:    fn control_selected_agent_index(&self) -> Option<usize> {
1417:        if self.control_selected == 0 {
1418:            return None;
1419:        }
1420:        self.visible_agent_indices()
1421:            .get(self.control_selected - 1)
1422:            .copied()
1423:    }
1424:
1425:    fn control_selected_agent_id(&self) -> Option<AgentId> {
1426:        self.control_selected_agent_index()
1427:            .map(|index| self.agents[index].id.clone())
1428:    }
1429:
1430:    fn left_pane_click_target(&mut self, row: u16) -> Option<LeftPaneClickTarget> {
1431:        let list_row = usize::from(row.saturating_sub(2));
1432:        if row < 2 {
1433:            return None;
1434:        }
1435:        if list_row == 0 {
1436:            self.control_selected = 0;
1437:            return Some(LeftPaneClickTarget::Command);
1438:        }
1439:
1440:        let mut current_row = 1;
1441:        for (visible_position, agent_index) in self.visible_agent_indices().iter().enumerate() {
1442:            let agent = &self.agents[*agent_index];
1443:            if list_row == current_row {
1444:                self.control_selected = visible_position + 1;
1445:                return Some(LeftPaneClickTarget::Agent(agent.id.clone()));
1446:            }
1447:            current_row += 1;
1448:
1449:            if !agent.modified_files.is_empty() {
1450:                if list_row == current_row {
1451:                    self.control_selected = visible_position + 1;
1452:                    return Some(LeftPaneClickTarget::Agent(agent.id.clone()));
1453:                }
1454:                current_row += 1;
1455:            }
1456:
1457:            for linked_agents in [
1458:                &agent.conflicting_agents,
1459:                &agent.depends_on,
1460:                &agent.depended_on_by,
1461:            ] {
1462:                if !linked_agents.is_empty() {
1463:                    if list_row == current_row {
1464:                        self.control_selected = visible_position + 1;
1465:                        return linked_agents
1466:                            .first()
1467:                            .cloned()
1468:                            .map(LeftPaneClickTarget::Agent);
1469:                    }
1470:                    current_row += 1;
1471:                }
1472:            }
1473:        }
1474:
1475:        None
1476:    }
1477:
1478:    fn action_agent_id(&self) -> Option<AgentId> {
1479:        self.control_selected_agent_id()
1480:            .or_else(|| self.selected_agent.clone())
1481:    }
1482:
1483:    fn control_cursor_row(&self) -> u16 {
1484:        (self.control_selected + 2).min(usize::from(u16::MAX)) as u16
1485:    }
1486:
1487:    fn right_cursor_position_with_cursor(
1488:        &self,
1489:        right_content: &str,
1490:        cursor_column: Option<usize>,
1491:    ) -> (u16, u16) {
1492:        let layout = self.layout();
1493:        let inner_width = layout.right_width.saturating_sub(2).max(1);
1494:        let lines = right_content.lines().collect::<Vec<_>>();
1495:        let Some(line) = lines.last().copied() else {
1496:            return (2, layout.left_width.saturating_add(2));
1497:        };
1498:        if !line.starts_with("chat> ") {
1499:            return (2, layout.left_width.saturating_add(2));
1500:        }
1501:        let previous_rows = lines[..lines.len() - 1]
1502:            .iter()
1503:            .map(|line| visual_rows(line, inner_width))
1504:            .sum::<u16>();
1505:        let line_chars = line.chars().count();
1506:        let line_len = cursor_column
1507:            .unwrap_or(line_chars)
1508:            .min(line_chars)
1509:            .min(usize::from(u16::MAX)) as u16;
1510:        let row = 2_u16
1511:            .saturating_add(previous_rows)
1512:            .saturating_add(line_len / inner_width);
1513:        let column = layout
1514:            .left_width
1515:            .saturating_add(2)
1516:            .saturating_add(line_len % inner_width);
1517:        (row, column)
1518:    }
1519:    fn right_inner_size(&self) -> (u16, u16) {
1520:        let layout = self.layout();
1521:        let inner_width = layout.right_width.saturating_sub(2).max(1);
1522:        let body_height = self.height.saturating_sub(1);
1523:        let inner_height = body_height.saturating_sub(2).max(1);
1524:        (inner_width, inner_height)
1525:    }
1526:
1527:    fn next_window(&mut self) {
1528:        if !self.windows.is_empty() {
1529:            self.active_window = (self.active_window + 1) % self.windows.len();
1530:        }
1531:    }
1532:
1533:    fn previous_window(&mut self) {
1534:        if !self.windows.is_empty() {
1535:            self.active_window = if self.active_window == 0 {
1536:                self.windows.len() - 1
1537:            } else {
1538:                self.active_window - 1
1539:            };
1540:        }
1541:    }
