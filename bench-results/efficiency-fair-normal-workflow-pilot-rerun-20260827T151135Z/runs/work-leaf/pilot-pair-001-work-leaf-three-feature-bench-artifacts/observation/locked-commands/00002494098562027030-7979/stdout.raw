1543:    fn render_agent_links(&self, label: &str, agents: &[AgentId], rendered: &mut String) {
1544:        if agents.is_empty() {
1545:            return;
1546:        }
1547:        rendered.push_str("    ");
1548:        rendered.push_str(label);
1549:        rendered.push_str(": ");
1550:        for (index, agent_id) in agents.iter().enumerate() {
1551:            if index > 0 {
1552:                rendered.push_str(", ");
1553:            }
1554:            rendered.push_str(agent_id.as_str());
1555:        }
1556:        rendered.push('\n');
1557:    }
1558:
1559:    fn render_status_line(&self) -> String {
1560:        if let Some(notice) = self.active_status_notice() {
1561:            return notice.to_string();
1562:        }
1563:
1564:        format!(
1565:            "mode={} focus={} window={}/{}",
1566:            self.mode.as_str(),
1567:            self.focus.as_str(),
1568:            self.active_window + 1,
1569:            self.windows.len()
1570:        )
1571:    }
1572:}
