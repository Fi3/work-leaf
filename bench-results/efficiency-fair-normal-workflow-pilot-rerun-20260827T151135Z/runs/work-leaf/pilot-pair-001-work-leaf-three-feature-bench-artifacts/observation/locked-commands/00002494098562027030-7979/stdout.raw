1574:impl UiMode {
1575:    fn as_str(&self) -> &'static str {
1576:        match self {
1577:            Self::Command => "command",
1578:            Self::Insert => "insert",
1579:            Self::Prompt => "prompt",
1580:        }
1581:    }
1582:}
1583:
1584:impl PaneFocus {
1585:    fn as_str(&self) -> &'static str {
1586:        match self {
1587:            Self::Left => "left",
1588:            Self::Right => "right",
1589:        }
1590:    }
1591:}
1592:
1593:fn agent_list_labels(agent: &AgentListEntry) -> (&str, &str) {
1594:    if agent.id.as_str().starts_with("review-") {
1595:        (agent.id.as_str(), &agent.feature)
1596:    } else {
1597:        (&agent.feature, agent.id.as_str())
1598:    }
1599:}
1600:
1601:fn compact_agent_row(agent: &AgentListEntry, selected: bool, width: usize) -> String {
1602:    let prefix = if selected { ">" } else { " " };
1603:    let status = if agent.ready { " READY" } else { "" };
1604:    let id = agent.id.as_str();
1605:    let width = width.max(1);
1606:
1607:    let row = if id.starts_with("review-") {
1608:        compact_fixed_first(prefix, id, &agent.feature, status, width)
1609:    } else {
1610:        compact_fixed_last(prefix, &agent.feature, id, status, width)
1611:    };
1612:    truncate_to_width(&row, width)
1613:}
1614:
1615:fn compact_fixed_first(
1616:    prefix: &str,
1617:    fixed: &str,
1618:    flexible: &str,
1619:    status: &str,
1620:    width: usize,
1621:) -> String {
1622:    let fixed_width = prefix.chars().count() + fixed.chars().count() + status.chars().count();
1623:    if fixed_width >= width {
1624:        return format!("{prefix}{fixed}{status}");
1625:    }
1626:
1627:    let flexible_width = width.saturating_sub(fixed_width + 1);
1628:    format!(
1629:        "{prefix}{fixed} {}{status}",
1630:        truncate_to_width(flexible, flexible_width)
1631:    )
1632:}
1633:
1634:fn compact_fixed_last(
1635:    prefix: &str,
1636:    flexible: &str,
1637:    fixed: &str,
1638:    status: &str,
1639:    width: usize,
1640:) -> String {
1641:    let fixed_width = prefix.chars().count() + 1 + fixed.chars().count() + status.chars().count();
1642:    if fixed_width >= width {
1643:        return format!("{prefix}{fixed}{status}");
1644:    }
1645:
1646:    let flexible_width = width.saturating_sub(fixed_width);
1647:    format!(
1648:        "{prefix}{} {fixed}{status}",
1649:        truncate_to_width(flexible, flexible_width)
1650:    )
1651:}
1652:
1653:fn truncate_to_width(text: &str, width: usize) -> String {
1654:    text.chars().take(width).collect()
1655:}
1656:
1657:fn buffer_to_string(buffer: &Buffer) -> String {
1658:    const ANSI_REVERSE_VIDEO: &str = "\u{1b}[7m";
1659:    const ANSI_RESET: &str = "\u{1b}[0m";
1660:    let mut output = String::new();
1661:    for y in 0..buffer.area.height {
1662:        let mut reversed = false;
1663:        for x in 0..buffer.area.width {
1664:            let cell = buffer.get(x, y);
1665:            let cell_reversed = cell.modifier.contains(Modifier::REVERSED);
1666:            if cell_reversed != reversed {
1667:                output.push_str(if cell_reversed {
1668:                    ANSI_REVERSE_VIDEO
1669:                } else {
1670:                    ANSI_RESET
1671:                });
1672:                reversed = cell_reversed;
1673:            }
1674:            output.push_str(&cell.symbol);
1675:        }
1676:        if reversed {
1677:            output.push_str(ANSI_RESET);
1678:        }
1679:        if y + 1 < buffer.area.height {
1680:            output.push_str("\r\n");
1681:        }
1682:    }
1683:    output
1684:}
1685:
1686:fn visual_rows(line: &str, width: u16) -> u16 {
1687:    visual_row_count(line, width).min(usize::from(u16::MAX)) as u16
1688:}
1689:
1690:fn visual_row_count(line: &str, width: u16) -> usize {
1691:    let width = usize::from(width.max(1));
1692:    let len = line.chars().count().min(usize::from(u16::MAX));
1693:    (len / width).saturating_add(1)
1694:}
1695:
1696:fn cursor_char_count(text: &str, cursor: usize) -> usize {
1697:    text.char_indices()
1698:        .take_while(|(index, _)| *index < cursor)
1699:        .count()
1700:}
1701:
1702:fn visible_content(content: &str, width: u16, height: u16, scroll_rows: usize) -> String {
1703:    let height = usize::from(height);
1704:    let Some((history, prompt)) = split_chat_prompt(content) else {
1705:        return tail_visible_content(content, width, height, scroll_rows);
1706:    };
1707:
1708:    let prompt_rows = visual_row_count(prompt, width);
1709:    let history_height = height.saturating_sub(prompt_rows).max(1);
1710:    let visible_history = tail_visible_content(history, width, history_height, scroll_rows);
1711:    if visible_history.is_empty() {
1712:        prompt.to_string()
1713:    } else {
1714:        format!("{visible_history}\n{prompt}")
1715:    }
1716:}
1717:
1718:fn split_chat_prompt(content: &str) -> Option<(&str, &str)> {
1719:    let (history, prompt) = content.rsplit_once('\n')?;
1720:    prompt.starts_with("chat> ").then_some((history, prompt))
1721:}
1722:
1723:fn tail_visible_content(content: &str, width: u16, height: usize, scroll_rows: usize) -> String {
1724:    if content.is_empty() || height == 0 {
1725:        return String::new();
1726:    }
1727:
1728:    let lines = content.lines().collect::<Vec<_>>();
1729:    let rows_to_skip = scroll_rows.min(
1730:        lines
1731:            .iter()
1732:            .map(|line| visual_row_count(line, width))
1733:            .sum::<usize>()
1734:            .saturating_sub(height),
1735:    );
1736:    let mut visible = Vec::new();
1737:    let mut skipped_rows = 0_usize;
1738:    let mut used_rows = 0_usize;
1739:    for line in lines.iter().rev() {
1740:        let rows = visual_row_count(line, width);
1741:        if skipped_rows.saturating_add(rows) <= rows_to_skip {
1742:            skipped_rows = skipped_rows.saturating_add(rows);
1743:            continue;
1744:        }
1745:        if visible.is_empty() || used_rows.saturating_add(rows) <= height {
1746:            visible.push(*line);
1747:            used_rows = used_rows.saturating_add(rows);
1748:        } else {
1749:            break;
1750:        }
1751:    }
1752:    visible.reverse();
1753:    visible.join("\n")
1754:}
