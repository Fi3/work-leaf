3640:    fn command_surface_chat_uses_command_agent_to_spawn_codex_agent() {
3641:        let root =
3642:            std::env::temp_dir().join(format!("work-leaf-command-surface-{}", std::process::id()));
3643:        let _ = std::fs::remove_dir_all(&root);
3644:        std::fs::create_dir_all(&root).unwrap();
3645:        let chat = CommandChat::new(root, NoopBackend);
3646:        let mut app = TerminalApp::new(chat, 80, 24);
3647:
3648:        assert!(app.ui().selected_agent().is_none());
3649:
3650:        app.handle_bytes(b"ispawn a new patch agent that uses codex\n");
3651:
3652:        assert!(app.wait_for_idle(Duration::from_secs(1)));
3653:        let agent_id = AgentId::new("user-1").expect("test agent id is valid");
3654:        assert_eq!(app.ui().selected_agent(), Some(&agent_id));
3655:        assert!(app.transcript().iter().any(|line| line
3656:            == "command-agent: launching Codex user agent for patch agent that uses codex"));
3657:        assert!(
3658:            app.transcript()
3659:                .iter()
3660:                .any(|line| line == "work-leaf> new patch agent that uses codex")
3661:        );
3662:    }
3663:}
