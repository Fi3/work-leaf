3679:#[test]
3680:fn git_history_finds_latest_commit_for_each_agent_id() {
3681:    let root = git_repo("review-history");
3682:    fs::write(root.join("one.txt"), "one\n").unwrap();
3683:    git(&root, ["add", "."]);
3684:    git(
3685:        &root,
3686:        [
3687:            "commit",
3688:            "-m",
3689:            "UPDATE apply parser patch from chat-a",
3690:            "-m",
3691:            "Agent-ID: chat-a\nFeature: parser\nReason: first",
3692:        ],
3693:    );
3694:    fs::write(root.join("two.txt"), "two\n").unwrap();
3695:    git(&root, ["add", "."]);
3696:    git(
3697:        &root,
3698:        [
3699:            "commit",
3700:            "-m",
3701:            "UPDATE apply docs patch from chat-b",
3702:            "-m",
3703:            "Agent-ID: chat-b\nFeature: docs\nReason: docs",
3704:        ],
3705:    );
3706:    fs::write(root.join("one.txt"), "one again\n").unwrap();
3707:    git(&root, ["add", "."]);
3708:    git(
3709:        &root,
3710:        [
3711:            "commit",
3712:            "-m",
3713:            "UPDATE apply parser patch from chat-a",
3714:            "-m",
3715:            "Agent-ID: chat-a\nFeature: parser\nReason: second",
3716:        ],
3717:    );
3718:
3719:    let commits = GitHistory::new(root).latest_agent_commits().unwrap();
3720:
3721:    assert_eq!(commits.len(), 2);
3722:    assert_eq!(commits[0].agent_id.as_str(), "chat-a");
3723:    assert_eq!(commits[0].reason, "second");
3724:    assert_eq!(commits[1].agent_id.as_str(), "chat-b");
3725:    assert_eq!(commits[1].feature, "docs");
3726:}
