3386:struct PromptLine {
3387:    buffer: LineBuffer,
3388:}
3389:
3390:impl PromptLine {
3391:    const CAPACITY: usize = 64 * 1024;
3392:
3393:    fn new() -> Self {
3394:        Self {
3395:            buffer: LineBuffer::with_capacity(Self::CAPACITY),
3396:        }
3397:    }
3398:
3399:    fn as_str(&self) -> &str {
3400:        self.buffer.as_str()
3401:    }
3402:
3403:    fn cursor(&self) -> usize {
3404:        self.buffer.pos()
3405:    }
3406:
3407:    fn cursor_char_count(&self) -> usize {
3408:        self.as_str()[..self.cursor()].chars().count()
3409:    }
3410:
3411:    fn trimmed_string(&self) -> String {
3412:        self.as_str().trim().to_string()
3413:    }
3414:
3415:    fn push(&mut self, ch: char) {
3416:        let mut listener = NoopLineListener;
3417:        let _ = self.buffer.insert(ch, 1, &mut listener);
3418:    }
3419:
3420:    fn move_left(&mut self) {
3421:        self.buffer.move_backward(1);
3422:    }
3423:
3424:    fn move_right(&mut self) {
3425:        self.buffer.move_forward(1);
3426:    }
3427:
3428:    fn backspace(&mut self) {
3429:        let mut listener = NoopLineListener;
3430:        self.buffer.backspace(1, &mut listener);
3431:    }
3432:
3433:    fn clear(&mut self) {
3434:        let mut listener = NoopLineListener;
3435:        let len = self.buffer.as_str().len();
3436:        self.buffer.replace(0..len, "", &mut listener);
3437:    }
3438:
3439:    fn replace(&mut self, text: &str) {
3440:        let mut listener = NoopLineListener;
3441:        let len = self.buffer.as_str().len();
3442:        self.buffer.replace(0..len, text, &mut listener);
3443:        self.buffer.move_end();
3444:    }
3445:}
