3301:fn is_agent_slash_command(line: &str) -> bool {
3302:    line.strip_prefix('/')
3303:        .and_then(|rest| rest.chars().next())
3304:        .is_some_and(|ch| !ch.is_whitespace())
3305:}
3306:
3307:fn is_complete_control_sequence(sequence: &[u8]) -> bool {
3308:    sequence.len() > 1
3309:        && sequence
3310:            .last()
3311:            .is_some_and(|byte| (0x40..=0x7e).contains(byte))
3312:}
3313:
3314:fn parse_control_sequence(sequence: &[u8]) -> Option<TerminalAppInput> {
3315:    match sequence {
3316:        [b'[', b'A'] => Some(TerminalAppInput::Key(UiKey::Up)),
3317:        [b'[', b'B'] => Some(TerminalAppInput::Key(UiKey::Down)),
3318:        [b'[', b'C'] => Some(TerminalAppInput::Key(UiKey::Right)),
3319:        [b'[', b'D'] => Some(TerminalAppInput::Key(UiKey::Left)),
3320:        [b'[', b'2', b'0', b'0', b'~'] => Some(TerminalAppInput::PasteStart),
3321:        [b'[', b'2', b'0', b'1', b'~'] => Some(TerminalAppInput::PasteEnd),
3322:        [b'[', b'1', b'3', b';', b'2', b'u']
3323:        | [b'[', b'1', b'3', b';', b'2', b'~']
3324:        | [b'[', b'2', b'7', b';', b'2', b';', b'1', b'3', b'~'] => {
3325:            Some(TerminalAppInput::LineBreak)
3326:        }
3327:        _ => parse_sgr_mouse_event(sequence).map(TerminalAppInput::Key),
3328:    }
3329:}
3330:
3331:fn parse_sgr_mouse_event(sequence: &[u8]) -> Option<UiKey> {
3332:    let final_byte = *sequence.last()?;
3333:    if !sequence.starts_with(b"[<") || !matches!(final_byte, b'M' | b'm') {
3334:        return None;
3335:    }
3336:
3337:    let body = std::str::from_utf8(&sequence[2..sequence.len() - 1]).ok()?;
3338:    let mut parts = body.split(';');
3339:    let button = parts.next()?.parse::<u16>().ok()?;
3340:    let column = parts.next()?.parse::<u16>().ok()?;
3341:    let row = parts.next()?.parse::<u16>().ok()?;
3342:    if parts.next().is_some() {
3343:        return None;
3344:    }
3345:
3346:    let button_kind = button & !0b0001_1100_u16;
3347:    match (button_kind, final_byte) {
3348:        (64, b'M') => Some(UiKey::MouseScrollUp { column, row }),
3349:        (65, b'M') => Some(UiKey::MouseScrollDown { column, row }),
3350:        (_, b'M' | b'm') if button_kind < 64 && button & 0b11 == 0 => {
3351:            Some(UiKey::MouseClick { column, row })
3352:        }
3353:        _ => None,
3354:    }
3355:}
3356:
3357:#[derive(Clone, Copy, Debug, Eq, PartialEq)]
3358:enum TerminalAppInput {
3359:    Key(UiKey),
3360:    Char(char),
3361:    Enter,
3362:    Backspace,
3363:    LineBreak,
3364:    PasteStart,
3365:    PasteEnd,
3366:    Interrupt,
3367:    Quit,
3368:}
3369:
3370:impl TerminalAppInput {
3371:    fn from_byte(byte: u8) -> Option<Self> {
3372:        match byte {
3373:            3 => Some(Self::Interrupt),
3374:            4 => Some(Self::Quit),
3375:            13 | 10 => Some(Self::Enter),
3376:            27 => Some(Self::Key(UiKey::Esc)),
3377:            23 => Some(Self::Key(UiKey::CtrlW)),
3378:            8 | 127 => Some(Self::Backspace),
3379:            byte if byte.is_ascii_graphic() || byte == b' ' => Some(Self::Char(byte as char)),
3380:            _ => None,
3381:        }
3382:    }
3383:}
