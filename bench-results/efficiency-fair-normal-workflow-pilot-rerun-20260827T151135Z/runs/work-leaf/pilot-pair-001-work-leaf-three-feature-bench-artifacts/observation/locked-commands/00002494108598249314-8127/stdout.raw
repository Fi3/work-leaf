1914:    pub fn render_frame(&self) -> String {
1915:        self.ui.render_screen_with_cursors(
1916:            &self.right_content(),
1917:            &self.prompt_buffer,
1918:            self.prompt_cursor,
1919:            Some(self.chat_cursor_column()),
1920:        )
1921:    }
1922:
1923:    fn handle_input(&mut self, input: HarnessInput) {
1924:        match input {
1925:            HarnessInput::Quit => self.quit = true,
1926:            HarnessInput::Interrupt => {
1927:                self.ui.show_ctrl_c_exit_notice();
1928:                if self.ui.focus() == PaneFocus::Right
1929:                    && let Some(agent_id) = self.ui.selected_agent()
1930:                {
1931:                    self.transcript
1932:                        .push(format!("work-leaf: sent Ctrl-C to {agent_id}"));
1933:                }
1934:            }
1935:            HarnessInput::Backspace if self.ui.mode() == UiMode::Prompt => {
1936:                self.backspace_prompt_char();
1937:            }
1938:            HarnessInput::Backspace if self.ui.mode() == UiMode::Insert => {
1939:                self.backspace_chat_char();
1940:            }
1941:            HarnessInput::Enter if self.ui.mode() == UiMode::Prompt => {
1942:                let line = self.prompt_buffer.trim().to_string();
1943:                self.prompt_buffer.clear();
1944:                self.prompt_cursor = 0;
1945:                self.prompt_history_index = None;
1946:                self.prompt_history_draft = None;
1947:                self.ui.handle_key(UiKey::Esc);
1948:                if !line.is_empty() {
1949:                    self.prompt_history.push(line.clone());
1950:                    self.transcript.push(format!("work-leaf> {line}"));
1951:                    self.execute_prompt(&line);
1952:                }
1953:            }
1954:            HarnessInput::Enter if self.ui.mode() == UiMode::Insert => {
1955:                let message = self.chat_buffer.trim().to_string();
1956:                self.chat_buffer.clear();
1957:                self.chat_cursor = 0;
1958:                self.chat_history_index = None;
1959:                self.chat_history_draft = None;
1960:                if !message.is_empty() {
1961:                    self.chat_history.push(message.clone());
1962:                    let target_agent = self.ui.selected_agent().cloned();
1963:                    if let Some(agent_id) = target_agent.as_ref() {
1964:                        self.name_chat_from_first_prompt(agent_id, &message);
1965:                    }
1966:                    let target = target_agent
1967:                        .as_ref()
1968:                        .map(AgentId::as_str)
1969:                        .unwrap_or("work-leaf");
1970:                    self.transcript.push(format!("{target}> {message}"));
1971:                    self.transcript
1972:                        .push("fixture reply: message recorded".to_string());
1973:                }
1974:            }
1975:            HarnessInput::Char('/') if self.should_start_agent_slash_command() => {
1976:                self.start_agent_slash_command();
1977:            }
1978:            HarnessInput::Char(ch) if self.ui.mode() == UiMode::Prompt => {
1979:                self.insert_prompt_char(ch);
1980:            }
1981:            HarnessInput::Char(ch) if self.ui.mode() == UiMode::Insert => {
1982:                self.insert_chat_char(ch);
1983:            }
1984:            HarnessInput::Key(UiKey::Left) if self.ui.mode() == UiMode::Prompt => {
1985:                self.move_prompt_cursor_left();
1986:            }
1987:            HarnessInput::Key(UiKey::Right) if self.ui.mode() == UiMode::Prompt => {
1988:                self.move_prompt_cursor_right();
1989:            }
1990:            HarnessInput::Key(UiKey::Up) if self.ui.mode() == UiMode::Prompt => {
1991:                self.recall_prompt_history(-1);
1992:            }
1993:            HarnessInput::Key(UiKey::Down) if self.ui.mode() == UiMode::Prompt => {
1994:                self.recall_prompt_history(1);
1995:            }
1996:            HarnessInput::Key(UiKey::Left) if self.should_route_chat_arrow() => {
1997:                self.move_chat_cursor_left();
1998:            }
1999:            HarnessInput::Key(UiKey::Right) if self.should_route_chat_arrow() => {
2000:                self.move_chat_cursor_right();
2001:            }
2002:            HarnessInput::Key(UiKey::Up) if self.should_route_chat_arrow() => {
2003:                self.recall_chat_history(-1);
2004:            }
2005:            HarnessInput::Key(UiKey::Down) if self.should_route_chat_arrow() => {
2006:                self.recall_chat_history(1);
2007:            }
2008:            HarnessInput::Key(UiKey::Esc) => {
2009:                self.prompt_buffer.clear();
2010:                self.prompt_cursor = 0;
2011:                self.prompt_history_index = None;
2012:                self.prompt_history_draft = None;
2013:                let actions = self.ui.handle_key(UiKey::Esc);
2014:                self.record_actions(actions);
2015:            }
2016:            HarnessInput::Key(key) => {
2017:                let actions = self.ui.handle_key(key);
2018:                self.record_actions(actions);
2019:            }
2020:            HarnessInput::Char(ch) => {
2021:                let actions = self.ui.handle_key(UiKey::Char(ch));
2022:                self.record_actions(actions);
2023:            }
2024:            HarnessInput::Backspace | HarnessInput::Enter => {}
2025:        }
2026:    }
2027:
2028:    fn execute_prompt(&mut self, line: &str) {
2029:        if matches!(line, "quit" | "exit" | "q") {
2030:            self.quit = true;
2031:            return;
2032:        }
2033:
2034:        let new_prompt = if line == "new" {
2035:            Some("interactive task discovery")
2036:        } else {
2037:            line.strip_prefix("new ")
2038:        };
2039:
2040:        if let Some(prompt) = new_prompt {
2041:            let agent_id = AgentId::new(format!("user-{}", self.next_agent))
2042:                .expect("generated fixture id is valid");
2043:            self.next_agent += 1;
2044:            self.ui
2045:                .add_agent(AgentListEntry::new(agent_id.clone(), "harness-agent"));
2046:            self.ui
2047:                .activate_agent_chat(&agent_id)
2048:                .expect("generated fixture agent is registered");
2049:            self.transcript
2050:                .push(format!("agent {agent_id} launched for: {prompt}"));
2051:            return;
2052:        }
2053:
2054:        match line {
2055:            "help" | "?" => {
2056:                self.transcript
2057:                    .push("commands: new [prompt...], review, linearize, quit".into());
2058:            }
2059:            "review" => self.transcript.push("fixture review: no findings".into()),
2060:            "linearize" => self
2061:                .transcript
2062:                .push("fixture linearize: keep user-1, keep user-2".into()),
2063:            other => self
2064:                .transcript
2065:                .push(format!("unknown fixture command: {other}")),
2066:        }
2067:    }
2068:
