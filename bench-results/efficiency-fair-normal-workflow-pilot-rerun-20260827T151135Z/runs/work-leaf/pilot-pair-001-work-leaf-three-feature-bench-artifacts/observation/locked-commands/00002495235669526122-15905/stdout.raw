3541:    #[test]
3542:    fn pasted_command_prompt_input_polls_controller_once_per_chunk() {
3543:        let snapshot_calls = Arc::new(AtomicUsize::new(0));
3544:        let drain_calls = Arc::new(AtomicUsize::new(0));
3545:        let controller = CountingController::new(
3546:            crate::WorkLeafSnapshot {
3547:                command_transcript: Vec::new(),
3548:                sessions: Vec::new(),
3549:            },
3550:            Arc::clone(&snapshot_calls),
3551:            Arc::clone(&drain_calls),
3552:        );
3553:        let mut app = TerminalAppCore::new(controller, 80, 24);
3554:        app.handle_bytes(b":");
3555:        drain_calls.store(0, Ordering::Relaxed);
3556:
3557:        let paste = "a".repeat(4096);
3558:        assert!(app.handle_bytes(paste.as_bytes()));
3559:
3560:        assert_eq!(app.prompt_buffer.as_str(), paste);
3561:        assert!(
3562:            drain_calls.load(Ordering::Relaxed) <= 3,
3563:            "large input chunks should not drain events once per byte"
3564:        );
3565:    }
