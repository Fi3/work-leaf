3567:    #[test]
3568:    fn rendering_uses_cached_snapshot_instead_of_refetching_full_transcripts() {
3569:        let snapshot_calls = Arc::new(AtomicUsize::new(0));
3570:        let drain_calls = Arc::new(AtomicUsize::new(0));
3571:        let agent_id = AgentId::new("user-1").expect("test agent id is valid");
3572:        let controller = CountingController::new(
3573:            crate::WorkLeafSnapshot {
3574:                command_transcript: vec!["help".to_string()],
3575:                sessions: vec![WorkLeafSession {
3576:                    id: agent_id,
3577:                    kind: AgentKind::Codex,
3578:                    title: "feature".to_string(),
3579:                    feature: "feature".to_string(),
3580:                    lines: vec!["large transcript line".repeat(256)],
3581:                    loading: None,
3582:                }],
3583:            },
3584:            Arc::clone(&snapshot_calls),
3585:            Arc::clone(&drain_calls),
3586:        );
3587:        let app = TerminalAppCore::new(controller, 80, 24);
3588:        snapshot_calls.store(0, Ordering::Relaxed);
3589:
3590:        assert!(app.render_frame().contains("help"));
3591:        assert!(app.render_frame().contains("help"));
3592:
3593:        assert_eq!(
3594:            snapshot_calls.load(Ordering::Relaxed),
3595:            0,
3596:            "rendering and scrolling should use the local snapshot cache"
3597:        );
3598:    }
