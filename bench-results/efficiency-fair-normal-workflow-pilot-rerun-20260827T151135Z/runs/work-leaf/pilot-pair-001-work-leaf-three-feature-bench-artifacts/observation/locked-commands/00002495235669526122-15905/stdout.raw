3488:    #[derive(Debug)]
3489:    struct CountingController {
3490:        snapshot: crate::WorkLeafSnapshot,
3491:        snapshot_calls: Arc<AtomicUsize>,
3492:        drain_calls: Arc<AtomicUsize>,
3493:    }
3494:
3495:    impl CountingController {
3496:        fn new(
3497:            snapshot: crate::WorkLeafSnapshot,
3498:            snapshot_calls: Arc<AtomicUsize>,
3499:            drain_calls: Arc<AtomicUsize>,
3500:        ) -> Self {
3501:            Self {
3502:                snapshot,
3503:                snapshot_calls,
3504:                drain_calls,
3505:            }
3506:        }
3507:    }
3508:
3509:    impl TerminalController for CountingController {
3510:        fn snapshot(&self) -> crate::WorkLeafSnapshot {
3511:            self.snapshot_calls.fetch_add(1, Ordering::Relaxed);
3512:            self.snapshot.clone()
3513:        }
3514:
3515:        fn drain_events(&mut self) -> Vec<WorkLeafEvent> {
3516:            self.drain_calls.fetch_add(1, Ordering::Relaxed);
3517:            Vec::new()
3518:        }
3519:
3520:        fn execute_command_line(&mut self, _line: &str) {}
3521:
3522:        fn send_command_agent_message(&mut self, _message: &str) {}
3523:
3524:        fn send_message(&mut self, _agent_id: &AgentId, _message: &str) {}
3525:
3526:        fn interrupt_agent(&mut self, _agent_id: &AgentId) {}
3527:
3528:        fn push_transcript_line(&mut self, _line: String) {}
3529:
3530:        fn is_busy(&mut self) -> bool {
3531:            false
3532:        }
3533:
3534:        fn loading_text(&self, _loading: WorkLeafLoading) -> String {
3535:            "Waiting for Codex".to_string()
3536:        }
3537:
3538:        fn shutdown(&mut self) {}
3539:    }
