3480:            Ok(AgentSession::new(request))
3481:        }
3482:
3483:        fn send(&mut self, _agent_id: &AgentId, prompt: &str) -> Result<ChatMessage, AgentError> {
3484:            Ok(ChatMessage::new(MessageRole::Agent, prompt))
3485:        }
3486:    }
