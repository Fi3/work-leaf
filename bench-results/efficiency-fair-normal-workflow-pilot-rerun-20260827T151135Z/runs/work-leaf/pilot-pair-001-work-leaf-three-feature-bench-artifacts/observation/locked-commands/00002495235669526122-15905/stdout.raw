3600:    #[test]
3601:    fn clearing_agent_loading_marks_chat_ready_in_left_pane() {
3602:        let chat = CommandChat::new(PathBuf::from("."), NoopBackend);
3603:        let mut app = TerminalApp::new(chat, 80, 24);
3604:        let agent_id = AgentId::new("user-1").expect("test agent id is valid");
3605:
3606:        app.inner
3607:            .ui
3608:            .add_agent(AgentListEntry::new(agent_id.clone(), "feature"));
3609:        app.inner
3610:            .ui
3611:            .activate_agent_chat(&agent_id)
3612:            .expect("test agent is registered");
3613:        app.set_agent_loading(&agent_id, Some(LoadingKind::WaitingForReply));
3614:
3615:        assert!(!app.render_frame().contains('\u{7}'));
3616:        assert!(!app.ui().render_left_pane().contains("READY"));
3617:
3618:        app.clear_agent_loading(&agent_id);
3619:
3620:        assert!(app.render_frame().starts_with('\u{7}'));
3621:        assert!(!app.render_frame().contains('\u{7}'));
3622:        assert!(
3623:            app.ui()
3624:                .render_left_pane()
3625:                .contains("\u{1b}[7m>feature user-1  working: feature  READY\u{1b}[0m")
3626:        );
3627:    }
