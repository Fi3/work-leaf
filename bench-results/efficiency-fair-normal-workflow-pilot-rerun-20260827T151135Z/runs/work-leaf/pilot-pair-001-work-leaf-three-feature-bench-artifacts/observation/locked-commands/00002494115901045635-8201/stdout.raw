2601:    pub fn interrupt_agent(&mut self, agent_id: &AgentId) {
2602:        let display_name = self.agent_display_name();
2603:        let result = self
2604:            .chat
2605:            .as_mut()
2606:            .expect("work-leaf controller command chat is present")
2607:            .interrupt_agent(agent_id);
2608:        match result {
2609:            Ok(()) => self.append_agent_line(
2610:                agent_id,
2611:                format!("work-leaf: sent Ctrl-C to {display_name}"),
2612:            ),
2613:            Err(error) => self.append_agent_line(agent_id, command_chat_error_text(&error)),
2614:        }
2615:    }
