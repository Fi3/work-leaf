2869:    fn session_contains(&self, agent_id: &AgentId, needle: &str) -> bool {
2870:        self.sessions
2871:            .get(agent_id)
2872:            .is_some_and(|session| session.lines.iter().any(|line| line.contains(needle)))
2873:    }
