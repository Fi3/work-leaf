2501:    pub fn wait_for_idle(&mut self, timeout: Duration) -> bool {
2502:        let start = Instant::now();
2503:        while start.elapsed() < timeout {
2504:            self.poll_worker();
2505:            if self.workers.is_empty() {
2506:                return true;
2507:            }
2508:            thread::sleep(Duration::from_millis(10));
2509:        }
2510:        self.poll_worker();
2511:        self.workers.is_empty()
2512:    }
2513:
2514:    pub fn wait_for_session_line(
2515:        &mut self,
2516:        agent_id: &AgentId,
2517:        needle: &str,
2518:        timeout: Duration,
2519:    ) -> bool {
2520:        let start = Instant::now();
2521:        while start.elapsed() < timeout {
2522:            self.poll_worker();
2523:            if self.session_contains(agent_id, needle) {
2524:                return true;
2525:            }
2526:            thread::sleep(Duration::from_millis(10));
2527:        }
2528:        self.poll_worker();
2529:        self.session_contains(agent_id, needle)
2530:    }
