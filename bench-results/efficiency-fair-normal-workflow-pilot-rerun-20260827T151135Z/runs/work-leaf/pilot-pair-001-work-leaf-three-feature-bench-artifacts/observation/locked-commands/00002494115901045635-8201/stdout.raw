2307:#[derive(Clone, Debug, Eq, PartialEq)]
2308:struct PendingEscapeSequence {
2309:    bytes: Vec<u8>,
2310:    mode_before: UiMode,
2311:    escape_dispatched: bool,
2312:}
2313:
2314:const CHAT_PROMPT: &str = "chat> ";
2315:const MAX_ESCAPE_SEQUENCE: usize = 64;
2316:
2317:fn parse_key_sequence(bytes: &[u8]) -> Option<(UiKey, usize)> {
2318:    match bytes {
2319:        [27, b'[', b'A', ..] => Some((UiKey::Up, 3)),
2320:        [27, b'[', b'B', ..] => Some((UiKey::Down, 3)),
2321:        [27, b'[', b'C', ..] => Some((UiKey::Right, 3)),
2322:        [27, b'[', b'D', ..] => Some((UiKey::Left, 3)),
2323:        _ => parse_sgr_mouse_sequence(bytes),
2324:    }
2325:}
2326:
2327:fn parse_sgr_mouse_sequence(bytes: &[u8]) -> Option<(UiKey, usize)> {
2328:    if !bytes.starts_with(b"\x1b[<") {
2329:        return None;
2330:    }
2331:
2332:    let final_index = bytes.iter().position(|byte| matches!(byte, b'M' | b'm'))?;
2333:    let final_byte = bytes[final_index];
2334:    let body = std::str::from_utf8(&bytes[3..final_index]).ok()?;
2335:    let mut parts = body.split(';');
2336:    let button = parts.next()?.parse::<u16>().ok()?;
2337:    let column = parts.next()?.parse::<u16>().ok()?;
2338:    let row = parts.next()?.parse::<u16>().ok()?;
2339:    if parts.next().is_some() {
2340:        return None;
2341:    }
2342:
2343:    let button_kind = button & !0b0001_1100_u16;
2344:    let key = match (button_kind, final_byte) {
2345:        (64, b'M') => UiKey::MouseScrollUp { column, row },
2346:        (65, b'M') => UiKey::MouseScrollDown { column, row },
2347:        (_, b'M' | b'm') if button_kind < 64 && button & 0b11 == 0 => {
2348:            UiKey::MouseClick { column, row }
2349:        }
2350:        _ => return None,
2351:    };
2352:    Some((key, final_index + 1))
2353:}
2354:
2355:#[derive(Clone, Copy, Debug, Eq, PartialEq)]
2356:enum HarnessInput {
2357:    Key(UiKey),
2358:    Char(char),
2359:    Enter,
2360:    Backspace,
2361:    Interrupt,
2362:    Quit,
2363:}
2364:
2365:impl HarnessInput {
2366:    fn from_byte(byte: u8) -> Option<Self> {
2367:        match byte {
2368:            3 => Some(Self::Interrupt),
2369:            4 => Some(Self::Quit),
2370:            13 | 10 => Some(Self::Enter),
2371:            27 => Some(Self::Key(UiKey::Esc)),
2372:            23 => Some(Self::Key(UiKey::CtrlW)),
2373:            8 | 127 => Some(Self::Backspace),
2374:            byte if byte.is_ascii_graphic() || byte == b' ' => Some(Self::Char(byte as char)),
2375:            _ => None,
2376:        }
2377:    }
2378:}
2379:
2380:fn cursor_char_count(text: &str, cursor: usize) -> usize {
2381:    text.char_indices()
2382:        .take_while(|(index, _)| *index < cursor)
2383:        .count()
2384:}
2385:fn fixture_ui(width: u16, height: u16, parser: AgentId, tests: AgentId) -> TerminalUi {
