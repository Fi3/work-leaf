2254:
2255:    fn continue_escape_sequence(&mut self, byte: u8) -> bool {
2256:        let Some(sequence) = self.escape_sequence.as_mut() else {
2257:            return false;
2258:        };
2259:
2260:        if sequence.bytes.len() == 1 && byte != b'[' {
2261:            let sequence = self
2262:                .escape_sequence
2263:                .take()
2264:                .expect("escape sequence is present");
