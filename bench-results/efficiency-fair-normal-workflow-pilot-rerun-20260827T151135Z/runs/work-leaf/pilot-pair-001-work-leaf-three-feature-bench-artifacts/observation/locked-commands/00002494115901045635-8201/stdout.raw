2651:    pub fn send_message(&mut self, agent_id: &AgentId, message: &str) -> Result<(), CliError> {
2652:        let message = message.trim();
2653:        if message.is_empty() {
2654:            return Ok(());
2655:        }
2656:        if self
2657:            .sessions
2658:            .get(agent_id)
2659:            .and_then(|session| session.loading)
2660:            .is_some()
2661:        {
2662:            self.append_agent_line(
2663:                agent_id,
2664:                format!("work-leaf: {} is still working", self.agent_display_name()),
2665:            );
2666:            return Ok(());
2667:        }
2668:
2669:        let title_prompt = self.reserve_first_chat_title_prompt(agent_id, message);
2670:        self.set_session_loading(agent_id, Some(WorkLeafLoading::WaitingForReply));
2671:        self.append_agent_line(agent_id, format!("user: {message}"));
2672:        let agent_id = agent_id.clone();
2673:        let message = message.to_string();
2674:        if let Some(first_prompt) = title_prompt {
2675:            self.start_title_worker(agent_id.clone(), first_prompt);
2676:        }
2677:        self.start_worker(move |mut chat, sender| {
2678:            let stream_sender = sender.clone();
2679:            let display_name = chat.agent_profile().display_name.clone();
2680:            let mut stream = move |event_agent_id: &AgentId, event| {
2681:                let _ = stream_sender.send(WorkerEvent::Stream {
2682:                    agent_id: event_agent_id.clone(),
2683:                    text: stream_event_text(event, &display_name),
2684:                });
2685:            };
2686:            match chat.send_to_agent_streaming_with_ids(&agent_id, &message, &mut stream) {
2687:                Ok(result) => {
2688:                    let _ = sender.send(WorkerEvent::Complete {
2689:                        agent_id: Some(agent_id),
2690:                        result,
2691:                    });
2692:                }
2693:                Err(error) => {
2694:                    let _ = sender.send(WorkerEvent::Error {
2695:                        agent_id: Some(agent_id),
2696:                        message: command_chat_error_text(&error),
2697:                    });
2698:                }
2699:            }
2700:        });
2701:        Ok(())
2702:    }
