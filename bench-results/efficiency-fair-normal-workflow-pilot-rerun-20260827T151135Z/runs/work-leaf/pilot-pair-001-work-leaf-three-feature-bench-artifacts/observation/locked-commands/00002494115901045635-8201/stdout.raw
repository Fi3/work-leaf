2179:    fn recall_chat_history(&mut self, delta: isize) {
2180:        if self.chat_history.is_empty() {
2181:            return;
2182:        }
2183:
2184:        if self.chat_history_index.is_none() {
2185:            self.chat_history_draft = Some(self.chat_buffer.clone());
2186:        }
2187:
2188:        let current = self.chat_history_index.unwrap_or(self.chat_history.len()) as isize;
2189:        let next = current + delta;
2190:        if next < 0 {
2191:            self.chat_history_index = Some(0);
2192:            self.chat_buffer = self.chat_history[0].clone();
2193:        } else if next >= self.chat_history.len() as isize {
2194:            self.chat_history_index = None;
2195:            self.chat_buffer = self.chat_history_draft.take().unwrap_or_default();
2196:        } else {
2197:            let next = next as usize;
2198:            self.chat_history_index = Some(next);
2199:            self.chat_buffer = self.chat_history[next].clone();
2200:        }
2201:        self.chat_cursor = self.chat_buffer.len();
