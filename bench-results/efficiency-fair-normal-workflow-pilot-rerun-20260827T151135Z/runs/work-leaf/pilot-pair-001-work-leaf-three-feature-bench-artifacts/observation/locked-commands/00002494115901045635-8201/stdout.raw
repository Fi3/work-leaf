3327:#[derive(Debug)]
3328:struct Worker {
3329:    receiver: Receiver<WorkerEvent>,
3330:    handle: JoinHandle<()>,
3331:}
3332:
3333:#[derive(Clone, Debug, Eq, PartialEq)]
3334:enum WorkerEvent {
3335:    Stream {
