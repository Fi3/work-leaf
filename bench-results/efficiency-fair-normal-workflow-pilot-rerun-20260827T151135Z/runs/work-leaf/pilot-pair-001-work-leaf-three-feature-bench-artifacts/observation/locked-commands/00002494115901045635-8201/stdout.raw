2279:                {
2280:                    let actions = self.ui.handle_key(UiKey::Char('i'));
2281:                    self.record_actions(actions);
2282:                }
2283:                self.handle_input(HarnessInput::Key(key));
2284:            }
2285:        } else if sequence.bytes.len() > MAX_ESCAPE_SEQUENCE {
2286:            let sequence = self
2287:                .escape_sequence
2288:                .take()
2289:                .expect("escape sequence is present");
2290:            self.dispatch_pending_escape_if_needed(&sequence);
2291:        }
2292:
2293:        true
2294:    }
