2532:    pub fn execute_command_line(&mut self, line: &str) {
2533:        let trimmed = line.trim();
2534:        if trimmed.is_empty() {
2535:            return;
2536:        }
2537:        self.push_command_line(format!("work-leaf> {trimmed}"));
2538:        let parts = split_command_line(trimmed);
2539:        let Some(command) = parts.first().map(String::as_str) else {
2540:            return;
2541:        };
2542:
2543:        match command {
2544:            "quit" | "exit" | "q" => self.request_quit(),
2545:            "new" => {
2546:                let prompt = parts[1..].join(" ");
2547:                if let Err(error) = self.create_agent(prompt) {
2548:                    self.push_command_line(command_chat_error_text(&error));
2549:                }
2550:            }
2551:            "review" => {
2552:                if let Err(error) = self.start_review() {
2553:                    self.push_command_line(command_chat_error_text(&error));
2554:                }
2555:            }
2556:            "linearize" => {
2557:                if let Err(error) = self.start_linearize() {
2558:                    self.push_command_line(command_chat_error_text(&error));
2559:                }
2560:            }
2561:            _ => self.start_command_worker(trimmed.to_string()),
2562:        }
2563:    }
2564:
2565:    pub fn send_command_agent_message(&mut self, message: &str) {
2566:        let message = message.trim();
2567:        if message.is_empty() {
2568:            return;
2569:        }
2570:
2571:        self.push_command_line(format!("user: {message}"));
2572:        let display_name = self.agent_display_name();
2573:        if literal_command_line(message).is_none()
2574:            && let Some(request) = command_agent_new_request(message)
2575:        {
2576:            self.push_command_line(format!(
2577:                "command-agent: {}",
2578:                command_agent_launch_reply(&display_name, &request)
2579:            ));
2580:            let command_line = command_agent_new_command_line(&request.prompt);
2581:            for _ in 0..request.count {
2582:                self.execute_command_line(&command_line);
2583:            }
2584:            return;
2585:        }
2586:
2587:        match command_agent_response(message, &display_name) {
2588:            CommandAgentResponse::Execute {
2589:                command_line,
2590:                reply,
2591:            } => {
2592:                self.push_command_line(format!("command-agent: {reply}"));
2593:                self.execute_command_line(&command_line);
2594:            }
2595:            CommandAgentResponse::Reply(reply) => {
2596:                self.push_command_line(format!("command-agent: {reply}"));
2597:            }
2598:        }
2599:    }
