3299:#[derive(Clone, Debug, Deserialize, Eq, PartialEq, Serialize)]
3300:pub enum WorkLeafEvent {
3301:    AgentAdded {
3302:        session: WorkLeafSession,
3303:    },
3304:    AgentUpdated {
3305:        session: WorkLeafSession,
3306:    },
3307:    AgentStatusUpdated {
