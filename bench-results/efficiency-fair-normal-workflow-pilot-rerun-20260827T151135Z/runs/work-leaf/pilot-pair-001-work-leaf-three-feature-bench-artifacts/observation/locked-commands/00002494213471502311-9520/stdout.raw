4197:fn controller_review_prompt_covers_all_agent_commits_since_launch() {
4198:    let root = git_repo("workspace-review-full-agent-scope");
4199:    fs::write(root.join("README.md"), "before\n").unwrap();
4200:    git(&root, ["add", "README.md"]);
4201:    git(&root, ["commit", "-m", "ADD initial readme fixture"]);
4202:    let backend = FakeBackend::new([
4203:        "first patch\n@work-leaf patch first step\n--- a/README.md\n+++ b/README.md\n@@ -1 +1 @@\n-before\n+after first\n@work-leaf end",
4204:        "second patch\n@work-leaf patch second step\n--- a/README.md\n+++ b/README.md\n@@ -1 +1 @@\n-after first\n+after second\n@work-leaf end\n@work-leaf done",
4205:        "summary: full change",
4206:        "NO_FINDINGS",
4207:    ]);
4208:    let chat = CommandChat::new(root, backend.clone()).with_max_review_rounds(4);
4209:    let mut controller = WorkLeafController::new(chat);
4210:
4211:    let agent_id = controller
4212:        .create_agent("update readme in two steps")
4213:        .unwrap();
4214:
4215:    assert_eq!(agent_id.as_str(), "user-1");
4216:    assert!(controller.wait_for_idle(Duration::from_secs(2)));
4217:    let launches = backend.launches();
4218:    let review_launch = launches
4219:        .iter()
4220:        .find(|launch| launch.id.as_str() == "review-user-1")
4221:        .expect("reviewer launched");
4222:    assert!(
4223:        review_launch.prompt.contains("first step"),
4224:        "{}",
4225:        review_launch.prompt
4226:    );
4227:    assert!(
4228:        review_launch.prompt.contains("second step"),
4229:        "{}",
4230:        review_launch.prompt
4231:    );
4232:}
