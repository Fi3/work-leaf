4055:#[test]
4056:fn controller_uses_agent_profile_for_non_codex_launches_and_reviews() {
4057:    let root = git_repo("workspace-custom-profile-review");
4058:    fs::write(root.join("README.md"), "fixture\n").unwrap();
4059:    git(&root, ["add", "README.md"]);
4060:    git(
4061:        &root,
4062:        [
4063:            "commit",
4064:            "-m",
4065:            "UPDATE apply parser patch from user-1",
4066:            "-m",
4067:            "Agent-ID: user-1\nFeature: parser\nReason: parse configs\nContext: parser context",
4068:        ],
4069:    );
4070:    let backend = FakeBackend::new(["launch reply", "summary", "NO_FINDINGS"]);
4071:    let profile = AgentProfile::new(
4072:        AgentKind::External("local-test-agent".to_string()),
4073:        "Local Test Agent",
4074:        "local-agent",
4075:    );
4076:    let chat = CommandChat::new(root, backend.clone()).with_agent_profile(profile.clone());
4077:    let mut controller = WorkLeafController::new(chat);
4078:
4079:    let agent_id = controller
4080:        .create_agent("build custom provider path")
4081:        .unwrap();
4082:    assert!(controller.wait_for_idle(Duration::from_secs(1)));
4083:    controller.start_review().unwrap();
4084:    assert!(controller.wait_for_idle(Duration::from_secs(1)));
4085:
4086:    let launches = backend.launches();
4087:    assert!(launches.iter().any(|launch| {
4088:        launch.id == agent_id
4089:            && launch.kind == profile.kind
4090:            && launch.feature == profile.default_feature
4091:    }));
4092:    assert!(
4093:        launches
4094:            .iter()
4095:            .any(|launch| { launch.id.as_str() == "review-user-1" && launch.kind == profile.kind })
4096:    );
4097:}
