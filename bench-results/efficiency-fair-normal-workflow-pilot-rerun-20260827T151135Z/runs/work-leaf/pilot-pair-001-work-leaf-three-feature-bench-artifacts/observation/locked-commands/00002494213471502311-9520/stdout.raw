3964:#[test]
3965:fn controller_status_events_do_not_resend_existing_large_transcripts() {
3966:    let large_reply = "large transcript line\n".repeat(8192);
3967:    let backend = FakeBackend::new([large_reply.as_str(), "follow reply"]);
3968:    let chat = CommandChat::new(PathBuf::from("/repo"), backend);
3969:    let mut controller = WorkLeafController::new(chat);
3970:
3971:    let agent_id = controller.create_agent("keep status compact").unwrap();
3972:    assert!(controller.wait_for_idle(Duration::from_secs(1)));
3973:    controller.drain_events();
3974:
3975:    controller.send_message(&agent_id, "continue").unwrap();
3976:    let waiting_events = controller.drain_events();
3977:    assert!(waiting_events.iter().any(|event| {
3978:        matches!(
3979:            event,
3980:            WorkLeafEvent::AgentStatusUpdated {
3981:                agent_id: id,
3982:                loading: Some(WorkLeafLoading::WaitingForReply),
3983:                ..
3984:            } if id == &agent_id
3985:        )
3986:    }));
3987:    assert!(
3988:        !waiting_events.iter().any(|event| {
3989:            matches!(
3990:                event,
3991:                WorkLeafEvent::AgentUpdated { session }
3992:                    if session.id == agent_id
3993:                        && session.lines.iter().any(|line| line == &large_reply)
3994:            )
3995:        }),
3996:        "status changes should not serialize existing transcript text"
3997:    );
3998:
3999:    assert!(controller.wait_for_idle(Duration::from_secs(1)));
4000:    let ready_events = controller.drain_events();
4001:    assert!(ready_events.iter().any(|event| {
4002:        matches!(
4003:            event,
4004:            WorkLeafEvent::AgentStatusUpdated {
4005:                agent_id: id,
4006:                loading: None,
4007:                ..
4008:            } if id == &agent_id
4009:        )
4010:    }));
4011:    assert!(ready_events.iter().any(|event| {
4012:        matches!(
4013:            event,
4014:            WorkLeafEvent::AgentLineAppended { agent_id: id, line }
4015:                if id == &agent_id && line == "follow reply"
4016:        )
4017:    }));
4018:    assert!(
4019:        !ready_events.iter().any(|event| {
4020:            matches!(
4021:                event,
4022:                WorkLeafEvent::AgentUpdated { session }
4023:                    if session.id == agent_id
4024:                        && session.lines.iter().any(|line| line == &large_reply)
4025:            )
4026:        }),
4027:        "ready status changes should not serialize existing transcript text"
4028:    );
4029:}
