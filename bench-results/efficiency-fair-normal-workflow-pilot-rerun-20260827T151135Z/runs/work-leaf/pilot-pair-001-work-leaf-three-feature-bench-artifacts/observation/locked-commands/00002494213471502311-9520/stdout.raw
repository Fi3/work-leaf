3900:#[test]
3901:fn controller_exposes_ui_neutral_events_and_snapshot_without_terminal_ui() {
3902:    let backend = FakeBackend::new(["launch reply", "follow reply"]);
3903:    let chat = CommandChat::new(PathBuf::from("/repo"), backend);
3904:    let mut controller = WorkLeafController::new(chat);
3905:
3906:    let agent_id = controller
3907:        .create_agent("implement parser combinator")
3908:        .unwrap();
3909:
3910:    assert_eq!(agent_id, AgentId::new("user-1").unwrap());
3911:    assert!(controller.drain_events().iter().any(|event| {
3912:        matches!(event, WorkLeafEvent::AgentAdded { session } if session.id == agent_id)
3913:    }));
3914:    let starting = controller.snapshot();
3915:    let session = starting.session(&agent_id).expect("session exists");
3916:    assert_eq!(session.title, "user-agent");
3917:    assert_eq!(session.loading, Some(WorkLeafLoading::Launching));
3918:
3919:    assert!(controller.wait_for_idle(Duration::from_secs(1)));
3920:    let ready = controller.snapshot();
3921:    let session = ready.session(&agent_id).expect("session exists");
3922:    assert_eq!(session.title, "parser-combinator");
3923:    assert_eq!(session.loading, None);
3924:    assert!(session.lines.iter().any(|line| line == "launch reply"));
3925:
3926:    controller.send_message(&agent_id, "continue").unwrap();
3927:    assert!(controller.wait_for_idle(Duration::from_secs(1)));
3928:    let replied = controller.snapshot();
3929:    let session = replied.session(&agent_id).expect("session exists");
3930:    assert!(session.lines.iter().any(|line| line == "user: continue"));
3931:    assert!(session.lines.iter().any(|line| line == "follow reply"));
3932:}
