4156:#[test]
4157:fn controller_does_not_start_review_until_patch_agent_reports_done() {
4158:    let root = git_repo("workspace-review-waits-for-done");
4159:    fs::write(root.join("README.md"), "before\n").unwrap();
4160:    git(&root, ["add", "README.md"]);
4161:    git(&root, ["commit", "-m", "ADD initial readme fixture"]);
4162:    let backend = FakeBackend::new([
4163:        "implemented patch\n@work-leaf patch update readme\n--- a/README.md\n+++ b/README.md\n@@ -1 +1 @@\n-before\n+after\n@work-leaf end",
4164:        "summary that should not be requested",
4165:        "NO_FINDINGS",
4166:    ]);
4167:    let chat = CommandChat::new(root, backend.clone()).with_max_review_rounds(4);
4168:    let mut controller = WorkLeafController::new(chat);
4169:
4170:    let agent_id = controller.create_agent("update readme").unwrap();
4171:
4172:    assert!(controller.wait_for_idle(Duration::from_secs(2)));
4173:    let snapshot = controller.snapshot();
4174:    assert!(
4175:        snapshot
4176:            .session(&AgentId::new("review-user-1").unwrap())
4177:            .is_none(),
4178:        "review must wait for the patch agent to report done"
4179:    );
4180:    let patch_agent = snapshot.session(&agent_id).expect("patch agent exists");
4181:    assert_eq!(patch_agent.loading, None);
4182:    let launches = backend.launches();
4183:    assert!(
4184:        !launches
4185:            .iter()
4186:            .any(|launch| launch.id.as_str() == "review-user-1")
4187:    );
4188:    let sends = backend.sends();
4189:    assert!(sends.iter().any(|(target, prompt)| {
4190:        target == &agent_id
4191:            && prompt.contains("work-leaf patch applied")
4192:            && prompt.contains("@work-leaf done")
4193:    }));
4194:}
