3934:#[test]
3935:fn controller_line_events_do_not_resend_full_session_transcripts() {
3936:    let backend = FakeBackend::new(["launch reply"]);
3937:    let chat = CommandChat::new(PathBuf::from("/repo"), backend);
3938:    let mut controller = WorkLeafController::new(chat);
3939:
3940:    let agent_id = controller.create_agent("stream compactly").unwrap();
3941:    assert!(controller.wait_for_idle(Duration::from_secs(1)));
3942:
3943:    let events = controller.drain_events();
3944:    assert!(events.iter().any(|event| {
3945:        matches!(
3946:            event,
3947:            WorkLeafEvent::AgentLineAppended { agent_id: id, line }
3948:                if id == &agent_id && line == "launch reply"
3949:        )
3950:    }));
3951:    assert!(
3952:        !events.iter().any(|event| {
3953:            matches!(
3954:                event,
3955:                WorkLeafEvent::AgentUpdated { session }
3956:                    if session.id == agent_id
3957:                        && session.lines.iter().any(|line| line == "launch reply")
3958:            )
3959:        }),
3960:        "line append events should not be paired with full-session transcript updates"
3961:    );
3962:}
