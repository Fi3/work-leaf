4099:#[test]
4100:fn controller_starts_review_after_patch_agent_done_and_loops_until_clean() {
4101:    let root = git_repo("workspace-automatic-review-loop");
4102:    fs::write(root.join("README.md"), "before\n").unwrap();
4103:    git(&root, ["add", "README.md"]);
4104:    git(&root, ["commit", "-m", "ADD initial readme fixture"]);
4105:    let backend = FakeBackend::new([
4106:        "implemented patch\n@work-leaf patch update readme\n--- a/README.md\n+++ b/README.md\n@@ -1 +1 @@\n-before\n+after\n@work-leaf end\n@work-leaf done",
4107:        "summary: README changes from before to after",
4108:        "FINDINGS\n- missing reviewed wording",
4109:        "fixed review finding\n@work-leaf patch address review\n--- a/README.md\n+++ b/README.md\n@@ -1 +1 @@\n-after\n+after review\n@work-leaf end\n@work-leaf done",
4110:        "NO_FINDINGS",
4111:    ]);
4112:    let chat = CommandChat::new(root.clone(), backend.clone()).with_max_review_rounds(4);
4113:    let mut controller = WorkLeafController::new(chat);
4114:
4115:    let agent_id = controller.create_agent("update readme").unwrap();
4116:
4117:    assert!(controller.wait_for_idle(Duration::from_secs(2)));
4118:    assert_eq!(
4119:        fs::read_to_string(root.join("README.md")).unwrap(),
4120:        "after review\n"
4121:    );
4122:
4123:    let reviewer_id = AgentId::new("review-user-1").unwrap();
4124:    let snapshot = controller.snapshot();
4125:    let reviewer = snapshot
4126:        .session(&reviewer_id)
4127:        .expect("reviewer session exists");
4128:    assert_eq!(reviewer.title, "review user-agent");
4129:    assert_eq!(reviewer.loading, None);
4130:    let patch_agent = snapshot.session(&agent_id).expect("patch agent exists");
4131:    assert!(
4132:        patch_agent
4133:            .lines
4134:            .iter()
4135:            .any(|line| line.contains("missing reviewed wording"))
4136:    );
4137:    assert!(
4138:        patch_agent.lines.iter().any(|line| {
4139:            line.contains("user-1 reviewed by review-user-1: rounds=2 resolved=yes")
4140:        })
4141:    );
4142:
4143:    let sends = backend.sends();
4144:    assert!(sends.iter().any(|(target, prompt)| {
4145:        target == &agent_id
4146:            && prompt.contains("missing reviewed wording")
4147:            && prompt.contains("Please fix the patch")
4148:    }));
4149:    assert!(sends.iter().any(|(target, prompt)| {
4150:        target == &reviewer_id
4151:            && prompt.contains("The original agent has responded to the findings")
4152:            && prompt.contains("Please check the patch again")
4153:    }));
4154:}
