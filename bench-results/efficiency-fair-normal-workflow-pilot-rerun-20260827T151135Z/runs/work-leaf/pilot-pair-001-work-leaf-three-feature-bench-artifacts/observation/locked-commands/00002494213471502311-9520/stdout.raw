4032:fn controller_uses_backend_agent_to_name_chat_from_first_prompt() {
4033:    let backend = FakeBackend::new(["launch reply"]);
4034:    let chat = CommandChat::new(PathBuf::from("/repo"), backend.clone());
4035:    let mut controller = WorkLeafController::new(chat);
4036:
4037:    let agent_id = controller
4038:        .create_agent("please fix login callback")
4039:        .unwrap();
4040:
4041:    assert!(controller.wait_for_idle(Duration::from_secs(1)));
4042:    let snapshot = controller.snapshot();
4043:    let session = snapshot.session(&agent_id).expect("session exists");
4044:    assert_eq!(session.title, "oauth-redirect-handler");
4045:    assert!(session.lines.iter().any(|line| line == "launch reply"));
4046:
4047:    let launches = backend.launches();
4048:    assert!(launches.iter().any(|launch| {
4049:        launch.id.as_str() == "title-user-1"
4050:            && launch.feature == "chat-title"
4051:            && launch.prompt.contains("please fix login callback")
4052:    }));
4053:}
