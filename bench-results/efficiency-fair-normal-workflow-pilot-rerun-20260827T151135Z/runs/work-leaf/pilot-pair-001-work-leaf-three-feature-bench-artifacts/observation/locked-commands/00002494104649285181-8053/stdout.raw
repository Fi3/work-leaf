1800:#[derive(Debug)]
1801:pub struct UiHarness {
1802:    ui: TerminalUi,
1803:    prompt_buffer: String,
1804:    prompt_cursor: usize,
1805:    prompt_history: Vec<String>,
1806:    prompt_history_index: Option<usize>,
1807:    prompt_history_draft: Option<String>,
1808:    chat_buffer: String,
1809:    chat_cursor: usize,
1810:    chat_history: Vec<String>,
1811:    chat_history_index: Option<usize>,
1812:    chat_history_draft: Option<String>,
1813:    escape_sequence: Option<PendingEscapeSequence>,
1814:    transcript: Vec<String>,
1815:    chat_title_agent: ChatTitleAgent,
1816:    next_agent: usize,
1817:    quit: bool,
1818:}
1819:
1820:impl UiHarness {
1821:    pub fn new(width: u16, height: u16) -> Self {
1822:        let parser = AgentId::new("user-1").expect("fixture agent id is valid");
1823:        let tests = AgentId::new("user-2").expect("fixture agent id is valid");
1824:        let mut chat_title_agent = ChatTitleAgent::new();
1825:        chat_title_agent.mark_named(&parser);
1826:        chat_title_agent.mark_named(&tests);
1827:
1828:        Self {
1829:            ui: fixture_ui(width, height, parser, tests),
1830:            prompt_buffer: String::new(),
1831:            prompt_cursor: 0,
1832:            prompt_history: Vec::new(),
1833:            prompt_history_index: None,
1834:            prompt_history_draft: None,
1835:            chat_buffer: String::new(),
1836:            chat_cursor: 0,
1837:            chat_history: Vec::new(),
1838:            chat_history_index: None,
1839:            chat_history_draft: None,
1840:            escape_sequence: None,
1841:            transcript: vec![
1842:                "UI harness".to_string(),
1843:                "Esc command, i insert, : prompt, Ctrl-W h/j/k/l focus, , toggle right, q quit"
1844:                    .to_string(),
1845:            ],
1846:            chat_title_agent,
1847:            next_agent: 3,
1848:            quit: false,
1849:        }
1850:    }
1851:
1852:    pub fn ui(&self) -> &TerminalUi {
1853:        &self.ui
1854:    }
1855:
1856:    pub fn transcript(&self) -> &[String] {
1857:        &self.transcript
1858:    }
1859:
1860:    pub fn mark_agent_ready(&mut self, agent_id: &str) -> Result<(), String> {
1861:        let agent_id = AgentId::new(agent_id).map_err(|error| error.to_string())?;
1862:        self.ui.set_agent_ready_state(&agent_id, true)
1863:    }
1864:
1865:    pub fn is_quit(&self) -> bool {
1866:        self.quit
1867:    }
1868:
1869:    pub fn handle_bytes(&mut self, bytes: &[u8]) -> bool {
1870:        let mut index = 0;
1871:        while index < bytes.len() {
1872:            if let Some((key, len)) = parse_key_sequence(&bytes[index..]) {
1873:                self.handle_input(HarnessInput::Key(key));
1874:                index += len;
1875:            } else if !self.handle_byte(bytes[index]) {
1876:                return false;
1877:            } else {
1878:                index += 1;
1879:            }
1880:        }
1881:        self.finish_pending_escape_sequence();
1882:        !self.quit
1883:    }
1884:
1885:    pub fn handle_byte(&mut self, byte: u8) -> bool {
1886:        if self.quit {
1887:            return false;
1888:        }
1889:
1890:        if self.continue_escape_sequence(byte) {
1891:            return !self.quit;
1892:        }
1893:
1894:        if byte == 27 {
1895:            let defer_escape = self.defer_escape_key();
1896:            self.escape_sequence = Some(PendingEscapeSequence {
1897:                bytes: vec![27],
1898:                mode_before: self.ui.mode(),
1899:                escape_dispatched: !defer_escape,
1900:            });
1901:            if !defer_escape {
1902:                self.handle_input(HarnessInput::Key(UiKey::Esc));
1903:            }
1904:            return !self.quit;
1905:        }
1906:
1907:        let Some(input) = HarnessInput::from_byte(byte) else {
1908:            return true;
1909:        };
1910:        self.handle_input(input);
1911:        !self.quit
1912:    }
1913:
1914:    pub fn render_frame(&self) -> String {
1915:        self.ui.render_screen_with_cursors(
1916:            &self.right_content(),
1917:            &self.prompt_buffer,
1918:            self.prompt_cursor,
1919:            Some(self.chat_cursor_column()),
1920:        )
1921:    }
1922:
1923:    fn handle_input(&mut self, input: HarnessInput) {
1924:        match input {
1925:            HarnessInput::Quit => self.quit = true,
1926:            HarnessInput::Interrupt => {
1927:                self.ui.show_ctrl_c_exit_notice();
1928:                if self.ui.focus() == PaneFocus::Right
1929:                    && let Some(agent_id) = self.ui.selected_agent()
1930:                {
1931:                    self.transcript
1932:                        .push(format!("work-leaf: sent Ctrl-C to {agent_id}"));
1933:                }
1934:            }
1935:            HarnessInput::Backspace if self.ui.mode() == UiMode::Prompt => {
1936:                self.backspace_prompt_char();
1937:            }
1938:            HarnessInput::Backspace if self.ui.mode() == UiMode::Insert => {
1939:                self.backspace_chat_char();
1940:            }
1941:            HarnessInput::Enter if self.ui.mode() == UiMode::Prompt => {
1942:                let line = self.prompt_buffer.trim().to_string();
1943:                self.prompt_buffer.clear();
1944:                self.prompt_cursor = 0;
1945:                self.prompt_history_index = None;
1946:                self.prompt_history_draft = None;
1947:                self.ui.handle_key(UiKey::Esc);
1948:                if !line.is_empty() {
1949:                    self.prompt_history.push(line.clone());
1950:                    self.transcript.push(format!("work-leaf> {line}"));
1951:                    self.execute_prompt(&line);
1952:                }
1953:            }
1954:            HarnessInput::Enter if self.ui.mode() == UiMode::Insert => {
1955:                let message = self.chat_buffer.trim().to_string();
1956:                self.chat_buffer.clear();
1957:                self.chat_cursor = 0;
1958:                self.chat_history_index = None;
1959:                self.chat_history_draft = None;
1960:                if !message.is_empty() {
1961:                    self.chat_history.push(message.clone());
1962:                    let target_agent = self.ui.selected_agent().cloned();
1963:                    if let Some(agent_id) = target_agent.as_ref() {
1964:                        self.name_chat_from_first_prompt(agent_id, &message);
1965:                    }
1966:                    let target = target_agent
1967:                        .as_ref()
1968:                        .map(AgentId::as_str)
1969:                        .unwrap_or("work-leaf");
1970:                    self.transcript.push(format!("{target}> {message}"));
1971:                    self.transcript
1972:                        .push("fixture reply: message recorded".to_string());
1973:                }
1974:            }
1975:            HarnessInput::Char('/') if self.should_start_agent_slash_command() => {
1976:                self.start_agent_slash_command();
1977:            }
1978:            HarnessInput::Char(ch) if self.ui.mode() == UiMode::Prompt => {
1979:                self.insert_prompt_char(ch);
1980:            }
1981:            HarnessInput::Char(ch) if self.ui.mode() == UiMode::Insert => {
1982:                self.insert_chat_char(ch);
1983:            }
1984:            HarnessInput::Key(UiKey::Left) if self.ui.mode() == UiMode::Prompt => {
1985:                self.move_prompt_cursor_left();
1986:            }
1987:            HarnessInput::Key(UiKey::Right) if self.ui.mode() == UiMode::Prompt => {
1988:                self.move_prompt_cursor_right();
1989:            }
1990:            HarnessInput::Key(UiKey::Up) if self.ui.mode() == UiMode::Prompt => {
1991:                self.recall_prompt_history(-1);
1992:            }
1993:            HarnessInput::Key(UiKey::Down) if self.ui.mode() == UiMode::Prompt => {
1994:                self.recall_prompt_history(1);
1995:            }
1996:            HarnessInput::Key(UiKey::Left) if self.should_route_chat_arrow() => {
1997:                self.move_chat_cursor_left();
1998:            }
1999:            HarnessInput::Key(UiKey::Right) if self.should_route_chat_arrow() => {
2000:                self.move_chat_cursor_right();
2001:            }
2002:            HarnessInput::Key(UiKey::Up) if self.should_route_chat_arrow() => {
2003:                self.recall_chat_history(-1);
2004:            }
2005:            HarnessInput::Key(UiKey::Down) if self.should_route_chat_arrow() => {
2006:                self.recall_chat_history(1);
2007:            }
2008:            HarnessInput::Key(UiKey::Esc) => {
2009:                self.prompt_buffer.clear();
2010:                self.prompt_cursor = 0;
2011:                self.prompt_history_index = None;
2012:                self.prompt_history_draft = None;
2013:                let actions = self.ui.handle_key(UiKey::Esc);
2014:                self.record_actions(actions);
2015:            }
2016:            HarnessInput::Key(key) => {
2017:                let actions = self.ui.handle_key(key);
2018:                self.record_actions(actions);
2019:            }
2020:            HarnessInput::Char(ch) => {
2021:                let actions = self.ui.handle_key(UiKey::Char(ch));
2022:                self.record_actions(actions);
2023:            }
2024:            HarnessInput::Backspace | HarnessInput::Enter => {}
2025:        }
2026:    }
2027:
2028:    fn execute_prompt(&mut self, line: &str) {
2029:        if matches!(line, "quit" | "exit" | "q") {
2030:            self.quit = true;
2031:            return;
2032:        }
2033:
2034:        let new_prompt = if line == "new" {
2035:            Some("interactive task discovery")
2036:        } else {
2037:            line.strip_prefix("new ")
2038:        };
2039:
2040:        if let Some(prompt) = new_prompt {
2041:            let agent_id = AgentId::new(format!("user-{}", self.next_agent))
2042:                .expect("generated fixture id is valid");
2043:            self.next_agent += 1;
2044:            self.ui
2045:                .add_agent(AgentListEntry::new(agent_id.clone(), "harness-agent"));
2046:            self.ui
2047:                .activate_agent_chat(&agent_id)
2048:                .expect("generated fixture agent is registered");
2049:            self.transcript
2050:                .push(format!("agent {agent_id} launched for: {prompt}"));
2051:            return;
2052:        }
2053:
2054:        match line {
2055:            "help" | "?" => {
2056:                self.transcript
2057:                    .push("commands: new [prompt...], review, linearize, quit".into());
2058:            }
2059:            "review" => self.transcript.push("fixture review: no findings".into()),
2060:            "linearize" => self
2061:                .transcript
2062:                .push("fixture linearize: keep user-1, keep user-2".into()),
2063:            other => self
2064:                .transcript
2065:                .push(format!("unknown fixture command: {other}")),
2066:        }
2067:    }
2068:
2069:    fn name_chat_from_first_prompt(&mut self, agent_id: &AgentId, prompt: &str) {
2070:        if !self.chat_title_agent.reserve_first_prompt_title(agent_id) {
2071:            return;
2072:        }
2073:        let title = fallback_chat_title_from_prompt(prompt);
2074:        let _ = self.ui.set_agent_feature(agent_id, title);
2075:    }
2076:
2077:    fn insert_prompt_char(&mut self, ch: char) {
2078:        self.prompt_buffer.insert(self.prompt_cursor, ch);
2079:        self.prompt_cursor += ch.len_utf8();
2080:        self.prompt_history_index = None;
2081:        self.prompt_history_draft = None;
2082:    }
2083:    fn backspace_prompt_char(&mut self) {
2084:        let Some((previous, _)) = self.prompt_buffer[..self.prompt_cursor]
2085:            .char_indices()
2086:            .next_back()
2087:        else {
2088:            return;
2089:        };
2090:        self.prompt_buffer.drain(previous..self.prompt_cursor);
2091:        self.prompt_cursor = previous;
2092:        self.prompt_history_index = None;
2093:        self.prompt_history_draft = None;
2094:    }
2095:    fn move_prompt_cursor_left(&mut self) {
2096:        if let Some((previous, _)) = self.prompt_buffer[..self.prompt_cursor]
2097:            .char_indices()
2098:            .next_back()
2099:        {
2100:            self.prompt_cursor = previous;
2101:        }
2102:    }
2103:    fn move_prompt_cursor_right(&mut self) {
2104:        if self.prompt_cursor >= self.prompt_buffer.len() {
2105:            return;
2106:        }
2107:        let next = self.prompt_buffer[self.prompt_cursor..]
2108:            .chars()
2109:            .next()
2110:            .map(|ch| self.prompt_cursor + ch.len_utf8())
2111:            .unwrap_or(self.prompt_buffer.len());
2112:        self.prompt_cursor = next;
2113:    }
2114:    fn recall_prompt_history(&mut self, delta: isize) {
2115:        if self.prompt_history.is_empty() {
2116:            return;
2117:        }
2118:        if self.prompt_history_index.is_none() {
2119:            self.prompt_history_draft = Some(self.prompt_buffer.clone());
2120:        }
2121:        let current = self
2122:            .prompt_history_index
2123:            .unwrap_or(self.prompt_history.len()) as isize;
2124:        let next = current + delta;
2125:        if next < 0 {
2126:            self.prompt_history_index = Some(0);
2127:            self.prompt_buffer = self.prompt_history[0].clone();
2128:        } else if next >= self.prompt_history.len() as isize {
2129:            self.prompt_history_index = None;
2130:            self.prompt_buffer = self.prompt_history_draft.take().unwrap_or_default();
2131:        } else {
2132:            let next = next as usize;
2133:            self.prompt_history_index = Some(next);
2134:            self.prompt_buffer = self.prompt_history[next].clone();
2135:        }
2136:        self.prompt_cursor = self.prompt_buffer.len();
2137:    }
2138:    fn insert_chat_char(&mut self, ch: char) {
2139:        self.chat_buffer.insert(self.chat_cursor, ch);
2140:        self.chat_cursor += ch.len_utf8();
2141:        self.chat_history_index = None;
2142:        self.chat_history_draft = None;
2143:    }
2144:
2145:    fn backspace_chat_char(&mut self) {
2146:        let Some((previous, _)) = self.chat_buffer[..self.chat_cursor]
2147:            .char_indices()
2148:            .next_back()
2149:        else {
2150:            return;
2151:        };
2152:        self.chat_buffer.drain(previous..self.chat_cursor);
2153:        self.chat_cursor = previous;
2154:        self.chat_history_index = None;
2155:        self.chat_history_draft = None;
2156:    }
2157:
2158:    fn move_chat_cursor_left(&mut self) {
2159:        if let Some((previous, _)) = self.chat_buffer[..self.chat_cursor]
2160:            .char_indices()
2161:            .next_back()
2162:        {
2163:            self.chat_cursor = previous;
2164:        }
2165:    }
