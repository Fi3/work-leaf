1756:#[cfg(test)]
1757:mod tests {
1758:    use super::*;
1759:
1760:    #[test]
1761:    fn setting_agent_ready_queues_one_bell_for_next_render() {
1762:        let mut ui = TerminalUi::new(80, 24);
1763:        let agent_id = AgentId::new("user-1").expect("test agent id is valid");
1764:        ui.add_agent(AgentListEntry::new(agent_id.clone(), "parser"));
1765:
1766:        ui.set_agent_ready_state(&agent_id, true)
1767:            .expect("test agent is registered");
1768:
1769:        assert!(ui.render_screen("reply").starts_with('\u{7}'));
1770:        assert!(!ui.render_screen("reply").contains('\u{7}'));
1771:    }
1772:
1773:    #[test]
1774:    fn ready_agent_row_is_reversed_across_the_tui_left_pane() {
1775:        let mut ui = TerminalUi::new(100, 24);
1776:        let agent_id = AgentId::new("user-1").expect("test agent id is valid");
1777:        ui.add_agent(AgentListEntry::new(agent_id, "parser").with_ready(true));
1778:
1779:        let buffer = ui.render_tui_buffer("reply", "", 0);
1780:        let left_width = ui.layout().left_width;
1781:
1782:        for column in 1..left_width.saturating_sub(1) {
1783:            assert!(
1784:                buffer.get(column, 2).modifier.contains(Modifier::REVERSED),
1785:                "column {column} on the ready agent row should be reversed"
1786:            );
1787:        }
1788:    }
1789:}
