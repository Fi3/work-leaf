4640:fn git<const N: usize>(root: &Path, args: [&str; N]) {
4641:    let output = Command::new("git")
4642:        .current_dir(root)
4643:        .args(args)
4644:        .output()
4645:        .unwrap();
4646:    assert!(
4647:        output.status.success(),
4648:        "git failed: {}\n{}",
4649:        String::from_utf8_lossy(&output.stdout),
4650:        String::from_utf8_lossy(&output.stderr)
4651:    );
4652:}
