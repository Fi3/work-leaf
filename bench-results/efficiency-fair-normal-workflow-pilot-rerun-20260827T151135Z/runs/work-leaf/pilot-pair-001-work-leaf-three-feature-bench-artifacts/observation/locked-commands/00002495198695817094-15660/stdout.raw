3729:fn review_coordinator_loops_until_reviewer_reports_no_findings() {
3730:    let root = git_repo("review-loop");
3731:    fs::write(root.join("lib.rs"), "pub fn value() -> u8 { 1 }\n").unwrap();
3732:    git(&root, ["add", "."]);
3733:    git(
3734:        &root,
3735:        [
3736:            "commit",
3737:            "-m",
3738:            "UPDATE apply parser patch from chat-a",
3739:            "-m",
3740:            "Agent-ID: chat-a\nFeature: parser\nReason: return value",
3741:        ],
3742:    );
3743:
3744:    let backend = FakeBackend::new([
3745:        "summary: returns a parser value",
3746:        "FINDINGS\n- missing edge case",
3747:        "fixed missing edge case",
3748:        "NO_FINDINGS",
3749:    ]);
3750:    let mut coordinator = ReviewCoordinator::new(root, backend).with_max_rounds(4);
3751:
3752:    let results = coordinator.review_latest_agent_commits().unwrap();
3753:    let backend = coordinator.into_backend();
3754:
3755:    assert_eq!(results.len(), 1);
3756:    assert_eq!(results[0].agent_id.as_str(), "chat-a");
3757:    assert_eq!(results[0].reviewer_id.as_str(), "review-chat-a");
3758:    assert_eq!(results[0].rounds, 2);
3759:    assert!(results[0].findings_resolved);
3760:
3761:    assert_eq!(backend.launches.len(), 1);
3762:    assert_eq!(backend.launches[0].id.as_str(), "review-chat-a");
3763:    assert_eq!(backend.launches[0].kind, AgentKind::Codex);
3764:    assert!(
3765:        backend.launches[0]
3766:            .prompt
3767:            .contains("summary: returns a parser value")
3768:    );
3769:    assert!(backend.launches[0].prompt.contains("chat-a"));
3770:
3771:    assert_eq!(backend.sends.len(), 3);
3772:    assert_eq!(backend.sends[0].0.as_str(), "chat-a");
3773:    assert!(backend.sends[0].1.contains("summarize"));
3774:    assert_eq!(backend.sends[1].0.as_str(), "chat-a");
3775:    assert!(backend.sends[1].1.contains("missing edge case"));
3776:    assert_eq!(backend.sends[2].0.as_str(), "review-chat-a");
3777:    assert!(backend.sends[2].1.contains("check the patch again"));
3778:}
