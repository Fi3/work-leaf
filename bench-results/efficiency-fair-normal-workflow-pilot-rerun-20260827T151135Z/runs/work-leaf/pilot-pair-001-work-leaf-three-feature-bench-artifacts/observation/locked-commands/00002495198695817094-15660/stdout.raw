3824:struct FakeBackend {
3825:    replies: VecDeque<String>,
3826:    launches: Vec<AgentLaunch>,
3827:    sends: Vec<(AgentId, String)>,
3828:}
3829:
3830:impl FakeBackend {
3831:    fn new<const N: usize>(replies: [&str; N]) -> Self {
3832:        Self {
3833:            replies: replies.into_iter().map(String::from).collect(),
3834:            launches: Vec::new(),
3835:            sends: Vec::new(),
3836:        }
3837:    }
3838:
3839:    fn next_reply(&mut self) -> String {
3840:        self.replies.pop_front().expect("missing fake reply")
3841:    }
3842:}
3843:
3844:impl AgentBackend for FakeBackend {
3845:    fn launch(&mut self, request: AgentLaunch) -> Result<AgentSession, AgentError> {
3846:        let reply = self.next_reply();
3847:        self.launches.push(request.clone());
3848:        let mut session = AgentSession::new(request);
3849:        session.push_message(MessageRole::Agent, reply);
3850:        Ok(session)
3851:    }
3852:
3853:    fn send(&mut self, agent_id: &AgentId, prompt: &str) -> Result<ChatMessage, AgentError> {
3854:        self.sends.push((agent_id.clone(), prompt.to_string()));
3855:        Ok(ChatMessage::new(MessageRole::Agent, self.next_reply()))
3856:    }
3857:}
