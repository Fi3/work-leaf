4544:struct FakeBackend {
4545:    state: Arc<Mutex<FakeBackendState>>,
4546:}
4547:
4548:#[derive(Debug)]
4549:struct FakeBackendState {
4550:    replies: VecDeque<String>,
4551:    launches: Vec<AgentLaunch>,
4552:    sends: Vec<(AgentId, String)>,
4553:}
4554:
4555:#[derive(Clone, Debug)]
4556:struct ConcurrentBackend;
4557:
4558:impl FakeBackend {
4559:    fn new<const N: usize>(replies: [&str; N]) -> Self {
4560:        Self {
4561:            state: Arc::new(Mutex::new(FakeBackendState {
4562:                replies: replies.into_iter().map(String::from).collect(),
4563:                launches: Vec::new(),
4564:                sends: Vec::new(),
4565:            })),
4566:        }
4567:    }
4568:
4569:    fn launches(&self) -> Vec<AgentLaunch> {
4570:        self.state.lock().unwrap().launches.clone()
4571:    }
4572:
4573:    fn sends(&self) -> Vec<(AgentId, String)> {
4574:        self.state.lock().unwrap().sends.clone()
4575:    }
4576:
4577:    fn next_reply(&self) -> String {
4578:        self.state
4579:            .lock()
4580:            .unwrap()
4581:            .replies
4582:            .pop_front()
4583:            .expect("missing fake reply")
4584:    }
4585:
4586:    fn title_reply(&self, prompt: &str) -> String {
4587:        fake_title_from_title_prompt(prompt)
4588:    }
4589:}
4590:
4591:impl AgentBackend for FakeBackend {
4592:    fn launch(&mut self, request: AgentLaunch) -> Result<AgentSession, AgentError> {
4593:        self.state.lock().unwrap().launches.push(request.clone());
4594:        let mut session = AgentSession::new(request);
4595:        let reply = if session.id.as_str().starts_with("title-") {
4596:            self.title_reply(&session.messages[0].text)
4597:        } else {
4598:            self.next_reply()
4599:        };
4600:        session.push_message(MessageRole::Agent, reply);
4601:        Ok(session)
4602:    }
4603:
4604:    fn send(&mut self, agent_id: &AgentId, prompt: &str) -> Result<ChatMessage, AgentError> {
4605:        self.state
4606:            .lock()
4607:            .unwrap()
4608:            .sends
4609:            .push((agent_id.clone(), prompt.to_string()));
4610:        Ok(ChatMessage::new(MessageRole::Agent, self.next_reply()))
4611:    }
4612:}
4613:
4614:impl AgentBackend for ConcurrentBackend {
4615:    fn launch(&mut self, request: AgentLaunch) -> Result<AgentSession, AgentError> {
4616:        let mut session = AgentSession::new(request);
4617:        session.push_message(MessageRole::Agent, "ready");
4618:        Ok(session)
4619:    }
4620:
4621:    fn send(&mut self, agent_id: &AgentId, _prompt: &str) -> Result<ChatMessage, AgentError> {
4622:        if agent_id.as_str() == "user-2" {
4623:            thread::sleep(Duration::from_millis(350));
4624:            return Ok(ChatMessage::new(MessageRole::Agent, "slow reply"));
4625:        }
4626:        Ok(ChatMessage::new(MessageRole::Agent, "quick reply"))
4627:    }
4628:}
