3869:fn git<const N: usize>(root: &Path, args: [&str; N]) {
3870:    let output = Command::new("git")
3871:        .args(args)
3872:        .current_dir(root)
3873:        .output()
3874:        .unwrap();
3875:    assert!(
3876:        output.status.success(),
3877:        "git failed: {}\n{}",
3878:        String::from_utf8_lossy(&output.stdout),
3879:        String::from_utf8_lossy(&output.stderr)
3880:    );
3881:}
