4630:fn git_repo(name: &str) -> PathBuf {
4631:    let root = std::env::temp_dir().join(format!("work-leaf-{name}-{}", std::process::id()));
4632:    let _ = fs::remove_dir_all(&root);
4633:    fs::create_dir_all(&root).unwrap();
4634:    git(&root, ["init", "-q"]);
4635:    git(&root, ["config", "user.email", "test@example.com"]);
4636:    git(&root, ["config", "user.name", "Test User"]);
4637:    root
4638:}
