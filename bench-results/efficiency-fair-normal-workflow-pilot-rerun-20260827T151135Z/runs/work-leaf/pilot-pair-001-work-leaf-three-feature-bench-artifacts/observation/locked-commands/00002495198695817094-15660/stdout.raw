3859:fn git_repo(name: &str) -> PathBuf {
3860:    let root = std::env::temp_dir().join(format!("work-leaf-{name}-{}", std::process::id()));
3861:    let _ = fs::remove_dir_all(&root);
3862:    fs::create_dir_all(&root).unwrap();
3863:    git(&root, ["init"]);
3864:    git(&root, ["config", "user.name", "Work Leaf Test"]);
3865:    git(&root, ["config", "user.email", "work-leaf@example.test"]);
3866:    root
3867:}
