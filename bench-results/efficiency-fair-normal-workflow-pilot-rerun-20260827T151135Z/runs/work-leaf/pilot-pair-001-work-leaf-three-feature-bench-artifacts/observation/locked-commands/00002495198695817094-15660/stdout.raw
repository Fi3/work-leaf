3781:fn git_history_builds_agent_review_scope_since_baseline() {
3782:    let root = git_repo("review-history-scope");
3783:    fs::write(root.join("README.md"), "before\n").unwrap();
3784:    git(&root, ["add", "README.md"]);
3785:    git(&root, ["commit", "-m", "ADD initial review scope fixture"]);
3786:    let baseline = GitHistory::new(root.clone()).head_hash().unwrap().unwrap();
3787:    fs::write(root.join("README.md"), "after first\n").unwrap();
3788:    git(&root, ["add", "README.md"]);
3789:    git(
3790:        &root,
3791:        [
3792:            "commit",
3793:            "-m",
3794:            "UPDATE apply first patch from user-1",
3795:            "-m",
3796:            "Agent-ID: user-1\nFeature: readme\nReason: first step\nContext: first context",
3797:        ],
3798:    );
3799:    fs::write(root.join("README.md"), "after second\n").unwrap();
3800:    git(&root, ["add", "README.md"]);
3801:    git(
3802:        &root,
3803:        [
3804:            "commit",
3805:            "-m",
3806:            "UPDATE apply second patch from user-1",
3807:            "-m",
3808:            "Agent-ID: user-1\nFeature: readme\nReason: second step\nContext: second context",
3809:        ],
3810:    );
3811:
3812:    let target = GitHistory::new(root)
3813:        .agent_review_commit(&AgentId::new("user-1").unwrap(), Some(&baseline))
3814:        .unwrap()
3815:        .expect("review target");
3816:
3817:    assert!(target.reason.contains("2 provisional commits"));
3818:    assert!(target.context.contains("first step"));
3819:    assert!(target.context.contains("second step"));
3820:    assert_eq!(target.feature, "readme");
3821:}
