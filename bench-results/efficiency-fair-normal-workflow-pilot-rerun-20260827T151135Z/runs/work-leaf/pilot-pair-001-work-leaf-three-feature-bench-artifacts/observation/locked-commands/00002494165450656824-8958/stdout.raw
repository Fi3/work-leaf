3800:
3801:    harness.handle_byte(b',');
3802:    assert_eq!(harness.ui().layout().left_width, 16);
3803:    assert_eq!(harness.ui().focus(), PaneFocus::Left);
3804:    harness.handle_bytes(&[23, b'j']);
3805:    assert_eq!(harness.ui().focus(), PaneFocus::Right);
3806:
3807:    harness.handle_bytes(&[23, b'k']);
3808:    assert_eq!(harness.ui().focus(), PaneFocus::Left);
3809:}
