4001:#[test]
4002:fn scripted_harness_mouse_wheel_scrolls_chat_history() {
4003:    let mut harness = UiHarness::new(80, 10);
4004:
4005:    harness.handle_bytes(&[23, b'l']);
4006:    harness.handle_byte(b'i');
4007:    for index in 0..12 {
4008:        harness.handle_bytes(format!("message-{index:02}\n").as_bytes());
4009:    }
4010:
4011:    let bottom_frame = harness.render_frame();
4012:    assert!(!bottom_frame.contains("UI harness"));
4013:    assert!(bottom_frame.contains("message-11"));
4014:
4015:    for _ in 0..8 {
4016:        harness.handle_bytes(b"\x1b[<64;20;3M");
4017:    }
4018:
4019:    let scrolled_frame = harness.render_frame();
4020:    assert!(scrolled_frame.contains("UI harness"));
4021:    assert!(scrolled_frame.contains("chat> "));
4022:
4023:    for _ in 0..8 {
4024:        harness.handle_bytes(b"\x1b[<65;20;3M");
4025:    }
4026:
4027:    let bottom_again = harness.render_frame();
4028:    assert!(!bottom_again.contains("UI harness"));
4029:    assert!(bottom_again.contains("message-11"));
4030:}
