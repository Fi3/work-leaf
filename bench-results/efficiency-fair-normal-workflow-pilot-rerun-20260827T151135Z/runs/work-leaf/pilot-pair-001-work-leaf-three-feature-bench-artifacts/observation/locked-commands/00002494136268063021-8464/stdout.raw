2888:    fn register_agent_feature(&mut self, agent_id: AgentId, feature: String) {
2889:        if let Some(chat) = self.chat.as_mut() {
2890:            chat.register_agent_feature(agent_id, feature);
2891:        }
2892:    }
2893:
2894:    fn reserve_first_chat_title_prompt(
2895:        &mut self,
2896:        agent_id: &AgentId,
2897:        prompt: &str,
2898:    ) -> Option<String> {
2899:        if !agent_id.as_str().starts_with("user-") {
2900:            return None;
2901:        }
2902:        if !self.title_agent.reserve_first_prompt_title(agent_id) {
2903:            return None;
2904:        }
2905:        Some(prompt.to_string())
2906:    }
2907:
2908:    fn remember_agent_review_baseline(&mut self, agent_id: &AgentId) {
2909:        if !agent_id.as_str().starts_with("user-")
2910:            || self.agent_review_baselines.contains_key(agent_id)
2911:        {
2912:            return;
2913:        }
2914:        let Some(root) = self
2915:            .chat
2916:            .as_ref()
2917:            .map(|chat| chat.project_dir().to_path_buf())
2918:        else {
2919:            return;
2920:        };
2921:        if let Ok(Some(hash)) = GitHistory::new(root).head_hash() {
2922:            self.agent_review_baselines.insert(agent_id.clone(), hash);
2923:        }
2924:    }
2925:
2926:    fn add_session(&mut self, session: WorkLeafSession) {
2927:        self.sessions.insert(session.id.clone(), session.clone());
2928:        self.pending_events
2929:            .push(WorkLeafEvent::AgentAdded { session });
2930:    }
2931:
2932:    fn start_launch_worker(&mut self, launch: AgentLaunch) {
2933:        let agent_id = launch.id.clone();
2934:        self.set_session_loading(&agent_id, Some(WorkLeafLoading::Launching));
2935:        self.start_worker(move |mut chat, sender| {
2936:            let stream_sender = sender.clone();
2937:            let display_name = chat.agent_profile().display_name.clone();
2938:            let mut stream = move |event_agent_id: &AgentId, event| {
2939:                let _ = stream_sender.send(WorkerEvent::Stream {
2940:                    agent_id: event_agent_id.clone(),
2941:                    text: stream_event_text(event, &display_name),
2942:                });
2943:            };
2944:            match chat.launch_prepared_agent_streaming_with_ids(launch, &mut stream) {
2945:                Ok(result) => {
2946:                    let _ = sender.send(WorkerEvent::Complete {
2947:                        agent_id: Some(agent_id),
2948:                        result,
2949:                    });
2950:                }
2951:                Err(error) => {
2952:                    let _ = sender.send(WorkerEvent::Error {
2953:                        agent_id: Some(agent_id),
2954:                        message: command_chat_error_text(&error),
2955:                    });
2956:                }
2957:            }
2958:        });
2959:    }
2960:
2961:    fn start_title_worker(&mut self, agent_id: AgentId, first_prompt: String) {
2962:        self.start_worker(move |mut chat, sender| {
2963:            let title = chat
2964:                .generate_chat_title(&agent_id, &first_prompt)
2965:                .unwrap_or_else(|_| fallback_chat_title_from_prompt(&first_prompt));
2966:            let _ = sender.send(WorkerEvent::TitleGenerated { agent_id, title });
2967:        });
2968:    }
2969:
2970:    fn start_review_worker(
2971:        &mut self,
2972:        commit: crate::review::AgentCommit,
2973:        reviewer_id: AgentId,
2974:        reuse_reviewer: bool,
2975:    ) {
2976:        self.start_worker(move |mut chat, sender| {
2977:            let stream_sender = sender.clone();
2978:            let display_name = chat.agent_profile().display_name.clone();
2979:            let reviewed_agent_id = commit.agent_id.clone();
2980:            let mut stream = move |event_agent_id: &AgentId, event| {
2981:                let _ = stream_sender.send(WorkerEvent::Stream {
2982:                    agent_id: event_agent_id.clone(),
2983:                    text: stream_event_text(event, &display_name),
2984:                });
2985:            };
2986:            match chat.review_commit_streaming_with_ids(
2987:                commit,
2988:                reviewer_id.clone(),
2989:                reuse_reviewer,
2990:                &mut stream,
2991:            ) {
2992:                Ok(result) => {
2993:                    let _ = sender.send(WorkerEvent::Complete {
2994:                        agent_id: Some(reviewer_id),
2995:                        result: CommandChatResult::ReviewComplete(vec![result]),
2996:                    });
2997:                }
2998:                Err(error) => {
2999:                    let _ = sender.send(WorkerEvent::ReviewError {
3000:                        reviewer_id,
3001:                        reviewed_agent_id,
3002:                        message: error.to_string(),
3003:                    });
3004:                }
3005:            }
3006:        });
3007:    }
3008:
3009:    fn start_command_worker(&mut self, line: String) {
3010:        self.start_worker(move |mut chat, sender| match chat.handle_line(&line) {
3011:            Ok(result) => {
3012:                let _ = sender.send(WorkerEvent::Complete {
3013:                    agent_id: None,
3014:                    result,
3015:                });
3016:            }
3017:            Err(error) => {
3018:                let _ = sender.send(WorkerEvent::Error {
3019:                    agent_id: None,
3020:                    message: command_chat_error_text(&error),
3021:                });
3022:            }
3023:        });
3024:    }
3025:
3026:    fn start_worker<F>(&mut self, operation: F)
3027:    where
3028:        F: FnOnce(CommandChat<B>, Sender<WorkerEvent>) + Send + 'static,
3029:    {
3030:        let Some(chat) = self.chat.as_ref().cloned() else {
3031:            return;
3032:        };
3033:        let (sender, receiver) = mpsc::channel();
3034:        let handle = thread::spawn(move || operation(chat, sender));
3035:        self.workers.push(Worker { receiver, handle });
3036:    }
3037:
3038:    fn apply_worker_event(&mut self, event: WorkerEvent) {
3039:        match event {
3040:            WorkerEvent::Stream { agent_id, text } => {
