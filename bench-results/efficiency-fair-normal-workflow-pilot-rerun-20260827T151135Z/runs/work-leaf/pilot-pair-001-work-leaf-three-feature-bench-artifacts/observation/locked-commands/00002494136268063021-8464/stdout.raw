2580:            let command_line = command_agent_new_command_line(&request.prompt);
2581:            for _ in 0..request.count {
2582:                self.execute_command_line(&command_line);
2583:            }
2584:            return;
2585:        }
2586:
2587:        match command_agent_response(message, &display_name) {
2588:            CommandAgentResponse::Execute {
2589:                command_line,
2590:                reply,
2591:            } => {
2592:                self.push_command_line(format!("command-agent: {reply}"));
2593:                self.execute_command_line(&command_line);
2594:            }
2595:            CommandAgentResponse::Reply(reply) => {
2596:                self.push_command_line(format!("command-agent: {reply}"));
2597:            }
2598:        }
2599:    }
2600:
2601:    pub fn interrupt_agent(&mut self, agent_id: &AgentId) {
2602:        let display_name = self.agent_display_name();
2603:        let result = self
2604:            .chat
2605:            .as_mut()
2606:            .expect("work-leaf controller command chat is present")
2607:            .interrupt_agent(agent_id);
2608:        match result {
2609:            Ok(()) => self.append_agent_line(
2610:                agent_id,
2611:                format!("work-leaf: sent Ctrl-C to {display_name}"),
2612:            ),
2613:            Err(error) => self.append_agent_line(agent_id, command_chat_error_text(&error)),
2614:        }
2615:    }
2616:
2617:    pub fn create_agent(&mut self, prompt: impl Into<String>) -> Result<AgentId, CliError> {
2618:        let prompt = prompt.into();
2619:        let args = split_command_line(&prompt);
2620:        let title_pending = args.is_empty();
2621:        let launch = {
2622:            let chat = self
2623:                .chat
2624:                .as_mut()
2625:                .expect("work-leaf controller command chat is present");
2626:            chat.prepare_agent_launch(&args)?
2627:        };
2628:        let agent_id = launch.id.clone();
2629:        self.remember_agent_review_baseline(&agent_id);
2630:        let title_prompt = self.reserve_launch_title_prompt(&launch, title_pending);
2631:        let title = launch.feature.clone();
2632:        self.register_agent_feature(agent_id.clone(), title.clone());
2633:        self.add_session(WorkLeafSession {
2634:            id: agent_id.clone(),
2635:            kind: launch.kind.clone(),
2636:            title,
2637:            feature: launch.feature.clone(),
2638:            lines: Vec::new(),
2639:            loading: Some(WorkLeafLoading::Launching),
2640:        });
2641:        self.pending_events.push(WorkLeafEvent::AgentSelected {
2642:            agent_id: agent_id.clone(),
2643:        });
2644:        if let Some(first_prompt) = title_prompt {
2645:            self.start_title_worker(agent_id.clone(), first_prompt);
2646:        }
2647:        self.start_launch_worker(launch);
2648:        Ok(agent_id)
2649:    }
2650:
2651:    pub fn send_message(&mut self, agent_id: &AgentId, message: &str) -> Result<(), CliError> {
2652:        let message = message.trim();
2653:        if message.is_empty() {
2654:            return Ok(());
2655:        }
2656:        if self
2657:            .sessions
2658:            .get(agent_id)
2659:            .and_then(|session| session.loading)
2660:            .is_some()
2661:        {
2662:            self.append_agent_line(
2663:                agent_id,
2664:                format!("work-leaf: {} is still working", self.agent_display_name()),
2665:            );
2666:            return Ok(());
2667:        }
2668:
2669:        let title_prompt = self.reserve_first_chat_title_prompt(agent_id, message);
2670:        self.set_session_loading(agent_id, Some(WorkLeafLoading::WaitingForReply));
2671:        self.append_agent_line(agent_id, format!("user: {message}"));
2672:        let agent_id = agent_id.clone();
2673:        let message = message.to_string();
2674:        if let Some(first_prompt) = title_prompt {
2675:            self.start_title_worker(agent_id.clone(), first_prompt);
2676:        }
2677:        self.start_worker(move |mut chat, sender| {
2678:            let stream_sender = sender.clone();
2679:            let display_name = chat.agent_profile().display_name.clone();
2680:            let mut stream = move |event_agent_id: &AgentId, event| {
2681:                let _ = stream_sender.send(WorkerEvent::Stream {
2682:                    agent_id: event_agent_id.clone(),
2683:                    text: stream_event_text(event, &display_name),
2684:                });
2685:            };
2686:            match chat.send_to_agent_streaming_with_ids(&agent_id, &message, &mut stream) {
2687:                Ok(result) => {
2688:                    let _ = sender.send(WorkerEvent::Complete {
2689:                        agent_id: Some(agent_id),
2690:                        result,
2691:                    });
2692:                }
2693:                Err(error) => {
2694:                    let _ = sender.send(WorkerEvent::Error {
2695:                        agent_id: Some(agent_id),
2696:                        message: command_chat_error_text(&error),
2697:                    });
2698:                }
2699:            }
2700:        });
2701:        Ok(())
2702:    }
2703:
2704:    pub fn start_review(&mut self) -> Result<Vec<AgentId>, CliError> {
2705:        self.start_review_for_agent(None)
2706:    }
2707:
2708:    fn start_review_for_patch_agent(
2709:        &mut self,
2710:        agent_id: &AgentId,
2711:    ) -> Result<Vec<AgentId>, CliError> {
2712:        self.start_review_for_agent(Some(agent_id))
2713:    }
2714:
2715:    fn start_review_for_agent(
2716:        &mut self,
2717:        target_agent_id: Option<&AgentId>,
2718:    ) -> Result<Vec<AgentId>, CliError> {
2719:        let (project_dir, agent_profile) = {
2720:            let chat = self
2721:                .chat
2722:                .as_ref()
2723:                .expect("work-leaf controller command chat is present");
2724:            (
2725:                chat.project_dir().to_path_buf(),
2726:                chat.agent_profile().clone(),
2727:            )
2728:        };
2729:        let empty_baselines = BTreeMap::new();
2730:        let agent_baselines = if target_agent_id.is_some() {
2731:            &self.agent_review_baselines
2732:        } else {
2733:            &empty_baselines
2734:        };
2735:        let commits = GitHistory::new(project_dir)
2736:            .latest_agent_review_commits(&self.reviewed_agent_commits, agent_baselines)?;
2737:        if commits.is_empty() {
2738:            self.push_command_line("no agent commits found".to_string());
2739:            return Ok(Vec::new());
2740:        }
2741:
2742:        let mut reviewer_ids = Vec::new();
2743:        for commit in commits {
2744:            if target_agent_id.is_some_and(|agent_id| &commit.agent_id != agent_id) {
2745:                continue;
2746:            }
2747:            if self
2748:                .reviewed_agent_commits
2749:                .get(&commit.agent_id)
2750:                .is_some_and(|hash| hash == &commit.hash)
2751:                || self
2752:                    .review_commits_in_progress
2753:                    .get(&commit.agent_id)
2754:                    .is_some_and(|hash| hash == &commit.hash)
2755:            {
2756:                continue;
2757:            }
2758:            let reviewer_id = AgentId::new(format!("review-{}", commit.agent_id.as_str()))
2759:                .map_err(CliError::Agent)?;
2760:            let reviewer_busy = self
2761:                .sessions
2762:                .get(&reviewer_id)
2763:                .and_then(|session| session.loading)
2764:                .is_some();
2765:            if reviewer_busy {
2766:                continue;
2767:            }
2768:            let session_exists = self.sessions.contains_key(&reviewer_id);
2769:            let reuse_reviewer = self.reviewers.contains(&reviewer_id);
2770:            if session_exists {
2771:                self.set_session_loading(&reviewer_id, Some(WorkLeafLoading::WaitingForReply));
2772:            } else {
2773:                self.add_session(WorkLeafSession {
2774:                    id: reviewer_id.clone(),
2775:                    kind: agent_profile.kind.clone(),
2776:                    title: format!("review {}", commit.feature),
2777:                    feature: format!("review {}", commit.feature),
2778:                    lines: Vec::new(),
2779:                    loading: Some(WorkLeafLoading::WaitingForReply),
2780:                });
2781:            }
2782:            if reviewer_ids.is_empty() {
2783:                self.pending_events.push(WorkLeafEvent::AgentSelected {
2784:                    agent_id: reviewer_id.clone(),
2785:                });
2786:            }
2787:            self.review_commits_in_progress
2788:                .insert(commit.agent_id.clone(), commit.hash.clone());
2789:            self.start_review_worker(commit, reviewer_id.clone(), reuse_reviewer);
2790:            reviewer_ids.push(reviewer_id);
2791:        }
2792:        Ok(reviewer_ids)
2793:    }
2794:
2795:    pub fn start_linearize(&mut self) -> Result<Option<AgentId>, CliError> {
2796:        let launch = {
2797:            let chat = self
2798:                .chat
2799:                .as_mut()
2800:                .expect("work-leaf controller command chat is present");
2801:            chat.prepare_linearize_launch()?
2802:        };
2803:        let Some(launch) = launch else {
2804:            self.push_command_line("no reviewed agent commits found".to_string());
2805:            return Ok(None);
2806:        };
2807:
2808:        let agent_id = launch.id.clone();
2809:        let title = launch.feature.clone();
2810:        self.register_agent_feature(agent_id.clone(), title.clone());
2811:        self.add_session(WorkLeafSession {
2812:            id: agent_id.clone(),
2813:            kind: launch.kind.clone(),
2814:            title: title.clone(),
2815:            feature: title,
2816:            lines: Vec::new(),
2817:            loading: Some(WorkLeafLoading::Launching),
2818:        });
2819:        self.pending_events.push(WorkLeafEvent::AgentSelected {
2820:            agent_id: agent_id.clone(),
2821:        });
2822:        self.start_launch_worker(launch);
2823:        Ok(Some(agent_id))
2824:    }
2825:
2826:    pub fn loading_text(&self, loading: WorkLeafLoading) -> String {
2827:        match loading {
2828:            WorkLeafLoading::Launching => {
2829:                format!("Starting {} session", self.agent_display_name())
2830:            }
2831:            WorkLeafLoading::WaitingForReply => {
2832:                format!("Waiting for {}", self.agent_display_name())
2833:            }
2834:        }
2835:    }
2836:
2837:    pub fn shutdown(&mut self) {
2838:        self.shutdown.shutdown();
2839:    }
2840:
2841:    fn poll_worker(&mut self) {
2842:        let mut events = Vec::new();
2843:        for worker in &self.workers {
2844:            while let Ok(event) = worker.receiver.try_recv() {
2845:                events.push(event);
2846:            }
2847:        }
2848:        for event in events {
2849:            self.apply_worker_event(event);
2850:        }
2851:
2852:        let mut index = 0;
2853:        while index < self.workers.len() {
2854:            if self.workers[index].handle.is_finished() {
2855:                let worker = self.workers.swap_remove(index);
2856:                while let Ok(event) = worker.receiver.try_recv() {
2857:                    self.apply_worker_event(event);
2858:                }
2859:                worker
2860:                    .handle
2861:                    .join()
2862:                    .expect("work-leaf worker did not panic");
2863:            } else {
2864:                index += 1;
2865:            }
2866:        }
2867:    }
2868:
2869:    fn session_contains(&self, agent_id: &AgentId, needle: &str) -> bool {
2870:        self.sessions
2871:            .get(agent_id)
2872:            .is_some_and(|session| session.lines.iter().any(|line| line.contains(needle)))
2873:    }
2874:
2875:    fn reserve_launch_title_prompt(
2876:        &mut self,
2877:        launch: &AgentLaunch,
2878:        title_pending: bool,
2879:    ) -> Option<String> {
2880:        if title_pending {
2881:            None
2882:        } else {
2883:            self.title_agent.mark_named(&launch.id);
2884:            Some(launch.prompt.clone())
2885:        }
2886:    }
