4474:fn controller_does_not_run_project_required_checks_after_agent_reply() {
4475:    let root = git_repo("workspace-no-required-check-run");
4476:    fs::write(
4477:        root.join("AGENTS.md"),
4478:        "## Required Checks\n- `sh check.sh`\n",
4479:    )
4480:    .unwrap();
4481:    fs::write(
4482:        root.join("check.sh"),
4483:        "#!/bin/sh\necho state is bad\nexit 1\n",
4484:    )
4485:    .unwrap();
4486:    fs::write(root.join("state.txt"), "bad\n").unwrap();
4487:    git(&root, ["add", "."]);
4488:    git(&root, ["commit", "-m", "ADD project instruction fixture"]);
4489:    let backend = FakeBackend::new(["launch reply"]);
4490:    let chat = CommandChat::new(root.clone(), backend.clone());
4491:    let mut controller = WorkLeafController::new(chat);
4492:
4493:    let agent_id = controller.create_agent("inspect required checks").unwrap();
4494:
4495:    assert!(controller.wait_for_idle(Duration::from_secs(2)));
4496:    assert_eq!(fs::read_to_string(root.join("state.txt")).unwrap(), "bad\n");
4497:    let snapshot = controller.snapshot();
4498:    let session = snapshot.session(&agent_id).expect("session exists");
4499:    assert_eq!(session.loading, None);
4500:    assert!(
4501:        !session
4502:            .lines
4503:            .iter()
4504:            .any(|line| line.contains("required check failed"))
4505:    );
4506:    assert!(backend.sends().is_empty());
4507:}
