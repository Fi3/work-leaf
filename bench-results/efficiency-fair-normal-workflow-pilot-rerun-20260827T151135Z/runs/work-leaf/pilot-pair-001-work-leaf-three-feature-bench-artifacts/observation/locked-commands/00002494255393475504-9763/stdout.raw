4324:fn controller_auto_review_ignores_historical_agents_outside_current_patch_agent() {
4325:    let root = git_repo("workspace-auto-review-current-agent-only");
4326:    fs::write(root.join("README.md"), "before\n").unwrap();
4327:    git(&root, ["add", "README.md"]);
4328:    git(&root, ["commit", "-m", "ADD initial readme fixture"]);
4329:    for old_agent in ["user-2", "user-3"] {
4330:        fs::write(
4331:            root.join("README.md"),
4332:            format!("historical commit from {old_agent}\n"),
4333:        )
4334:        .unwrap();
4335:        git(&root, ["add", "README.md"]);
4336:        git(
4337:            &root,
4338:            [
4339:                "commit",
4340:                "-m",
4341:                "UPDATE apply historical patch",
4342:                "-m",
4343:                &format!(
4344:                    "Agent-ID: {old_agent}\nFeature: historical\nReason: previous work\nContext: old patch"
4345:                ),
4346:            ],
4347:        );
4348:    }
4349:    fs::write(root.join("README.md"), "before\n").unwrap();
4350:    git(&root, ["add", "README.md"]);
4351:    git(&root, ["commit", "-m", "UPDATE reset live fixture"]);
4352:    let backend = FakeBackend::new([
4353:        "live patch\n@work-leaf patch update readme\n--- a/README.md\n+++ b/README.md\n@@ -1 +1 @@\n-before\n+after\n@work-leaf end\n@work-leaf done",
4354:        "summary: live README change",
4355:        "NO_FINDINGS",
4356:    ]);
4357:    let chat = CommandChat::new(root, backend.clone()).with_max_review_rounds(4);
4358:    let mut controller = WorkLeafController::new(chat);
4359:
4360:    let agent_id = controller.create_agent("update readme").unwrap();
4361:    assert_eq!(agent_id.as_str(), "user-1");
4362:    assert!(controller.wait_for_idle(Duration::from_secs(2)));
4363:
4364:    let launches = backend.launches();
4365:    assert_eq!(
4366:        launches
4367:            .iter()
4368:            .filter(|launch| launch.id.as_str().starts_with("review-"))
4369:            .map(|launch| launch.id.as_str().to_string())
4370:            .collect::<Vec<_>>(),
4371:        vec!["review-user-1".to_string()]
4372:    );
4373:}
