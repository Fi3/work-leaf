4376:fn controller_linearize_uses_only_commits_reviewed_in_this_session() {
4377:    let root = git_repo("workspace-linearize-current-reviewed-only");
4378:    fs::write(root.join("README.md"), "before\n").unwrap();
4379:    fs::write(root.join("legacy.txt"), "legacy before\n").unwrap();
4380:    git(&root, ["add", "."]);
4381:    git(&root, ["commit", "-m", "ADD initial linearize fixture"]);
4382:    fs::write(root.join("legacy.txt"), "legacy after\n").unwrap();
4383:    git(&root, ["add", "legacy.txt"]);
4384:    git(
4385:        &root,
4386:        [
4387:            "commit",
4388:            "-m",
4389:            "UPDATE apply legacy patch from user-2",
4390:            "-m",
4391:            "Agent-ID: user-2\nFeature: legacy\nReason: old run\nContext: old session",
4392:        ],
4393:    );
4394:    let backend = FakeBackend::new([
4395:        "live patch\n@work-leaf patch update readme\n--- a/README.md\n+++ b/README.md\n@@ -1 +1 @@\n-before\n+after\n@work-leaf end\n@work-leaf done",
4396:        "summary: live README change",
4397:        "NO_FINDINGS",
4398:        "linearizer ready",
4399:    ]);
4400:    let chat = CommandChat::new(root, backend.clone()).with_max_review_rounds(4);
4401:    let mut controller = WorkLeafController::new(chat);
4402:
4403:    let agent_id = controller.create_agent("update readme").unwrap();
4404:    assert_eq!(agent_id.as_str(), "user-1");
4405:    assert!(controller.wait_for_idle(Duration::from_secs(2)));
4406:    assert!(controller.start_linearize().unwrap().is_some());
4407:    assert!(controller.wait_for_idle(Duration::from_secs(2)));
4408:
4409:    let launches = backend.launches();
4410:    let linearize_launch = launches
4411:        .iter()
4412:        .find(|launch| launch.id.as_str() == "linearize")
4413:        .expect("linearize agent launched");
4414:    assert!(linearize_launch.prompt.contains("Agent-ID: user-1"));
4415:    assert!(linearize_launch.prompt.contains("Commit:"));
4416:    assert!(!linearize_launch.prompt.contains("Agent-ID: user-2"));
4417:    assert!(!linearize_launch.prompt.contains("old session"));
4418:}
