4421:fn controller_linearize_keeps_multiple_reviewed_commits_from_same_agent() {
4422:    let root = git_repo("workspace-linearize-same-agent-multiple-reviewed");
4423:    fs::write(root.join("README.md"), "before\n").unwrap();
4424:    git(&root, ["add", "README.md"]);
4425:    git(&root, ["commit", "-m", "ADD initial readme fixture"]);
4426:    let backend = FakeBackend::new([
4427:        "first patch\n@work-leaf patch update readme once\n--- a/README.md\n+++ b/README.md\n@@ -1 +1 @@\n-before\n+after first\n@work-leaf end\n@work-leaf done",
4428:        "summary: first reviewed change",
4429:        "NO_FINDINGS",
4430:        "second patch\n@work-leaf patch update readme twice\n--- a/README.md\n+++ b/README.md\n@@ -1 +1 @@\n-after first\n+after second\n@work-leaf end\n@work-leaf done",
4431:        "summary: second reviewed change",
4432:        "NO_FINDINGS",
4433:        "linearizer ready",
4434:    ]);
4435:    let chat = CommandChat::new(root, backend.clone()).with_max_review_rounds(4);
4436:    let mut controller = WorkLeafController::new(chat);
4437:
4438:    let agent_id = controller.create_agent("update readme").unwrap();
4439:    assert_eq!(agent_id.as_str(), "user-1");
4440:    assert!(controller.wait_for_idle(Duration::from_secs(2)));
4441:    controller
4442:        .send_message(&agent_id, "make a second reviewed update")
4443:        .unwrap();
4444:    assert!(controller.wait_for_idle(Duration::from_secs(2)));
4445:    assert!(controller.start_linearize().unwrap().is_some());
4446:    assert!(controller.wait_for_idle(Duration::from_secs(2)));
4447:
4448:    let launches = backend.launches();
4449:    let linearize_launch = launches
4450:        .iter()
4451:        .find(|launch| launch.id.as_str() == "linearize")
4452:        .expect("linearize agent launched");
4453:    assert!(
4454:        linearize_launch
4455:            .prompt
4456:            .contains("Reason: update readme once"),
4457:        "{}",
4458:        linearize_launch.prompt
4459:    );
4460:    assert!(
4461:        linearize_launch
4462:            .prompt
4463:            .contains("Reason: update readme twice"),
4464:        "{}",
4465:        linearize_launch.prompt
4466:    );
4467:    assert_eq!(
4468:        linearize_launch.prompt.matches("Agent-ID: user-1").count(),
4469:        2
4470:    );
4471:}
