3900:fn scripted_harness_new_commands_select_new_agent_chat() {
3901:    let mut harness = UiHarness::new(80, 24);
3902:
3903:    harness.handle_bytes(b":new ui automation\n");
3904:
3905:    assert_eq!(
3906:        harness.ui().selected_agent().map(|id| id.as_str()),
3907:        Some("user-3")
3908:    );
3909:    assert_eq!(harness.ui().focus(), PaneFocus::Right);
3910:    assert_eq!(harness.ui().mode(), UiMode::Insert);
3911:    assert!(
3912:        harness
3913:            .transcript()
3914:            .iter()
3915:            .any(|line| line.contains("agent user-3 launched for: ui automation"))
3916:    );
3917:    assert!(harness.render_frame().contains("user-3"));
3918:
3919:    harness.handle_bytes(b"\x1b:new\n");
3920:
3921:    assert_eq!(
3922:        harness.ui().selected_agent().map(|id| id.as_str()),
3923:        Some("user-4")
3924:    );
3925:    assert_eq!(harness.ui().focus(), PaneFocus::Right);
3926:    assert_eq!(harness.ui().mode(), UiMode::Insert);
3927:}
