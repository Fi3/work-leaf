4182:
4183:fn strip_ansi(input: &str) -> String {
4184:    let mut output = String::new();
4185:    let mut chars = input.chars();
4186:    while let Some(ch) = chars.next() {
4187:        if ch == '\u{1b}' {
4188:            for next in chars.by_ref() {
4189:                if next.is_ascii_alphabetic() {
4190:                    break;
4191:                }
4192:            }
4193:        } else {
4194:            output.push(ch);
4195:        }
4196:    }
4197:    output
4198:}
