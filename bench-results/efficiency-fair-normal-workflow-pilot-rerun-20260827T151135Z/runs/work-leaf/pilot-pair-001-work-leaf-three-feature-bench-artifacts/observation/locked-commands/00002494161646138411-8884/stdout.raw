3668:#[test]
3669:fn scripted_harness_rings_and_highlights_ready_chat() {
3670:    let mut harness = UiHarness::new(100, 24);
3671:
3672:    assert!(!harness.render_frame().starts_with('\u{7}'));
3673:
3674:    harness
3675:        .mark_agent_ready("user-2")
3676:        .expect("fixture user-2 agent is registered");
3677:
3678:    let ready_frame = harness.render_frame();
3679:    assert!(ready_frame.starts_with('\u{7}'));
3680:    assert!(ready_frame.contains("\u{1b}[7m test user-2 READY\u{1b}[0m"));
3681:    assert!(!harness.render_frame().starts_with('\u{7}'));
3682:}
