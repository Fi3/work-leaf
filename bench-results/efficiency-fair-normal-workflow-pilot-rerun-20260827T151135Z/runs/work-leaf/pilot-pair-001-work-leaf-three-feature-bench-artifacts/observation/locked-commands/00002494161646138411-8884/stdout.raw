3783:#[test]
3784:fn scripted_harness_drives_ctrl_w_navigation_and_left_toggle() {
3785:    let mut harness = UiHarness::new(80, 24);
3786:
3787:    harness.handle_bytes(&[23, b'l']);
3788:    assert_eq!(harness.ui().focus(), PaneFocus::Right);
3789:    assert!(harness.render_frame().ends_with("\u{1b}[5;24H"));
3790:
3791:    harness.handle_bytes(&[23, b'h']);
3792:    assert_eq!(harness.ui().focus(), PaneFocus::Left);
3793:    assert!(harness.render_frame().ends_with("\u{1b}[3;2H"));
3794:
3795:    harness.handle_byte(b',');
3796:    assert_eq!(harness.ui().layout().left_width, 0);
3797:    assert_eq!(harness.ui().layout().right_width, 80);
3798:    assert!(harness.ui().layout().right_surface.is_some());
3799:    assert_eq!(harness.ui().focus(), PaneFocus::Right);
3800:
3801:    harness.handle_byte(b',');
3802:    assert_eq!(harness.ui().layout().left_width, 16);
3803:    assert_eq!(harness.ui().focus(), PaneFocus::Left);
3804:    harness.handle_bytes(&[23, b'j']);
3805:    assert_eq!(harness.ui().focus(), PaneFocus::Right);
3806:
3807:    harness.handle_bytes(&[23, b'k']);
3808:    assert_eq!(harness.ui().focus(), PaneFocus::Left);
3809:}
