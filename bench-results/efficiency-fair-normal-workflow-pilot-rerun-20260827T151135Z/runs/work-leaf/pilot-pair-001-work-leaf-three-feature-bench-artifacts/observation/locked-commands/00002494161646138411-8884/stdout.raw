3929:#[test]
3930:fn scripted_harness_names_new_chat_from_first_inserted_prompt() {
3931:    let mut harness = UiHarness::new(80, 24);
3932:
3933:    harness.handle_bytes(b":new\n");
3934:    assert!(
3935:        harness
3936:            .ui()
3937:            .render_left_pane()
3938:            .contains(">harness-agent user-3  working: harness-agent")
3939:    );
3940:
3941:    harness.handle_bytes(b"please fix the OAuth redirect handler\n");
3942:
3943:    let named_left_pane = harness.ui().render_left_pane();
3944:    assert!(named_left_pane.contains(
3945:        ">please-fix-the-oauth-redirect-handler user-3  working: please-fix-the-oauth-redirect-handler"
3946:    ));
3947:    assert!(!named_left_pane.contains("harness-agent user-3"));
3948:
3949:    harness.handle_bytes(b"add cookie coverage\n");
3950:
3951:    let unchanged_left_pane = harness.ui().render_left_pane();
3952:    assert!(unchanged_left_pane.contains(
3953:        ">please-fix-the-oauth-redirect-handler user-3  working: please-fix-the-oauth-redirect-handler"
3954:    ));
3955:    assert!(!unchanged_left_pane.contains("add-cookie-coverage user-3"));
3956:}
