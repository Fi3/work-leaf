3650:#[test]
3651:fn scripted_harness_renders_full_width_crlf_frame() {
3652:    let harness = UiHarness::new(80, 24);
3653:    let rendered = harness.render_frame();
3654:    let lines = rendered.split("\r\n").collect::<Vec<_>>();
3655:
3656:    assert!(rendered.starts_with("\u{1b}[H"));
3657:    assert!(!rendered.contains("\u{1b}[2J"));
3658:    assert!(rendered.contains("UI harness"));
3659:    assert!(rendered.contains("user-1"));
3660:    assert_eq!(lines.len(), 24);
3661:    assert!(
3662:        lines
3663:            .iter()
3664:            .all(|line| strip_ansi(line).chars().count() == 80)
3665:    );
3666:}
