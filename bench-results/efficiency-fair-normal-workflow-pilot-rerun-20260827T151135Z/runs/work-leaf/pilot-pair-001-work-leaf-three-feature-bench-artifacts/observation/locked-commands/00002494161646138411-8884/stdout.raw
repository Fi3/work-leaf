3684:#[test]
3685:fn scripted_harness_switches_modes_without_enter() {
3686:    let mut harness = UiHarness::new(80, 24);
3687:
3688:    harness.handle_byte(b'i');
3689:    assert_eq!(harness.ui().mode(), UiMode::Insert);
3690:
3691:    harness.handle_byte(27);
3692:    assert_eq!(harness.ui().mode(), UiMode::Command);
3693:
3694:    harness.handle_byte(b':');
3695:    assert_eq!(harness.ui().mode(), UiMode::Prompt);
3696:    assert!(harness.render_frame().ends_with("\u{1b}[24;2H"));
3697:
3698:    harness.handle_byte(b'n');
3699:    assert_eq!(harness.ui().mode(), UiMode::Prompt);
3700:    assert!(harness.render_frame().ends_with("\u{1b}[24;3H"));
3701:}
