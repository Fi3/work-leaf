+    fn left_control_row_index(&self) -> usize {
+        if self.control_selected == 0 {
+            return 0;
+        }
+
+        let Some(selected_agent_index) = self.control_selected_agent_index() else {
+            return 0;
+        };
+        let mut row = 1;
+        for agent_index in self.visible_agent_indices() {
+            if agent_index == selected_agent_index {
+                return row;
+            }
+
+            let agent = &self.agents[agent_index];
+            row += 1;
+            if !agent.modified_files.is_empty() {
+                row += 1;
+            }
+            for linked_agents in [
+                &agent.conflicting_agents,
+                &agent.depends_on,
+                &agent.depended_on_by,
+            ] {
+                if !linked_agents.is_empty() {
+                    row += 1;
+                }
+            }
+        }
+
+        self.left_pane_rows(1).len().saturating_sub(1)
+    }
