+    fn append_feature_state_line(&mut self, agent_id: &AgentId, line: &str) {
+        let line = self.unique_agent_line(agent_id, line);
+        self.append_agent_line(agent_id, line);
+    }
+
+    fn unique_agent_line(&self, agent_id: &AgentId, line: &str) -> String {
+        let Some(session) = self.sessions.get(agent_id) else {
+            return line.to_string();
+        };
+        let suffixed_prefix = format!("{line} (");
+        let matching_lines = session
+            .lines
+            .iter()
+            .filter(|existing| existing.as_str() == line || existing.starts_with(&suffixed_prefix))
+            .count();
+        if matching_lines == 0 {
+            line.to_string()
+        } else {
+            format!("{line} ({})", matching_lines + 1)
+        }
+    }
