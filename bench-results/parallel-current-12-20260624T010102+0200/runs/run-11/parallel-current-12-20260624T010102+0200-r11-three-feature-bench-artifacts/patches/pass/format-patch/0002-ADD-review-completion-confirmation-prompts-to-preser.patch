 impl WorkLeafSession {
+    pub(crate) fn needs_feature_done_confirmation(&self) -> bool {
+        self.feature_completion_state() == FeatureCompletionState::NeedsConfirmation
+    }
+
+    fn feature_completion_state(&self) -> FeatureCompletionState {
+        let mut state = FeatureCompletionState::Open;
+        for line in &self.lines {
+            if line.starts_with(FEATURE_DONE_PROMPT) {
+                state = FeatureCompletionState::NeedsConfirmation;
+            } else if line.starts_with(FEATURE_DONE_CLOSED) {
+                state = FeatureCompletionState::Closed;
+            } else if line.starts_with(FEATURE_DONE_REOPENED)
+                || (state != FeatureCompletionState::Open && line.starts_with("user: "))
+            {
+                state = FeatureCompletionState::Open;
+            }
+        }
+        state
+    }
