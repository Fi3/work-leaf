+fn selected_agent_slash_command(message: &str) -> Option<&str> {
+    let message = message.trim();
+    let rest = message.strip_prefix('/')?;
+    rest.chars()
+        .next()
+        .is_some_and(|ch| !ch.is_whitespace())
+        .then_some(message)
+}
