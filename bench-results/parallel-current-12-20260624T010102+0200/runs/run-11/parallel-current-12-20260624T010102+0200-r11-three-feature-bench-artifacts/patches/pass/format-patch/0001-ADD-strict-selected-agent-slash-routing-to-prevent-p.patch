+    fn selected_agent_slash_commands_require_a_non_whitespace_token() {
+        assert_eq!(selected_agent_slash_command("/status"), Some("/status"));
+        assert_eq!(
+            selected_agent_slash_command("  /fork user-1  "),
+            Some("/fork user-1")
+        );
+        assert_eq!(selected_agent_slash_command("/"), None);
+        assert_eq!(selected_agent_slash_command("/ status"), None);
+        assert_eq!(selected_agent_slash_command("status"), None);
+    }
 }
