+#[test]
+fn terminal_app_fork_slash_command_from_chat_view_sends_agent_command() {
+    let backend = FakeBackend::new(["launch reply", "fork reply"]);
+    let chat = CommandChat::new(PathBuf::from("/repo"), backend);
+    let mut app = TerminalApp::new(chat, 100, 24);
+
+    app.handle_bytes(b":new fork command\n");
+    app.wait_for_idle(Duration::from_secs(1));
+    app.handle_bytes(b"\x1b/fork continue from here\n");
+    app.wait_for_idle(Duration::from_secs(1));
+
+    assert!(
+        app.render_frame()
+            .contains("user: /fork continue from here")
+    );
+    assert!(app.render_frame().contains("fork reply"));
+
+    let backend = app.into_chat().into_backend();
+    let sends = backend.sends();
+    let commands = backend.commands();
+    assert!(sends.is_empty());
+    assert_eq!(commands.len(), 1);
+    assert_eq!(commands[0].0.as_str(), "user-1");
+    assert_eq!(commands[0].1, "/fork continue from here");
 }
 
