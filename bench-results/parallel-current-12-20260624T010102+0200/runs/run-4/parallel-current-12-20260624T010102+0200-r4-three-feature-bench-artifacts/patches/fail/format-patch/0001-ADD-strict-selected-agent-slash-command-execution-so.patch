 src/cli.rs            | 145 ++++++++++++++++++++++++++++++++++++++++--
 src/codex.rs          |  71 ++++++++++++++++++++-
 tests/terminal_app.rs |  56 +++++++++++++++-
 5 files changed, 295 insertions(+), 14 deletions(-)

