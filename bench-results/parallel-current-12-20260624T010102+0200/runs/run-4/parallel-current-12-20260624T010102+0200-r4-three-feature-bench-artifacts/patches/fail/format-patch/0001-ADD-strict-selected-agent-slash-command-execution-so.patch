+fn selected_agent_backend_command(message: &str) -> Option<&str> {
+    let rest = message.strip_prefix('/')?;
+    if rest.is_empty() || rest.chars().next().is_some_and(char::is_whitespace) {
+        return None;
+    }
+    Some(message)
+}
