+fn session_ready_state(session: &WorkLeafSession) -> bool {
+    session.loading.is_none() && !session_feature_done_closed(session)
+}
+
+fn session_feature_done_closed(session: &WorkLeafSession) -> bool {
+    let Some(closed_at) = latest_line_index(session, FEATURE_DONE_CLOSED_LINE) else {
+        return false;
+    };
+    let reopened_at = [
+        FEATURE_DONE_PROMPT,
+        FEATURE_DONE_OPEN_LINE,
+        FEATURE_DONE_REOPENED_LINE,
+    ]
+    .iter()
+    .filter_map(|line| latest_line_index(session, line))
+    .max();
+    reopened_at.is_none_or(|index| closed_at > index)
+}
+
+fn latest_line_index(session: &WorkLeafSession, needle: &str) -> Option<usize> {
+    session.lines.iter().rposition(|line| line == needle)
+}
