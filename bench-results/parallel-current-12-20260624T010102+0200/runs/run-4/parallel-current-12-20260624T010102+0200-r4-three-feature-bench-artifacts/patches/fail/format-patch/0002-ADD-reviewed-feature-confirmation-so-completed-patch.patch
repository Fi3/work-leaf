+    fn handle_feature_done_confirmation(
+        &mut self,
+        agent_id: &AgentId,
+        message: &str,
+    ) -> FeatureDoneConfirmation {
+        if !self.feature_done_confirmation_pending.remove(agent_id) {
+            return FeatureDoneConfirmation::None;
+        }
+        self.feature_done_closed.remove(agent_id);
+
+        match feature_done_answer(message) {
+            Some(true) => {
+                self.append_agent_line_allow_duplicate(agent_id, format!("user: {message}"));
+                self.feature_done_closed.insert(agent_id.clone());
+                self.append_agent_line_allow_duplicate(
+                    agent_id,
+                    FEATURE_DONE_CLOSED_LINE.to_string(),
+                );
+                FeatureDoneConfirmation::Closed
+            }
+            Some(false) => {
+                self.append_agent_line_allow_duplicate(agent_id, format!("user: {message}"));
+                self.append_agent_line_allow_duplicate(
+                    agent_id,
+                    FEATURE_DONE_OPEN_LINE.to_string(),
+                );
+                FeatureDoneConfirmation::KeptOpen
+            }
+            None => {
+                self.append_agent_line_allow_duplicate(
+                    agent_id,
+                    FEATURE_DONE_REOPENED_LINE.to_string(),
+                );
+                FeatureDoneConfirmation::Reopened
+            }
+        }
+    }
