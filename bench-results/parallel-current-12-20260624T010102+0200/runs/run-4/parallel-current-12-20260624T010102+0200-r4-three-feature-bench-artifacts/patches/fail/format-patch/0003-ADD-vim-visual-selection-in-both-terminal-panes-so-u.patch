+    fn handle_visual_input(&mut self, input: TerminalAppInput) -> bool {
+        if self.ui.is_visual_mode() {
+            match input {
+                TerminalAppInput::Char('y') => {
+                    let right_content = self.right_content();
+                    self.ui.yank_visual_selection(&right_content, false);
+                }
+                TerminalAppInput::Char('Y') => {
+                    let right_content = self.right_content();
+                    self.ui.yank_visual_selection(&right_content, true);
+                }
+                TerminalAppInput::Key(key) => {
+                    let actions = self.ui.handle_key(key);
+                    self.record_actions(actions);
+                }
+                TerminalAppInput::Char(ch) => {
+                    let actions = self.ui.handle_key(UiKey::Char(ch));
+                    self.record_actions(actions);
+                }
+                TerminalAppInput::Backspace
+                | TerminalAppInput::Enter
+                | TerminalAppInput::LineBreak
+                | TerminalAppInput::PasteStart
+                | TerminalAppInput::PasteEnd => {}
+                TerminalAppInput::Interrupt | TerminalAppInput::Quit => return false,
+            }
+            return true;
+        }
+
+        if self.ui.mode() != UiMode::Command {
+            return false;
+        }
+
+        match input {
+            TerminalAppInput::Char('v') => {
+                let right_content = self.right_content();
+                self.ui.start_visual_character_selection(
+                    &right_content,
+                    Some(self.chat_cursor_column()),
+                );
+                true
+            }
+            TerminalAppInput::Char('V') => {
+                let right_content = self.right_content();
+                self.ui
+                    .start_visual_line_selection(&right_content, Some(self.chat_cursor_column()));
+                true
+            }
+            TerminalAppInput::Key(UiKey::Char('\u{16}')) => {
+                let right_content = self.right_content();
+                self.ui
+                    .start_visual_block_selection(&right_content, Some(self.chat_cursor_column()));
+                true
+            }
+            _ => false,
+        }
+    }
