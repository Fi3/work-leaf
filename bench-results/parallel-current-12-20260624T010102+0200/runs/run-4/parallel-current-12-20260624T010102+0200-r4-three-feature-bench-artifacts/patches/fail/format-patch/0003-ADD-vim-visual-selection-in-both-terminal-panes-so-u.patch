+fn styled_line(
+    text: &str,
+    selected_range: Option<(usize, usize)>,
+    base_style: Style,
+) -> Spans<'static> {
+    let Some((start, end)) = selected_range else {
+        return Spans::from(vec![Span::styled(text.to_string(), base_style)]);
+    };
+    let len = text.chars().count();
+    let start = start.min(len);
+    let end = end.min(len);
+    if start >= end {
+        return Spans::from(vec![Span::styled(text.to_string(), base_style)]);
+    }
+
+    let mut spans = Vec::new();
+    push_styled_slice(&mut spans, text, 0, start, base_style);
+    push_styled_slice(
+        &mut spans,
+        text,
+        start,
+        end,
+        Style::default().add_modifier(Modifier::REVERSED),
+    );
+    push_styled_slice(&mut spans, text, end, len, base_style);
+    Spans::from(spans)
+}
+
+fn push_styled_slice(
+    spans: &mut Vec<Span<'static>>,
+    text: &str,
+    start: usize,
+    end: usize,
+    style: Style,
+) {
+    if start >= end {
+        return;
+    }
+    spans.push(Span::styled(char_slice(text, start, end), style));
+}
+
+fn selected_text(lines: &[String], selection: &VisualSelection, force_linewise: bool) -> String {
+    if lines.is_empty() {
+        return String::new();
+    }
+
+    let (start_row, end_row) = ordered_rows(selection);
+    let start_row = start_row.min(lines.len().saturating_sub(1));
+    let end_row = end_row.min(lines.len().saturating_sub(1));
+    (start_row..=end_row)
+        .filter_map(|row| {
+            let line = &lines[row];
+            selection_range(selection, row, line.chars().count(), force_linewise)
+                .map(|(start, end)| char_slice(line, start, end))
+        })
+        .collect::<Vec<_>>()
+        .join("\n")
+}
+
+fn selection_range(
+    selection: &VisualSelection,
+    row: usize,
+    line_len: usize,
+    force_linewise: bool,
+) -> Option<(usize, usize)> {
+    let (start_row, end_row) = ordered_rows(selection);
+    if row < start_row || row > end_row {
+        return None;
+    }
+
+    if force_linewise || selection.kind == VisualSelectionKind::Line {
+        return Some((0, line_len));
+    }
+
+    match selection.kind {
+        VisualSelectionKind::Character => character_selection_range(selection, row, line_len),
+        VisualSelectionKind::Block => {
+            let start = selection
+                .anchor
+                .column
+                .min(selection.cursor.column)
+                .min(line_len);
+            let end = selection
+                .anchor
+                .column
+                .max(selection.cursor.column)
+                .saturating_add(1)
+                .min(line_len);
+            Some((start, end))
+        }
+        VisualSelectionKind::Line => Some((0, line_len)),
+    }
+}
+
+fn character_selection_range(
+    selection: &VisualSelection,
+    row: usize,
+    line_len: usize,
+) -> Option<(usize, usize)> {
+    let (start, end) = ordered_positions(selection);
+    if row < start.row || row > end.row {
+        return None;
+    }
+
+    if start.row == end.row {
+        return Some((
+            start.column.min(line_len),
+            end.column.saturating_add(1).min(line_len),
+        ));
+    }
+
+    if row == start.row {
+        Some((start.column.min(line_len), line_len))
+    } else if row == end.row {
+        Some((0, end.column.saturating_add(1).min(line_len)))
+    } else {
+        Some((0, line_len))
+    }
+}
+
+fn ordered_rows(selection: &VisualSelection) -> (usize, usize) {
+    (
+        selection.anchor.row.min(selection.cursor.row),
+        selection.anchor.row.max(selection.cursor.row),
+    )
+}
+
+fn ordered_positions(selection: &VisualSelection) -> (VisualPosition, VisualPosition) {
+    let anchor = selection.anchor;
+    let cursor = selection.cursor;
+    if (anchor.row, anchor.column) <= (cursor.row, cursor.column) {
+        (anchor, cursor)
+    } else {
+        (cursor, anchor)
+    }
+}
+
+fn char_slice(text: &str, start: usize, end: usize) -> String {
+    text.chars()
+        .skip(start)
+        .take(end.saturating_sub(start))
+        .collect()
+}
