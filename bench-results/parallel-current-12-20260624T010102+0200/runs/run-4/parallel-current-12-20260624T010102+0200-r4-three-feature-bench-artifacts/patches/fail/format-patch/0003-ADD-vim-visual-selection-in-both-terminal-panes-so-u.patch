+fn wrapped_display_lines(content: &str, width: u16) -> Vec<String> {
+    let width = usize::from(width.max(1));
+    if content.is_empty() {
+        return Vec::new();
+    }
+    content
+        .lines()
+        .flat_map(|line| wrapped_display_line(line, width))
+        .collect()
+}
+
+fn wrapped_display_line(line: &str, width: usize) -> Vec<String> {
+    if line.is_empty() {
+        return vec![String::new()];
+    }
+    let chars = line.chars().collect::<Vec<_>>();
+    chars
+        .chunks(width)
+        .map(|chunk| chunk.iter().collect())
+        .collect()
+}
+
+fn wrapped_cursor_position(
+    content: &str,
+    width: u16,
+    cursor_column: Option<usize>,
+) -> VisualPosition {
+    let width = usize::from(width.max(1));
+    let lines = content.lines().collect::<Vec<_>>();
+    let Some(line) = lines.last().copied() else {
+        return VisualPosition { row: 0, column: 0 };
+    };
+    let previous_rows = lines[..lines.len() - 1]
+        .iter()
+        .map(|line| display_row_count(line, width))
+        .sum::<usize>();
+    let line_chars = line.chars().count();
+    let cursor = cursor_column.unwrap_or(line_chars).min(line_chars);
+    VisualPosition {
+        row: previous_rows.saturating_add(cursor / width),
+        column: cursor % width,
+    }
+}
+
+fn display_row_count(line: &str, width: usize) -> usize {
+    if line.is_empty() {
+        1
+    } else {
+        line.chars().count().saturating_sub(1) / width + 1
+    }
+}
+
+fn apply_delta(value: usize, delta: isize, limit: usize) -> usize {
+    if delta.is_negative() {
+        value.saturating_sub(delta.unsigned_abs()).min(limit)
+    } else {
+        value.saturating_add(delta as usize).min(limit)
+    }
+}
