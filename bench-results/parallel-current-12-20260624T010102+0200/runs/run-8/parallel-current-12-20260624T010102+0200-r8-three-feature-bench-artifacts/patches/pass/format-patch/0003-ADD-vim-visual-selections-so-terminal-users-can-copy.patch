+    fn styled_line_spans(
+        &self,
+        pane: PaneFocus,
+        row: usize,
+        text: &str,
+        base_reversed: bool,
+    ) -> Spans<'static> {
+        let mut ranges = self.selection_ranges_for_line(pane, row, text);
+        ranges.sort_by_key(|range| range.start);
+        let chars = text.chars().collect::<Vec<_>>();
+        let mut spans = Vec::new();
+        let mut cursor = 0;
+
+        for range in ranges {
+            let start = range.start.min(chars.len());
+            let end = range.end.min(chars.len());
+            if cursor < start {
+                spans.push(styled_span(
+                    chars[cursor..start].iter().collect(),
+                    base_reversed,
+                ));
+            }
+            if start < end {
+                spans.push(styled_span(chars[start..end].iter().collect(), true));
+            }
+            cursor = end;
+        }
+
+        if cursor < chars.len() {
+            spans.push(styled_span(chars[cursor..].iter().collect(), base_reversed));
+        }
+        if spans.is_empty() {
+            spans.push(styled_span(String::new(), base_reversed));
+        }
+
+        Spans::from(spans)
+    }
