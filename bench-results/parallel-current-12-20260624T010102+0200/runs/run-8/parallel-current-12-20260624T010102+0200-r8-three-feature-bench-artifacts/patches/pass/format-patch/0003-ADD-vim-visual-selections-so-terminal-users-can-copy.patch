+fn character_selection_range(
+    selection: VisualSelection,
+    row: usize,
+    line_len: usize,
+) -> Option<Range<usize>> {
+    if line_len == 0 {
+        return None;
+    }
+
+    let (start_position, end_position) = ordered_selection_positions(selection);
+    if start_position.row == end_position.row {
+        let start = start_position.column;
+        let end = end_position.column;
+        return (start < line_len).then_some(start..end.min(line_len.saturating_sub(1)) + 1);
+    }
+
+    if row == start_position.row {
+        return Some(start_position.column.min(line_len.saturating_sub(1))..line_len);
+    }
+    if row == end_position.row {
+        return Some(0..end_position.column.min(line_len.saturating_sub(1)) + 1);
+    }
