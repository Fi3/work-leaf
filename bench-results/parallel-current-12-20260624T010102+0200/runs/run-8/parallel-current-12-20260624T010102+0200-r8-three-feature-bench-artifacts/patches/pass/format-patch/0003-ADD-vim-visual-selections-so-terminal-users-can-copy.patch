+fn selection_range_for_line(
+    selection: VisualSelection,
+    row: usize,
+    line_len: usize,
+) -> Option<Range<usize>> {
+    let start_row = selection.anchor.row.min(selection.cursor.row);
+    let end_row = selection.anchor.row.max(selection.cursor.row);
+    if row < start_row || row > end_row {
+        return None;
+    }
+
+    match selection.kind {
+        VisualKind::Character => character_selection_range(selection, row, line_len),
+        VisualKind::Line => Some(0..line_len),
+        VisualKind::Block => block_selection_range(selection, line_len),
+    }
