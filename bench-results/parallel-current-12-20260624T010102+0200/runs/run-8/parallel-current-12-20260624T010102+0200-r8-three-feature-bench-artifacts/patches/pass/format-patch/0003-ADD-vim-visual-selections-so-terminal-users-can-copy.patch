+    fn handle_visual_key(&mut self, key: UiKey) -> Vec<UiAction> {
+        match key {
+            UiKey::Char('h') | UiKey::Left => self.move_visual_cursor(0, -1),
+            UiKey::Char('l') | UiKey::Right => self.move_visual_cursor(0, 1),
+            UiKey::Char('k') | UiKey::Up => self.move_visual_cursor(-1, 0),
+            UiKey::Char('j') | UiKey::Down => self.move_visual_cursor(1, 0),
+            UiKey::Char('v') => self.set_visual_kind(VisualKind::Character),
+            UiKey::Char('V') => self.set_visual_kind(VisualKind::Line),
+            UiKey::Char(CTRL_V_CHAR) => self.set_visual_kind(VisualKind::Block),
+            UiKey::Char('y') => self.copy_visual_selection(),
+            UiKey::Char('Y') => {
+                self.set_visual_kind(VisualKind::Line);
+                self.copy_visual_selection();
+            }
+            _ => {}
+        }
+        Vec::new()
+    }
+
+    fn start_visual_selection(&mut self, kind: VisualKind) {
+        let pane = self.focus;
+        let lines = self.selectable_lines_for_pane(pane);
+        if lines.is_empty() {
+            return;
+        }
+        let position = self.initial_visual_position(pane, &lines);
+        self.visual_selection = Some(VisualSelection {
+            pane,
+            kind,
+            anchor: position,
+            cursor: position,
+        });
+        self.mode = UiMode::Command;
+        self.pending = None;
+    }
+
+    fn set_visual_kind(&mut self, kind: VisualKind) {
+        if let Some(selection) = self.visual_selection.as_mut() {
+            selection.kind = kind;
+        } else {
+            self.start_visual_selection(kind);
+        }
+    }
+
+    fn clear_visual_selection(&mut self) {
+        self.visual_selection = None;
+    }
+
+    fn move_visual_cursor(&mut self, row_delta: isize, column_delta: isize) {
+        let Some(selection) = self.visual_selection else {
+            return;
+        };
+        let lines = self.selectable_lines_for_pane(selection.pane);
+        if lines.is_empty() {
+            return;
+        }
+
+        let current = clamp_text_position(selection.cursor, &lines);
+        let row = offset_usize(current.row, row_delta).min(lines.len().saturating_sub(1));
+        let column =
+            offset_usize(current.column, column_delta).min(max_selectable_column(&lines[row]));
+
+        if let Some(selection) = self.visual_selection.as_mut() {
+            selection.cursor = TextPosition { row, column };
+        }
+    }
+
+    fn copy_visual_selection(&mut self) {
+        let Some(selection) = self.visual_selection else {
+            return;
+        };
+        let lines = self.selectable_lines_for_pane(selection.pane);
+        let copied = selected_text(selection, &lines);
+        self.store_clipboard(copied);
+        self.clear_visual_selection();
+    }
+
+    fn copy_current_line(&mut self) {
+        let pane = self.focus;
+        let lines = self.selectable_lines_for_pane(pane);
+        if lines.is_empty() {
+            return;
+        }
+        let position = self.initial_visual_position(pane, &lines);
+        let copied = lines.get(position.row).cloned().unwrap_or_default();
+        self.store_clipboard(copied);
+    }
+
+    fn store_clipboard(&mut self, text: String) {
