+    fn close_feature_chat(&mut self, agent_id: &AgentId) {
+        self.dismiss_current_feature_done_prompt(agent_id);
+        let _ = self.ui.set_agent_ready_state(agent_id, false);
+        let _ = self.ui.set_agent_hidden_state(agent_id, true);
+        self.reopen_feature_agent = Some(agent_id.clone());
+        self.ui.select_command_interface();
+    }
+
+    fn reopen_feature_chat(&mut self, agent_id: &AgentId) {
+        self.dismiss_current_feature_done_prompt(agent_id);
+        let _ = self.ui.set_agent_hidden_state(agent_id, false);
+        let _ = self.ui.set_agent_ready_state(agent_id, false);
+        let _ = self.ui.activate_agent_chat(agent_id);
+        if self
+            .reopen_feature_agent
+            .as_ref()
+            .is_some_and(|reopen_agent| reopen_agent == agent_id)
+        {
+            self.reopen_feature_agent = None;
+        }
+    }
+
+    fn has_pending_feature_done_prompt(&self, agent_id: &AgentId) -> bool {
+        self.snapshot
+            .session(agent_id)
+            .is_some_and(|session| self.session_has_pending_feature_done_prompt(session))
+    }
+
+    fn session_has_pending_feature_done_prompt(&self, session: &WorkLeafSession) -> bool {
+        if session.loading.is_some() {
+            return false;
+        }
+        self.feature_done_prompts.contains(&session.id)
+    }
+
+    fn dismiss_current_feature_done_prompt(&mut self, agent_id: &AgentId) {
+        self.feature_done_prompts.remove(agent_id);
+    }
+
+    fn observe_feature_done_prompt_line(&mut self, agent_id: &AgentId, line: &str) {
+        if self
+            .review_prompt_candidate
+            .as_ref()
+            .is_some_and(|candidate| candidate == agent_id)
+            && line.starts_with(FEATURE_DONE_PROMPT_PREFIX)
+        {
+            self.feature_done_prompts.insert(agent_id.clone());
+            self.last_review_completion_line = None;
+            self.review_prompt_candidate = None;
+            return;
+        }
+
+        if self
+            .last_review_completion_line
+            .as_ref()
+            .is_some_and(|review_line| line == format!("review: {review_line}"))
+        {
+            self.review_prompt_candidate = Some(agent_id.clone());
+            return;
+        }
+
+        if self
+            .review_prompt_candidate
+            .as_ref()
+            .is_some_and(|candidate| candidate == agent_id)
+        {
+            self.review_prompt_candidate = None;
+        }
+    }
+
+    fn seed_feature_done_prompts_from_snapshot(&mut self) {
+        let review_lines = self
+            .snapshot
+            .command_transcript
+            .iter()
+            .filter(|line| is_review_completion_line(line))
+            .cloned()
+            .collect::<Vec<_>>();
+        if review_lines.is_empty() {
+            return;
+        }
+
+        for session in &self.snapshot.sessions {
+            if session.loading.is_some() {
+                continue;
+            }
+            if session.lines.iter().any(|line| {
+                line.starts_with(FEATURE_DONE_PROMPT_PREFIX)
+                    && review_lines.iter().any(|review_line| {
+                        session
+                            .lines
+                            .iter()
+                            .any(|candidate| candidate == &format!("review: {review_line}"))
+                    })
+            }) {
+                self.feature_done_prompts.insert(session.id.clone());
+            }
+        }
     }
 
