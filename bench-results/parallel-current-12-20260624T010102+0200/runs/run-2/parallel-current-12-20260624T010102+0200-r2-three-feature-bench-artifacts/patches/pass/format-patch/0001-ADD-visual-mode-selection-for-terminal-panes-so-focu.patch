+fn display_rows(content: &str, width: u16) -> Vec<String> {
+    let width = usize::from(width.max(1));
+    if content.is_empty() {
+        return vec![String::new()];
+    }
+
+    let mut rows = Vec::new();
+    for line in content.lines() {
+        let chars = line.chars().collect::<Vec<_>>();
+        if chars.is_empty() {
+            rows.push(String::new());
+            continue;
+        }
+        for chunk in chars.chunks(width) {
+            rows.push(chunk.iter().collect());
+        }
+    }
+    rows
+}
+
+fn visual_line_width(line: &str, pane_width: usize) -> usize {
+    line.chars().count().min(pane_width).max(1)
+}
+
+fn selected_columns(
+    selection: &VisualSelection,
+    row: usize,
+    line: &str,
+    pane_width: usize,
+) -> Option<(usize, usize)> {
+    let (top, bottom) = if selection.anchor.row <= selection.cursor.row {
+        (selection.anchor, selection.cursor)
+    } else {
+        (selection.cursor, selection.anchor)
+    };
+    if row < top.row || row > bottom.row {
+        return None;
+    }
+
+    let line_width = visual_line_width(line, pane_width);
+    let range = match selection.kind {
+        VisualSelectionKind::Line => (0, line_width.saturating_sub(1)),
+        VisualSelectionKind::Block => {
+            let start = selection.anchor.column.min(selection.cursor.column);
+            let end = selection.anchor.column.max(selection.cursor.column);
+            (
+                start.min(line_width.saturating_sub(1)),
+                end.min(line_width.saturating_sub(1)),
+            )
+        }
+        VisualSelectionKind::Character if top.row == bottom.row => {
+            let start = top
+                .column
+                .min(bottom.column)
+                .min(line_width.saturating_sub(1));
+            let end = top
+                .column
+                .max(bottom.column)
+                .min(line_width.saturating_sub(1));
+            (start, end)
+        }
+        VisualSelectionKind::Character if row == top.row => (
+            top.column.min(line_width.saturating_sub(1)),
+            line_width.saturating_sub(1),
+        ),
+        VisualSelectionKind::Character if row == bottom.row => {
+            (0, bottom.column.min(line_width.saturating_sub(1)))
+        }
+        VisualSelectionKind::Character => (0, line_width.saturating_sub(1)),
+    };
+
+    (range.0 <= range.1).then_some(range)
+}
+
+fn selected_text(selection: &VisualSelection, lines: &[String], pane_width: usize) -> String {
+    let mut selected_lines = Vec::new();
+    for (row, line) in lines.iter().enumerate() {
+        let Some((start, end)) = selected_columns(selection, row, line, pane_width) else {
+            continue;
+        };
+        selected_lines.push(
+            line.chars()
+                .take(pane_width)
+                .skip(start)
+                .take(end.saturating_sub(start).saturating_add(1))
+                .collect::<String>(),
+        );
+    }
+    selected_lines.join("\n")
+}
+
+fn osc52_clipboard_sequence(text: &str) -> String {
+    format!("\u{1b}]52;c;{}\u{7}", base64_encode(text.as_bytes()))
+}
+
+fn base64_encode(bytes: &[u8]) -> String {
+    const TABLE: &[u8; 64] = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    let mut encoded = String::with_capacity(bytes.len().div_ceil(3) * 4);
+    for chunk in bytes.chunks(3) {
+        let first = chunk[0];
+        let second = *chunk.get(1).unwrap_or(&0);
+        let third = *chunk.get(2).unwrap_or(&0);
+        encoded.push(TABLE[usize::from(first >> 2)] as char);
+        encoded.push(TABLE[usize::from(((first & 0b0000_0011) << 4) | (second >> 4))] as char);
+        if chunk.len() > 1 {
+            encoded.push(TABLE[usize::from(((second & 0b0000_1111) << 2) | (third >> 6))] as char);
+        } else {
+            encoded.push('=');
+        }
+        if chunk.len() > 2 {
+            encoded.push(TABLE[usize::from(third & 0b0011_1111)] as char);
+        } else {
+            encoded.push('=');
+        }
+    }
+    encoded
+}
