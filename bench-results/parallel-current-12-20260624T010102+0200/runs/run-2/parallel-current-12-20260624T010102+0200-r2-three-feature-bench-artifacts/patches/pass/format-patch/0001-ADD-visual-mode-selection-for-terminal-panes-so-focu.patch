+    fn apply_visual_selection(&self, buffer: &mut Buffer, right_content: &str) {
+        let Some(selection) = &self.visual_selection else {
+            return;
+        };
+        let Some((origin_x, origin_y, width, height, lines)) =
+            self.visual_pane_display(selection.pane, right_content)
+        else {
+            return;
+        };
+
+        let width = usize::from(width);
+        let height = usize::from(height);
+        for row in 0..height {
+            let Some(line) = lines.get(row) else {
+                continue;
+            };
+            let Some((start, end)) = selected_columns(selection, row, line, width) else {
+                continue;
+            };
+            let row_y = origin_y.saturating_add(row.min(usize::from(u16::MAX)) as u16);
+            for column in start..=end {
+                if column >= width {
+                    break;
+                }
+                let column_x = origin_x.saturating_add(column.min(usize::from(u16::MAX)) as u16);
+                buffer
+                    .get_mut(column_x, row_y)
+                    .modifier
+                    .insert(Modifier::REVERSED);
+            }
+        }
+    }
+
+    fn visual_pane_display(
+        &self,
+        pane: PaneFocus,
+        visible_right_content: &str,
+    ) -> Option<(u16, u16, u16, u16, Vec<String>)> {
+        let layout = self.layout();
+        let body_height = self.height.saturating_sub(1);
+        let inner_height = body_height.saturating_sub(2).max(1);
+        match pane {
+            PaneFocus::Left if layout.left_width > 0 => {
+                let inner_width = layout.left_width.saturating_sub(2).max(1);
+                let rows = self
+                    .left_pane_rows(usize::from(inner_width))
+                    .into_iter()
+                    .map(|row| row.text)
+                    .collect::<Vec<_>>();
+                Some((1, 1, inner_width, inner_height, rows))
+            }
+            PaneFocus::Left => None,
+            PaneFocus::Right => {
+                let inner_width = layout.right_width.saturating_sub(2).max(1);
+                let origin_x = if layout.left_width > 0 {
+                    layout.left_width.saturating_add(1)
+                } else {
+                    1
+                };
+                Some((
+                    origin_x,
+                    1,
+                    inner_width,
+                    inner_height,
+                    display_rows(visible_right_content, inner_width),
+                ))
+            }
+        }
+    }
+
+    fn handle_visual_key(&mut self, key: UiKey) -> Vec<UiAction> {
+        match key {
+            UiKey::Esc => {
+                self.visual_selection = None;
+                self.mode = UiMode::Command;
+            }
+            UiKey::Char('v') => self.switch_visual_selection(VisualSelectionKind::Character),
+            UiKey::Char('V') => self.switch_visual_selection(VisualSelectionKind::Line),
+            UiKey::CtrlV => self.switch_visual_selection(VisualSelectionKind::Block),
+            UiKey::Char('y') => {
+                self.copy_visual_selection(false);
+                self.visual_selection = None;
+            }
+            UiKey::Char('Y') => {
+                self.copy_visual_selection(true);
+                self.visual_selection = None;
+            }
+            UiKey::Char('h') | UiKey::Left => self.move_visual_cursor(0, -1),
+            UiKey::Char('j') | UiKey::Down => self.move_visual_cursor(1, 0),
+            UiKey::Char('k') | UiKey::Up => self.move_visual_cursor(-1, 0),
+            UiKey::Char('l') | UiKey::Right => self.move_visual_cursor(0, 1),
+            _ => {}
+        }
+        Vec::new()
+    }
+
+    fn start_visual_selection(&mut self, kind: VisualSelectionKind) {
+        let pane = self.focus;
+        let position = self.visual_start_position(pane);
+        self.visual_selection = Some(VisualSelection {
+            pane,
+            kind,
+            anchor: position,
+            cursor: position,
+        });
+    }
+
+    fn switch_visual_selection(&mut self, kind: VisualSelectionKind) {
+        if let Some(selection) = self.visual_selection.as_mut() {
+            selection.kind = kind;
+        } else {
+            self.start_visual_selection(kind);
+        }
+    }
+
+    fn visual_start_position(&self, pane: PaneFocus) -> VisualPosition {
+        match pane {
+            PaneFocus::Left => {
+                let max_row = self
+                    .visual_lines_for_pane(PaneFocus::Left)
+                    .0
+                    .len()
+                    .saturating_sub(1);
+                VisualPosition {
+                    row: self.control_selected.min(max_row),
+                    column: 0,
+                }
+            }
+            PaneFocus::Right => {
+                let rows = self.visual_lines_for_pane(PaneFocus::Right).0;
+                VisualPosition {
+                    row: rows.len().saturating_sub(1),
+                    column: 0,
+                }
+            }
+        }
+    }
+
+    fn move_visual_cursor(&mut self, row_delta: isize, column_delta: isize) {
+        let Some(mut selection) = self.visual_selection.take() else {
+            return;
+        };
+        let (lines, width) = self.visual_lines_for_pane(selection.pane);
+        let max_row = lines.len().saturating_sub(1);
+        selection.cursor.row = add_delta(selection.cursor.row, row_delta).min(max_row);
+        let line_width = visual_line_width(
+            lines
+                .get(selection.cursor.row)
+                .map(String::as_str)
+                .unwrap_or(""),
+            width,
+        );
+        selection.cursor.column =
+            add_delta(selection.cursor.column, column_delta).min(line_width.saturating_sub(1));
+        self.visual_selection = Some(selection);
+    }
+
+    fn visual_lines_for_pane(&self, pane: PaneFocus) -> (Vec<String>, usize) {
+        match pane {
+            PaneFocus::Left => {
+                let width = usize::from(self.layout().left_width.saturating_sub(2).max(1));
+                let lines = self
+                    .left_pane_rows(width)
+                    .into_iter()
+                    .map(|row| row.text)
+                    .collect::<Vec<_>>();
+                (ensure_display_lines(lines), width)
+            }
+            PaneFocus::Right => {
+                let (width, _) = self.right_inner_size();
+                (self.last_right_rows.borrow().clone(), usize::from(width))
+            }
+        }
+    }
+
+    fn copy_visual_selection(&mut self, linewise: bool) {
+        let Some(mut selection) = self.visual_selection.clone() else {
+            return;
+        };
+        if linewise && selection.kind != VisualSelectionKind::Block {
+            selection.kind = VisualSelectionKind::Line;
+        }
+        self.copy_selection(&selection);
+    }
+
+    fn copy_focused_line(&mut self) {
+        let position = self.visual_start_position(self.focus);
+        let selection = VisualSelection {
+            pane: self.focus,
+            kind: VisualSelectionKind::Line,
+            anchor: position,
+            cursor: position,
+        };
+        self.copy_selection(&selection);
+    }
+
+    fn copy_selection(&mut self, selection: &VisualSelection) {
+        let (lines, width) = self.visual_lines_for_pane(selection.pane);
+        let text = selected_text(selection, &lines, width);
+        if text.is_empty() {
+            self.show_status_notice(
+                EMPTY_SELECTION_NOTICE,
+                Duration::from_secs(STATUS_NOTICE_SECONDS),
+            );
+            return;
+        }
+        self.pending_clipboard.replace(Some(text));
+        self.show_status_notice(CLIPBOARD_NOTICE, Duration::from_secs(STATUS_NOTICE_SECONDS));
+    }
+
