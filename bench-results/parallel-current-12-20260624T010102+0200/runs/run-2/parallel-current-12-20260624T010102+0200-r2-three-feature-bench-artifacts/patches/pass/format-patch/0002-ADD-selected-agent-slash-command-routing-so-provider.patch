+    fn execute_backend_command_streaming(
+        &mut self,
+        agent_id: &AgentId,
+        command: &str,
+        sink: &mut dyn FnMut(AgentStreamEvent),
+    ) -> Result<ChatMessage, AgentError> {
+        match parse_codex_backend_command(command)? {
