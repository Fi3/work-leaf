+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+enum CodexBackendCommand<'a> {
+    Status,
+    Fork { prompt: &'a str },
+}
+
+fn parse_codex_backend_command(command: &str) -> Result<CodexBackendCommand<'_>, AgentError> {
+    let command_body = command
+        .strip_prefix('/')
+        .ok_or_else(|| unsupported_backend_command(command))?;
+    let mut parts = command_body.splitn(2, char::is_whitespace);
+    let token = parts
+        .next()
+        .filter(|token| !token.is_empty())
+        .ok_or_else(|| unsupported_backend_command(command))?;
+    let rest = parts.next().unwrap_or_default().trim_start();
+    match token {
+        "status" => Ok(CodexBackendCommand::Status),
+        "fork" => Ok(CodexBackendCommand::Fork { prompt: rest }),
+        _ => Err(unsupported_backend_command(command)),
+    }
+}
+
+fn unsupported_backend_command(command: &str) -> AgentError {
+    AgentError::Io(std::io::Error::other(format!(
+        "unsupported Codex backend command `{command}`"
+    )))
 }
 
