+#[test]
+fn scripted_harness_review_completion_yes_closes_highlighted_chat() {
+    let mut harness = UiHarness::new(100, 24);
+    harness.handle_byte(b'j');
+    assert_eq!(
+        harness.ui().selected_agent().map(|id| id.as_str()),
+        Some("user-2")
+    );
+
+    harness
+        .mark_agent_review_complete("user-2")
+        .expect("fixture user-2 agent is registered");
+
+    let frame = harness.render_frame();
+    assert!(frame.starts_with('\u{7}'));
+    assert!(frame.contains("work-leaf: Review complete. Is this feature done? yes/no"));
+
+    harness.handle_bytes(b"iyes\n");
+
+    assert!(harness.ui().selected_agent().is_none());
+    assert!(
+        !harness
+            .transcript()
+            .iter()
+            .any(|line| line == "user-2> yes")
+    );
+    assert!(
+        harness
+            .transcript()
+            .iter()
+            .any(|line| line == "work-leaf: feature marked done")
+    );
+}
