+            self.clamp_visual_selection(right_content);
+        } else {
+            self.begin_visual_selection(mode, right_content);
+        }
+    }
+
+    fn move_visual_cursor(&mut self, row_delta: isize, column_delta: isize, right_content: &str) {
+        let Some(selection) = self.visual_selection.as_ref() else {
+            return;
+        };
+        let lines = self.visual_lines(selection.pane, right_content);
+        let max_row = lines.len().saturating_sub(1);
+        let next_row = offset_index(selection.cursor.row, row_delta, max_row);
+        let current_line_len = lines
+            .get(next_row)
+            .map(|line| line.chars().count())
+            .unwrap_or_default();
+        let next_column = if selection.mode == VisualSelectionMode::Line {
+            0
+        } else {
+            offset_index(selection.cursor.column, column_delta, current_line_len)
+        };
+        if let Some(selection) = self.visual_selection.as_mut() {
+            selection.cursor = VisualPosition {
+                row: next_row,
+                column: next_column,
+            };
+        }
+    }
+
+    fn clamp_visual_selection(&mut self, right_content: &str) {
+        let Some(selection) = self.visual_selection.as_ref() else {
+            return;
+        };
+        let lines = self.visual_lines(selection.pane, right_content);
+        let max_row = lines.len().saturating_sub(1);
+        let mut anchor = selection.anchor;
+        let mut cursor = selection.cursor;
+        anchor.row = anchor.row.min(max_row);
+        cursor.row = cursor.row.min(max_row);
+        if selection.mode == VisualSelectionMode::Line {
+            anchor.column = 0;
+            cursor.column = 0;
+        } else {
+            anchor.column = anchor.column.min(lines[anchor.row].chars().count());
+            cursor.column = cursor.column.min(lines[cursor.row].chars().count());
+        }
+        if let Some(selection) = self.visual_selection.as_mut() {
+            selection.anchor = anchor;
+            selection.cursor = cursor;
+        }
+    }
