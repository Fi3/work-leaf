+fn reversed_range_spans(line: &str, start: usize, end: usize) -> Spans<'static> {
+    let line_len = line.chars().count();
+    let start = start.min(line_len);
+    let end = end.min(line_len);
+    if start >= end {
+        return Spans::from(Span::raw(line.to_string()));
+    }
+    let style = Style::default().add_modifier(Modifier::REVERSED);
+    Spans::from(vec![
+        Span::raw(char_range(line, 0, start)),
+        Span::styled(char_range(line, start, end), style),
+        Span::raw(char_range(line, end, line_len)),
+    ])
+}
+
+fn char_range(line: &str, start: usize, end: usize) -> String {
+    line.chars()
+        .skip(start)
+        .take(end.saturating_sub(start))
+        .collect()
+}
+
+fn offset_index(value: usize, delta: isize, max: usize) -> usize {
+    if delta < 0 {
+        value.saturating_sub((-delta) as usize)
+    } else {
+        value.saturating_add(delta as usize).min(max)
+    }
+}
+
+fn ordered_visual_positions(
+    left: VisualPosition,
+    right: VisualPosition,
+) -> (VisualPosition, VisualPosition) {
+    if (left.row, left.column) <= (right.row, right.column) {
+        (left, right)
+    } else {
+        (right, left)
+    }
+}
+
+fn row_in_visual_range(selection: &VisualSelection, row: usize) -> bool {
+    let start = selection.anchor.row.min(selection.cursor.row);
+    let end = selection.anchor.row.max(selection.cursor.row);
+    (start..=end).contains(&row)
+}
+
+fn character_visual_columns(
+    selection: &VisualSelection,
+    row: usize,
+    line_len: usize,
+) -> Option<(usize, usize)> {
+    let (start, end) = ordered_visual_positions(selection.anchor, selection.cursor);
+    if row < start.row || row > end.row {
+        return None;
+    }
+    let start_column = if row == start.row { start.column } else { 0 }.min(line_len);
+    let end_column = if row == end.row {
+        end.column.saturating_add(1)
+    } else {
+        line_len
+    }
+    .min(line_len);
+    (start_column < end_column).then_some((start_column, end_column))
+}
+
+fn block_visual_columns(
+    selection: &VisualSelection,
+    row: usize,
+    line_len: usize,
+) -> Option<(usize, usize)> {
+    if !row_in_visual_range(selection, row) {
+        return None;
+    }
+    let start_column = selection
+        .anchor
+        .column
+        .min(selection.cursor.column)
+        .min(line_len);
+    let end_column = selection
+        .anchor
+        .column
+        .max(selection.cursor.column)
+        .saturating_add(1)
+        .min(line_len);
+    (start_column < end_column).then_some((start_column, end_column))
+}
+
+fn selected_visual_text(
+    selection: &VisualSelection,
+    lines: &[String],
+    whole_lines: bool,
+) -> Option<String> {
+    if lines.is_empty() {
+        return None;
+    }
+    let max_row = lines.len().saturating_sub(1);
+    let start_row = selection.anchor.row.min(selection.cursor.row).min(max_row);
+    let end_row = selection.anchor.row.max(selection.cursor.row).min(max_row);
+    if whole_lines || selection.mode == VisualSelectionMode::Line {
+        return Some(lines[start_row..=end_row].join("\n"));
+    }
+
+    match selection.mode {
+        VisualSelectionMode::Character => {
+            let (start, end) = ordered_visual_positions(selection.anchor, selection.cursor);
+            let start_row = start.row.min(max_row);
+            let end_row = end.row.min(max_row);
+            let mut copied = Vec::new();
+            for (row, line) in lines.iter().enumerate().take(end_row + 1).skip(start_row) {
+                let line_len = line.chars().count();
+                let start_column = if row == start_row { start.column } else { 0 }.min(line_len);
+                let end_column = if row == end_row {
+                    end.column.saturating_add(1)
+                } else {
+                    line_len
+                }
+                .min(line_len);
+                copied.push(char_range(line, start_column, end_column));
+            }
+            Some(copied.join("\n"))
+        }
+        VisualSelectionMode::Block => {
+            let start_column = selection.anchor.column.min(selection.cursor.column);
+            let end_column = selection
+                .anchor
+                .column
+                .max(selection.cursor.column)
+                .saturating_add(1);
+            let copied = lines[start_row..=end_row]
+                .iter()
+                .map(|line| {
+                    let line_len = line.chars().count();
+                    char_range(line, start_column.min(line_len), end_column.min(line_len))
+                })
+                .collect::<Vec<_>>();
+            Some(copied.join("\n"))
+        }
+        VisualSelectionMode::Line => unreachable!("line mode returned whole lines above"),
+    }
+}
