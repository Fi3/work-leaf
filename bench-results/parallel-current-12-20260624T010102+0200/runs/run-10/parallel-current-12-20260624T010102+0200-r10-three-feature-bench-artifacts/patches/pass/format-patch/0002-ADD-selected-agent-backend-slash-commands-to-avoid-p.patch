+        assert!(session.lines.iter().any(|line| line == "user: /fork"));
+        assert!(
+            session
+                .lines
+                .iter()
+                .any(|line| line == "backend command output: /status")
+        );
+        assert!(
+            session
+                .lines
+                .iter()
+                .any(|line| line == "backend command output: /fork")
+        );
+    }
+
+    #[test]
+    fn slash_followed_by_whitespace_remains_an_agent_prompt() {
+        let backend = RecordingBackend::default();
+        let state = Arc::clone(&backend.state);
+        let chat = CommandChat::new(PathBuf::from("."), backend);
+        let mut controller = WorkLeafController::new(chat);
+        let agent_id = controller
+            .create_agent("initial task")
+            .expect("test agent launches");
+        assert!(controller.wait_for_idle(Duration::from_secs(1)));
+
+        controller
+            .send_message(&agent_id, "/ status")
+            .expect("prompt sends");
+        assert!(controller.wait_for_idle(Duration::from_secs(1)));
+
+        let state = state.lock().unwrap();
+        assert_eq!(state.sends, vec!["/ status"]);
+        assert!(state.commands.is_empty());
+    }
+
+    #[test]
+    fn selected_agent_backend_command_requires_non_whitespace_command_token() {
+        assert_eq!(selected_agent_backend_command("/status"), Some("/status"));
+        assert_eq!(
+            selected_agent_backend_command(" /fork now "),
+            Some("/fork now")
+        );
+        assert_eq!(selected_agent_backend_command("/"), None);
+        assert_eq!(selected_agent_backend_command("/ status"), None);
+        assert_eq!(selected_agent_backend_command("status"), None);
+    }
+}
