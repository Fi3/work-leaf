+                    session.feature
+                ))
+            }
+            "/fork" => Ok(
+                "Codex backend command `/fork` is not supported for non-interactive Work Leaf sessions"
+                    .to_string(),
+            ),
+            other => Ok(format!(
+                "Codex backend command `{other}` is not supported by Work Leaf"
+            )),
+        }
