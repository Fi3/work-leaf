+    fn backend_command_reply(
+        &self,
+        agent_id: &AgentId,
+        command: &str,
+    ) -> Result<String, AgentError> {
+        let command_token = command.split_whitespace().next().unwrap_or(command);
+        let state = self
+            .state
+            .lock()
+            .expect("codex backend state mutex poisoned");
+        let session = state
+            .sessions
+            .get(agent_id)
+            .ok_or_else(|| AgentError::UnknownSession(agent_id.clone()))?;
+
+        match command_token {
+            "/status" => {
+                let activity = if state.active_processes.contains_key(agent_id) {
+                    "running"
+                } else {
+                    "idle"
+                };
+                let thread = state
+                    .thread_ids
