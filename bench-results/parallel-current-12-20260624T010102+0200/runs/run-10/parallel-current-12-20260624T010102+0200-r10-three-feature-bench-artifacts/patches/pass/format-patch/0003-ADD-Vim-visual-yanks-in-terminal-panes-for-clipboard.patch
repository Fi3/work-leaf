+fn visual_range_for_line(
+    selection: &VisualSelection,
+    row: usize,
+    line_len: usize,
+    force_line: bool,
+) -> Option<(usize, usize)> {
+    if force_line || selection.kind == VisualSelectionKind::Line {
+        let start = selection.anchor.row.min(selection.cursor.row);
+        let end = selection.anchor.row.max(selection.cursor.row);
+        return (start..=end).contains(&row).then_some((0, line_len));
+    }
+
+    match selection.kind {
+        VisualSelectionKind::Character => {
+            let (start, end) = ordered_positions(selection.anchor, selection.cursor);
+            if row < start.row || row > end.row {
+                None
+            } else if start.row == end.row {
+                Some((
+                    start.column.min(line_len),
+                    end.column.saturating_add(1).min(line_len),
+                ))
+            } else if row == start.row {
+                Some((start.column.min(line_len), line_len))
+            } else if row == end.row {
+                Some((0, end.column.saturating_add(1).min(line_len)))
+            } else {
+                Some((0, line_len))
+            }
+        }
+        VisualSelectionKind::Line => unreachable!("line selections return before kind match"),
+        VisualSelectionKind::Block => {
+            let top = selection.anchor.row.min(selection.cursor.row);
+            let bottom = selection.anchor.row.max(selection.cursor.row);
+            if !(top..=bottom).contains(&row) {
+                return None;
+            }
+            let left = selection.anchor.column.min(selection.cursor.column);
+            let right = selection.anchor.column.max(selection.cursor.column);
+            Some((left.min(line_len), right.saturating_add(1).min(line_len)))
+        }
+    }
+}
+
+fn ordered_positions(start: TextPosition, end: TextPosition) -> (TextPosition, TextPosition) {
+    if start <= end {
+        (start, end)
+    } else {
+        (end, start)
+    }
+}
+
+fn char_range(text: &str, start: usize, end: usize) -> String {
+    let start = start.min(end);
+    let start_byte = byte_index_for_char(text, start);
+    let end_byte = byte_index_for_char(text, end);
+    text[start_byte..end_byte].to_string()
+}
+
+fn byte_index_for_char(text: &str, char_index: usize) -> usize {
+    text.char_indices()
+        .nth(char_index)
+        .map(|(index, _)| index)
+        .unwrap_or(text.len())
+}
+
+fn osc52_clipboard_sequence(text: &str) -> String {
+    format!("\u{1b}]52;c;{}\u{7}", base64_encode(text.as_bytes()))
+}
+
+fn base64_encode(bytes: &[u8]) -> String {
+    const TABLE: &[u8; 64] = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    let mut encoded = String::with_capacity(bytes.len().div_ceil(3) * 4);
+    for chunk in bytes.chunks(3) {
+        let b0 = chunk[0];
+        let b1 = chunk.get(1).copied().unwrap_or(0);
+        let b2 = chunk.get(2).copied().unwrap_or(0);
+        encoded.push(TABLE[(b0 >> 2) as usize] as char);
+        encoded.push(TABLE[(((b0 & 0b0000_0011) << 4) | (b1 >> 4)) as usize] as char);
+        if chunk.len() > 1 {
+            encoded.push(TABLE[(((b1 & 0b0000_1111) << 2) | (b2 >> 6)) as usize] as char);
+        } else {
+            encoded.push('=');
+        }
+        if chunk.len() > 2 {
+            encoded.push(TABLE[(b2 & 0b0011_1111) as usize] as char);
+        } else {
+            encoded.push('=');
+        }
+    }
+    encoded
+}
