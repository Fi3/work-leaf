+    fn selectable_lines(&self, pane: PaneFocus) -> Vec<String> {
+        match pane {
+            PaneFocus::Left => {
+                let inner_width = usize::from(self.layout().left_width.saturating_sub(2).max(1));
+                self.left_widget_lines(inner_width)
+                    .into_iter()
+                    .map(|line| line.text)
+                    .collect()
+            }
+            PaneFocus::Right => self
