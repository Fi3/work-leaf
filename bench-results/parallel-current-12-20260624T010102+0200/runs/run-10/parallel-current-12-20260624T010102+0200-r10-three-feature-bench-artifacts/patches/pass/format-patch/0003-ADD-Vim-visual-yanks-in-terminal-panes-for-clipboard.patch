+    fn start_visual_selection(&mut self, kind: VisualSelectionKind) -> Vec<UiAction> {
+        let pane = self.focus;
+        let position = self.current_visual_position(pane);
+        self.visual_selection = Some(VisualSelection {
+            pane,
+            kind,
+            anchor: position,
+            cursor: position,
+        });
+        Vec::new()
+    }
+
+    fn clear_visual_selection(&mut self) {
+        self.visual_selection = None;
+    }
+
+    fn handle_visual_key(&mut self, key: UiKey) -> Vec<UiAction> {
+        match key {
+            UiKey::Char('v') => self.set_visual_selection_kind(VisualSelectionKind::Character),
+            UiKey::Char('V') => self.set_visual_selection_kind(VisualSelectionKind::Line),
+            UiKey::Char(CTRL_V_CHAR) => self.set_visual_selection_kind(VisualSelectionKind::Block),
+            UiKey::Char('h') | UiKey::Left => self.move_visual_cursor(0, -1),
+            UiKey::Char('j') | UiKey::Down => self.move_visual_cursor(1, 0),
+            UiKey::Char('k') | UiKey::Up => self.move_visual_cursor(-1, 0),
+            UiKey::Char('l') | UiKey::Right => self.move_visual_cursor(0, 1),
+            UiKey::Char('y') => self.copy_visual_selection(false),
+            UiKey::Char('Y') => self.copy_visual_selection(true),
+            _ => {}
+        }
+        Vec::new()
+    }
+
+    fn set_visual_selection_kind(&mut self, kind: VisualSelectionKind) {
+        if let Some(selection) = &mut self.visual_selection {
+            selection.kind = kind;
+        }
+    }
+
+    fn move_visual_cursor(&mut self, row_delta: isize, column_delta: isize) {
+        let Some(selection) = self.visual_selection.clone() else {
+            return;
+        };
+        let lines = self.selectable_lines(selection.pane);
+        if lines.is_empty() {
+            return;
+        }
+        let max_row = lines.len().saturating_sub(1) as isize;
+        let next_row = (selection.cursor.row as isize + row_delta).clamp(0, max_row) as usize;
+        let line_len = lines[next_row].chars().count();
+        let max_column = line_len.saturating_sub(1) as isize;
+        let next_column =
+            (selection.cursor.column as isize + column_delta).clamp(0, max_column) as usize;
+        if let Some(selection) = &mut self.visual_selection {
+            selection.cursor = TextPosition {
+                row: next_row,
+                column: next_column,
+            };
+        }
+    }
+
+    fn copy_visual_selection(&mut self, force_line: bool) {
+        let copied = self.selected_text(force_line);
+        self.copy_text_to_clipboard(copied);
+        self.clear_visual_selection();
+    }
+
+    fn copy_focused_line(&mut self) -> Vec<UiAction> {
+        let lines = self.selectable_lines(self.focus);
+        let position = self.current_visual_position(self.focus);
+        if let Some(line) = lines.get(position.row) {
+            self.copy_text_to_clipboard(line.clone());
+        }
+        Vec::new()
+    }
+
+    fn copy_text_to_clipboard(&mut self, text: String) {
+        self.clipboard = text;
+        self.pending_clipboard.replace(Some(self.clipboard.clone()));
+        self.show_status_notice(
+            format!("copied {} chars", self.clipboard.chars().count()),
+            Duration::from_secs(STATUS_NOTICE_SECONDS),
+        );
+    }
+
+    fn selected_text(&self, force_line: bool) -> String {
+        let Some(selection) = &self.visual_selection else {
+            return String::new();
+        };
+        let lines = self.selectable_lines(selection.pane);
+        let mut selected = Vec::new();
+        for (row, line) in lines.iter().enumerate() {
+            if let Some((start, end)) =
+                visual_range_for_line(selection, row, line.chars().count(), force_line)
+            {
+                selected.push(char_range(line, start, end));
+            }
+        }
+        selected.join("\n")
+    }
+
+    fn current_visual_position(&self, pane: PaneFocus) -> TextPosition {
+        match pane {
+            PaneFocus::Left => {
+                let lines = self.selectable_lines(PaneFocus::Left);
+                TextPosition {
+                    row: self
+                        .left_control_render_row()
+                        .min(lines.len().saturating_sub(1)),
+                    column: 0,
+                }
+            }
+            PaneFocus::Right => {
+                let lines = self.selectable_lines(PaneFocus::Right);
+                let row = lines.len().saturating_sub(1);
+                let line_len = lines
