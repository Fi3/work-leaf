+    fn visual_cursor_position(&self, selection: &VisualSelection) -> (u16, u16) {
+        let layout = self.layout();
+        let row = selection.cursor.row.min(usize::from(u16::MAX)) as u16;
+        let column = selection.cursor.column.min(usize::from(u16::MAX)) as u16;
+        match selection.pane {
+            PaneFocus::Left => {
+                let max_column = layout.left_width.saturating_sub(1).max(1);
+                (
+                    row.saturating_add(2),
+                    column.saturating_add(2).min(max_column),
+                )
+            }
+            PaneFocus::Right => {
+                let max_column = layout
+                    .left_width
+                    .saturating_add(layout.right_width)
+                    .saturating_sub(1)
+                    .max(1);
+                (
+                    row.saturating_add(2),
+                    layout
+                        .left_width
+                        .saturating_add(2)
+                        .saturating_add(column)
+                        .min(max_column),
+                )
+            }
+        }
+    }
