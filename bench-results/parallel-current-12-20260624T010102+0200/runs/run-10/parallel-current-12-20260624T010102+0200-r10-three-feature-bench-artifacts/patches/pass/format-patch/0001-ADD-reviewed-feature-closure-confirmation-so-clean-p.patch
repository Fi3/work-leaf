+fn session_is_closed(session: &WorkLeafSession) -> bool {
+    session
+        .lines
+        .iter()
+        .rev()
+        .find_map(|line| agent_closed_state(line))
+        .unwrap_or(false)
+}
+
+fn agent_closed_state(line: &str) -> Option<bool> {
+    match line {
+        FEATURE_CLOSED_NOTICE => Some(true),
+        FEATURE_REOPENED_NOTICE => Some(false),
+        _ => None,
+    }
+}
