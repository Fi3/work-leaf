+    fn answer_done_confirmation(&mut self, agent_id: &AgentId, message: &str) -> bool {
+        if !self.done_confirmation_agents.remove(agent_id) {
+            return false;
+        }
+
+        let normalized = message.to_ascii_lowercase();
+        if matches!(normalized.as_str(), "yes" | "y") {
+            self.append_agent_line(agent_id, format!("user: {message}"));
+            self.closed_agents.insert(agent_id.clone());
+            self.append_agent_line_force(agent_id, FEATURE_CLOSED_NOTICE.to_string());
+            return true;
+        }
+
+        self.closed_agents.remove(agent_id);
+        if matches!(normalized.as_str(), "no" | "n") {
+            self.append_agent_line(agent_id, format!("user: {message}"));
+            self.append_agent_line_force(agent_id, FEATURE_REOPENED_NOTICE.to_string());
+            return true;
+        }
+
+        self.append_agent_line_force(agent_id, FEATURE_REOPENED_NOTICE.to_string());
+        false
+    }
+
+    fn reopen_agent_session(&mut self, agent_id: &AgentId) {
+        if self.closed_agents.remove(agent_id) {
+            self.append_agent_line_force(agent_id, FEATURE_REOPENED_NOTICE.to_string());
+        }
+    }
