+#[test]
+fn controller_runs_selected_agent_status_slash_command_without_normal_send() {
+    let backend = FakeBackend::new(["launch reply", "status output"]);
+    let chat = CommandChat::new(PathBuf::from("/repo"), backend.clone());
+    let mut controller = WorkLeafController::new(chat);
+
+    let agent_id = controller.create_agent("inspect status").unwrap();
+    assert!(controller.wait_for_idle(Duration::from_secs(1)));
+
+    controller.send_message(&agent_id, "/status").unwrap();
+    assert!(controller.wait_for_idle(Duration::from_secs(1)));
+
+    let snapshot = controller.snapshot();
+    let session = snapshot.session(&agent_id).expect("session exists");
+    assert!(session.lines.iter().any(|line| line == "user: /status"));
+    assert!(session.lines.iter().any(|line| line == "status output"));
+    assert_eq!(
+        backend.commands(),
+        vec![(agent_id.clone(), "/status".to_string())]
+    );
+    assert!(
+        backend.sends().is_empty(),
+        "/status must not be routed through the ordinary backend send path"
+    );
+}
+
+#[test]
+fn controller_runs_selected_agent_fork_slash_command_as_backend_command() {
+    let backend = FakeBackend::new(["launch reply", "fork output"]);
+    let chat = CommandChat::new(PathBuf::from("/repo"), backend.clone());
+    let mut controller = WorkLeafController::new(chat);
+
+    let agent_id = controller.create_agent("prepare fork").unwrap();
+    assert!(controller.wait_for_idle(Duration::from_secs(1)));
+
+    controller.send_message(&agent_id, "/fork user-2").unwrap();
+    assert!(controller.wait_for_idle(Duration::from_secs(1)));
+
+    let snapshot = controller.snapshot();
+    let session = snapshot.session(&agent_id).expect("session exists");
+    assert!(
+        session
+            .lines
+            .iter()
+            .any(|line| line == "user: /fork user-2")
+    );
+    assert!(session.lines.iter().any(|line| line == "fork output"));
+    assert_eq!(
+        backend.commands(),
+        vec![(agent_id.clone(), "/fork user-2".to_string())]
+    );
+    assert!(backend.sends().is_empty());
+}
