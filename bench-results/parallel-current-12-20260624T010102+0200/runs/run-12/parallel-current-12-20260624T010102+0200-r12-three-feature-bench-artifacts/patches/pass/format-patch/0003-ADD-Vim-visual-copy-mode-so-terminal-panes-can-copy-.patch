+    let range = if start.row == end.row {
+        (
+            start.column.min(line_len),
+            end.column.saturating_add(1).min(line_len),
+        )
+    } else if row == start.row {
+        (start.column.min(line_len), line_len)
+    } else if row == end.row {
+        (0, end.column.saturating_add(1).min(line_len))
+    } else {
+        (0, line_len)
+    };
+    Some(range)
