+    fn selection_text(&self, selection: &VisualSelection, force_linewise: bool) -> String {
+        let lines = self.snapshot_lines(selection.pane);
+        if lines.is_empty() {
+            return String::new();
+        }
+        if force_linewise || selection.kind == VisualSelectionKind::Line {
+            let (start, end) = selected_row_range(selection);
+            return lines[start.min(lines.len() - 1)..=end.min(lines.len() - 1)].join("\n");
+        }
+
+        lines
+            .iter()
+            .enumerate()
+            .filter_map(|(row, line)| {
+                selection_range(selection, row, line.chars().count())
+                    .map(|(start, end)| line_char_range(line, start, end))
+            })
+            .collect::<Vec<_>>()
+            .join("\n")
+    }
+
