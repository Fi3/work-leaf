+    fn handle_visual_key(&mut self, key: UiKey) -> Vec<UiAction> {
+        match key {
+            UiKey::Esc => {
+                self.clear_visual_selection();
+                Vec::new()
+            }
+            UiKey::Char('v') => {
+                self.set_visual_selection_kind(VisualSelectionKind::Character);
+                Vec::new()
+            }
+            UiKey::Char('V') => {
+                self.set_visual_selection_kind(VisualSelectionKind::Line);
+                Vec::new()
+            }
+            UiKey::Char('y') => {
+                self.copy_visual_selection(false);
+                Vec::new()
+            }
+            UiKey::Char('Y') => {
+                self.copy_visual_selection(true);
+                Vec::new()
+            }
+            UiKey::Char('h') | UiKey::Left => {
+                self.move_visual_cursor(0, -1);
+                Vec::new()
+            }
+            UiKey::Char('j') | UiKey::Down => {
+                self.move_visual_cursor(1, 0);
+                Vec::new()
+            }
+            UiKey::Char('k') | UiKey::Up => {
+                self.move_visual_cursor(-1, 0);
+                Vec::new()
+            }
+            UiKey::Char('l') | UiKey::Right => {
+                self.move_visual_cursor(0, 1);
+                Vec::new()
+            }
+            _ => Vec::new(),
+        }
+    }
+
+    fn start_visual_selection(&mut self, kind: VisualSelectionKind) {
+        let pane = self.focus;
+        let position = self.current_visual_position(pane);
+        self.visual_selection = Some(VisualSelection {
+            pane,
+            kind,
+            anchor: position,
+            cursor: position,
+        });
+        self.mode = UiMode::Command;
+    }
+
+    fn set_visual_selection_kind(&mut self, kind: VisualSelectionKind) {
+        if let Some(selection) = self.visual_selection.as_mut() {
+            selection.kind = kind;
+        } else {
+            self.start_visual_selection(kind);
+        }
+    }
+
+    fn clear_visual_selection(&mut self) {
+        self.visual_selection = None;
+    }
+
+    fn current_visual_position(&self, pane: PaneFocus) -> TextPosition {
+        let lines = self.snapshot_lines(pane);
+        let row = match pane {
+            PaneFocus::Left => self.left_selected_text_row(),
+            PaneFocus::Right => lines.len().saturating_sub(1),
+        };
+        clamp_text_position(&lines, TextPosition { row, column: 0 })
+    }
+
+    fn left_selected_text_row(&self) -> usize {
+        if self.control_selected == 0 {
+            return 0;
+        }
+
+        let mut current_row = 1;
+        for (visible_position, agent_index) in self.visible_agent_indices().iter().enumerate() {
+            let agent = &self.agents[*agent_index];
+            if self.control_selected == visible_position + 1 {
+                return current_row;
+            }
+            current_row += 1;
+
+            if !agent.modified_files.is_empty() {
+                current_row += 1;
+            }
+            for linked_agents in [
+                &agent.conflicting_agents,
+                &agent.depends_on,
+                &agent.depended_on_by,
+            ] {
+                if !linked_agents.is_empty() {
+                    current_row += 1;
+                }
+            }
+        }
+
+        current_row.saturating_sub(1)
+    }
+
+    fn snapshot_lines(&self, pane: PaneFocus) -> Vec<String> {
+        let snapshot = self.render_snapshot.borrow();
+        match pane {
+            PaneFocus::Left => snapshot.left_lines.clone(),
+            PaneFocus::Right => snapshot.right_lines.clone(),
+        }
+    }
+
+    fn move_visual_cursor(&mut self, row_delta: isize, column_delta: isize) {
+        let Some(selection) = self.visual_selection.clone() else {
+            return;
+        };
+        let lines = self.snapshot_lines(selection.pane);
+        let row = selection
+            .cursor
+            .row
+            .saturating_add_signed(row_delta)
+            .min(lines.len().saturating_sub(1));
+        let column = selection.cursor.column.saturating_add_signed(column_delta);
+        let Some(selection) = self.visual_selection.as_mut() else {
+            return;
+        };
+        selection.cursor = clamp_text_position(&lines, TextPosition { row, column });
+    }
+
+    fn copy_visual_selection(&mut self, force_linewise: bool) {
+        let Some(selection) = self.visual_selection.clone() else {
+            return;
+        };
+        let text = self.selection_text(&selection, force_linewise);
+        self.clear_visual_selection();
+        self.copy_text(text);
+    }
