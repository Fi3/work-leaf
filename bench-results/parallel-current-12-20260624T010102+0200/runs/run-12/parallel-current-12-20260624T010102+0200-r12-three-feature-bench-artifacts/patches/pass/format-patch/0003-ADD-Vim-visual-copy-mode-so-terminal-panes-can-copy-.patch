+fn selection_range(
+    selection: &VisualSelection,
+    row: usize,
+    line_len: usize,
+) -> Option<(usize, usize)> {
+    match selection.kind {
+        VisualSelectionKind::Line => {
+            let (start_row, end_row) = selected_row_range(selection);
+            (start_row..=end_row)
+                .contains(&row)
+                .then_some((0, line_len))
+        }
+        VisualSelectionKind::Block => {
+            let (start_row, end_row) = selected_row_range(selection);
+            if !(start_row..=end_row).contains(&row) {
+                return None;
+            }
+            let start = selection.anchor.column.min(selection.cursor.column);
+            let end = selection
+                .anchor
+                .column
+                .max(selection.cursor.column)
+                .saturating_add(1);
+            if line_len == 0 {
+                return Some((0, 0));
+            }
+            (start < line_len).then_some((start.min(line_len), end.min(line_len)))
+        }
+        VisualSelectionKind::Character => character_selection_range(selection, row, line_len),
+    }
