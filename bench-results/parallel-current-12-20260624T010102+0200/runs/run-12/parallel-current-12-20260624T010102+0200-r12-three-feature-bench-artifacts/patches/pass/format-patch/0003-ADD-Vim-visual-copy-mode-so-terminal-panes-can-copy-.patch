+    fn copy_focused_line(&mut self) {
+        let pane = self.focus;
+        let lines = self.snapshot_lines(pane);
+        let position = self.current_visual_position(pane);
+        let text = lines.get(position.row).cloned().unwrap_or_default();
+        self.copy_text(text);
