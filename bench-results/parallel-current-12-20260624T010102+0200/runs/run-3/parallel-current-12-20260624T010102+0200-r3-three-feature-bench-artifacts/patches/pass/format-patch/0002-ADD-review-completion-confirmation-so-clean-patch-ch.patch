+    fn request_feature_done_confirmation(&mut self, review: &ReviewResult) {
+        self.awaiting_done_confirmation
+            .insert(review.agent_id.clone());
+        self.done_features.remove(&review.agent_id);
+        self.append_agent_line(
+            &review.agent_id,
+            format!(
+                "work-leaf: review complete for {}. Is this feature done? yes/no",
+                short_hash(&review.commit.hash)
+            ),
+        );
+    }
+
+    fn handle_feature_done_reply(&mut self, agent_id: &AgentId, message: &str) -> bool {
+        if !self.awaiting_done_confirmation.contains(agent_id) {
+            return false;
+        }
+
+        match confirmation_answer(message) {
+            Some(true) => {
+                self.append_agent_line(agent_id, format!("user: {message}"));
+                self.awaiting_done_confirmation.remove(agent_id);
+                self.done_features.insert(agent_id.clone());
+                self.append_agent_line(agent_id, "work-leaf: feature marked done".to_string());
+                true
+            }
+            Some(false) => {
+                self.append_agent_line(agent_id, format!("user: {message}"));
+                self.awaiting_done_confirmation.remove(agent_id);
+                self.done_features.remove(agent_id);
+                self.append_agent_line(agent_id, "work-leaf: feature remains open".to_string());
+                true
+            }
+            None => {
+                self.awaiting_done_confirmation.remove(agent_id);
+                false
+            }
+        }
+    }
