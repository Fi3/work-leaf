+fn confirmation_answer(message: &str) -> Option<bool> {
+    let normalized = message
+        .trim()
+        .trim_matches(|ch: char| matches!(ch, '.' | '!' | '?'))
+        .to_ascii_lowercase();
+    match normalized.as_str() {
+        "yes" | "y" => Some(true),
+        "no" | "n" => Some(false),
+        _ => None,
+    }
+}
+
+fn short_hash(hash: &str) -> &str {
+    hash.get(..12).unwrap_or(hash)
+}
