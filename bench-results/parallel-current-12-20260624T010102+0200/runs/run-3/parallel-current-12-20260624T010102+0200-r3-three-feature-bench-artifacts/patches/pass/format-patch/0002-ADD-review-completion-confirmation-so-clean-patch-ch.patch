+
+    let prompt_frame = harness.render_frame();
+    assert!(prompt_frame.starts_with('\u{7}'));
+    assert!(prompt_frame.contains("Is this feature done? yes/no"));
+    assert!(prompt_frame.contains("\u{1b}[7m test user-2 READY\u{1b}[0m"));
