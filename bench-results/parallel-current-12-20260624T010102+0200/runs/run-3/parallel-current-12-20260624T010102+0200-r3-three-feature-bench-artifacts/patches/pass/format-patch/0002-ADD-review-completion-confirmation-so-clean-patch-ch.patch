+            "yes" | "y" => {
+                self.feature_done_prompts.remove(agent_id);
+                self.closed_agents.insert(agent_id.clone());
+                let _ = self.ui.set_agent_ready_state(agent_id, false);
+                let _ = self.ui.set_agent_hidden_state(agent_id, true);
+                self.transcript.push(format!("{agent_id}> {message}"));
+                self.transcript
+                    .push("work-leaf: feature marked done".to_string());
+                true
+            }
