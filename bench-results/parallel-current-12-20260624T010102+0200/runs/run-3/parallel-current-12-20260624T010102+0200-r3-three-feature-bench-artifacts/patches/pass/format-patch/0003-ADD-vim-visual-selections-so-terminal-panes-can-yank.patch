+    fn selection_spans_for_line(&self, pane: PaneFocus, row: usize, line: &str) -> Spans<'static> {
+        let Some(selection) = &self.visual_selection else {
+            return Spans::from(vec![Span::raw(line.to_string())]);
+        };
+        if selection.pane != pane {
+            return Spans::from(vec![Span::raw(line.to_string())]);
+        }
+        let ranges = selected_ranges_for_line(
+            selection,
+            row,
+            line.chars().count(),
+            selection.kind == VisualSelectionKind::Line,
+        );
+        if ranges.is_empty() {
+            return Spans::from(vec![Span::raw(line.to_string())]);
+        }
+        styled_selection_spans(line, &ranges)
+    }
