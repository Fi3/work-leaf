+            PaneFocus::Right => {
+                let row = line_lengths.len().saturating_sub(1);
+                let line_len = line_lengths[row];
+                let requested = right_cursor_column.unwrap_or(line_len);
+                let column = if kind == VisualSelectionKind::Line || line_len == 0 {
+                    0
+                } else {
+                    requested.min(line_len.saturating_sub(1))
+                };
+                TextPosition { row, column }
