+fn selected_row_count(selection: &VisualSelection) -> usize {
+    let start = selection.anchor.row.min(selection.cursor.row);
+    let end = selection.anchor.row.max(selection.cursor.row);
+    end.saturating_sub(start).saturating_add(1)
+}
+
+fn selected_text(lines: &[String], selection: &VisualSelection, linewise: bool) -> String {
+    let start = selection.anchor.row.min(selection.cursor.row);
+    let end = selection.anchor.row.max(selection.cursor.row);
+    let mut selected = Vec::new();
+    for row in start..=end {
+        let line = lines.get(row).map(String::as_str).unwrap_or("");
+        if linewise {
+            selected.push(line.to_string());
+            continue;
+        }
+        let text = selected_ranges_for_line(selection, row, line.chars().count(), false)
+            .into_iter()
+            .map(|(start, end)| char_slice(line, start, end))
+            .collect::<Vec<_>>()
+            .join("");
+        selected.push(text);
+    }
+    selected.join("\n")
+}
+
+fn selected_ranges_for_line(
+    selection: &VisualSelection,
+    row: usize,
+    line_len: usize,
+    linewise: bool,
+) -> Vec<(usize, usize)> {
+    let start_row = selection.anchor.row.min(selection.cursor.row);
+    let end_row = selection.anchor.row.max(selection.cursor.row);
+    if row < start_row || row > end_row {
+        return Vec::new();
+    }
+    if linewise {
+        return vec![(0, line_len)];
+    }
+
+    match selection.kind {
+        VisualSelectionKind::Line => vec![(0, line_len)],
+        VisualSelectionKind::Block => {
+            let start = selection.anchor.column.min(selection.cursor.column);
+            let end = selection
+                .anchor
+                .column
+                .max(selection.cursor.column)
+                .saturating_add(1);
+            vec![(start.min(line_len), end.min(line_len))]
+        }
+        VisualSelectionKind::Character => {
+            let starts_before_cursor = selection.anchor.row < selection.cursor.row
+                || (selection.anchor.row == selection.cursor.row
+                    && selection.anchor.column <= selection.cursor.column);
+            let (start, end) = if starts_before_cursor {
+                (selection.anchor, selection.cursor)
+            } else {
+                (selection.cursor, selection.anchor)
+            };
+
+            if start.row == end.row {
+                return vec![(
+                    start.column.min(line_len),
+                    end.column.saturating_add(1).min(line_len),
+                )];
+            }
+            if row == start.row {
+                vec![(start.column.min(line_len), line_len)]
+            } else if row == end.row {
+                vec![(0, end.column.saturating_add(1).min(line_len))]
+            } else {
+                vec![(0, line_len)]
+            }
+        }
+    }
+}
+
+fn styled_selection_spans(line: &str, ranges: &[(usize, usize)]) -> Spans<'static> {
+    let mut spans = Vec::new();
+    let mut cursor = 0;
+    for (start, end) in ranges {
+        if *start > cursor {
+            spans.push(Span::raw(char_slice(line, cursor, *start)));
+        }
+        if end > start {
+            spans.push(Span::styled(
+                char_slice(line, *start, *end),
+                Style::default().add_modifier(Modifier::REVERSED),
+            ));
+        }
+        cursor = *end;
+    }
+    let line_len = line.chars().count();
+    if cursor < line_len {
+        spans.push(Span::raw(char_slice(line, cursor, line_len)));
+    }
+    if spans.is_empty() {
+        spans.push(Span::raw(line.to_string()));
+    }
+    Spans::from(spans)
+}
+
+fn char_slice(text: &str, start: usize, end: usize) -> String {
+    text.chars()
+        .skip(start)
+        .take(end.saturating_sub(start))
+        .collect()
+}
