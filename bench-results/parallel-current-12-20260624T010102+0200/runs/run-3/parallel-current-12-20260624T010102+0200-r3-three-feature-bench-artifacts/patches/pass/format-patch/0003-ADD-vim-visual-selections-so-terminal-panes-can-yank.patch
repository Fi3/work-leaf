+    fn selection_spans_for_text(&self, pane: PaneFocus, text: &str) -> Vec<Spans<'static>> {
+        let lines = text.lines().collect::<Vec<_>>();
+        if lines.is_empty() {
+            return vec![self.selection_spans_for_line(pane, 0, "")];
+        }
+        lines
+            .iter()
