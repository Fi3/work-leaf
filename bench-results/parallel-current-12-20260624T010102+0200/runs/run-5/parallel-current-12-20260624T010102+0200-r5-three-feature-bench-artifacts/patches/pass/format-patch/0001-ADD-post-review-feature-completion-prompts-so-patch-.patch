+    fn handle_feature_completion_reply(&mut self, agent_id: &AgentId, message: &str) -> bool {
+        let Some(state) = self.feature_completion.get(agent_id).copied() else {
+            return false;
+        };
+
+        match state {
+            FeatureCompletionState::PendingConfirmation if message.eq_ignore_ascii_case("yes") => {
+                self.append_agent_line(agent_id, format!("user: {message}"));
+                self.feature_completion
+                    .insert(agent_id.clone(), FeatureCompletionState::Closed);
+                self.append_agent_line_allow_duplicate(agent_id, FEATURE_CLOSED_LINE.to_string());
+                true
+            }
+            FeatureCompletionState::PendingConfirmation if message.eq_ignore_ascii_case("no") => {
+                self.append_agent_line(agent_id, format!("user: {message}"));
+                self.reopen_feature(agent_id);
+                true
+            }
+            FeatureCompletionState::PendingConfirmation | FeatureCompletionState::Closed => {
+                self.reopen_feature(agent_id);
+                false
+            }
+        }
+    }
+
