+    fn start_visual_selection(&mut self, kind: VisualKind) {
+        let pane = self.focus;
+        let point = self.focused_visual_point(pane);
+        self.visual_selection = Some(VisualSelection {
+            pane,
+            kind,
+            anchor: point,
+            cursor: point,
+        });
+    }
+
+    fn clear_visual_selection(&mut self) {
+        self.visual_selection = None;
+    }
+
+    fn toggle_visual_kind(&mut self, kind: VisualKind) {
+        let Some(selection) = self.visual_selection else {
+            self.start_visual_selection(kind);
+            return;
+        };
+        if selection.kind == kind {
+            self.clear_visual_selection();
+        } else {
+            self.set_visual_kind(kind);
+        }
+    }
+
+    fn set_visual_kind(&mut self, kind: VisualKind) {
+        if let Some(selection) = self.visual_selection.as_mut() {
+            selection.kind = kind;
+        } else {
+            self.start_visual_selection(kind);
+        }
+    }
+
+    fn focused_visual_point(&self, pane: PaneFocus) -> VisualPoint {
+        match pane {
+            PaneFocus::Left => {
+                let lines = self.pane_text_lines(PaneFocus::Left);
+                clamp_point_to_lines(
+                    VisualPoint {
+                        row: self.selected_left_visual_row(),
+                        column: 0,
+                    },
+                    &lines,
+                )
+            }
+            PaneFocus::Right => {
+                clamp_point_to_lines(self.right_selection_cursor, &self.right_selection_lines)
+            }
+        }
+    }
+
+    fn move_visual_cursor(&mut self, row_delta: isize, column_delta: isize) {
+        let Some(mut selection) = self.visual_selection else {
+            return;
+        };
+        let lines = self.pane_text_lines(selection.pane);
+        if lines.is_empty() {
+            self.clear_visual_selection();
+            return;
+        }
+        let max_row = lines.len() - 1;
+        let row = apply_delta(selection.cursor.row, row_delta, max_row);
+        let max_column = lines[row].chars().count().saturating_sub(1);
+        let column = apply_delta(selection.cursor.column, column_delta, max_column);
+        selection.cursor = VisualPoint { row, column };
+        self.visual_selection = Some(selection);
+    }
+
+    fn yank_visual_selection(&mut self, kind_override: Option<VisualKind>) {
+        let Some(text) = self.selected_text(kind_override) else {
+            return;
+        };
+        self.queue_clipboard_copy(text);
+        self.clear_visual_selection();
+    }
+
+    fn yank_focused_line(&mut self) {
+        let pane = self.focus;
+        let lines = self.pane_text_lines(pane);
+        if lines.is_empty() {
+            return;
+        }
+        let row = self.focused_visual_point(pane).row.min(lines.len() - 1);
+        self.queue_clipboard_copy(lines[row].clone());
+    }
+
+    fn queue_clipboard_copy(&mut self, text: String) {
+        let copied_chars = text.chars().count();
+        *self.pending_clipboard.borrow_mut() = Some(text);
+        self.show_status_notice(
+            format!("copied {copied_chars} chars"),
+            Duration::from_secs(STATUS_NOTICE_SECONDS),
+        );
+    }
+
+    fn selected_text(&self, kind_override: Option<VisualKind>) -> Option<String> {
+        let selection = self.visual_selection?;
+        let lines = self.pane_text_lines(selection.pane);
+        if lines.is_empty() {
+            return None;
+        }
+        let kind = kind_override.unwrap_or(selection.kind);
+        Some(selection_text(&lines, selection, kind))
+    }
+
