+
+fn ordered_points(left: VisualPoint, right: VisualPoint) -> (VisualPoint, VisualPoint) {
+    if (left.row, left.column) <= (right.row, right.column) {
+        (left, right)
+    } else {
+        (right, left)
+    }
+}
+
+fn visual_selection_range_for_line(
+    selection: VisualSelection,
+    row: usize,
+    text: &str,
+) -> Option<(usize, usize)> {
+    let len = text.chars().count();
+    match selection.kind {
+        VisualKind::Character => {
+            let (start, end) = ordered_points(selection.anchor, selection.cursor);
+            if row < start.row || row > end.row {
+                return None;
+            }
+            if start.row == end.row {
+                return Some((start.column.min(len), end.column.saturating_add(1).min(len)));
+            }
+            if row == start.row {
+                Some((start.column.min(len), len))
+            } else if row == end.row {
+                Some((0, end.column.saturating_add(1).min(len)))
+            } else {
+                Some((0, len))
+            }
+        }
+        VisualKind::Line => {
+            let start = selection.anchor.row.min(selection.cursor.row);
+            let end = selection.anchor.row.max(selection.cursor.row);
+            (start..=end).contains(&row).then_some((0, len))
+        }
+        VisualKind::Block => {
+            let top = selection.anchor.row.min(selection.cursor.row);
+            let bottom = selection.anchor.row.max(selection.cursor.row);
+            if row < top || row > bottom {
+                return None;
+            }
+            let start = selection
+                .anchor
+                .column
+                .min(selection.cursor.column)
+                .min(len);
+            let end = selection
+                .anchor
+                .column
+                .max(selection.cursor.column)
+                .saturating_add(1)
+                .min(len);
+            Some((start, end))
+        }
+    }
+}
+
+fn selection_text(lines: &[String], selection: VisualSelection, kind: VisualKind) -> String {
+    match kind {
+        VisualKind::Character => {
+            let (start, end) = ordered_points(selection.anchor, selection.cursor);
+            if start.row == end.row {
+                let line = &lines[start.row];
+                return slice_chars(line, start.column, end.column.saturating_add(1));
+            }
+            let mut selected = Vec::new();
+            let first = &lines[start.row];
+            selected.push(slice_chars(first, start.column, first.chars().count()));
+            for line in &lines[start.row + 1..end.row] {
+                selected.push(line.clone());
+            }
+            let last = &lines[end.row];
+            selected.push(slice_chars(last, 0, end.column.saturating_add(1)));
+            selected.join("\n")
+        }
+        VisualKind::Line => {
+            let start = selection.anchor.row.min(selection.cursor.row);
+            let end = selection.anchor.row.max(selection.cursor.row);
+            lines[start..=end].join("\n")
+        }
+        VisualKind::Block => {
+            let top = selection.anchor.row.min(selection.cursor.row);
+            let bottom = selection.anchor.row.max(selection.cursor.row);
+            let start = selection.anchor.column.min(selection.cursor.column);
+            let end = selection
+                .anchor
+                .column
+                .max(selection.cursor.column)
+                .saturating_add(1);
+            lines[top..=bottom]
+                .iter()
+                .map(|line| slice_chars(line, start, end))
+                .collect::<Vec<_>>()
+                .join("\n")
+        }
+    }
+}
+
+fn clamp_point_to_lines(point: VisualPoint, lines: &[String]) -> VisualPoint {
+    if lines.is_empty() {
+        return VisualPoint { row: 0, column: 0 };
+    }
+    let row = point.row.min(lines.len() - 1);
+    let max_column = lines[row].chars().count().saturating_sub(1);
+    VisualPoint {
+        row,
+        column: point.column.min(max_column),
+    }
+}
+
+fn apply_delta(value: usize, delta: isize, max: usize) -> usize {
+    if delta.is_negative() {
+        value.saturating_sub(delta.unsigned_abs()).min(max)
+    } else {
+        value.saturating_add(delta as usize).min(max)
+    }
+}
+
+fn slice_chars(text: &str, start: usize, end: usize) -> String {
+    text.chars()
+        .skip(start)
+        .take(end.saturating_sub(start))
+        .collect()
+}
+
+fn osc52_copy_sequence(text: &str) -> String {
+    format!("\u{1b}]52;c;{}\u{7}", base64_encode(text.as_bytes()))
+}
+
+fn base64_encode(bytes: &[u8]) -> String {
+    const TABLE: &[u8; 64] = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    let mut encoded = String::new();
+    for chunk in bytes.chunks(3) {
+        let first = chunk[0];
+        let second = chunk.get(1).copied().unwrap_or(0);
+        let third = chunk.get(2).copied().unwrap_or(0);
+        encoded.push(TABLE[(first >> 2) as usize] as char);
+        encoded.push(TABLE[(((first & 0b0000_0011) << 4) | (second >> 4)) as usize] as char);
+        if chunk.len() > 1 {
+            encoded.push(TABLE[(((second & 0b0000_1111) << 2) | (third >> 6)) as usize] as char);
+        } else {
+            encoded.push('=');
+        }
+        if chunk.len() > 2 {
+            encoded.push(TABLE[(third & 0b0011_1111) as usize] as char);
+        } else {
+            encoded.push('=');
+        }
+    }
+    encoded
+}
+
 fn visual_rows(line: &str, width: u16) -> u16 {
     visual_row_count(line, width).min(usize::from(u16::MAX)) as u16
 }
