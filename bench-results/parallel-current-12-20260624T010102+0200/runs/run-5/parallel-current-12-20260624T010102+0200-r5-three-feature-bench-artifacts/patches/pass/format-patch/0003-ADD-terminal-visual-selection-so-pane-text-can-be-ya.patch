+        let point = clamp_point_to_lines(selection.cursor, &lines);
+        match selection.pane {
+            PaneFocus::Left => Some((
+                2_u16.saturating_add(point.row.min(usize::from(u16::MAX)) as u16),
+                2_u16.saturating_add(point.column.min(usize::from(u16::MAX)) as u16),
+            )),
+            PaneFocus::Right => Some((
+                2_u16.saturating_add(point.row.min(usize::from(u16::MAX)) as u16),
+                self.layout()
