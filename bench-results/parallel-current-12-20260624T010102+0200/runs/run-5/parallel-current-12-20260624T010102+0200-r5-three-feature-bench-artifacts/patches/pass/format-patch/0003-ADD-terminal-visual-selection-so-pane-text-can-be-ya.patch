+    fn styled_pane_line(&self, pane: PaneFocus, row: usize, text: &str) -> Spans<'static> {
+        let Some((start, end)) = self.selection_range_for_line(pane, row, text) else {
+            return Spans::from(vec![Span::raw(text.to_string())]);
+        };
+        let len = text.chars().count();
+        if start >= end || start >= len {
+            return Spans::from(vec![Span::raw(text.to_string())]);
+        }
+        let end = end.min(len);
+        let mut spans = Vec::new();
+        if start > 0 {
+            spans.push(Span::raw(slice_chars(text, 0, start)));
+        }
+        spans.push(Span::styled(
+            slice_chars(text, start, end),
+            Style::default().add_modifier(Modifier::REVERSED),
+        ));
+        if end < len {
+            spans.push(Span::raw(slice_chars(text, end, len)));
+        }
+        Spans::from(spans)
+    }
