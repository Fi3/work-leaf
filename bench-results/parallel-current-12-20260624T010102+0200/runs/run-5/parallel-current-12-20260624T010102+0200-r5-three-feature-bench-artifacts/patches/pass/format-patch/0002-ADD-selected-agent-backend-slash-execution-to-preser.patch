+    #[test]
+    fn selected_agent_slash_commands_use_backend_command_not_prompt_send() {
+        let backend = RecordingBackend::default();
+        let calls = backend.calls.clone();
+        let mut chat = CommandChat::new(PathBuf::from("/repo"), backend);
+        let agent_id = AgentId::new("user-1").unwrap();
+
+        let status = chat.send_to_agent(&agent_id, "/status").unwrap();
+        let fork = chat.send_to_agent(&agent_id, "/fork").unwrap();
+        let ordinary = chat.send_to_agent(&agent_id, "continue").unwrap();
+
+        assert_eq!(
+            status,
+            CommandChatResult::AgentMessage {
+                agent_id: agent_id.clone(),
+                reply: "backend command output: /status".to_string(),
+            }
+        );
+        assert_eq!(
+            fork,
+            CommandChatResult::AgentMessage {
+                agent_id: agent_id.clone(),
+                reply: "backend command output: /fork".to_string(),
+            }
+        );
+        assert_eq!(
+            ordinary,
+            CommandChatResult::AgentMessage {
+                agent_id: agent_id.clone(),
+                reply: "normal send output: continue".to_string(),
+            }
+        );
+
+        let calls = calls
+            .lock()
+            .expect("recording backend calls mutex poisoned");
+        assert_eq!(calls.commands, vec!["/status", "/fork"]);
+        assert_eq!(calls.sends, vec!["continue"]);
+    }
+
+    #[derive(Clone, Default)]
+    struct RecordingBackend {
+        calls: Arc<Mutex<RecordingCalls>>,
+    }
+
+    #[derive(Default)]
+    struct RecordingCalls {
+        sends: Vec<String>,
+        commands: Vec<String>,
+    }
+
+    impl AgentBackend for RecordingBackend {
+        fn launch(&mut self, request: AgentLaunch) -> Result<AgentSession, AgentError> {
+            let mut session = AgentSession::new(request);
+            session.push_message(MessageRole::Agent, "launch reply");
+            Ok(session)
+        }
+
+        fn send(&mut self, _agent_id: &AgentId, prompt: &str) -> Result<ChatMessage, AgentError> {
+            self.calls
+                .lock()
+                .expect("recording backend calls mutex poisoned")
+                .sends
+                .push(prompt.to_string());
+            Ok(ChatMessage::new(
+                MessageRole::Agent,
+                format!("normal send output: {prompt}"),
+            ))
+        }
+
+        fn execute_command(
+            &mut self,
+            _agent_id: &AgentId,
+            command: &str,
+        ) -> Result<ChatMessage, AgentError> {
+            self.calls
+                .lock()
+                .expect("recording backend calls mutex poisoned")
+                .commands
+                .push(command.to_string());
+            Ok(ChatMessage::new(
+                MessageRole::Agent,
+                format!("backend command output: {command}"),
+            ))
+        }
+    }
 }
