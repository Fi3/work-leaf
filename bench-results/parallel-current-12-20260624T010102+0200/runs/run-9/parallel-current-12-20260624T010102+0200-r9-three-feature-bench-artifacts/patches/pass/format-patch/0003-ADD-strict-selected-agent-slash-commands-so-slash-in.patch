+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::agent::{AgentError, AgentSession, ChatMessage, MessageRole};
+    use std::path::PathBuf;
+    use std::sync::{Arc, Mutex};
+
+    #[test]
+    fn selected_agent_slash_commands_execute_through_backend_command_path() {
+        let backend = RecordingBackend::default();
+        let log = backend.log.clone();
+        let chat = CommandChat::new(PathBuf::from("."), backend);
+        let mut controller = WorkLeafController::new(chat);
+        let agent_id = controller.create_agent("").expect("agent launches");
+
+        assert!(controller.wait_for_idle(Duration::from_secs(1)));
+
+        controller
+            .send_message(&agent_id, "/status")
+            .expect("status command is accepted");
+        assert!(controller.wait_for_idle(Duration::from_secs(1)));
+        controller
+            .send_message(&agent_id, "/fork")
+            .expect("fork command is accepted");
+        assert!(controller.wait_for_idle(Duration::from_secs(1)));
+
+        let log = log.lock().expect("recording log mutex poisoned");
+        assert_eq!(
+            log.commands,
+            vec![
+                ("user-1".to_string(), "/status".to_string()),
+                ("user-1".to_string(), "/fork".to_string()),
+            ]
+        );
+        assert!(
+            log.sends
+                .iter()
+                .all(|(_, prompt)| prompt != "/status" && prompt != "/fork"),
+            "slash commands must not be delivered as ordinary backend prompts"
+        );
+        drop(log);
+
+        let snapshot = controller.snapshot();
+        let session = snapshot.session(&agent_id).expect("session is present");
+        assert!(session.lines.iter().any(|line| line == "user: /status"));
+        assert!(
+            session
+                .lines
+                .iter()
+                .any(|line| line == "backend command output: /status")
+        );
+        assert!(session.lines.iter().any(|line| line == "user: /fork"));
+        assert!(
+            session
+                .lines
+                .iter()
+                .any(|line| line == "backend command output: /fork")
+        );
+    }
+
+    #[test]
+    fn slash_followed_by_whitespace_is_an_ordinary_agent_prompt() {
+        let backend = RecordingBackend::default();
+        let log = backend.log.clone();
+        let chat = CommandChat::new(PathBuf::from("."), backend);
+        let mut controller = WorkLeafController::new(chat);
+        let agent_id = controller.create_agent("").expect("agent launches");
+
+        assert!(controller.wait_for_idle(Duration::from_secs(1)));
+        controller
+            .send_message(&agent_id, "/ status")
+            .expect("prompt is accepted");
+        assert!(controller.wait_for_idle(Duration::from_secs(1)));
+
+        let log = log.lock().expect("recording log mutex poisoned");
+        assert_eq!(log.commands, Vec::<(String, String)>::new());
+        assert_eq!(
+            log.sends,
+            vec![("user-1".to_string(), "/ status".to_string())]
+        );
+    }
+
+    #[derive(Clone, Default)]
+    struct RecordingBackend {
+        log: Arc<Mutex<RecordingLog>>,
+    }
+
+    #[derive(Default)]
+    struct RecordingLog {
+        sends: Vec<(String, String)>,
+        commands: Vec<(String, String)>,
+    }
+
+    impl AgentBackend for RecordingBackend {
+        fn launch(&mut self, request: AgentLaunch) -> Result<AgentSession, AgentError> {
+            let mut session = AgentSession::new(request);
+            session.push_message(MessageRole::Agent, "launch ready");
+            Ok(session)
+        }
+
+        fn send(&mut self, agent_id: &AgentId, prompt: &str) -> Result<ChatMessage, AgentError> {
+            self.log
+                .lock()
+                .expect("recording log mutex poisoned")
+                .sends
+                .push((agent_id.as_str().to_string(), prompt.to_string()));
+            Ok(ChatMessage::new(
+                MessageRole::Agent,
+                format!("send reply: {prompt}"),
+            ))
+        }
+
+        fn run_command(
+            &mut self,
+            agent_id: &AgentId,
+            command: &str,
+        ) -> Result<ChatMessage, AgentError> {
+            self.log
+                .lock()
+                .expect("recording log mutex poisoned")
+                .commands
+                .push((agent_id.as_str().to_string(), command.to_string()));
+            Ok(ChatMessage::new(
+                MessageRole::Agent,
+                format!("backend command output: {command}"),
+            ))
+        }
+    }
+}
