+    fn handle_visual_key(
+        &mut self,
+        key: UiKey,
+        right_content: &str,
+        right_cursor_column: Option<usize>,
+    ) -> Vec<UiAction> {
+        match key {
+            UiKey::Esc => {
+                self.mode = UiMode::Command;
+                self.visual = None;
+            }
+            UiKey::Char('v') => {
+                self.update_visual_kind(VisualKind::Character, right_content, right_cursor_column);
+            }
+            UiKey::Char('V') => {
+                self.update_visual_kind(VisualKind::Line, right_content, right_cursor_column);
+            }
+            UiKey::CtrlV => {
+                self.update_visual_kind(VisualKind::Block, right_content, right_cursor_column);
+            }
+            UiKey::Char('y') => {
+                self.copy_visual_selection(right_content, false);
+            }
+            UiKey::Char('Y') => {
+                self.copy_visual_selection(right_content, true);
+            }
+            UiKey::Char('h') | UiKey::Left => self.move_visual_cursor(0, -1),
+            UiKey::Char('j') | UiKey::Down => self.move_visual_cursor(1, 0),
+            UiKey::Char('k') | UiKey::Up => self.move_visual_cursor(-1, 0),
+            UiKey::Char('l') | UiKey::Right => self.move_visual_cursor(0, 1),
+            _ => {}
