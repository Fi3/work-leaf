+fn copied_osc52_text(frame: &str) -> String {
+    let prefix = "\u{1b}]52;c;";
+    let start = frame
+        .find(prefix)
+        .map(|index| index + prefix.len())
+        .expect("frame contains OSC52 clipboard sequence");
+    let end = frame[start..]
+        .find('\u{7}')
+        .map(|index| start + index)
+        .expect("OSC52 sequence is BEL-terminated");
+    decode_base64(&frame[start..end])
+}
+
+fn decode_base64(input: &str) -> String {
+    let mut bytes = Vec::new();
+    for chunk in input.as_bytes().chunks(4) {
+        let first = decode_base64_byte(chunk[0]);
+        let second = decode_base64_byte(chunk[1]);
+        bytes.push((first << 2) | (second >> 4));
+        if chunk.get(2) != Some(&b'=') {
+            let third = decode_base64_byte(chunk[2]);
+            bytes.push((second << 4) | (third >> 2));
+            if chunk.get(3) != Some(&b'=') {
+                let fourth = decode_base64_byte(chunk[3]);
+                bytes.push((third << 6) | fourth);
+            }
+        }
+    }
+    String::from_utf8(bytes).expect("copied test text is valid UTF-8")
+}
+
+fn decode_base64_byte(byte: u8) -> u8 {
+    match byte {
+        b'A'..=b'Z' => byte - b'A',
+        b'a'..=b'z' => byte - b'a' + 26,
+        b'0'..=b'9' => byte - b'0' + 52,
+        b'+' => 62,
+        b'/' => 63,
+        _ => panic!("invalid base64 byte in OSC52 payload"),
+    }
+}
