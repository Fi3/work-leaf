+    fn apply_visual_selection(&self, buffer: &mut Buffer) {
+        if self.mode != UiMode::Visual {
+            return;
+        }
+        let Some(visual) = self.visual.as_ref() else {
+            return;
+        };
+        let Some(rect) = self.pane_inner_rect(visual.pane) else {
+            return;
+        };
+
+        for row in 0..rect.height {
+            let Some((start_column, end_column)) =
+                self.selection_columns_for_row(visual, row, rect.width, false)
+            else {
+                continue;
+            };
+            for column in start_column..=end_column {
+                buffer
+                    .get_mut(rect.x + column, rect.y + row)
+                    .modifier
+                    .insert(Modifier::REVERSED);
+            }
+        }
+    }
+
+    fn selected_text_from_buffer(&self, buffer: &Buffer, force_line: bool) -> String {
+        let Some(visual) = self.visual.as_ref() else {
+            return String::new();
+        };
+        let Some(rect) = self.pane_inner_rect(visual.pane) else {
+            return String::new();
+        };
+
+        let mut lines = Vec::new();
+        for row in 0..rect.height {
+            let Some((start_column, end_column)) =
+                self.selection_columns_for_row(visual, row, rect.width, force_line)
+            else {
+                continue;
+            };
+            let mut line = String::new();
+            for column in start_column..=end_column {
+                line.push_str(&buffer.get(rect.x + column, rect.y + row).symbol);
+            }
+            lines.push(line.trim_end_matches(' ').to_string());
+        }
+        lines.join("\n")
+    }
+
+    fn selection_columns_for_row(
+        &self,
+        visual: &VisualSelection,
+        row: u16,
+        width: u16,
+        force_line: bool,
+    ) -> Option<(u16, u16)> {
+        if width == 0 {
+            return None;
+        }
+
+        let max_column = width - 1;
+        let row_min = visual.anchor.row.min(visual.cursor.row);
+        let row_max = visual.anchor.row.max(visual.cursor.row);
+
+        if force_line || visual.kind == VisualKind::Line {
+            return (row_min..=row_max)
+                .contains(&row)
+                .then_some((0, max_column));
+        }
+
+        if visual.kind == VisualKind::Block {
+            let column_min = visual
+                .anchor
+                .column
+                .min(visual.cursor.column)
+                .min(max_column);
+            let column_max = visual
+                .anchor
+                .column
+                .max(visual.cursor.column)
+                .min(max_column);
+            return (row_min..=row_max)
+                .contains(&row)
+                .then_some((column_min, column_max));
+        }
+
+        let (start, end) = ordered_visual_positions(visual);
+        if row < start.row || row > end.row {
+            return None;
+        }
+        if start.row == end.row {
+            return Some((start.column.min(max_column), end.column.min(max_column)));
+        }
+        if row == start.row {
+            return Some((start.column.min(max_column), max_column));
+        }
+        if row == end.row {
+            return Some((0, end.column.min(max_column)));
+        }
+        Some((0, max_column))
+    }
+
+    fn pane_inner_rect(&self, pane: PaneFocus) -> Option<Rect> {
+        let body_height = self.height.saturating_sub(1);
+        if body_height <= 2 {
+            return None;
+        }
+
+        let layout = self.layout();
+        match pane {
+            PaneFocus::Left if self.left_visible && layout.left_width > 2 => Some(Rect::new(
+                1,
+                1,
+                layout.left_width.saturating_sub(2),
+                body_height.saturating_sub(2),
+            )),
+            PaneFocus::Right if layout.right_width > 2 => {
+                let x = if layout.left_width > 0 {
+                    layout.left_width.saturating_add(1)
+                } else {
+                    1
+                };
+                Some(Rect::new(
+                    x,
+                    1,
+                    layout.right_width.saturating_sub(2),
+                    body_height.saturating_sub(2),
+                ))
+            }
+            _ => None,
+        }
+    }
