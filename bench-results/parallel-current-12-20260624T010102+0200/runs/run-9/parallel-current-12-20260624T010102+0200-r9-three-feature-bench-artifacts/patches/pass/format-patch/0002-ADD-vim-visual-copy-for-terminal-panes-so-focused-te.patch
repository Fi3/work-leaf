+fn ordered_visual_positions(visual: &VisualSelection) -> (VisualPosition, VisualPosition) {
+    if (visual.anchor.row, visual.anchor.column) <= (visual.cursor.row, visual.cursor.column) {
+        (visual.anchor, visual.cursor)
+    } else {
+        (visual.cursor, visual.anchor)
+    }
+}
+
+fn offset_visual_coordinate(value: u16, delta: isize, max: u16) -> u16 {
+    let step = delta.unsigned_abs().min(usize::from(u16::MAX)) as u16;
+    if delta.is_negative() {
+        value.saturating_sub(step).min(max)
+    } else {
+        value.saturating_add(step).min(max)
+    }
+}
