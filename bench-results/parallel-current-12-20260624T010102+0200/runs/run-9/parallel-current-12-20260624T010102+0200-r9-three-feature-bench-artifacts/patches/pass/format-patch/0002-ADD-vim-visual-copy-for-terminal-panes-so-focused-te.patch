+
+    fn current_visual_position(
+        &self,
+        right_content: &str,
+        right_cursor_column: Option<usize>,
+    ) -> Option<VisualPosition> {
+        let pane = self.focus;
+        let rect = self.pane_inner_rect(pane)?;
+        let (row, column) = match pane {
+            PaneFocus::Left => (
+                self.left_visual_cursor_row()
+                    .min(usize::from(rect.height.saturating_sub(1))) as u16,
+                0,
+            ),
+            PaneFocus::Right => {
+                let (row, column) =
+                    self.right_cursor_position_with_cursor(right_content, right_cursor_column);
+                (
+                    row.saturating_sub(1).saturating_sub(rect.y),
+                    column.saturating_sub(1).saturating_sub(rect.x),
+                )
+            }
+        };
+
+        Some(VisualPosition {
+            row: row.min(rect.height.saturating_sub(1)),
+            column: column.min(rect.width.saturating_sub(1)),
+        })
+    }
+
+    fn left_visual_cursor_row(&self) -> usize {
+        if self.control_selected == 0 {
+            return 0;
+        }
+
+        let mut current_row = 1;
+        for (visible_position, agent_index) in self.visible_agent_indices().iter().enumerate() {
+            if self.control_selected == visible_position + 1 {
+                return current_row;
+            }
+
+            current_row += 1;
+            let agent = &self.agents[*agent_index];
+            if !agent.modified_files.is_empty() {
+                current_row += 1;
+            }
+            for linked_agents in [
+                &agent.conflicting_agents,
+                &agent.depends_on,
+                &agent.depended_on_by,
+            ] {
+                if !linked_agents.is_empty() {
+                    current_row += 1;
+                }
+            }
+        }
+
+        current_row
+    }
