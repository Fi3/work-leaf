 src/terminal_app.rs  |  21 +-
 src/ui.rs            | 473 ++++++++++++++++++++++++++++++++++++++++++-
 src/ui_harness.rs    |  19 +-
 tests/ui_harness.rs  | 123 +++++++++++
 5 files changed, 624 insertions(+), 17 deletions(-)

