+    fn move_visual_cursor(&mut self, row_delta: isize, column_delta: isize) {
+        let Some(pane) = self.visual.as_ref().map(|visual| visual.pane) else {
+            return;
+        };
+        let Some(rect) = self.pane_inner_rect(pane) else {
+            return;
+        };
+        let Some(visual) = self.visual.as_mut() else {
+            return;
+        };
+        visual.cursor.row =
+            offset_visual_coordinate(visual.cursor.row, row_delta, rect.height.saturating_sub(1));
+        visual.cursor.column = offset_visual_coordinate(
+            visual.cursor.column,
