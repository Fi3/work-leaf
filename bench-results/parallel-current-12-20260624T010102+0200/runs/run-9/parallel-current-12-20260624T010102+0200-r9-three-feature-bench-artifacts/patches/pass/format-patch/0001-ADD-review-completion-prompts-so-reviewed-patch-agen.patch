+#[test]
+fn terminal_app_feature_done_prompt_closes_and_reopens_patch_chat() {
+    let root = git_repo("terminal-app-feature-done-prompt");
+    fs::write(root.join("README.md"), "before\n").unwrap();
+    Command::new("git")
+        .current_dir(&root)
+        .args(["add", "README.md"])
+        .status()
+        .unwrap();
+    Command::new("git")
+        .current_dir(&root)
+        .args(["commit", "-m", "ADD initial readme fixture"])
+        .status()
+        .unwrap();
+
+    let backend = FakeBackend::new([
+        "implemented patch\n@work-leaf patch update readme\n--- a/README.md\n+++ b/README.md\n@@ -1 +1 @@\n-before\n+after\n@work-leaf end\n@work-leaf done",
+        "summary: README changes from before to after",
+        "NO_FINDINGS",
+        "implemented second patch\n@work-leaf patch update readme again\n--- a/README.md\n+++ b/README.md\n@@ -1 +1 @@\n-after\n+after second\n@work-leaf end\n@work-leaf done",
+        "summary: README changes from after to after second",
+        "NO_FINDINGS",
+        "yes should not be sent",
+    ]);
+    let chat = CommandChat::new(root, backend.clone()).with_max_review_rounds(4);
+    let mut app = TerminalApp::new(chat, 100, 24);
+
+    app.handle_bytes(b":new update readme\n");
+    assert!(app.wait_for_idle(Duration::from_secs(2)));
+
+    assert_eq!(
+        app.ui().selected_agent().map(AgentId::as_str),
+        Some("user-1")
+    );
+    assert!(
+        app.render_frame()
+            .contains("work-leaf: is this feature done? yes/no")
+    );
+    assert!(
+        app.ui()
+            .render_left_pane()
+            .lines()
+            .any(|line| line.contains(" user-1  working:") && line.contains("READY"))
+    );
+
+    app.handle_bytes(b"yes\n");
+
+    assert!(
+        !app.ui()
+            .render_left_pane()
+            .lines()
+            .any(|line| line.contains(" user-1  working:"))
+    );
+
+    app.handle_bytes(b"needs one more tweak");
+
+    assert!(
+        app.ui()
+            .render_left_pane()
+            .lines()
+            .any(|line| line.contains(" user-1  working:"))
+    );
+
+    app.handle_bytes(b"\n");
+    assert!(app.wait_for_idle(Duration::from_secs(2)));
+
+    let sends = backend.sends();
+    assert!(sends.iter().any(|(target, prompt)| {
+        target.as_str() == "user-1" && prompt == "needs one more tweak"
+    }));
+    assert!(
+        app.render_frame()
+            .contains("work-leaf: is this feature done? yes/no")
+    );
+
+    app.handle_bytes(b"yes\n");
+
+    assert!(
+        !app.ui()
+            .render_left_pane()
+            .lines()
+            .any(|line| line.contains(" user-1  working:"))
+    );
+
+    let sends = backend.sends();
+    assert!(
+        !sends
+            .iter()
+            .any(|(target, prompt)| target.as_str() == "user-1" && prompt == "yes")
+    );
+}
