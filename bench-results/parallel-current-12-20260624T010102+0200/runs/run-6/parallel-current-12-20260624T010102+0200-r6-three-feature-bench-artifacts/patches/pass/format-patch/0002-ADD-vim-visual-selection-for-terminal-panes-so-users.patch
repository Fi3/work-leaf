+    fn update_last_right_cursor(&self, right_content: &str, cursor_column: Option<usize>) {
+        self.last_right_cursor
+            .set(self.right_visual_cursor_position(right_content, cursor_column));
+    }
+
+    fn right_visual_cursor_position(
+        &self,
+        right_content: &str,
+        cursor_column: Option<usize>,
+    ) -> VisualPosition {
+        let (width, height) = self.visual_pane_size(PaneFocus::Right);
+        let width = width.max(1);
+        let lines = right_content.lines().collect::<Vec<_>>();
+        let Some(line) = lines.last().copied() else {
+            return VisualPosition::origin();
+        };
+        let previous_rows = lines[..lines.len() - 1]
+            .iter()
+            .map(|line| visual_row_count(line, width as u16))
+            .sum::<usize>();
+        let line_chars = line.chars().count();
+        let cursor_chars = cursor_column.unwrap_or(line_chars).min(line_chars);
+        self.clamp_visual_position(
+            PaneFocus::Right,
+            VisualPosition {
+                row: previous_rows.saturating_add(cursor_chars / width),
+                column: cursor_chars % width,
+            },
+            width,
+            height,
+        )
+    }
+
+    fn handle_visual_key(&mut self, key: UiKey) -> Vec<UiAction> {
+        match key {
