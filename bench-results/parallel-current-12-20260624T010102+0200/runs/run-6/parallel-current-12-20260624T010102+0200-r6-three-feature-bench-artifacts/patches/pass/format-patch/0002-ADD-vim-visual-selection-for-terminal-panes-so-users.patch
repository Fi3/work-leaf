+            }
+            UiKey::Char('Y') => {
+                self.yank_visual_selection(true);
+                Vec::new()
+            }
+            UiKey::Char('v') => {
+                self.set_visual_selection_kind(VisualSelectionKind::Character);
+                Vec::new()
+            }
+            UiKey::Char('V') => {
+                self.set_visual_selection_kind(VisualSelectionKind::Line);
+                Vec::new()
+            }
+            UiKey::Char(CTRL_V_KEY) => {
+                self.set_visual_selection_kind(VisualSelectionKind::Block);
+                Vec::new()
+            }
+            UiKey::Char('h') | UiKey::Left => {
+                self.move_visual_cursor(0, -1);
+                Vec::new()
+            }
+            UiKey::Char('j') | UiKey::Down => {
+                self.move_visual_cursor(1, 0);
+                Vec::new()
+            }
+            UiKey::Char('k') | UiKey::Up => {
+                self.move_visual_cursor(-1, 0);
+                Vec::new()
+            }
+            UiKey::Char('l') | UiKey::Right => {
+                self.move_visual_cursor(0, 1);
+                Vec::new()
+            }
+            _ => Vec::new(),
+        }
+    }
+
+    fn start_visual_selection(&mut self, kind: VisualSelectionKind) {
+        let pane = if self.focus == PaneFocus::Left && !self.left_visible {
+            PaneFocus::Right
+        } else {
+            self.focus
+        };
+        let position = self.current_visual_position(pane);
+        self.pending = None;
+        self.mode = UiMode::Command;
+        self.visual_selection = Some(VisualSelection {
+            pane,
+            kind,
+            anchor: position,
