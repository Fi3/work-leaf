+    force_line: bool,
+) -> Option<Range<usize>> {
+    let width = width.max(1);
+    let start_row = selection.anchor.row.min(selection.cursor.row);
+    let end_row = selection.anchor.row.max(selection.cursor.row);
+    if row < start_row || row > end_row {
+        return None;
+    }
+
+    if force_line || selection.kind == VisualSelectionKind::Line {
+        return Some(0..width);
+    }
+
+    match selection.kind {
+        VisualSelectionKind::Line => Some(0..width),
+        VisualSelectionKind::Block => {
+            let start = selection
+                .anchor
+                .column
+                .min(selection.cursor.column)
+                .min(width - 1);
+            let end = selection
+                .anchor
+                .column
+                .max(selection.cursor.column)
+                .min(width - 1);
+            Some(start..end.saturating_add(1))
+        }
+        VisualSelectionKind::Character => {
+            let (start, end) = ordered_visual_positions(selection.anchor, selection.cursor);
+            if start.row == end.row {
+                let start_column = start.column.min(width - 1);
+                let end_column = end.column.min(width - 1);
+                return Some(start_column..end_column.saturating_add(1));
+            }
+            if row == start.row {
+                Some(start.column.min(width - 1)..width)
+            } else if row == end.row {
+                Some(0..end.column.min(width - 1).saturating_add(1))
+            } else {
+                Some(0..width)
+            }
+        }
+    }
+}
+
+fn ordered_visual_positions(
+    first: VisualPosition,
+    second: VisualPosition,
+) -> (VisualPosition, VisualPosition) {
+    if (first.row, first.column) <= (second.row, second.column) {
+        (first, second)
+    } else {
+        (second, first)
+    }
+}
