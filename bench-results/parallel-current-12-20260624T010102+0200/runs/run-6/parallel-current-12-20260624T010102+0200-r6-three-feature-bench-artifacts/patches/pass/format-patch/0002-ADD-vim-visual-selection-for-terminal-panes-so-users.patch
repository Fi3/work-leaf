+    fn current_visual_position(&self, pane: PaneFocus) -> VisualPosition {
+        let (width, height) = self.visual_pane_size(pane);
+        let position = match pane {
+            PaneFocus::Left => VisualPosition {
+                row: self.control_selected_content_row(),
+                column: 0,
+            },
+            PaneFocus::Right => self.last_right_cursor.get(),
+        };
+        self.clamp_visual_position(pane, position, width, height)
+    }
+
+    fn clamp_visual_position(
+        &self,
+        _pane: PaneFocus,
+        position: VisualPosition,
+        width: usize,
+        height: usize,
+    ) -> VisualPosition {
+        VisualPosition {
+            row: position.row.min(height.saturating_sub(1)),
+            column: position.column.min(width.saturating_sub(1)),
+        }
+    }
+
+    fn visual_pane_size(&self, pane: PaneFocus) -> (usize, usize) {
+        self.visual_pane_inner_rect(pane)
+            .map(|rect| (usize::from(rect.width), usize::from(rect.height)))
+            .unwrap_or((1, 1))
+    }
+
+    fn visual_pane_inner_rect(&self, pane: PaneFocus) -> Option<Rect> {
+        let layout = self.layout();
+        let body_height = self.height.saturating_sub(1);
+        if body_height <= 2 {
+            return None;
+        }
+        match pane {
+            PaneFocus::Left => {
+                if !self.left_visible || layout.left_width <= 2 {
+                    return None;
+                }
+                Some(Rect::new(1, 1, layout.left_width - 2, body_height - 2))
+            }
+            PaneFocus::Right => {
+                if layout.right_width <= 2 {
+                    return None;
+                }
+                let pane_x = if self.left_visible {
+                    layout.left_width
+                } else {
+                    0
+                };
+                Some(Rect::new(
+                    pane_x + 1,
+                    1,
+                    layout.right_width - 2,
+                    body_height - 2,
+                ))
+            }
+        }
+    }
+
+    fn visual_cursor_screen_position(&self, selection: VisualSelection) -> (u16, u16) {
+        let Some(rect) = self.visual_pane_inner_rect(selection.pane) else {
+            return (1, 1);
+        };
+        (
+            rect.y
+                .saturating_add(selection.cursor.row.min(usize::from(rect.height - 1)) as u16),
+            rect.x
+                .saturating_add(selection.cursor.column.min(usize::from(rect.width - 1)) as u16),
+        )
+    }
+
+    fn apply_visual_selection(&self, buffer: &mut Buffer) {
+        let Some(selection) = self.visual_selection else {
+            return;
+        };
+        self.apply_selection_to_buffer(buffer, &selection, false);
+    }
+
+    fn apply_selection_to_buffer(
+        &self,
+        buffer: &mut Buffer,
+        selection: &VisualSelection,
+        force_line: bool,
+    ) {
+        let Some(rect) = self.visual_pane_inner_rect(selection.pane) else {
+            return;
+        };
+        let width = usize::from(rect.width);
+        for row in 0..usize::from(rect.height) {
+            let Some(columns) = selection_column_range(selection, row, width, force_line) else {
+                continue;
+            };
+            for column in columns {
+                let x = rect.x.saturating_add(column as u16);
+                let y = rect.y.saturating_add(row as u16);
+                buffer.get_mut(x, y).modifier.insert(Modifier::REVERSED);
+            }
+        }
+    }
+
+    fn selection_text(
+        &self,
+        buffer: &Buffer,
+        selection: &VisualSelection,
+        force_line: bool,
+    ) -> String {
+        let Some(rect) = self.visual_pane_inner_rect(selection.pane) else {
+            return String::new();
+        };
+        let width = usize::from(rect.width);
+        let mut lines = Vec::new();
+        for row in 0..usize::from(rect.height) {
+            let Some(columns) = selection_column_range(selection, row, width, force_line) else {
+                continue;
+            };
+            let mut line = String::new();
+            for column in columns {
+                let x = rect.x.saturating_add(column as u16);
+                let y = rect.y.saturating_add(row as u16);
+                line.push_str(&buffer.get(x, y).symbol);
+            }
+            lines.push(line.trim_end().to_string());
+        }
+        while lines.last().is_some_and(|line| line.is_empty()) {
+            lines.pop();
+        }
+        lines.join("\n")
+    }
