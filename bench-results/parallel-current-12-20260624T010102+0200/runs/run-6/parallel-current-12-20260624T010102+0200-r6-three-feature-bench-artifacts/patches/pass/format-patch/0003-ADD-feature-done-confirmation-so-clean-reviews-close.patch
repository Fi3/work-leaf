+pub(crate) const FEATURE_DONE_PROMPT: &str = "work-leaf: Is this feature done? yes/no";
+pub(crate) const FEATURE_CLOSED_MESSAGE: &str = "work-leaf: feature closed";
+pub(crate) const FEATURE_REOPENED_MESSAGE: &str = "work-leaf: feature reopened";
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub(crate) enum FeatureCompletionResponse {
+    Done,
+    Reopen,
+    Continue,
+}
+
+pub(crate) fn feature_completion_response(message: &str) -> FeatureCompletionResponse {
+    match message.trim().to_ascii_lowercase().as_str() {
+        "yes" | "y" => FeatureCompletionResponse::Done,
+        "no" | "n" => FeatureCompletionResponse::Reopen,
+        _ => FeatureCompletionResponse::Continue,
+    }
+}
