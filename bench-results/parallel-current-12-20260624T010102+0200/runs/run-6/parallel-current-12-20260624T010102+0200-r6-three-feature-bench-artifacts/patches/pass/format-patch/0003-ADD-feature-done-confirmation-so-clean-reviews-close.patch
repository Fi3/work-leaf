+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+enum FeatureChatState {
+    None,
+    AwaitingConfirmation,
+    Closed,
+    Reopened,
+}
+
+fn session_feature_completion_state(session: &WorkLeafSession) -> FeatureChatState {
+    for (index, line) in session.lines.iter().enumerate().rev() {
+        match line.as_str() {
+            FEATURE_CLOSED_MESSAGE => return FeatureChatState::Closed,
+            FEATURE_REOPENED_MESSAGE => return FeatureChatState::Reopened,
+            _ if line.starts_with("user: ") => {
+                return previous_feature_completion_marker(&session.lines[..index])
+                    .unwrap_or(FeatureChatState::None);
+            }
+            _ if line.starts_with(FEATURE_DONE_PROMPT) => {
+                return FeatureChatState::AwaitingConfirmation;
+            }
+            _ => {}
+        }
+    }
+    FeatureChatState::None
+}
+
+fn previous_feature_completion_marker(lines: &[String]) -> Option<FeatureChatState> {
+    for line in lines.iter().rev() {
+        match line.as_str() {
+            FEATURE_CLOSED_MESSAGE | FEATURE_REOPENED_MESSAGE => {
+                return Some(FeatureChatState::Reopened);
+            }
+            _ if line.starts_with(FEATURE_DONE_PROMPT) => return Some(FeatureChatState::Reopened),
+            _ => {}
+        }
+    }
+    None
+}
