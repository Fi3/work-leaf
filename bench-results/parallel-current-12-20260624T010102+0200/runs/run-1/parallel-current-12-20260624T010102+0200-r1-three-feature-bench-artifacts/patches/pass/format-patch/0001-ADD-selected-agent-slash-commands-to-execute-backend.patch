+    fn status_command_reply(&self, agent_id: &AgentId) -> Result<String, AgentError> {
+        let state = self
+            .state
+            .lock()
+            .expect("codex backend state mutex poisoned");
+        let session = state
+            .sessions
+            .get(agent_id)
+            .ok_or_else(|| AgentError::UnknownSession(agent_id.clone()))?;
+        let thread_id = state
+            .thread_ids
+            .get(agent_id)
+            .map(String::as_str)
+            .unwrap_or("unknown");
+        Ok(format!(
+            "Codex status for {agent_id}\nfeature: {}\nstate: {:?}\nthread: {thread_id}\nmessages: {}",
+            session.feature,
+            &session.state,
+            session.messages.len()
+        ))
+    }
+
+    fn fork_command_reply(&self, agent_id: &AgentId, command: &str) -> Result<String, AgentError> {
+        let state = self
+            .state
+            .lock()
+            .expect("codex backend state mutex poisoned");
+        let session = state
+            .sessions
+            .get(agent_id)
+            .ok_or_else(|| AgentError::UnknownSession(agent_id.clone()))?;
+        let target = command.split_whitespace().nth(1).unwrap_or("new session");
+        Ok(format!(
+            "Codex fork requested for {agent_id} ({}) toward {target}; non-interactive Codex exec sessions do not expose a backend fork operation.",
+            session.feature
+        ))
+    }
+
+    fn unsupported_command_reply(
+        &self,
+        agent_id: &AgentId,
+        token: &str,
+    ) -> Result<String, AgentError> {
+        let state = self
+            .state
+            .lock()
+            .expect("codex backend state mutex poisoned");
+        if !state.sessions.contains_key(agent_id) {
+            return Err(AgentError::UnknownSession(agent_id.clone()));
+        }
+        Ok(format!(
+            "Codex backend command `{token}` is not supported for {agent_id}."
+        ))
+    }
+
+    fn record_backend_command_reply(
+        &mut self,
+        agent_id: &AgentId,
+        command: &str,
+        reply: String,
+    ) -> Result<ChatMessage, AgentError> {
+        let message = ChatMessage::new(MessageRole::Agent, reply);
+        let mut state = self
+            .state
+            .lock()
+            .expect("codex backend state mutex poisoned");
+        let session = state
+            .sessions
+            .get_mut(agent_id)
+            .ok_or_else(|| AgentError::UnknownSession(agent_id.clone()))?;
+        session.push_message(MessageRole::User, command);
+        session.messages.push(message.clone());
+        Ok(message)
+    }
