+#[test]
+fn scripted_harness_feature_done_prompt_closes_or_reopens_chat() {
+    let mut harness = UiHarness::new(100, 24);
+    harness
+        .mark_feature_review_done("user-1")
+        .expect("fixture user-1 agent is registered");
+
+    let done_frame = harness.render_frame();
+    assert!(done_frame.contains("work-leaf: is this feature done? yes/no"));
+    assert!(
+        harness
+            .ui()
+            .render_left_pane()
+            .contains("\u{1b}[7m>parser user-1")
+    );
+
+    harness.handle_bytes(b"yes\n");
+    assert!(!harness.ui().render_left_pane().contains("parser user-1"));
+
+    let mut harness = UiHarness::new(100, 24);
+    harness
+        .mark_feature_review_done("user-1")
+        .expect("fixture user-1 agent is registered");
+
+    harness.handle_bytes(b"please adjust the parser\n");
+    assert!(harness.ui().render_left_pane().contains("parser user-1"));
+    assert!(
+        harness
+            .transcript()
+            .iter()
+            .any(|line| line == "user-1> please adjust the parser")
+    );
+}
