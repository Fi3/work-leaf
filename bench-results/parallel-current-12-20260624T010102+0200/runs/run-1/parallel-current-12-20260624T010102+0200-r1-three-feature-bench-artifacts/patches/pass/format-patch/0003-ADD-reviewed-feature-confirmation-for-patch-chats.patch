+fn session_awaits_feature_done(session: &WorkLeafSession) -> bool {
+    session.loading.is_none()
+        && session
+            .lines
+            .iter()
+            .rev()
+            .find(|line| !line.trim().is_empty())
+            .is_some_and(|line| line == FEATURE_DONE_PROMPT)
+}
+
+fn feature_done_answer_is_yes(message: &str) -> bool {
+    message.trim().eq_ignore_ascii_case("yes")
