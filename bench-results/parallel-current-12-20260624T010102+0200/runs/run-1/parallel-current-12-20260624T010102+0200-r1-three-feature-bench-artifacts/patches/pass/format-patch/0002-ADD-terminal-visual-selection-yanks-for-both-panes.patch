+
+fn selected_range(
+    selection: VisualSelection,
+    row: usize,
+    line_len: usize,
+) -> Option<std::ops::Range<usize>> {
+    let top = selection.anchor.row.min(selection.cursor.row);
+    let bottom = selection.anchor.row.max(selection.cursor.row);
+    if row < top || row > bottom {
+        return None;
+    }
+    match selection.kind {
+        VisualSelectionKind::Line => Some(0..line_len),
+        VisualSelectionKind::Block => {
+            let start = selection
+                .anchor
+                .column
+                .min(selection.cursor.column)
+                .min(line_len);
+            let end = selection
+                .anchor
+                .column
+                .max(selection.cursor.column)
+                .saturating_add(1)
+                .min(line_len);
+            (start < end).then_some(start..end)
+        }
+        VisualSelectionKind::Character => character_selected_range(selection, row, line_len),
+    }
+}
+
+fn character_selected_range(
+    selection: VisualSelection,
+    row: usize,
+    line_len: usize,
+) -> Option<std::ops::Range<usize>> {
+    let (start, end) = ordered_cursors(selection.anchor, selection.cursor);
+    if row < start.row || row > end.row {
+        return None;
+    }
+    if start.row == end.row {
+        let range_start = start.column.min(line_len);
+        let range_end = end.column.saturating_add(1).min(line_len);
+        return (range_start < range_end).then_some(range_start..range_end);
+    }
+    if row == start.row {
+        let range_start = start.column.min(line_len);
+        return (range_start < line_len).then_some(range_start..line_len);
+    }
+    if row == end.row {
+        let range_end = end.column.saturating_add(1).min(line_len);
+        return (range_end > 0).then_some(0..range_end);
+    }
+    Some(0..line_len)
+}
+
+fn ordered_cursors(left: TextCursor, right: TextCursor) -> (TextCursor, TextCursor) {
+    if (left.row, left.column) <= (right.row, right.column) {
+        (left, right)
+    } else {
+        (right, left)
+    }
+}
+
+fn selected_text(lines: &[String], selection: VisualSelection, force_line: bool) -> Option<String> {
+    if lines.is_empty() {
+        return None;
+    }
+    let top = selection
+        .anchor
+        .row
+        .min(selection.cursor.row)
+        .min(lines.len() - 1);
+    let bottom = selection
+        .anchor
+        .row
+        .max(selection.cursor.row)
+        .min(lines.len() - 1);
+    let kind = if force_line {
+        VisualSelectionKind::Line
+    } else {
+        selection.kind
+    };
+    let selected = match kind {
+        VisualSelectionKind::Line => lines[top..=bottom].join("\n"),
+        VisualSelectionKind::Block => (top..=bottom)
+            .map(|row| {
+                let start = selection.anchor.column.min(selection.cursor.column);
+                let end = selection.anchor.column.max(selection.cursor.column);
+                char_range(&lines[row], start, end.saturating_add(1))
+            })
+            .collect::<Vec<_>>()
+            .join("\n"),
+        VisualSelectionKind::Character => character_selected_text(lines, selection),
+    };
+    Some(selected)
+}
+
+fn character_selected_text(lines: &[String], selection: VisualSelection) -> String {
+    let (start, end) = ordered_cursors(selection.anchor, selection.cursor);
+    let start_row = start.row.min(lines.len() - 1);
+    let end_row = end.row.min(lines.len() - 1);
+    if start_row == end_row {
+        return char_range(
+            &lines[start_row],
+            start.column,
+            end.column.saturating_add(1),
+        );
+    }
+    let mut selected = Vec::new();
+    selected.push(char_range(
+        &lines[start_row],
+        start.column,
+        lines[start_row].chars().count(),
+    ));
+    for line in lines.iter().take(end_row).skip(start_row + 1) {
+        selected.push(line.clone());
+    }
+    selected.push(char_range(&lines[end_row], 0, end.column.saturating_add(1)));
+    selected.join("\n")
+}
+
+fn chars_before(text: &str, end: usize) -> String {
+    text.chars().take(end).collect()
+}
+
+fn chars_between(text: &str, start: usize, end: usize) -> String {
+    text.chars()
+        .skip(start)
+        .take(end.saturating_sub(start))
+        .collect()
+}
+
+fn chars_after(text: &str, start: usize) -> String {
+    text.chars().skip(start).collect()
+}
+
+fn char_range(text: &str, start: usize, end: usize) -> String {
+    text.chars()
+        .skip(start)
+        .take(end.saturating_sub(start))
+        .collect()
+}
+
+fn base64_encode(bytes: &[u8]) -> String {
+    const TABLE: &[u8; 64] = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    let mut encoded = String::new();
+    for chunk in bytes.chunks(3) {
+        let first = chunk[0];
+        let second = chunk.get(1).copied().unwrap_or(0);
+        let third = chunk.get(2).copied().unwrap_or(0);
+        encoded.push(TABLE[(first >> 2) as usize] as char);
+        encoded.push(TABLE[(((first & 0b0000_0011) << 4) | (second >> 4)) as usize] as char);
+        if chunk.len() > 1 {
+            encoded.push(TABLE[(((second & 0b0000_1111) << 2) | (third >> 6)) as usize] as char);
+        } else {
+            encoded.push('=');
+        }
+        if chunk.len() > 2 {
+            encoded.push(TABLE[(third & 0b0011_1111) as usize] as char);
+        } else {
+            encoded.push('=');
+        }
+    }
+    encoded
+}
