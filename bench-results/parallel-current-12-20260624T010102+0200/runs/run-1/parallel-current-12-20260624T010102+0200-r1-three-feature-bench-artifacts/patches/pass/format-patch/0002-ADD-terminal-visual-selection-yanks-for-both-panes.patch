+    fn start_visual_selection(
+        &mut self,
+        kind: VisualSelectionKind,
+        right_content: &str,
+        right_cursor_column: Option<usize>,
+    ) {
+        if self.mode != UiMode::Command {
+            return;
+        }
+        let cursor = match self.focus {
+            PaneFocus::Left => TextCursor {
+                row: self.left_visual_cursor_row(),
+                column: 0,
+            },
+            PaneFocus::Right => self.right_visual_cursor(right_content, right_cursor_column),
+        };
+        self.visual_selection = Some(VisualSelection {
+            pane: self.focus,
+            kind,
+            anchor: cursor,
+            cursor,
+        });
+    }
+
+    fn right_visual_cursor(
+        &self,
+        right_content: &str,
+        right_cursor_column: Option<usize>,
+    ) -> TextCursor {
+        let visible_content = self.visible_right_content(right_content);
+        let lines = text_lines(&visible_content);
+        let Some(line) = lines.last() else {
+            return TextCursor { row: 0, column: 0 };
+        };
+        TextCursor {
+            row: lines.len().saturating_sub(1),
+            column: right_cursor_column
+                .unwrap_or_else(|| line.chars().count())
+                .min(line.chars().count()),
+        }
+    }
+
+    fn left_visual_cursor_row(&self) -> usize {
+        if self.control_selected == 0 {
+            return 0;
+        }
+
+        let mut rendered_row = 1;
+        for (visible_position, agent_index) in self.visible_agent_indices().iter().enumerate() {
+            if self.control_selected == visible_position + 1 {
+                return rendered_row;
+            }
+            rendered_row += 1;
+            let agent = &self.agents[*agent_index];
+            if !agent.modified_files.is_empty() {
+                rendered_row += 1;
+            }
+            for linked_agents in [
+                &agent.conflicting_agents,
+                &agent.depends_on,
+                &agent.depended_on_by,
+            ] {
+                if !linked_agents.is_empty() {
+                    rendered_row += 1;
+                }
+            }
+        }
+
+        rendered_row.saturating_sub(1)
+    }
+
+    fn clear_visual_selection(&mut self) {
+        self.visual_selection = None;
+    }
+
+    fn selection_lines(&self, pane: PaneFocus, right_content: &str) -> Vec<String> {
+        match pane {
+            PaneFocus::Left => self
+                .left_widget_lines(usize::from(
+                    self.layout().left_width.saturating_sub(2).max(1),
+                ))
+                .into_iter()
+                .map(|line| line.text)
+                .collect(),
+            PaneFocus::Right => text_lines(&self.visible_right_content(right_content))
+                .into_iter()
+                .map(ToString::to_string)
+                .collect(),
+        }
+    }
+
+    fn left_widget_lines(&self, inner_width: usize) -> Vec<LeftWidgetLine> {
+        let mut lines = vec![LeftWidgetLine {
+            text: if self.control_selected == 0 {
+                "> work-leaf  command".to_string()
+            } else {
+                "  work-leaf  command".to_string()
+            },
+            reversed: false,
+        }];
+        for (visible_position, agent_index) in self.visible_agent_indices().iter().enumerate() {
+            let agent = &self.agents[*agent_index];
+            let selected = self.control_selected == visible_position + 1;
+            lines.push(LeftWidgetLine {
+                text: compact_agent_row(agent, selected, inner_width),
+                reversed: agent.ready,
+            });
+            if !agent.modified_files.is_empty() {
+                lines.push(LeftWidgetLine {
+                    text: format!(
+                        "    files: {}",
+                        agent
+                            .modified_files
+                            .iter()
+                            .map(|path| path.display().to_string())
+                            .collect::<Vec<_>>()
+                            .join(", ")
+                    ),
+                    reversed: false,
+                });
+            }
+            for (label, agents) in [
+                ("conflicts", &agent.conflicting_agents),
+                ("depends-on", &agent.depends_on),
+                ("depended-on-by", &agent.depended_on_by),
+            ] {
+                if !agents.is_empty() {
