diff --git a/tests/ui_harness.rs b/tests/ui_harness.rs
index 3502bcf..623998e 100644
--- a/tests/ui_harness.rs
+++ b/tests/ui_harness.rs
@@ -348,6 +348,67 @@ fn scripted_harness_visual_mode_yanks_right_pane_line_to_clipboard() {
     assert!(frame.contains("copied "));
 }
 
+#[test]
+fn scripted_harness_visual_mode_yanks_left_pane_character_selection_to_clipboard() {
+    let mut harness = UiHarness::new(80, 24);
+
+    assert_eq!(harness.ui().focus(), PaneFocus::Left);
+
+    harness.handle_byte(b'v');
+
+    assert!(harness.ui().visual_selection_active());
+    assert!(
+        harness
+            .render_frame()
+            .contains("mode=visual-char focus=left")
+    );
+
+    harness.handle_bytes(b"lly");
+
+    assert_eq!(harness.ui().copied_text(), Some(">us"));
+}
+
+#[test]
+fn scripted_harness_visual_mode_yanks_left_pane_line_to_clipboard() {
+    let mut harness = UiHarness::new(80, 24);
+
+    assert_eq!(harness.ui().focus(), PaneFocus::Left);
+
+    harness.handle_byte(b'V');
+
+    assert!(harness.ui().visual_selection_active());
+    assert!(
+        harness
+            .render_frame()
+            .contains("mode=visual-line focus=left")
+    );
+
+    harness.handle_byte(b'Y');
+
+    assert_eq!(harness.ui().copied_text(), Some(">user-1 READY"));
+}
+
+#[test]
+fn scripted_harness_visual_mode_yanks_left_pane_block_to_clipboard() {
+    let mut harness = UiHarness::new(80, 24);
+
+    assert_eq!(harness.ui().focus(), PaneFocus::Left);
+
+    harness.handle_byte(22);
+
+    assert!(harness.ui().visual_selection_active());
+    assert!(
+        harness
+            .render_frame()
+            .contains("mode=visual-block focus=left")
+    );
+
+    harness.handle_bytes(b"llj");
+    harness.handle_byte(b'y');
+
+    assert_eq!(harness.ui().copied_text(), Some(">us\n   "));
+}
+
