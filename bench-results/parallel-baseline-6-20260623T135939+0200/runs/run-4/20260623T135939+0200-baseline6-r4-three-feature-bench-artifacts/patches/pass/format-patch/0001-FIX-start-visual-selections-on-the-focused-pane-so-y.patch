From 5b314c651090ec6a583b57932636a85481e3cd03 Mon Sep 17 00:00:00 2001
From: fi3 <you@example.com>
Date: Tue, 23 Jun 2026 14:18:29 +0200
Subject: [PATCH 1/3] FIX start visual selections on the focused pane so yanks
 use rendered rows

Command-mode visual selection starts in the pane that owns focus, and left-pane selection anchors use the rendered row instead of the control ordinal. Visual movement also clamps stale rows before edge scrolling so chat-history windows keep moving after the visible row changes.
---
 src/ui.rs            | 25 ++++++++++++----
 tests/terminal_ui.rs | 27 +++++------------
 tests/ui_harness.rs  | 69 +++++++++++++++++++++++++++++++++++++++++---
 3 files changed, 91 insertions(+), 30 deletions(-)

diff --git a/src/ui.rs b/src/ui.rs
index 620b15c..7153d74 100644
--- a/src/ui.rs
+++ b/src/ui.rs
@@ -669,6 +669,11 @@ impl TerminalUi {
             }
             UiKey::Char('v') if self.mode == UiMode::Command => {
                 self.start_visual_cursor(visible_right_content, right_cursor_column);
+                self.start_visual_selection(
+                    VisualSelectionMode::Character,
+                    visible_right_content,
+                    right_cursor_column,
+                );
                 Vec::new()
             }
             UiKey::Char('V') if self.mode == UiMode::Command => {
@@ -1190,7 +1195,9 @@ impl TerminalUi {
         match self.focus {
             PaneFocus::Left => {
                 let lines = self.visual_pane_lines(visible_right_content, PaneFocus::Left);
-                let row = self.control_selected.min(lines.len().saturating_sub(1));
+                let row = self
+                    .control_selected_line_row()
+                    .min(lines.len().saturating_sub(1));
                 VisualPoint { row, column: 0 }
             }
             PaneFocus::Right => {
@@ -1250,7 +1257,8 @@ impl TerminalUi {
             return;
         }
         let max_row = lines.len().saturating_sub(1) as isize;
-        let requested_row = point.row as isize + row_delta;
+        let current_row = point.row.min(lines.len().saturating_sub(1));
+        let requested_row = current_row as isize + row_delta;
         if pane == PaneFocus::Right {
             if requested_row < 0 && self.scroll_right_visual_view(right_content, true) {
                 return;
@@ -2048,12 +2056,12 @@ impl TerminalUi {
             .or_else(|| self.selected_agent.clone())
     }
 
-    fn control_cursor_row(&self) -> u16 {
+    fn control_selected_line_row(&self) -> usize {
         let target = if self.control_selected == 0 {
             LeftPaneClickTarget::Command
         } else {
             let Some(agent_id) = self.control_selected_agent_id() else {
-                return 2;
+                return 0;
             };
             LeftPaneClickTarget::Agent(agent_id)
         };
@@ -2061,8 +2069,13 @@ impl TerminalUi {
         self.left_pane_lines(inner_width)
             .iter()
             .position(|line| line.control_target.as_ref() == Some(&target))
-            .map(|row| (row + 2).min(usize::from(u16::MAX)) as u16)
-            .unwrap_or(2)
+            .unwrap_or(0)
+    }
+
+    fn control_cursor_row(&self) -> u16 {
+        self.control_selected_line_row()
+            .saturating_add(2)
+            .min(usize::from(u16::MAX)) as u16
     }
 
     fn right_cursor_position_with_cursor(
