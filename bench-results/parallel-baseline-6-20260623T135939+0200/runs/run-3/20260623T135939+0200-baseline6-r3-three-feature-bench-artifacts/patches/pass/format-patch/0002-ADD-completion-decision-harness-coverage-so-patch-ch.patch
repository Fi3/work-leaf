+#[test]
+fn scripted_harness_completion_question_highlights_closes_and_reopens_patch_chat() {
+    let mut harness = UiHarness::new(100, 24);
+
+    harness
+        .mark_agent_needs_completion_decision("user-2", "tests")
+        .expect("fixture user-2 agent is registered");
+
+    assert_eq!(
+        harness.ui().selected_agent().map(|id| id.as_str()),
+        Some("user-2")
+    );
+    let question_frame = harness.render_frame();
+    assert!(question_frame.starts_with('\u{7}'));
+    assert!(question_frame.contains("work-leaf: is this feature done? [yes/no]"));
+    assert!(
+        harness
+            .ui()
+            .render_left_pane()
+            .contains("\u{1b}[7m>tests DONE? user-2  working: tests DONE?  READY\u{1b}[0m")
+    );
+    assert!(!harness.render_frame().starts_with('\u{7}'));
+
+    harness.handle_bytes(b"yes\n");
+
+    let closed_left_pane = strip_ansi(&harness.ui().render_left_pane());
+    assert!(closed_left_pane.contains("[closed]\n>tests CLOSED user-2  working: tests CLOSED"));
+    assert!(!closed_left_pane.contains("tests CLOSED  READY"));
+
+    harness.handle_bytes(b"follow up\n");
+
+    let reopened_left_pane = strip_ansi(&harness.ui().render_left_pane());
+    assert!(!reopened_left_pane.contains("[closed]\n>tests CLOSED"));
+    assert!(reopened_left_pane.contains("[working]\n>tests user-2  working: tests"));
+}
