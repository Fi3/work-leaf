+    fn handle_completion_message(&mut self, agent_id: &AgentId, message: &str) -> bool {
+        let Some(completion) = self.completion_states.get(agent_id).cloned() else {
+            return false;
+        };
+
+        self.transcript.push(format!("{agent_id}> {message}"));
+        match completion.state {
+            HarnessCompletion::NeedsDecision if message.eq_ignore_ascii_case("yes") => {
+                let _ = self.set_agent_completion_state(
+                    agent_id,
+                    completion.feature,
+                    HarnessCompletion::Closed,
+                );
+                self.transcript
+                    .push("work-leaf: feature marked closed".to_string());
+            }
+            HarnessCompletion::NeedsDecision if message.eq_ignore_ascii_case("no") => {
+                self.clear_agent_completion_state(agent_id, completion.feature);
+                self.transcript
+                    .push("work-leaf: feature remains open".to_string());
+            }
+            HarnessCompletion::NeedsDecision => {
+                self.transcript
+                    .push("work-leaf: answer yes or no to close this feature".to_string());
+            }
+            HarnessCompletion::Closed => {
+                self.clear_agent_completion_state(agent_id, completion.feature);
+                self.transcript
+                    .push("fixture reply: message recorded".to_string());
+            }
+        }
+        true
+    }
+
+    fn set_agent_completion_state(
+        &mut self,
+        agent_id: &AgentId,
+        feature: String,
+        state: HarnessCompletion,
+    ) -> Result<(), String> {
+        let display_feature = match state {
+            HarnessCompletion::NeedsDecision => format!("{feature} DONE?"),
+            HarnessCompletion::Closed => format!("{feature} CLOSED"),
+        };
+        self.ui.set_agent_feature(agent_id, display_feature)?;
+        self.ui
+            .set_agent_patch_lifecycle(agent_id, true, state == HarnessCompletion::Closed)?;
+        self.ui
+            .set_agent_ready_state(agent_id, state == HarnessCompletion::NeedsDecision)?;
+        self.completion_states
+            .insert(agent_id.clone(), HarnessCompletionState { feature, state });
+        Ok(())
+    }
+
+    fn clear_agent_completion_state(&mut self, agent_id: &AgentId, feature: String) {
+        self.completion_states.remove(agent_id);
+        let _ = self.ui.set_agent_feature(agent_id, feature);
+        let _ = self.ui.set_agent_patch_lifecycle(agent_id, true, false);
+        let _ = self.ui.set_agent_ready_state(agent_id, false);
+    }
+
     fn clear_prompt_edit_state(&mut self) {
