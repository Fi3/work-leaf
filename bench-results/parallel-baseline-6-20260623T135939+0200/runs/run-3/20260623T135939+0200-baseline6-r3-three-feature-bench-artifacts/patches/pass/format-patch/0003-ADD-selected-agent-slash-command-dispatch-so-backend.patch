+            kind: AgentKind::Codex,
+            title: "user-1".to_string(),
+            feature: "status command".to_string(),
+            lines: Vec::new(),
+            loading: None,
+            completion: None,
+            token_usage: None,
+            depends_on: Vec::new(),
