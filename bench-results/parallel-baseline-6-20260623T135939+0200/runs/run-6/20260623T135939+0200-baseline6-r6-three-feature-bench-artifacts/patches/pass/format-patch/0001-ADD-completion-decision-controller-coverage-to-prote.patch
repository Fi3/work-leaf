From 5b16570ce9b154c100bb0a7568ebd1e09ad1f631 Mon Sep 17 00:00:00 2001
From: fi3 <you@example.com>
Date: Tue, 23 Jun 2026 14:16:54 +0200
Subject: [PATCH 1/3] ADD completion-decision controller coverage to protect
 reviewed chat closure

Cover the controller paths that clear loading when a clean review asks for a yes/no decision, close the patch chat on yes, and reopen it when the user sends a later follow-up. This keeps the reviewed completion gate behavior tested before linearization can depend on closed chats.
---
 src/workspace.rs | 69 ++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 69 insertions(+)

diff --git a/src/workspace.rs b/src/workspace.rs
index 72d6ce4..f5e8fb8 100644
--- a/src/workspace.rs
+++ b/src/workspace.rs
@@ -2214,6 +2214,10 @@ mod tests {
         fn launches(&self) -> Vec<AgentLaunch> {
             self.state.lock().unwrap().launches.clone()
         }
+
+        fn sends(&self) -> Vec<(AgentId, String)> {
+            self.state.lock().unwrap().sends.clone()
+        }
     }
 
     impl AgentBackend for ScriptedBackend {
@@ -2285,6 +2289,71 @@ mod tests {
         assert!(!controller.implicit_loading_agents.contains_key(&agent_id));
     }
 
+    #[test]
+    fn feature_done_yes_closes_and_later_message_reopens_patch_chat() {
+        let backend = ScriptedBackend::new(["follow-up accepted", "follow-up title"]);
+        let chat = CommandChat::new(PathBuf::from("/repo"), backend.clone());
+        let mut controller = WorkLeafController::new(chat);
+        let agent_id = AgentId::new("user-1").expect("test agent id is valid");
+
+        controller.register_agent_feature(agent_id.clone(), "visual mode".to_string());
+        controller.add_session(WorkLeafSession {
+            id: agent_id.clone(),
+            kind: AgentKind::Codex,
+            title: "user-1".to_string(),
+            feature: "visual mode".to_string(),
+            lines: vec![FEATURE_DONE_QUESTION.to_string()],
+            loading: None,
+            completion: Some(WorkLeafCompletion::NeedsDecision),
+            token_usage: None,
+            depends_on: Vec::new(),
+            depended_on_by: Vec::new(),
+        });
+
+        controller
+            .send_message(&agent_id, "yes")
+            .expect("completion answer is accepted");
+
+        let snapshot = controller.snapshot();
+        let session = snapshot
+            .session(&agent_id)
+            .expect("patch agent session exists");
+        assert_eq!(session.completion, Some(WorkLeafCompletion::Closed));
+        assert!(
+            session
+                .lines
+                .iter()
+                .any(|line| line == "work-leaf: feature marked closed"),
+            "{session:?}"
+        );
+        assert!(
+            backend.sends().is_empty(),
+            "yes should close the feature without sending a backend turn"
+        );
+
+        controller
+            .send_message(&agent_id, "handle one more case")
+            .expect("closed patch chat accepts follow-up text");
+        assert!(controller.wait_for_idle(Duration::from_secs(1)));
+
+        let snapshot = controller.snapshot();
+        let session = snapshot
+            .session(&agent_id)
+            .expect("patch agent session exists");
+        assert_eq!(session.completion, None);
+        assert!(
+            session
+                .lines
+                .iter()
+                .any(|line| line == "user: handle one more case"),
+            "{session:?}"
+        );
+        assert_eq!(
+            backend.sends(),
+            vec![(agent_id, "handle one more case".to_string())]
+        );
+    }
+
     #[test]
     fn non_user_patch_agent_done_starts_review_and_completion_question() {
         let root = git_repo("workspace-non-user-review-completion");
