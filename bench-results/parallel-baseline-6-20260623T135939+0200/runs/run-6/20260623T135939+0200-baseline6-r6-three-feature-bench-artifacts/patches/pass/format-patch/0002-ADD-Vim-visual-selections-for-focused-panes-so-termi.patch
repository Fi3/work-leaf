+    fn yank_visual_cursor_character(&mut self, visible_right_content: &str) {
+        let Some(cursor) = self.visual_cursor.clone() else {
+            return;
+        };
+        let lines = self.visual_pane_lines(visible_right_content, cursor.pane);
+        if lines.is_empty() {
+            return;
+        }
+        let selection = VisualSelection {
+            pane: cursor.pane,
+            mode: VisualSelectionMode::Character,
+            anchor: cursor.point,
+            cursor: cursor.point,
+        };
+        self.copy_text_to_clipboard(extract_visual_text(&lines, &selection, false));
+    }
+
