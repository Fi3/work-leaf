+#[test]
+fn scripted_harness_visual_mode_yanks_left_pane_focused_row_to_clipboard() {
+    let mut harness = UiHarness::new(80, 24);
+
+    harness.handle_byte(b'V');
+
+    assert!(
+        harness
+            .render_frame()
+            .contains("mode=visual-line focus=left")
+    );
+
+    harness.handle_byte(b'Y');
+
+    assert_eq!(harness.ui().copied_text(), Some(">user-1 READY"));
+}
+
+#[test]
+fn scripted_harness_visual_mode_v_motion_yanks_right_pane_character_selection() {
+    let mut harness = UiHarness::new(80, 24);
+
+    harness.handle_bytes(&[23, b'l']);
+    harness.handle_byte(b'v');
+    harness.handle_bytes(b"llll");
+
+    assert!(
+        harness
+            .render_frame()
+            .contains("mode=visual-char focus=right")
+    );
+
+    harness.handle_byte(b'y');
+
+    assert_eq!(harness.ui().copied_text(), Some("Esc c"));
+}
+
+#[test]
+fn scripted_harness_visual_mode_v_vertical_motion_yanks_right_pane_character_selection() {
+    let mut harness = UiHarness::new(80, 24);
+    let expected =
+        "Esc command, i insert, : prompt, Ctrl-W h/j/k/l focus, , focus/toggle left, q quit\nc";
+
+    harness.handle_bytes(&[23, b'l']);
+    harness.handle_byte(b'v');
+    harness.handle_byte(b'j');
+
+    assert!(
+        harness
+            .render_frame()
+            .contains("mode=visual-char focus=right")
+    );
+
+    harness.handle_byte(b'y');
+
+    assert_eq!(harness.ui().copied_text(), Some(expected));
+}
+
+#[test]
+fn scripted_harness_visual_mode_v_vertical_motion_yanks_left_pane_character_selection() {
+    let mut harness = UiHarness::new(80, 24);
+
+    harness.handle_byte(b'v');
+    harness.handle_byte(b'j');
+
+    assert!(
+        harness
+            .render_frame()
+            .contains("mode=visual-char focus=left")
+    );
+
+    harness.handle_byte(b'y');
+
+    assert_eq!(harness.ui().copied_text(), Some(">user-1 READY\n "));
+}
+
+#[test]
+fn scripted_harness_visual_mode_ctrl_v_yanks_right_pane_block_selection() {
+    let mut harness = UiHarness::new(80, 24);
+
+    harness.handle_bytes(&[23, b'l']);
+    harness.handle_byte(22);
+    harness.handle_byte(b'j');
+    harness.handle_byte(b'l');
+
+    assert!(
+        harness
+            .render_frame()
+            .contains("mode=visual-block focus=right")
+    );
+
+    harness.handle_byte(b'y');
+
+    assert_eq!(harness.ui().copied_text(), Some("Es\nch"));
+}
