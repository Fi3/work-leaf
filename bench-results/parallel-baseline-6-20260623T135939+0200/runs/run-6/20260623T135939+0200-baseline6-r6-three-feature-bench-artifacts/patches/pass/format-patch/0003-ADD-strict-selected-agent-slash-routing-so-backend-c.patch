+    fn start_agent_command_worker(&mut self, agent_id: AgentId, command: String) {
+        self.start_agent_command_worker_with_user_line(agent_id, command, true);
+    }
+
+    fn start_agent_command_worker_without_user_line(&mut self, agent_id: AgentId, command: String) {
+        self.start_agent_command_worker_with_user_line(agent_id, command, false);
+    }
+
+    fn start_agent_command_worker_with_user_line(
+        &mut self,
+        agent_id: AgentId,
+        command: String,
+        append_user_line: bool,
+    ) {
+        self.set_session_loading(&agent_id, Some(WorkLeafLoading::WaitingForReply));
+        if append_user_line {
+            self.append_agent_line(&agent_id, format!("user: {command}"));
+        }
+        self.start_worker(Some(agent_id.clone()), move |mut chat, sender| {
+            match chat.execute_agent_command(&agent_id, &command) {
+                Ok(result) => {
+                    let _ = sender.send(WorkerEvent::Complete {
+                        agent_id: Some(agent_id),
+                        result,
+                        streamed_agent_ids: BTreeSet::new(),
+                    });
+                }
+                Err(error) => {
+                    let _ = sender.send(WorkerEvent::Error {
+                        agent_id: Some(agent_id),
+                        message: command_chat_error_text(&error),
+                        streamed_agent_ids: BTreeSet::new(),
+                    });
+                }
+            }
+        });
+    }
+
     fn start_send_worker_without_user_line(&mut self, agent_id: AgentId, message: String) {
         self.start_send_worker_with_user_line(agent_id, message, false);
     }
