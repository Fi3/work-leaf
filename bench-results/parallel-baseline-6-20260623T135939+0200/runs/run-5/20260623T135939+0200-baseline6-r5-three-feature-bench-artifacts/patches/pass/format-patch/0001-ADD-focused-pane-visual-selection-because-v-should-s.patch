diff --git a/tests/ui_harness.rs b/tests/ui_harness.rs
index 3502bcf..b3b95f5 100644
--- a/tests/ui_harness.rs
+++ b/tests/ui_harness.rs
@@ -348,6 +348,82 @@ fn scripted_harness_visual_mode_yanks_right_pane_line_to_clipboard() {
     assert!(frame.contains("copied "));
 }
 
+#[test]
+fn scripted_harness_visual_v_selects_and_yanks_left_pane_text() {
+    let mut harness = UiHarness::new(80, 24);
+
+    harness.handle_byte(b'v');
+
+    assert!(harness.ui().visual_selection_active());
+    assert!(
+        harness
+            .render_frame()
+            .contains("mode=visual-char focus=left")
+    );
+
+    harness.handle_bytes(b"lll");
+    harness.handle_byte(b'y');
+
+    assert_eq!(harness.ui().copied_text(), Some(">use"));
+    assert!(harness.render_frame().starts_with("\u{1b}]52;c;"));
+}
+
+#[test]
+fn scripted_harness_visual_line_yanks_left_pane_rows_to_clipboard() {
+    let mut harness = UiHarness::new(80, 24);
+
+    harness.handle_byte(b'V');
+    harness.handle_byte(b'j');
+    harness.handle_byte(b'Y');
+
+    assert_eq!(
+        harness.ui().copied_text(),
+        Some(">user-1 READY\n    files: src/parser.rs")
+    );
+}
+
+#[test]
+fn scripted_harness_visual_block_yanks_right_pane_columns_to_clipboard() {
+    let mut harness = UiHarness::new(80, 24);
+
+    harness.handle_bytes(&[23, b'l']);
+    harness.handle_byte(22);
+
+    assert!(
+        harness
+            .render_frame()
+            .contains("mode=visual-block focus=right")
+    );
+
+    harness.handle_byte(b'l');
+    harness.handle_byte(b'j');
+    harness.handle_byte(b'y');
+
+    assert_eq!(harness.ui().copied_text(), Some("Es\nch"));
+}
+
+#[test]
+fn scripted_harness_visual_v_extends_across_right_pane_jumps_before_yank() {
+    let mut harness = UiHarness::new(80, 10);
+
+    harness.handle_bytes(&[23, b'l']);
+    harness.handle_byte(b'i');
+    for index in 0..12 {
+        harness.handle_bytes(format!("message-{index:02}\n").as_bytes());
+    }
+    harness.handle_byte(27);
+    harness.handle_byte(b'v');
+    harness.handle_bytes(b"gg");
+    harness.handle_byte(b'y');
+
+    let copied = harness
+        .ui()
+        .copied_text()
+        .expect("visual selection yanks selected text");
+    assert!(copied.starts_with("UI harness\nEsc command"));
+    assert_ne!(copied, "UI harness");
+}
+
