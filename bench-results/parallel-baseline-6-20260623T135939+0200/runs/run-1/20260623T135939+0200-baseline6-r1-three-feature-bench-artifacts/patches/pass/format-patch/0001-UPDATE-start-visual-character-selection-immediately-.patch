From 29d38b4506a6bbf154a6f8bbad5cdc3172a2cd35 Mon Sep 17 00:00:00 2001
From: fi3 <you@example.com>
Date: Tue, 23 Jun 2026 14:21:20 +0200
Subject: [PATCH 1/2] UPDATE start visual character selection immediately so
 focused panes yank like Vim

Command-mode v initializes a character visual selection at the focused pane anchor, matching Vim-style selection behavior without requiring a second v keystroke. UI harness and terminal UI tests cover right-pane character/block yanks and left-pane character selections so the behavior stays tied to pane focus instead of a fixture-specific path.
---
 src/ui.rs            | 37 ++++++++++++++++++++--------------
 tests/terminal_ui.rs | 24 ++++++++--------------
 tests/ui_harness.rs  | 47 ++++++++++++++++++++++++++++++++++++++++----
 3 files changed, 73 insertions(+), 35 deletions(-)

diff --git a/src/ui.rs b/src/ui.rs
index 620b15c..9c7aa8b 100644
--- a/src/ui.rs
+++ b/src/ui.rs
@@ -1097,9 +1097,12 @@ impl TerminalUi {
         right_cursor_column: Option<usize>,
     ) {
         let point = self.visual_start_point(visible_right_content, right_cursor_column);
-        self.visual_cursor = Some(VisualCursor {
+        self.visual_cursor = None;
+        self.visual_selection = Some(VisualSelection {
             pane: self.focus,
-            point,
+            mode: VisualSelectionMode::Character,
+            anchor: point,
+            cursor: point,
         });
     }
 
@@ -1190,7 +1193,10 @@ impl TerminalUi {
         match self.focus {
             PaneFocus::Left => {
                 let lines = self.visual_pane_lines(visible_right_content, PaneFocus::Left);
-                let row = self.control_selected.min(lines.len().saturating_sub(1));
+                let row = self
+                    .control_selected_row_index()
+                    .unwrap_or(0)
+                    .min(lines.len().saturating_sub(1));
                 VisualPoint { row, column: 0 }
             }
             PaneFocus::Right => {
@@ -2012,6 +2018,18 @@ impl TerminalUi {
             .map(|index| self.agents[index].id.clone())
     }
 
+    fn control_selected_row_index(&self) -> Option<usize> {
+        let target = if self.control_selected == 0 {
+            LeftPaneClickTarget::Command
+        } else {
+            LeftPaneClickTarget::Agent(self.control_selected_agent_id()?)
+        };
+        let inner_width = usize::from(self.layout().left_width.saturating_sub(2).max(1));
+        self.left_pane_lines(inner_width)
+            .iter()
+            .position(|line| line.control_target.as_ref() == Some(&target))
+    }
+
     fn left_pane_click_target(&mut self, row: u16) -> Option<LeftPaneClickTarget> {
         let list_row = usize::from(row.saturating_sub(2));
         if row < 2 {
@@ -2049,18 +2067,7 @@ impl TerminalUi {
     }
 
     fn control_cursor_row(&self) -> u16 {
-        let target = if self.control_selected == 0 {
-            LeftPaneClickTarget::Command
-        } else {
-            let Some(agent_id) = self.control_selected_agent_id() else {
-                return 2;
-            };
-            LeftPaneClickTarget::Agent(agent_id)
-        };
-        let inner_width = usize::from(self.layout().left_width.saturating_sub(2).max(1));
-        self.left_pane_lines(inner_width)
-            .iter()
-            .position(|line| line.control_target.as_ref() == Some(&target))
+        self.control_selected_row_index()
             .map(|row| (row + 2).min(usize::from(u16::MAX)) as u16)
             .unwrap_or(2)
     }
