+    fn selected_agent_slash_commands_execute_as_backend_commands() {
+        let backend = ScriptedBackend::new(["status output", "generated title", "fork output"]);
+        let chat = CommandChat::new(PathBuf::from("/repo"), backend.clone());
+        let mut controller = WorkLeafController::new(chat);
+        let agent_id = AgentId::new("user-1").expect("test agent id is valid");
+
+        controller.register_agent_feature(agent_id.clone(), "backend commands".to_string());
+        controller.add_session(WorkLeafSession {
+            id: agent_id.clone(),
+            kind: AgentKind::Codex,
+            title: "user-1".to_string(),
+            feature: "backend commands".to_string(),
+            lines: Vec::new(),
+            loading: None,
+            completion: None,
+            token_usage: None,
+            depends_on: Vec::new(),
+            depended_on_by: Vec::new(),
+        });
+
+        controller
+            .send_message(&agent_id, "/status")
+            .expect("slash status command is accepted");
+        assert!(controller.wait_for_idle(Duration::from_secs(1)));
+        controller
+            .send_message(&agent_id, "/fork")
+            .expect("slash fork command is accepted");
+        assert!(controller.wait_for_idle(Duration::from_secs(1)));
+
+        assert_eq!(backend.sends(), Vec::new());
+        assert_eq!(
