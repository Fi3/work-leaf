+    #[test]
+    fn feature_done_yes_closes_and_later_message_reopens_patch_agent() {
+        let backend =
+            ScriptedBackend::new(["agent reply after reopen", "reopened completion flow"]);
+        let chat = CommandChat::new(PathBuf::from("/repo"), backend.clone());
+        let mut controller = WorkLeafController::new(chat);
+        let agent_id = AgentId::new("user-1").expect("test agent id is valid");
+
+        controller.register_agent_feature(agent_id.clone(), "completion flow".to_string());
+        controller.add_session(WorkLeafSession {
+            id: agent_id.clone(),
+            kind: AgentKind::Codex,
+            title: "user-1".to_string(),
+            feature: "completion flow".to_string(),
+            lines: Vec::new(),
+            loading: None,
+            completion: None,
+            token_usage: None,
+            depends_on: Vec::new(),
+            depended_on_by: Vec::new(),
+        });
+        controller.ask_feature_done(&agent_id);
+
+        controller
+            .send_message(&agent_id, "maybe later")
+            .expect("unknown completion answer is accepted");
+
+        let snapshot = controller.snapshot();
+        let session = snapshot
+            .session(&agent_id)
+            .expect("patch agent session exists");
+        assert_eq!(session.completion, Some(WorkLeafCompletion::NeedsDecision));
+        assert!(
+            session
+                .lines
+                .iter()
+                .any(|line| line == "work-leaf: answer yes or no to close this feature")
+        );
+        assert!(backend.sends().is_empty());
+
+        controller
+            .send_message(&agent_id, "yes")
+            .expect("yes completion answer is accepted");
+
+        let snapshot = controller.snapshot();
+        let session = snapshot
+            .session(&agent_id)
+            .expect("patch agent session exists");
+        assert_eq!(session.completion, Some(WorkLeafCompletion::Closed));
+        assert!(
+            session
+                .lines
+                .iter()
+                .any(|line| line == "work-leaf: feature marked closed")
+        );
+        assert!(backend.sends().is_empty());
+
+        controller
+            .send_message(&agent_id, "follow up after close")
+            .expect("closed patch agent accepts a new message");
+        assert!(controller.wait_for_idle(Duration::from_secs(1)));
+
+        let snapshot = controller.snapshot();
+        let session = snapshot
+            .session(&agent_id)
+            .expect("patch agent session exists");
+        assert_eq!(session.completion, None);
+        assert!(
+            session
+                .lines
+                .iter()
+                .any(|line| line == "user: follow up after close")
+        );
+        assert!(
+            session
+                .lines
+                .iter()
+                .any(|line| line == "agent reply after reopen")
+        );
+        assert_eq!(
+            backend.sends(),
+            vec![(agent_id, "follow up after close".to_string())]
+        );
+    }
+
