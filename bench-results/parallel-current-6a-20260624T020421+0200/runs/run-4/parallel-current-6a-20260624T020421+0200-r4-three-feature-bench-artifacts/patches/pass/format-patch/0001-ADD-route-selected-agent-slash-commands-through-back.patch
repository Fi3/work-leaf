+#[test]
+fn controller_routes_selected_agent_status_slash_command_to_backend_command() {
+    let backend = FakeBackend::new(["launch reply", "status command output"]);
+    let chat = CommandChat::new(PathBuf::from("/repo"), backend.clone());
+    let mut controller = WorkLeafController::new(chat);
+
+    let agent_id = controller.create_agent("check status").unwrap();
+    assert!(controller.wait_for_idle(Duration::from_secs(1)));
+
+    controller.send_message(&agent_id, "/status").unwrap();
+    assert!(controller.wait_for_idle(Duration::from_secs(1)));
+
+    let snapshot = controller.snapshot();
+    let session = snapshot.session(&agent_id).expect("session exists");
+    assert!(session.lines.iter().any(|line| line == "user: /status"));
+    assert!(
+        session
+            .lines
+            .iter()
+            .any(|line| line == "status command output")
+    );
+    assert_eq!(
+        backend.commands(),
+        vec![(agent_id.clone(), "/status".to_string())]
+    );
+    assert!(
+        backend
+            .sends()
+            .iter()
+            .all(|(_, prompt)| prompt != "/status")
+    );
+}
+
+#[test]
+fn controller_routes_selected_agent_fork_slash_command_to_backend_command() {
+    let backend = FakeBackend::new(["launch reply", "fork command output"]);
+    let chat = CommandChat::new(PathBuf::from("/repo"), backend.clone());
+    let mut controller = WorkLeafController::new(chat);
+
+    let agent_id = controller.create_agent("fork session").unwrap();
+    assert!(controller.wait_for_idle(Duration::from_secs(1)));
+
+    controller.send_message(&agent_id, "/fork").unwrap();
+    assert!(controller.wait_for_idle(Duration::from_secs(1)));
+
+    let snapshot = controller.snapshot();
+    let session = snapshot.session(&agent_id).expect("session exists");
+    assert!(session.lines.iter().any(|line| line == "user: /fork"));
+    assert!(
+        session
+            .lines
+            .iter()
+            .any(|line| line == "fork command output")
+    );
+    assert_eq!(
+        backend.commands(),
+        vec![(agent_id.clone(), "/fork".to_string())]
+    );
+    assert!(backend.sends().is_empty());
+}
+
