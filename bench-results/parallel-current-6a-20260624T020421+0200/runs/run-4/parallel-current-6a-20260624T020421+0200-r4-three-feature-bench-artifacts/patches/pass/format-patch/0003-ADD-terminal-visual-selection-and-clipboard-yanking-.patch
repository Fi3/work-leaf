+    fn start_visual_selection(
+        &mut self,
+        kind: VisualSelectionKind,
+        right_content: &str,
+        right_cursor_column: Option<usize>,
+    ) {
+        let anchor = self.visual_anchor_position(right_content, right_cursor_column);
+        self.visual_selection = Some(VisualSelection {
+            pane: self.focus,
+            kind,
+            anchor,
+            cursor: anchor,
+        });
+        self.mode = UiMode::Command;
+        self.pending = None;
+    }
+
+    fn start_visual_selection_at_current_focus(&mut self, kind: VisualSelectionKind) {
+        let anchor = match self.focus {
+            PaneFocus::Left => VisualPosition {
+                row: self.control_visual_row(),
+                column: 0,
+            },
+            PaneFocus::Right => VisualPosition { row: 0, column: 0 },
+        };
+        self.visual_selection = Some(VisualSelection {
+            pane: self.focus,
+            kind,
+            anchor,
+            cursor: anchor,
+        });
+        self.pending = None;
+    }
+
+    fn visual_anchor_position(
+        &self,
+        right_content: &str,
+        right_cursor_column: Option<usize>,
+    ) -> VisualPosition {
+        match self.focus {
+            PaneFocus::Left => VisualPosition {
+                row: self.control_visual_row(),
+                column: 0,
+            },
+            PaneFocus::Right => {
+                self.right_visual_cursor_position(right_content, right_cursor_column)
+            }
+        }
+    }
+
+    fn right_visual_cursor_position(
+        &self,
+        right_content: &str,
+        right_cursor_column: Option<usize>,
+    ) -> VisualPosition {
+        let visible_right_content = self.visible_right_content(right_content);
+        let (row, column) =
+            self.right_cursor_position_with_cursor(&visible_right_content, right_cursor_column);
+        let layout = self.layout();
+        VisualPosition {
+            row: usize::from(row.saturating_sub(2)),
+            column: usize::from(column.saturating_sub(layout.left_width.saturating_add(2))),
+        }
+    }
+
+    fn handle_visual_key(&mut self, key: UiKey) -> Vec<UiAction> {
+        match key {
+            UiKey::Esc | UiKey::Char('v') => {
+                self.visual_selection = None;
+            }
+            UiKey::Char('V') => {
+                if let Some(selection) = self.visual_selection.as_mut() {
+                    selection.kind = VisualSelectionKind::Line;
+                }
+            }
+            UiKey::Char('\u{16}') => {
+                if let Some(selection) = self.visual_selection.as_mut() {
+                    selection.kind = VisualSelectionKind::Block;
+                }
+            }
+            UiKey::Char('h') | UiKey::Left => self.move_visual_cursor(0, -1),
+            UiKey::Char('j') | UiKey::Down => self.move_visual_cursor(1, 0),
+            UiKey::Char('k') | UiKey::Up => self.move_visual_cursor(-1, 0),
+            UiKey::Char('l') | UiKey::Right => self.move_visual_cursor(0, 1),
+            UiKey::MouseClick { .. } => {
+                self.visual_selection = None;
+            }
+            _ => {}
+        }
+        Vec::new()
+    }
+
+    fn move_visual_cursor(&mut self, row_delta: isize, column_delta: isize) {
+        let Some(selection) = self.visual_selection.as_mut() else {
+            return;
+        };
+        if row_delta.is_negative() {
+            selection.cursor.row = selection
+                .cursor
+                .row
+                .saturating_sub(row_delta.unsigned_abs());
+        } else {
+            selection.cursor.row = selection.cursor.row.saturating_add(row_delta as usize);
+        }
+        if column_delta.is_negative() {
+            selection.cursor.column = selection
+                .cursor
+                .column
+                .saturating_sub(column_delta.unsigned_abs());
+        } else {
+            selection.cursor.column = selection
+                .cursor
+                .column
+                .saturating_add(column_delta as usize);
+        }
+    }
+
+    fn queue_clipboard_text(&self, text: &str) {
+        *self.pending_clipboard_sequence.borrow_mut() = Some(osc52_clipboard_sequence(text));
+    }
+
+    fn visual_selection_text(
+        &self,
+        selection: &VisualSelection,
+        right_content: &str,
+        force_linewise: bool,
+    ) -> Option<String> {
+        let visible_right_content = self.visible_right_content(right_content);
+        let lines = self.visual_pane_lines(selection.pane, &visible_right_content);
+        if lines.is_empty() {
+            return None;
+        }
+        let ranges = selection_ranges(selection, &lines, force_linewise);
+        let mut selected = ranges
+            .iter()
+            .map(|range| slice_chars(&lines[range.row], range.start, range.end))
+            .collect::<Vec<_>>()
+            .join("\n");
+        if selection.kind.selects_full_lines(force_linewise) {
+            selected.push('\n');
+        }
+        Some(selected)
+    }
+
+    fn apply_visual_selection(&self, buffer: &mut Buffer, visible_right_content: &str) {
+        let Some(selection) = self.visual_selection.as_ref() else {
+            return;
+        };
+        let Some(inner) = self.visual_inner_area(selection.pane) else {
+            return;
+        };
+        if inner.width == 0 || inner.height == 0 {
+            return;
+        }
+
+        let lines = self.visual_pane_lines(selection.pane, visible_right_content);
+        let ranges = selection_ranges(selection, &lines, false);
+        for range in ranges {
+            if range.row >= usize::from(inner.height) {
+                continue;
+            }
+            let end = if matches!(selection.kind, VisualSelectionKind::Line) {
+                usize::from(inner.width)
+            } else {
+                range.end
+            };
+            for column in range.start..end.min(usize::from(inner.width)) {
+                let x = inner
+                    .x
+                    .saturating_add(column.min(usize::from(u16::MAX)) as u16);
+                let y = inner
+                    .y
+                    .saturating_add(range.row.min(usize::from(u16::MAX)) as u16);
+                buffer.get_mut(x, y).modifier.insert(Modifier::REVERSED);
+            }
+        }
+    }
+
+    fn visual_cursor_terminal_position(&self) -> Option<(u16, u16)> {
+        let selection = self.visual_selection.as_ref()?;
+        let inner = self.visual_inner_area(selection.pane)?;
+        if inner.width == 0 || inner.height == 0 {
+            return None;
+        }
+        let row = selection.cursor.row.min(usize::from(inner.height - 1));
+        let column = selection.cursor.column.min(usize::from(inner.width - 1));
+        Some((
+            inner
+                .y
+                .saturating_add(row.min(usize::from(u16::MAX)) as u16)
+                .saturating_add(1),
+            inner
+                .x
+                .saturating_add(column.min(usize::from(u16::MAX)) as u16)
+                .saturating_add(1),
+        ))
+    }
+
