+fn wrapped_visual_lines(content: &str, width: u16) -> Vec<String> {
+    let width = usize::from(width.max(1));
+    if content.is_empty() {
+        return vec![String::new()];
+    }
+
+    let mut rows = Vec::new();
+    for line in content.split('\n') {
+        if line.is_empty() {
+            rows.push(String::new());
+            continue;
+        }
+        let chars = line.chars().collect::<Vec<_>>();
+        for chunk in chars.chunks(width) {
+            rows.push(chunk.iter().collect());
+        }
+    }
+    rows
+}
+
+fn selection_ranges(
+    selection: &VisualSelection,
+    lines: &[String],
+    force_linewise: bool,
+) -> Vec<SelectionRange> {
+    if lines.is_empty() {
+        return Vec::new();
+    }
+
+    let max_row = lines.len() - 1;
+    let anchor = clamp_visual_position(selection.anchor, max_row);
+    let cursor = clamp_visual_position(selection.cursor, max_row);
+    let start_row = anchor.row.min(cursor.row);
+    let end_row = anchor.row.max(cursor.row);
+
+    if selection.kind.selects_full_lines(force_linewise) {
+        return (start_row..=end_row)
+            .map(|row| SelectionRange {
+                row,
+                start: 0,
+                end: lines[row].chars().count(),
+            })
+            .collect();
+    }
+
+    if matches!(selection.kind, VisualSelectionKind::Block) {
+        let left = anchor.column.min(cursor.column);
+        let right = anchor.column.max(cursor.column);
+        return (start_row..=end_row)
+            .map(|row| {
+                let len = lines[row].chars().count();
+                SelectionRange {
+                    row,
+                    start: left.min(len),
+                    end: right.saturating_add(1).min(len),
+                }
+            })
+            .collect();
+    }
+
+    let (start, end) = if position_le(anchor, cursor) {
+        (anchor, cursor)
+    } else {
+        (cursor, anchor)
+    };
+    (start.row..=end.row)
+        .map(|row| {
+            let len = lines[row].chars().count();
+            if len == 0 {
+                return SelectionRange {
+                    row,
+                    start: 0,
+                    end: 0,
+                };
+            }
+            let start_column = if row == start.row {
+                start.column.min(len)
+            } else {
+                0
+            };
+            let end_column = if row == end.row {
+                end.column.min(len.saturating_sub(1)).saturating_add(1)
+            } else {
+                len
+            };
+            SelectionRange {
+                row,
+                start: start_column,
+                end: end_column.max(start_column),
+            }
+        })
+        .collect()
+}
+
+fn clamp_visual_position(position: VisualPosition, max_row: usize) -> VisualPosition {
+    VisualPosition {
+        row: position.row.min(max_row),
+        column: position.column,
+    }
+}
+
+fn position_le(left: VisualPosition, right: VisualPosition) -> bool {
+    left.row < right.row || (left.row == right.row && left.column <= right.column)
+}
+
+fn slice_chars(text: &str, start: usize, end: usize) -> String {
+    text.chars()
+        .skip(start)
+        .take(end.saturating_sub(start))
+        .collect()
+}
+
+fn osc52_clipboard_sequence(text: &str) -> String {
+    format!("\u{1b}]52;c;{}\u{7}", base64_encode(text.as_bytes()))
+}
+
+fn base64_encode(bytes: &[u8]) -> String {
+    const TABLE: &[u8; 64] = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    let mut encoded = String::new();
+    for chunk in bytes.chunks(3) {
+        let first = chunk[0];
+        let second = *chunk.get(1).unwrap_or(&0);
+        let third = *chunk.get(2).unwrap_or(&0);
+
+        encoded.push(TABLE[(first >> 2) as usize] as char);
+        encoded.push(TABLE[(((first & 0b0000_0011) << 4) | (second >> 4)) as usize] as char);
+        if chunk.len() > 1 {
+            encoded.push(TABLE[(((second & 0b0000_1111) << 2) | (third >> 6)) as usize] as char);
+        } else {
+            encoded.push('=');
+        }
+        if chunk.len() > 2 {
+            encoded.push(TABLE[(third & 0b0011_1111) as usize] as char);
+        } else {
+            encoded.push('=');
+        }
+    }
+    encoded
+}
