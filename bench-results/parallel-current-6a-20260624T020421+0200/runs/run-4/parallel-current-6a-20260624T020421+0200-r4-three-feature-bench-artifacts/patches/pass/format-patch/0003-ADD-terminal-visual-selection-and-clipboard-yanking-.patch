+        let body_height = self.height.saturating_sub(1);
+        let layout = self.layout();
+        if layout.left_width > 0 {
+            (
+                Some(Rect::new(0, 0, layout.left_width, body_height)),
+                Rect::new(layout.left_width, 0, layout.right_width, body_height),
+            )
+        } else {
+            (None, Rect::new(0, 0, self.width, body_height))
+        }
+    }
