+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+enum FeatureCompletionState {
+    AwaitingDecision,
+    Closed,
+}
+
+fn feature_done_prompt(commit: &AgentCommit) -> String {
+    format!(
+        "{}{}. {}",
+        FEATURE_DONE_PROMPT_PREFIX,
+        short_hash(&commit.hash),
+        FEATURE_DONE_PROMPT_SUFFIX
+    )
+}
+
+fn feature_completion_answer(message: &str) -> Option<bool> {
+    match message.trim().to_ascii_lowercase().as_str() {
+        "yes" | "y" => Some(true),
+        "no" | "n" => Some(false),
+        _ => None,
+    }
+}
+
+fn short_hash(hash: &str) -> &str {
+    hash.get(..12).unwrap_or(hash)
