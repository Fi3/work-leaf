+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+enum FeatureCompletionUiState {
+    Open,
+    AwaitingDecision,
+    Closed,
+}
+
+fn session_feature_completion_state(session: &WorkLeafSession) -> FeatureCompletionUiState {
+    let mut state = FeatureCompletionUiState::Open;
+    for line in &session.lines {
+        if is_feature_done_prompt(line) {
+            state = FeatureCompletionUiState::AwaitingDecision;
+        } else if line == FEATURE_DONE_CLOSED {
+            state = FeatureCompletionUiState::Closed;
+        } else if line == FEATURE_DONE_OPEN
+            || (line.starts_with("user: ")
+                && matches!(
+                    state,
+                    FeatureCompletionUiState::AwaitingDecision | FeatureCompletionUiState::Closed
+                ))
+        {
+            state = FeatureCompletionUiState::Open;
+        }
+    }
+    state
+}
+
+fn is_feature_done_prompt(line: &str) -> bool {
+    line.starts_with(FEATURE_DONE_PROMPT_PREFIX) && line.ends_with(FEATURE_DONE_PROMPT_SUFFIX)
+}
 
