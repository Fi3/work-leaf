+    fn handle_visual_key(&mut self, key: UiKey) -> Vec<UiAction> {
+        match key {
+            UiKey::Esc => {
+                self.clear_visual_selection();
+                self.mode = UiMode::Command;
+            }
+            UiKey::Char('v') => self.set_visual_selection_kind(VisualSelectionKind::Character),
+            UiKey::Char('V') => self.set_visual_selection_kind(VisualSelectionKind::Line),
+            UiKey::Char('\u{16}') => self.set_visual_selection_kind(VisualSelectionKind::Block),
+            UiKey::Char('y') => self.yank_visual_selection(false),
+            UiKey::Char('Y') => self.yank_visual_selection(true),
+            UiKey::Char('h') | UiKey::Left => self.move_visual_column(-1),
+            UiKey::Char('l') | UiKey::Right => self.move_visual_column(1),
+            UiKey::Char('k') | UiKey::Up => self.move_visual_row(-1),
+            UiKey::Char('j') | UiKey::Down => self.move_visual_row(1),
+            _ => {}
+        }
+        Vec::new()
+    }
+
+    fn start_visual_selection(&mut self, kind: VisualSelectionKind) {
+        let pane = if self.focus == PaneFocus::Left && !self.left_visible {
+            PaneFocus::Right
+        } else {
+            self.focus
+        };
+        let lines = self.pane_text_lines(pane);
+        let position = self.current_pane_position(pane, &lines);
+        self.visual_selection = Some(VisualSelection {
+            pane,
+            kind,
+            anchor: position,
+            cursor: position,
+            preferred_column: position.column,
+        });
+        self.mode = UiMode::Command;
+        self.pending = None;
+    }
+
+    fn set_visual_selection_kind(&mut self, kind: VisualSelectionKind) {
+        if let Some(selection) = self.visual_selection.as_mut() {
+            selection.kind = kind;
+        }
+    }
+
+    fn clear_visual_selection(&mut self) {
+        self.visual_selection = None;
+    }
+
+    fn move_visual_row(&mut self, delta: isize) {
+        let Some(pane) = self
+            .visual_selection
+            .as_ref()
+            .map(|selection| selection.pane)
+        else {
+            return;
+        };
+        let lines = self.pane_text_lines(pane);
+        let max_row = lines.len().saturating_sub(1);
+        let Some(selection) = self.visual_selection.as_mut() else {
+            return;
+        };
+        let next = (selection.cursor.row as isize + delta).clamp(0, max_row as isize) as usize;
+        selection.cursor.row = next;
+        selection.cursor.column = selection.preferred_column.min(line_cursor_max(
+            lines.get(next).map(String::as_str).unwrap_or(""),
+        ));
+    }
+
+    fn move_visual_column(&mut self, delta: isize) {
+        let Some(pane) = self
+            .visual_selection
+            .as_ref()
+            .map(|selection| selection.pane)
+        else {
+            return;
+        };
+        let lines = self.pane_text_lines(pane);
+        let Some(selection) = self.visual_selection.as_mut() else {
+            return;
+        };
+        let line = lines
+            .get(selection.cursor.row)
+            .map(String::as_str)
