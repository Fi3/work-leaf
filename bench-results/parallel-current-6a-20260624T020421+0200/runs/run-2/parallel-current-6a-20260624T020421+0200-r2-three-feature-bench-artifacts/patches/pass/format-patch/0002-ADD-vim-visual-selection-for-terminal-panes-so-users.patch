+fn display_lines(content: &str) -> Vec<&str> {
+    let lines = content.lines().collect::<Vec<_>>();
+    if lines.is_empty() { vec![""] } else { lines }
+}
+
+fn line_cursor_max(line: &str) -> usize {
+    line.chars().count().saturating_sub(1)
+}
+
+fn selected_text(lines: &[String], selection: &VisualSelection, force_line: bool) -> String {
+    let (start_row, end_row) = ordered_rows(selection);
+    (start_row..=end_row)
+        .filter_map(|row| {
+            let line = lines.get(row).map(String::as_str).unwrap_or("");
+            let line_len = line.chars().count();
+            selection_line_range(selection, row, line_len, force_line)
+                .map(|(start, end)| slice_chars(line, start, end))
+        })
+        .collect::<Vec<_>>()
+        .join("\n")
+}
+
+fn selection_line_range(
+    selection: &VisualSelection,
+    row: usize,
+    line_len: usize,
+    force_line: bool,
+) -> Option<(usize, usize)> {
+    let (start_row, end_row) = ordered_rows(selection);
+    if row < start_row || row > end_row {
+        return None;
+    }
+
+    let kind = if force_line {
+        VisualSelectionKind::Line
+    } else {
+        selection.kind
+    };
+    match kind {
+        VisualSelectionKind::Line => Some((0, line_len)),
+        VisualSelectionKind::Block => {
+            let start = selection
+                .anchor
+                .column
+                .min(selection.cursor.column)
+                .min(line_len);
+            let end = selection
+                .anchor
+                .column
+                .max(selection.cursor.column)
+                .saturating_add(1)
+                .min(line_len);
+            Some((start, end))
+        }
+        VisualSelectionKind::Character => {
+            let (start, end) = ordered_positions(selection.anchor, selection.cursor);
+            if start.row == end.row {
+                return Some((
+                    start.column.min(line_len),
+                    end.column.saturating_add(1).min(line_len),
+                ));
+            }
+            if row == start.row {
+                Some((start.column.min(line_len), line_len))
+            } else if row == end.row {
+                Some((0, end.column.saturating_add(1).min(line_len)))
+            } else {
+                Some((0, line_len))
+            }
+        }
+    }
+}
+
+fn ordered_rows(selection: &VisualSelection) -> (usize, usize) {
+    (
+        selection.anchor.row.min(selection.cursor.row),
+        selection.anchor.row.max(selection.cursor.row),
+    )
+}
+
+fn ordered_positions(left: TextPosition, right: TextPosition) -> (TextPosition, TextPosition) {
+    if (left.row, left.column) <= (right.row, right.column) {
+        (left, right)
+    } else {
+        (right, left)
+    }
+}
+
+fn slice_chars(text: &str, start: usize, end: usize) -> String {
+    text.chars()
+        .skip(start)
+        .take(end.saturating_sub(start))
+        .collect()
+}
+
+fn osc52_clipboard_sequence(text: &str) -> String {
+    format!("\u{1b}]52;c;{}\u{7}", base64_encode(text.as_bytes()))
+}
+
+fn base64_encode(bytes: &[u8]) -> String {
+    const TABLE: &[u8; 64] = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    let mut encoded = String::new();
+    for chunk in bytes.chunks(3) {
+        let first = chunk[0];
+        let second = *chunk.get(1).unwrap_or(&0);
+        let third = *chunk.get(2).unwrap_or(&0);
+        let combined = ((first as u32) << 16) | ((second as u32) << 8) | third as u32;
+
+        encoded.push(TABLE[((combined >> 18) & 0x3f) as usize] as char);
+        encoded.push(TABLE[((combined >> 12) & 0x3f) as usize] as char);
+        if chunk.len() > 1 {
+            encoded.push(TABLE[((combined >> 6) & 0x3f) as usize] as char);
+        } else {
+            encoded.push('=');
+        }
+        if chunk.len() > 2 {
+            encoded.push(TABLE[(combined & 0x3f) as usize] as char);
+        } else {
+            encoded.push('=');
+        }
+    }
+    encoded
+}
