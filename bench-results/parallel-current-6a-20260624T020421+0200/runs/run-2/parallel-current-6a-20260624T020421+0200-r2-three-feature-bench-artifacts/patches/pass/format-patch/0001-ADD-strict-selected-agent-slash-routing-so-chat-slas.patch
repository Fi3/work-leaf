+#[test]
+fn controller_routes_selected_agent_slash_commands_to_backend_commands() {
+    let backend = FakeBackend::new(["launch reply", "status reply", "fork reply"]);
+    let chat = CommandChat::new(PathBuf::from("/repo"), backend.clone());
+    let mut controller = WorkLeafController::new(chat);
+
+    let agent_id = controller.create_agent("slash command target").unwrap();
+    assert!(controller.wait_for_idle(Duration::from_secs(1)));
+
+    controller.send_message(&agent_id, "/status").unwrap();
+    assert!(controller.wait_for_idle(Duration::from_secs(1)));
+    controller
+        .send_message(&agent_id, "/fork add branch coverage")
+        .unwrap();
+    assert!(controller.wait_for_idle(Duration::from_secs(1)));
+
+    let snapshot = controller.snapshot();
+    let session = snapshot.session(&agent_id).expect("session exists");
+    assert!(session.lines.iter().any(|line| line == "user: /status"));
+    assert!(session.lines.iter().any(|line| line == "status reply"));
+    assert!(
+        session
+            .lines
+            .iter()
+            .any(|line| line == "user: /fork add branch coverage")
+    );
+    assert!(session.lines.iter().any(|line| line == "fork reply"));
+    assert!(
+        backend.sends().is_empty(),
+        "/status must not be delivered as an ordinary backend prompt"
+    );
+    let commands = backend.commands();
+    assert_eq!(commands.len(), 2);
+    assert_eq!(commands[0].0, agent_id);
+    assert_eq!(commands[0].1, "/status");
+    assert_eq!(commands[1].0, agent_id);
+    assert_eq!(commands[1].1, "/fork add branch coverage");
