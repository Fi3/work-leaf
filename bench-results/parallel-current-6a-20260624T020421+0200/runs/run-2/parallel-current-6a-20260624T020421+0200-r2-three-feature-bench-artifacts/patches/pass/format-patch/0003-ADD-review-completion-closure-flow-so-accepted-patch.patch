+#[test]
+fn terminal_app_reopens_the_patch_chat_closed_by_yes_when_multiple_prompts_wait() {
+    let root = git_repo("terminal-app-review-completion-multiple-prompts");
+    fs::write(root.join("README.md"), "before\n").unwrap();
+    Command::new("git")
+        .current_dir(&root)
+        .args(["add", "README.md"])
+        .status()
+        .unwrap();
+    Command::new("git")
+        .current_dir(&root)
+        .args(["commit", "-m", "ADD initial readme fixture"])
+        .status()
+        .unwrap();
+
+    let backend = FakeBackend::new([
+        "implemented patch\n@work-leaf patch update readme\n--- a/README.md\n+++ b/README.md\n@@ -1 +1 @@\n-before\n+after\n@work-leaf end\n@work-leaf done",
+        "summary: README changes from before to after",
+        "NO_FINDINGS",
+        "implemented second patch\n@work-leaf patch update readme again\n--- a/README.md\n+++ b/README.md\n@@ -1 +1 @@\n-after\n+after again\n@work-leaf end\n@work-leaf done",
+        "summary: README changes from after to after again",
+        "NO_FINDINGS",
+        "follow-up reply",
+    ]);
+    let chat = CommandChat::new(root, backend.clone());
+    let mut app = TerminalApp::new(chat, 100, 24);
+
+    app.handle_bytes(b":new patch update readme\n");
+    assert!(app.wait_for_idle(Duration::from_secs(2)));
+
+    let first_agent_id = AgentId::new("user-1").unwrap();
+    assert_eq!(app.ui().selected_agent(), Some(&first_agent_id));
+    assert!(app.render_frame().contains("Is this feature done? yes/no"));
+
+    app.handle_bytes(b"\x1b:new patch update readme again\n");
+    assert!(app.wait_for_idle(Duration::from_secs(2)));
+
+    let second_agent_id = AgentId::new("user-2").unwrap();
+    assert!(app.render_frame().contains("Is this feature done? yes/no"));
+    if app.ui().selected_agent().map(AgentId::as_str) == Some("review-user-2") {
+        app.handle_bytes(&[27, 23, b'h', b'k', b'l']);
+    }
+    assert_eq!(app.ui().selected_agent(), Some(&second_agent_id));
+
+    app.handle_bytes(b"yes\n");
+    assert_ne!(app.ui().selected_agent(), Some(&second_agent_id));
+
+    app.handle_bytes(b"follow up\n");
+    assert!(app.wait_for_idle(Duration::from_secs(1)));
+
+    assert_eq!(app.ui().selected_agent(), Some(&second_agent_id));
+    assert!(app.render_frame().contains("follow-up reply"));
+
+    let backend = app.into_chat().into_backend();
+    let sends = backend.sends();
+    assert!(
+        sends
+            .iter()
+            .any(|(target, prompt)| target == &second_agent_id && prompt == "follow up")
+    );
+    assert!(
+        !sends
+            .iter()
+            .any(|(target, prompt)| target == &first_agent_id && prompt == "follow up")
+    );
+}
