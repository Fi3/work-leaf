+    fn status_command_output(&self, agent_id: &AgentId) -> Result<String, AgentError> {
+        let state = self
+            .state
+            .lock()
+            .expect("codex backend state mutex poisoned");
+        let session = state
+            .sessions
+            .get(agent_id)
+            .ok_or_else(|| AgentError::UnknownSession(agent_id.clone()))?;
+        let thread_id = state
+            .thread_ids
+            .get(agent_id)
+            .map(String::as_str)
+            .unwrap_or("not recorded");
+        let process = if state.active_processes.contains_key(agent_id) {
+            "running"
+        } else {
+            "idle"
+        };
+        Ok(format!(
+            "Codex status for {agent_id}\nfeature: {}\nstate: {:?}\nthread: {thread_id}\nprocess: {process}\nmessages: {}",
+            session.feature,
+            session.state,
+            session.messages.len()
+        ))
+    }
+
+    fn fork_command_output(&self, agent_id: &AgentId, command: &str) -> Result<String, AgentError> {
+        let state = self
+            .state
+            .lock()
+            .expect("codex backend state mutex poisoned");
+        let session = state
+            .sessions
+            .get(agent_id)
+            .ok_or_else(|| AgentError::UnknownSession(agent_id.clone()))?;
+        let thread_id = state
+            .thread_ids
+            .get(agent_id)
+            .map(String::as_str)
+            .unwrap_or("not recorded");
+        let fork_args = command
+            .split_whitespace()
+            .skip(1)
+            .collect::<Vec<_>>()
+            .join(" ");
+        let mut output = format!(
+            "Codex fork requested for {agent_id}\nfeature: {}\nsource thread: {thread_id}",
+            session.feature
+        );
+        if !fork_args.is_empty() {
+            output.push_str("\narguments: ");
+            output.push_str(&fork_args);
+        }
+        output.push_str("\nCodex exec does not expose a non-interactive fork command; no new session was created.");
+        Ok(output)
+    }
