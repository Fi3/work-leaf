+
+fn spans_for_selection_range(line: &str, range: Option<(usize, usize)>) -> Spans<'static> {
+    let Some((start, end)) = range else {
+        return Spans::from(vec![Span::raw(line.to_string())]);
+    };
+    if start >= end {
+        return Spans::from(vec![Span::raw(line.to_string())]);
+    }
+
+    let start_byte = char_byte_index(line, start);
+    let end_byte = char_byte_index(line, end);
+    let mut spans = Vec::new();
+    if start_byte > 0 {
+        spans.push(Span::raw(line[..start_byte].to_string()));
+    }
+    spans.push(Span::styled(
+        line[start_byte..end_byte].to_string(),
+        Style::default().add_modifier(Modifier::REVERSED),
+    ));
+    if end_byte < line.len() {
+        spans.push(Span::raw(line[end_byte..].to_string()));
+    }
+    Spans::from(spans)
+}
+
+fn selected_text_from_lines(
+    lines: &[String],
+    selection: &VisualSelection,
+    linewise: bool,
+) -> String {
+    if lines.is_empty() {
+        return String::new();
+    }
+
+    let start_row = selection.anchor.row.min(selection.cursor.row);
+    let end_row = selection
+        .anchor
+        .row
+        .max(selection.cursor.row)
+        .min(lines.len() - 1);
+    let mut selected = Vec::new();
+    for row in start_row..=end_row {
+        let line = &lines[row];
+        if linewise || selection.kind == VisualSelectionKind::Line {
+            selected.push(line.clone());
+        } else if let Some((start, end)) =
+            visual_selection_range_for_line(selection, row, line.chars().count(), false)
+        {
+            selected.push(slice_chars(line, start, end).to_string());
+        }
+    }
+
+    let mut text = selected.join("\n");
+    if linewise || selection.kind == VisualSelectionKind::Line {
+        text.push('\n');
+    }
+    text
+}
+
+fn visual_selection_range_for_line(
+    selection: &VisualSelection,
+    row: usize,
+    line_len: usize,
+    linewise: bool,
+) -> Option<(usize, usize)> {
+    let start_row = selection.anchor.row.min(selection.cursor.row);
+    let end_row = selection.anchor.row.max(selection.cursor.row);
+    if row < start_row || row > end_row {
+        return None;
+    }
+    if linewise || selection.kind == VisualSelectionKind::Line {
+        return Some((0, line_len));
+    }
+
+    match selection.kind {
+        VisualSelectionKind::Line => Some((0, line_len)),
+        VisualSelectionKind::Block => {
+            let start = selection.anchor.column.min(selection.cursor.column).min(line_len);
+            let end = inclusive_column_end(
+                selection.anchor.column.max(selection.cursor.column),
+                line_len,
+            );
+            Some((start.min(end), end))
+        }
+        VisualSelectionKind::Character => {
+            let (top, bottom) = if selection.anchor.row <= selection.cursor.row {
+                (selection.anchor, selection.cursor)
+            } else {
+                (selection.cursor, selection.anchor)
+            };
+            if top.row == bottom.row {
+                let start = top.column.min(bottom.column).min(line_len);
+                let end = inclusive_column_end(top.column.max(bottom.column), line_len);
+                Some((start.min(end), end))
+            } else if row == top.row {
+                Some((top.column.min(line_len), line_len))
+            } else if row == bottom.row {
+                Some((0, inclusive_column_end(bottom.column, line_len)))
+            } else {
+                Some((0, line_len))
+            }
+        }
+    }
+}
+
+fn inclusive_column_end(column: usize, line_len: usize) -> usize {
+    if line_len == 0 {
+        0
+    } else {
+        column.min(line_len.saturating_sub(1)).saturating_add(1)
+    }
+}
+
+fn slice_chars(text: &str, start: usize, end: usize) -> &str {
+    let start = char_byte_index(text, start);
+    let end = char_byte_index(text, end);
+    &text[start..end]
+}
+
+fn char_byte_index(text: &str, char_index: usize) -> usize {
+    text.char_indices()
+        .nth(char_index)
+        .map(|(index, _)| index)
+        .unwrap_or(text.len())
+}
+
+fn osc52_copy_sequence(text: &str) -> String {
+    format!("\u{1b}]52;c;{}\u{7}", base64_encode(text.as_bytes()))
+}
+
+fn base64_encode(bytes: &[u8]) -> String {
+    const TABLE: &[u8; 64] = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    let mut output = String::new();
+    for chunk in bytes.chunks(3) {
+        let first = chunk[0];
+        let second = chunk.get(1).copied().unwrap_or(0);
+        let third = chunk.get(2).copied().unwrap_or(0);
+        let combined = ((first as u32) << 16) | ((second as u32) << 8) | third as u32;
+        output.push(TABLE[((combined >> 18) & 0x3f) as usize] as char);
+        output.push(TABLE[((combined >> 12) & 0x3f) as usize] as char);
+        if chunk.len() > 1 {
+            output.push(TABLE[((combined >> 6) & 0x3f) as usize] as char);
+        } else {
+            output.push('=');
+        }
+        if chunk.len() > 2 {
+            output.push(TABLE[(combined & 0x3f) as usize] as char);
+        } else {
+            output.push('=');
+        }
+    }
+    output
+}
