+fn scripted_harness_visual_line_mode_copies_right_pane_text() {
+    let mut harness = UiHarness::new(80, 24);
+
+    harness.handle_bytes(&[23, b'l']);
+    harness.handle_byte(b'v');
+    assert_eq!(harness.ui().mode(), UiMode::Visual);
+
+    harness.handle_byte(b'V');
+    harness.handle_byte(b'k');
+    let visual_frame = harness.render_frame();
+    assert!(visual_frame.contains("mode=visual-line focus=right"));
+    assert!(visual_frame.contains("\u{1b}[7m"));
+
+    harness.handle_byte(b'Y');
+
+    assert_eq!(harness.ui().mode(), UiMode::Command);
+    let copied = harness
+        .ui()
+        .copied_text()
+        .expect("visual yank stores copied text");
+    assert!(copied.contains("Esc command"));
+    assert!(copied.contains("chat> "));
+    assert!(copied.ends_with('\n'));
