+    fn start_visual_selection(
+        &mut self,
+        kind: VisualSelectionKind,
+        right_content: &str,
+        right_cursor_column: Option<usize>,
+    ) {
+        let pane = self.focus;
+        let position = self.selection_start_position(pane, right_content, right_cursor_column);
+        self.visual_selection = Some(VisualSelection {
+            pane,
+            kind,
+            anchor: position,
+            cursor: position,
+        });
+        self.mode = UiMode::Visual;
+    }
+
+    fn set_visual_selection_kind(&mut self, kind: VisualSelectionKind) {
+        if let Some(selection) = self.visual_selection.as_mut() {
+            selection.kind = kind;
+        }
+    }
+
+    fn move_visual_cursor(&mut self, row_delta: isize, column_delta: isize, right_content: &str) {
+        let Some(selection) = self.visual_selection.clone() else {
+            return;
+        };
+        let lines = self.visual_lines_for_pane(selection.pane, right_content);
+        if lines.is_empty() {
+            return;
+        }
+        let max_row = lines.len() - 1;
+        let next_row = selection
+            .cursor
+            .row
+            .saturating_add_signed(row_delta)
+            .min(max_row);
+        let line_len = lines[next_row].chars().count();
+        let max_column = line_len.saturating_sub(1);
+        let next_column = if column_delta == 0 {
+            selection.cursor.column.min(max_column)
+        } else {
+            selection
+                .cursor
+                .column
+                .saturating_add_signed(column_delta)
+                .min(max_column)
+        };
+        if let Some(selection) = self.visual_selection.as_mut() {
+            selection.cursor = TextPosition {
+                row: next_row,
+                column: next_column,
+            };
+        }
+    }
+
