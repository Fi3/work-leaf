+fn ordered_positions(left: TextPosition, right: TextPosition) -> (TextPosition, TextPosition) {
+    if (left.row, left.column) <= (right.row, right.column) {
+        (left, right)
+    } else {
+        (right, left)
+    }
+}
+
+fn selected_row_range(selection: VisualSelection, lines: &[String]) -> (usize, usize) {
+    let (start, end) = ordered_positions(selection.anchor, selection.cursor);
+    let max_row = lines.len().saturating_sub(1);
+    (start.row.min(max_row), end.row.min(max_row))
+}
+
+fn selected_line_text(selection: VisualSelection, lines: &[String]) -> String {
+    let (start_row, end_row) = selected_row_range(selection, lines);
+    lines[start_row..=end_row].join("\n")
+}
+
+fn selected_block_text(selection: VisualSelection, lines: &[String]) -> String {
+    let (start_row, end_row) = selected_row_range(selection, lines);
+    let start_column = selection.anchor.column.min(selection.cursor.column);
+    let end_column = selection.anchor.column.max(selection.cursor.column) + 1;
+    lines[start_row..=end_row]
+        .iter()
+        .map(|line| {
+            let line_len = line.chars().count();
+            if start_column >= line_len {
+                String::new()
+            } else {
+                slice_chars(line, start_column, end_column.min(line_len))
+            }
+        })
+        .collect::<Vec<_>>()
+        .join("\n")
+}
+
+fn selected_character_text(selection: VisualSelection, lines: &[String]) -> String {
+    let (start, end) = ordered_positions(selection.anchor, selection.cursor);
+    let (start_row, end_row) = selected_row_range(selection, lines);
+    (start_row..=end_row)
+        .map(|row| {
+            let line = &lines[row];
+            let line_len = line.chars().count();
+            if start_row == end_row {
+                let start_column = start.column.min(line_len);
+                let end_column = (end.column + 1).min(line_len);
+                slice_chars(line, start_column, end_column)
+            } else if row == start_row {
+                let start_column = start.column.min(line_len);
+                slice_chars(line, start_column, line_len)
+            } else if row == end_row {
+                let end_column = (end.column + 1).min(line_len);
+                slice_chars(line, 0, end_column)
+            } else {
+                line.clone()
+            }
+        })
+        .collect::<Vec<_>>()
+        .join("\n")
+}
