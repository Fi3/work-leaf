+    fn visual_spans(&self, pane: PaneFocus, row: usize, text: &str) -> Vec<Span<'static>> {
+        let Some((start, end)) = self.visual_selected_columns(pane, row, text) else {
+            return vec![Span::raw(text.to_string())];
+        };
+
+        let prefix = slice_chars(text, 0, start);
+        let selected = slice_chars(text, start, end);
+        let suffix = slice_chars(text, end, text.chars().count());
+        let mut spans = Vec::new();
+        if !prefix.is_empty() {
+            spans.push(Span::raw(prefix));
+        }
+        spans.push(Span::styled(
+            selected,
+            Style::default().add_modifier(Modifier::REVERSED | Modifier::UNDERLINED),
+        ));
+        if !suffix.is_empty() {
+            spans.push(Span::raw(suffix));
+        }
+        spans
+    }
+
+    fn visual_selected_columns(
+        &self,
+        pane: PaneFocus,
+        row: usize,
+        text: &str,
+    ) -> Option<(usize, usize)> {
+        let selection = self.visual_selection?;
+        if selection.pane != pane {
+            return None;
+        }
+
+        let line_len = text.chars().count();
+        if line_len == 0 {
+            return None;
+        }
+
+        let (start, end) = ordered_positions(selection.anchor, selection.cursor);
+        if row < start.row || row > end.row {
+            return None;
+        }
+
+        match selection.kind {
+            VisualSelectionKind::Line => Some((0, line_len)),
+            VisualSelectionKind::Block => {
+                let start_column = selection.anchor.column.min(selection.cursor.column);
+                let end_column = selection.anchor.column.max(selection.cursor.column) + 1;
+                (start_column < line_len).then_some((start_column, end_column.min(line_len)))
+            }
+            VisualSelectionKind::Character => {
+                if start.row == end.row {
+                    let start_column = start.column.min(line_len);
+                    let end_column = (end.column + 1).min(line_len);
+                    (start_column < end_column).then_some((start_column, end_column))
+                } else if row == start.row {
+                    let start_column = start.column.min(line_len);
+                    (start_column < line_len).then_some((start_column, line_len))
+                } else if row == end.row {
+                    let end_column = (end.column + 1).min(line_len);
+                    (end_column > 0).then_some((0, end_column))
+                } else {
+                    Some((0, line_len))
+                }
+            }
+        }
+    }
+
+    fn remember_right_content(&self, right_content: &str) {
+        *self.right_content_lines.borrow_mut() = if right_content.is_empty() {
+            Vec::new()
+        } else {
+            right_content.split('\n').map(str::to_string).collect()
+        };
+    }
+
+    fn selectable_lines(&self, pane: PaneFocus) -> Vec<String> {
+        match pane {
+            PaneFocus::Left => {
+                let inner_width = usize::from(self.layout().left_width.saturating_sub(2).max(1));
+                self.left_pane_lines(inner_width)
+                    .into_iter()
+                    .map(|line| line.text)
+                    .collect()
+            }
+            PaneFocus::Right => self.right_content_lines.borrow().clone(),
+        }
+    }
+
+    fn start_visual_selection(&mut self, kind: VisualSelectionKind) {
+        let pane = if self.focus == PaneFocus::Left && !self.left_visible {
+            PaneFocus::Right
+        } else {
+            self.focus
+        };
+        let lines = self.selectable_lines(pane);
+        if lines.is_empty() {
+            return;
+        }
+        let row = match pane {
+            PaneFocus::Left => self.control_selected.min(lines.len().saturating_sub(1)),
+            PaneFocus::Right => lines.len().saturating_sub(1),
+        };
+        let line_last_column = lines[row].chars().count().saturating_sub(1);
+        let column = match kind {
+            VisualSelectionKind::Line => 0,
+            VisualSelectionKind::Character | VisualSelectionKind::Block => match pane {
+                PaneFocus::Left => 0,
+                PaneFocus::Right => self
+                    .right_cursor_column
+                    .get()
+                    .unwrap_or(line_last_column)
+                    .min(line_last_column),
+            },
+        };
+        let position = TextPosition { row, column };
+        self.visual_selection = Some(VisualSelection {
+            pane,
+            kind,
+            anchor: position,
+            cursor: position,
+        });
+        self.focus = pane;
+    }
+
+    fn handle_visual_key(&mut self, key: UiKey) -> Vec<UiAction> {
+        match key {
+            UiKey::Esc => {
+                self.clear_visual_selection();
+                Vec::new()
+            }
+            UiKey::Char('v') => {
+                self.set_visual_selection_kind(VisualSelectionKind::Character);
+                Vec::new()
+            }
+            UiKey::Char('V') => {
+                self.set_visual_selection_kind(VisualSelectionKind::Line);
+                Vec::new()
+            }
+            UiKey::Char(CTRL_V) => {
+                self.set_visual_selection_kind(VisualSelectionKind::Block);
+                Vec::new()
+            }
+            UiKey::Char('y') => self.copy_visual_selection(false),
+            UiKey::Char('Y') => self.copy_visual_selection(true),
+            UiKey::Char('h') | UiKey::Left => {
+                self.move_visual_cursor(0, -1);
+                Vec::new()
+            }
+            UiKey::Char('j') | UiKey::Down => {
+                self.move_visual_cursor(1, 0);
+                Vec::new()
+            }
+            UiKey::Char('k') | UiKey::Up => {
+                self.move_visual_cursor(-1, 0);
+                Vec::new()
+            }
+            UiKey::Char('l') | UiKey::Right => {
+                self.move_visual_cursor(0, 1);
+                Vec::new()
+            }
+            _ => Vec::new(),
+        }
+    }
+
+    fn set_visual_selection_kind(&mut self, kind: VisualSelectionKind) {
+        let Some(mut selection) = self.visual_selection else {
+            self.start_visual_selection(kind);
+            return;
+        };
+        selection.kind = kind;
+        if kind == VisualSelectionKind::Line {
+            selection.anchor.column = 0;
+            selection.cursor.column = 0;
+        }
+        self.visual_selection = Some(selection);
+    }
+
+    fn move_visual_cursor(&mut self, row_delta: isize, column_delta: isize) {
+        let Some(mut selection) = self.visual_selection else {
+            return;
+        };
+        let lines = self.selectable_lines(selection.pane);
+        if lines.is_empty() {
+            return;
+        }
+
+        let max_row = lines.len().saturating_sub(1) as isize;
+        let max_column = max_selectable_column(&lines) as isize;
+        let row = (selection.cursor.row as isize + row_delta).clamp(0, max_row) as usize;
+        let column =
+            (selection.cursor.column as isize + column_delta).clamp(0, max_column) as usize;
+        selection.cursor = TextPosition { row, column };
+        self.visual_selection = Some(selection);
+    }
+
+    fn copy_visual_selection(&mut self, force_line: bool) -> Vec<UiAction> {
+        let Some(selection) = self.visual_selection else {
+            return Vec::new();
+        };
+        let lines = self.selectable_lines(selection.pane);
+        if lines.is_empty() {
+            self.clear_visual_selection();
+            return Vec::new();
+        }
+
+        let text = if force_line || selection.kind == VisualSelectionKind::Line {
+            selected_line_text(selection, &lines)
+        } else if selection.kind == VisualSelectionKind::Block {
+            selected_block_text(selection, &lines)
+        } else {
+            selected_character_text(selection, &lines)
+        };
+        let char_count = text.chars().count();
+        self.pending_clipboard.replace(Some(text.clone()));
+        self.show_status_notice(
+            format!("copied selection ({char_count} chars)"),
+            Duration::from_secs(STATUS_NOTICE_SECONDS),
+        );
+        self.clear_visual_selection();
+        Vec::new()
+    }
+
+    fn clear_visual_selection(&mut self) {
+        self.visual_selection = None;
+    }
+
+    fn visual_cursor_position(&self) -> Option<(u16, u16)> {
+        let selection = self.visual_selection?;
+        let layout = self.layout();
+        if selection.pane == PaneFocus::Left && !self.left_visible {
+            return None;
+        }
+        let row = 2_u16.saturating_add(selection.cursor.row.min(usize::from(u16::MAX)) as u16);
+        let column_offset = selection.cursor.column.min(usize::from(u16::MAX)) as u16;
+        let column = match selection.pane {
+            PaneFocus::Left => 2_u16.saturating_add(column_offset),
+            PaneFocus::Right => layout
+                .left_width
+                .saturating_add(2)
+                .saturating_add(column_offset),
+        };
+        Some((row, column))
+    }
+
