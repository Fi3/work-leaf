+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::path::PathBuf;
+    use std::sync::{Arc, Mutex};
+
+    use crate::agent::{AgentError, AgentSession, ChatMessage, MessageRole};
+
+    #[derive(Clone, Debug, Default)]
+    struct RecordingBackend {
+        state: Arc<Mutex<RecordingBackendState>>,
+    }
+
+    #[derive(Debug, Default, Eq, PartialEq)]
+    struct RecordingBackendState {
+        sends: Vec<String>,
+        commands: Vec<String>,
+    }
+
+    impl RecordingBackend {
+        fn state(&self) -> Arc<Mutex<RecordingBackendState>> {
+            Arc::clone(&self.state)
+        }
+    }
+
+    impl AgentBackend for RecordingBackend {
+        fn launch(&mut self, request: AgentLaunch) -> Result<AgentSession, AgentError> {
+            let mut session = AgentSession::new(request);
+            session.push_message(MessageRole::Agent, "launch reply");
+            Ok(session)
+        }
+
+        fn send(&mut self, _agent_id: &AgentId, prompt: &str) -> Result<ChatMessage, AgentError> {
+            self.state
+                .lock()
+                .expect("recording backend state mutex poisoned")
+                .sends
+                .push(prompt.to_string());
+            Ok(ChatMessage::new(
+                MessageRole::Agent,
+                format!("send reply: {prompt}"),
+            ))
+        }
+
+        fn run_command(
+            &mut self,
+            _agent_id: &AgentId,
+            command: &str,
+        ) -> Result<ChatMessage, AgentError> {
+            self.state
+                .lock()
+                .expect("recording backend state mutex poisoned")
+                .commands
+                .push(command.to_string());
+            Ok(ChatMessage::new(
+                MessageRole::Agent,
+                format!("command reply: {command}"),
+            ))
+        }
+    }
+
+    #[test]
+    fn selected_agent_status_slash_command_uses_backend_command_not_send() {
+        let (mut controller, agent_id, state) = controller_with_agent();
+
+        controller
+            .send_message(&agent_id, "/status")
+            .expect("selected agent slash command is accepted");
+        assert!(controller.wait_for_idle(Duration::from_secs(1)));
+
+        let recorded = state
+            .lock()
+            .expect("recording backend state mutex poisoned");
+        assert_eq!(recorded.commands, vec!["/status"]);
+        assert!(
+            recorded.sends.is_empty(),
+            "/status must not be delivered through the ordinary send path"
+        );
+        drop(recorded);
+
+        let snapshot = controller.snapshot();
+        let session = snapshot
+            .session(&agent_id)
+            .expect("selected agent session is present");
+        assert!(session.lines.iter().any(|line| line == "user: /status"));
+        assert!(
+            session
+                .lines
+                .iter()
+                .any(|line| line == "command reply: /status")
+        );
+    }
+
+    #[test]
+    fn selected_agent_fork_slash_command_appends_backend_command_output() {
+        let (mut controller, agent_id, state) = controller_with_agent();
+
+        controller
+            .send_message(&agent_id, "/fork")
+            .expect("selected agent slash command is accepted");
+        assert!(controller.wait_for_idle(Duration::from_secs(1)));
+
+        let recorded = state
+            .lock()
+            .expect("recording backend state mutex poisoned");
+        assert_eq!(recorded.commands, vec!["/fork"]);
+        assert!(recorded.sends.is_empty());
+        drop(recorded);
+
+        let snapshot = controller.snapshot();
+        let session = snapshot
+            .session(&agent_id)
+            .expect("selected agent session is present");
+        assert!(session.lines.iter().any(|line| line == "user: /fork"));
+        assert!(
+            session
+                .lines
+                .iter()
+                .any(|line| line == "command reply: /fork")
+        );
+    }
+
+    fn controller_with_agent() -> (
+        WorkLeafController<RecordingBackend>,
+        AgentId,
+        Arc<Mutex<RecordingBackendState>>,
+    ) {
+        let backend = RecordingBackend::default();
+        let state = backend.state();
+        let chat = CommandChat::new(PathBuf::from("."), backend);
+        let mut controller = WorkLeafController::new(chat);
+        let agent_id = controller
+            .create_agent("")
+            .expect("fixture agent launch is prepared");
+        assert!(controller.wait_for_idle(Duration::from_secs(1)));
+        (controller, agent_id, state)
+    }
+}
