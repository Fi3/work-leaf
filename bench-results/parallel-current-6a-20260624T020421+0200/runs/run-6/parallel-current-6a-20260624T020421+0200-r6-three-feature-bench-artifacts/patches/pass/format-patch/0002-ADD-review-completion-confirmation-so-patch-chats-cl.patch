+#[test]
+fn scripted_harness_feature_done_prompt_closes_and_reopens_selected_chat() {
+    let mut harness = UiHarness::new(100, 24);
+
+    harness
+        .mark_agent_feature_done_prompt("user-1")
+        .expect("fixture user-1 agent is registered");
+
+    let prompt_frame = harness.render_frame();
+    assert!(prompt_frame.starts_with('\u{7}'));
+    assert!(harness.ui().render_left_pane().contains("DONE?"));
+
+    harness
+        .close_agent("user-1")
+        .expect("fixture user-1 agent is registered");
+
+    let closed_frame = harness.render_frame();
+    assert!(!closed_frame.contains("parser user-1"));
+    assert!(!closed_frame.contains("src/parser.rs"));
+
+    harness.handle_bytes(b"ifollow up\n");
+
+    let reopened_frame = harness.render_frame();
+    assert!(reopened_frame.contains("user-1"));
+    assert!(
+        harness
+            .transcript()
+            .iter()
+            .any(|line| line == "user-1> follow up")
+    );
+}
