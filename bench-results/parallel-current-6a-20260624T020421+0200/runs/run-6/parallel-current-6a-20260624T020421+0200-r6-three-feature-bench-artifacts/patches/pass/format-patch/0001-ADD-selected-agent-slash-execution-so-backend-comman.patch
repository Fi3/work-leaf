+fn slash_command_token(command: &str) -> Option<&str> {
+    let rest = command.strip_prefix('/')?;
+    let first = rest.chars().next()?;
+    if first.is_whitespace() {
+        return None;
+    }
+    let end = rest
+        .char_indices()
+        .find_map(|(index, ch)| ch.is_whitespace().then_some(index))
+        .unwrap_or(rest.len());
+    Some(&rest[..end])
+}
