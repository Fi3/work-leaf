+#[test]
+fn controller_executes_status_slash_command_through_backend_command_path() {
+    let backend = FakeBackend::new(["launch reply"]);
+    let chat = CommandChat::new(PathBuf::from("/repo"), backend.clone());
+    let mut controller = WorkLeafController::new(chat);
+
+    let agent_id = controller.create_agent("inspect status").unwrap();
+    assert!(controller.wait_for_idle(Duration::from_secs(1)));
+
+    controller.send_message(&agent_id, "/status").unwrap();
+    assert!(controller.wait_for_idle(Duration::from_secs(1)));
+
+    assert_eq!(
+        backend.commands(),
+        vec![(agent_id.clone(), "/status".to_string())]
+    );
+    assert!(
+        backend.sends().is_empty(),
+        "/status must not be routed through the normal backend send path"
+    );
+    let snapshot = controller.snapshot();
+    let session = snapshot.session(&agent_id).expect("session exists");
+    assert!(session.lines.iter().any(|line| line == "user: /status"));
+    assert!(
+        session
+            .lines
+            .iter()
+            .any(|line| line == "backend command output: user-1 /status")
+    );
+}
+
+#[test]
+fn controller_executes_status_slash_command_while_agent_is_working() {
+    let backend = ConcurrentBackend;
+    let chat = CommandChat::new(PathBuf::from("/repo"), backend);
+    let mut controller = WorkLeafController::new(chat);
+
+    let _quick_agent_id = controller.create_agent("quick task").unwrap();
+    let agent_id = controller.create_agent("slow task").unwrap();
+    assert!(controller.wait_for_idle(Duration::from_secs(1)));
+    assert_eq!(agent_id.as_str(), "user-2");
+
+    controller.send_message(&agent_id, "slow question").unwrap();
+    controller.send_message(&agent_id, "/status").unwrap();
+
+    assert!(controller.wait_for_session_line(
+        &agent_id,
+        "backend command output: user-2 /status",
+        Duration::from_millis(150)
+    ));
+    let snapshot = controller.snapshot();
+    let session = snapshot.session(&agent_id).expect("session exists");
+    assert_eq!(session.loading, Some(WorkLeafLoading::WaitingForReply));
+    assert!(session.lines.iter().any(|line| line == "user: /status"));
+    assert!(
+        !session
+            .lines
+            .iter()
+            .any(|line| line.contains("still working"))
+    );
+
+    assert!(controller.wait_for_idle(Duration::from_secs(1)));
+}
