+fn ordered_positions(left: TextPosition, right: TextPosition) -> (TextPosition, TextPosition) {
+    if (left.line, left.column) <= (right.line, right.column) {
+        (left, right)
+    } else {
+        (right, left)
+    }
+}
+
+fn ordered_lines(selection: VisualSelection) -> (usize, usize) {
+    (
+        selection.anchor.line.min(selection.cursor.line),
+        selection.anchor.line.max(selection.cursor.line),
+    )
+}
+
+fn selection_range_for_line(
+    selection: VisualSelection,
+    line_index: usize,
+    line: &str,
+) -> Option<(usize, usize)> {
+    let line_len = line_char_count(line);
+    match selection.kind {
+        VisualKind::Character => {
+            let (start, end) = ordered_positions(selection.anchor, selection.cursor);
+            if line_index < start.line || line_index > end.line {
+                return None;
+            }
+            let start_column = if line_index == start.line {
+                start.column.min(line_len)
+            } else {
+                0
+            };
+            let end_column = if line_index == end.line {
+                end.column.saturating_add(1).min(line_len)
+            } else {
+                line_len
+            };
+            Some((start_column, end_column))
+        }
+        VisualKind::Line => {
+            let (start_line, end_line) = ordered_lines(selection);
+            (start_line..=end_line)
+                .contains(&line_index)
+                .then_some((0, line_len))
+        }
+        VisualKind::Block => {
+            let (start_line, end_line) = ordered_lines(selection);
+            if !(start_line..=end_line).contains(&line_index) {
+                return None;
+            }
+            let start_column = selection
+                .anchor
+                .column
+                .min(selection.cursor.column)
+                .min(line_len);
+            let end_column = selection
+                .anchor
+                .column
+                .max(selection.cursor.column)
+                .saturating_add(1)
+                .min(line_len);
+            Some((start_column, end_column))
+        }
+    }
+}
+
+fn styled_line_spans(line: &str, start: usize, end: usize) -> Spans<'static> {
+    if start >= end {
+        return Spans::from(vec![Span::raw(line.to_string())]);
+    }
+    let selected_style = Style::default().add_modifier(Modifier::REVERSED);
+    let mut spans = Vec::new();
+    let before = char_slice(line, 0, start);
+    if !before.is_empty() {
+        spans.push(Span::raw(before));
+    }
+    let selected = char_slice(line, start, end);
+    if !selected.is_empty() {
+        spans.push(Span::styled(selected, selected_style));
+    }
+    let after = char_slice(line, end, line_char_count(line));
+    if !after.is_empty() {
+        spans.push(Span::raw(after));
+    }
+    if spans.is_empty() {
+        spans.push(Span::raw(String::new()));
+    }
+    Spans::from(spans)
+}
+
+fn selection_text(lines: &[String], selection: VisualSelection) -> String {
+    match selection.kind {
+        VisualKind::Character => {
+            let (start, end) = ordered_positions(selection.anchor, selection.cursor);
+            lines
+                .iter()
+                .enumerate()
+                .filter_map(|(line_index, line)| {
+                    if line_index < start.line || line_index > end.line {
+                        return None;
+                    }
+                    let line_len = line_char_count(line);
+                    let start_column = if line_index == start.line {
+                        start.column.min(line_len)
+                    } else {
+                        0
+                    };
+                    let end_column = if line_index == end.line {
+                        end.column.saturating_add(1).min(line_len)
+                    } else {
+                        line_len
+                    };
+                    Some(char_slice(line, start_column, end_column))
+                })
+                .collect::<Vec<_>>()
+                .join("\n")
+        }
+        VisualKind::Line => {
+            let (start_line, end_line) = ordered_lines(selection);
+            lines
+                .iter()
+                .skip(start_line)
+                .take(end_line.saturating_sub(start_line).saturating_add(1))
+                .cloned()
+                .collect::<Vec<_>>()
+                .join("\n")
+        }
+        VisualKind::Block => {
+            let (start_line, end_line) = ordered_lines(selection);
+            let start_column = selection.anchor.column.min(selection.cursor.column);
+            let end_column = selection
+                .anchor
+                .column
+                .max(selection.cursor.column)
+                .saturating_add(1);
+            lines
+                .iter()
+                .skip(start_line)
+                .take(end_line.saturating_sub(start_line).saturating_add(1))
+                .map(|line| {
+                    let line_len = line_char_count(line);
+                    char_slice(line, start_column.min(line_len), end_column.min(line_len))
+                })
+                .collect::<Vec<_>>()
+                .join("\n")
+        }
+    }
+}
+
+fn char_slice(line: &str, start: usize, end: usize) -> String {
+    line.chars()
+        .skip(start)
+        .take(end.saturating_sub(start))
+        .collect()
+}
