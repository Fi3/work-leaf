+    fn handle_visual_key(&mut self, key: UiKey) -> Vec<UiAction> {
+        match key {
+            UiKey::Esc => self.clear_visual_selection(),
+            UiKey::Char('v') => self.start_visual_selection(VisualKind::Character),
+            UiKey::Char('V') => self.start_visual_selection(VisualKind::Line),
+            UiKey::Char(CTRL_V_KEY) => self.start_visual_selection(VisualKind::Block),
+            UiKey::Char('y') => self.yank_visual_selection(None),
+            UiKey::Char('Y') => self.yank_visual_selection(Some(VisualKind::Line)),
+            UiKey::Char('h') | UiKey::Left => self.move_visual_cursor(0, -1),
+            UiKey::Char('j') | UiKey::Down => self.move_visual_cursor(1, 0),
+            UiKey::Char('k') | UiKey::Up => self.move_visual_cursor(-1, 0),
+            UiKey::Char('l') | UiKey::Right => self.move_visual_cursor(0, 1),
+            _ => {}
+        }
