+    fn current_visual_position(&self, pane: PaneFocus) -> TextPosition {
+        let lines = self.selection_pane_lines(pane);
+        let line = match pane {
+            PaneFocus::Left => self.control_selected,
+            PaneFocus::Right => lines.len().saturating_sub(1),
+        }
+        .min(lines.len().saturating_sub(1));
+        TextPosition { line, column: 0 }
+    }
+
+    fn move_visual_cursor(&mut self, line_delta: isize, column_delta: isize) {
+        let Some(selection) = self.visual_selection else {
+            return;
+        };
+        let lines = self.selection_pane_lines(selection.pane);
+        if lines.is_empty() {
+            return;
+        }
+        let next_line = (selection.cursor.line as isize + line_delta)
+            .clamp(0, lines.len().saturating_sub(1) as isize) as usize;
+        let next_column = (selection.cursor.column as isize + column_delta).max(0) as usize;
+        let max_column = lines
+            .get(next_line)
+            .map(|line| line_char_count(line).saturating_sub(1))
+            .unwrap_or(0);
+        if let Some(selection) = self.visual_selection.as_mut() {
+            selection.cursor = TextPosition {
+                line: next_line,
+                column: next_column.min(max_column),
+            };
+        }
+    }
