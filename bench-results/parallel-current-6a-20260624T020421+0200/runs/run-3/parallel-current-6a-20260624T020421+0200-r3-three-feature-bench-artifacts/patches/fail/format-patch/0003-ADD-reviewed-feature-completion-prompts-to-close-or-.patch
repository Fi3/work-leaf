+#[test]
+fn controller_prompts_for_feature_completion_after_review_and_reopens_on_new_chat() {
+    let root = git_repo("workspace-feature-completion");
+    fs::create_dir_all(root.join("src")).unwrap();
+    fs::write(root.join("src/lib.rs"), "before\n").unwrap();
+    git(&root, ["add", "src/lib.rs"]);
+    git(&root, ["commit", "-m", "ADD initial lib fixture"]);
+    let backend = FakeBackend::new([
+        "implemented patch\n@work-leaf patch update lib\n--- a/src/lib.rs\n+++ b/src/lib.rs\n@@ -1 +1 @@\n-before\n+after\n@work-leaf end\n@work-leaf done",
+        "summary: src lib changed from before to after",
+        "NO_FINDINGS",
+        "second patch\n@work-leaf patch polish lib\n--- a/src/lib.rs\n+++ b/src/lib.rs\n@@ -1 +1 @@\n-after\n+polished\n@work-leaf end\n@work-leaf done",
+        "summary: src lib changed from after to polished",
+        "NO_FINDINGS",
+    ]);
+    let chat = CommandChat::new(root, backend.clone()).with_max_review_rounds(4);
+    let mut controller = WorkLeafController::new(chat);
+
+    let agent_id = controller.create_agent("update lib").unwrap();
+
+    assert!(controller.wait_for_idle(Duration::from_secs(2)));
+    let snapshot = controller.snapshot();
+    let patch_agent = snapshot.session(&agent_id).expect("patch agent exists");
+    assert_eq!(patch_agent.loading, None);
+    assert!(
+        patch_agent
+            .lines
+            .iter()
+            .any(|line| line == "work-leaf: is this feature done? yes/no")
+    );
+    let completion_events = controller.drain_events();
+    assert!(completion_events.iter().any(|event| {
+        matches!(event, WorkLeafEvent::AgentSelected { agent_id: id } if id == &agent_id)
+    }));
+
+    let sends_after_review = backend.sends().len();
+    controller.send_message(&agent_id, "yes").unwrap();
+    let accepted = controller.snapshot();
+    let patch_agent = accepted.session(&agent_id).expect("patch agent exists");
+    assert!(patch_agent.lines.iter().any(|line| line == "user: yes"));
+    assert!(
+        patch_agent
+            .lines
+            .iter()
+            .any(|line| line == "work-leaf: feature marked done")
+    );
+    assert_eq!(
+        backend.sends().len(),
+        sends_after_review,
+        "answering yes should close the completion prompt without sending to the agent"
+    );
+    let close_events = controller.drain_events();
+    assert!(close_events.iter().any(|event| {
+        matches!(
+            event,
+            WorkLeafEvent::AgentLineAppended { agent_id: id, line }
+                if id == &agent_id && line == "work-leaf: feature marked done"
+        )
+    }));
+
+    controller
+        .send_message(&agent_id, "please polish the result")
+        .unwrap();
+    assert!(controller.wait_for_idle(Duration::from_secs(1)));
+    let reopen_events = controller.drain_events();
+    assert!(reopen_events.iter().any(|event| {
+        matches!(
+            event,
+            WorkLeafEvent::AgentLineAppended { agent_id: id, line }
+                if id == &agent_id && line == "work-leaf: feature reopened"
+        )
+    }));
+    assert!(reopen_events.iter().any(|event| {
+        matches!(
+            event,
+            WorkLeafEvent::AgentLineAppended { agent_id: id, line }
+                if id == &agent_id && line == "work-leaf: is this feature done? yes/no"
+        )
+    }));
+    let reopened = controller.snapshot();
+    let patch_agent = reopened.session(&agent_id).expect("patch agent exists");
+    assert!(
+        patch_agent
+            .lines
+            .iter()
+            .any(|line| line == "work-leaf: feature reopened")
+    );
+    assert!(
+        patch_agent
+            .lines
+            .iter()
+            .any(|line| line.contains("user-1 reviewed by review-user-1: rounds=1 resolved=yes"))
+    );
+    assert!(
+        backend
+            .sends()
+            .iter()
+            .any(|(target, prompt)| target == &agent_id && prompt == "please polish the result")
+    );
+
+    let sends_after_second_review = backend.sends().len();
+    controller.send_message(&agent_id, "yes").unwrap();
+    let second_close_events = controller.drain_events();
+    assert!(second_close_events.iter().any(|event| {
+        matches!(
+            event,
+            WorkLeafEvent::AgentLineAppended { agent_id: id, line }
+                if id == &agent_id && line == "work-leaf: feature marked done"
+        )
+    }));
+    assert_eq!(
+        backend.sends().len(),
+        sends_after_second_review,
+        "answering yes a second time should still close locally without sending to the agent"
+    );
+}
