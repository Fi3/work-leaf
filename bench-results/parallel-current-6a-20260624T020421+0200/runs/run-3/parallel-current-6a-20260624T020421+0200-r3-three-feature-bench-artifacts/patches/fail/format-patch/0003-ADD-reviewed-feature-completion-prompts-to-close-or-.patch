+#[test]
+fn terminal_app_highlights_patch_agent_for_completion_after_review() {
+    let root = git_repo("terminal-app-review-completion");
+    fs::create_dir_all(root.join("src")).unwrap();
+    fs::write(root.join("src/lib.rs"), "before\n").unwrap();
+    Command::new("git")
+        .current_dir(&root)
+        .args(["add", "src/lib.rs"])
+        .status()
+        .unwrap();
+    Command::new("git")
+        .current_dir(&root)
+        .args(["commit", "-m", "ADD initial lib fixture"])
+        .status()
+        .unwrap();
+    let backend = FakeBackend::new([
+        "implemented patch\n@work-leaf patch update lib\n--- a/src/lib.rs\n+++ b/src/lib.rs\n@@ -1 +1 @@\n-before\n+after\n@work-leaf end\n@work-leaf done",
+        "summary: src lib changed from before to after",
+        "NO_FINDINGS",
+        "second patch\n@work-leaf patch polish lib\n--- a/src/lib.rs\n+++ b/src/lib.rs\n@@ -1 +1 @@\n-after\n+polished\n@work-leaf end\n@work-leaf done",
+        "summary: src lib changed from after to polished",
+        "NO_FINDINGS",
+    ]);
+    let chat = CommandChat::new(root, backend).with_max_review_rounds(4);
+    let mut app = TerminalApp::new(chat, 100, 24);
+
+    app.handle_bytes(b":new patch lib\n");
+
+    assert!(app.wait_for_idle(Duration::from_secs(2)));
+    assert_eq!(
+        app.ui().selected_agent().map(AgentId::as_str),
+        Some("user-1")
+    );
+    let frame = app.render_frame();
+    assert!(frame.starts_with('\u{7}'));
+    assert!(frame.contains("work-leaf: is this feature done? yes/no"));
+    let left_pane = app.ui().render_left_pane();
+    assert!(left_pane.contains("user-1"));
+    assert!(left_pane.contains("READY"));
+
+    app.handle_bytes(b"yes\n");
+    let closed_frame = app.render_frame();
+    assert_eq!(
+        app.ui().selected_agent().map(AgentId::as_str),
+        Some("review-user-1")
+    );
+    let closed_left_pane = app.ui().render_left_pane();
+    assert!(!closed_left_pane.contains("patch user-1"));
+    assert!(closed_left_pane.contains("review-user-1"));
+    assert!(
+        !closed_frame.contains("work-leaf: feature marked done"),
+        "yes should close the completed patch-agent chat instead of leaving it visible"
+    );
+
+    app.handle_bytes(b"please polish it\n");
+    assert!(app.wait_for_idle(Duration::from_secs(1)));
+    let frame = app.render_frame();
+    assert!(frame.contains("work-leaf: feature reopened"));
+    assert!(frame.contains("work-leaf: is this feature done? yes/no"));
+    assert!(
+        frame.rfind("work-leaf: feature reopened")
+            < frame.rfind("work-leaf: is this feature done? yes/no"),
+        "the repeated completion prompt should be visible after the reopen line"
+    );
+
+    app.handle_bytes(b"yes\n");
+    let second_closed_left_pane = app.ui().render_left_pane();
+    assert!(!second_closed_left_pane.contains("patch user-1"));
+    assert!(second_closed_left_pane.contains("review-user-1"));
+
+    let backend = app.into_chat().into_backend();
+    let sends = backend.sends();
+    assert!(
+        !sends
+            .iter()
+            .any(|(target, prompt)| target.as_str() == "user-1" && prompt == "yes")
+    );
+    assert!(
+        sends
+            .iter()
+            .any(|(target, prompt)| target.as_str() == "user-1" && prompt == "please polish it")
+    );
+}
