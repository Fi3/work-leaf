+fn selected_character_text(selection: VisualSelection, lines: &[String]) -> String {
+    if lines.is_empty() {
+        return String::new();
+    }
+    let (start, end) = ordered_positions(
+        clamp_text_position(selection.anchor, lines),
+        clamp_text_position(selection.cursor, lines),
+    );
+    (start.row..=end.row)
+        .map(|row| {
+            let line = &lines[row];
+            let start_column = if row == start.row { start.column } else { 0 };
+            let end_column = if row == end.row {
+                end.column.saturating_add(1)
+            } else {
+                char_count(line)
+            };
+            char_range(line, start_column, end_column)
+        })
+        .collect::<Vec<_>>()
+        .join("\n")
+}
+
+fn selected_line_text(selection: VisualSelection, lines: &[String]) -> String {
+    if lines.is_empty() {
+        return String::new();
+    }
+    let start = selection
+        .anchor
+        .row
+        .min(selection.cursor.row)
+        .min(lines.len() - 1);
+    let end = selection
+        .anchor
+        .row
+        .max(selection.cursor.row)
+        .min(lines.len() - 1);
+    lines[start..=end].join("\n")
+}
