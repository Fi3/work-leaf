+#[derive(Clone, Copy)]
+struct VisualArea {
+    x: u16,
+    y: u16,
+    width: u16,
+    height: u16,
+}
+
+fn reverse_visual_line(buffer: &mut Buffer, line: &str, start_row: usize, area: VisualArea) {
+    let rows = visual_row_count(line, area.width);
+    for visual_row in start_row..start_row.saturating_add(rows) {
+        if visual_row >= usize::from(area.height) {
+            break;
+        }
+        for column in 0..area.width {
+            reverse_cell(
+                buffer,
+                area.x.saturating_add(column),
+                area.y.saturating_add(visual_row as u16),
+            );
+        }
+    }
