+
+fn reverse_character_range(
+    buffer: &mut Buffer,
+    line: &str,
+    start_row: usize,
+    start_column: usize,
+    end_column: usize,
+    area: VisualArea,
+) {
+    let line_len = char_count(line);
+    let start_column = start_column.min(line_len);
+    let end_column = end_column.min(line_len);
+    for column in start_column..end_column.max(start_column.saturating_add(1)) {
+        let visual_row = start_row.saturating_add(column / usize::from(area.width));
+        if visual_row >= usize::from(area.height) {
+            break;
+        }
+        let visual_column = column % usize::from(area.width);
+        reverse_cell(
+            buffer,
+            area.x.saturating_add(visual_column as u16),
+            area.y.saturating_add(visual_row as u16),
+        );
+    }
