+    fn current_text_position(
+        &self,
+        right_content: &str,
+        right_cursor_column: Option<usize>,
+    ) -> TextPosition {
+        let lines = self.pane_lines_for_interaction(self.focus, right_content);
+        if lines.is_empty() {
+            return TextPosition { row: 0, column: 0 };
+        }
+        let row = match self.focus {
+            PaneFocus::Left => self
