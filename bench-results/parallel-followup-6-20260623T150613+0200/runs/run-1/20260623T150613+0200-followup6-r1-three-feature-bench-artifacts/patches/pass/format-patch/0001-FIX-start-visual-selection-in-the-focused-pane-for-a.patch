diff --git a/tests/ui_harness.rs b/tests/ui_harness.rs
index 3502bcf..63e645d 100644
--- a/tests/ui_harness.rs
+++ b/tests/ui_harness.rs
@@ -348,6 +348,66 @@ fn scripted_harness_visual_mode_yanks_right_pane_line_to_clipboard() {
     assert!(frame.contains("copied "));
 }
 
+#[test]
+fn scripted_harness_v_starts_right_pane_character_selection_and_yanks_text() {
+    let mut harness = UiHarness::new(80, 24);
+
+    harness.handle_bytes(&[23, b'l']);
+    harness.handle_byte(b'v');
+
+    assert!(harness.ui().visual_selection_active());
+    assert!(
+        harness
+            .render_frame()
+            .contains("mode=visual-char focus=right")
+    );
+
+    harness.handle_bytes(b"llll");
+    harness.handle_byte(b'y');
+
+    assert_eq!(harness.ui().copied_text(), Some("Esc c"));
+}
+
+#[test]
+fn scripted_harness_v_starts_left_pane_character_selection_at_selected_row() {
+    let mut harness = UiHarness::new(120, 24);
+
+    harness.handle_byte(b'v');
+
+    assert!(harness.ui().visual_selection_active());
+    assert!(
+        harness
+            .render_frame()
+            .contains("mode=visual-char focus=left")
+    );
+
+    harness.handle_bytes(b"llllll");
+    harness.handle_byte(b'y');
+
+    assert_eq!(harness.ui().copied_text(), Some(">parser"));
+}
+
+#[test]
+fn scripted_harness_ctrl_v_starts_block_selection_and_yanks_rectangle() {
+    let mut harness = UiHarness::new(80, 24);
+
+    harness.handle_bytes(&[23, b'l']);
+    harness.handle_byte(22);
+
+    assert!(harness.ui().visual_selection_active());
+    assert!(
+        harness
+            .render_frame()
+            .contains("mode=visual-block focus=right")
+    );
+
+    harness.handle_byte(b'k');
+    harness.handle_bytes(b"ll");
+    harness.handle_byte(b'y');
+
+    assert_eq!(harness.ui().copied_text(), Some("UI \nEsc"));
+}
+
