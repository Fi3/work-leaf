+    #[derive(Debug, Default)]
+    struct CommandGate {
+        state: Mutex<CommandGateState>,
+        condvar: Condvar,
+    }
+
+    #[derive(Debug, Default)]
+    struct CommandGateState {
+        started: bool,
+        released: bool,
+    }
+
+    impl CommandGate {
+        fn mark_started_and_wait(&self) {
+            let mut state = self.state.lock().unwrap();
+            state.started = true;
+            self.condvar.notify_all();
+            while !state.released {
+                state = self.condvar.wait(state).unwrap();
+            }
+        }
+
+        fn wait_started(&self, timeout: Duration) -> bool {
+            let started_at = std::time::Instant::now();
+            let mut state = self.state.lock().unwrap();
+            loop {
+                if state.started {
+                    return true;
+                }
+                let Some(remaining) = timeout.checked_sub(started_at.elapsed()) else {
+                    return false;
+                };
+                let (next_state, result) = self.condvar.wait_timeout(state, remaining).unwrap();
+                state = next_state;
+                if result.timed_out() && !state.started {
+                    return false;
+                }
+            }
+        }
+
+        fn release(&self) {
+            let mut state = self.state.lock().unwrap();
+            state.released = true;
+            self.condvar.notify_all();
+        }
+    }
