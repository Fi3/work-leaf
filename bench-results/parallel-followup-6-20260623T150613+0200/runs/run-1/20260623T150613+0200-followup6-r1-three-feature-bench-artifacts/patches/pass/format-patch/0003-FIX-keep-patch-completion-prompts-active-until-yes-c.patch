+    fn handle_feature_completion_message(&mut self, agent_id: &AgentId, message: &str) -> bool {
+        if self.closed_features.remove(agent_id) {
+            if let Some(feature) = self.completion_features.remove(agent_id) {
+                let _ = self.ui.set_agent_feature(agent_id, feature);
+                let _ = self.ui.set_agent_patch_lifecycle(agent_id, true, false);
+                let _ = self.ui.set_agent_ready_state(agent_id, false);
+            }
+            return false;
+        }
+
+        let Some(feature) = self.completion_features.get(agent_id).cloned() else {
+            return false;
+        };
+
+        self.transcript.push(format!("{agent_id}> {message}"));
+        if message.eq_ignore_ascii_case("yes") {
+            self.closed_features.insert(agent_id.clone());
+            let _ = self
+                .ui
+                .set_agent_feature(agent_id, format!("{feature} CLOSED"));
+            let _ = self.ui.set_agent_patch_lifecycle(agent_id, true, true);
+            let _ = self.ui.set_agent_ready_state(agent_id, false);
+            self.transcript
+                .push("work-leaf: feature marked closed".to_string());
+        } else if message.eq_ignore_ascii_case("no") {
+            self.completion_features.remove(agent_id);
+            let _ = self.ui.set_agent_feature(agent_id, feature);
+            let _ = self.ui.set_agent_patch_lifecycle(agent_id, true, false);
+            let _ = self.ui.set_agent_ready_state(agent_id, false);
+            self.transcript
+                .push("work-leaf: feature remains open".to_string());
+        } else {
+            self.transcript
+                .push("work-leaf: answer yes or no to close this feature".to_string());
+        }
+        true
+    }
