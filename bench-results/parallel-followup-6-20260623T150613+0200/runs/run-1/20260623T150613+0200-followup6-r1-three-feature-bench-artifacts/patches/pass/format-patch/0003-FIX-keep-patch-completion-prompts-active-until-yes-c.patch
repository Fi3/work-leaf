+    #[test]
+    fn closed_feature_reopens_when_user_sends_follow_up() {
+        let backend = ScriptedBackend::new(["reopened reply"]);
+        let agent_id = AgentId::new("user-1").expect("test agent id is valid");
+        let mut controller = controller_with_agent(backend.clone(), &agent_id);
+
+        controller.ask_feature_done(&agent_id);
+        controller
+            .send_message(&agent_id, "yes")
+            .expect("completion answer is accepted");
+
+        let snapshot = controller.snapshot();
+        let closed = snapshot
+            .session(&agent_id)
+            .expect("patch agent session exists");
+        assert_eq!(closed.completion, Some(WorkLeafCompletion::Closed));
+        assert!(
+            closed
+                .lines
+                .iter()
+                .any(|line| line == FEATURE_CLOSED_MESSAGE),
+            "{closed:?}"
+        );
+
+        controller
+            .send_message(&agent_id, "please continue")
+            .expect("closed patch chat can be reopened");
+        assert!(controller.wait_for_idle(Duration::from_secs(1)));
+
+        let snapshot = controller.snapshot();
+        let reopened = snapshot
+            .session(&agent_id)
+            .expect("patch agent session exists");
+        assert_eq!(reopened.completion, None);
+        assert!(
+            backend
+                .sends()
+                .iter()
+                .any(|(id, prompt)| id == &agent_id && prompt == "please continue"),
+            "{:?}",
+            backend.sends()
+        );
+        assert!(
+            reopened.lines.iter().any(|line| line == "reopened reply"),
+            "{reopened:?}"
+        );
+    }
