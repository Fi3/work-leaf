From b4628c12c4dea00b58984c892604b729d3e94ec4 Mon Sep 17 00:00:00 2001
From: fi3 <you@example.com>
Date: Tue, 23 Jun 2026 15:25:56 +0200
Subject: [PATCH 3/3] ADD visual selection yanks for focused panes to make
 copied text consistent

Visual-mode entry creates an active selection immediately in the focused pane so character, line, and block yanks share the same copyable text path across chat and left-pane rows.
---
 src/ui.rs            | 45 ++++++++++++++++++------------
 tests/terminal_ui.rs | 22 +++++++--------
 tests/ui_harness.rs  | 65 ++++++++++++++++++++++++++++++++++++++++++--
 3 files changed, 100 insertions(+), 32 deletions(-)

diff --git a/src/ui.rs b/src/ui.rs
index 620b15c..e642e61 100644
--- a/src/ui.rs
+++ b/src/ui.rs
@@ -1096,11 +1096,11 @@ impl TerminalUi {
         visible_right_content: &str,
         right_cursor_column: Option<usize>,
     ) {
-        let point = self.visual_start_point(visible_right_content, right_cursor_column);
-        self.visual_cursor = Some(VisualCursor {
-            pane: self.focus,
-            point,
-        });
+        self.start_visual_selection(
+            VisualSelectionMode::Character,
+            visible_right_content,
+            right_cursor_column,
+        );
     }
 
     fn start_visual_selection(
@@ -1189,8 +1189,8 @@ impl TerminalUi {
     ) -> VisualPoint {
         match self.focus {
             PaneFocus::Left => {
-                let lines = self.visual_pane_lines(visible_right_content, PaneFocus::Left);
-                let row = self.control_selected.min(lines.len().saturating_sub(1));
+                let inner_width = usize::from(self.layout().left_width.saturating_sub(2).max(1));
+                let row = self.left_control_row_index(inner_width).unwrap_or(0);
                 VisualPoint { row, column: 0 }
             }
             PaneFocus::Right => {
@@ -1524,9 +1524,12 @@ impl TerminalUi {
             .column
             .min(lines[row].chars().count().saturating_sub(1));
         Some((
-            area.y.saturating_add(row.min(usize::from(u16::MAX)) as u16),
+            area.y
+                .saturating_add(row.min(usize::from(u16::MAX)) as u16)
+                .saturating_add(1),
             area.x
-                .saturating_add(column.min(usize::from(u16::MAX)) as u16),
+                .saturating_add(column.min(usize::from(u16::MAX)) as u16)
+                .saturating_add(1),
         ))
     }
 
@@ -2048,19 +2051,25 @@ impl TerminalUi {
             .or_else(|| self.selected_agent.clone())
     }
 
-    fn control_cursor_row(&self) -> u16 {
-        let target = if self.control_selected == 0 {
-            LeftPaneClickTarget::Command
+    fn left_control_target(&self) -> Option<LeftPaneClickTarget> {
+        if self.control_selected == 0 {
+            Some(LeftPaneClickTarget::Command)
         } else {
-            let Some(agent_id) = self.control_selected_agent_id() else {
-                return 2;
-            };
-            LeftPaneClickTarget::Agent(agent_id)
-        };
-        let inner_width = usize::from(self.layout().left_width.saturating_sub(2).max(1));
+            self.control_selected_agent_id()
+                .map(LeftPaneClickTarget::Agent)
+        }
+    }
+
+    fn left_control_row_index(&self, inner_width: usize) -> Option<usize> {
+        let target = self.left_control_target()?;
         self.left_pane_lines(inner_width)
             .iter()
             .position(|line| line.control_target.as_ref() == Some(&target))
+    }
+
+    fn control_cursor_row(&self) -> u16 {
+        let inner_width = usize::from(self.layout().left_width.saturating_sub(2).max(1));
+        self.left_control_row_index(inner_width)
             .map(|row| (row + 2).min(usize::from(u16::MAX)) as u16)
             .unwrap_or(2)
     }
