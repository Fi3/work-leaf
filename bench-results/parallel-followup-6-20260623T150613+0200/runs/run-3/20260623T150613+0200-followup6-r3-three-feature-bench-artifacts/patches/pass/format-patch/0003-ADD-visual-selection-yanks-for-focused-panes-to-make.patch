-fn visual_mode_v_enters_cursor_mode_before_selecting_text() {
+fn visual_mode_v_starts_character_selection_in_focused_pane() {
     let mut ui = TerminalUi::new(120, 20);
     let chat_a = AgentId::new("chat-a").unwrap();
     let chat_b = AgentId::new("chat-b").unwrap();
@@ -356,31 +356,31 @@ fn visual_mode_v_enters_cursor_mode_before_selecting_text() {
 
     ui.handle_key(UiKey::Char('v'));
 
-    assert!(!ui.visual_selection_active());
+    assert!(ui.visual_selection_active());
     assert!(
         ui.render_screen("right pane")
-            .contains("mode=visual-cursor focus=left")
+            .contains("mode=visual-char focus=left")
     );
 
     ui.handle_key(UiKey::Char('j'));
-    assert!(!ui.visual_selection_active());
+    assert!(ui.visual_selection_active());
     assert!(
         ui.render_screen("right pane")
-            .contains("mode=visual-cursor focus=left")
+            .contains("mode=visual-char focus=left")
     );
 
-    ui.handle_key(UiKey::Char('v'));
-    assert!(ui.visual_selection_active());
     ui.handle_key(UiKey::Esc);
 
     ui.handle_key(UiKey::Char('v'));
     ui.handle_key(UiKey::Char('j'));
     ui.handle_key(UiKey::Char('j'));
-    ui.handle_key(UiKey::Char('j'));
     ui.handle_key(UiKey::Char('V'));
     ui.handle_key(UiKey::Char('y'));
 
-    assert_eq!(ui.copied_text(), Some(" parser chat-a"));
+    assert_eq!(
+        ui.copied_text(),
+        Some("> work-leaf  command\n[working]\n parser chat-a")
+    );
 }
 
 #[test]
diff --git a/tests/ui_harness.rs b/tests/ui_harness.rs
index aecb8e1..21d4534 100644
--- a/tests/ui_harness.rs
+++ b/tests/ui_harness.rs
@@ -391,6 +391,65 @@ fn scripted_harness_visual_mode_yanks_right_pane_line_to_clipboard() {
     assert!(frame.contains("copied "));
 }
 
+#[test]
+fn scripted_harness_visual_char_yanks_right_pane_selection_to_clipboard() {
+    let mut harness = UiHarness::new(80, 24);
+
+    harness.handle_bytes(&[23, b'l']);
+    harness.handle_byte(b'v');
+
+    assert!(harness.ui().visual_selection_active());
+    assert!(
+        harness
+            .render_frame()
+            .contains("mode=visual-char focus=right")
+    );
+
+    harness.handle_bytes(b"ll");
+    harness.handle_byte(b'y');
+
+    assert_eq!(harness.ui().copied_text(), Some("Esc"));
+}
+
+#[test]
+fn scripted_harness_visual_line_yanks_focused_left_pane_row_to_clipboard() {
+    let mut harness = UiHarness::new(80, 24);
+
+    assert_eq!(harness.ui().focus(), PaneFocus::Left);
+
+    harness.handle_byte(b'V');
+    assert!(
+        harness
+            .render_frame()
+            .contains("mode=visual-line focus=left")
+    );
+
+    harness.handle_byte(b'Y');
+
+    assert_eq!(harness.ui().copied_text(), Some(">user-1 READY"));
+}
+
+#[test]
+fn scripted_harness_visual_block_yanks_right_pane_rectangle_to_clipboard() {
+    let mut harness = UiHarness::new(80, 24);
+
+    harness.handle_bytes(&[23, b'l']);
+    harness.handle_byte(22);
+
+    assert!(harness.ui().visual_selection_active());
+    assert!(
+        harness
+            .render_frame()
+            .contains("mode=visual-block focus=right")
+    );
+
+    harness.handle_byte(b'j');
+    harness.handle_bytes(b"ll");
+    harness.handle_byte(b'y');
+
+    assert_eq!(harness.ui().copied_text(), Some("Esc\ncha"));
+}
+
