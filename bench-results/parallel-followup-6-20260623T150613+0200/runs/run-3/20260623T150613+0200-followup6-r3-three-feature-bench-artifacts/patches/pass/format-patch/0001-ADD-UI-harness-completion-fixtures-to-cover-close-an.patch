+    pub fn ask_feature_done(&mut self, agent_id: &str, title: &str) -> Result<(), String> {
+        let agent_id = AgentId::new(agent_id).map_err(|error| error.to_string())?;
+        self.ui
+            .set_agent_feature(&agent_id, format!("{title} DONE?"))?;
+        self.ui.set_agent_patch_lifecycle(&agent_id, true, false)?;
+        self.ui.set_agent_ready_state(&agent_id, true)?;
+        self.ui.activate_agent_chat(&agent_id)?;
+        self.completion_questions
+            .insert(agent_id, title.to_string());
+        self.transcript
+            .push("work-leaf: is this feature done? [yes/no]".to_string());
+        Ok(())
+    }
