+#[test]
+fn scripted_harness_completion_question_highlights_closes_and_reopens() {
+    let mut harness = UiHarness::new(100, 24);
+
+    harness
+        .ask_feature_done("user-2", "tests")
+        .expect("fixture user-2 agent is registered");
+
+    let done_frame = harness.render_frame();
+    assert!(done_frame.starts_with('\u{7}'));
+    assert!(done_frame.contains("work-leaf: is this feature done? [yes/no]"));
+    assert!(
+        harness
+            .ui()
+            .render_left_pane()
+            .contains("\u{1b}[7m>tests DONE? user-2  working: tests DONE?  READY\u{1b}[0m")
+    );
+
+    assert!(harness.handle_bytes(b"yes\n"));
+
+    let closed_left_pane = strip_ansi(&harness.ui().render_left_pane());
+    assert!(closed_left_pane.contains("[closed]\n>tests CLOSED user-2  working: tests CLOSED"));
+    assert!(!closed_left_pane.contains("tests CLOSED  READY"));
+    assert!(
+        harness
+            .transcript()
+            .iter()
+            .any(|line| line == "work-leaf: feature marked closed")
+    );
+
+    assert!(harness.handle_bytes(b"add another tweak\n"));
+
+    let reopened_left_pane = strip_ansi(&harness.ui().render_left_pane());
+    assert!(!reopened_left_pane.contains("tests CLOSED"));
+    assert!(reopened_left_pane.contains("tests user-2  working: tests"));
+    assert!(
+        harness
+            .transcript()
+            .iter()
+            .any(|line| line == "user-2> add another tweak")
+    );
+}
