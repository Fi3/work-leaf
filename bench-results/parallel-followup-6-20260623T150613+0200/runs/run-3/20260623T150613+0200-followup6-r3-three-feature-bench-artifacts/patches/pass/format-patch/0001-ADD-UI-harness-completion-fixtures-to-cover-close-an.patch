+    fn handle_completion_chat_message(&mut self, agent_id: &AgentId, message: &str) -> bool {
+        let Some(title) = self.completion_questions.get(agent_id).cloned() else {
+            return false;
+        };
+        if message.eq_ignore_ascii_case("yes") {
+            self.completion_questions.remove(agent_id);
+            self.closed_agent_titles
+                .insert(agent_id.clone(), title.clone());
+            let _ = self
+                .ui
+                .set_agent_feature(agent_id, format!("{title} CLOSED"));
+            let _ = self.ui.set_agent_patch_lifecycle(agent_id, true, true);
+            let _ = self.ui.set_agent_ready_state(agent_id, false);
+            self.transcript
+                .push("work-leaf: feature marked closed".to_string());
+            return true;
+        }
+        if message.eq_ignore_ascii_case("no") {
+            self.completion_questions.remove(agent_id);
+            let _ = self.ui.set_agent_feature(agent_id, title);
+            let _ = self.ui.set_agent_patch_lifecycle(agent_id, true, false);
+            let _ = self.ui.set_agent_ready_state(agent_id, false);
+            self.transcript
+                .push("work-leaf: feature remains open".to_string());
+            return true;
+        }
+        self.transcript
+            .push("work-leaf: answer yes or no to close this feature".to_string());
+        true
+    }
+
+    fn reopen_closed_agent_if_needed(&mut self, agent_id: &AgentId) {
+        let Some(title) = self.closed_agent_titles.remove(agent_id) else {
+            return;
+        };
+        let _ = self.ui.set_agent_feature(agent_id, title);
+        let _ = self.ui.set_agent_patch_lifecycle(agent_id, true, false);
+    }
