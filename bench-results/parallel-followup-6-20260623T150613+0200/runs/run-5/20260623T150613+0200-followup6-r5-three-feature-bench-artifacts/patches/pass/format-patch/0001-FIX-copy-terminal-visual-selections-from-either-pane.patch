+#[test]
+fn scripted_harness_visual_mode_yanks_character_selections_in_both_panes() {
+    let mut right_harness = UiHarness::new(80, 24);
+    right_harness.handle_bytes(&[23, b'l']);
+    right_harness.handle_byte(b'v');
+    right_harness.handle_byte(b'l');
+    right_harness.handle_byte(b'y');
+
+    assert_eq!(right_harness.ui().copied_text(), Some("Es"));
+
+    let mut left_harness = UiHarness::new(80, 24);
+    left_harness.handle_byte(b'k');
+    left_harness.handle_byte(b'v');
+    left_harness.handle_byte(b'l');
+    left_harness.handle_byte(b'y');
+
+    assert_eq!(left_harness.ui().copied_text(), Some("[c"));
+}
+
+#[test]
+fn scripted_harness_visual_cursor_uppercase_y_yanks_selected_line_range() {
+    let mut harness = UiHarness::new(80, 24);
+    let expected = "UI harness\nEsc command, i insert, : prompt, Ctrl-W h/j/k/l focus, , focus/toggle left, q quit";
+
+    harness.handle_bytes(&[23, b'l']);
+    harness.handle_byte(b'v');
+    harness.handle_byte(b'k');
+    harness.handle_byte(b'Y');
+
+    assert_eq!(harness.ui().copied_text(), Some(expected));
+}
+
+#[test]
+fn scripted_harness_visual_mode_yanks_left_pane_block_selection_to_clipboard() {
+    let mut harness = UiHarness::new(80, 24);
+
+    harness.handle_byte(b'k');
+    harness.handle_byte(22);
+
+    assert!(
+        harness
+            .render_frame()
+            .contains("mode=visual-block focus=left")
+    );
+
+    harness.handle_byte(b'l');
+    harness.handle_byte(b'j');
+    harness.handle_byte(b'y');
+
+    assert_eq!(harness.ui().copied_text(), Some("[c\n> "));
+}
