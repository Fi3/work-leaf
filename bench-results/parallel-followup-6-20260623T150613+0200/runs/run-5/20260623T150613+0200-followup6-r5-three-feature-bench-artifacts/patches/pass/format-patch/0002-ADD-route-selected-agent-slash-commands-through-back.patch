 pub trait AgentBackend {
     fn launch(&mut self, request: AgentLaunch) -> Result<AgentSession, AgentError>;
     fn send(&mut self, agent_id: &AgentId, prompt: &str) -> Result<ChatMessage, AgentError>;
+    fn command(&mut self, _agent_id: &AgentId, command: &str) -> Result<ChatMessage, AgentError> {
+        let command = command.trim();
+        let command = command
+            .split_once(char::is_whitespace)
+            .map_or(command, |(command, _)| command);
+        let command = if command.is_empty() {
+            "backend command"
+        } else {
+            command
+        };
+        Ok(ChatMessage::new(
+            MessageRole::Agent,
+            format!("{command} is not supported by this backend; no model request was sent."),
+        ))
+    }
 
