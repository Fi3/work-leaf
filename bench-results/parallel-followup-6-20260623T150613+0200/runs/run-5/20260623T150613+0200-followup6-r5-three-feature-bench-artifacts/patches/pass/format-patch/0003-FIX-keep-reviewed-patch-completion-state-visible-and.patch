     assert!(!harness.render_frame().starts_with('\u{7}'));
 }
 
+#[test]
+fn scripted_harness_review_done_highlights_chat_until_yes_closes_and_later_text_reopens() {
+    let mut harness = UiHarness::new(120, 24);
+
+    harness.handle_bytes(b":new completion flow\n");
+    assert_eq!(
+        harness.ui().selected_agent().map(|id| id.as_str()),
+        Some("user-3")
+    );
+
+    harness.handle_bytes(b"\x1b:review\n");
+
+    let done_frame = harness.render_frame();
+    assert!(done_frame.starts_with('\u{7}'));
+    assert!(done_frame.contains("work-leaf: is this feature done? [yes/no]"));
+    let done_left_pane = strip_ansi(&harness.ui().render_left_pane());
+    let ready_section = done_left_pane
+        .find("[ready]")
+        .expect("ready section renders");
+    let working_section = done_left_pane
+        .find("[working]")
+        .expect("working section renders");
+    let done_row = done_left_pane
+        .find(">completion-flow DONE? user-3  working: completion-flow DONE?  READY")
+        .expect("reviewed patch row renders with completion prompt");
+    assert!(
+        ready_section < done_row && done_row < working_section,
+        "{done_left_pane}"
+    );
+
+    harness.handle_bytes(b"yes\n");
+
+    let closed_left_pane = strip_ansi(&harness.ui().render_left_pane());
+    assert!(
+        closed_left_pane
+            .contains("[closed]\n>completion-flow CLOSED user-3  working: completion-flow CLOSED"),
+        "{closed_left_pane}"
+    );
+    assert!(
+        !closed_left_pane
+            .contains("completion-flow CLOSED user-3  working: completion-flow CLOSED  READY"),
+        "{closed_left_pane}"
+    );
+    assert!(
+        harness
+            .transcript()
+            .iter()
+            .any(|line| line == "work-leaf: feature marked closed")
+    );
+
+    harness.handle_bytes(b"follow up\n");
+
+    let reopened_left_pane = strip_ansi(&harness.ui().render_left_pane());
+    let working_section = reopened_left_pane
+        .find("[working]")
+        .expect("working section renders");
+    let reopened_row = reopened_left_pane
+        .find(">completion-flow user-3  working: completion-flow")
+        .expect("reopened patch row renders without completion suffix");
+    assert!(working_section < reopened_row, "{reopened_left_pane}");
+    assert!(!reopened_left_pane.contains("completion-flow CLOSED"));
+    assert!(
+        harness
+            .transcript()
+            .iter()
+            .any(|line| line == "user-3> follow up")
+    );
+}
