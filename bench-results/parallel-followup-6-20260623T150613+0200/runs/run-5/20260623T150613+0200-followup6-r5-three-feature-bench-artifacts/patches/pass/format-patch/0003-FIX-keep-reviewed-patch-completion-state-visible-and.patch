+    #[test]
+    fn feature_done_yes_closes_and_later_message_reopens_session() {
+        let backend = ScriptedBackend::new(["reopened reply", "reviewed feature"]);
+        let chat = CommandChat::new(PathBuf::from("/repo"), backend.clone());
+        let mut controller = WorkLeafController::new(chat);
+        let agent_id = AgentId::new("user-1").expect("test agent id is valid");
+
+        controller.register_agent_feature(agent_id.clone(), "reviewed feature".to_string());
+        controller.add_session(WorkLeafSession {
+            id: agent_id.clone(),
+            kind: AgentKind::Codex,
+            title: "reviewed feature".to_string(),
+            feature: "reviewed feature".to_string(),
+            lines: Vec::new(),
+            loading: None,
+            completion: None,
+            token_usage: None,
+            depends_on: Vec::new(),
+            depended_on_by: Vec::new(),
+        });
+
+        controller.ask_feature_done(&agent_id);
+        controller
+            .send_message(&agent_id, "yes")
+            .expect("completion answer is accepted");
+
+        assert!(
+            backend.sends().is_empty(),
+            "yes closes the feature without sending a backend turn"
+        );
+        let closed_snapshot = controller.snapshot();
+        let closed = closed_snapshot
+            .session(&agent_id)
+            .expect("patch agent session exists");
+        assert_eq!(closed.completion, Some(WorkLeafCompletion::Closed));
+        assert!(closed.lines.iter().any(|line| line == "user: yes"));
+        assert!(
+            closed
+                .lines
+                .iter()
+                .any(|line| line == FEATURE_CLOSED_MESSAGE)
+        );
+
+        controller
+            .send_message(&agent_id, "continue work")
+            .expect("message after close is accepted");
+        assert!(controller.wait_for_idle(Duration::from_secs(1)));
+
+        assert_eq!(
+            backend.sends(),
+            vec![(agent_id.clone(), "continue work".to_string())]
+        );
+        let reopened_snapshot = controller.snapshot();
+        let reopened = reopened_snapshot
+            .session(&agent_id)
+            .expect("patch agent session exists");
+        assert_eq!(reopened.completion, None);
+        assert!(
+            reopened
+                .lines
+                .iter()
+                .any(|line| line == "user: continue work")
+        );
+    }
+
