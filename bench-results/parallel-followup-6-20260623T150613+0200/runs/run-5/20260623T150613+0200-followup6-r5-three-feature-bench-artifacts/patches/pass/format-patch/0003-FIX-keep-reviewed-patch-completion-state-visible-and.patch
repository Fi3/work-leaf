@@ -2275,10 +2282,23 @@ fn compact_fixed_last(
     let flexible_width = width.saturating_sub(fixed_width);
     format!(
         "{prefix}{} {fixed}{status}",
-        truncate_to_width(flexible, flexible_width)
+        truncate_completion_label_to_width(flexible, flexible_width)
     )
 }
 
+fn truncate_completion_label_to_width(text: &str, width: usize) -> String {
+    for suffix in [" DONE?", " CLOSED"] {
+        if let Some(base) = text.strip_suffix(suffix) {
+            let suffix_width = suffix.chars().count();
+            if suffix_width < width {
+                let base_width = width.saturating_sub(suffix_width);
+                return format!("{}{}", truncate_to_width(base, base_width), suffix);
+            }
+        }
+    }
+    truncate_to_width(text, width)
+}
+
