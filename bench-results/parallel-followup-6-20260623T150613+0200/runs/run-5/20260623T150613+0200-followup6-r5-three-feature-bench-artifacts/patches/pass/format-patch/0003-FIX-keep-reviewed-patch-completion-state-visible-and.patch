+    fn finish_selected_review(&mut self) {
+        self.transcript.push("fixture review: no findings".into());
+        let Some(agent_id) = self.ui.selected_agent().cloned() else {
+            return;
+        };
+        self.mark_agent_needs_completion(&agent_id);
+        let _ = self.ui.activate_agent_chat(&agent_id);
+        self.transcript
+            .push("work-leaf: is this feature done? [yes/no]".into());
+    }
+
+    fn handle_completion_answer(&mut self, agent_id: &AgentId, message: &str) -> bool {
+        let Some(base_title) = self.agent_title_before_suffix(agent_id, " DONE?") else {
+            return false;
+        };
+        self.transcript.push(format!("{agent_id}> {message}"));
+        if message.trim().eq_ignore_ascii_case("yes") {
+            self.set_agent_completion_feature(agent_id, &base_title, " CLOSED", true, false);
+            self.transcript
+                .push("work-leaf: feature marked closed".to_string());
+        } else if message.trim().eq_ignore_ascii_case("no") {
+            self.set_agent_completion_feature(agent_id, &base_title, "", false, false);
+            self.transcript
+                .push("work-leaf: feature remains open".to_string());
+        } else {
+            self.transcript
+                .push("work-leaf: answer yes or no to close this feature".to_string());
+        }
+        true
+    }
+
+    fn mark_agent_needs_completion(&mut self, agent_id: &AgentId) {
+        let Some(base_title) = self.agent_base_title(agent_id) else {
+            return;
+        };
+        self.set_agent_completion_feature(agent_id, &base_title, " DONE?", false, true);
+    }
+
+    fn reopen_closed_agent(&mut self, agent_id: &AgentId) {
+        if let Some(base_title) = self.agent_title_before_suffix(agent_id, " CLOSED") {
+            self.set_agent_completion_feature(agent_id, &base_title, "", false, false);
+        }
+    }
+
+    fn set_agent_completion_feature(
+        &mut self,
+        agent_id: &AgentId,
+        base_title: &str,
+        suffix: &str,
+        closed: bool,
+        ready: bool,
+    ) {
+        let _ = self
+            .ui
+            .set_agent_feature(agent_id, format!("{base_title}{suffix}"));
+        let _ = self.ui.set_agent_patch_lifecycle(agent_id, true, closed);
+        let _ = self.ui.set_agent_ready_state(agent_id, ready);
+    }
+
+    fn agent_base_title(&self, agent_id: &AgentId) -> Option<String> {
+        self.ui
+            .agent_feature(agent_id)
+            .map(strip_completion_suffix)
+            .map(str::to_string)
+    }
+
+    fn agent_title_before_suffix(&self, agent_id: &AgentId, suffix: &str) -> Option<String> {
+        self.ui
+            .agent_feature(agent_id)?
+            .strip_suffix(suffix)
+            .map(str::to_string)
+    }
+
     fn name_chat_from_first_prompt(&mut self, agent_id: &AgentId, prompt: &str) {
