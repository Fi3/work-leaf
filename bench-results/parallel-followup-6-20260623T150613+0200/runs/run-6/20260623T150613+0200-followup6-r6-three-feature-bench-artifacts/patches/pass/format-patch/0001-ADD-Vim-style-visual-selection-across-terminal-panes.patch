diff --git a/tests/ui_harness.rs b/tests/ui_harness.rs
index 3502bcf..46af90a 100644
--- a/tests/ui_harness.rs
+++ b/tests/ui_harness.rs
@@ -348,6 +348,102 @@ fn scripted_harness_visual_mode_yanks_right_pane_line_to_clipboard() {
     assert!(frame.contains("copied "));
 }
 
+#[test]
+fn scripted_harness_v_starts_character_selection_in_left_pane() {
+    let mut harness = UiHarness::new(80, 24);
+
+    assert_eq!(harness.ui().focus(), PaneFocus::Left);
+
+    harness.handle_byte(b'v');
+
+    assert!(harness.ui().visual_selection_active());
+    let frame = harness.render_frame();
+    assert!(frame.contains("mode=visual-char focus=left"));
+    assert!(frame.ends_with("\u{1b}[5;2H"));
+
+    harness.handle_bytes(b"lllllly");
+
+    assert_eq!(harness.ui().copied_text(), Some(">user-1"));
+}
+
+#[test]
+fn scripted_harness_shift_v_yanks_line_selection_from_left_pane() {
+    let mut harness = UiHarness::new(80, 24);
+
+    assert_eq!(harness.ui().focus(), PaneFocus::Left);
+
+    harness.handle_byte(b'V');
+
+    assert!(harness.ui().visual_selection_active());
+    assert!(
+        harness
+            .render_frame()
+            .contains("mode=visual-line focus=left")
+    );
+
+    harness.handle_byte(b'y');
+
+    assert_eq!(harness.ui().copied_text(), Some(">user-1 READY"));
+}
+
+#[test]
+fn scripted_harness_ctrl_v_yanks_block_selection_from_left_pane() {
+    let mut harness = UiHarness::new(80, 24);
+
+    assert_eq!(harness.ui().focus(), PaneFocus::Left);
+
+    harness.handle_byte(22);
+
+    assert!(harness.ui().visual_selection_active());
+    assert!(
+        harness
+            .render_frame()
+            .contains("mode=visual-block focus=left")
+    );
+
+    harness.handle_bytes(b"kllly");
+
+    assert_eq!(harness.ui().copied_text(), Some("[rea\n>use"));
+}
+
+#[test]
+fn scripted_harness_v_starts_character_selection_in_right_pane() {
+    let mut harness = UiHarness::new(80, 24);
+
+    harness.handle_bytes(&[23, b'l']);
+    harness.handle_byte(b'v');
+
+    assert!(harness.ui().visual_selection_active());
+    assert!(
+        harness
+            .render_frame()
+            .contains("mode=visual-char focus=right")
+    );
+
+    harness.handle_bytes(b"lly");
+
+    assert_eq!(harness.ui().copied_text(), Some("Esc"));
+}
+
+#[test]
+fn scripted_harness_ctrl_v_yanks_block_selection_from_right_pane() {
+    let mut harness = UiHarness::new(80, 24);
+
+    harness.handle_bytes(&[23, b'l']);
+    harness.handle_byte(22);
+
+    assert!(harness.ui().visual_selection_active());
+    assert!(
+        harness
+            .render_frame()
+            .contains("mode=visual-block focus=right")
+    );
+
+    harness.handle_bytes(b"klly");
+
+    assert_eq!(harness.ui().copied_text(), Some("UI \nEsc"));
+}
+
