+
+    fn execute_command_streaming(
+        &mut self,
+        agent_id: &AgentId,
+        command: &str,
+        _sink: &mut dyn FnMut(AgentStreamEvent),
+    ) -> Result<ChatMessage, AgentError> {
+        let _operation_guard = self.acquire_agent_operation(agent_id);
+        let (thread_id, sandbox) = {
+            let state = self
+                .state
+                .lock()
+                .expect("codex backend state mutex poisoned");
+            (
+                state
+                    .thread_ids
+                    .get(agent_id)
+                    .cloned()
+                    .ok_or_else(|| AgentError::UnknownSession(agent_id.clone()))?,
+                self.sandbox_for_agent(agent_id),
+            )
+        };
+        let output =
+            self.app_server
+                .command(agent_id, command, &thread_id, &sandbox, &self.shutdown)?;
+        if !output.thread_id.is_empty() {
+            self.state
+                .lock()
+                .expect("codex backend state mutex poisoned")
+                .thread_ids
+                .insert(agent_id.clone(), output.thread_id.clone());
+        }
+        self.record_send_reply(agent_id, command, output.reply)
+    }
 }
 
