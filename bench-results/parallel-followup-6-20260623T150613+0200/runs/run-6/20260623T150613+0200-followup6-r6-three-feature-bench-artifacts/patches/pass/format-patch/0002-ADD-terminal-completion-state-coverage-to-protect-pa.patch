+    #[test]
+    fn typing_in_closed_completion_chat_reopens_row_and_sends_message() {
+        let agent_id = AgentId::new("user-1").expect("test agent id is valid");
+        let controller = ReopeningController::new(agent_id.clone());
+        let mut app = TerminalAppCore::new(controller, 120, 24);
+        app.ui
+            .activate_agent_chat(&agent_id)
+            .expect("closed fixture agent is registered");
+
+        let closed_left_pane = app.ui.render_left_pane();
+        assert!(closed_left_pane.contains("[closed]"));
+        assert!(closed_left_pane.contains("feature CLOSED user-1  working: feature CLOSED"));
+
+        app.handle_bytes(b"add follow-up\n");
+
+        assert_eq!(
+            app.controller.sent_messages,
+            vec![(agent_id, "add follow-up".to_string())]
+        );
+        let reopened_left_pane = app.ui.render_left_pane();
+        assert!(!reopened_left_pane.contains("feature CLOSED"));
+        assert!(!reopened_left_pane.contains("[closed]"));
+        assert!(reopened_left_pane.contains("[working]"));
+        assert!(reopened_left_pane.contains("feature user-1  working: feature"));
+        assert!(!reopened_left_pane.contains("READY"));
+    }
+
