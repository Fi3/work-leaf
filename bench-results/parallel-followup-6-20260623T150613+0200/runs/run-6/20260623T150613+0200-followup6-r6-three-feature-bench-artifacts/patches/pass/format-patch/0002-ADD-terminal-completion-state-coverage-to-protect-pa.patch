diff --git a/tests/ui_harness.rs b/tests/ui_harness.rs
index 46af90a..dc6640c 100644
--- a/tests/ui_harness.rs
+++ b/tests/ui_harness.rs
@@ -86,6 +86,32 @@ fn scripted_harness_rings_and_highlights_ready_chat() {
     assert!(!harness.render_frame().starts_with('\u{7}'));
 }
 
+#[test]
+fn scripted_harness_highlights_completion_question_and_shows_closed_chat() {
+    let mut harness = UiHarness::new(120, 24);
+
+    harness
+        .mark_agent_needs_completion_decision("user-2", "tests")
+        .expect("fixture user-2 agent is registered");
+
+    let decision_left_pane = harness.ui().render_left_pane();
+    assert!(decision_left_pane.contains("[ready]"));
+    assert!(
+        decision_left_pane
+            .contains("\u{1b}[7m tests DONE? user-2  working: tests DONE?  READY\u{1b}[0m")
+    );
+
+    harness
+        .mark_agent_closed("user-2", "tests")
+        .expect("fixture user-2 agent is registered");
+
+    let closed_left_pane = harness.ui().render_left_pane();
+    assert!(closed_left_pane.contains("[closed]"));
+    assert!(closed_left_pane.contains(" tests CLOSED user-2  working: tests CLOSED"));
+    assert!(!closed_left_pane.contains("tests CLOSED  READY"));
+    assert!(!closed_left_pane.contains("\u{1b}[7m tests CLOSED"));
+}
