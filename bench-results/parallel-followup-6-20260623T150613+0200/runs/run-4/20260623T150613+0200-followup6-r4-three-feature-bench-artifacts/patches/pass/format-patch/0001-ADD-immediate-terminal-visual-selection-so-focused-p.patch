diff --git a/tests/ui_harness.rs b/tests/ui_harness.rs
index 3502bcf..f37f0ae 100644
--- a/tests/ui_harness.rs
+++ b/tests/ui_harness.rs
@@ -348,6 +348,61 @@ fn scripted_harness_visual_mode_yanks_right_pane_line_to_clipboard() {
     assert!(frame.contains("copied "));
 }
 
+#[test]
+fn scripted_harness_v_starts_right_pane_character_selection_to_clipboard() {
+    let mut harness = UiHarness::new(80, 24);
+
+    harness.handle_bytes(&[23, b'l']);
+    harness.handle_byte(b'v');
+
+    assert!(harness.ui().visual_selection_active());
+    assert!(
+        harness
+            .render_frame()
+            .contains("mode=visual-char focus=right")
+    );
+
+    harness.handle_bytes(b"lly");
+
+    assert_eq!(harness.ui().copied_text(), Some("Esc"));
+}
+
+#[test]
+fn scripted_harness_visual_mode_yanks_left_pane_lines_to_clipboard() {
+    let mut harness = UiHarness::new(80, 24);
+
+    assert_eq!(harness.ui().focus(), PaneFocus::Left);
+
+    harness.handle_byte(b'V');
+
+    assert!(harness.ui().visual_selection_active());
+    assert!(
+        harness
+            .render_frame()
+            .contains("mode=visual-line focus=left")
+    );
+
+    harness.handle_byte(b'j');
+    harness.handle_byte(b'Y');
+
+    assert_eq!(
+        harness.ui().copied_text(),
+        Some(">user-1 READY\n    files: src/parser.rs")
+    );
+}
+
+#[test]
+fn scripted_harness_ctrl_v_yanks_left_pane_block_to_clipboard() {
+    let mut harness = UiHarness::new(80, 24);
+
+    assert_eq!(harness.ui().focus(), PaneFocus::Left);
+
+    harness.handle_byte(22);
+    harness.handle_bytes(b"jly");
+
+    assert_eq!(harness.ui().copied_text(), Some(">u\n  "));
+}
+
