From cfdb7cf6b5acfc9d33877dbc3dec4e864e75d642 Mon Sep 17 00:00:00 2001
From: fi3 <you@example.com>
Date: Tue, 23 Jun 2026 15:29:54 +0200
Subject: [PATCH 1/2] ADD immediate terminal visual selection so focused panes
 can yank text

Start visual selection directly from command-mode v, V, and Ctrl-V, using the focused pane's visible row as the anchor so yank commands copy the text users selected.
---
 src/ui.rs            | 30 ++++++++++++++++++--
 tests/terminal_ui.rs | 19 +++++++------
 tests/ui_harness.rs  | 65 ++++++++++++++++++++++++++++++++++++++++----
 3 files changed, 98 insertions(+), 16 deletions(-)

diff --git a/src/ui.rs b/src/ui.rs
index 620b15c..76afe99 100644
--- a/src/ui.rs
+++ b/src/ui.rs
@@ -669,6 +669,11 @@ impl TerminalUi {
             }
             UiKey::Char('v') if self.mode == UiMode::Command => {
                 self.start_visual_cursor(visible_right_content, right_cursor_column);
+                self.start_visual_selection(
+                    VisualSelectionMode::Character,
+                    visible_right_content,
+                    right_cursor_column,
+                );
                 Vec::new()
             }
             UiKey::Char('V') if self.mode == UiMode::Command => {
@@ -1189,8 +1194,11 @@ impl TerminalUi {
     ) -> VisualPoint {
         match self.focus {
             PaneFocus::Left => {
-                let lines = self.visual_pane_lines(visible_right_content, PaneFocus::Left);
-                let row = self.control_selected.min(lines.len().saturating_sub(1));
+                let inner_width = usize::from(self.layout().left_width.saturating_sub(2).max(1));
+                let lines = self.left_pane_lines(inner_width);
+                let row = self
+                    .left_visual_start_row(&lines)
+                    .min(lines.len().saturating_sub(1));
                 VisualPoint { row, column: 0 }
             }
             PaneFocus::Right => {
@@ -1213,6 +1221,22 @@ impl TerminalUi {
         }
     }
 
+    fn left_visual_start_row(&self, lines: &[LeftPaneLine]) -> usize {
+        let target = if self.control_selected == 0 {
+            Some(LeftPaneClickTarget::Command)
+        } else {
+            self.control_selected_agent_id()
+                .map(LeftPaneClickTarget::Agent)
+        };
+        let Some(target) = target else {
+            return 0;
+        };
+        lines
+            .iter()
+            .position(|line| line.control_target.as_ref() == Some(&target))
+            .unwrap_or(0)
+    }
+
     fn right_visual_start_row(&self, lines: &[String]) -> usize {
         if lines.is_empty() {
             return 0;
@@ -1602,7 +1626,7 @@ impl TerminalUi {
     }
 
     fn command_mode_text_key_control_status(&self, key: UiKey) -> Option<bool> {
-        if self.mode != UiMode::Command || self.pending.is_some() {
+        if self.mode != UiMode::Command || self.pending.is_some() || self.visual_mode_active() {
             return None;
         }
         let UiKey::Char(ch) = key else {
