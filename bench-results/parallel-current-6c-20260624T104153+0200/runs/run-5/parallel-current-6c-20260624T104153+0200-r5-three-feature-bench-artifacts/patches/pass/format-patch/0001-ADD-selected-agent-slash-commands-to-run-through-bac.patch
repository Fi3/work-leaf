+pub(crate) fn agent_backend_command_line(message: &str) -> Option<&str> {
+    let trimmed = message.trim();
+    let rest = trimmed.strip_prefix('/')?;
+    match rest.chars().next() {
+        Some(ch) if !ch.is_whitespace() => Some(trimmed),
+        _ => None,
+    }
+}
