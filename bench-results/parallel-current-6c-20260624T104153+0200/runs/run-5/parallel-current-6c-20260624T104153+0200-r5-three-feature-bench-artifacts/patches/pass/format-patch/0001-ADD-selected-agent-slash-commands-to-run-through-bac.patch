+    #[test]
+    fn selected_agent_slash_commands_execute_backend_command_without_normal_send() {
+        let backend = RecordingBackend::default();
+        let state = Arc::clone(&backend.state);
+        let chat = CommandChat::new(PathBuf::from("."), backend);
+        let mut app = TerminalApp::new(chat, 100, 24);
+
+        app.handle_bytes(b":new\n");
+        assert!(app.wait_for_idle(Duration::from_secs(1)));
+        let agent_id = AgentId::new("user-1").expect("test agent id is valid");
+        assert_eq!(app.ui().selected_agent(), Some(&agent_id));
+
+        app.handle_bytes(b"/status\n");
+        assert!(app.wait_for_idle(Duration::from_secs(1)));
+        app.handle_bytes(b"/fork\n");
+        assert!(app.wait_for_idle(Duration::from_secs(1)));
+
+        let state = state
+            .lock()
+            .expect("recording backend state mutex poisoned");
+        assert_eq!(
+            state.commands,
+            vec![
+                (agent_id.clone(), "/status".to_string()),
+                (agent_id.clone(), "/fork".to_string()),
+            ]
+        );
+        assert!(
+            !state.sends.iter().any(|(_, prompt)| prompt == "/status"),
+            "/status must not be delivered through the normal prompt send path"
+        );
+        assert!(
+            !state.sends.iter().any(|(_, prompt)| prompt == "/fork"),
+            "/fork must not be delivered through the normal prompt send path"
+        );
+        drop(state);
+
+        let frame = app.render_frame();
+        assert!(frame.contains("user: /status"));
+        assert!(frame.contains("command output for /status"));
+        assert!(frame.contains("user: /fork"));
+        assert!(frame.contains("command output for /fork"));
+    }
 }
