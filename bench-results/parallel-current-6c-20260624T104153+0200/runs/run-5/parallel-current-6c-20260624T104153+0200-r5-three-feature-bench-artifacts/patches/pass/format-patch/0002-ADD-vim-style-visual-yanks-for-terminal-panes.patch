+}
+
+fn wrapped_row_offsets(lines: &[String], width: u16) -> Vec<usize> {
+    let mut offsets = Vec::with_capacity(lines.len());
+    let mut next_offset = 0_usize;
+    for line in lines {
+        offsets.push(next_offset);
+        next_offset = next_offset.saturating_add(visual_row_count(line, width));
+    }
