+    fn left_visual_start_row(&self) -> usize {
+        if self.control_selected == 0 {
+            return 0;
+        }
+
+        let target = self.control_selected - 1;
+        let mut row = 1;
+        for (visible_position, agent_index) in self.visible_agent_indices().iter().enumerate() {
+            if visible_position == target {
+                return row;
+            }
+            row += 1;
+
+            let agent = &self.agents[*agent_index];
+            if !agent.modified_files.is_empty() {
+                row += 1;
+            }
+            for linked_agents in [
+                &agent.conflicting_agents,
+                &agent.depends_on,
+                &agent.depended_on_by,
+            ] {
+                if !linked_agents.is_empty() {
+                    row += 1;
+                }
+            }
+        }
+        0
+    }
+
+    fn left_pane_display_lines(&self) -> Vec<String> {
+        let inner_width = usize::from(self.layout().left_width.saturating_sub(2).max(1));
+        let mut lines = vec![if self.control_selected == 0 {
+            "> work-leaf  command".to_string()
+        } else {
+            "  work-leaf  command".to_string()
+        }];
+        for (visible_position, agent_index) in self.visible_agent_indices().iter().enumerate() {
+            let agent = &self.agents[*agent_index];
+            lines.push(compact_agent_row(
+                agent,
+                self.control_selected == visible_position + 1,
+                inner_width,
+            ));
+            if !agent.modified_files.is_empty() {
+                lines.push(format!(
+                    "    files: {}",
+                    agent
+                        .modified_files
+                        .iter()
+                        .map(|path| path.display().to_string())
+                        .collect::<Vec<_>>()
+                        .join(", ")
+                ));
+            }
+            for (label, agents) in [
+                ("conflicts", &agent.conflicting_agents),
+                ("depends-on", &agent.depends_on),
+                ("depended-on-by", &agent.depended_on_by),
+            ] {
+                if !agents.is_empty() {
+                    lines.push(format!(
+                        "    {label}: {}",
+                        agents
+                            .iter()
+                            .map(AgentId::as_str)
+                            .collect::<Vec<_>>()
+                            .join(", ")
+                    ));
+                }
+            }
+        }
+        lines
+    }
+
+    fn remember_right_content(&self, right_content: &str, right_cursor_column: Option<usize>) {
+        let lines = text_lines(right_content);
+        let line_count = lines.len().max(1);
+        let line_len = lines.last().map(|line| line.chars().count()).unwrap_or(0);
+        self.last_right_line_count.set(line_count);
+        self.last_right_cursor_row.set(line_count.saturating_sub(1));
+        self.last_right_cursor_column
+            .set(right_cursor_column.unwrap_or(line_len).min(line_len));
+    }
+
+    fn apply_visual_selection(&self, buffer: &mut Buffer, right_content: &str) {
+        let Some(selection) = self.visual_selection.as_ref() else {
+            return;
+        };
+        let Some((origin_x, origin_y, width, height)) = self.visual_pane_area(selection.focus)
+        else {
+            return;
+        };
+        let lines = match selection.focus {
+            PaneFocus::Left => self.left_pane_display_lines(),
+            PaneFocus::Right => text_lines(right_content),
+        };
+        if width == 0 || height == 0 {
+            return;
+        }
+
+        let right_row_offsets = if selection.focus == PaneFocus::Right {
+            wrapped_row_offsets(&lines, width)
+        } else {
+            Vec::new()
+        };
+
+        for (row, start, end) in selection_ranges(&lines, selection, selection.kind) {
+            match selection.focus {
+                PaneFocus::Left => {
+                    if row >= usize::from(height) {
+                        continue;
+                    }
+                    let start = start.min(usize::from(width.saturating_sub(1)));
+                    let end = end.max(start + 1).min(usize::from(width));
+                    for column in start..end {
+                        let x = origin_x.saturating_add(column as u16);
+                        let y = origin_y.saturating_add(row as u16);
+                        buffer.get_mut(x, y).modifier.insert(Modifier::REVERSED);
+                    }
+                }
+                PaneFocus::Right => {
+                    let Some(row_offset) = right_row_offsets.get(row).copied() else {
+                        continue;
+                    };
+                    for column in start..end.max(start + 1) {
+                        let screen_row = row_offset.saturating_add(column / usize::from(width));
+                        if screen_row >= usize::from(height) {
+                            break;
+                        }
+                        let screen_column = column % usize::from(width);
+                        let x = origin_x.saturating_add(screen_column as u16);
+                        let y = origin_y.saturating_add(screen_row as u16);
+                        buffer.get_mut(x, y).modifier.insert(Modifier::REVERSED);
+                    }
+                }
+            }
+        }
+    }
+
+    fn visual_cursor_screen_position(&self, right_content: &str) -> Option<(u16, u16)> {
+        let selection = self.visual_selection.as_ref()?;
+        let (origin_x, origin_y, width, height) = self.visual_pane_area(selection.focus)?;
+        if width == 0 || height == 0 {
+            return None;
+        }
+        let lines = match selection.focus {
+            PaneFocus::Left => self.left_pane_display_lines(),
+            PaneFocus::Right => text_lines(right_content),
+        };
+        let max_row = lines.len().max(1).saturating_sub(1);
+        let row = selection.cursor.row.min(max_row);
