+    fn handle_visual_key(&mut self, key: UiKey) -> Vec<UiAction> {
+        match key {
+            UiKey::Esc => self.clear_visual_selection(),
+            UiKey::Char('y') => {
+                if let Some(selection) = self.visual_selection.as_ref() {
+                    self.pending_yank = Some(selection.kind);
+                }
+            }
+            UiKey::Char('Y') => {
+                self.pending_yank = Some(VisualKind::Line);
+            }
+            UiKey::Char('v') => self.set_visual_kind(VisualKind::Character),
+            UiKey::Char('V') => self.set_visual_kind(VisualKind::Line),
+            UiKey::CtrlV => self.set_visual_kind(VisualKind::Block),
+            UiKey::Char('h') | UiKey::Left => self.move_visual_cursor(0, -1),
+            UiKey::Char('j') | UiKey::Down => self.move_visual_cursor(1, 0),
+            UiKey::Char('k') | UiKey::Up => self.move_visual_cursor(-1, 0),
+            UiKey::Char('l') | UiKey::Right => self.move_visual_cursor(0, 1),
+            _ => {}
+        }
+        Vec::new()
+    }
+
+    fn start_visual_selection(&mut self, kind: VisualKind) -> bool {
+        if self.mode != UiMode::Command || self.focus == PaneFocus::Left && !self.left_visible {
+            return false;
+        }
+        let focus = self.focus;
+        let anchor = self.visual_start_position(focus);
+        self.visual_selection = Some(VisualSelection {
+            focus,
+            kind,
+            anchor,
+            cursor: anchor,
+        });
+        true
+    }
+
+    fn set_visual_kind(&mut self, kind: VisualKind) {
+        if let Some(selection) = self.visual_selection.as_mut() {
+            selection.kind = kind;
+        }
+    }
+
+    fn move_visual_cursor(&mut self, row_delta: isize, column_delta: isize) {
+        let Some(focus) = self
+            .visual_selection
+            .as_ref()
+            .map(|selection| selection.focus)
+        else {
+            return;
+        };
+        let max_row = self.visual_line_count(focus).saturating_sub(1);
+        if let Some(selection) = self.visual_selection.as_mut() {
+            selection.cursor.row = apply_delta(selection.cursor.row, row_delta).min(max_row);
+            selection.cursor.column = apply_delta(selection.cursor.column, column_delta);
+        }
+    }
+
+    fn clear_visual_selection(&mut self) {
+        self.visual_selection = None;
+        self.pending_yank = None;
+    }
