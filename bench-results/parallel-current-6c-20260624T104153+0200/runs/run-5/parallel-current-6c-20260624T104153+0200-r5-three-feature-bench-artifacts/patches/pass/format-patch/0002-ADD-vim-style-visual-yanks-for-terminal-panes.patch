+
+fn selection_ranges(
+    lines: &[String],
+    selection: &VisualSelection,
+    kind: VisualKind,
+) -> Vec<(usize, usize, usize)> {
+    if lines.is_empty() {
+        return Vec::new();
+    }
+    let (start, end) = ordered_visual_positions(selection);
+    let start_row = start.row.min(lines.len().saturating_sub(1));
+    let end_row = end.row.min(lines.len().saturating_sub(1));
+    let start_column = selection.anchor.column.min(selection.cursor.column);
+    let end_column = selection.anchor.column.max(selection.cursor.column);
+
+    match kind {
+        VisualKind::Line => (start_row..=end_row)
+            .map(|row| (row, 0, line_char_count(lines, row).max(1)))
+            .collect(),
+        VisualKind::Block => (start_row..=end_row)
+            .map(|row| (row, start_column, end_column.saturating_add(1)))
+            .collect(),
+        VisualKind::Character if start_row == end_row => {
+            vec![(start_row, start.column, end.column.saturating_add(1))]
+        }
+        VisualKind::Character => (start_row..=end_row)
+            .map(|row| {
+                if row == start.row {
+                    (row, start.column, line_char_count(lines, row).max(1))
+                } else if row == end.row {
+                    (row, 0, end.column.saturating_add(1))
+                } else {
+                    (row, 0, line_char_count(lines, row).max(1))
+                }
+            })
+            .collect(),
+    }
+}
+
+fn ordered_visual_positions(selection: &VisualSelection) -> (VisualPosition, VisualPosition) {
+    if selection.anchor.row < selection.cursor.row
+        || selection.anchor.row == selection.cursor.row
+            && selection.anchor.column <= selection.cursor.column
+    {
+        (selection.anchor, selection.cursor)
+    } else {
+        (selection.cursor, selection.anchor)
+    }
+}
