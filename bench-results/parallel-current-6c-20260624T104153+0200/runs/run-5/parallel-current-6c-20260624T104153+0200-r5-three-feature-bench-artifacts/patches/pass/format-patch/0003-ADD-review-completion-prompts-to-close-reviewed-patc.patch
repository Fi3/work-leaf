+    fn close_completed_feature(&mut self, agent_id: &AgentId) {
+        self.feature_completion_prompts.remove(agent_id);
+        self.closed_feature_agents.insert(agent_id.clone());
+        self.set_session_completion(agent_id, Some(WorkLeafFeatureCompletion::Closed));
+        self.append_agent_line_allowing_duplicates(agent_id, FEATURE_MARKED_DONE_LINE.to_string());
+    }
+
+    fn reopen_feature(&mut self, agent_id: &AgentId) {
+        let was_prompted = self.feature_completion_prompts.remove(agent_id);
+        let was_closed = self.closed_feature_agents.remove(agent_id);
+        if was_prompted || was_closed {
+            self.set_session_completion(agent_id, None);
+            self.append_agent_line_allowing_duplicates(agent_id, FEATURE_REOPENED_LINE.to_string());
+        }
+    }
+
+    fn set_session_completion(
+        &mut self,
+        agent_id: &AgentId,
+        completion: Option<WorkLeafFeatureCompletion>,
+    ) {
+        let fallback_kind = self.agent_kind();
+        if !self.sessions.contains_key(agent_id) {
+            let session = WorkLeafSession::unknown(agent_id.clone(), fallback_kind);
+            self.sessions.insert(agent_id.clone(), session.clone());
+            self.pending_events
+                .push(WorkLeafEvent::AgentAdded { session });
+        }
+        if let Some(completion) = completion {
+            self.feature_completions
+                .insert(agent_id.clone(), completion);
+        } else {
+            self.feature_completions.remove(agent_id);
+        }
+        self.pending_feature_completion_events
+            .push((agent_id.clone(), completion));
+    }
