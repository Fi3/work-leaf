+#[test]
+fn controller_closes_reviewed_feature_on_yes_and_reopens_on_next_message() {
+    let root = git_repo("workspace-feature-done-prompt");
+    fs::write(root.join("README.md"), "before\n").unwrap();
+    git(&root, ["add", "README.md"]);
+    git(&root, ["commit", "-m", "ADD initial readme fixture"]);
+    let backend = FakeBackend::new([
+        "implemented patch\n@work-leaf patch update readme\n--- a/README.md\n+++ b/README.md\n@@ -1 +1 @@\n-before\n+after\n@work-leaf end\n@work-leaf done",
+        "summary: README changes from before to after",
+        "NO_FINDINGS",
+        "follow-up reply",
+    ]);
+    let chat = CommandChat::new(root, backend.clone()).with_max_review_rounds(4);
+    let mut controller = WorkLeafController::new(chat);
+
+    let agent_id = controller.create_agent("update readme").unwrap();
+
+    assert!(controller.wait_for_idle(Duration::from_secs(2)));
+    let reviewed = controller.snapshot();
+    let patch_agent = reviewed.session(&agent_id).expect("patch agent exists");
+    assert!(
+        patch_agent
+            .lines
+            .iter()
+            .any(|line| line == "work-leaf: is this feature done? yes/no")
+    );
+
+    let sends_after_review = backend.sends().len();
+    controller.send_message(&agent_id, "yes").unwrap();
+    assert_eq!(
+        backend.sends().len(),
+        sends_after_review,
+        "yes answers the controller prompt instead of going to the backend"
+    );
+    let closed = controller.snapshot();
+    let patch_agent = closed.session(&agent_id).expect("patch agent exists");
+    assert!(
+        patch_agent
+            .lines
+            .iter()
+            .any(|line| line == "work-leaf: feature marked done")
+    );
+
+    controller
+        .send_message(&agent_id, "please make one more adjustment")
+        .unwrap();
+    assert!(controller.wait_for_idle(Duration::from_secs(2)));
+    let reopened = controller.snapshot();
+    let patch_agent = reopened.session(&agent_id).expect("patch agent exists");
+    assert!(
+        patch_agent
+            .lines
+            .iter()
+            .any(|line| line == "work-leaf: feature reopened")
+    );
+    assert!(
+        patch_agent
+            .lines
+            .iter()
+            .any(|line| line == "user: please make one more adjustment")
+    );
+    assert!(
+        patch_agent
+            .lines
+            .iter()
+            .any(|line| line == "follow-up reply")
+    );
+}
