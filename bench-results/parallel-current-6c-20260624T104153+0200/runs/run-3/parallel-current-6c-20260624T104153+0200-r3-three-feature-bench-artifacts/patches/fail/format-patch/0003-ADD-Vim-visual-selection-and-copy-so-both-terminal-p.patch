+fn selected_text_from_lines(
+    lines: &[String],
+    anchor: VisualCursor,
+    cursor: VisualCursor,
+    kind: VisualKind,
+) -> String {
+    match kind {
+        VisualKind::Character => character_selection_text(lines, anchor, cursor),
+        VisualKind::Line => line_selection_text(lines, anchor, cursor),
+        VisualKind::Block => block_selection_text(lines, anchor, cursor),
+    }
+}
+
+fn character_selection_text(
+    lines: &[String],
+    anchor: VisualCursor,
+    cursor: VisualCursor,
+) -> String {
+    let Some((start, end)) = ordered_cursors(lines, anchor, cursor) else {
+        return String::new();
+    };
+    (start.row..=end.row)
+        .map(|row| {
+            let line = &lines[row];
+            let line_len = line.chars().count();
+            let start_column = if row == start.row {
+                start.column.min(line_len)
+            } else {
+                0
+            };
+            let end_column = if row == end.row {
+                end.column.saturating_add(1).min(line_len)
+            } else {
+                line_len
+            };
+            slice_chars(line, start_column, end_column)
+        })
+        .collect::<Vec<_>>()
+        .join("\n")
+}
+
+fn line_selection_text(lines: &[String], anchor: VisualCursor, cursor: VisualCursor) -> String {
+    let Some((start_row, end_row)) = ordered_rows(lines, anchor, cursor) else {
+        return String::new();
+    };
+    lines[start_row..=end_row].join("\n")
+}
+
+fn block_selection_text(lines: &[String], anchor: VisualCursor, cursor: VisualCursor) -> String {
+    let Some((start_row, end_row)) = ordered_rows(lines, anchor, cursor) else {
+        return String::new();
+    };
+    let start_column = anchor.column.min(cursor.column);
+    let end_column = anchor.column.max(cursor.column).saturating_add(1);
+    (start_row..=end_row)
+        .map(|row| slice_chars(&lines[row], start_column, end_column))
+        .collect::<Vec<_>>()
+        .join("\n")
+}
+
+fn selection_ranges(
+    lines: &[String],
+    anchor: VisualCursor,
+    cursor: VisualCursor,
+    kind: VisualKind,
+) -> Vec<(usize, usize, usize)> {
+    match kind {
+        VisualKind::Character => character_selection_ranges(lines, anchor, cursor),
+        VisualKind::Line => line_selection_ranges(lines, anchor, cursor),
+        VisualKind::Block => block_selection_ranges(lines, anchor, cursor),
+    }
+}
+
+fn character_selection_ranges(
+    lines: &[String],
+    anchor: VisualCursor,
+    cursor: VisualCursor,
+) -> Vec<(usize, usize, usize)> {
+    let Some((start, end)) = ordered_cursors(lines, anchor, cursor) else {
+        return Vec::new();
+    };
+    (start.row..=end.row)
+        .map(|row| {
+            let line_len = lines[row].chars().count();
+            let start_column = if row == start.row {
+                start.column.min(line_len)
+            } else {
+                0
+            };
+            let end_column = if row == end.row {
+                end.column.saturating_add(1).min(line_len)
+            } else {
+                line_len
+            };
+            (row, start_column, end_column)
+        })
+        .collect()
+}
+
+fn line_selection_ranges(
+    lines: &[String],
+    anchor: VisualCursor,
+    cursor: VisualCursor,
+) -> Vec<(usize, usize, usize)> {
+    let Some((start_row, end_row)) = ordered_rows(lines, anchor, cursor) else {
+        return Vec::new();
+    };
+    (start_row..=end_row)
+        .map(|row| (row, 0, lines[row].chars().count()))
+        .collect()
+}
+
+fn block_selection_ranges(
+    lines: &[String],
+    anchor: VisualCursor,
+    cursor: VisualCursor,
+) -> Vec<(usize, usize, usize)> {
+    let Some((start_row, end_row)) = ordered_rows(lines, anchor, cursor) else {
+        return Vec::new();
+    };
+    let start_column = anchor.column.min(cursor.column);
+    let end_column = anchor.column.max(cursor.column).saturating_add(1);
+    (start_row..=end_row)
+        .map(|row| {
+            let line_len = lines[row].chars().count();
+            (row, start_column.min(line_len), end_column.min(line_len))
+        })
+        .collect()
+}
+
+fn ordered_cursors(
+    lines: &[String],
+    anchor: VisualCursor,
+    cursor: VisualCursor,
+) -> Option<(VisualCursor, VisualCursor)> {
+    if lines.is_empty() {
+        return None;
+    }
+    let anchor = clamp_cursor_row(anchor, lines.len());
+    let cursor = clamp_cursor_row(cursor, lines.len());
+    if (anchor.row, anchor.column) <= (cursor.row, cursor.column) {
+        Some((anchor, cursor))
+    } else {
+        Some((cursor, anchor))
+    }
+}
+
+fn ordered_rows(
+    lines: &[String],
+    anchor: VisualCursor,
+    cursor: VisualCursor,
+) -> Option<(usize, usize)> {
+    if lines.is_empty() {
+        return None;
+    }
+    let anchor = anchor.row.min(lines.len() - 1);
+    let cursor = cursor.row.min(lines.len() - 1);
+    Some((anchor.min(cursor), anchor.max(cursor)))
+}
+
+fn clamp_cursor_row(cursor: VisualCursor, line_count: usize) -> VisualCursor {
+    VisualCursor::new(cursor.row.min(line_count - 1), cursor.column)
+}
+
+fn slice_chars(line: &str, start: usize, end: usize) -> String {
+    line.chars()
+        .skip(start)
+        .take(end.saturating_sub(start))
+        .collect()
+}
+
+fn offset_index(value: usize, delta: isize) -> usize {
+    if delta < 0 {
+        value.saturating_sub((-delta) as usize)
+    } else {
+        value.saturating_add(delta as usize)
+    }
+}
