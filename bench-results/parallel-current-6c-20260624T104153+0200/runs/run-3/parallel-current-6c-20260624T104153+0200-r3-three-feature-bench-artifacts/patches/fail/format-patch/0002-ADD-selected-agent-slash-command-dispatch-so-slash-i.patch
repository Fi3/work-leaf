+fn backend_slash_command(message: &str) -> Option<BackendSlashCommand<'_>> {
+    let rest = message.trim().strip_prefix('/')?;
+    let command_end = rest.find(char::is_whitespace).unwrap_or(rest.len());
+    if command_end == 0 {
+        return None;
+    }
+    Some(BackendSlashCommand {
+        command: &rest[..command_end],
+        arguments: rest[command_end..].trim_start(),
+    })
+}
