+use crate::agent::{AgentError, AgentId, AgentLaunch, AgentSession, ChatMessage, MessageRole};
 
 pub trait AgentBackend {
     fn launch(&mut self, request: AgentLaunch) -> Result<AgentSession, AgentError>;
     fn send(&mut self, agent_id: &AgentId, prompt: &str) -> Result<ChatMessage, AgentError>;
+    fn execute_command(
+        &mut self,
+        _agent_id: &AgentId,
+        command: &str,
+        arguments: &str,
+    ) -> Result<ChatMessage, AgentError> {
+        Ok(ChatMessage::new(
+            MessageRole::Agent,
+            unsupported_backend_command_text(command, arguments),
+        ))
+    }
+
     fn interrupt(&mut self, _agent_id: &AgentId) -> Result<(), AgentError> {
         Ok(())
     }
@@ -33,6 +45,26 @@ pub trait AgentBackend {
     ) -> Result<ChatMessage, AgentError> {
         self.send(agent_id, prompt)
     }
+
+    fn execute_command_streaming(
+        &mut self,
+        agent_id: &AgentId,
+        command: &str,
+        arguments: &str,
+        _sink: &mut dyn FnMut(AgentStreamEvent),
+    ) -> Result<ChatMessage, AgentError> {
+        self.execute_command(agent_id, command, arguments)
+    }
+}
+
+fn unsupported_backend_command_text(command: &str, arguments: &str) -> String {
+    let arguments = arguments.trim();
+    let command = if arguments.is_empty() {
+        format!("/{command}")
+    } else {
+        format!("/{command} {arguments}")
+    };
+    format!("backend command `{command}` is not supported by this agent backend")
 }
 
