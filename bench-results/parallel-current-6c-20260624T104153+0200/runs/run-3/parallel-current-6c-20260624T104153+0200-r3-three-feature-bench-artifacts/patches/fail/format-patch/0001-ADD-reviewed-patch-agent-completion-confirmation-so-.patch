+#[test]
+fn terminal_app_closes_reviewed_patch_agent_on_yes_and_reopens_on_new_input() {
+    let root = git_repo("terminal-app-review-close-prompt");
+    fs::write(root.join("README.md"), "before\n").unwrap();
+    Command::new("git")
+        .current_dir(&root)
+        .args(["add", "README.md"])
+        .status()
+        .unwrap();
+    Command::new("git")
+        .current_dir(&root)
+        .args(["commit", "-m", "ADD initial readme fixture"])
+        .status()
+        .unwrap();
+
+    let backend = FakeBackend::new([
+        "implemented patch\n@work-leaf patch update readme\n--- a/README.md\n+++ b/README.md\n@@ -1 +1 @@\n-before\n+after\n@work-leaf end\n@work-leaf done",
+        "summary: README changes from before to after",
+        "NO_FINDINGS",
+        "second patch\n@work-leaf patch update readme again\n--- a/README.md\n+++ b/README.md\n@@ -1 +1 @@\n-after\n+after again\n@work-leaf end\n@work-leaf done",
+        "summary: README changes from after to after again",
+        "NO_FINDINGS",
+    ]);
+    let chat = CommandChat::new(root, backend.clone()).with_max_review_rounds(4);
+    let mut app = TerminalApp::new(chat, 100, 24);
+
+    app.handle_bytes(b":new update readme\n");
+    assert!(app.wait_for_idle(Duration::from_secs(2)));
+
+    let reviewed_frame = app.render_frame();
+    assert!(reviewed_frame.contains("work-leaf: is this feature done? yes/no"));
+    assert!(app.ui().render_left_pane().contains("user-1"));
+    assert!(app.ui().render_left_pane().contains("READY"));
+
+    app.handle_bytes(b"yes\n");
+
+    let closed_left_pane = app.ui().render_left_pane();
+    assert!(!closed_left_pane.contains("user-1  working:"));
+    assert!(closed_left_pane.contains("review-user-1"));
+    assert!(app.render_frame().contains("work-leaf: feature closed"));
+
+    app.handle_bytes(b"please reopen for follow-up\n");
+    assert!(app.wait_for_idle(Duration::from_secs(2)));
+
+    assert!(app.ui().render_left_pane().contains("user-1  working:"));
+    let reopened_frame = app.render_frame();
+    assert!(reopened_frame.contains("work-leaf: feature reopened"));
+    assert!(reopened_frame.contains("user: please reopen for follow-up"));
+    assert!(reopened_frame.contains("after again"));
+    assert!(reopened_frame.contains("work-leaf: is this feature done? yes/no"));
+
+    app.handle_bytes(b"yes\n");
+
+    let closed_again_left_pane = app.ui().render_left_pane();
+    assert!(!closed_again_left_pane.contains("user-1  working:"));
+    assert!(closed_again_left_pane.contains("review-user-1"));
+
+    let backend = app.into_chat().into_backend();
+    let sends = backend.sends();
+    assert!(
+        !sends
+            .iter()
+            .any(|(target, prompt)| target.as_str() == "user-1" && prompt == "yes")
+    );
+    assert!(sends.iter().any(|(target, prompt)| {
+        target.as_str() == "user-1" && prompt == "please reopen for follow-up"
+    }));
+}
