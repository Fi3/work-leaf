+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+enum FeatureCompletionState {
+    Open,
+    Prompted,
+    Closed,
+}
+
+fn feature_completion_state(lines: &[String]) -> FeatureCompletionState {
+    lines
+        .iter()
+        .rev()
+        .find_map(|line| match line.as_str() {
+            FEATURE_DONE_PROMPT_LINE => Some(FeatureCompletionState::Prompted),
+            FEATURE_CLOSED_LINE => Some(FeatureCompletionState::Closed),
+            FEATURE_REOPENED_LINE => Some(FeatureCompletionState::Open),
+            _ => None,
+        })
+        .unwrap_or(FeatureCompletionState::Open)
+}
+
+fn is_feature_completion_line(line: &str) -> bool {
+    matches!(
+        line,
+        FEATURE_DONE_PROMPT_LINE | FEATURE_CLOSED_LINE | FEATURE_REOPENED_LINE
+    )
+}
