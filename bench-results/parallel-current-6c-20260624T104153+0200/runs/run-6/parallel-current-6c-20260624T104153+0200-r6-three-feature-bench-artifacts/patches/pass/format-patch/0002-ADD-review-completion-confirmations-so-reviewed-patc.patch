+fn scripted_harness_feature_done_prompt_closes_on_yes_and_reopens_on_text() {
+    let mut harness = UiHarness::new(100, 24);
+
+    harness
+        .prompt_feature_done("user-1")
+        .expect("fixture user-1 agent is registered");
+
+    let frame = harness.render_frame();
+    assert!(frame.starts_with('\u{7}'));
+    assert!(frame.contains("Is this feature done? yes/no"));
+    assert!(
+        harness
+            .ui()
+            .render_left_pane()
+            .contains("\u{1b}[7m>parser user-1  working: parser  DONE?\u{1b}[0m")
+    );
+
+    harness.handle_bytes(b"iyes\n");
+
+    assert!(harness.ui().selected_agent().is_none());
+    assert!(!harness.ui().render_left_pane().contains(">parser user-1"));
+
+    let mut harness = UiHarness::new(100, 24);
+    harness
+        .prompt_feature_done("user-1")
+        .expect("fixture user-1 agent is registered");
+
+    harness.handle_bytes(b"icontinue work\n");
+
+    assert!(
+        harness
+            .transcript()
+            .iter()
+            .any(|line| line == "user-1> continue work")
+    );
+    assert!(
+        !harness
+            .render_frame()
+            .contains("Is this feature done? yes/no")
+    );
+}
