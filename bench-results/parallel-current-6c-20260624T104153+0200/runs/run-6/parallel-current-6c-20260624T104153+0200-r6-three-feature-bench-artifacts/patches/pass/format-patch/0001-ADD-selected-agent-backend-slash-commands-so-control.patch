+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::agent::{AgentError, AgentSession, ChatMessage, MessageRole};
+    use std::fs;
+    use std::path::PathBuf;
+    use std::sync::{
+        Arc, Mutex,
+        atomic::{AtomicUsize, Ordering},
+    };
+
+    #[test]
+    fn selected_agent_slash_command_requires_non_whitespace_command_token() {
+        assert_eq!(selected_agent_backend_command("/status"), Some("/status"));
+        assert_eq!(
+            selected_agent_backend_command("/fork branch"),
+            Some("/fork branch")
+        );
+        assert_eq!(
+            selected_agent_backend_command("  /status  "),
+            Some("/status")
+        );
+        assert_eq!(selected_agent_backend_command("/"), None);
+        assert_eq!(selected_agent_backend_command("/ status"), None);
+        assert_eq!(selected_agent_backend_command("status"), None);
+    }
+
+    #[test]
+    fn selected_agent_slash_commands_execute_as_backend_commands() {
+        let project = temp_project("slash-command");
+        let backend = RecordingBackend::default();
+        let state = backend.state.clone();
+        let chat = CommandChat::new(project.path().to_path_buf(), backend);
+        let mut controller = WorkLeafController::new(chat);
+        let agent_id = controller
+            .create_agent("")
+            .expect("test agent launch starts");
+        assert!(controller.wait_for_idle(Duration::from_secs(1)));
+
+        controller
+            .send_message(&agent_id, "/status")
+            .expect("status command starts");
+        assert!(controller.wait_for_idle(Duration::from_secs(1)));
+        controller
+            .send_message(&agent_id, "/fork")
+            .expect("fork command starts");
+        assert!(controller.wait_for_idle(Duration::from_secs(1)));
+
+        let snapshot = controller.snapshot();
+        let session = snapshot
+            .session(&agent_id)
+            .expect("test session is present in snapshot");
+        assert!(session.lines.iter().any(|line| line == "user: /status"));
+        assert!(
+            session
+                .lines
+                .iter()
+                .any(|line| line == "command output: /status")
+        );
+        assert!(session.lines.iter().any(|line| line == "user: /fork"));
+        assert!(
+            session
+                .lines
+                .iter()
+                .any(|line| line == "command output: /fork")
+        );
+
+        let state = state
+            .lock()
+            .expect("recording backend state mutex poisoned");
+        assert_eq!(state.commands, vec!["/status", "/fork"]);
+        assert!(
+            state.sends.is_empty(),
+            "slash commands must not be sent through the normal prompt path"
+        );
+    }
+
+    #[derive(Clone, Debug, Default)]
+    struct RecordingBackend {
+        state: Arc<Mutex<RecordingBackendState>>,
+    }
+
+    #[derive(Debug, Default)]
+    struct RecordingBackendState {
+        sends: Vec<String>,
+        commands: Vec<String>,
+    }
+
+    impl AgentBackend for RecordingBackend {
+        fn launch(&mut self, request: AgentLaunch) -> Result<AgentSession, AgentError> {
+            let mut session = AgentSession::new(request);
+            session.push_message(MessageRole::Agent, "launch ready");
+            Ok(session)
+        }
+
+        fn send(&mut self, _agent_id: &AgentId, prompt: &str) -> Result<ChatMessage, AgentError> {
+            self.state
+                .lock()
+                .expect("recording backend state mutex poisoned")
+                .sends
+                .push(prompt.to_string());
+            Ok(ChatMessage::new(
+                MessageRole::Agent,
+                format!("prompt output: {prompt}"),
+            ))
+        }
+
+        fn execute_command(
+            &mut self,
+            _agent_id: &AgentId,
+            command: &str,
+        ) -> Result<ChatMessage, AgentError> {
+            self.state
+                .lock()
+                .expect("recording backend state mutex poisoned")
+                .commands
+                .push(command.to_string());
+            Ok(ChatMessage::new(
+                MessageRole::Agent,
+                format!("command output: {command}"),
+            ))
+        }
+    }
+
+    struct TempProject {
+        root: PathBuf,
+    }
+
+    impl TempProject {
+        fn path(&self) -> &std::path::Path {
+            &self.root
+        }
+    }
+
+    impl Drop for TempProject {
+        fn drop(&mut self) {
+            let _ = fs::remove_dir_all(&self.root);
+        }
+    }
+
+    fn temp_project(name: &str) -> TempProject {
+        static COUNTER: AtomicUsize = AtomicUsize::new(0);
+        let root = std::env::temp_dir().join(format!(
+            "work-leaf-workspace-test-{name}-{}-{}",
+            std::process::id(),
+            COUNTER.fetch_add(1, Ordering::Relaxed)
+        ));
+        let _ = fs::remove_dir_all(&root);
+        fs::create_dir_all(&root).expect("test project directory is created");
+        TempProject { root }
+    }
+}
