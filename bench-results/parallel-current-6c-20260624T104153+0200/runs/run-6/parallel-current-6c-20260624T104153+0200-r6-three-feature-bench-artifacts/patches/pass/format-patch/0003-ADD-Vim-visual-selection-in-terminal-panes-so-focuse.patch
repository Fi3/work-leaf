+
+    fn current_visual_point(&self, focus: PaneFocus, right_content: &str) -> VisualPoint {
+        let lines = self.pane_text_lines(focus, right_content);
+        let last_row = lines.len().saturating_sub(1);
+        let row = match focus {
+            PaneFocus::Left => self.control_selected.min(last_row),
+            PaneFocus::Right => last_row,
+        };
+        VisualPoint { row, column: 0 }
+    }
+
+    fn move_visual_cursor(&mut self, row_delta: isize, column_delta: isize, right_content: &str) {
+        let Some(selection) = self.visual_selection.clone() else {
+            return;
+        };
+        let lines = self.pane_text_lines(selection.focus, right_content);
+        if lines.is_empty() {
+            return;
+        }
+        let max_row = lines.len().saturating_sub(1) as isize;
+        let row = (selection.cursor.row as isize + row_delta).clamp(0, max_row) as usize;
+        let line_len = lines[row].chars().count();
+        let max_column = line_len.saturating_sub(1) as isize;
+        let column = if column_delta == 0 {
+            selection.cursor.column.min(line_len.saturating_sub(1))
+        } else {
+            (selection.cursor.column as isize + column_delta).clamp(0, max_column) as usize
+        };
+        if let Some(selection) = self.visual_selection.as_mut() {
+            selection.cursor = VisualPoint { row, column };
+        }
+    }
+
+    fn copy_visual_selection(
+        &mut self,
+        right_content: &str,
+        kind_override: Option<VisualKind>,
+    ) -> Vec<UiAction> {
+        let Some(selection) = self.visual_selection.clone() else {
+            return Vec::new();
+        };
+        let lines = self.pane_text_lines(selection.focus, right_content);
+        let kind = kind_override.unwrap_or(selection.kind);
+        self.copied_text = Some(Self::selected_text_from_lines(&lines, &selection, kind));
+        self.clear_visual_selection();
+        Vec::new()
+    }
+
+    fn pane_text_lines(&self, focus: PaneFocus, right_content: &str) -> Vec<String> {
+        match focus {
+            PaneFocus::Left => self
+                .left_pane_lines()
+                .into_iter()
+                .map(|line| line.text)
+                .collect(),
+            PaneFocus::Right => {
+                let visible = self.visible_right_content(right_content);
+                if visible.is_empty() {
+                    vec![String::new()]
+                } else {
+                    visible.lines().map(str::to_string).collect()
+                }
+            }
+        }
+    }
+
+    fn selected_text_from_lines(
+        lines: &[String],
+        selection: &VisualSelection,
+        kind: VisualKind,
+    ) -> String {
+        lines
+            .iter()
+            .enumerate()
+            .filter_map(|(row, line)| {
+                let (start, end) = Self::selection_range_for(
+                    kind,
+                    selection.anchor,
+                    selection.cursor,
+                    row,
+                    line.chars().count(),
+                )?;
+                Some(char_slice(line, start, end))
+            })
+            .collect::<Vec<_>>()
+            .join("\n")
+    }
+
+    fn selection_range_for(
+        kind: VisualKind,
+        anchor: VisualPoint,
+        cursor: VisualPoint,
+        row: usize,
+        line_len: usize,
+    ) -> Option<(usize, usize)> {
+        let top = anchor.row.min(cursor.row);
+        let bottom = anchor.row.max(cursor.row);
+        if row < top || row > bottom {
+            return None;
+        }
+
+        match kind {
+            VisualKind::Line => Some((0, line_len)),
+            VisualKind::Block => {
+                let start = anchor.column.min(cursor.column).min(line_len);
+                let end = anchor
+                    .column
+                    .max(cursor.column)
+                    .saturating_add(1)
+                    .min(line_len);
+                Some((start, end.max(start)))
+            }
+            VisualKind::Character => {
+                let (start, end) = if anchor.row == cursor.row {
+                    (
+                        anchor.column.min(cursor.column),
+                        anchor.column.max(cursor.column).saturating_add(1),
+                    )
+                } else if row == anchor.row {
+                    if anchor.row < cursor.row {
+                        (anchor.column, line_len)
+                    } else {
+                        (0, anchor.column.saturating_add(1))
+                    }
+                } else if row == cursor.row {
+                    if anchor.row < cursor.row {
+                        (0, cursor.column.saturating_add(1))
+                    } else {
+                        (cursor.column, line_len)
+                    }
+                } else {
+                    (0, line_len)
+                };
+                let start = start.min(line_len);
+                let end = end.min(line_len);
+                Some((start, end.max(start)))
+            }
+        }
+    }
