+                Vec::new()
+            }
+            UiKey::Char('y') => self.copy_visual_selection(right_content, None),
+            UiKey::Char('Y') => self.copy_visual_selection(right_content, Some(VisualKind::Line)),
+            _ => Vec::new(),
