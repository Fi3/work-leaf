+pub(crate) fn selected_agent_backend_command(message: &str) -> Option<&str> {
+    let trimmed = message.trim();
+    let command = trimmed.strip_prefix('/')?;
+    if command.chars().next().is_some_and(char::is_whitespace) || command.is_empty() {
+        return None;
+    }
+    Some(trimmed)
+}
