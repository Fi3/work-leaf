+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+enum FeatureCompletionReply {
+    Done,
+    Reopen,
+}
+
+fn feature_completion_reply(message: &str) -> Option<FeatureCompletionReply> {
+    let normalized = message.trim().to_ascii_lowercase();
+    match normalized.as_str() {
+        "yes" | "y" => Some(FeatureCompletionReply::Done),
+        "no" | "n" => Some(FeatureCompletionReply::Reopen),
+        _ => None,
+    }
+}
