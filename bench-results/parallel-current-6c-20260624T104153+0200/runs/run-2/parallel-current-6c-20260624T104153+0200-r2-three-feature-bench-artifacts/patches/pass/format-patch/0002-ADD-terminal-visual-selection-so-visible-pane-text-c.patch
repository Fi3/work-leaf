+    fn start_visual_selection(&mut self, kind: VisualKind) {
+        let focus = if self.focus == PaneFocus::Left && !self.left_visible {
+            PaneFocus::Right
+        } else {
+            self.focus
+        };
+        let (width, height) = self.pane_inner_dimensions(focus);
+        let anchor = self.visual_start_point(focus).clamp(width, height);
+        self.visual_selection = Some(VisualSelection {
+            focus,
+            kind,
+            anchor,
+            head: anchor,
+        });
+        self.mode = UiMode::Command;
+        self.pending = None;
+    }
+
+    fn set_visual_kind(&mut self, kind: VisualKind) {
+        if let Some(selection) = self.visual_selection.as_mut() {
+            selection.kind = kind;
+        }
+    }
+
+    fn clear_visual_selection(&mut self) {
+        self.visual_selection = None;
+        self.pending_visual_copy = None;
+    }
+
+    fn visual_start_point(&self, focus: PaneFocus) -> TextPoint {
+        match focus {
+            PaneFocus::Left => TextPoint {
+                row: self.left_visual_start_row(),
+                column: 0,
+            },
+            PaneFocus::Right => self.right_cursor_hint,
+        }
+    }
+
+    fn left_visual_start_row(&self) -> usize {
+        if self.control_selected == 0 {
+            return 0;
+        }
+
+        let Some(target_agent_index) = self.control_selected_agent_index() else {
+            return 0;
+        };
+        let mut row = 1;
+        for agent_index in self.visible_agent_indices() {
+            if agent_index == target_agent_index {
+                return row;
+            }
+            let agent = &self.agents[agent_index];
+            row += 1;
+            if !agent.modified_files.is_empty() {
+                row += 1;
+            }
+            if !agent.conflicting_agents.is_empty() {
+                row += 1;
+            }
+            if !agent.depends_on.is_empty() {
+                row += 1;
+            }
+            if !agent.depended_on_by.is_empty() {
+                row += 1;
+            }
+        }
+        0
+    }
+
+    fn move_visual_selection(&mut self, row_delta: isize, column_delta: isize) {
+        let Some(selection) = self.visual_selection else {
+            return;
+        };
+        let (width, height) = self.pane_inner_dimensions(selection.focus);
+        let max_row = height.saturating_sub(1);
+        let max_column = width.saturating_sub(1);
+        if let Some(selection) = self.visual_selection.as_mut() {
+            selection.head = TextPoint {
+                row: offset_clamped(selection.head.row, row_delta, max_row),
+                column: offset_clamped(selection.head.column, column_delta, max_column),
+            };
+        }
+    }
