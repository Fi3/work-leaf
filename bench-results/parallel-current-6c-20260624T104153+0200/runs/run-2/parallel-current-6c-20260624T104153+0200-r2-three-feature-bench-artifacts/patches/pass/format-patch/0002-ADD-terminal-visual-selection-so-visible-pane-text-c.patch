+    fn pane_inner_dimensions(&self, focus: PaneFocus) -> (usize, usize) {
+        let layout = self.layout();
+        let width = match focus {
+            PaneFocus::Left => layout.left_width,
+            PaneFocus::Right => layout.right_width,
+        }
+        .saturating_sub(2)
+        .max(1);
+        let height = self.height.saturating_sub(1).saturating_sub(2).max(1);
+        (usize::from(width), usize::from(height))
+    }
+
+    fn pane_inner_origin(&self, focus: PaneFocus) -> Option<(u16, u16)> {
+        let layout = self.layout();
+        match focus {
+            PaneFocus::Left if layout.left_width > 0 => Some((1, 1)),
+            PaneFocus::Left => None,
+            PaneFocus::Right if layout.left_width > 0 => Some((layout.left_width + 1, 1)),
+            PaneFocus::Right => Some((1, 1)),
+        }
+    }
+
+    fn apply_visual_selection(&self, buffer: &mut Buffer) {
+        let Some(selection) = self.visual_selection else {
+            return;
+        };
+        let Some((origin_x, origin_y)) = self.pane_inner_origin(selection.focus) else {
+            return;
+        };
+        let (width, height) = self.pane_inner_dimensions(selection.focus);
+        for row in 0..height {
+            let Some((start, end)) = selected_columns(selection, selection.kind, row, width) else {
+                continue;
+            };
+            for column in start..=end {
+                let x = origin_x.saturating_add(column.min(usize::from(u16::MAX)) as u16);
+                let y = origin_y.saturating_add(row.min(usize::from(u16::MAX)) as u16);
+                if x < buffer.area.width && y < buffer.area.height {
+                    buffer
+                        .get_mut(x, y)
+                        .set_style(Style::default().add_modifier(Modifier::REVERSED));
+                }
+            }
+        }
+    }
+
+    fn selected_visual_text(&self, right_content: &str, copy_kind: VisualKind) -> Option<String> {
+        let selection = self.visual_selection?;
+        let (width, height) = self.pane_inner_dimensions(selection.focus);
+        if width == 0 || height == 0 {
+            return None;
+        }
+
+        let lines = self.pane_visible_text_lines(selection.focus, right_content);
+        let row_start = selection.anchor.row.min(selection.head.row);
+        let row_end = selection.anchor.row.max(selection.head.row).min(height - 1);
+        let mut copied = Vec::new();
+        for row in row_start..=row_end {
+            let Some((start, end)) = selected_columns(selection, copy_kind, row, width) else {
+                continue;
+            };
+            let line = lines.get(row).map(String::as_str).unwrap_or("");
+            let segment = match copy_kind {
+                VisualKind::Line => line.trim_end().to_string(),
+                VisualKind::Character => line_slice_by_columns(line, start, end, false),
+                VisualKind::Block => line_slice_by_columns(line, start, end, true),
+            };
+            copied.push(segment);
+        }
+        while copied.last().is_some_and(|line| line.is_empty()) {
+            copied.pop();
+        }
+        Some(copied.join("\n"))
+    }
+
+    fn pane_visible_text_lines(&self, focus: PaneFocus, right_content: &str) -> Vec<String> {
+        let (width, height) = self.pane_inner_dimensions(focus);
+        match focus {
+            PaneFocus::Left => self
