+fn selected_columns(
+    selection: VisualSelection,
+    kind: VisualKind,
+    row: usize,
+    width: usize,
+) -> Option<(usize, usize)> {
+    if width == 0 {
+        return None;
+    }
+    let last_column = width - 1;
+    let row_start = selection.anchor.row.min(selection.head.row);
+    let row_end = selection.anchor.row.max(selection.head.row);
+    if row < row_start || row > row_end {
+        return None;
+    }
+
+    match kind {
+        VisualKind::Line => Some((0, last_column)),
+        VisualKind::Block => {
+            let start = selection
+                .anchor
+                .column
+                .min(selection.head.column)
+                .min(last_column);
+            let end = selection
+                .anchor
+                .column
+                .max(selection.head.column)
+                .min(last_column);
+            Some((start, end))
+        }
+        VisualKind::Character => {
+            let (start, end) = ordered_points(selection.anchor, selection.head);
+            if start.row == end.row {
+                Some((start.column.min(last_column), end.column.min(last_column)))
+            } else if row == start.row {
+                Some((start.column.min(last_column), last_column))
+            } else if row == end.row {
+                Some((0, end.column.min(last_column)))
+            } else {
+                Some((0, last_column))
+            }
+        }
+    }
+}
+
+fn ordered_points(left: TextPoint, right: TextPoint) -> (TextPoint, TextPoint) {
+    if left.row < right.row || (left.row == right.row && left.column <= right.column) {
+        (left, right)
+    } else {
+        (right, left)
+    }
+}
+
+fn line_slice_by_columns(line: &str, start: usize, end: usize, pad: bool) -> String {
+    let mut chars = line.chars().collect::<Vec<_>>();
+    if pad && chars.len() <= end {
+        chars.resize(end + 1, ' ');
+    }
+    chars
+        .into_iter()
+        .skip(start)
+        .take(end.saturating_sub(start) + 1)
+        .collect()
+}
+
+fn wrap_line_to_width(line: &str, width: usize) -> Vec<String> {
+    let width = width.max(1);
+    if line.is_empty() {
+        return vec![String::new()];
+    }
+    line.chars()
+        .collect::<Vec<_>>()
+        .chunks(width)
+        .map(|chunk| chunk.iter().copied().collect())
+        .collect()
+}
+
+fn offset_clamped(value: usize, delta: isize, max: usize) -> usize {
+    if delta.is_negative() {
+        value.saturating_sub(delta.unsigned_abs()).min(max)
+    } else {
+        value.saturating_add(delta as usize).min(max)
+    }
+}
