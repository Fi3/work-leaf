+fn controller_prompts_feature_done_after_each_clean_review_for_reopened_agent() {
+    let root = git_repo("workspace-review-prompts-each-clean-pass");
+    fs::write(root.join("README.md"), "before\n").unwrap();
+    git(&root, ["add", "README.md"]);
+    git(&root, ["commit", "-m", "ADD initial readme fixture"]);
+    let backend = FakeBackend::new([
+        "first patch\n@work-leaf patch first change\n--- a/README.md\n+++ b/README.md\n@@ -1 +1 @@\n-before\n+first\n@work-leaf end\n@work-leaf done",
+        "summary: first patch",
+        "NO_FINDINGS",
+        "second patch\n@work-leaf patch second change\n--- a/README.md\n+++ b/README.md\n@@ -1 +1 @@\n-first\n+second\n@work-leaf end\n@work-leaf done",
+        "summary: second patch",
+        "NO_FINDINGS",
+    ]);
+    let chat = CommandChat::new(root, backend).with_max_review_rounds(4);
+    let mut controller = WorkLeafController::new(chat);
+
+    let agent_id = controller.create_agent("update readme twice").unwrap();
+    assert!(controller.wait_for_idle(Duration::from_secs(2)));
