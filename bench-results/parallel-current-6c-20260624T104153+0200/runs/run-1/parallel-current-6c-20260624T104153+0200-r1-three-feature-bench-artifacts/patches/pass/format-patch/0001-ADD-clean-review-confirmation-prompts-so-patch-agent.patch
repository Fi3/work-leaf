+    fn handle_feature_completion_reply(
+        &mut self,
+        agent_id: &AgentId,
+        message: &str,
+    ) -> Result<bool, CliError> {
+        if !self.feature_completion_prompts.contains(agent_id) {
+            return Ok(false);
+        }
+
+        self.feature_completion_prompts.remove(agent_id);
+        self.append_agent_line(agent_id, format!("user: {message}"));
+        if is_feature_done_confirmation(message) {
+            self.closed_feature_chats.insert(agent_id.clone());
+            self.append_agent_line(agent_id, FEATURE_CLOSED_LINE.to_string());
+            Ok(true)
+        } else if is_feature_not_done_confirmation(message) {
+            self.append_agent_line(agent_id, FEATURE_REOPENED_LINE.to_string());
+            Ok(true)
+        } else {
+            self.append_agent_line(agent_id, FEATURE_REOPENED_LINE.to_string());
+            self.send_message(agent_id, message)?;
+            Ok(true)
+        }
+    }
+
+    fn ask_feature_done(&mut self, agent_id: &AgentId) {
+        self.closed_feature_chats.remove(agent_id);
+        self.feature_completion_prompts.insert(agent_id.clone());
+        let prompt_count = self
+            .feature_completion_prompt_counts
+            .entry(agent_id.clone())
+            .and_modify(|count| *count += 1)
+            .or_insert(1);
+        let prompt = if *prompt_count == 1 {
+            FEATURE_DONE_PROMPT.to_string()
+        } else {
+            format!("{FEATURE_DONE_PROMPT} (review {prompt_count})")
+        };
+        self.append_agent_line(agent_id, prompt);
+    }
+
+    fn mark_patch_agent_under_review(&mut self, agent_id: &AgentId) {
+        self.feature_completion_prompts.remove(agent_id);
+        self.closed_feature_chats.remove(agent_id);
+        self.set_existing_session_loading(agent_id, Some(WorkLeafLoading::WaitingForReply));
+    }
+
+    fn set_existing_session_loading(
+        &mut self,
+        agent_id: &AgentId,
+        loading: Option<WorkLeafLoading>,
+    ) {
+        if self.sessions.contains_key(agent_id) {
+            self.set_session_loading(agent_id, loading);
+        }
+    }
