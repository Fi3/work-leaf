+    fn current_visual_position(
+        &self,
+        right_content: &str,
+        right_cursor_column: Option<usize>,
+    ) -> VisualPosition {
+        match self.focus {
+            PaneFocus::Left => {
+                let (_, height) = self.visual_inner_size(PaneFocus::Left);
+                VisualPosition {
+                    row: self
+                        .control_selected_visual_row()
+                        .min(height.saturating_sub(1)),
+                    column: 0,
+                }
+            }
+            PaneFocus::Right => {
+                let visible_right_content = self.visible_right_content(right_content);
+                let (cursor_row, cursor_column) = self
+                    .right_cursor_position_with_cursor(&visible_right_content, right_cursor_column);
+                let layout = self.layout();
+                let (width, height) = self.visual_inner_size(PaneFocus::Right);
+                let row = usize::from(cursor_row.saturating_sub(2)).min(height.saturating_sub(1));
+                let mut column = usize::from(
+                    cursor_column
+                        .saturating_sub(layout.left_width)
+                        .saturating_sub(2),
+                )
+                .min(width.saturating_sub(1));
+                let rows = visual_text_rows(&visible_right_content, width);
+                if let Some(line) = rows.get(row) {
+                    let line_len = line.chars().count();
+                    column = if line_len == 0 {
+                        0
+                    } else {
+                        column.min(line_len.saturating_sub(1))
+                    };
+                }
+                VisualPosition { row, column }
+            }
+        }
+    }
+
+    fn visual_cursor_position(&self, selection: VisualSelection) -> (u16, u16) {
+        let Some(inner) = self.visual_inner_rect(selection.pane) else {
+            return match self.focus {
+                PaneFocus::Left => (self.control_cursor_row(), 2),
+                PaneFocus::Right => (2, self.layout().left_width.saturating_add(2)),
+            };
+        };
+        (
+            inner
+                .y
+                .saturating_add(selection.cursor.row.min(usize::from(u16::MAX)) as u16)
+                .saturating_add(1),
+            inner
+                .x
+                .saturating_add(selection.cursor.column.min(usize::from(u16::MAX)) as u16)
+                .saturating_add(1),
+        )
+    }
