+fn move_index(current: usize, delta: isize, max: usize) -> usize {
+    if delta.is_negative() {
+        current.saturating_sub(delta.unsigned_abs()).min(max)
+    } else {
+        current.saturating_add(delta as usize).min(max)
+    }
+}
+
+fn selected_text_from_rows(
+    rows: &[String],
+    selection: VisualSelection,
+    kind: VisualSelectionKind,
+) -> Option<String> {
+    if rows.is_empty() {
+        return None;
+    }
+    let (start, end) = ordered_positions(selection.anchor, selection.cursor);
+    let start_row = start.row.min(rows.len().saturating_sub(1));
+    let end_row = end.row.min(rows.len().saturating_sub(1));
+    let lines: Vec<String> = match kind {
+        VisualSelectionKind::Line => rows[start_row..=end_row].to_vec(),
+        VisualSelectionKind::Block => {
+            let start_column = selection.anchor.column.min(selection.cursor.column);
+            let end_column = selection.anchor.column.max(selection.cursor.column);
+            (start_row..=end_row)
+                .map(|row| row_columns(&rows[row], start_column, end_column))
+                .collect()
+        }
+        VisualSelectionKind::Character => (start_row..=end_row)
+            .map(|row| {
+                let line_len = rows[row].chars().count();
+                if line_len == 0 {
+                    return String::new();
+                }
+                let last_column = line_len.saturating_sub(1);
+                let start_column = if row == start.row {
+                    start.column.min(last_column)
+                } else {
+                    0
+                };
+                let end_column = if row == end.row {
+                    end.column.min(last_column)
+                } else {
+                    last_column
+                };
+                row_columns(&rows[row], start_column, end_column)
+            })
+            .collect(),
+    };
+    Some(lines.join("\n"))
+}
+
+fn visual_selection_contains(selection: VisualSelection, row: usize, column: usize) -> bool {
+    match selection.kind {
+        VisualSelectionKind::Line => {
+            let start = selection.anchor.row.min(selection.cursor.row);
+            let end = selection.anchor.row.max(selection.cursor.row);
+            (start..=end).contains(&row)
+        }
+        VisualSelectionKind::Block => {
+            let start_row = selection.anchor.row.min(selection.cursor.row);
+            let end_row = selection.anchor.row.max(selection.cursor.row);
+            let start_column = selection.anchor.column.min(selection.cursor.column);
+            let end_column = selection.anchor.column.max(selection.cursor.column);
+            (start_row..=end_row).contains(&row) && (start_column..=end_column).contains(&column)
+        }
+        VisualSelectionKind::Character => {
+            let (start, end) = ordered_positions(selection.anchor, selection.cursor);
+            if row < start.row || row > end.row {
+                return false;
+            }
+            if start.row == end.row {
+                return (start.column..=end.column).contains(&column);
+            }
+            if row == start.row {
+                return column >= start.column;
+            }
+            if row == end.row {
+                return column <= end.column;
+            }
+            true
+        }
+    }
+}
+
+fn ordered_positions(
+    first: VisualPosition,
+    second: VisualPosition,
+) -> (VisualPosition, VisualPosition) {
+    if (first.row, first.column) <= (second.row, second.column) {
+        (first, second)
+    } else {
+        (second, first)
+    }
+}
+
+fn row_columns(line: &str, start_column: usize, end_column: usize) -> String {
+    if start_column > end_column {
+        return String::new();
+    }
+    line.chars()
+        .skip(start_column)
+        .take(end_column.saturating_sub(start_column).saturating_add(1))
+        .collect()
+}
