+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::path::PathBuf;
+    use std::sync::{Arc, Mutex};
+    use std::time::Duration;
+
+    use crate::agent::{AgentError, AgentSession, ChatMessage, MessageRole};
+
+    #[test]
+    fn selected_agent_status_command_uses_backend_command_path_without_send_prompt() {
+        let (mut controller, state, agent_id) = recording_controller();
+
+        controller.send_message(&agent_id, "/status").unwrap();
+        assert!(controller.wait_for_idle(Duration::from_secs(1)));
+
+        let state = state.lock().expect("recording state mutex is not poisoned");
+        assert_eq!(state.commands, vec!["/status".to_string()]);
+        assert!(
+            state.sends.is_empty(),
+            "/status must not be delivered to the normal send path"
+        );
+        drop(state);
+
+        let snapshot = controller.snapshot();
+        let session = snapshot
+            .session(&agent_id)
+            .expect("test agent session is present");
+        assert!(session.lines.iter().any(|line| line == "user: /status"));
+        assert!(
+            session
+                .lines
+                .iter()
+                .any(|line| line == "command output: /status")
+        );
+        assert!(
+            !session
+                .lines
+                .iter()
+                .any(|line| line == "send reply: /status")
+        );
+    }
+
+    #[test]
+    fn selected_agent_fork_command_uses_backend_command_path() {
+        let (mut controller, state, agent_id) = recording_controller();
+
+        controller.send_message(&agent_id, "/fork").unwrap();
+        assert!(controller.wait_for_idle(Duration::from_secs(1)));
+
+        let state = state.lock().expect("recording state mutex is not poisoned");
+        assert_eq!(state.commands, vec!["/fork".to_string()]);
+        assert!(state.sends.is_empty());
+        drop(state);
+
+        let snapshot = controller.snapshot();
+        let session = snapshot
+            .session(&agent_id)
+            .expect("test agent session is present");
+        assert!(session.lines.iter().any(|line| line == "user: /fork"));
+        assert!(
+            session
+                .lines
+                .iter()
+                .any(|line| line == "command output: /fork")
+        );
+    }
+
+    fn recording_controller() -> (
+        WorkLeafController<RecordingBackend>,
+        Arc<Mutex<RecordingState>>,
+        AgentId,
+    ) {
+        let backend = RecordingBackend::default();
+        let state = Arc::clone(&backend.state);
+        let chat = CommandChat::new(PathBuf::from("."), backend);
+        let mut controller = WorkLeafController::new(chat);
+        let agent_id = controller.create_agent("").unwrap();
+        assert!(controller.wait_for_idle(Duration::from_secs(1)));
+        (controller, state, agent_id)
+    }
+
+    #[derive(Clone, Debug, Default)]
+    struct RecordingBackend {
+        state: Arc<Mutex<RecordingState>>,
+    }
+
+    #[derive(Debug, Default)]
+    struct RecordingState {
+        sends: Vec<String>,
+        commands: Vec<String>,
+    }
+
+    impl AgentBackend for RecordingBackend {
+        fn launch(&mut self, request: AgentLaunch) -> Result<AgentSession, AgentError> {
+            let mut session = AgentSession::new(request);
+            session.push_message(MessageRole::Agent, "launch ready");
+            Ok(session)
+        }
+
+        fn send(&mut self, _agent_id: &AgentId, prompt: &str) -> Result<ChatMessage, AgentError> {
+            self.state
+                .lock()
+                .expect("recording state mutex is not poisoned")
+                .sends
+                .push(prompt.to_string());
+            Ok(ChatMessage::new(
+                MessageRole::Agent,
+                format!("send reply: {prompt}"),
+            ))
+        }
+
+        fn execute_command_streaming(
+            &mut self,
+            _agent_id: &AgentId,
+            command: &str,
+            _sink: &mut dyn FnMut(AgentStreamEvent),
+        ) -> Result<ChatMessage, AgentError> {
+            self.state
+                .lock()
+                .expect("recording state mutex is not poisoned")
+                .commands
+                .push(command.to_string());
+            Ok(ChatMessage::new(
+                MessageRole::Agent,
+                format!("command output: {command}"),
+            ))
+        }
+    }
+}
