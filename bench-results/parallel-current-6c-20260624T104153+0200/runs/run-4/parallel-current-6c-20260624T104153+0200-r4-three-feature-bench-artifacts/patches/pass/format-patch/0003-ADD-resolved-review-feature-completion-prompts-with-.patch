+
+        self.feature_done_prompts.remove(agent_id);
+        self.closed_features.insert(agent_id.clone());
+        self.transcript.push(format!("{target}> {message}"));
+        self.transcript.push(FEATURE_DONE_CLOSED.to_string());
+        let _ = self.ui.set_agent_ready_state(agent_id, false);
+        true
+    }
+
+    fn reopen_feature_if_needed(&mut self, agent_id: &AgentId) -> bool {
+        let reopened =
+            self.feature_done_prompts.remove(agent_id) || self.closed_features.remove(agent_id);
+        if reopened {
