+fn styled_spans(line: &str, ranges: &[(usize, usize)]) -> Vec<Span<'static>> {
+    if ranges.is_empty() {
+        return vec![Span::raw(line.to_string())];
+    }
+
+    let mut spans = Vec::new();
+    let mut cursor = 0;
+    let line_len = line.chars().count();
+    for (start, end) in ranges {
+        let start = (*start).min(line_len);
+        let end = (*end).min(line_len);
+        if cursor < start {
+            spans.push(Span::raw(char_range(line, cursor, start)));
+        }
+        if start < end {
+            spans.push(Span::styled(
+                char_range(line, start, end),
+                Style::default().add_modifier(Modifier::REVERSED),
+            ));
+        }
+        cursor = end;
+    }
+    if cursor < line_len {
+        spans.push(Span::raw(char_range(line, cursor, line_len)));
+    }
+    if spans.is_empty() {
+        spans.push(Span::raw(String::new()));
+    }
+    spans
+}
+
+fn visual_ranges_for_row(
+    selection: &VisualSelection,
+    lines: &[String],
+    row: usize,
+) -> Vec<(usize, usize)> {
+    if lines.is_empty() {
+        return Vec::new();
+    }
+
+    let (start, end) = normalized_visual_positions(selection, lines);
+    if row < start.row || row > end.row {
+        return Vec::new();
+    }
+
+    let line_len = lines[row].chars().count();
+    match selection.kind {
+        VisualKind::Line => vec![(0, line_len)],
+        VisualKind::Block => {
+            let start_column = start.column.min(end.column).min(line_len);
+            let end_column = start.column.max(end.column).saturating_add(1).min(line_len);
+            vec![(start_column, end_column)]
+        }
+        VisualKind::Character if start.row == end.row => {
+            vec![(
+                start.column.min(line_len),
+                end.column.saturating_add(1).min(line_len),
+            )]
+        }
+        VisualKind::Character if row == start.row => vec![(start.column.min(line_len), line_len)],
+        VisualKind::Character if row == end.row => {
+            vec![(0, end.column.saturating_add(1).min(line_len))]
+        }
+        VisualKind::Character => vec![(0, line_len)],
+    }
+}
+
+fn selected_visual_text(
+    selection: &VisualSelection,
+    lines: &[String],
+    force_linewise: bool,
+) -> String {
+    if lines.is_empty() {
+        return String::new();
+    }
+
+    let (start, end) = normalized_visual_positions(selection, lines);
+    if force_linewise || selection.kind == VisualKind::Line {
+        return lines[start.row..=end.row].join("\n");
+    }
+
+    match selection.kind {
+        VisualKind::Block => {
+            let start_column = start.column.min(end.column);
+            let end_column = start.column.max(end.column).saturating_add(1);
+            (start.row..=end.row)
+                .map(|row| char_range(&lines[row], start_column, end_column))
+                .collect::<Vec<_>>()
+                .join("\n")
+        }
+        VisualKind::Character if start.row == end.row => char_range(
+            &lines[start.row],
+            start.column,
+            end.column.saturating_add(1),
+        ),
+        VisualKind::Character => {
+            let mut selected = Vec::new();
+            selected.push(char_range(
+                &lines[start.row],
+                start.column,
+                lines[start.row].chars().count(),
+            ));
+            for line in &lines[start.row + 1..end.row] {
+                selected.push(line.clone());
+            }
+            selected.push(char_range(&lines[end.row], 0, end.column.saturating_add(1)));
+            selected.join("\n")
+        }
+        VisualKind::Line => lines[start.row..=end.row].join("\n"),
+    }
+}
+
+fn normalized_visual_positions(
+    selection: &VisualSelection,
+    lines: &[String],
+) -> (VisualPosition, VisualPosition) {
+    let anchor = clamp_visual_position(selection.anchor, lines);
+    let cursor = clamp_visual_position(selection.cursor, lines);
+    if anchor.row < cursor.row || (anchor.row == cursor.row && anchor.column <= cursor.column) {
+        (anchor, cursor)
+    } else {
+        (cursor, anchor)
+    }
+}
+
+fn clamp_visual_position(position: VisualPosition, lines: &[String]) -> VisualPosition {
+    let row = position.row.min(lines.len().saturating_sub(1));
+    let line_len = lines.get(row).map(|line| line.chars().count()).unwrap_or(0);
+    let column = position.column.min(line_len.saturating_sub(1));
+    VisualPosition { row, column }
+}
+
+fn move_index(current: usize, delta: isize, max: usize) -> usize {
+    if delta.is_negative() {
+        current.saturating_sub(delta.unsigned_abs()).min(max)
+    } else {
+        current.saturating_add(delta as usize).min(max)
+    }
+}
+
+fn char_range(line: &str, start: usize, end: usize) -> String {
+    line.chars()
+        .skip(start)
+        .take(end.saturating_sub(start))
+        .collect()
+}
+
+fn osc52_copy_sequence(text: &str) -> String {
+    format!("\u{1b}]52;c;{}\u{7}", base64_encode(text.as_bytes()))
+}
+
+fn base64_encode(input: &[u8]) -> String {
+    const TABLE: &[u8; 64] = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    let mut output = String::new();
+    for chunk in input.chunks(3) {
+        let first = chunk[0];
+        let second = chunk.get(1).copied().unwrap_or(0);
+        let third = chunk.get(2).copied().unwrap_or(0);
+        output.push(TABLE[(first >> 2) as usize] as char);
+        output.push(TABLE[(((first & 0b0000_0011) << 4) | (second >> 4)) as usize] as char);
+        if chunk.len() > 1 {
+            output.push(TABLE[(((second & 0b0000_1111) << 2) | (third >> 6)) as usize] as char);
+        } else {
+            output.push('=');
+        }
+        if chunk.len() > 2 {
+            output.push(TABLE[(third & 0b0011_1111) as usize] as char);
+        } else {
+            output.push('=');
+        }
+    }
+    output
+}
