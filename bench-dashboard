  <script>
    const body = document.getElementById('bench-body');
    const comparisonBody = document.getElementById('comparison-body');
    const oldBody = document.getElementById('old-bench-body');
    const filter = document.getElementById('filter');
    const summary = document.getElementById('summary');
    const modeFilters = document.getElementById('mode-filters');
    const latestReference = document.getElementById('latest-reference');
    const baselineNotes = document.getElementById('baseline-notes');
    const comparisonSummary = document.getElementById('comparison-summary');
    const baselineMetrics = document.getElementById('baseline-metrics');
    const thresholds = document.getElementById('thresholds');
    const baselineCount = document.getElementById('baseline-count');
    const comparisonCount = document.getElementById('comparison-count');
    const oldCount = document.getElementById('old-count');
    const home = document.getElementById('home');
    const report = document.getElementById('report');
    const reportTitle = document.getElementById('report-title');
    const reportContent = document.getElementById('report-content');
    const back = document.getElementById('back');
    let records = [];
    let comparisonRecords = [];
    let oldRecords = [];
    let activeMode = 'All';

    function escapeHtml(value) {
      return String(value ?? '').replace(/[&<>"']/g, char => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;'
      }[char]));
    }

    function number(value) {
      if (value === null || value === undefined || Number(value) === 0) return value === 0 ? '0' : '-';
      return Number(value).toLocaleString();
    }

    function duration(seconds) {
      if (seconds === null || seconds === undefined) return '-';
      seconds = Number(seconds);
      const h = Math.floor(seconds / 3600);
      const m = Math.floor((seconds % 3600) / 60);
      const s = seconds % 60;
      if (h > 0) return `${h}h ${String(m).padStart(2, '0')}m ${String(s).padStart(2, '0')}s`;
      return `${m}m ${String(s).padStart(2, '0')}s`;
    }

    function lineDelta(record) {
      const added = record.changed_lines_added;
      const deleted = record.changed_lines_deleted;
      if (added === null || added === undefined || deleted === null || deleted === undefined) return '-';
      return `+${number(added)}/-${number(deleted)}`;
    }

    function statusClass(value) {
      const normalized = String(value || '').toLowerCase();
      if (normalized === 'pass' || normalized === 'yes') return 'pass';
      if (normalized === 'fail' || normalized === 'no') return 'fail';
      return 'unknown';
    }

    function modelStatusClass(value) {
      const normalized = String(value || '').toLowerCase();
      if (normalized === 'fit' || normalized === 'training') return 'pass';
      if (normalized === 'watch' || normalized === 'unavailable') return 'unknown';
      if (normalized === 'anomaly' || normalized === 'reliability') return 'fail';
      return 'unknown';
    }

    function modelDistance(record) {
      const delta = record.token_model_delta_tokens;
      if (delta === null || delta === undefined) return '-';
      const sign = Number(delta) >= 0 ? '+' : '';
      const z = record.token_model_z === null || record.token_model_z === undefined ? '-' : `${Number(record.token_model_z).toFixed(2)}`;
      const percentile = record.token_model_percentile === null || record.token_model_percentile === undefined ? '-' : `${Number(record.token_model_percentile).toFixed(1)}%`;
      return `${sign}${number(delta)} / z ${z} / p ${percentile}`;
    }

    function searchable(record) {
      return [
        record.kind, record.run_id, record.result, record.agent_model, record.agent_reasoning_effort, record.agent_transport,
        record.codex_cli_version, record.codex_cli_path,
        record.benched_binary_commit, record.benched_binary_dirty, record.operator_notes,
        record.report_file, record.baseline_status, record.baseline_reason,
        record.token_model_status, record.token_model_reason, record.token_model_rerun
      ].join(' ').toLowerCase();
    }

    function modeCounts() {
      const all = [...comparisonRecords, ...records, ...oldRecords];
      const counts = { All: all.length, 'Work Leaf': 0, Parallel: 0, Sequential: 0, Worktree: 0 };
      for (const record of all) counts[record.kind] = (counts[record.kind] || 0) + 1;
      return counts;
    }

    function renderModeFilters() {
      const counts = modeCounts();
      const order = ['All', 'Work Leaf', 'Parallel', 'Sequential', 'Worktree'];
      modeFilters.innerHTML = '';
      for (const mode of order) {
        if (mode !== 'All' && !counts[mode]) continue;
        const button = document.createElement('button');
        button.type = 'button';
        button.className = `mode-filter${activeMode === mode ? ' active' : ''}`;
        button.textContent = `${mode} (${counts[mode] || 0})`;
        button.addEventListener('click', () => {
          activeMode = mode;
          renderModeFilters();
          renderRows();
        });
        modeFilters.appendChild(button);
      }
    }

    function visibleRows(source) {
      const query = filter.value.trim().toLowerCase();
      return source.filter(record => {
        const modeMatches = activeMode === 'All' || record.kind === activeMode;
        return modeMatches && (!query || searchable(record).includes(query));
      });
    }

    function renderTableRows(targetBody, visible, emptyText) {
      if (visible.length === 0) {
        targetBody.innerHTML = `<tr><td colspan="22">${emptyText}</td></tr>`;
        return;
      }
      targetBody.innerHTML = '';
      for (const record of visible) {
        const tr = document.createElement('tr');
        tr.title = 'Open saved benchmark report';
        tr.innerHTML = `
          <td><span class="badge">${escapeHtml(record.kind)}</span></td>
          <td><code>${escapeHtml(record.run_id)}</code></td>
          <td><span class="${statusClass(record.result)}">${record.result}</span></td>
          <td><span class="${modelStatusClass(record.token_model_status)}" title="${escapeHtml(record.token_model_reason)}">${escapeHtml(record.token_model_label || record.token_model_status || '-')}</span></td>
          <td class="num">${modelDistance(record)}</td>
          <td>${escapeHtml(record.token_model_rerun || '-')}</td>
          <td class="num">${duration(record.duration_seconds)}</td>
          <td class="num">${number(record.input_tokens)}</td>
          <td class="num">${number(record.uncached_input_tokens)}</td>
          <td class="num">${number(record.output_tokens)}</td>
          <td class="num">${number(record.reasoning_output_tokens)}</td>
          <td><span class="${statusClass(record.review_completed)}">${record.review_completed}</span></td>
          <td><span class="${statusClass(record.linearize_completed)}">${record.linearize_completed}</span></td>
          <td class="num">${number(record.commits_after_base)}</td>
          <td class="num">${number(record.changed_files)}</td>
          <td class="num">${lineDelta(record)}</td>
          <td>${escapeHtml(record.final_checks)}</td>
          <td>${escapeHtml(record.codex_cli_version)}</td>
          <td>${escapeHtml(record.agent_model)}</td>
          <td>${escapeHtml(record.agent_reasoning_effort)}</td>
          <td>${escapeHtml(record.agent_transport)}</td>
          <td>${escapeHtml(record.benched_binary_dirty)}</td>
        `;
        tr.addEventListener('click', () => openReport(record.report_file));
        targetBody.appendChild(tr);
      }
    }

    function renderRows() {
      const counts = modeCounts();
      const comparisonVisible = visibleRows(comparisonRecords);
      const visible = visibleRows(records);
      const oldVisible = visibleRows(oldRecords);
      summary.textContent = `${comparisonVisible.length} of ${comparisonRecords.length} comparisons; ${visible.length} of ${records.length} baseline reports; ${oldVisible.length} of ${oldRecords.length} old/invalid reports; Work Leaf ${counts['Work Leaf'] || 0}, Parallel ${counts.Parallel || 0}, Sequential ${counts.Sequential || 0}, Worktree ${counts.Worktree || 0}`;
      comparisonCount.textContent = `${comparisonVisible.length} shown`;
      baselineCount.textContent = `${visible.length} shown`;
      oldCount.textContent = `${oldVisible.length} shown`;
      renderTableRows(comparisonBody, comparisonVisible, 'No model comparison bench reports match the filter.');
      renderTableRows(body, visible, 'No baseline bench reports match the filter.');
      renderTableRows(oldBody, oldVisible, 'No old or invalid bench reports match the filter.');
    }

    function renderBaselineSummary(manifest, baselineSummary) {
      const configured = manifest && manifest.configured;
      const manifestName = manifest && manifest.name ? manifest.name : 'regression baseline';
      baselineNotes.textContent = configured
        ? `${manifestName}: ${manifest.reports.length} report paths listed. ${manifest.notes || ''}`.trim()
        : 'No baseline manifest is configured; all discovered reports are treated as baseline rows.';
      if (!baselineSummary || !baselineSummary.count) {
        baselineMetrics.innerHTML = '<div class="metric"><span class="metric-label">Baseline runs</span><span class="metric-value">0</span></div>';
        thresholds.innerHTML = '<li>No passing baseline reports with token usage are available.</li>';
        return;
      }
      baselineMetrics.innerHTML = `
        <div class="metric"><span class="metric-label">Runs</span><span class="metric-value">${number(baselineSummary.count)}</span></div>
        <div class="metric"><span class="metric-label">Mean input+output</span><span class="metric-value">${number(baselineSummary.input_output_mean)}</span></div>
        <div class="metric"><span class="metric-label">Stddev</span><span class="metric-value">${number(baselineSummary.input_output_stddev)}</span></div>
        <div class="metric"><span class="metric-label">CV</span><span class="metric-value">${baselineSummary.coefficient_of_variation_percent}%</span></div>
        <div class="metric"><span class="metric-label">Central 95%</span><span class="metric-value">${number(baselineSummary.central95_low)}-${number(baselineSummary.central95_high)}</span></div>
        <div class="metric"><span class="metric-label">Min</span><span class="metric-value">${number(baselineSummary.input_output_min)}</span></div>
        <div class="metric"><span class="metric-label">Max</span><span class="metric-value">${number(baselineSummary.input_output_max)}</span></div>
      `;
      thresholds.innerHTML = '';
      for (const threshold of baselineSummary.regression_thresholds || []) {
        const item = document.createElement('li');
        item.textContent = `${threshold.runs} runs are needed to see roughly a ${threshold.detectable_percent}% regression, about +${number(threshold.detectable_tokens)} input+output tokens, with this baseline variance.`;
        thresholds.appendChild(item);
      }
    }

    async function openReport(reportFile) {
      history.pushState({ reportFile }, '', `#report=${encodeURIComponent(reportFile)}`);
      await showReport(reportFile);
    }

    async function showReport(reportFile) {
      home.classList.add('hidden');
      report.style.display = 'block';
      reportTitle.textContent = reportFile;
      reportContent.textContent = 'Loading report...';
      const response = await fetch(`/api/report/${encodeURIComponent(reportFile)}`);
      if (!response.ok) {
        reportContent.textContent = `Failed to load ${reportFile}: HTTP ${response.status}`;
        return;
      }
      reportContent.textContent = await response.text();
    }

    function showHome() {
      history.pushState({}, '', location.pathname);
      report.style.display = 'none';
      home.classList.remove('hidden');
    }

    back.addEventListener('click', showHome);
    filter.addEventListener('input', renderRows);
    window.addEventListener('popstate', () => route());

    function route() {
      const match = location.hash.match(/^#report=(.+)$/);
      if (match) {
        showReport(decodeURIComponent(match[1]));
      } else {
        report.style.display = 'none';
        home.classList.remove('hidden');
      }
    }

    async function load() {
      const response = await fetch('/api/benches');
      const payload = await response.json();
      records = payload.records || [];
      comparisonRecords = payload.comparison_records || [];
      oldRecords = payload.old_invalid_records || [];
      latestReference.textContent = payload.latest_reference || 'no benchmark report found';
      const comparisons = payload.comparison_summary || {};
      comparisonSummary.textContent = `${comparisons.successful_count || 0} successful comparison runs, ${comparisons.failed_count || 0} failed/stalled comparison runs; ${comparisons.fit_count || 0} fit, ${comparisons.watch_count || 0} watch, ${comparisons.anomaly_count || 0} anomaly.`;
      renderBaselineSummary(payload.baseline_manifest || {}, payload.baseline_summary || {});
      renderModeFilters();
      renderRows();
      route();
    }

    load().catch(error => {
      comparisonBody.innerHTML = `<tr><td colspan="22">Failed to load bench reports: ${error}</td></tr>`;
      body.innerHTML = `<tr><td colspan="22">Failed to load bench reports: ${error}</td></tr>`;
      oldBody.innerHTML = `<tr><td colspan="22">Failed to load bench reports: ${error}</td></tr>`;
      latestReference.textContent = 'bench reports failed to load';
    });
  </script>
</body>
</html>
"""


class BenchDashboardHandler(BaseHTTPRequestHandler):
    results_dir: Path = DEFAULT_RESULTS_DIR

    def log_message(self, format_: str, *args: Any) -> None:
        sys.stderr.write("%s - - [%s] %s\n" % (self.address_string(), self.log_date_time_string(), format_ % args))

    def send_body(self, status: int, content_type: str, body: bytes) -> None:
        self.send_response(status)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self) -> None:
        path = self.path.split("?", 1)[0]
        if path in ("/", "/index.html"):
            self.send_body(200, "text/html; charset=utf-8", render_index_html().encode("utf-8"))
            return
        if path == "/api/benches":
            all_records = collect_bench_records(self.results_dir)
            manifest = load_baseline_manifest(self.results_dir)
            baseline_records, comparison_records, old_invalid_records = split_benchmark_records(all_records, manifest)
            summary = baseline_summary(baseline_records)
            annotate_token_model(baseline_records, summary, "training")
            annotate_token_model(comparison_records, summary, "comparison")
            annotate_token_model(old_invalid_records, summary, "old-invalid")
            payload = {
                "results_dir": str(self.results_dir),
                "latest_reference": latest_reference(comparison_records or baseline_records or all_records),
                "baseline_manifest": baseline_manifest_payload(manifest),
                "baseline_summary": summary,
                "comparison_summary": comparison_summary(comparison_records),
                "records": baseline_records,
                "comparison_records": comparison_records,
                "old_invalid_records": old_invalid_records,
                "all_records": all_records,
            }
            self.send_body(200, "application/json; charset=utf-8", json_bytes(payload))
            return
        if path.startswith("/api/report/"):
            report_name = path.removeprefix("/api/report/")
            try:
                body = read_report(self.results_dir, report_name).encode("utf-8")
            except FileNotFoundError:
                self.send_body(404, "text/plain; charset=utf-8", b"report not found\n")
                return
            self.send_body(200, "text/plain; charset=utf-8", body)
            return
        self.send_body(404, "text/plain; charset=utf-8", b"not found\n")


def serve(host: str, port: int, results_dir: Path) -> None:
    handler = type("ConfiguredBenchDashboardHandler", (BenchDashboardHandler,), {"results_dir": results_dir.resolve()})
    server = ThreadingHTTPServer((host, port), handler)
    bound_host, bound_port = server.server_address[:2]
    print(f"Serving Work Leaf bench dashboard at http://{bound_host}:{bound_port}", flush=True)
    print(f"Reading bench reports from {results_dir.resolve()}", flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nStopped bench dashboard.")
    finally:
        server.server_close()


def write(path: Path, text: str) -> None:
    path.write_text(text, encoding="utf-8")


