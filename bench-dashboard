BASELINE_MANIFEST_NAME = "baseline-manifest.json"
TOKEN_RE = re.compile(r"(cached_input|reasoning_output|input|output)=(\d+)")
META_RE = re.compile(r"^- ([A-Za-z0-9_]+):\s*(.*)$")
REGRESSION_RUN_COUNTS = (1, 3, 6, 9)


def parse_json_stream(text: str) -> list[dict[str, Any]]:
    decoder = json.JSONDecoder()
    records: list[dict[str, Any]] = []
    index = 0
    while index < len(text):
        while index < len(text) and text[index].isspace():
            index += 1
        if index >= len(text):
            break
        try:
            value, end = decoder.raw_decode(text, index)
        except json.JSONDecodeError:
            next_start = text.find("{", index + 1)
            if next_start == -1:
                break
            index = next_start
            continue
        if isinstance(value, dict):
            records.append(value)
        index = end
    return records


def parse_markdown_metadata(text: str) -> dict[str, str]:
    fields: dict[str, str] = {}
    for line in text.splitlines():
        match = META_RE.match(line)
        if match:
            fields[match.group(1)] = match.group(2).strip()
    return fields


def parse_token_totals(token_usage: str | None) -> dict[str, int]:
    totals = {
        "input": 0,
        "cached_input": 0,
        "uncached_input": 0,
        "output": 0,
        "reasoning_output": 0,
    }
    if not token_usage:
        return totals
    for key, value in TOKEN_RE.findall(token_usage):
        totals[key] += int(value)
    totals["uncached_input"] = max(0, totals["input"] - totals["cached_input"])
    return totals


def int_or_none(value: Any) -> int | None:
    if value is None:
        return None
    if isinstance(value, int):
        return value
    text = str(value).strip()
    if not text or text.lower() == "null":
        return None
    try:
        return int(text)
    except ValueError:
        return None


def value(fields: dict[str, Any], *keys: str) -> Any:
    for key in keys:
        if fields.get(key) not in (None, ""):
            return fields[key]
    return None


def classify_bench(report_name: str, fields: dict[str, Any]) -> str:
    hints = " ".join(
        str(part)
        for part in (
            report_name,
            value(fields, "bench_mode"),
            value(fields, "bench_kind"),
            value(fields, "report"),
            value(fields, "patch_artifacts"),
        )
        if part
    ).lower()
    if "parallel" in hints:
        return "Parallel"
    if "sequential" in hints:
        return "Sequential"
    if "worktree" in hints:
        return "Worktree"
    return "Work Leaf"


def safe_relative_report_name(results_dir: Path, path: Path) -> str | None:
    try:
        return path.resolve().relative_to(results_dir.resolve()).as_posix()
    except ValueError:
        return None


def load_baseline_manifest(results_dir: Path) -> dict[str, Any]:
    manifest_path = results_dir.resolve() / BASELINE_MANIFEST_NAME
    if not manifest_path.exists():
        return {
            "configured": False,
            "name": "all discovered reports",
            "notes": "",
            "reports": [],
            "report_set": set(),
        }
    try:
        data = json.loads(manifest_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        return {
            "configured": True,
            "name": "invalid baseline manifest",
            "notes": f"{BASELINE_MANIFEST_NAME} could not be read: {error}",
            "reports": [],
            "report_set": set(),
        }

    raw_reports = data.get("reports") or data.get("valid_reports") or []
    reports: list[str] = []
    for item in raw_reports:
        raw_report = item.get("report") if isinstance(item, dict) else item
        if not raw_report:
            continue
        report_name = str(raw_report).strip()
        if "\\" in report_name or not is_bench_report_name(report_name):
            continue
        relative = safe_relative_report_name(results_dir, results_dir / report_name)
        if relative and relative not in reports:
            reports.append(relative)

    return {
        "configured": True,
        "name": str(data.get("name") or "regression baseline"),
        "notes": str(data.get("notes") or ""),
        "reports": reports,
        "report_set": set(reports),
    }


def split_baseline_records(
    records: list[dict[str, Any]],
    manifest: dict[str, Any],
) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:
    baseline: list[dict[str, Any]] = []
    old_invalid: list[dict[str, Any]] = []
    configured = bool(manifest.get("configured"))
    report_set = set(manifest.get("report_set") or [])

    for record in records:
        copy = dict(record)
        if configured:
            if copy["report_file"] in report_set:
                copy["baseline_status"] = "baseline"
                copy["baseline_reason"] = "listed in baseline manifest"
                baseline.append(copy)
            else:
                copy["baseline_status"] = "old-invalid"
                copy["baseline_reason"] = "not listed in baseline manifest"
                old_invalid.append(copy)
        else:
            copy["baseline_status"] = "baseline"
            copy["baseline_reason"] = "no baseline manifest configured"
            baseline.append(copy)

    return baseline, old_invalid


def rounded(value_: float) -> int:
    return int(value_ + 0.5)


def median(values: list[int]) -> float:
    midpoint = len(values) // 2
    if len(values) % 2:
        return float(values[midpoint])
    return (values[midpoint - 1] + values[midpoint]) / 2


def sample_stddev(values: list[int], mean: float) -> float:
    if len(values) < 2:
        return 0.0
    variance = sum((value_ - mean) ** 2 for value_ in values) / (len(values) - 1)
    return math.sqrt(variance)


def baseline_summary(records: list[dict[str, Any]]) -> dict[str, Any]:
    totals = sorted(
        int(record["input_tokens"]) + int(record["output_tokens"])
        for record in records
        if str(record.get("result")).lower() == "pass"
        and int(record.get("input_tokens") or 0) > 0
        and int(record.get("output_tokens") or 0) > 0
    )
    if not totals:
        return {
            "count": 0,
            "input_output_min": None,
            "input_output_max": None,
            "input_output_mean": None,
            "input_output_median": None,
            "input_output_stddev": None,
            "coefficient_of_variation_percent": None,
            "regression_thresholds": [],
        }

    mean = sum(totals) / len(totals)
    stddev = sample_stddev(totals, mean)
    cv_percent = (stddev / mean * 100) if mean else 0.0
    thresholds = []
    for run_count in REGRESSION_RUN_COUNTS:
        if stddev == 0 or len(totals) < 2:
            detectable = 0.0
        else:
            detectable = 2.1 * stddev * math.sqrt((1 / len(totals)) + (1 / run_count))
        thresholds.append(
            {
                "runs": run_count,
                "detectable_tokens": rounded(detectable),
                "detectable_percent": round((detectable / mean * 100) if mean else 0.0, 1),
                "upper_threshold": rounded(mean + detectable),
            }
        )

    return {
        "count": len(totals),
        "input_output_min": min(totals),
        "input_output_max": max(totals),
        "input_output_mean": rounded(mean),
        "input_output_median": rounded(median(totals)),
        "input_output_stddev": rounded(stddev),
        "coefficient_of_variation_percent": round(cv_percent, 1),
        "regression_thresholds": thresholds,
    }


def baseline_manifest_payload(manifest: dict[str, Any]) -> dict[str, Any]:
    return {
        "configured": bool(manifest.get("configured")),
        "name": manifest.get("name") or "",
        "notes": manifest.get("notes") or "",
        "reports": list(manifest.get("reports") or []),
    }


def infer_report_name(
    results_dir: Path,
    index_path: Path,
    run_id: str,
    fields: dict[str, Any],
) -> str | None:
    report = value(fields, "report")
    if report:
        report_path = Path(str(report))
        if not report_path.is_absolute():
            report_path = index_path.parent / report_path
        return safe_relative_report_name(results_dir, report_path)
    if not run_id:
        return None
    mode = str(value(fields, "bench_mode") or "").lower()
    index_name = index_path.name
    if mode == "sequential" or "sequential" in index_name:
        report_name = f"{run_id}-three-feature-sequential-bench.md"
    elif mode == "worktree" or "worktree" in index_name:
        report_name = f"{run_id}-three-feature-worktree-bench.md"
    else:
        report_name = f"{run_id}-three-feature-bench.md"
    return safe_relative_report_name(results_dir, index_path.parent / report_name)


def report_files(results_dir: Path) -> list[Path]:
    if not results_dir.exists():
        return []
    return sorted(
        path
        for path in results_dir.rglob("*.md")
        if path.is_file()
        if is_bench_report_name(path.name)
    )


def is_bench_report_name(name: str) -> bool:
    lowered = name.lower()
    if "direct-comparison" in lowered or "interim-baseline" in lowered:
        return False
    return "three-feature" in lowered and (
        "bench" in lowered or "sequential" in lowered or "worktree" in lowered
    )


def normalize_record(
    fields: dict[str, Any],
    report_name: str,
    markdown_text: str | None = None,
) -> dict[str, Any]:
    run_id = str(value(fields, "run_id") or report_name.split("-three-feature", 1)[0])
    tokens = parse_token_totals(str(value(fields, "token_usage") or ""))
    changed_added = int_or_none(value(fields, "changed_lines_added", "added_lines"))
    changed_deleted = int_or_none(value(fields, "changed_lines_deleted", "deleted_lines"))
    changed_total = int_or_none(value(fields, "changed_lines_total", "total_line_delta"))
    if changed_total is None and changed_added is not None and changed_deleted is not None:
        changed_total = changed_added + changed_deleted
    result = str(value(fields, "result") or "unknown")
    code_quality = str(value(fields, "code_quality") or "")
    final_checks = "pass" if code_quality.startswith("passed ") else ("not run" if code_quality == "not run" else code_quality or "unknown")
    kind = classify_bench(report_name, fields)

    return {
        "id": report_name,
        "report_file": report_name,
        "kind": kind,
        "run_id": run_id,
        "result": result,
        "duration_seconds": int_or_none(value(fields, "duration_seconds")),
        "input_tokens": tokens["input"],
        "cached_input_tokens": tokens["cached_input"],
        "uncached_input_tokens": tokens["uncached_input"],
        "output_tokens": tokens["output"],
        "reasoning_output_tokens": tokens["reasoning_output"],
        "review_completed": str(value(fields, "review_completed") or "unknown"),
        "linearize_completed": str(value(fields, "linearize_completed") or "unknown"),
        "commits_after_base": int_or_none(value(fields, "commits_after_base")),
        "changed_files": int_or_none(value(fields, "changed_files")),
        "changed_lines_added": changed_added,
        "changed_lines_deleted": changed_deleted,
        "changed_lines_total": changed_total,
        "final_checks": final_checks,
        "agent_model": str(value(fields, "agent_model") or "not recorded"),
        "agent_reasoning_effort": str(value(fields, "agent_reasoning_effort") or "not recorded"),
        "agent_reasoning_effort_source": str(value(fields, "agent_reasoning_effort_source") or "not recorded"),
        "agent_transport": str(value(fields, "agent_transport") or "unknown"),
        "codex_cli_path": str(value(fields, "codex_cli_path") or "unknown"),
        "codex_cli_version": str(value(fields, "codex_cli_version") or "unknown"),
        "no_read_permission": str(value(fields, "no_read_permission") or "unknown"),
        "benched_binary_commit": str(value(fields, "benched_binary_commit", "bench_driver_commit") or "unknown"),
        "benched_binary_dirty": str(value(fields, "benched_binary_dirty", "bench_driver_dirty") or "unknown"),
        "operator_notes": str(value(fields, "operator_notes", "human_operator_note") or ""),
        "markdown_preview": markdown_text.splitlines()[0] if markdown_text else "",
    }


def collect_bench_records(results_dir: Path) -> list[dict[str, Any]]:
    results_dir = results_dir.resolve()
    merged: dict[str, dict[str, Any]] = {}

    if results_dir.exists():
        for index_path in sorted(path for path in results_dir.rglob("*.jsonl") if path.is_file()):
            for fields in parse_json_stream(index_path.read_text(encoding="utf-8", errors="replace")):
                run_id = str(value(fields, "run_id") or "")
                report_name = infer_report_name(results_dir, index_path, run_id, fields)
                if not report_name or not is_bench_report_name(report_name):
                    continue
                md_path = results_dir / report_name
                md_text = md_path.read_text(encoding="utf-8", errors="replace") if md_path.exists() else None
                md_fields = parse_markdown_metadata(md_text) if md_text else {}
                combined = {**md_fields, **fields}
                merged[report_name] = normalize_record(combined, report_name, md_text)

    for md_path in report_files(results_dir):
        report_name = safe_relative_report_name(results_dir, md_path)
        if not report_name or report_name in merged:
            continue
        md_text = md_path.read_text(encoding="utf-8", errors="replace")
        fields = parse_markdown_metadata(md_text)
        merged[report_name] = normalize_record(fields, report_name, md_text)

    return sorted(
        merged.values(),
        key=lambda record: str(record.get("run_id") or record.get("report_file") or ""),
        reverse=True,
    )


def latest_reference(records: list[dict[str, Any]]) -> str:
    if not records:
        return "no benchmark report found"
    latest = records[0]
    return (
        f"{latest['run_id']} ({latest['kind']}, {latest['result']}, "
        f"model {latest['agent_model']})"
    )


def read_report(results_dir: Path, report_name: str) -> str:
    decoded = unquote(report_name)
    if "\\" in decoded:
        raise FileNotFoundError(decoded)
    if not is_bench_report_name(decoded):
        raise FileNotFoundError(decoded)
    report_path = (results_dir.resolve() / decoded).resolve()
    try:
        report_path.relative_to(results_dir.resolve())
    except ValueError as exc:
        raise FileNotFoundError(decoded) from exc
    if not report_path.exists() or not report_path.is_file():
        raise FileNotFoundError(decoded)
    return report_path.read_text(encoding="utf-8", errors="replace")


def json_bytes(value_: Any) -> bytes:
    return json.dumps(value_, indent=2, sort_keys=True).encode("utf-8")


