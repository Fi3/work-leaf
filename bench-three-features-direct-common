run_feature_cycle() {
  local feature_index="$1"
  local repo="$2"
  local label_prefix="$3"
  local feature_base="$4"
  local round review_label review_text fix_label previous_evidence_file review_result_file
  local implementation_thread_id reviewer_thread_id
  previous_evidence_file=""
  review_result_file="$tmp_root/review-results/${label_prefix}.review"
  run_direct_agent "${label_prefix}-implement" "$repo" "$patch_sandbox" "$(implementation_prompt "$feature_index")" \
    || return 1
  implementation_thread_id="$(cat "$tmp_root/runs/${label_prefix}-implement.thread_id" 2>/dev/null || true)"
  if [[ -z "$implementation_thread_id" ]]; then
    printf 'feature=%s\nresult=missing implementation thread id\n' "$feature_index" > "$review_result_file"
    return 1
  fi
  commit_if_changed \
    "$repo" \
    "ADD direct-agent baseline feature $feature_index for review" \
    "Record the direct implementation for benchmark request $feature_index so a separate reviewer can evaluate exactly that behavior." \
    || return 1
  observer_timeline patch-accepted \
    "feature=$feature_index commit=$(git -C "$repo" rev-parse HEAD)" || return 1

  reviewer_thread_id=""
  round=1
  while true; do
    if [[ "$review_rounds" != "0" && "$round" -gt "$review_rounds" ]]; then
      printf 'feature=%s\nrounds=%s\nresult=review-findings-remained\n' "$feature_index" "$review_rounds" >> "$review_result_file"
      return 1
    fi
    review_label="${label_prefix}-review-${round}"
    observer_timeline reviewer-launch "feature=$feature_index round=$round" || return 1
    if [[ -z "$reviewer_thread_id" ]]; then
      run_direct_agent "$review_label" "$repo" "$review_sandbox" "$(review_prompt "$feature_index" "$feature_base" "$previous_evidence_file")" \
        || return 1
      reviewer_thread_id="$(cat "$tmp_root/runs/${review_label}.thread_id" 2>/dev/null || true)"
      if [[ -z "$reviewer_thread_id" ]]; then
        printf 'feature=%s\nround=%s\nresult=missing reviewer thread id\n' "$feature_index" "$round" >> "$review_result_file"
        return 1
      fi
    else
      run_direct_agent_resume "$review_label" "$repo" "$review_sandbox" "$reviewer_thread_id" "$(review_prompt "$feature_index" "$feature_base" "$previous_evidence_file")" \
        || return 1
    fi
    review_text="$tmp_root/runs/${review_label}.text.txt"
    if review_is_clean "$review_text"; then
      observer_timeline review-clean "feature=$feature_index round=$round" || return 1
      printf 'feature=%s\nrounds=%s\nresult=clean\n' "$feature_index" "$round" > "$review_result_file"
      return 0
    fi
    observer_timeline review-findings "feature=$feature_index round=$round" || return 1
    fix_label="${label_prefix}-fix-${round}"
    observer_timeline review-fix-start "feature=$feature_index round=$round" || return 1
    run_direct_agent_resume "$fix_label" "$repo" "$patch_sandbox" "$implementation_thread_id" "$(fix_prompt "$feature_index" "$review_text")" \
      || return 1
    previous_evidence_file="$tmp_root/runs/${fix_label}.text.txt"
    if commit_if_changed \
      "$repo" \
      "FIX direct-agent baseline feature $feature_index after review" \
      "Address the direct reviewer findings for benchmark request $feature_index while keeping the change scoped to that reviewed feature."
    then
      printf 'feature=%s\nround=%s\nfix=%s\nresult=committed\n' "$feature_index" "$round" "$fix_label" >> "$review_result_file"
      observer_timeline review-fix-complete \
        "feature=$feature_index round=$round result=committed" || return 1
    else
      printf 'feature=%s\nround=%s\nfix=%s\nresult=no file changes after fix; carrying author response/evidence into next review\n' "$feature_index" "$round" "$fix_label" >> "$review_result_file"
      observer_timeline review-fix-complete \
        "feature=$feature_index round=$round result=no-file-changes" || return 1
    fi
    round=$((round + 1))
  done
}

run_sequential_bench() {
  local feature_index feature_base linearize_thread_id plan_head plan_status
  for feature_index in 1 2 3; do
    begin_stage_deadline "feature-$feature_index"
    feature_base="$(git -C "$checkout_dir" rev-parse HEAD)"
    log "sequential feature $feature_index starts at $feature_base"
    observer_timeline feature-start "feature=$feature_index base=$feature_base" \
      || fail_bench "failed to record observer feature timeline"
    run_feature_cycle "$feature_index" "$checkout_dir" "sequential-feature-${feature_index}" "$feature_base" \
      || fail_bench "sequential feature $feature_index did not reach a clean review"
    observer_timeline feature-cycle-complete "feature=$feature_index" \
      || fail_bench "failed to record completed feature cycle"
    observer_checkpoint "feature-$feature_index-complete" \
      || fail_bench "failed to capture completed feature checkpoint"
  done
  review_completed="yes"
  begin_stage_deadline "linearize"
  observer_checkpoint pre-linearize || fail_bench "failed to capture pre-linearize checkpoint"
  observer_timeline linearize-start "reviewed-features=3" \
    || fail_bench "failed to record linearize start"
  plan_head="$(git -C "$checkout_dir" rev-parse HEAD)"
  plan_status="$(git -C "$checkout_dir" status --porcelain)"
  run_direct_agent "linearize-plan" "$checkout_dir" "$linearize_sandbox" "$(linearize_plan_prompt_sequential)" \
    || fail_bench "sequential linearizer planning turn failed"
  if [[ "$(git -C "$checkout_dir" rev-parse HEAD)" != "$plan_head" || "$(git -C "$checkout_dir" status --porcelain)" != "$plan_status" ]]; then
    fail_bench "sequential linearizer modified the checkout before plan acceptance"
  fi
  linearize_thread_id="$(cat "$tmp_root/runs/linearize-plan.thread_id" 2>/dev/null || true)"
  [[ -n "$linearize_thread_id" ]] || fail_bench "sequential linearizer did not return a thread id"
  observer_timeline linearize-accept "reviewed-features=3" \
    || fail_bench "failed to record linearize acceptance"
  run_direct_agent_resume "linearize-accept" "$checkout_dir" "$linearize_sandbox" "$linearize_thread_id" "$(linearize_accept_prompt_sequential)" \
    || fail_bench "sequential linearizer acceptance turn failed"
  linearize_completed="yes"
}

run_final_checks() {
  local commits_after_base
  git -C "$checkout_dir" status --short > "$tmp_root/final-status.txt"
  git -C "$checkout_dir" log --oneline --max-count=30 > "$tmp_root/final-log.txt"
  if [[ -s "$tmp_root/final-status.txt" ]]; then
    code_quality="not run; final repository was dirty"
    fail_bench "linearize finished with a dirty repository"
  fi
  commits_after_base="$(git -C "$checkout_dir" rev-list --count HEAD ^"$base_commit" 2>/dev/null || printf '0')"
  if [[ "$commits_after_base" != "$sequential_final_commits" ]]; then
    code_quality="not run; workflow produced ${commits_after_base} commits instead of ${sequential_final_commits}"
    fail_bench "expected exactly ${sequential_final_commits} final commits; workflow produced ${commits_after_base}"
  fi
  if (( commits_after_base < minimum_candidate_commits )); then
    code_quality="not run; workflow produced no candidate commits"
    fail_bench "expected candidate output after the benchmark base"
  fi
  log "running final code quality checks"
  bench_run_final_gate "$checkout_dir" "$child_tmp_dir" "$tmp_root/checks.log" || {
    code_quality="failed; see checks.log"
    fail_bench "final repository checks failed"
  }
  git -C "$checkout_dir" status --short > "$tmp_root/final-status.txt"
  if [[ -s "$tmp_root/final-status.txt" ]]; then
    code_quality="failed; final gate changed the final repository"
    fail_bench "final repository changed during the final gate"
  fi
  code_quality="passed cargo fmt -- --check; cargo clippy --all-targets --all-features -- -D warnings; cargo test --all-targets --all-features"
}

if ! bench_begin_artifact_transaction \
  "$results_dir" \
  "${artifact_final_dir##*/}" \
  "${report_path##*/}" \
  "${index_path##*/}"; then
  reported=1
  report_attempted=1
  echo "error: benchmark artifact output already exists or could not be reserved" >&2
  exit 1
fi
artifact_dir="$bench_artifact_transaction_stage_fd_path"

log "WORK_LEAF_DIRECT_BENCH_TEMP=$tmp_root"
log "WORK_LEAF_DIRECT_BENCH_BASE=$base_commit"
printf 'WORK_LEAF_DIRECT_BENCH_TEMP=%s\n' "$tmp_root"
mkdir -p "$child_tmp_dir" "$tmp_root/runs" "$tmp_root/review-results"

git -C "$repo_root" clone --no-checkout --no-hardlinks "$repo_root" "$checkout_dir" >/dev/null
git -C "$checkout_dir" checkout --detach "$base_commit" >/dev/null
git -C "$checkout_dir" config user.email bench@example.com
git -C "$checkout_dir" config user.name "Work Leaf Bench"

if [[ "$dry_run" == "1" ]]; then
  result="skipped"
  code_quality="not run"
  git -C "$checkout_dir" status --short > "$tmp_root/final-status.txt" 2>/dev/null || true
  git -C "$checkout_dir" log --oneline --max-count=30 > "$tmp_root/final-log.txt" 2>/dev/null || true
  write_report "dry run created and removed the isolated direct-agent $mode checkout without launching agents"
  exit 0
fi

if [[ "${WORK_LEAF_DIRECT_BENCH_SKIP_BUILD:-${WORK_LEAF_CODEX_BENCH_SKIP_BUILD:-0}}" != "1" ]]; then
  (cd "$repo_root" && cargo build --release --bins)
fi
if [[ -z "${WORK_LEAF_BENCH_OBSERVER_BIN+x}" ]]; then
  cargo build --manifest-path "$repo_root/bench-observer/Cargo.toml" --release --bin bench-observer
fi

agent_bin="$(command -v "$agent_backend" 2>/dev/null || true)"
[[ -n "$agent_bin" ]] || fail_bench "$agent_backend binary not found on PATH"
{
  printf 'agent_bin=%s\n' "$agent_bin"
  "$agent_bin" --version 2>&1 || true
} > "$tmp_root/agent-version.txt"
env | redact_sensitive_env > "$tmp_root/driver-env.txt"
detect_agent_profile
bench_install_no_recursive_agent_policy "$checkout_dir" "$tmp_root/agent-policy" \
  || fail_bench "failed to install benchmark provider-isolation policy"
prepare_bench_codex_profile || fail_bench "failed to prepare explicit Codex model/reasoning profile"
setup_observer || fail_bench "failed to start required benchmark observer"
observer_checkpoint base || fail_bench "failed to capture observer base checkpoint"

run_sequential_bench

bench_restore_no_recursive_agent_policy "$checkout_dir" "$tmp_root/agent-policy" \
  || fail_bench "failed to restore benchmark repository instructions"
bench_assert_no_recursive_codex "$bench_recursive_codex_log" \
  || fail_bench "a benchmarked agent attempted recursive provider verification"
run_final_checks
completed_active_seconds="$(monotonic_seconds)"
observer_timeline final-checks-complete "status=pass" || fail_bench "failed to record final checks"
observer_checkpoint final || fail_bench "failed to capture final checkpoint"
stage_candidate_binary || fail_bench "final candidate release build failed"
result="pass"
git -C "$checkout_dir" status --short > "$tmp_root/final-status.txt" 2>/dev/null || true
git -C "$checkout_dir" log --oneline --max-count=30 > "$tmp_root/final-log.txt" 2>/dev/null || true
finish_observation 0
write_report "direct $agent_backend $mode benchmark completed review, linearize, and final checks"
exit 0
