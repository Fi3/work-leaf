extract_text_from_jsonl() {
  local jsonl="$1"
  local out="$2"
  python3 - "$jsonl" > "$out" <<'PY'
import json
import sys

text_keys = {"text", "message", "content", "response", "reply", "delta", "summary"}
parts = []

def walk(value, parent_key=""):
    if isinstance(value, dict):
        for key, child in value.items():
            walk(child, key)
    elif isinstance(value, list):
        for child in value:
            walk(child, parent_key)
    elif isinstance(value, str) and parent_key in text_keys:
        parts.append(value)

with open(sys.argv[1], "r", encoding="utf-8", errors="replace") as handle:
    for line in handle:
        line = line.strip()
        if not line:
            continue
        try:
            walk(json.loads(line))
        except json.JSONDecodeError:
            continue

print("\n".join(parts))
PY
}

extract_thread_id() {
  local jsonl="$1"
  python3 - "$jsonl" <<'PY'
import json
import sys

with open(sys.argv[1], "r", encoding="utf-8", errors="replace") as handle:
    for line in handle:
        line = line.strip()
        if not line:
            continue
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue
        session_id = event.get("thread_id") or event.get("session_id")
        if isinstance(session_id, str) and session_id:
            print(session_id)
            sys.exit(0)
sys.exit(1)
PY
}

run_direct_agent() {
  local label="$1"
  local cwd="$2"
  local sandbox="$3"
  local prompt="$4"
  local run_dir jsonl stderr_file prompt_file text_file status_file
  run_dir="$tmp_root/runs"
  mkdir -p "$run_dir"
  jsonl="$run_dir/${label}.jsonl"
  stderr_file="$run_dir/${label}.stderr"
  prompt_file="$run_dir/${label}.prompt.txt"
  text_file="$run_dir/${label}.text.txt"
  status_file="$run_dir/${label}.status"
  printf '%s\n' "$prompt" > "$prompt_file"
  log "$agent_backend $label in $cwd"

  local args=(--cd "$cwd" --sandbox "$sandbox" --ask-for-approval never)
  if [[ "$bench_model" != "default" ]]; then
    args+=(--model "$bench_model")
  fi
  args+=(exec --color never --json -)
  local now remaining
  now="$(monotonic_seconds)"
  remaining=$((deadline - now))
  if (( remaining <= 0 )); then
    printf 'timed out before starting %s\n' "$label" > "$stderr_file"
    printf '124\n' > "$status_file"
    return 124
  fi
  set +e
  if command -v timeout >/dev/null 2>&1; then
    (
      cd "$cwd"
      timeout --foreground "${remaining}s" env WORK_LEAF_OBSERVER_ROLE="$label" WORK_LEAF_OBSERVER_PRIMARY_MARKER="$observer_primary_marker" \
        "$agent_bin" "${args[@]}" < "$prompt_file" > "$jsonl" 2> "$stderr_file"
    )
  else
    (
      cd "$cwd"
      env WORK_LEAF_OBSERVER_ROLE="$label" WORK_LEAF_OBSERVER_PRIMARY_MARKER="$observer_primary_marker" \
        "$agent_bin" "${args[@]}" < "$prompt_file" > "$jsonl" 2> "$stderr_file"
    )
  fi
  local status=$?
  set -e
  printf '%s\n' "$status" > "$status_file"
  extract_text_from_jsonl "$jsonl" "$text_file" || true
  extract_thread_id "$jsonl" > "$run_dir/${label}.thread_id" 2>/dev/null || true
  return "$status"
}

