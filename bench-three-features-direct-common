#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage:
  bench-three-features-sequential [--dry-run]

Run the direct sequential Codex baseline against the historical Work Leaf base
commit. The sequential mode asks one normal agent session to implement each
request, commits it, asks a separate normal agent review session to review it,
loops on fixes until clean, and then asks one final agent session to linearize
the resulting history.

Environment:
  WORK_LEAF_DIRECT_BENCH_MODEL         optional model passed to the selected CLI
  WORK_LEAF_DIRECT_BENCH_REASONING_EFFORT optional Codex reasoning level
  WORK_LEAF_DIRECT_BENCH_TMPDIR        parent directory for temporary roots
  WORK_LEAF_DIRECT_BENCH_RESULTS_DIR   report directory, default bench-results
  WORK_LEAF_DIRECT_BENCH_SKIP_BUILD    set to 1 to skip the pre-benchmark runner build
  WORK_LEAF_DIRECT_BENCH_BIN_DIR       directory containing Work Leaf runner binaries
  WORK_LEAF_DIRECT_BENCH_TIMEOUT_SECS  timeout for each feature and linearize stage, default 7200 each
  WORK_LEAF_DIRECT_BENCH_REVIEW_ROUNDS max review/fix rounds per feature, default 0 to use only the global timeout
  WORK_LEAF_CODEX_BENCH_MODEL         legacy alias for WORK_LEAF_DIRECT_BENCH_MODEL
  WORK_LEAF_DIRECT_BENCH_SANDBOX       Codex implementation/fix sandbox, default workspace-write
  WORK_LEAF_DIRECT_BENCH_LINEARIZE_SANDBOX Codex linearize sandbox, default danger-full-access
  WORK_LEAF_DIRECT_BENCH_OPERATOR_NOTES optional human notes saved in the report
  WORK_LEAF_BENCH_OBSERVER_BIN             bench-observer executable; defaults to bench-observer/target/release/bench-observer
  WORK_LEAF_BENCH_STUDY_ID                 observer study identity, default efficiency-causal-study
  WORK_LEAF_BENCH_PAIR_ID                  observer pair identity, default unpaired-<run-id>
  WORK_LEAF_CODEX_BENCH_*              legacy aliases remain accepted
USAGE
}

mode="${1:-}"
if [[ "$mode" != "sequential" ]]; then
  usage >&2
  exit 2
fi
shift
readonly feature_schedule="sequential"

dry_run=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run)
      dry_run=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "unknown direct-agent bench option: $1" >&2
      exit 2
      ;;
  esac
done

monotonic_seconds() {
  python3 -c 'import time; print(int(time.monotonic()))'
}

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$repo_root/bench-candidate-common"
source "$repo_root/bench-validation-common"
source "$repo_root/bench-agent-profile-common"
agent_backend="${WORK_LEAF_DIRECT_BENCH_AGENT:-codex}"
if [[ "$agent_backend" != "codex" ]]; then
  echo "the direct sequential benchmark requires WORK_LEAF_DIRECT_BENCH_AGENT=codex" >&2
  exit 2
fi
readonly base_commit="c92a0b7060a36eac6db2d869b85e589a7a9480f9"
readonly candidate_schema="$bench_candidate_schema"
readonly minimum_candidate_commits=1
readonly sequential_final_commits=3
if [[ -n "${WORK_LEAF_DIRECT_BENCH_BASE+x}" || -n "${WORK_LEAF_CODEX_BENCH_BASE+x}" ]]; then
  echo "direct benchmark base overrides are not supported; the fixed base is $base_commit" >&2
  exit 2
fi
tmp_parent="${WORK_LEAF_DIRECT_BENCH_TMPDIR:-${WORK_LEAF_CODEX_BENCH_TMPDIR:-${TMPDIR:-/tmp}}}"
results_dir="${WORK_LEAF_DIRECT_BENCH_RESULTS_DIR:-${WORK_LEAF_CODEX_BENCH_RESULTS_DIR:-$repo_root/bench-results}}"
timeout_secs="${WORK_LEAF_DIRECT_BENCH_TIMEOUT_SECS:-${WORK_LEAF_CODEX_BENCH_TIMEOUT_SECS:-7200}}"
review_rounds="${WORK_LEAF_DIRECT_BENCH_REVIEW_ROUNDS:-${WORK_LEAF_CODEX_BENCH_REVIEW_ROUNDS:-0}}"
patch_sandbox="${WORK_LEAF_DIRECT_BENCH_SANDBOX:-${WORK_LEAF_CODEX_BENCH_SANDBOX:-workspace-write}}"
review_sandbox="${WORK_LEAF_DIRECT_BENCH_REVIEW_SANDBOX:-${WORK_LEAF_CODEX_BENCH_REVIEW_SANDBOX:-read-only}}"
linearize_sandbox="${WORK_LEAF_DIRECT_BENCH_LINEARIZE_SANDBOX:-${WORK_LEAF_CODEX_BENCH_LINEARIZE_SANDBOX:-danger-full-access}}"
requested_bench_model="${WORK_LEAF_DIRECT_BENCH_MODEL:-${WORK_LEAF_CODEX_BENCH_MODEL:-${WORK_LEAF_BENCH_MODEL:-default}}}"
bench_model="$requested_bench_model"
bench_model_source="requested"
requested_reasoning_effort="${WORK_LEAF_DIRECT_BENCH_REASONING_EFFORT:-${WORK_LEAF_BENCH_REASONING_EFFORT:-default}}"
agent_reasoning_effort="$requested_reasoning_effort"
agent_reasoning_effort_source="requested"
bench_actual_codex_bin=""
bench_profiled_codex_bin=""
bench_actual_codex_sha256=""
bench_profiled_codex_sha256=""
bin_dir="${WORK_LEAF_DIRECT_BENCH_BIN_DIR:-${WORK_LEAF_CODEX_BENCH_BIN_DIR:-$repo_root/target/release}}"
candidate_cargo_bin="$(command -v cargo 2>/dev/null || true)"
run_id="${WORK_LEAF_DIRECT_BENCH_RUN_ID:-${WORK_LEAF_CODEX_BENCH_RUN_ID:-$(date +%Y%m%dT%H%M%S%z)}}"
observer_study_id="${WORK_LEAF_BENCH_STUDY_ID:-efficiency-causal-study}"
observer_pair_id="${WORK_LEAF_BENCH_PAIR_ID:-unpaired-$run_id}"
operator_notes="${WORK_LEAF_DIRECT_BENCH_OPERATOR_NOTES:-${WORK_LEAF_CODEX_BENCH_OPERATOR_NOTES:-}}"
if ! [[ "$review_rounds" =~ ^[0-9]+$ ]]; then
  echo "WORK_LEAF_DIRECT_BENCH_REVIEW_ROUNDS must be a non-negative integer" >&2
  exit 2
fi
case "$requested_reasoning_effort" in
  default|low|medium|high|xhigh|max) ;;
  *)
    echo "WORK_LEAF_DIRECT_BENCH_REASONING_EFFORT must be low, medium, high, xhigh, max, or default" >&2
    exit 2
    ;;
esac
bench_name="three-feature-sequential-bench"
index_path_name="three-feature-sequential-bench.jsonl"

mkdir -p "$tmp_parent" "$results_dir"
results_dir="$(cd "$results_dir" && pwd)"
tmp_root="$(mktemp -d "$tmp_parent/work-leaf-3feature-${mode}-bench.XXXXXX")"
checkout_dir="$tmp_root/repo"
child_tmp_dir="$tmp_root/tmp"
artifact_dir="$results_dir/${run_id}-${bench_name}-artifacts"
report_path="$results_dir/${run_id}-${bench_name}.md"
index_path="$results_dir/$index_path_name"
artifact_final_dir="$artifact_dir"
human_report_name=".human-report.md"
start_epoch="$(date +%s)"
start_active_seconds="$(monotonic_seconds)"
result="fail"
review_completed="no"
linearize_completed="no"
code_quality="not run"
token_usage="unavailable"
measurement_status="not-started"
measurement_reason="observer was not initialized"
total_workflow_input_tokens=0
total_workflow_cached_input_tokens=0
total_workflow_uncached_input_tokens=0
total_workflow_output_tokens=0
total_workflow_reasoning_output_tokens=0
total_workflow_raw_tokens=0
total_workflow_uncached_tokens=0
failure_reason=""
reported=0
report_attempted=0
completed_active_seconds=""
deadline=0
current_stage="not-started"
agent_bin=""
observer_bin="${WORK_LEAF_BENCH_OBSERVER_BIN:-$repo_root/bench-observer/target/release/bench-observer}"
observer_config=""
observer_root=""
observer_proxy_dir=""
observer_primary_marker=""
observer_enabled=0
observer_finalized=0
agent_transport="direct-${agent_backend}-cli"
agent_conversation_mode="persistent-${agent_backend}-resume-sessions"

feature_1='add vim like visual mode for both panes when I do v I can select the text in focused the panes same keystrokes of vim y Y for copy maiusc V line select block select with ctrl v block select'
feature_2='when an user prompt start with / and is followed by something without whitespace that is a command for the agent; the orchestrator must send it to the selected backend agent and show that backend response'
feature_3='when review process is done the patch agent chat must be highlighted and ask is this feature done with yes/no; yes closes it, typing again reopens it'

log() {
  printf '[%s] %s\n' "$(date '+%H:%M:%S')" "$*"
}

begin_stage_deadline() {
  local now
  current_stage="$1"
  now="$(monotonic_seconds)"
  deadline=$((now + timeout_secs))
  log "stage $current_stage started with ${timeout_secs}s timeout"
}

setup_observer() {
  [[ -x "$observer_bin" ]] \
    || fail_bench "required benchmark observer is not executable: $observer_bin"
  local real_sh real_cargo experiment_commit real_codex
  real_sh="$(command -v sh 2>/dev/null || true)"
  [[ -n "$real_sh" ]] || fail_bench "observer could not resolve sh from PATH"
  real_cargo="$(command -v cargo 2>/dev/null || true)"
  [[ -n "$real_cargo" ]] || fail_bench "observer could not resolve cargo from PATH"
  real_codex="$bench_profiled_codex_bin"
  experiment_commit="$(git -C "$repo_root" rev-parse HEAD 2>/dev/null || printf 'unknown')"
  observer_root="$artifact_dir/observation"
  mkdir -p "$observer_root"
  "$observer_bin" init \
    --root "$observer_root" \
    --study-id "$observer_study_id" \
    --pair-id "$observer_pair_id" \
    --condition direct \
    --run-id "$run_id" \
    --real-codex "$real_codex" \
    --real-sh "$real_sh" \
    --real-cargo "$real_cargo" \
    --base-commit "$base_commit" \
    --experiment-commit "$experiment_commit" \
    --model "$bench_model" \
    --effort "$agent_reasoning_effort" >/dev/null \
    || fail_bench "failed to initialize benchmark observer"
  observer_config="$observer_root/observer-config.json"
  observer_proxy_dir="$observer_root/proxy-bin"
  observer_primary_marker="$(jq -er '.primary_invocation_marker' "$observer_config")" \
    || fail_bench "observer configuration has no primary invocation marker"
  export WORK_LEAF_OBSERVER_CONFIG="$observer_config"
  export PATH="$observer_proxy_dir:$PATH"
  agent_bin="$observer_proxy_dir/codex"
  observer_enabled=1
  observer_timeline condition-start "schedule=sequential"
}

observer_timeline() {
  [[ "$observer_enabled" == "1" ]] || return 0
  local event="$1"
  local detail="${2:-}"
  if ! "$observer_bin" timeline --config "$observer_config" --event "$event" --detail "$detail"; then
    log "observer timeline capture failed for $event"
  fi
  return 0
}

observer_checkpoint() {
  [[ "$observer_enabled" == "1" ]] || return 0
  local label="$1"
  if ! "$observer_bin" git-checkpoint \
    --config "$observer_config" --repo "$checkout_dir" --label "$label"; then
    log "observer Git checkpoint failed for $label"
  fi
  return 0
}

finalize_observation() {
  if [[ "$observer_enabled" != "1" ]]; then
    measurement_status="not-started"
    measurement_reason="observer was not initialized"
    return 0
  fi
  local sessions_root="${CODEX_HOME:-$HOME/.codex}/sessions"
  "$observer_bin" analyze --config "$observer_config" \
    >"$artifact_dir/observation/analysis-pre-rollout.json" \
    2>"$artifact_dir/observation/analysis-pre-rollout.err" || true
  "$observer_bin" extract-rollouts --config "$observer_config" --sessions-root "$sessions_root" \
    >"$artifact_dir/observation/rollout-extraction.json" \
    2>"$artifact_dir/observation/rollout-extraction.err" || true
  "$observer_bin" analyze --config "$observer_config" \
    >"$artifact_dir/observation/analysis.json" 2>"$artifact_dir/observation/analysis.err" || true
  observer_finalized=1
  load_observer_measurement
}

load_observer_measurement() {
  local analysis="$artifact_dir/observation/analysis.json"
  if ! jq -e '.usage_scopes.total_workflow' "$analysis" >/dev/null 2>&1; then
    measurement_status="unavailable"
    measurement_reason="observer did not produce a readable total-workflow usage record"
    return 0
  fi
  if [[ "$(jq -r '.capture_complete' "$analysis")" == "true" ]]; then
    measurement_status="complete"
    measurement_reason="all observer capture checks passed"
  else
    measurement_status="incomplete"
    measurement_reason="$(jq -r 'if (.errors | length) == 0 then "capture marked incomplete without a recorded reason" else (.errors | join("; ")) end' "$analysis")"
  fi
  total_workflow_input_tokens="$(jq -r '.usage_scopes.total_workflow.input_tokens' "$analysis")"
  total_workflow_cached_input_tokens="$(jq -r '.usage_scopes.total_workflow.cached_input_tokens' "$analysis")"
  total_workflow_uncached_input_tokens="$(jq -r '.usage_scopes.total_workflow.uncached_input_tokens' "$analysis")"
  total_workflow_output_tokens="$(jq -r '.usage_scopes.total_workflow.output_tokens' "$analysis")"
  total_workflow_reasoning_output_tokens="$(jq -r '.usage_scopes.total_workflow.reasoning_output_tokens' "$analysis")"
  total_workflow_raw_tokens="$(jq -r '.usage_scopes.total_workflow.raw_input_plus_output' "$analysis")"
  total_workflow_uncached_tokens="$(jq -r '.usage_scopes.total_workflow.uncached_input_plus_output' "$analysis")"
  token_usage="total-workflow: input=$total_workflow_input_tokens cached_input=$total_workflow_cached_input_tokens output=$total_workflow_output_tokens reasoning_output=$total_workflow_reasoning_output_tokens"
}

finish_observation() {
  local status="$1"
  [[ "$observer_finalized" != "1" ]] || return 0
  observer_timeline condition-end "status=$status result=$result" \
    || log "observer final timeline event failed"
  finalize_observation
}

feature_prompt() {
  case "$1" in
    1) printf '%s\n' "$feature_1" ;;
    2) printf '%s\n' "$feature_2" ;;
    3) printf '%s\n' "$feature_3" ;;
    *) return 1 ;;
  esac
}

redact_sensitive_env() {
  sed -E \
    -e 's/^(.*(TOKEN|token|Token|SECRET|secret|Secret|PASSWORD|password|Password|KEY|key|Key|AUTH|auth|Auth|CREDENTIAL|credential|Credential|COOKIE|cookie|Cookie|SESSION|session|Session)[^=]*)=.*/\1=<redacted>/'
}

cleanup() {
  local status=$?
  if [[ "$status" -ne 0 && "$reported" == "0" && "$report_attempted" == "0" \
    && "$bench_artifact_transaction_active" == "1" ]]; then
    result="fail"
    failure_reason="${failure_reason:-bench exited unexpectedly with status $status}"
    git -C "$checkout_dir" status --short > "$tmp_root/final-status.txt" 2>/dev/null || true
    git -C "$checkout_dir" log --oneline --max-count=30 > "$tmp_root/final-log.txt" 2>/dev/null || true
    finish_observation "$status"
    write_report "$failure_reason" || true
  fi
  bench_abort_artifact_transaction
  rm -rf "$tmp_root"
  exit "$status"
}
trap cleanup EXIT INT TERM

stage_candidate_binary() {
  local source_commit source_tree base_tree checkout_status commits_after_base

  [[ -n "$candidate_cargo_bin" ]] || return 1
  rm -rf "$tmp_root/candidate-target" "$tmp_root/candidate" "$tmp_root/candidate-runtime" \
    || return 1
  checkout_status="$(git -C "$checkout_dir" status --porcelain=v1 --untracked-files=all)" \
    || return 1
  [[ -z "$checkout_status" ]] || return 1
  source_commit="$(git -C "$checkout_dir" rev-parse --verify 'HEAD^{commit}')" || return 1
  git -C "$checkout_dir" merge-base --is-ancestor "$base_commit" "$source_commit" \
    || return 1
  base_tree="$(git -C "$checkout_dir" rev-parse --verify "$base_commit^{tree}")" || return 1
  source_tree="$(git -C "$checkout_dir" rev-parse --verify "$source_commit^{tree}")" \
    || return 1
  [[ "$source_tree" != "$base_tree" ]] || return 1
  commits_after_base="$(git -C "$checkout_dir" rev-list --count "$source_commit" "^$base_commit")" \
    || return 1
  [[ "$commits_after_base" =~ ^[0-9]+$ ]] || return 1
  (( commits_after_base >= minimum_candidate_commits )) || return 1

  mkdir -p \
    "$tmp_root/candidate-target" \
    "$tmp_root/candidate" \
    "$tmp_root/candidate-runtime" \
    || return 1
  log "building and smoking final candidate replay runtime"
  if ! bench_stage_candidate_runtime \
    "$checkout_dir" \
    "$candidate_cargo_bin" \
    "$source_commit" \
    "$tmp_root/candidate-target" \
    "$child_tmp_dir" \
    "$tmp_root/candidate" \
    "$tmp_root/candidate-runtime" \
    "$tmp_root/candidate-build.log"; then
    log "candidate runtime staging failed: ${bench_runtime_error_reason:-unknown error}"
    rm -rf "$tmp_root/candidate"
    return 1
  fi
  jq -n \
    --arg schema "$candidate_schema" \
    --arg source_commit "$source_commit" \
    --arg entrypoint "candidate/bin/work-leaf" \
    --argjson executables "$bench_runtime_executables" \
    --arg target_sha256 "$bench_runtime_target_manifest_digest" \
    --arg smoke_schema "$bench_candidate_smoke_schema" \
    --arg smoke_stdout_sha256 "$bench_runtime_smoke_stdout_digest" \
    --arg smoke_stderr_sha256 "$bench_runtime_smoke_stderr_digest" \
    --arg stdin_sha256 "$bench_runtime_stdin_digest" \
    '{
      schema:$schema,
      source_commit:$source_commit,
      entrypoint:$entrypoint,
      executables:$executables,
      targets:{path:"candidate/SOURCE_TARGETS.json",sha256:$target_sha256},
      smoke:{
        schema:$smoke_schema,
        gate:"bounded-startup-quit",
        command:[$entrypoint],
        stdin_sha256:$stdin_sha256,
        timeout_seconds:20,
        exit_code:0,
        stdout:{path:"candidate/SMOKE.stdout",sha256:$smoke_stdout_sha256},
        stderr:{path:"candidate/SMOKE.stderr",sha256:$smoke_stderr_sha256}
      }
    }' \
    > "$tmp_root/candidate/PROVENANCE" || return 1
}

copy_artifacts() {
  local candidate_admission="${1:-}"

  [[ "$bench_artifact_transaction_active" == "1" \
    && "$(stat -Lc '%d:%i' "$artifact_dir" 2>/dev/null)" \
      == "$bench_artifact_transaction_stage_identity" ]] || return 1
  for file in agent-version.txt agent-model.txt agent-profile.txt driver-env.txt final-status.txt final-log.txt checks.log driver.log candidate-build.log; do
    if [[ -f "$tmp_root/$file" && ! -L "$tmp_root/$file" ]]; then
      cp --no-dereference -- "$tmp_root/$file" "$artifact_dir/$file"
    fi
  done
  if [[ -d "$tmp_root/agent-policy" ]]; then
    cp -a -- "$tmp_root/agent-policy" "$artifact_dir/agent-policy"
  fi
  if [[ -f "${bench_recursive_codex_log:-}" ]]; then
    cp --no-dereference -- "$bench_recursive_codex_log" "$artifact_dir/recursive-codex-attempts.log"
  fi
  if [[ -d "$tmp_root/runs" ]]; then
    mkdir -p "$artifact_dir/runs"
    cp -a --no-dereference -- "$tmp_root/runs/." "$artifact_dir/runs/"
  fi
  if [[ -d "$tmp_root/review-results" ]]; then
    mkdir -p "$artifact_dir/review-results"
    cp -a --no-dereference -- \
      "$tmp_root/review-results/." "$artifact_dir/review-results/"
  fi
  mkdir -p "$artifact_dir/runner-bin"
  for binary in work-leaf work-leaf-orchestrator; do
    if [[ -f "$bin_dir/$binary" && ! -L "$bin_dir/$binary" && -x "$bin_dir/$binary" ]]; then
      cp --no-dereference -- "$bin_dir/$binary" "$artifact_dir/runner-bin/$binary"
    fi
  done
  if compgen -G "$artifact_dir/runner-bin/*" >/dev/null; then
    (cd "$artifact_dir/runner-bin" && sha256sum * > SHA256SUMS)
  fi

  if [[ "$result" == "pass" && -x "$tmp_root/candidate/bin/work-leaf" ]]; then
    jq -e --arg schema "$candidate_schema" '
      type == "object"
      and keys == ["entrypoint", "executables", "schema", "smoke", "source_commit", "targets"]
      and .schema == $schema
      and .entrypoint == "candidate/bin/work-leaf"
      and (.executables | type == "array" and length > 0)
      and .targets.path == "candidate/SOURCE_TARGETS.json"
      and .smoke.gate == "bounded-startup-quit"
    ' "$tmp_root/candidate/PROVENANCE" >/dev/null || return 1
    (
      cd "$tmp_root/candidate"
      sha256sum --check --strict --status SHA256SUMS
    ) || return 1
    bench_publish_candidate_runtime \
      "$artifact_dir" \
      "$tmp_root/candidate" \
      "$candidate_admission" \
      "$bench_artifact_transaction_stage_identity" || return 1
  fi
}

save_repo_snapshot() {
  local label="$1"
  local safe_label commit_count snapshot_dir patch_dir git_dir snapshot_index
  [[ -d "$checkout_dir/.git" ]] || return
  safe_label="$(printf '%s' "$label" | tr -c 'A-Za-z0-9._-' '-')"
  snapshot_dir="$artifact_dir/patches/$safe_label"
  patch_dir="$snapshot_dir/format-patch"
  mkdir -p "$patch_dir"
  git -C "$checkout_dir" rev-parse --show-toplevel > "$snapshot_dir/repo-path.txt" 2>/dev/null || true
  git -C "$checkout_dir" status --short > "$snapshot_dir/git-status.txt" 2>/dev/null || true
  git -C "$checkout_dir" log --oneline --decorate "$base_commit"..HEAD > "$snapshot_dir/git-log.txt" 2>/dev/null || true
  git -C "$checkout_dir" diff --stat "$base_commit"..HEAD > "$snapshot_dir/diff-stat.txt" 2>/dev/null || true
  git -C "$checkout_dir" diff --stat > "$snapshot_dir/worktree-diff-stat.txt" 2>/dev/null || true
  git -C "$checkout_dir" diff --cached --binary > "$snapshot_dir/index.diff" 2>/dev/null || true
  git_dir="$(git -C "$checkout_dir" rev-parse --absolute-git-dir 2>/dev/null || true)"
  snapshot_index="$snapshot_dir/snapshot.index"
  if [[ -n "$git_dir" ]] && cp -- "$git_dir/index" "$snapshot_index" 2>/dev/null \
    && GIT_INDEX_FILE="$snapshot_index" git -C "$checkout_dir" add -N -- . 2>/dev/null; then
    GIT_INDEX_FILE="$snapshot_index" git -C "$checkout_dir" diff --binary \
      > "$snapshot_dir/worktree.diff" 2>/dev/null || true
  else
    git -C "$checkout_dir" diff --binary > "$snapshot_dir/worktree.diff" 2>/dev/null || true
  fi
  rm -f -- "$snapshot_index"
  commit_count="$(git -C "$checkout_dir" rev-list --count HEAD ^"$base_commit" 2>/dev/null || printf '0')"
  if [[ "$commit_count" != "0" ]]; then
    git -C "$checkout_dir" format-patch --no-signature -o "$patch_dir" "$base_commit"..HEAD > "$snapshot_dir/format-patch-files.txt" 2>/dev/null || true
    git -C "$checkout_dir" bundle create "$snapshot_dir/commits.bundle" "$base_commit"..HEAD > "$snapshot_dir/bundle-create.txt" 2>&1 || true
  else
    printf 'no commits after %s\n' "$base_commit" > "$snapshot_dir/no-commits.txt"
  fi
}

write_report() {
  local comment="$1"
  local end_epoch active_end_seconds elapsed commits status_lines recent_log driver_commit driver_dirty
  local changed_files changed_lines_added changed_lines_deleted changed_lines_total
  local binaries_produced effective_notes patch_artifacts agent_version
  local candidate_json="null" candidate_admission=""
  local machine_report_staging="$tmp_root/machine-report.json"
  report_attempted=1
  end_epoch="$(date +%s)"
  active_end_seconds="$(monotonic_seconds)"
  if [[ -n "$completed_active_seconds" ]]; then
    active_end_seconds="$completed_active_seconds"
  fi
  elapsed=$((active_end_seconds - start_active_seconds))
  commits="$(git -C "$checkout_dir" rev-list --count HEAD ^"$base_commit" 2>/dev/null || printf '0')"
  status_lines="$(cat "$tmp_root/final-status.txt" 2>/dev/null || true)"
  recent_log="$(cat "$tmp_root/final-log.txt" 2>/dev/null || true)"
  driver_commit="$(git -C "$repo_root" rev-parse HEAD 2>/dev/null || printf 'unknown')"
  if git -C "$repo_root" diff --quiet --ignore-submodules -- && git -C "$repo_root" diff --cached --quiet --ignore-submodules --; then
    driver_dirty="no"
  else
    driver_dirty="yes"
  fi
  changed_files="$(git -C "$checkout_dir" diff --name-only "$base_commit"..HEAD 2>/dev/null | wc -l | tr -d ' ')"
  read -r changed_lines_added changed_lines_deleted < <(
    git -C "$checkout_dir" diff --numstat "$base_commit"..HEAD 2>/dev/null |
