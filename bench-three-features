start_web_ui() {
  case "$web_ui_enabled" in
    0|false|False|no|No)
      log "web UI helper disabled"
      return
      ;;
  esac
  if ! command -v python3 >/dev/null 2>&1; then
    log "web UI helper skipped: python3 not found"
    return
  fi

  python3 "$repo_root/web-ui/serve.py" --listen "$web_ui_listen" --api "$url" >"$tmp_root/web-ui.out" 2>"$tmp_root/web-ui.err" &
  web_ui_pid=$!
  local line
  for _ in $(seq 1 100); do
    if [[ -s "$tmp_root/web-ui.out" ]]; then
      line="$(sed -n 's/^WORK_LEAF_WEB_UI_URL=//p' "$tmp_root/web-ui.out" | head -n1)"
      if [[ -n "$line" ]]; then
        web_ui_url="$line"
        printf '%s\n' "$web_ui_url" > "$tmp_root/web-ui-url.txt"
        log "web UI URL: $web_ui_url"
        return
      fi
    fi
    if ! kill -0 "$web_ui_pid" 2>/dev/null; then
      log "web UI helper exited before printing a URL; see web-ui.err"
      web_ui_pid=""
      return
    fi
    sleep 0.1
  done
  log "web UI helper did not print a URL before timeout; continuing without it"
}

