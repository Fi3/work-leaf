}

detect_codex_model() {
  local config_path config_model config_reasoning cache_path cache_reasoning
  config_path="${CODEX_HOME:-$HOME/.codex}/config.toml"
  if [[ -n "${WORK_LEAF_BENCH_MODEL:-}" ]]; then
    bench_model="$WORK_LEAF_BENCH_MODEL"
    bench_model_source="WORK_LEAF_BENCH_MODEL"
  elif [[ -f "$config_path" ]]; then
    config_model="$(read_codex_config_value "$config_path" "model" || true)"
    if [[ -n "$config_model" ]]; then
      bench_model="$config_model"
      bench_model_source="codex config $config_path"
    fi
  fi

  if [[ -z "$bench_model" || "$bench_model" == "default" || "$bench_model" == "unknown" || "$bench_model" == "unresolved" ]]; then
    printf 'error: unable to resolve Codex model from WORK_LEAF_BENCH_MODEL or %s\n' "$config_path" >&2
    return 1
  fi

  if [[ -n "${WORK_LEAF_BENCH_REASONING_EFFORT:-}" ]]; then
    agent_reasoning_effort="$WORK_LEAF_BENCH_REASONING_EFFORT"
    agent_reasoning_effort_source="WORK_LEAF_BENCH_REASONING_EFFORT"
    return
  fi

  if [[ -f "$config_path" ]]; then
    config_reasoning="$(read_codex_config_value "$config_path" "model_reasoning_effort" || true)"
    if [[ -n "$config_reasoning" ]]; then
      agent_reasoning_effort="$config_reasoning"
      agent_reasoning_effort_source="codex config $config_path"
      return
    fi
  fi

  cache_path="${CODEX_HOME:-$HOME/.codex}/models_cache.json"
  if [[ -f "$cache_path" ]] && command -v jq >/dev/null 2>&1; then
    cache_reasoning="$(jq -r --arg model "$bench_model" '.models[]? | select(.slug == $model) | .default_reasoning_level // empty' "$cache_path" 2>/dev/null | head -n 1)"
    if [[ -n "$cache_reasoning" ]]; then
      agent_reasoning_effort="$cache_reasoning"
      agent_reasoning_effort_source="codex models cache $cache_path"
      return
    fi
  fi

  printf 'error: unable to resolve Codex reasoning effort for model %s from %s or %s\n' "$bench_model" "$config_path" "$cache_path" >&2
  return 1
}

read_codex_config_value() {
  local config_path="$1"
  local key="$2"
  awk -v key="$key" '
    /^\[/ { exit }
    {
      line = $0
      sub(/[[:space:]]+#.*/, "", line)
      if (line ~ "^[[:space:]]*" key "[[:space:]]*=") {
        sub(/^[^=]*=[[:space:]]*/, "", line)
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", line)
        gsub(/^"|"$/, "", line)
        print line
        exit
      }
    }
  ' "$config_path"
}

detect_codex_cli_version() {
  local version_output
  if codex_cli_path="$(command -v codex 2>/dev/null)"; then
    :
  else
    codex_cli_path="unavailable"
  fi

  if [[ "$codex_cli_path" == "unavailable" ]]; then
    codex_cli_version="unavailable"
    return
  fi

  if version_output="$("$codex_cli_path" --version 2>&1 | awk 'NF { line = $0 } END { if (line) print line; else print "unavailable" }')"; then
    codex_cli_version="$version_output"
  else
    codex_cli_version="${version_output:-unavailable}"
  fi
}

