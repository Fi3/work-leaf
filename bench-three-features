if [[ "$dry_run" == "1" ]]; then
  log "WORK_LEAF_BENCH_TEMP=$tmp_root"
  log "WORK_LEAF_BENCH_SOURCE_HEAD=$source_head"
  if ! detect_codex_model; then
    bench_model="not-applicable"
    bench_model_source="dry run did not launch Codex"
    agent_reasoning_effort="not-applicable"
    agent_reasoning_effort_source="dry run did not launch Codex"
  fi
  detect_codex_cli_version
  prepare_base_checkout
  log "WORK_LEAF_BENCH_BASE=$base_commit"
  result="skipped"
  code_quality="not run"
  write_report "dry run created and removed the working-tree snapshot checkout without launching agents"
  exit 0
fi

if ! detect_codex_model; then
  reported=1
  exit 1
fi
detect_codex_cli_version

if [[ "${WORK_LEAF_BENCH_SKIP_BUILD:-}" != "1" ]]; then
  (cd "$repo_root" && cargo build --release --bins)
fi
if [[ -z "${WORK_LEAF_BENCH_OBSERVER_BIN+x}" ]]; then
  cargo build --manifest-path "$repo_root/bench-observer/Cargo.toml" --release --bin bench-observer
fi

log "WORK_LEAF_BENCH_TEMP=$tmp_root"
log "WORK_LEAF_BENCH_SOURCE_HEAD=$source_head"
prepare_base_checkout
log "WORK_LEAF_BENCH_BASE=$base_commit"
mkdir -p "$child_tmp_dir"
bench_install_no_recursive_agent_policy "$checkout_dir" "$tmp_root/agent-policy" \
  || fail_bench "failed to install benchmark provider-isolation policy"
prepare_bench_codex_profile || fail_bench "failed to prepare explicit Codex model/reasoning profile"
setup_observer || fail_bench "failed to start required benchmark observer"
observer_checkpoint base || fail_bench "failed to capture observer base checkpoint"

daemon_args=("--listen" "$listen_addr")
daemon_args+=("--model" "$bench_model")
if [[ "$no_read_permission" == "1" || "$no_read_permission" == "true" || "$no_read_permission" == "yes" ]]; then
  daemon_args+=("--no-read-permission")
fi
(
  cd "$checkout_dir"
  TMPDIR="$child_tmp_dir" exec env WORK_LEAF_OBSERVER_PRIMARY_MARKER="$observer_primary_marker" WORK_LEAF_CONTEXT_BUNDLE_DIR="$tmp_root/context-bundles" WORK_LEAF_COMMAND_TMPDIR="$child_tmp_dir" WORK_LEAF_CODEX_TRACE=1 WORK_LEAF_CODEX_LINEARIZE_SANDBOX=danger-full-access WORK_LEAF_CODEX_EXACT_USAGE=1 "$bin_dir/work-leaf-orchestrator" "${daemon_args[@]}" >"$tmp_root/daemon.out" 2>"$tmp_root/daemon.err"
) &
daemon_pid=$!
{
  printf 'daemon_pid=%s\n' "$daemon_pid"
  printf 'bench_pid=%s\n' "$$"
  printf 'parent_pid=%s\n' "$PPID"
  ps -o pid,ppid,pgid,sid,stat,comm,args -p "$daemon_pid" 2>/dev/null || true
} > "$tmp_root/daemon-ps.txt"
if [[ -r "/proc/$daemon_pid/environ" ]]; then
  tr '\0' '\n' < "/proc/$daemon_pid/environ" | redact_sensitive_env > "$tmp_root/daemon-env.txt" 2>/dev/null || true
fi

for _ in $(seq 1 200); do
  if [[ -s "$tmp_root/daemon.out" ]]; then
    url="$(sed -n 's/^WORK_LEAF_ORCHESTRATOR_URL=//p' "$tmp_root/daemon.out" | head -n1)"
    [[ -n "$url" ]] && break
  fi
  if ! kill -0 "$daemon_pid" 2>/dev/null; then
    fail_bench "orchestrator exited before printing a URL"
  fi
  sleep 0.1
done
[[ -n "$url" ]] || fail_bench "timed out waiting for orchestrator URL"
log "daemon URL: $url"
observer_app_server_expected=1
observer_timeline daemon-ready "url=$url" || fail_bench "failed to record daemon readiness"
start_web_ui

launched_features=0
start_benchmark_features

linearize_started=0
accepted_linearize=0
expected_final_commits=3
last_sig=""
last_provider_sig=""
last_progress_active_seconds="$start_active_seconds"
feature_stage_deadline=$((start_active_seconds + timeout_secs))
linearize_stage_deadline=0

while true; do
  now_active="$(monotonic_seconds)"
  elapsed=$((now_active - start_active_seconds))
  if [[ "$linearize_started" == "0" ]]; then
    (( now_active <= feature_stage_deadline )) \
      || fail_bench "feature/review stage timed out after ${timeout_secs}s"
  else
    (( now_active <= linearize_stage_deadline )) \
      || fail_bench "linearize stage timed out after ${timeout_secs}s"
  fi

  fetch_state_snapshot "$tmp_root/state.json" || fail_bench "orchestrator state request failed"
  if [[ -f "$tmp_root/abort-reason" ]]; then
    fail_bench "$(cat "$tmp_root/abort-reason")"
  fi
  busy="$(jq -r '.busy' "$tmp_root/state.json")"
  sig="$(jq -r '[.snapshot.sessions[] | "\(.id):\(.loading // "-"):\(.completion // "-"):lines=\(.lines|length):title=\(.title)"] | join(" | ")' "$tmp_root/state.json")"
  if [[ "$sig" != "$last_sig" ]]; then
    last_sig="$sig"
    last_progress_active_seconds="$now_active"
    log "elapsed=${elapsed}s busy=$busy $sig"
  fi
  provider_sig="$(bench_provider_stream_signature "$observer_root")"
  if [[ "$provider_sig" != "$last_provider_sig" ]]; then
    last_provider_sig="$provider_sig"
    last_progress_active_seconds="$now_active"
  fi
  reviews="$(jq '[.snapshot.sessions[] | select(.id|startswith("review-"))] | length' "$tmp_root/state.json")"
  ready_users="$(jq '[.snapshot.sessions[] | select((.id|test("^user-[0-9]+$")) and .completion == "NeedsDecision")] | length' "$tmp_root/state.json")"
  done_users="$(jq '[.snapshot.sessions[] | select(.id|test("^user-[0-9]+$")) | .id as $session_id | select([.lines[]? | select(contains("agent " + $session_id + " reported done"))] | length > 0)] | length' "$tmp_root/state.json")"
  terminal_users="$(jq '[.snapshot.sessions[] | select(.id|test("^user-[0-9]+$")) | .id as $session_id | select(.completion == "NeedsDecision" or ([.lines[]? | select(contains("agent " + $session_id + " reported done"))] | length > 0)) | .id] | unique | length' "$tmp_root/state.json")"
  user_count="$(jq '[.snapshot.sessions[] | select(.id|test("^user-[0-9]+$"))] | length' "$tmp_root/state.json")"
  commits_after_base="$(git -C "$checkout_dir" rev-list --count HEAD ^"$base_commit" 2>/dev/null || printf '0')"
  patch_agents_with_commits="$(git -C "$checkout_dir" log --format=%B "$base_commit"..HEAD 2>/dev/null | awk '/^Agent-ID: user-[0-9]+$/ { print $2 }' | sort -u | wc -l | tr -d ' ')"
  [[ -n "$patch_agents_with_commits" ]] || patch_agents_with_commits=0
  launch_errors="$(jq '[.snapshot.sessions[] | select((.id|test("^user-[0-9]+$")) and ([.lines[]? | select(startswith("error:"))] | length > 0))] | length' "$tmp_root/state.json")"
  if [[ "$busy" == "true" ]]; then
    active_stall_secs="$busy_stall_secs"
    active_stall_kind="busy"
  else
    active_stall_secs="$idle_stall_secs"
    active_stall_kind="idle"
  fi
  if (( now_active - last_progress_active_seconds > active_stall_secs )); then
    fail_bench "${active_stall_kind} stalled for more than ${active_stall_secs}s without session state changes; user_count=${user_count} terminal_users=${terminal_users} done_users=${done_users} ready_users=${ready_users} patch_agents_with_commits=${patch_agents_with_commits}"
  fi
  if [[ "$busy" == "false" && "$user_count" == "3" && "$launch_errors" == "3" && "$commits_after_base" == "0" ]]; then
    fail_bench "all three initial Codex launches failed before producing work"
  fi
  if [[ "$linearize_started" == "0" && "$busy" == "false" && "$user_count" == "3" && "$terminal_users" == "$user_count" && "$ready_users" -ge "$patch_agents_with_commits" ]]; then
    review_completed="yes"
    if [[ "$patch_agents_with_commits" != "3" ]]; then
      fail_bench "expected all three patch agents to produce reviewed commits before linearize; got ${patch_agents_with_commits}"
    fi
    expected_final_commits=3
    log "all patch agents done and ${patch_agents_with_commits} patch-agent commit(s) reviewed; launching force-linearize"
    observer_timeline feature-cycle-complete "feature=3" || fail_bench "failed to record completed feature cycle"
    observer_checkpoint pre-linearize || fail_bench "failed to capture pre-linearize checkpoint"
    observer_timeline linearize-start "reviewed-features=3" || fail_bench "failed to record linearize start"
    post_command 'force-linearize' || fail_bench "failed to post force-linearize command"
    linearize_started=1
    linearize_stage_deadline=$((now_active + timeout_secs))
    sleep 5
    continue
  fi

  linearize_ready="$(jq '[.snapshot.sessions[] | select(.id == "linearize" and .loading == null)] | length' "$tmp_root/state.json")"
  if [[ "$linearize_started" == "1" && "$accepted_linearize" == "0" && "$linearize_ready" != "0" && "$busy" == "false" ]]; then
    log "linearizer ready; accepting plan"
    observer_timeline linearize-accept "reviewed-features=3" || fail_bench "failed to record linearize acceptance"
    post_agent 'linearize' 'Accept the proposed linearization plan. Rewrite the reviewed provisional agent commits into final commits now, preserving all three reviewed features. Run the checks required by the repository instructions and iterate until they pass. Leave the repository clean and report the final commit messages and verification results.' || fail_bench "failed to accept linearize plan"
    accepted_linearize=1
    sleep 5
    continue
  fi

  if [[ "$accepted_linearize" == "1" && "$busy" == "false" ]]; then
    linearize_completed="yes"
    fetch_state_snapshot "$tmp_root/final-state.json" || fail_bench "orchestrator final-state request failed"
    bench_restore_no_recursive_agent_policy "$checkout_dir" "$tmp_root/agent-policy" \
      || fail_bench "failed to restore benchmark repository instructions"
    bench_assert_no_recursive_codex "$bench_recursive_codex_log" \
      || fail_bench "a benchmarked agent attempted recursive provider verification"
    git -C "$checkout_dir" status --short > "$tmp_root/final-status.txt"
    git -C "$checkout_dir" log --oneline --max-count=30 > "$tmp_root/final-log.txt"
    if [[ -s "$tmp_root/final-status.txt" ]]; then
      code_quality="not run; final repository was dirty"
      fail_bench "linearize finished with a dirty repository"
    fi
    commits_after_base="$(git -C "$checkout_dir" rev-list --count HEAD ^"$base_commit" 2>/dev/null || printf '0')"
    if [[ "$commits_after_base" != "$expected_final_commits" ]]; then
      code_quality="not run; workflow produced ${commits_after_base} commits instead of ${expected_final_commits}"
      fail_bench "workflow produced ${commits_after_base} commits after base; expected ${expected_final_commits} final commit(s) for patch agents that changed code"
    fi
    log "running final code quality checks"
    bench_run_final_gate "$checkout_dir" "$child_tmp_dir" "$tmp_root/checks.log" || {
      code_quality="failed; see checks.log"
      fail_bench "final repository checks failed"
    }
    git -C "$checkout_dir" status --short > "$tmp_root/final-status.txt"
    if [[ -s "$tmp_root/final-status.txt" ]]; then
      code_quality="failed; final gate changed the final repository"
      fail_bench "final repository changed during the final gate"
    fi
    code_quality="passed cargo fmt -- --check; cargo clippy --all-targets --all-features -- -D warnings; cargo test --all-targets --all-features"
    completed_active_seconds="$(monotonic_seconds)"
    observer_timeline final-checks-complete "status=pass" || fail_bench "failed to record final checks"
    observer_checkpoint final || fail_bench "failed to capture final checkpoint"
    stage_candidate_binary || fail_bench "final candidate release build failed"
    result="pass"
    finish_observation 0
    write_report "review and linearize completed; final repository checks passed"
    exit 0
  fi

  sleep 5
done
